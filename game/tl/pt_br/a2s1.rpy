# TODO: Translation updated at 2021-07-13 23:51

# game/a2s1.rpy:2
translate pt_br a2s1_a20cefa7:

    # "..."
    "..."

# game/a2s1.rpy:3
translate pt_br a2s1_160011ff:

    # unk "\"Understand that this will not be easy, even for the parents.\""
    unk "\"Entenda que isto não será fácil, mesmo para os progenitores.\""

# game/a2s1.rpy:4
translate pt_br a2s1_d9ae59d6:

    # unk "\"The pain will be temporary.\""
    unk "\"A dor será temporária.\""

# game/a2s1.rpy:5
translate pt_br a2s1_7526860c:

    # "What's happening?"
    "O que está acontecendo?"

# game/a2s1.rpy:6
translate pt_br a2s1_a20cefa7_1:

    # "..."
    "..."

# game/a2s1.rpy:7
translate pt_br a2s1_245b0bf5:

    # unk "\"You will know in time...but not yet.\""
    unk "\"Você saberá no momento certo... mas ainda não.\""

# game/a2s1.rpy:9
translate pt_br a2s1_1381611a:

    # "Time loses meaning."
    "O tempo perde o sentido."

# game/a2s1.rpy:10
translate pt_br a2s1_23607765:

    # "Blackness...simultaneously eternal and non-existent."
    "Escuridão... simultaneamente eterna e inexistente."

# game/a2s1.rpy:11
translate pt_br a2s1_37151c28:

    # "Nightmares ebb and flow, building and fading."
    "Pesadelos vem e vão, formando-se e desaparecendo."

# game/a2s1.rpy:12
translate pt_br a2s1_3c0c989d:

    # "Scenes from my earliest childhood to my landing on Adastra, all warped by horrific and violent imagery that never happened."
    "Cenas de minha primeira infância até meu desembarque em Adastra, todas distorcidas por imagens horríveis e violentas que nunca aconteceram."

# game/a2s1.rpy:13
translate pt_br a2s1_5a877227:

    # "But as soon as each one ends, I forget, just like any other dream...except one."
    "Mas assim que cada uma termina, eu me esqueço dela, como qualquer outro sonho... exceto por uma."

# game/a2s1.rpy:16
translate pt_br a2s1_63fcd66d:

    # "I'm huddled in the seat of the ship, freezing cold, numb with desperation and the fear of impending death."
    "Estou encolhido no assento da nave, congelando, entorpecido com o desespero e o medo da morte iminente."

# game/a2s1.rpy:17
translate pt_br a2s1_37b5952c:

    # "How is this happening to me?"
    "Por que isso está acontecendo comigo?"

# game/a2s1.rpy:18
translate pt_br a2s1_6586d6e5:

    # "What did I do to deserve this?"
    "O que eu fiz para merecer isso?"

# game/a2s1.rpy:19
translate pt_br a2s1_c6b91544:

    # "I glance back at the crumpled form of the wolf in the back of the ship."
    "Olho de volta para a forma derrotada do lobo na parte de trás da nave."

# game/a2s1.rpy:20
translate pt_br a2s1_487348c9:

    # "His head is framed by a pool of blood, the metal pipe just a few feet away where I'd dropped it."
    "Sua cabeça repousa em cima de uma poça de sangue, o cano de metal a poucos metros de distância de onde o deixei cair."

# game/a2s1.rpy:21
translate pt_br a2s1_bb3dd992:

    # "I've made a huge mistake."
    "Eu cometi um grande erro."

# game/a2s1.rpy:22
translate pt_br a2s1_7bd4dbe4:

    # "The anger and terror I'd been feeling over the past several hours, days—"
    "A raiva e o terror que venho sentindo nas últimas horas, dias—"

# game/a2s1.rpy:23
translate pt_br a2s1_6b45b899:

    # "...weeks?"
    "...semanas?"

# game/a2s1.rpy:24
translate pt_br a2s1_1640d67e:

    # "—builds until I scream and smash both of my fists on the glowing panels in front of me."
    "—vêm à tona até eu gritar e bater com força os meus dois punhos nos painéis brilhantes à minha frente."

# game/a2s1.rpy:28
translate pt_br a2s1_56cb53d4:

    # "The next thing I know, light blasts the interior of the ship and I cover my face with my hands."
    "A próxima coisa que percebo é luz mergulhando no interior da nave e cubro meu rosto com as mãos."

# game/a2s1.rpy:29
translate pt_br a2s1_670d96d8:

    # "Still, the light pierces through and I see blood-red."
    "Ainda assim, a luz atravessa e eu enxergo vermelho-sangue."

# game/a2s1.rpy:30
translate pt_br a2s1_b4971792:

    # "The ship vibrates violently, and I know right away that we're being pulled into it."
    "A nave vibra violentamente e eu percebo de imediato que estamos sendo puxados."

# game/a2s1.rpy:31
translate pt_br a2s1_cd5e14cd:

    # "I reach out despite the impossible light, uselessly pounding at the unresponsive panels."
    "Eu estendo a mão apesar da luz cegante, batendo inutilmente nos painéis, os quais não respondem."

# game/a2s1.rpy:32
translate pt_br a2s1_acdf0673:

    # "After a few moments, the brightness and heat become unbearable, and I finally throw myself to the floor, crawling away, crawling toward my wolf."
    "Depois de algum tempo, o brilho e o calor se tornam insuportáveis e eu finalmente me jogo no chão, rastejando para longe, em direção ao meu lobo."

# game/a2s1.rpy:33
translate pt_br a2s1_22aff67f:

    # m "\"Amicus, HELP!\""
    m "\"Amicus, SOCORRO!\""

# game/a2s1.rpy:36
translate pt_br a2s1_1109be40:

    # "But the light continues to grow, and soon everything is lit up in a blinding white, the heat so intense that the metal melts underneath my hands and knees."
    "Mas a luz continua crescendo e logo tudo se acende em um branco ofuscante, o calor tão intenso que o metal derrete sob minhas mãos e joelhos."

# game/a2s1.rpy:37
translate pt_br a2s1_93460862:

    # "I'm on fire...I {i}am{/i} fire. I feel lines of molten lead course through from the base of my neck, down my spine, branching out into my limbs, even my toes and fingers."
    "Estou pegando fogo... eu {i}sou{/i} fogo. Sinto traços de chumbo derretido percorrendo desde a base do meu pescoço até a coluna, ramificando-se nos membros até meus dedos dos pés e das mãos."

# game/a2s1.rpy:38
translate pt_br a2s1_ad6c4dc1:

    # "I can only float in the inferno, dumbly wondering why I still feel if I'm dead, wondering if this {i}is{/i} death as the ship, the wolf, and I become part of the star."
    "Me resta flutuar no inferno, sem entender por que ainda pondero sobre minha morte, imaginando se essa {i}é{/i} a morte enquanto a nave, o lobo e eu nos tornamos parte da estrela."

# game/a2s1.rpy:39
translate pt_br a2s1_6c6dc7d6:

    # "Once again, time is lost and I only exist as fire."
    "Mais uma vez, o tempo se perde e eu apenas existo como fogo."

# game/a2s1.rpy:43
translate pt_br a2s1_c92cd084:

    # "I stare up at the sky, the air suddenly cool as I try to comprehend the sudden change from the harsh, all-consuming starlight, to the gentle, cold moonlight."
    "Eu olho para cima no céu, o ar repentinamente esfria enquanto eu tento compreender a mudança de luz estelar severa a consumir tudo em volta para a fria e suave luz lunar."

# game/a2s1.rpy:44
translate pt_br a2s1_508232ce:

    # "Still, fire continues to lance through my head, neck, spine, and limbs in agonizing lines, my body mapped as a tortured stick figure."
    "Ainda assim, o fogo continua a atravessar minha cabeça, pescoço, coluna e membros em linhas agonizantes, meu corpo delineado como um boneco de palito sob tortura."

# game/a2s1.rpy:45
translate pt_br a2s1_6a3e0e48:

    # "It hurts...hurts more than anything I've ever experienced, but it's fading after what happened in the star, so I try to relax in the sand."
    "Dói... dói mais do que qualquer coisa que eu já tenha vivenciado, mas começa a desaparecer depois do que aconteceu na estrela, então eu tento relaxar na areia."

# game/a2s1.rpy:46
translate pt_br a2s1_76aaa938:

    # "After a few minutes, I realize that I can hear the waves, and I feel something drawing me toward the water."
    "Depois de alguns minutos, percebo que consigo ouvir as ondas e sinto algo me arrastando em direção à água."

# game/a2s1.rpy:47
translate pt_br a2s1_6b8343f4:

    # "I'm a little scared of getting up, of any movement at all, terrified that it might trigger the pain anew...but it doesn't."
    "Fico com um pouco de medo de me levantar, de executar qualquer movimento, aterrorizado de que isso possa desencadear a dor outra vez... mas não acontece."

# game/a2s1.rpy:48
translate pt_br a2s1_76f7ea5b:

    # "It almost feels like I'm not moving at all."
    "Eu quase me sinto como se não estivesse me movendo."

# game/a2s1.rpy:50
translate pt_br a2s1_aac0bcbb:

    # "I glide toward the water, watching the surface reflect the bright planet and moon in hypnotic ripples."
    "Eu deslizo em direção à água, observando a superfície refletir o planeta e a lua brilhantes em ondas hipnóticas."

# game/a2s1.rpy:51
translate pt_br a2s1_2d08d92d:

    # "Entering the lake and feeling the cold, gentle water wash over my skin is the best feeling I've ever felt."
    "Entrar no lago e sentir a água fria e suave cobrindo minha pele é a melhor sensação que já senti."

# game/a2s1.rpy:52
translate pt_br a2s1_d4cfd0e1:

    # "It envelops me slowly, moving up my legs, torso, and finally my head, and just like that, the pain and fire is chased away, subdued to a dull, tingly throb."
    "Ela me envolve lentamente, subindo minhas pernas, tronco, e finalmente, minha cabeça. Assim, a dor e o fogo são expulsos, subjulgados a um formigamento palpitante sem importância."

# game/a2s1.rpy:53
translate pt_br a2s1_2a256f2f:

    # "I gasp in relief, somehow able to breathe under the water."
    "Eu suspiro de alívio, de alguma forma capaz de respirar debaixo d'água."

# game/a2s1.rpy:54
translate pt_br a2s1_af40c3d5:

    # "I drift through the dark water, watching the globes of light dance and sway above me before I finally resurface."
    "Deslizo através da água escura, assistindo aos globos de luz dançarem e balançarem sobre mim antes de finalmente voltar à superfície."

# game/a2s1.rpy:55
translate pt_br a2s1_e7c6f119:

    # "It's only then that I remember Amicus."
    "Apenas então me lembro do Amicus."

# game/a2s1.rpy:56
translate pt_br a2s1_4fd3e49d:

    # "Fear grips me."
    "O medo me consome."

# game/a2s1.rpy:57
translate pt_br a2s1_3066e1cd:

    # "Was he still on that ship?"
    "Ele ainda estava naquela nave?"

# game/a2s1.rpy:58
translate pt_br a2s1_fd3518b2:

    # "Did I leave him behind in the star?"
    "Eu o abandonei na estrela?"

# game/a2s1.rpy:59
translate pt_br a2s1_d11e3251:

    # "I look up and see the lights glittering from the palace and I begin to swim towards it, somehow moving much faster than I should be able to."
    "Olho para cima, vejo as luzes do palácio brilhando e começo a nadar em direção a ele, de alguma forma me movendo muito mais rápido do que deveria ser capaz."

# game/a2s1.rpy:60
translate pt_br a2s1_448246f0:

    # "Instead of swimming to the beach though, I end up moving toward the balcony, straight to Amicus's room."
    "Mas em vez de nadar até a praia, acabo indo em direção à varanda, direto para o quarto do Amicus."

# game/a2s1.rpy:61
translate pt_br a2s1_2bc0dc91:

    # "As I get closer, I realize that someone IS on the balcony."
    "Ao me aproximar, percebo que há alguém na varanda."

# game/a2s1.rpy:62
translate pt_br a2s1_709aca38:

    # "It's Amicus, and my heart fills with relief."
    "É o Amicus, e meu coração se enche de alívio."

# game/a2s1.rpy:63
translate pt_br a2s1_4b7871a8:

    # "He's got his back to the railing, leaning against it casually."
    "Ele está de costas para a cerca, encostado casualmente nela."

# game/a2s1.rpy:64
translate pt_br a2s1_ae9b9397:

    # "Even though I can only see him from behind, I realize that it's not the Amicus I know."
    "Mesmo que eu consiga enxergá-lo apenas por trás, percebo que esse não é o Amicus que conheço."

# game/a2s1.rpy:65
translate pt_br a2s1_eb04a09c:

    # "Instead, he's in full robes, and he's a lot more skinny than I remember."
    "Em vez disso, ele veste um traje completo e está muito mais magro do que me lembro."

# game/a2s1.rpy:66
translate pt_br a2s1_52d2bf62:

    # "I slow down, wondering why he's not looking at me with all the splashing noises I'm making."
    "Eu desacelero, me perguntando por que ele não olha para mim com todos os barulhos de água respingando que estou fazendo."

# game/a2s1.rpy:67
translate pt_br a2s1_b938c562:

    # "Just as I'm about to call up to him though, I see brown arms wrap around him, smoothing over his arms and back and that's when Amicus turns to the side."
    "No momento exato em que fico prestes a chamá-lo, vejo braços sendo envolvidos nele, alisando seus braços e costas e é quando o Amicus se vira para o lado."

# game/a2s1.rpy:68
translate pt_br a2s1_7c48af8a:

    # "I see now that those arms belong to another wolf, smaller and brown-furred, one that I've never seen before."
    "Eu vejo agora que esses braços pertencem a outro lobo, menor e de pelo marrom, um que eu nunca tinha visto antes."

# game/a2s1.rpy:69
translate pt_br a2s1_f41d510c:

    # "Amicus is doing the same to him, paws moving around his body in a way that's awkward and hesitant...a pair of young lovers making out for the first time."
    "Amicus faz a mesma coisa com ele, as patas se movendo ao redor de seu corpo de uma maneira estranha e hesitante... um casal de jovens amantes se beijando pela primeira vez."

# game/a2s1.rpy:70
translate pt_br a2s1_4a3787df:

    # "I watch, suddenly feeling embarrassed."
    "Eu assisto, me sentindo constrangido de repente."

# game/a2s1.rpy:74
translate pt_br a2s1_9116b7fb:

    # "I'm back in Amicus's room, and that same, teen-aged wolf is now on the sofa, bent over, hiding his face behind his paws."
    "Estou de volta ao quarto do Amicus e aquele mesmo lobo adolescente está agora no sofá, curvado, escondendo o rosto atrás das patas."

# game/a2s1.rpy:75
translate pt_br a2s1_161fec76:

    # "I've never seen Amicus really cry, but I can tell that's what he's doing now."
    "Eu nunca realmente vi o Amicus chorando, mas posso dizer que é isso o que ele está fazendo agora."

# game/a2s1.rpy:76
translate pt_br a2s1_90b47541:

    # "I feel the sense of complete and utter shame, the feeling that you've let everyone down."
    "Sinto uma vergonha absoluta e excruciante, o sentimento de decepcionar todo mundo."

# game/a2s1.rpy:77
translate pt_br a2s1_b3bd77b8:

    # "It consumes me."
    "Isso me consome."

# game/a2s1.rpy:78
translate pt_br a2s1_47bc94b7:

    # "I reach out toward the young wolf, wanting to comfort him, wondering if he'll even know who I am."
    "Eu estendo a mão em direção ao jovem lobo, querendo confortá-lo, me perguntando se ele sequer saberá quem sou."

# game/a2s1.rpy:81
translate pt_br a2s1_c40df052:

    # "Suddenly, I'm sucked back into the cosmos."
    "De repente, sou sugado de volta ao cosmos."

# game/a2s1.rpy:82
translate pt_br a2s1_d220ccec:

    # "There is no parent this time."
    "Não há progenitor desta vez."

# game/a2s1.rpy:83
translate pt_br a2s1_1373005f:

    # "Instead, I float peacefully through the vacuum, staring down at what I assume is Adastra."
    "Em vez disso, flutuo pacificamente através do vácuo, encarando o que presumo ser Adastra."

# game/a2s1.rpy:84
translate pt_br a2s1_f583244f:

    # "Even though there isn't anyone here with me, I sense beings all around me."
    "Mesmo que não haja ninguém aqui comigo, sinto seres por toda parte."

# game/a2s1.rpy:86
translate pt_br a2s1_58bd533f:

    # "I also get a sense of approval, like their work is done."
    "Também capto um sentimento de aprovação, como se o trabalho deles estivesse concluído."

# game/a2s1.rpy:87
translate pt_br a2s1_92bfcda0:

    # "\"Finish Meera's work, young human...\""
    "\"Termine o que Meera começou, jovem humano...\""

# game/a2s1.rpy:88
translate pt_br a2s1_4c2327be:

    # "Just like that, I start to drift back down toward the moon, descending faster and faster until everything becomes a blur."
    "E assim começo a deslizar de volta em direção à lua, descendo cada vez mais rápido até que tudo se torne um borrão."

# game/a2s1.rpy:92
translate pt_br a2s1_2e0cbece:

    # "This time, coming to feels real, and I immediately know I'm not in a dream."
    "Dessa vez, tudo parece real e eu imediatamente sei que não estou em um sonho."

# game/a2s1.rpy:93
translate pt_br a2s1_87975d1f:

    # "I smell lavender."
    "Sinto cheiro de lavanda."

# game/a2s1.rpy:94
translate pt_br a2s1_f95af865:

    # "Amicus?"
    "Amicus?"

# game/a2s1.rpy:95
translate pt_br a2s1_14e0825c:

    # "My eyes feel like they're glued shut and I have to rub at them to get them to fully open."
    "A sensação em meus olhos é de como se estivessem colados e há a necessidade de esfregá-los para abrir por completo."

# game/a2s1.rpy:96
translate pt_br a2s1_0ec6e4de:

    # "The first thing I see is the sky, the planet {i}Ancoris{/i}, and the moon {i}Torque{/i}, both of them glowing brightly."
    "A primeira coisa que vejo é o céu, o planeta {i}Ancoris{/i}, e a lua {i}Torque{/i}, ambos brilhando intensamente."

# game/a2s1.rpy:97
translate pt_br a2s1_72fe72f2:

    # "I stare at the two floating orbs for a while, waiting for things to fall into place as to why I'm out here."
    "Eu encaro os dois orbes flutuantes por um momento, esperando que as coisas se encaixem sobre o motivo de eu estar aqui fora."

# game/a2s1.rpy:98
translate pt_br a2s1_5bc44a2a:

    # "I'm laying on something hard, like concrete, and I feel soft, but weighty things on my chest."
    "Estou deitado em algo duro como concreto, me sinto leve, mas com algo pesando em meu peito."

# game/a2s1.rpy:99
translate pt_br a2s1_35a509aa:

    # "My hands are curled around it, and I lift it slowly to have a look, even though it feels like a 50 pound dumbbell."
    "Minhas mãos estão entrelaçadas segurando algo, levanto lentamente para dar uma olhada, mesmo que a sensação seja a de erguer um haltere de 20 quilos."

# game/a2s1.rpy:100
translate pt_br a2s1_f6beb2bb:

    # "Flowers..."
    "Flores..."

# game/a2s1.rpy:101
translate pt_br a2s1_b4fc8aea:

    # "Flowers with a fair bit of lavender mixed in."
    "Flores com uma pequena quantidade de lavanda entre elas."

# game/a2s1.rpy:102
translate pt_br a2s1_4c44e917:

    # "Slowly, I turn my head and again, I get the feeling of heavy weights attached to my body."
    "Lentamente viro minha cabeça e mais uma vez tenho a sensação de que pesos foram anexados ao meu corpo."

# game/a2s1.rpy:103
translate pt_br a2s1_e47db068:

    # "I somehow manage it and immediately see that I'm in the amphitheater."
    "De alguma forma eu consigo e imediatamente percebo estar no anfiteatro."

# game/a2s1.rpy:104
translate pt_br a2s1_e4476fa8:

    # "At the same time, I see more flowers and I realize that they're arranged all around me in a circle."
    "Ao mesmo tempo, vejo mais flores e percebo que elas foram dispostas ao meu redor em um círculo."

# game/a2s1.rpy:105
translate pt_br a2s1_2f54169e:

    # "Moving my head around also makes me realize that there's something scratchy and prickly on my head."
    "Mexer minha cabeça também me faz perceber que há algo espinhoso pinicando."

# game/a2s1.rpy:106
translate pt_br a2s1_6b7312dc:

    # "Still struggling with my heavy hand, I reach up and grab at it."
    "Ainda fazendo esforço com minha mão pesada, eu alcanço e agarro."

# game/a2s1.rpy:107
translate pt_br a2s1_1e21f6bd:

    # "I lift it from my head and hold it in front of my face, my eyes taking a few moments to focus to find out that it's a wreath, pink flowers woven into the twigs."
    "Levanto o objeto da minha cabeça e seguro em frente ao meu rosto, meus olhos demorando alguns momentos para descobrir que se trata de uma grinalda com flores rosas tecidas nos galhos."

# game/a2s1.rpy:108
translate pt_br a2s1_5ccba045:

    # "I finally drop my arm to the side, getting too tired to hold it up and I watch it lazily roll a few feet away."
    "Eu finalmente largo meu braço para o lado, ficando cansado demais para sustentá-lo e observo enquanto ele rola no chão."

# game/a2s1.rpy:109
translate pt_br a2s1_a29ad6ff:

    # "The movement sends a wave of tingling through my body, but it fades quickly"
    "O movimento envia uma onda de formigamento através do meu corpo, mas desaparece rapidamente."

# game/a2s1.rpy:110
translate pt_br a2s1_3f184c4f:

    # "The heavy weakness is also starting to fade, but I'm more worried about how I got here, and why I'm covered in flowers."
    "A forte fraqueza também começa a desaparecer, mas eu fico mais preocupado em como vim parar aqui e por que fui coberto com flores."

# game/a2s1.rpy:111
translate pt_br a2s1_5d59597f:

    # "From what I can tell, I'm in the gardens, though a part of it I haven't been to before."
    "Pelo que posso dizer, estou no jardim, embora seja uma parte dele a qual eu nunca estive antes."

# game/a2s1.rpy:112
translate pt_br a2s1_608f8f9a:

    # "I close my eyes, trying to remember how I got here."
    "Eu fecho meus olhos, tentando lembrar como cheguei até aqui."

# game/a2s1.rpy:113
translate pt_br a2s1_aa7471c5:

    # "Amicus...the Trial of Rhetoric...the restaurant...being sick."
    "Amicus... o julgamento da retórica... o restaurante... fiquei doente."

# game/a2s1.rpy:114
translate pt_br a2s1_982371be:

    # "Again, I lift my arm, though it's easier this time, and I look at the skin."
    "Novamente levanto meu braço, embora dessa vez seja mais fácil, e observo a pele."

# game/a2s1.rpy:115
translate pt_br a2s1_2e1f785a:

    # "It's covered in crusty, yellow-ish scabs, though they don't hurt."
    "Está coberta por feridas amareladas e encrostadas, mas não há dor."

# game/a2s1.rpy:116
translate pt_br a2s1_c48dfb6d:

    # "I don't know why, but I get the feeling that the skin underneath is completely healed."
    "Eu não sei por que, mas tenho a sensação de que a pele por baixo está completamente curada."

# game/a2s1.rpy:117
translate pt_br a2s1_9d917297:

    # "I try to think again."
    "Eu tento pensar de novo."

# game/a2s1.rpy:118
translate pt_br a2s1_6d4bcfce:

    # "I do remember throwing up on Cassius, but after that...just terrible dreams."
    "Me lembro de vomitar no Cassius, mas depois disso... apenas sonhos terríveis."

# game/a2s1.rpy:119
translate pt_br a2s1_f321f7d2:

    # "Did they heal me somehow?"
    "Eles me curaram de algum jeito?"

# game/a2s1.rpy:120
translate pt_br a2s1_27bc3cea:

    # "Is this flower thing part of that?"
    "Essas flores fazem parte disso?"

# game/a2s1.rpy:121
translate pt_br a2s1_db2ec920:

    # "I'm feeling some of my strength returning, so I force myself into a sitting position, joints popping and muscles stiff."
    "Sinto um pouco da minha força retornando, então me forço a ficar sentado, as articulações estalando e os músculos rígidos."

# game/a2s1.rpy:122
translate pt_br a2s1_fc4c80fa:

    # "Still, with every movement things get easier."
    "Ainda assim, com cada movimento as coisas ficam mais fáceis."

# game/a2s1.rpy:123
translate pt_br a2s1_6f1980e9:

    # "I do get light-headed though, and I have to sit there for a moment, looking around again, wondering where Amicus is."
    "No entanto, isso me deixa tonto e preciso ficar sentando por um tempo, olhando em volta de novo, me perguntando onde o Amicus está."

# game/a2s1.rpy:124
translate pt_br a2s1_62544444:

    # "He'd sounded so desperate and sad the last I heard him."
    "Ele parecia tão desesperado e triste da última vez que o ouvi."

# game/a2s1.rpy:125
translate pt_br a2s1_374a4dce:

    # "I need to show him that I'm okay now...at least I think I am."
    "Eu preciso mostrar para ele que estou bem agora... ou pelo menos acho que estou."

# game/a2s1.rpy:126
translate pt_br a2s1_458b3b89:

    # "I slowly push myself up, listening to the gunshot cracks of my knees, as if I hadn't used them for days."
    "Eu lentamente me levanto, ouvindo as estaladas em meus joelhos, como se não os tivesse usado por dias."

# game/a2s1.rpy:127
translate pt_br a2s1_b28f2e2c:

    # "I stand unsteadily in the center of the square, looking around at the circle of flowers."
    "Instavelmente me levanto no centro do pátio, olhando em volta para o círculo de flores."

# game/a2s1.rpy:128
translate pt_br a2s1_13be5b50:

    # "I'm startled when I turn and see a wolf behind me...but it's just a sculpture."
    "Fico surpreso quando me viro e vejo um lobo atrás de mim... mas é apenas uma escultura."

# game/a2s1.rpy:129
translate pt_br a2s1_ab4cb26e:

    # "A male wolf decked out in armor, both of his paws raised to the sky."
    "Um lobo macho vestido com armadura, as duas patas levantadas em direção ao céu."

# game/a2s1.rpy:130
translate pt_br a2s1_753ca14d:

    # "He's got a bunch of flowers weaved around his wrists and on his head too."
    "Ele também está com algumas flores em volta dos pulsos e em sua cabeça."

# game/a2s1.rpy:131
translate pt_br a2s1_22f6f53b:

    # "I wait a few moments, listening for anyone that might be nearby."
    "Eu espero um pouco, tentando escutar qualquer um que possa estar por perto."

# game/a2s1.rpy:132
translate pt_br a2s1_9d30af44:

    # "All I hear are the insects around me."
    "Tudo o que escuto são insetos ao meu redor."

# game/a2s1.rpy:133
translate pt_br a2s1_ba3febdd:

    # "So, I start to move toward the path that I know leads to the palace."
    "Então começo a andar em direção ao caminho que segue até o palácio."

# game/a2s1.rpy:134
translate pt_br a2s1_49e187fa:

    # "Although I'm pretty sure I'm not dreaming now, this eerie scenario has me questioning that."
    "Embora eu tenha bastante certeza de que não estou sonhando agora, todo esse cenário misterioso me faz questionar isso."

# game/a2s1.rpy:135
translate pt_br a2s1_25592392:

    # "The whole situation is surreal."
    "A situação inteira é surreal."

# game/a2s1.rpy:136
translate pt_br a2s1_d58e3da8:

    # "All of the things that I remember happening last feel so distant."
    "Todas as coisas que lembro de acontecerem pela última vez parecem tão distantes."

# game/a2s1.rpy:137
translate pt_br a2s1_d5e18e8b:

    # "Despite spending all of my time on Adastra trying to be covert, I find myself longing to find someone, anyone really."
    "Apesar de gastar todo meu tempo em Adastra tentando manter um disfarce, eu só queria encontrar alguém agora, qualquer pessoa, não importa quem."

# game/a2s1.rpy:138
translate pt_br a2s1_d85c515b:

    # "I just need to know what's happened."
    "Eu só preciso saber o que aconteceu."

# game/a2s1.rpy:139
translate pt_br a2s1_db7c317d:

    # "And pretty soon, I do find someone."
    "E bem rápido, eu encontro alguém."

# game/a2s1.rpy:140
translate pt_br a2s1_51517c3c:

    # "His back is to me, stooped over, fur almost ghostly in the glow of the garden lights."
    "Ele está de costas para mim, curvado, os pelos quase fantasmagóricos sob o brilho das luzes do jardim."

# game/a2s1.rpy:141
translate pt_br a2s1_5efb5a4e:

    # "The cat busies himself with some flowers, a pair of metal clippers in his paws."
    "O gato se ocupa com algumas flores, uma tesoura de metal nas patas."

# game/a2s1.rpy:142
translate pt_br a2s1_9b556c71:

    # "As I get closer, I can hear him humming just above the noise of his busy snipping."
    "Conforme me aproximo, consigo ouvi-lo cantarolando por cima dos barulhos de corte."

# game/a2s1.rpy:143
translate pt_br a2s1_20d66d9a:

    # "I'm just opening my mouth when I see his ears perk."
    "Eu começo a abrir minha boca quando noto suas orelhas subirem."

# game/a2s1.rpy:144
translate pt_br a2s1_7ca27fa3:

    # al "\"Cass? You know I don't like these games.\""
    al "\"Cass? Você sabe que eu não gosto desses joguinhos.\""

# game/a2s1.rpy:146
translate pt_br a2s1_d08a6b46:

    # "Alex turns to face me, a knowing smile on his lips."
    "Alex se vira para mim, um sorriso em seus lábios."

# game/a2s1.rpy:148
translate pt_br a2s1_3c880225:

    # "That quickly disappears the second he sees me though, replaced by a look of complete shock."
    "Mas o sorriso desaparece rapidamente no segundo em que ele me vê, substituído por um olhar de completo choque."

# game/a2s1.rpy:149
translate pt_br a2s1_02be851c:

    # al "\"Ah—\""
    al "\"Ah—\""

# game/a2s1.rpy:150
translate pt_br a2s1_2b00a40e:

    # "Whatever he was trying to say doesn't seem to want to come out, and instead, he just stands there, gaping at me."
    "Seja lá o que ele queria dizer parece não querer sair, em vez disso, ele só fica parado lá, boquiaberto."

# game/a2s1.rpy:151
translate pt_br a2s1_50a1817c:

    # m "\"H—hey...\""
    m "\"E—Ei...\""

# game/a2s1.rpy:152
translate pt_br a2s1_d63bda65:

    # "I can barely talk, my voice rasping out like sandpaper on wood."
    "Eu mal consigo falar, minha voz rouca como lixa na madeira."

# game/a2s1.rpy:153
translate pt_br a2s1_60746ad3:

    # "I take a step forward and that's when Alex finally reacts, jumping almost a foot into the air in a backwards motion, putting space between us as he yelps."
    "Dou um passo para a frente e é quando o Alex finalmente reage, pulando quase meio metro no ar em um movimento para trás, colocando espaço entre nós enquanto grita."

# game/a2s1.rpy:155
translate pt_br a2s1_b81aa4d4:

    # al "\"What...what!? How!?\""
    al "\"O que... o que!? Como!?\""

# game/a2s1.rpy:156
translate pt_br a2s1_06cbe9de:

    # "He stutters, and stumbles over his words."
    "Ele gagueja e tropeça em suas palavras."

# game/a2s1.rpy:157
translate pt_br a2s1_639ebd86:

    # "I've seen Alex flustered before, but never like this."
    "Eu já vi o Alex perturbado antes, mas nunca desse jeito."

# game/a2s1.rpy:158
translate pt_br a2s1_0c721863:

    # "There's real fear in his eyes as he stumbles against some bushes."
    "Há medo genuíno em seus olhos conforme ele tropeça e colide com alguns arbustos."

# game/a2s1.rpy:159
translate pt_br a2s1_9666338d:

    # "I wonder if he's just going to take off running, but instead he stands there, quivering as he holds the clippers up in front of his chest, as if contemplating using them as a weapon."
    "Eu me pergunto se ele simplesmente vai sair correndo, mas fica parado em vez disso, tremendo enquanto segura a tesoura na frente do peito, como se estivesse pensando em usá-la como arma."

# game/a2s1.rpy:160
translate pt_br a2s1_5e6ae92c:

    # "I raise my hands reassuringly."
    "Eu levanto minhas mãos para cima, tentando tranquilizá-lo."

# game/a2s1.rpy:161
translate pt_br a2s1_5f144e3e:

    # m "\"Hey...Alex, it's me...\""
    m "\"Ei... Alex, sou eu...\""

# game/a2s1.rpy:162
translate pt_br a2s1_f2dac74d:

    # "I cough a few times, trying to clear my throat."
    "Eu tusso algumas vezes, tentando limpar minha garganta."

# game/a2s1.rpy:163
translate pt_br a2s1_9bf90bb5:

    # "I see Alex's ears twitch at the sound as he slowly lowers the clippers, though he moves to the side away from the bush, giving himself a clear path to the palace."
    "Eu vejo as orelhas do Alex sacudirem com o som enquanto ele lentamente abaixa a tesoura, embora ele se afaste para a lateral do arbusto, claramente reservando um caminho para o palácio."

# game/a2s1.rpy:165
translate pt_br a2s1_673bde58:

    # al "\"[mc]? But how?\""
    al "\"[mc]? Mas como?\""

# game/a2s1.rpy:166
translate pt_br a2s1_c554c7d0:

    # "He's staring at me like what he's seeing is impossible."
    "Ele me encara como se o que estivesse vendo fosse impossível."

# game/a2s1.rpy:167
translate pt_br a2s1_86449a24:

    # m "\"How what?\""
    m "\"Como o que?\""

# game/a2s1.rpy:168
translate pt_br a2s1_1ec05cea:

    # "I'm regaining my voice slowly, but surely."
    "Eu recupero minha voz lentamente."

# game/a2s1.rpy:169
translate pt_br a2s1_604e6184:

    # m "\"What's happening?\""
    m "\"O que tá acontecendo?\""

# game/a2s1.rpy:170
translate pt_br a2s1_3fe13a32:

    # "Alex finally seems to get a hold of himself, fur slowly laying flat again as he eyes me, looking almost suspicious."
    "Alex finalmente parece se estabilizar, seu pelo lentamente abaixando de novo enquanto ele me olha, parecendo quase desconfiado."

# game/a2s1.rpy:172
translate pt_br a2s1_2e576bda:

    # al "\"I could ask you the same thing.\""
    al "\"Eu poderia lhe perguntar a mesma coisa.\""

# game/a2s1.rpy:173
translate pt_br a2s1_1767bb16:

    # "This catches me off-guard."
    "Isso me pega desprevenido."

# game/a2s1.rpy:174
translate pt_br a2s1_fdcfd18e:

    # m "\"Why?\""
    m "\"Por que?\""

# game/a2s1.rpy:175
translate pt_br a2s1_94dd6a87:

    # al "\"Well...\""
    al "\"Bem...\""

# game/a2s1.rpy:176
translate pt_br a2s1_a4a3dc23:

    # "Alex looks around before focusing on me again, tilting his head, as if to look at me from a different angle."
    "Alex olha em volta antes de focar em mim de novo, inclinando a cabeça, como se quisesse me olhar de um ângulo diferente."

# game/a2s1.rpy:178
translate pt_br a2s1_073b4648:

    # al "\"You were...you were dead.\""
    al "\"Você estava... você estava morto.\""

# game/a2s1.rpy:179
translate pt_br a2s1_90c3f286:

    # m "\"Dead?\""
    m "\"Morto?\""

# game/a2s1.rpy:180
translate pt_br a2s1_2291d7a0:

    # al "\"Well, not completely, but you were in a coma that we were told you would not wake up from.\""
    al "\"Bem, não completamente, mas estava em um coma do qual nos disseram que não iria acordar.\""

# game/a2s1.rpy:181
translate pt_br a2s1_2d6ee573:

    # m "\"Oh.\""
    m "\"Ah.\""

# game/a2s1.rpy:182
translate pt_br a2s1_be758cce:

    # "I look down at myself, as if to confirm that I am indeed alive and well."
    "Eu olho para mim mesmo, como se para confirmar que realmente estou vivo e bem."

# game/a2s1.rpy:183
translate pt_br a2s1_49f4091f:

    # "Aside from the patchy scabs all over my arms and legs, I feel okay, aside from the grogginess."
    "Apesar das crostas irregulares por toda a extensão dos meus braços e pernas, e estar meio grogue, me sinto bem."

# game/a2s1.rpy:184
translate pt_br a2s1_e57e4c16:

    # m "\"I thought the doctor healed me.\""
    m "\"Achei que o médico tivesse me curado.\""

# game/a2s1.rpy:185
translate pt_br a2s1_757f0f1b:

    # "Alex's ears perk."
    "As orelhas do Alex se levantam."

# game/a2s1.rpy:187
translate pt_br a2s1_14b7da30:

    # al "\"Doctor?\""
    al "\"Médico?\""

# game/a2s1.rpy:188
translate pt_br a2s1_6074f15d:

    # m "\"I mean, I think there was a doctor...I heard him when I was brought back here.\""
    m "\"Quer dizer, eu acho que tinha um médico... ouvi alguém quando me trouxeram de volta pra cá.\""

# game/a2s1.rpy:190
translate pt_br a2s1_ba979357:

    # "Alex's eyes narrow."
    "Os olhos do Alex se estreitam."

# game/a2s1.rpy:191
translate pt_br a2s1_b1ccb7d2:

    # al "\"Amicus told us you were vegetative before he arrived, how did you hear him?\""
    al "\"Amicus nos disse que você estava em estado vegetativo antes dele chegar, como você o ouviu?\""

# game/a2s1.rpy:192
translate pt_br a2s1_f2ccde3e:

    # m "\"I...I dunno, I might have dreamed it. I was really out of it.\""
    m "\"Eu... eu não sei, eu posso ter sonhado. Eu tava realmente desorientado.\""

# game/a2s1.rpy:193
translate pt_br a2s1_d36092b2:

    # al "\"If you were still concious when he arrived, he should have been able to halt the damage caused by the virus. Who was the doctor?\""
    al "\"Se você ainda estava consciente quando ele chegou, deve ter sido capaz de deter os danos causados pelo virus. Quem era o médico?\""

# game/a2s1.rpy:194
translate pt_br a2s1_a5374efd:

    # "With every passing second, I regain more and more of my wits, and Alex's demeanor is confusing me."
    "A cada segundo que se passa, eu recupero meu juízo cada vez mais e o comportamento do Alex me deixa confuso."

# game/a2s1.rpy:195
translate pt_br a2s1_def963f3:

    # "He thought I was dead, and instead of being happy, I feel like he's interrogating me."
    "Ele achava que eu estava morto e em vez de ficar feliz, sinto que está me interrogando."

# game/a2s1.rpy:196
translate pt_br a2s1_2c651f30:

    # "That's also when I realize something else:"
    "Também é quando eu percebo uma coisa:"

# game/a2s1.rpy:197
translate pt_br a2s1_705614c7:

    # m "\"Wait, you all think I'm dead?\""
    m "\"Espera, todos vocês acham que eu morri?\""

# game/a2s1.rpy:199
translate pt_br a2s1_1b68d77a:

    # al "\"Well, not me anymore, obviously. This is all very strange...how did you survive, exactly?\""
    al "\"Bem, eu não mais, obviamente. Tudo isso é muito estranho... como você sobreviveu, exatamente?\""

# game/a2s1.rpy:200
translate pt_br a2s1_9b64e0ec:

    # "Now the cat is starting to annoy me, and I look past him toward the palace, the situation finally dawning on me."
    "Agora o gato está começando a me irritar e eu olho por cima dele em direção ao palácio, a situação finalmente fazendo algum sentido."

# game/a2s1.rpy:201
translate pt_br a2s1_54ae3d90:

    # m "\"Where's Amicus?\""
    m "\"Cadê o Amicus?\""

# game/a2s1.rpy:202
translate pt_br a2s1_7ac60d87:

    # "The cat is quiet for a moment, as if contemplating something, then quirks his head."
    "O gato fica quieto por um momento, como se estivesse pensando em alguma coisa, depois inclina a cabeça."

# game/a2s1.rpy:203
translate pt_br a2s1_5fda0983:

    # al "\"I'm not sure. He's been here and there, though I haven't seen him for at least a day.\""
    al "\"Eu não tenho certeza. Ele esteve por aí, embora eu não o tenha visto há pelo menos um dia.\""

# game/a2s1.rpy:204
translate pt_br a2s1_51f4f438:

    # "I walk past the cat, toward the palace, realizing what sort of state the wolf might be in."
    "Eu ando e passo pelo gato, em direção ao palácio, percebendo em que tipo de estado o lobo deve estar agora."

# game/a2s1.rpy:206
translate pt_br a2s1_34cccb2b:

    # al "\"Where are you going? I'm very happy to see that you are well. This is all just very sudden and unexpected.\""
    al "\"Onde você está indo? Estou muito feliz de ver que você está bem. É só que isso é tudo muito repentino e inesperado.\""

# game/a2s1.rpy:207
translate pt_br a2s1_836f1b1c:

    # "I ignore Alex, not really in the mood to figure out why he's acting the way he is."
    "Eu ignoro o Alex, não estou no clima para descobrir por que ele está agindo assim."

# game/a2s1.rpy:208
translate pt_br a2s1_acee2047:

    # "He's making me feel like I'm still dreaming."
    "Ele me fez sentir como se eu ainda estivesse sonhando."

# game/a2s1.rpy:210
translate pt_br a2s1_a0a6d4c0:

    # "So I walk quickly, and I'm relieved that he doesn't follow me."
    "Então eu ando rápido e fico aliviado por ele não me seguir."

# game/a2s1.rpy:213
translate pt_br a2s1_57c8c97b:

    # "The wave of cool air that hits me as I enter the palace is a welcome feeling, and I find myself grateful to be back."
    "A onda de ar frio que me atinge conforme entro no palácio é uma sensação bem-vinda e eu me sinto grato por estar de volta."

# game/a2s1.rpy:214
translate pt_br a2s1_4324a409:

    # "Despite having apparently been here the whole time, it really does feel like I've been away for weeks."
    "Apesar de aparentemente ter estado aqui esse tempo todo, realmente parece que estive fora por semanas."

# game/a2s1.rpy:215
translate pt_br a2s1_196ebb3f:

    # "I pick up the pace as I head toward Amicus's room, practically jogging."
    "Eu apresso o passo enquanto ando em direção ao quarto do Amicus, praticamente correndo."

# game/a2s1.rpy:216
translate pt_br a2s1_bec4a70d:

    # "I have to let him know that I'm okay."
    "Eu tenho que avisar para ele que estou bem."

# game/a2s1.rpy:217
translate pt_br a2s1_780edd54:

    # "The short distance to his room seems like it takes longer than it ever has before, and I'm glad that I don't run into anyone else on the way."
    "A curta distância até seu quarto parece demorar mais do que nunca e fico feliz por não encontrar mais ninguém no caminho."

# game/a2s1.rpy:218
translate pt_br a2s1_38af3931:

    # "That interaction with Alex was weird and I don't need a repeat of that right now."
    "Aquela interação com o Alex foi estranha e eu não quero uma repetição daquilo agora."

# game/a2s1.rpy:219
translate pt_br a2s1_ffc1b34a:

    # "I finally make it to his door and I immediately hear muffled chattering behind it."
    "Eu finalmente chego até sua porta e imediatamente ouço um falatório abafado por trás dela."

# game/a2s1.rpy:220
translate pt_br a2s1_5d4338c9:

    # "I don't hesitate though, and I press my hand to the panel."
    "Mas eu não hesito e pressiono minha mão contra o painel."

# game/a2s1.rpy:224
translate pt_br a2s1_ee46c8af:

    # "The door slides open, and instead of the usual blast of even colder air I would often get from Amicus's room, it's stuffy, warm, and the smell a little bit musky."
    "A porta se abre e em vez da habitual explosão de ar ainda mais frio que costumava sentir saindo do quarto do Amicus, agora é quente, abafado e com um cheiro de cachorro molhado."

# game/a2s1.rpy:225
translate pt_br a2s1_6d59c678:

    # "The lights are dimmed, and my heart sinks when I see the empty bed."
    "As luzes estão apagadas e o meu coração afunda quando vejo a cama vazia."

# game/a2s1.rpy:226
translate pt_br a2s1_460bbc32:

    # "I linger in the doorway though, something feeling off."
    "Mas eu permaneço na porta, algo parecendo errado."

# game/a2s1.rpy:227
translate pt_br a2s1_99c19046:

    # "The droning chatter is Com, giving what sounds like a monologue on the history of some past emperor."
    "O falatório vem do Com, contando o que parece um monólogo sobre a história de algum imperador do passado."

# game/a2s1.rpy:228
translate pt_br a2s1_999c8f56:

    # "I see wine bottles too, mostly bunched together on top of the bedside table, but there are also a few laying here and there on the floor."
    "Eu também vejo garrafas de vinho, a maioria agrupada em cima da mesa de cabeceira, mas também algumas jogadas no chão aleatoriamente."

# game/a2s1.rpy:229
translate pt_br a2s1_2e87079d:

    # m "\"Amicus?\""
    m "\"Amicus?\""

# game/a2s1.rpy:230
translate pt_br a2s1_122a2bd7:

    # "I call out, starting to become afraid of what I might find."
    "Eu chamo por ele, começando a ficar com medo do que posso acabar encontrando."

# game/a2s1.rpy:231
translate pt_br a2s1_d0491686:

    # "I take a few tentative steps into the room, then I hear a loud snore and instantly, the worry gripping my chest starts to release."
    "Eu dou alguns passos hesitantes para dentro do quarto, então ouço um ronco alto e instantaneamente a preocupação apertando meu peito começa a se dissipar."

# game/a2s1.rpy:232
translate pt_br a2s1_2c3f6caf:

    # "I'd recognize that sound anywhere."
    "Eu reconheceria esse som em qualquer lugar."

# game/a2s1.rpy:233
translate pt_br a2s1_23b00d31:

    # "I hurry over to the other side of the bed where I find my wolf splayed out on the floor, a wine bottle next to his head, only in his underwear."
    "Eu corro até o outro lado da cama, onde encontro meu lobo jogado no chão, apenas de cueca, uma garrafa de vinho ao lado de sua cabeça."

# game/a2s1.rpy:234
translate pt_br a2s1_2a116355:

    # "He's clearly asleep...or passed out, muzzle hanging wide open as another, thunderous snore shakes the floor."
    "Ele está claramente dormindo... ou desmaiado, seu focinho aberto enquanto outro ronco estrondoso sacode o chão."

# game/a2s1.rpy:235
translate pt_br a2s1_0c416389:

    # m "\"Amicus!\""
    m "\"Amicus!\""

# game/a2s1.rpy:236
translate pt_br a2s1_ab30108e:

    # "I crouch down next to him, resting a hand on his chest, trying to shake him awake."
    "Eu me agacho ao lado dele, repousando uma mão em seu peito, tentando acordá-lo com uma sacudida."

# game/a2s1.rpy:237
translate pt_br a2s1_5e959ba1:

    # "His only response is a few more broken snorts before drooling out the side of his muzzle."
    "Sua única resposta são mais alguns roncos quebrados antes de babar pela lateral do focinho."

# game/a2s1.rpy:238
translate pt_br a2s1_02b85c32:

    # "I switch to patting at his face, then grabbing his muzzle and shaking it around, noticing how crusty the fur is, something I've never felt on Amicus before."
    "Recorro a dar tapinhas em seu rosto, então agarro seu focinho e sacudo, notando quão duro o pelo está, algo que nunca senti no Amicus antes."

# game/a2s1.rpy:239
translate pt_br a2s1_0c416389_1:

    # m "\"Amicus!\""
    m "\"Amicus!\""

# game/a2s1.rpy:240
translate pt_br a2s1_93c40b17:

    # "I consider slapping him like I've seen people do in the movies, then I see the bottle next to his head and decide to go for another approach."
    "Eu considero dar um tapão como já vi as pessoas fazendo nos filmes, mas noto a garrafa perto de sua cabeça e decido seguir outra abordagem."

# game/a2s1.rpy:241
translate pt_br a2s1_9e7f29f9:

    # "I snatch it up and hurry to the bathroom."
    "Eu a agarro e corro até o banheiro."

# game/a2s1.rpy:243
translate pt_br a2s1_db95341a:

    # "I hold the bottle under the faucet for a good five seconds, letting it fill up with soapy water to the halfway point before I hurry back out into the room."
    "Seguro a garrafa embaixo da torneira por uns bons cinco segundos, deixando-a se encher com a água espumante até a metade antes de correr de volta para o quarto."

# game/a2s1.rpy:245
translate pt_br a2s1_31282c9e:

    # "Meanwhile, Com doesn't seem to notice me, droning on about how this particular emperor was known for having a fondness of orchids."
    "Enquanto isso, Com parece não me notar, falando sobre como esse imperador em particular era conhecido por gostar de orquídeas."

# game/a2s1.rpy:246
translate pt_br a2s1_2bdfe313:

    # "I crouch down next to Amicus again, hesitating for a second as I wonder if maybe I should call Cato...probably not Cato...Neferu maybe, just in case Amicus is actually in trouble."
    "Eu me agacho ao lado do Amicus de novo, hesitando por um segundo enquanto me pergunto se não deveria chamar o Cato... provavelmente não o Cato... Neferu, talvez, só no caso do Amicus estar uma situação mais séria."

# game/a2s1.rpy:247
translate pt_br a2s1_1d03a23d:

    # "I don't know how much a wolf can drink before it can kill them, but the sheer amount of bottles laying around the room worries me."
    "Eu não sei quanto um lobo consegue beber antes que isso o mate, mas a enorme quantidade de garrafas espalhadas pelo quarto me preocupa."

# game/a2s1.rpy:248
translate pt_br a2s1_38abd19e:

    # "I decide to just go ahead with my plan, and I upend the bottle over Amicus's face."
    "Eu decido então seguir em frente com meu plano e despejo a água no rosto do Amicus."

# game/a2s1.rpy:249
translate pt_br a2s1_3d315301:

    # "It pours directly onto his nose and he immediately chokes, turning his head this way and that to avoid the stream of bubbly water."
    "Ela derrama diretamente em seu nariz e isso o faz engasgar imediatamente, virando a cabeça para os lados, evitando o fluxo de água espumante."

# game/a2s1.rpy:250
translate pt_br a2s1_8246ee8c:

    # "I have a moment to wonder if drowning him is the best approach before he suddenly sits up, pawing at his face."
    "Eu tenho um segundo para me perguntar se afogá-lo foi a melhor abordagem antes dele subitamente se sentar, levando a pata ao rosto."

# game/a2s1.rpy:252
translate pt_br a2s1_a4a4ee61:

    # a "\"Gah!\""
    a "\"Gah!\""

# game/a2s1.rpy:253
translate pt_br a2s1_039aeb77:

    # "The wolf covers his eyes and it's only then that I realize how irritating the soap might be for them."
    "O lobo cobre os olhos e é só então que percebo o quão irritante o sabão deve ser para eles."

# game/a2s1.rpy:254
translate pt_br a2s1_57b286fd:

    # m "\"Shit, sorry! Should I get some water from the shower so you can rinse your eyes out?\""
    m "\"Merda, desculpa! Quer que eu pegue um pouco de água do chuveiro pra você enxaguar os olhos?\""

# game/a2s1.rpy:255
translate pt_br a2s1_7e55b344:

    # "Amicus freezes, still covering his face, then slowly lowers his paws to reveal his bleary, bloodshot eyes."
    "Amicus congela, ainda cobrindo o rosto, então ele abaixa as patas lentamente para revelar seus olhos turvos e vermelhos."

# game/a2s1.rpy:258
translate pt_br a2s1_34b31d73:

    # "He stares at me in a way that he never has before."
    "Ele olha para mim de um jeito que nunca olhou antes."

# game/a2s1.rpy:259
translate pt_br a2s1_0cfb7b95:

    # "It's kind of surprised like Alex had been, but rather than fear, Amicus simply looks empty, numb."
    "É meio que surpreso como foi com o Alex, mas ao invés de medo, Amicus simplesmente parece vazio, entorpecido."

# game/a2s1.rpy:260
translate pt_br a2s1_994f6c7b:

    # m "\"Are you okay?\""
    m "\"Você tá bem?\""

# game/a2s1.rpy:261
translate pt_br a2s1_bda79675:

    # "I reach out, but Amicus turns his head away."
    "Eu estendo minha mão, mas Amicus vira a cabeça."

# game/a2s1.rpy:263
translate pt_br a2s1_a502c2d7:

    # a "\"Away with you ghost...enough of your torment.\""
    a "\"Vá embora, fantasma... eu não aguento mais isso!\""

# game/a2s1.rpy:264
translate pt_br a2s1_998f342a:

    # "He keeps his head turned away, eyes closed."
    "Ele mantém sua cabeça virada, seus olhos fechados."

# game/a2s1.rpy:265
translate pt_br a2s1_066a1a4f:

    # m "\"Ghost? Amicus, it's me.\""
    m "\"Fantasma? Amicus, sou eu.\""

# game/a2s1.rpy:266
translate pt_br a2s1_915985b2:

    # "I reach out and grab his face, and that seems to shock him as he jumps and turns to look me right in the eye."
    "Eu estendo a mão e agarro seu rosto, isso parece chocá-lo enquanto ele recua e vira para me olhar fundo nos olhos."

# game/a2s1.rpy:268
translate pt_br a2s1_a79ed9e2:

    # "I can tell that he's drunk, very drunk, but there's an extra distant look in his eyes that I don't like."
    "Pois é, ele está bêbado, bêbado para caramba, mas há um torpor distante extra em seus olhos o qual não me agrada."

# game/a2s1.rpy:270
translate pt_br a2s1_fe1a0c89:

    # m "\"Amicus...what are you on? Did you take something?\""
    m "\"Amicus... por que você tá assim? Tomou alguma coisa?\""

# game/a2s1.rpy:271
translate pt_br a2s1_f7fb34ff:

    # "I hold his big head steady, feeling the fullness of his cheeks in my hands, looking into his familiar eyes, no matter how glazed and unfocused they are."
    "Eu seguro sua grande cabeça com firmeza, sentindo a plenitude de suas bochechas em minhas mãos, observando seus olhos familiares, não importa o quão vidrados e sem foco eles estejam."

# game/a2s1.rpy:273
translate pt_br a2s1_6bbf591c:

    # "Then I find myself throwing my arms around his neck and leaning into his body, the reality of the situation crashing down on me all at once."
    "Então eu jogo meus braços ao redor de seu pescoço e me inclino sobre seu corpo, a realidade da situação desabando sobre mim de uma só vez."

# game/a2s1.rpy:274
translate pt_br a2s1_0d29a13a:

    # "Amicus gasps into my ear, as if my touch suddenly makes him realize that I'm real, that I'm here."
    "Amicus ofega em meu ouvido, como se meu toque de repente o fizesse perceber que sou real, que eu estou aqui."

# game/a2s1.rpy:275
translate pt_br a2s1_709ec02a:

    # "Clumsily, he starts to stand up, pulling me up with him."
    "Desjeitosamente, ele começa a se levantar, me puxando consigo."

# game/a2s1.rpy:276
translate pt_br a2s1_343cf0f3:

    # "It's difficult because I don't let go, almost getting lifted off my feet before I settle on letting go for just a moment to hug him lower, around his body, pressing my head to his chest, hearing his heart hammering inside."
    "Ele faz isso com dificuldade pois eu não o solto, quase sou levantado do chão antes de decidir recuar um pouco e abraçá-lo mais para baixo em seu corpo, pressionando minha cabeça contra seu peito, ouvindo seu coração martelando por dentro."

# game/a2s1.rpy:277
translate pt_br a2s1_4c5508ad:

    # "Finally, he's able to get a grip on me and push me away despite my intention to cling to him forever."
    "Finalmente, ele consegue me segurar e empurrar, apesar da minha intenção de agarrá-lo para sempre."

# game/a2s1.rpy:278
translate pt_br a2s1_94ba2416:

    # "He holds me at arms length, staring at me."
    "Ele me segura na distância de um braço, me encarando."

# game/a2s1.rpy:279
translate pt_br a2s1_3edbab4e:

    # "I clutch his paws on my shoulders, staring up at him, feeling my eyes start to water."
    "Eu fixo as patas dele em meus ombros, encarando-o de volta, sentindo meus olhos começarem a lacrimejar."

# game/a2s1.rpy:281
translate pt_br a2s1_81e7c5e6:

    # a "\"Is...is this possible? Is...no, please, I can't handle another hallucination.\""
    a "\"Isso... isso é possível? Isso... não, por favor, eu não vou aguentar outra alucinação.\""

# game/a2s1.rpy:282
translate pt_br a2s1_8fa55bc4:

    # "His expression keeps morphing from hope and awe to devastation."
    "Sua expressão fica intercalando entre esperança e devastação."

# game/a2s1.rpy:283
translate pt_br a2s1_3a5c0960:

    # "I feel his paws grip into my shoulders tightly, almost painfully, as if to make sure I'm real."
    "Eu sinto suas patas apertarem meus ombros mais forte, quase dolorosamente, como se estivesse tentando se assegurar de que sou real."

# game/a2s1.rpy:284
translate pt_br a2s1_119f0fed:

    # m "\"It's me! I woke up in the garden for some reason, I'm okay...\""
    m "\"Sou eu! Eu acordei no jardim por algum motivo, eu tô bem...\""

# game/a2s1.rpy:285
translate pt_br a2s1_62597a4d:

    # "I want to hug him again, but he keeps holding me away, looking me up and down, pushing my hair back and feeling my crusty skin."
    "Eu quero abraçá-lo outra vez, mas ele continua me segurando longe, me olhando de cima a baixo, empurrando meu cabelo para trás e sentindo minha pele encrostada."

# game/a2s1.rpy:286
translate pt_br a2s1_b9c47b09:

    # a "\"But...but how...\""
    a "\"Mas... mas como...\""

# game/a2s1.rpy:287
translate pt_br a2s1_4074ccc2:

    # m "\"I don't know. I just remember having crazy dreams, then I was in the garden.\""
    m "\"Eu não sei. Eu só me lembro de ter tido uns sonhos malucos e então eu acordei no jardim.\""

# game/a2s1.rpy:290
translate pt_br a2s1_9a7123a1:

    # "As I'm talking, I think Amicus is finally believing it's me...and I notice that his body is starting to sway in a worrying manner."
    "Enquanto falo, acho que o Amicus finalmente acredita que sou eu... e noto seu corpo começando a balançar de um jeito preocupante."

# game/a2s1.rpy:291
translate pt_br a2s1_2e87079d_1:

    # m "\"Amicus?\""
    m "\"Amicus?\""

# game/a2s1.rpy:292
translate pt_br a2s1_334a06e4:

    # "I reach out to steady him, but as I do, his eyes roll back and I realize there's no way in hell I'm going to be able to keep a wolf over twice my weight from toppling over."
    "Eu estendo a mão para segurá-lo, mas enquanto faço isso, seus olhos giram e percebo que nem fodendo vou conseguir impedir um lobo com o dobro do meu peso de tombar."

# game/a2s1.rpy:294
translate pt_br a2s1_96778158:

    # "I try anyway, wrapping my arms around him as Amicus falls backwards, his bulk pulling me down with him before he falls back-first onto the bedside table, sending bottles flying while his upper-back and head smashes into the wall."
    "Eu tento mesmo assim, envolvendo meus braços nele enquanto ele cai, seu volume me puxando para baixo antes de cair primeiro na mesa de cabeceira, jogando garrafas para todo lado enquanto a parte superior de suas costas e a cabeça se chocam contra a parede."

# game/a2s1.rpy:297
translate pt_br a2s1_51e7b306:

    # "My fall is absorbed by his much softer front, but the sound is loud, the room shaking and probably waking up the entire palace."
    "Minha queda é absorvida pela parte frontal muito mais suave de seu corpo, mas o som é alto, o quarto tremendo e provavelmente acordando o palácio inteiro."

# game/a2s1.rpy:301
translate pt_br a2s1_b5c11923:

    # "Waking the wolf up the second time is a lot easier, probably because he'd fainted rather than passed out from too much wine."
    "Acordar o lobo pela segunda vez é muito mais fácil, provavelmente por ter apenas desmaiado ao invés de beber vinho até cair."

# game/a2s1.rpy:302
translate pt_br a2s1_5932ca17:

    # "We're at least able to move onto the bed where Amicus sits cross-legged, pulling me onto his lap and just holding me there, his paws moving around my body, still trying to make sure I'm real."
    "Pelo menos conseguimos nos mover até a cama, onde o Amicus se senta de pernas cruzadas, me puxando para seu colo, suas patas movendo ao redor do meu corpo, ainda tentando ter certeza de que sou real."

# game/a2s1.rpy:303
translate pt_br a2s1_507760fb:

    # "For a moment, we don't talk, the wolf just pressing his nose to my hair and breathing in deeply."
    "Por um momento, nós não conversamos, o lobo apenas pressionando o nariz contra meu cabelo e respirando profundamente."

# game/a2s1.rpy:304
translate pt_br a2s1_561de92c:

    # "I feel a little self-conscious, knowing I must not smell very good right now, but that doesn't seem to bother Amicus as he goes on pressing his nose to my head and neck, taking in my scent."
    "Eu me sinto um pouco constrangido, sabendo que provavelmente não devo estar cheirando muito bem agora, mas isso não parece incomodar o Amicus enquanto ele continua pressionando seu nariz contra a minha cabeça e pescoço, sentindo meu cheiro."

# game/a2s1.rpy:305
translate pt_br a2s1_766e820b:

    # "Finally, he does speak, but it's one word:"
    "Finalmente, ele fala, mas apenas uma palavra:"

# game/a2s1.rpy:307
translate pt_br a2s1_8f0367b9:

    # a "\"How?\""
    a "\"Como?\""

# game/a2s1.rpy:308
translate pt_br a2s1_a16e2a59:

    # "I turn my head toward the wolf, resting my cheek against his neck."
    "Eu viro minha cabeça em direção ao lobo, repousando minha bochecha contra seu pescoço."

# game/a2s1.rpy:309
translate pt_br a2s1_269b8607:

    # m "\"I don't know. I don't really even know what happened to me.\""
    m "\"Eu não sei. Eu nem sequer sei o que aconteceu comigo.\""

# game/a2s1.rpy:310
translate pt_br a2s1_5f05b7ee:

    # a "\"You got sick...so sick. You were having convulsions, brain and nerve damage, it was...it was terrible.\""
    a "\"Você ficou doente... tão doente. Estava tendo convulsões, danos nos nervos e no cérebro, foi... foi terrível.\""

# game/a2s1.rpy:312
translate pt_br a2s1_164c5252:

    # "Amicus's arms tighten around me, his voice, normally deep and strong, now sounding weak and broken."
    "Os braços do Amicus me apertam. Sua voz, normalmente profunda e forte, agora soando fraca e quebrada."

# game/a2s1.rpy:313
translate pt_br a2s1_aa77c1d8:

    # "This statement worries me though, and I have to wonder if I really am better."
    "Mas essa afirmação me preocupa e me faz questionar se realmente melhorei."

# game/a2s1.rpy:314
translate pt_br a2s1_04bc24b7:

    # "There seem to be patches missing from my memory, and I do feel different, like I'm not fully myself, but I don't really want to think about it right now."
    "Partes da minha memória parecem faltar e eu de fato me sinto diferente, como se não fosse totalmente eu mesmo, mas não quero pensar muito sobre isso agora."

# game/a2s1.rpy:315
translate pt_br a2s1_f256838f:

    # m "\"I think I remember a little bit of that. I had—\""
    m "\"Eu acho que me lembro um pouco disso. Eu tive—\""

# game/a2s1.rpy:316
translate pt_br a2s1_465418f6:

    # "I lift my arm up, showing Amicus the shiny, crusty scabs on my arm."
    "Eu levanto meu braço, mostrando ao Amicus as crostas brilhantes e duras."

# game/a2s1.rpy:318
translate pt_br a2s1_1766557d:

    # a "\"It was avia pox, I—I can't believe I didn't consider the possibility of disease and illness for you. I'm just so used to the idea of any new arrival on Adastra going through that process...obviously we did it a bit differently.\""
    a "\"Foi varíola aviária, eu-eu não acredito que nem considerei a possibilidade de você contrair doenças e enfermidades. Estou acostumado com a ideia de qualquer nova chegada em Adastra passando por esse processo. Obviamente nós fizemos um pouco diferente.\""

# game/a2s1.rpy:319
translate pt_br a2s1_bf023949:

    # m "\"Yeah...\""
    m "\"Sim...\""

# game/a2s1.rpy:321
translate pt_br a2s1_d8628ec5:

    # a "\"And honestly I'm not even sure I'd have you do it. I don't know if you'd react differently to those vaccinations...each species has their own customized cocktail."
    a "\"E honestamente, nem tenho certeza se faria você fazer isso. Não sei se as vacinas seriam totalmente seguras para você... cada espécie tem o próprio coquetel personalizado."

# game/a2s1.rpy:323
translate pt_br a2s1_97e31c80:

    # a "\"And avia pox isn't included in the vaccination set. It's such a mild virus, we'd never seen anyone react to it the way you did, even other primates.\""
    a "\"E varíola aviária não está incluída no conjunto de vacinas. É um vírus tão comum, nunca vimos ninguém reagir a ele da forma como você reagiu, até mesmo outros primatas.\""

# game/a2s1.rpy:324
translate pt_br a2s1_52d565f8:

    # "I think back to how quickly I became sick, how quickly I almost died."
    "Penso na rapidez com a qual fiquei doente, como quão rápido eu quase morri."

# game/a2s1.rpy:325
translate pt_br a2s1_d462051c:

    # "I notice Amicus looking down at me again and I look back up at him."
    "Eu noto o Amicus me encarando de novo e eu olho de volta."

# game/a2s1.rpy:326
translate pt_br a2s1_df8ec4bc:

    # m "\"What?\""
    m "\"Que foi?\""

# game/a2s1.rpy:328
translate pt_br a2s1_3122b23f:

    # "Amicus shakes his head."
    "Amicus balança a cabeça."

# game/a2s1.rpy:329
translate pt_br a2s1_cbe94906:

    # a "\"I'm just still trying to make sure you're here, that you're real...I—I'm afraid if I let go, if I even look away, you'll disappear.\""
    a "\"Eu só estou tentando me certificar de que você está aqui, que você é real... eu-eu tenho medo de que se deixar você ir, ou mesmo desviar o olhar, você vai desaparecer.\""

# game/a2s1.rpy:330
translate pt_br a2s1_717e2371:

    # "His arms tighten around me again, squeezing a huff of breath out of me."
    "Seus braços se apertam em volta de mim novamente, esvaziando um suspiro dos meus pulmões."

# game/a2s1.rpy:331
translate pt_br a2s1_a3f2d03a:

    # m "\"I'm here, I promise.\""
    m "\"Eu tô aqui, eu prometo.\""

# game/a2s1.rpy:333
translate pt_br a2s1_4dd5f2d8:

    # a "\"Well, I've had a lot of hallucinations; too many stress tablets I think.\""
    a "\"Eu tive muitas alucinações; comprimidos para estresse demais, eu acho.\""

# game/a2s1.rpy:334
translate pt_br a2s1_bfdc248b:

    # m "\"Stress tablets?\""
    m "\"Comprimidos pra estresse?\""

# game/a2s1.rpy:335
translate pt_br a2s1_9114cacf:

    # a "\"Yes, quite a few of them in fact.\""
    a "\"Sim, muitos deles, na verdade.\""

# game/a2s1.rpy:336
translate pt_br a2s1_2d633f11:

    # m "\"With wine?\""
    m "\"Com vinho?\""

# game/a2s1.rpy:338
translate pt_br a2s1_f2aee798:

    # a "\"Oh yes.\""
    a "\"Ah, sim.\""

# game/a2s1.rpy:339
translate pt_br a2s1_0c416389_2:

    # m "\"Amicus!\""
    m "\"Amicus!\""

# game/a2s1.rpy:340
translate pt_br a2s1_16b9d01b:

    # "I don't really know what these stress tablets are, but I imagine mixing space Xanax with alcohol is a horrible idea."
    "Eu não sei o que esses comprimidos para estresse são, mas imagino que misturar sertralina espacial com álcool é uma péssima ideia."

# game/a2s1.rpy:341
translate pt_br a2s1_0abee862:

    # "Amicus doesn't seem bothered by my reprimand though, instead just snuggling closer to me, his crusted face-fur prickly against my skin."
    "Mas Amicus não parece incomodado com a minha repreensão, em vez disso apenas se aconchega mais perto de mim, seu pelo facial encrostado pinicando a minha pele."

# game/a2s1.rpy:343
translate pt_br a2s1_67128b9e:

    # a "\"I love you, [mc].\""
    a "\"Eu te amo, [mc].\""

# game/a2s1.rpy:344
translate pt_br a2s1_3ac5abdd:

    # "I get that familiar swooping feeling in my chest, like I'm on a roller coaster."
