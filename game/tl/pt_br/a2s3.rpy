# TODO: Translation updated at 2021-07-13 23:51

# game/a2s3.rpy:2
translate pt_br a2s3_2e56e6d9:

    # "Behind me..."
    "Atrás de mim..."

# game/a2s3.rpy:3
translate pt_br a2s3_2d0ee2da:

    # "There is no \"behind me\" because I don't have a body anymore."
    "Não existe \"atrás de mim\" porque eu não tenho mais um corpo."

# game/a2s3.rpy:4
translate pt_br a2s3_9fcec8f9:

    # "Instead, the feeling creeps just outside of my awareness."
    "Em vez disso, o sentimento se arrasta para fora da minha consciência."

# game/a2s3.rpy:5
translate pt_br a2s3_8424101f:

    # "Whenever I try to focus on it, it slips away."
    "Sempre que eu tento focar nele, ele escapa."

# game/a2s3.rpy:6
translate pt_br a2s3_c5efb80b:

    # "So instead I just let it go, floating in space, feeling almost nothing."
    "Então só deixo rolar, flutuando no espaço, sentindo quase nada."

# game/a2s3.rpy:7
translate pt_br a2s3_e74765a9:

    # "And feeling nothing right now, after everything, feels good."
    "E não sentir nada agora, depois de tudo, é uma coisa boa."

# game/a2s3.rpy:8
translate pt_br a2s3_4666fda3:

    # "But after a moment, I start to get vague, far-off feelings."
    "Mas depois de um tempo, começo a ter sentimentos vagos e distantes."

# game/a2s3.rpy:9
translate pt_br a2s3_6857104c:

    # "Not my own feelings, but the feelings of others, and I pick them up like distant whispers."
    "Não meus sentimentos, sentimentos alheios, e eu os capto como se fossem sussurros distantes."

# game/a2s3.rpy:10
translate pt_br a2s3_bd5e49c1:

    # "\"We've interfered far too much already.\""
    "\"Já interferimos demais.\""

# game/a2s3.rpy:11
translate pt_br a2s3_66ead535:

    # "\"Nothing goes to plan with the wolves. It must be done...\""
    "\"Nada corre como planejado com os lobos...\""

# game/a2s3.rpy:12
translate pt_br a2s3_054f2c18:

    # "I'm only half-listening, coasting on the waves of soothing, empty space."
    "Eu escuto um pouco distraído, deslizando sobre as ondas de espaço vazio tranquilizante."

# game/a2s3.rpy:13
translate pt_br a2s3_db10d9a5:

    # "If this is how the drug makes you feel, I'm pretty into it."
    "Se é assim que a droga faz você se sentir, estou curtindo bastante."

# game/a2s3.rpy:14
translate pt_br a2s3_eafda6cc:

    # "\"The more we interfere the harder it will be to predict anything.\""
    "\"Quanto mais interferirmos, mais difícil será prever qualquer coisa.\""

# game/a2s3.rpy:15
translate pt_br a2s3_6a881e53:

    # "\"There is no other choice.\""
    "\"Não há outra escolha.\""

# game/a2s3.rpy:16
translate pt_br a2s3_7c1eb45c:

    # "The voice-feelings cease at that point, and I continue to ripple on the waves of the universe."
    "As sensações de voz encerram nesse ponto e eu continuo boiando nas ondas do universo."

# game/a2s3.rpy:17
translate pt_br a2s3_4e8fa7ea:

    # "That's when I notice something appearing in the center of my infinite space."
    "É quando percebo algo aparecendo no centro do meu espaço infinito."

# game/a2s3.rpy:19
translate pt_br a2s3_1e350b05:

    # "I've...seen this thing before...I think."
    "Eu já... vi essa coisa antes... eu acho."

# game/a2s3.rpy:20
translate pt_br a2s3_078635c2:

    # "Dreams that had fled my mind the moment I'd woken up suddenly come flooding back."
    "Sonhos que fugiram da minha mente no momento em que acordei de repente me inundam de volta."

# game/a2s3.rpy:21
translate pt_br a2s3_867e541d:

    # "I focus on this being, this creature that's been following me since I was abducted."
    "Eu me concentro neste ser, a criatura que vem me seguindo desde que eu fui abduzido."

# game/a2s3.rpy:22
translate pt_br a2s3_85642ea2:

    # "He looms there, staring at me, even though I'm everywhere at once."
    "Ele se eleva lá, me encarando, mesmo que eu esteja em todos os lugares ao mesmo tempo."

# game/a2s3.rpy:23
translate pt_br a2s3_b93b5446:

    # "The silence goes on for a while...or maybe not."
    "O silêncio se estende por um momento... ou talvez não."

# game/a2s3.rpy:24
translate pt_br a2s3_25301166:

    # "I still don't have any sense of time."
    "Eu ainda não tenho nenhuma percepção de tempo."

# game/a2s3.rpy:25
translate pt_br a2s3_c1502248:

    # "That is until the creature speaks."
    "Isso até que a criatura fala."

# game/a2s3.rpy:27
translate pt_br a2s3_6db03bd5:

    # unk "\"[mc].\""
    unk "\"[mc].\""

# game/a2s3.rpy:28
translate pt_br a2s3_47816b5e:

    # "The voice is deep and masculine, rumbling through my being."
    "A voz é profunda e masculina, reverberando através do meu ser."

# game/a2s3.rpy:29
translate pt_br a2s3_2ff8dc86:

    # "I wait a moment, then try to acknowledge him, made difficult by the fact that I don't have a mouth to speak with."
    "Eu espero um momento, então tento respondê-lo, minha ação sendo dificultada pelo fato de eu não ter uma boca com a qual falar."

# game/a2s3.rpy:30
translate pt_br a2s3_d3da1ea5:

    # unk "\"If you wish to communicate then do so. I can hear you.\""
    unk "\"Se você deseja se comunicar, então prossiga. Eu posso escutá-lo.\""

# game/a2s3.rpy:31
translate pt_br a2s3_41578c0b:

    # "\"What?\""
    "\"O que?\""

# game/a2s3.rpy:32
translate pt_br a2s3_7b718084:

    # "I try to think the word at him, but it's slow and clumsy in my mind, and I just wish that I could talk."
    "Eu tento pensar a palavra na direção dele, mas é lenta e desajeitada na minha mente, eu só queria poder falar."

# game/a2s3.rpy:33
translate pt_br a2s3_ef50485a:

    # "There's a rumble of amusement through the air."
    "Há um estrondo entretido através do ar."

# game/a2s3.rpy:34
translate pt_br a2s3_319344a4:

    # unk "\"If you desire a body, simply will it to be. The loss of self is a disturbing feeling for you creatures, I know.\""
    unk "\"Se você deseja um corpo, simplesmente decida ter um. Sei que a perda do ego é um sentimento perturbador para vocês criaturas.\""

# game/a2s3.rpy:35
translate pt_br a2s3_3475e454:

    # "What he's saying doesn't make all that much sense, but I try anyway, and just like that, I feel my being start to pull together."
    "O que ele está dizendo não faz lá muito sentido, mas eu tento de qualquer maneira e sinto meu ser começando a se materializar logo em seguida."

# game/a2s3.rpy:36
translate pt_br a2s3_74bad230:

    # "I start to materialize right in front of the creature, and I see my hands in front of myself again."
    "Eu me materializo bem na frente da criatura e vejo minhas em frente de mim outra vez."

# game/a2s3.rpy:37
translate pt_br a2s3_fe7405ca:

    # "When I look down, I see my body, naked."
    "Quando olho para baixo, vejo meu corpo, pelado."

# game/a2s3.rpy:38
translate pt_br a2s3_aff7e4b2:

    # "As soon as I see that, I feel a shock of embarrassment, and my robe suddenly appears on my body."
    "Assim que me deparo com isso, sinto um choque de vergonha e repentinamente meu traje aparece no corpo."

# game/a2s3.rpy:39
translate pt_br a2s3_5b19ce2e:

    # "I still don't feel right, like I'm still not in this body that I see."
    "Ainda não me sinto bem, como se ainda não estivesse nesse corpo o qual enxergo."

# game/a2s3.rpy:40
translate pt_br a2s3_a47d0f02:

    # "Still, it does feel better, and I'm able to open my mouth."
    "Ainda assim, é uma sensação melhor e sou capaz de abrir minha boca."

# game/a2s3.rpy:41
translate pt_br a2s3_c2d19494:

    # m "\"What is this?\""
    m "\"O que é isso?\""

# game/a2s3.rpy:42
translate pt_br a2s3_ae5159c1:

    # "My mouth feels strange and rubbery, and at the same time it feels like cotton is coating the inside."
    "Minha boca parece estranha e emborrachada, ao mesmo tempo, parece que algodão compõe o interior."

# game/a2s3.rpy:43
translate pt_br a2s3_6c2a3d0c:

    # unk "\"This is...\""
    unk "\"Isto é...\""

# game/a2s3.rpy:44
translate pt_br a2s3_a1af0e1d:

    # "For the first time, the creature seems unsure of what he should say."
    "Pela primeira vez, a criatura parece não ter certeza do que deveria falar."

# game/a2s3.rpy:45
translate pt_br a2s3_1ae033dd:

    # unk "\"Well, it's a bit complicated to explain, but it's simply a space where you and I might be able to communicate peacefully."
    unk "\"Bem, é um pouco complicado de explicar, mas é simplesmente um espaço onde você e eu podemos nos comunicar pacificamente."

# game/a2s3.rpy:46
translate pt_br a2s3_7791008c:

    # "That's not really an answer."
    "Isso não é uma resposta de verdade."

# game/a2s3.rpy:47
translate pt_br a2s3_0a2cc1a2:

    # unk "\"No, but if I were to explain it in-depth, it would waste the small amount of time we have together and confuse you even further.\""
    unk "\"Não, mas se eu explicasse em profundidade, desperdiçaria a pequena quantidade de tempo que temos juntos e o confundiria ainda mais.\""

# game/a2s3.rpy:48
translate pt_br a2s3_2003d2f3:

    # "I try to stay focused, wanting to know as much about this guy as I can before the drug wears off."
    "Eu tento manter o foco, querendo saber o máximo sobre esse cara antes que o efeito da droga passe."

# game/a2s3.rpy:49
translate pt_br a2s3_0707f63b:

    # m "\"You're a parent?\""
    m "\"Você é um progenitor?\""

# game/a2s3.rpy:50
translate pt_br a2s3_1238f0c9:

    # "That rumbling laughter tickles at the edge of my existence again."
    "A risada estridente faz cócegas na borda da minha existência outra vez."

# game/a2s3.rpy:51
translate pt_br a2s3_6848f276:

    # unk "\"No, definitely not. I am a monitor.\""
    unk "\"Não, definitivamente não. Eu sou um monitor.\""

# game/a2s3.rpy:52
translate pt_br a2s3_18956410:

    # "Monitor."
    "Monitor."

# game/a2s3.rpy:53
translate pt_br a2s3_c59db4f7:

    # "Icy fear trickles down my imagined spine as I realize what this all might mean."
    "O medo gelado escorre por minha coluna imaginária quando percebo o que tudo isso pode significar."

# game/a2s3.rpy:54
translate pt_br a2s3_10e9a801:

    # "The monitor quickly holds up a paw."
    "O monitor rapidamente levanta uma pata."

# game/a2s3.rpy:55
translate pt_br a2s3_b6ffdd9f:

    # mon "\"No, no, don't worry. You're not in trouble.\""
    mon "\"Não, não, não se preocupe. Você não está em apuros.\""

# game/a2s3.rpy:56
translate pt_br a2s3_8f2cc6ad:

    # "I watch him cautiously, as if he's only lulling me into a false sense of security before annihilating me on the spot."
    "Eu o observo cautelosamente, como se ele estivesse apenas me iludindo em uma falsa sensação de segurança antes de me aniquilar ali mesmo."

# game/a2s3.rpy:57
translate pt_br a2s3_4bdc7545:

    # "Again, that feeling of amusement."
    "Mais uma vez, aquele sentimento de estar entretido."

# game/a2s3.rpy:58
translate pt_br a2s3_cd47d5d1:

    # mon "\"Now that would be impossible to do here.\""
    mon "\"Bem, isso seria impossível de ser feito aqui.\""

# game/a2s3.rpy:59
translate pt_br a2s3_e303116c:

    # "I try to keep my thoughts focused."
    "Tento manter meus pensamentos em foco."

# game/a2s3.rpy:60
translate pt_br a2s3_c58b8321:

    # m "\"What about Amicus? Is he in trouble?\""
    m "\"Mas e o Amicus? Ele tá encrencado?\""

# game/a2s3.rpy:61
translate pt_br a2s3_0f8637cd:

    # mon "\"No. He only did what we had planned for him to do.\""
    mon "\"Não. Ele apenas fez o que nós planejamos que ele fizesse.\""

# game/a2s3.rpy:62
translate pt_br a2s3_21c64e60:

    # m "\"Planned?\""
    m "\"Você planejou?\""

# game/a2s3.rpy:63
translate pt_br a2s3_e6567a05:

    # "There's a pause, as if the monitor is gathering his thoughts."
    "Há uma pausa, como se o monitor estivesse reunindo seus pensamentos."

# game/a2s3.rpy:64
translate pt_br a2s3_ab7d06d0:

    # mon "\"No, I'm simply receiving instructions.\""
    mon "\"Não, eu estou simplesmente recebendo instruções.\""

# game/a2s3.rpy:65
translate pt_br a2s3_6d813ddb:

    # m "\"From?\""
    m "\"De quem?\""

# game/a2s3.rpy:66
translate pt_br a2s3_69702861:

    # mon "\"The parents.\""
    mon "\"Dos progenitores.\""

# game/a2s3.rpy:67
translate pt_br a2s3_e3a5312e:

    # "I stare at him."
    "Eu encaro ele."

# game/a2s3.rpy:68
translate pt_br a2s3_0f2606e1:

    # m "\"They're talking to you?\""
    m "\"Eles tão falando com você?\""

# game/a2s3.rpy:69
translate pt_br a2s3_417de913:

    # mon "\"Yes, about you and what I can and cannot tell you.\""
    mon "\"Sim, sobre você e o que eu posso ou não dizer.\""

# game/a2s3.rpy:70
translate pt_br a2s3_e28421cc:

    # m "\"Why don't {i}they{/i} just talk to me then?\""
    m "\"Por que {i}eles{/i} não só falam comigo, então?\""

# game/a2s3.rpy:71
translate pt_br a2s3_e691c5cd:

    # mon "\"Because they cannot. Direct communication is impossible.\""
    mon "\"Porque eles não podem. Comunicação direta é impossível.\""

# game/a2s3.rpy:72
translate pt_br a2s3_4d73dc43:

    # m "\"Then how—\""
    m "\"Então como—\""

# game/a2s3.rpy:73
translate pt_br a2s3_820fcbad:

    # mon "\"I was specifically designed to be a bridge between your...let's say dimension, and theirs.\""
    mon "\"Eu fui especificamente projetado para ser uma ponte entre sua... dimensão, digamos, e a deles.\""

# game/a2s3.rpy:74
translate pt_br a2s3_1a01ea41:

    # "I don't really know what to think about that, but I get the feeling that I shouldn't be distracted by these things right now."
    "Eu não sei realmente o que pensar sobre isso, mas tenho a sensação de que não deveria ficar distraído com essas coisas agora."

# game/a2s3.rpy:75
translate pt_br a2s3_87b39766:

    # mon "\"That would be wise.\""
    mon "\"Isso seria sensato.\""

# game/a2s3.rpy:76
translate pt_br a2s3_8086576c:

    # m "\"So what do you mean 'planned'? The parents set Amicus up somehow?\""
    m "\"Então o que você quis dizer com \"planejamos\"? Manipularam o Amicus de algum jeito?\""

# game/a2s3.rpy:77
translate pt_br a2s3_80bdddc4:

    # mon "\"Your abduction and introduction to the wolven empire was meant to happen.\""
    mon "\"Sua abdução e introdução ao império lobino foram intencionais.\""

# game/a2s3.rpy:78
translate pt_br a2s3_fdcfd18e:

    # m "\"Why?\""
    m "\"Por que?\""

# game/a2s3.rpy:79
translate pt_br a2s3_52229fd7:

    # "Another slight pause."
    "Outra leve pausa."

# game/a2s3.rpy:80
translate pt_br a2s3_592336d1:

    # mon "\"The wolves could single-handedly undo the {i}Galaxias{/i}, but you can change that.\""
    mon "\"Os lobos poderiam sozinhos desfazer a {i}congregação galáctica{/i}, mas você pode mudar isso.\""

# game/a2s3.rpy:81
translate pt_br a2s3_a0d83c4e:

    # "I frown, feeling some anxiety slip through the drug-induced calm."
    "Eu arqueio as sobrancelhas, sentindo alguma ansiedade deslizar através da calma induzida pelas drogas."

# game/a2s3.rpy:82
translate pt_br a2s3_70a1eda3:

    # m "\"What? How?\""
    m "\"O que? Como?\""

# game/a2s3.rpy:83
translate pt_br a2s3_0d2dc043:

    # mon "\"The wolves are...a stubborn sibling, possibly a mistake made at the very beginning, but the parents can still see the correct path and destination.\""
    mon "\"Os lobos são... um irmão teimoso, possivelmente um erro cometido desde o início, mas os progenitores ainda podem enxergar o caminho e o destino corretos.\""

# game/a2s3.rpy:84
translate pt_br a2s3_26d69e3b:

    # m "\"See? Can they see the future, or something?\""
    m "\"Enxergar? Eles podem ver o futuro, ou sei lá?\""

# game/a2s3.rpy:85
translate pt_br a2s3_4c8dd750:

    # mon "\"In a way, yes. Their minds exist in many times at once.\""
    mon "\"De certa forma, sim. Suas mentes existem em vários períodos de tempo simultaneamente.\""

# game/a2s3.rpy:86
translate pt_br a2s3_d7e2ebce:

    # "I'm starting to become lost and suddenly, I begin to feel like a primitive life-form, incapable of understanding this ancient, alien monolith before me."
    "Eu começo a me perder e, de repente, me sentir como uma forma de vida primitiva, incapaz de compreender esse monólito alienígena antigo diante de mim."

# game/a2s3.rpy:87
translate pt_br a2s3_8a7468ec:

    # mon "\"Do not feel that way. You yourself may not understand, but your species as a whole is more than capable.\""
    mon "\"Não se sinta assim. Você sozinho pode não ser capaz de entender, mas sua espécie como um todo é mais do que capaz.\""

# game/a2s3.rpy:88
translate pt_br a2s3_dd391805:

    # "My mind automatically thinks back to how we were abandoned by the wolves, by maybe even the jackals too."
    "Minha mente automaticamente volta a pensar em como nós fomos abandonados pelos lobos, talvez até pelos chacais, também."

# game/a2s3.rpy:89
translate pt_br a2s3_d6e52837:

    # mon "\"You were abandoned by all the siblings.\""
    mon "\"Vocês foram abandonados por toda a Irmandade.\""

# game/a2s3.rpy:90
translate pt_br a2s3_871ccb49:

    # "For a single moment, multiple images of several different creatures cross my mind; a bear, a wolf, a jackal, a lion, a ram..."
    "Por um único momento, várias imagens de várias criaturas diferentes passam pela minha mente; um urso, um lobo, um chacal, um leão, um carneiro..."

# game/a2s3.rpy:91
translate pt_br a2s3_fa8b478f:

    # "They're all recognizable, and what they wear is recognizable too, reminding me of several different cultures on Earth."
    "Todos eles são reconhecíveis e o que eles vestem também, me lembrando de várias culturas diferentes na Terra."

# game/a2s3.rpy:92
translate pt_br a2s3_ce2e65c0:

    # "The images finally stop on a tiger in a flowing dress with intricate designs and patterns, and what looks like a sari draped over her shoulder."
    "As imagens finalmente param em uma tigresa usando um vestido esvoaçante com desenhos e padrões complexos e o que parece com um sári pendurado por cima do ombro."

# game/a2s3.rpy:93
translate pt_br a2s3_f12d0bf1:

    # "As the image fades from my mind, somehow I know immediately that it's Meera."
    "Conforme a imagem desaparece da minha mente, de alguma forma eu sei imediatamente que essa é Meera."

# game/a2s3.rpy:94
translate pt_br a2s3_d155c615:

    # mon "\"Yes, we reigned in the wolves once before with the help of the Hindos, but it lasted for a far shorter period of time than we'd foreseen. That's why we've turned to you, to play her ancient role.\""
    mon "\"Sim, interferimos com os lobos uma vez antes com a ajuda dos hindus, mas durou por um periodo muito menor do que havíamos previsto. É por isso que nos voltamos a você, para desempenhar o papel antigo dela.\""

# game/a2s3.rpy:95
translate pt_br a2s3_7238d718:

    # m "\"But...we're not part of the {i}Galaxias{/i}. Everyone failed at uplifting us, so isn't something wrong with us?\""
    m "\"Mas... se a gente não faz parte da {i}congregação galáctica{/i}... todo mundo falhou em nos elevar, então não tem alguma coisa errada com a gente?\""

# game/a2s3.rpy:96
translate pt_br a2s3_156a8c4f:

    # "Another pause."
    "Outra pausa."

# game/a2s3.rpy:97
translate pt_br a2s3_797d26d5:

    # mon "\"In a way, yes, but after the attempts, all of the parents realized that humans would factor into the {i}Galaxias{/i} later...now.\""
    mon "\"De certa forma, sim, mas depois das tentativas, todos os progenitores perceberam que os humanos fariam parte da {i}congregação galáctica{/i} mais tarde... agora.\""

# game/a2s3.rpy:98
translate pt_br a2s3_85ba7560:

    # m "\"All? Aren't the parents competing with each other?\""
    m "\"Todos eles? Os progenitores não competem entre si?\""

# game/a2s3.rpy:99
translate pt_br a2s3_5fe0e287:

    # "This time I only get silence in response."
    "Dessa vez eu só recebo silêncio como resposta."

# game/a2s3.rpy:100
translate pt_br a2s3_32b181b3:

    # "I wonder if he's just been told that he can't tell me that."
    "Me pergunto se só disseram para ele que não pode me contar."

# game/a2s3.rpy:101
translate pt_br a2s3_e8e25570:

    # m "\"So...what am I supposed to do? What do you want with me?\""
    m "\"Então... o que eu deveria fazer? O que vocês querem de mim?\""

# game/a2s3.rpy:102
translate pt_br a2s3_64a0c5ed:

    # "The answer this time is immediate."
    "A resposta dessa vez é imediata."

# game/a2s3.rpy:103
translate pt_br a2s3_dc5c8b76:

    # mon "\"Restore Amicus to his rightful place on the throne.\""
    mon "\"Retorne Amicus ao seu devido lugar no trono.\""

# game/a2s3.rpy:104
translate pt_br a2s3_94255d80:

    # "I wait, but there isn't any other explanation."
    "Eu espero, mas não tem mais nenhuma outra explicação."

# game/a2s3.rpy:106
translate pt_br a2s3_9399816c:

    # m "\"And...how do I do that?\""
    m "\"E... como eu faço isso?\""

# game/a2s3.rpy:107
translate pt_br a2s3_16b8cb94:

    # "Silence."
    "Silêncio."

# game/a2s3.rpy:108
translate pt_br a2s3_9b1e5155:

    # m "\"Why me?\""
    m "\"Por que eu?\""

# game/a2s3.rpy:109
translate pt_br a2s3_486859e8:

    # "More silence."
    "Mais silêncio."

# game/a2s3.rpy:110
translate pt_br a2s3_5bfdce14:

    # "I blow out air in frustration, or try to since nothing comes out."
    "Eu sopro ar em frustração, ou tento, já que nada sai."

# game/a2s3.rpy:111
translate pt_br a2s3_77f8545c:

    # m "\"Why can't you all just {i}tell{/i} me what to do? You brought me here, didn't you? Just tell me.\""
    m "\"Por que vocês não podem simplesmente me {i}dizer{/i} o que fazer? Vocês me trouxeram até aqui, não? Só falem pra mim.\""

# game/a2s3.rpy:112
translate pt_br a2s3_9850f53c:

    # "Nothing."
    "Nada."

# game/a2s3.rpy:113
translate pt_br a2s3_92296a2b:

    # "I'm about to just give up, wait out the trip when the monitor begins speaking again."
    "Eu fico prestes a desistir de esperar quando o monitor começa a falar novamente."

# game/a2s3.rpy:114
translate pt_br a2s3_d42f9c47:

    # mon "\"Interference often leads to destabilization of the events that should follow. The {i}Galaxias{/i} must develop and learn in its own way.\""
    mon "\"Interferência frequentemente leva à desestabilização dos eventos que deveriam se seguir. A {i}congregação galáctica{/i} deve se desenvolver e aprender à sua própria maneira.\""

# game/a2s3.rpy:115
translate pt_br a2s3_0d1a0de0:

    # m "\"Except for now, right? This is interfering, isn't it?\""
    m "\"Menos agora, não? Isso é interferir, não é?\""

# game/a2s3.rpy:116
translate pt_br a2s3_786fb9c0:

    # mon "\"Except for in various instances where the children and siblings stray too far off course.\""
    mon "\"Exceto em vários casos em que os infantes e a irmandade desviam muito do curso, é claro.\""

# game/a2s3.rpy:117
translate pt_br a2s3_9a8bcdb8:

    # "This time I'm the one left unsure of what to say."
    "Dessa vez sou eu quem não tem certeza do que dizer."

# game/a2s3.rpy:118
translate pt_br a2s3_00f46889:

    # "I'd always seen the parents as all-knowing beings with only good intentions for their children, but now..."
    "Eu sempre imaginei os progenitores como seres oniscientes apenas com boas intenções em relação aos seus infantes, mas agora..."

# game/a2s3.rpy:119
translate pt_br a2s3_807a397a:

    # "How do I know they can even be trusted?"
    "Como que eu sei se eles podem sequer ser confiáveis?"

# game/a2s3.rpy:120
translate pt_br a2s3_84d6ec58:

    # "What I do know is that the monitor is apparently able to hear all my thoughts, so he definitely heard that."
    "O que eu sei é que o monitor aparentemente é capaz de ouvir todos os meus pensamentos, então ele definitivamente ouviu isso."

# game/a2s3.rpy:121
translate pt_br a2s3_c2997c7d:

    # "Still, he doesn't say anything, just regarding me silently."
    "Ainda assim, ele não fala nada, apenas me observa em silêncio."

# game/a2s3.rpy:122
translate pt_br a2s3_db9027ae:

    # m "\"So...I guess you can't tell me what the purpose of all of this is, then? The {i}Galaxias{/i} as a whole?\""
    m "\"Acho que você não pode me dizer qual é o propósito disso tudo, então? A {i}congregação galáctica{/i} como um todo?\""

# game/a2s3.rpy:123
translate pt_br a2s3_c4bd107d:

    # mon "\"That knowledge has not been earned by the sapients yet.\""
    mon "\"Este conhecimento ainda não foi adquirido pelos sapientes.\""

# game/a2s3.rpy:124
translate pt_br a2s3_7a7f80f4:

    # "My mistrust grows."
    "Minha desconfiança aumenta."

# game/a2s3.rpy:125
translate pt_br a2s3_169e12b2:

    # m "\"Well...can you give me something, {i}anything{/i} that might help me with getting Amicus out of the dungeon? If I'm straying off the course then tell me how to get back on it.\""
    m "\"Tá... você pode me dar alguma dica, {i}qualquer coisa{/i} que possa me ajudar a tirar o Amicus das masmorras? Se eu tô saindo do caminho que vocês traçaram então me digam como voltar pra ele.\""

# game/a2s3.rpy:126
translate pt_br a2s3_ae3283b7:

    # "The monitor pauses for a moment, as if getting more information from the parents."
    "O monitor pausa por um momento, como se estivesse adquirindo mais informações dos progenitores."

# game/a2s3.rpy:127
translate pt_br a2s3_fecefe41:

    # mon "\"Watch the cat.\""
    mon "\"Observe o gato.\""

# game/a2s3.rpy:128
translate pt_br a2s3_8374eeb7:

    # "The cat."
    "O gato."

# game/a2s3.rpy:129
translate pt_br a2s3_2a2df911:

    # m "\"Alexios?\""
    m "\"Alexios?\""

# game/a2s3.rpy:130
translate pt_br a2s3_810a73bf:

    # "I wait, but again I get silence."
    "Eu espero, mas de novo, recebo silêncio."

# game/a2s3.rpy:131
translate pt_br a2s3_6a20a80d:

    # "I shake my head."
    "Eu balanço a cabeça."

# game/a2s3.rpy:132
translate pt_br a2s3_f7d17162:

    # "If the parents really are all-knowing and all-powerful, then why can't they just tell me—"
    "Se os progenitores realmente são oniscientes e onipotentes, então por que eles não podem simplesmente me dizer—"

# game/a2s3.rpy:133
translate pt_br a2s3_66fa897a:

    # mon "\"We are neither of these things, hence why we must be so careful.\""
    mon "\"Não somos nenhuma dessas coisas, por isso devemos ser tão cuidadosos.\""

# game/a2s3.rpy:134
translate pt_br a2s3_9d5b8253:

    # "I just stand there, unsure of what else to do."
    "Eu só fico lá parado sem saber o que mais fazer."

# game/a2s3.rpy:135
translate pt_br a2s3_02513e4d:

    # "I look around."
    "Eu olho em volta."

# game/a2s3.rpy:136
translate pt_br a2s3_31f27818:

    # m "\"Is uh, is Cassius alright?\""
    m "\"O, hã... o Cassius tá bem?\""

# game/a2s3.rpy:137
translate pt_br a2s3_2b056f1f:

    # mon "\"The false emperor? Yes, he's somewhere around here.\""
    mon "\"O falso imperador? Sim, ele está em algum lugar por aqui.\""

# game/a2s3.rpy:138
translate pt_br a2s3_d3acc7e5:

    # "The monitor looks about dismissively."
    "O monitor olha em volta com desdém."

# game/a2s3.rpy:139
translate pt_br a2s3_a70d69f1:

    # m "\"Did he hear us?\""
    m "\"Ele nos ouviu?\""

# game/a2s3.rpy:140
translate pt_br a2s3_2a5220f9:

    # mon "\"No, he's too busy panicking. A side-effect of being a coward imposter.\""
    mon "\"Não, ele está muito ocupado entrando em pânico. Um efeito colateral de ser um impostor covarde.\""

# game/a2s3.rpy:141
translate pt_br a2s3_c000bb8e:

    # "I frown, feeling that's a bit harsh, even on someone like Cassius."
    "Eu faço uma careta, sentindo que isso é um pouco duro, até para alguém como o Cassius."

# game/a2s3.rpy:142
translate pt_br a2s3_7d5f75c2:

    # m "\"Can you...can you help him, maybe bring him here?\""
    m "\"Você pode... ajudar o coitado, trazer ele até aqui?\""

# game/a2s3.rpy:143
translate pt_br a2s3_ce014a87:

    # "I get a feeling from the monitor that I can only describe as an annoyed sigh."
    "Eu sinto uma sensação vindo do monitor que só consigo descrever como um suspiro de aborrecimento."

# game/a2s3.rpy:144
translate pt_br a2s3_95dab2d7:

    # mon "\"I suppose.\""
    mon "\"Creio que sim.\""

# game/a2s3.rpy:145
translate pt_br a2s3_474309d5:

    # "A few moments pass before I start to see something appear next to me."
    "Alguns momentos se passam antes que eu comece a enxergar algo aparecendo ao meu lado."

# game/a2s3.rpy:147
translate pt_br a2s3_5a414fc1:

    # "The unmistakable shape of Cassius materializes, frightened and shaking."
    "A forma inconfundível do Cassius se materializa, assustada e trêmula."

# game/a2s3.rpy:148
translate pt_br a2s3_5648e05a:

    # "He immediately sees me."
    "Ele imediatamente me vê."

# game/a2s3.rpy:150
translate pt_br a2s3_688b3c80:

    # c "\"[mc]!? Where are we? What's happened? Are you—\""
    c "\"[mc]!? Onde estamos? O que aconteceu? Você está—\""

# game/a2s3.rpy:151
translate pt_br a2s3_02bf1091:

    # "Then he sees the monitor."
    "Então ele nota o monitor."

# game/a2s3.rpy:153
translate pt_br a2s3_0c05a9bf:

    # c "\"Agh!\""
    c "\"Agh!\""

# game/a2s3.rpy:154
translate pt_br a2s3_13537808:

    # "He jumps behind me, shielding himself from the creature."
    "Ele pula para trás de mim, fazendo meu corpo de escudo contra a criatura."

# game/a2s3.rpy:155
translate pt_br a2s3_1808daf1:

    # c "\"The demon! Help me!\""
    c "\"É o demônio! Socorro!\""

# game/a2s3.rpy:156
translate pt_br a2s3_c1a58595:

    # "I get that feeling of amusement from the dragon creature again, and I frown."
    "Eu capto aquela sensação de entretido da criatura dragão outra vez e estreito os olhos."

# game/a2s3.rpy:157
translate pt_br a2s3_bb5d41bd:

    # m "\"Have you been scaring him?\""
    m "\"Você tava assustando ele?\""

# game/a2s3.rpy:158
translate pt_br a2s3_16f93144:

    # "I get the feeling of a shrug from the creature."
    "Eu capto o sentimento de um dar de ombros da criatura."

# game/a2s3.rpy:159
translate pt_br a2s3_e8225aa7:

    # mon "\"If he's scared that's his choice.\""
    mon "\"Se ele está assustado, a escolha é dele.\""

# game/a2s3.rpy:160
translate pt_br a2s3_7e7eed74:

    # m "\"And the parents are okay with you doing that?\""
    m "\"E os progenitores ficam de boa com você fazendo isso?\""

# game/a2s3.rpy:161
translate pt_br a2s3_c08ba5e9:

    # mon "\"Possibly not, but the white wolf means little to them.\""
    mon "\"Possivelmente não, mas o lobo branco significa pouco para eles.\""

# game/a2s3.rpy:163
translate pt_br a2s3_fb70ab3e:

    # c "\"What?\""
    c "\"O que?\""

# game/a2s3.rpy:164
translate pt_br a2s3_a9684113:

    # "That seems to get Cassius's attention, and he pokes his head around my side to glare at the monitor."
    "Isso parece chamar a atenção do Cassius e ele inclina a cabeça para olhar atrás de mim, encarando o monitor."

# game/a2s3.rpy:165
translate pt_br a2s3_06b24b95:

    # ca "\"E-excuse me, but I am the emperor—\""
    ca "\"C-com licença, mas eu sou o imperador—\""

# game/a2s3.rpy:166
translate pt_br a2s3_024a03ea:

    # mon "\"No, you are not.\""
    mon "\"Não, você não é.\""

# game/a2s3.rpy:167
translate pt_br a2s3_91076a2c:

    # "I frown, the scene growing more and more surreal before me."
    "Eu levanto uma sobrancelha, a cena ficando cada vez mais surreal diante de mim."

# game/a2s3.rpy:169
translate pt_br a2s3_1ddc86d2:

    # c "\"Excuse me!?\""
    c "\"Como é que é!?\""

# game/a2s3.rpy:171
translate pt_br a2s3_a2a6a5df:

    # "Cassius seems unable to think of anything else to say."
    "Cassius parece incapaz de pensar em qualquer coisa a mais para dizer."

# game/a2s3.rpy:172
translate pt_br a2s3_422db174:

    # "Just as I'm about to step between the two of them, I find myself unable to hold my consciousness together any longer and I begin to drift off..."
    "Mas assim que estou prestes a intervir na conversa dos dois, me pego incapaz de manter minha consciência no lugar por mais tempo e começo a adormecer..."

# game/a2s3.rpy:175
translate pt_br a2s3_5b6b3f6b:

    # "Slowly, I come to on the sofa, my eyes cracking open as I wince at the throbbing headache I have."
    "Lentamente, volto ao sofá, meus olhos se abrindo imediatamente enquanto me contorço com a dor de cabeça latejante que tenho."

# game/a2s3.rpy:176
translate pt_br a2s3_5249355a:

    # "There's a cold sensation around my mouth and I reach up to feel that I've been drooling all over myself."
    "Há uma sensação gelada ao redor da minha boca e eu levanto minha mão para descobrir que estava babando em cima de mim esse tempo todo."

# game/a2s3.rpy:177
translate pt_br a2s3_9b14a9d3:

    # "I roll over, feeling a wave of dizziness as I do."
    "Eu rolo para o lado, sentindo uma onda de tontura enquanto faço isso."

# game/a2s3.rpy:178
translate pt_br a2s3_8a0d55cc:

    # "I pause there, waiting for the wooziness to pass."
    "Faço uma pausa, esperando a tontura passar."

# game/a2s3.rpy:179
translate pt_br a2s3_c6ab2354:

    # "When it finally does, I'm able to focus better on my surroundings."
    "Quando finalmente passa, sou capaz de me concentrar melhor em meus arredores."

# game/a2s3.rpy:180
translate pt_br a2s3_78051807:

    # "I stare a full ten seconds before I remember where I am, and what I'm doing there."
    "Eu fico olhando para o nada por dez segundos antes de me lembrar onde estou e o que estou fazendo aqui."

# game/a2s3.rpy:181
translate pt_br a2s3_c3359226:

    # "I look over at the bed and see Cassius lying spread-eagle on the covers, his eyes fluttering."
    "Olho para a cama e vejo o Cassius esparramado em cima dos cobertores, seus olhos tremendo."

# game/a2s3.rpy:182
translate pt_br a2s3_d2616c92:

    # "I watch him for a while, realizing that he's still unconscious."
    "Eu o observo por um tempo, percebendo que ele ainda está inconsciente."

# game/a2s3.rpy:183
translate pt_br a2s3_0c37fe87:

    # "He did take in a lot more of the drug than I had, so I guess that makes sense."
    "Ele inalou a droga muito mais do que eu, então acho que isso faz sentido."

# game/a2s3.rpy:184
translate pt_br a2s3_b524dd81:

    # "Very slowly, I slide my legs off of the sofa and sit there as a second dizzy spell overtakes me."
    "Bem lentamente, deslizo minhas pernas para fora do sofá e fico sentado enquanto uma segunda leva de tontura me domina."

# game/a2s3.rpy:185
translate pt_br a2s3_20d4865f:

    # "I wait a solid minute for this one to pass so that when I stand up I don't end up just falling over."
    "Eu espero um minuto para essa passar de forma que não acabe caindo quando me levantar."

# game/a2s3.rpy:186
translate pt_br a2s3_991cd81c:

    # "When I'm able to do that, I stumble to the bathroom, feeling more and more clear-headed by the second."
    "Quando consigo fazer isso, tropeço até o banheiro, me sentindo cada vez mais tonto a cada segundo."

# game/a2s3.rpy:189
translate pt_br a2s3_7bf77408:

    # "When I get to the sink, I rest there, staring at myself in the mirror."
    "Quando chego até a pia, repouso minhas mãos em cima dela, encarando a mim mesmo no espelho."

# game/a2s3.rpy:190
translate pt_br a2s3_f8110bc5:

    # "My eyes are red and my hair is messed up in every direction."
    "Meus olhos estão vermelhos e meu cabelo bagunçado em todas as direções."

# game/a2s3.rpy:191
translate pt_br a2s3_37f5657b:

    # "I wet one of the towels and wash my face and by the time I'm finished, I feel mostly better."
    "Eu molho uma das toalhas, lavo meu rosto e assim que termino, me sinto muito melhor."

# game/a2s3.rpy:192
translate pt_br a2s3_0392df0b:

    # "As I rest there against the sink, I think back to what just happened."
    "Enquanto descanso contra a pia, recapitulo tudo o que acabou de acontecer."

# game/a2s3.rpy:193
translate pt_br a2s3_886664fc:

    # "Not just the drug trip I'd been sent on, but what I'd been told."
    "Não só a viagem nas drogas a qual eu fui submetido, mas o que me disseram."

# game/a2s3.rpy:194
translate pt_br a2s3_c0be3eb7:

    # "All the dreams I'd had since being on this moon; I remember everything."
    "Todos os sonhos que tive desde que pousei nessa lua; eu me lembro de todos eles."

# game/a2s3.rpy:195
translate pt_br a2s3_31ecaf90:

    # "I don't know if it's real or not, if I'd really just spoken to the parents."
    "Não sei se foi real ou não, se eu realmente acabei de falar com os progenitores."

# game/a2s3.rpy:196
translate pt_br a2s3_1c31f360:

    # "It had seemed too intricate to not be real."
    "Pareceu muito complicado para não ser real."

# game/a2s3.rpy:197
translate pt_br a2s3_35afd58c:

    # "My mind wouldn't be able to make up something like that, would it?"
    "Minha mente não seria capaz de inventar algo assim, seria?"

# game/a2s3.rpy:198
translate pt_br a2s3_968ddef1:

    # "Then again, I don't know what Cassius was smoking."
    "Mas também, não sei o que o Cassius fumou."

# game/a2s3.rpy:199
translate pt_br a2s3_bde2a58d:

    # "As if on cue, I hear the wolf snort in the bedroom and I make my way out of the bathroom, finding Cassius on his side now, facing away from me."
    "Falando no diabo, ouço o lobo bufar no quarto e saio do banheiro, encontrando Cassius deitado de lado agora, olhando na direção contrária."

# game/a2s3.rpy:201
translate pt_br a2s3_16cf3218:

    # m "\"Cassius?\""
    m "\"Cassius?\""

# game/a2s3.rpy:202
translate pt_br a2s3_7100a56d:

    # "Slowly, I walk around the bed and see that the wolf's eyes, just as red as mine, are open, staring off into space."
    "Lentamente dou a volta na cama e vejo que os olhos do lobo, tão vermelhos quanto os meus, estão abertos e olhando para o nada."

# game/a2s3.rpy:203
translate pt_br a2s3_aa593a1b:

    # "I try again."
    "Eu tento outra vez."

# game/a2s3.rpy:204
translate pt_br a2s3_19c32e41:

    # m "\"Cassius? You okay?\""
    m "\"Cassius? Você tá bem?\""

# game/a2s3.rpy:205
translate pt_br a2s3_be700a8a:

    # "The wolf mumbles something, not even looking at me."
    "O lobo murmura alguma coisa sem nem olhar para mim."

# game/a2s3.rpy:206
translate pt_br a2s3_7b1cc89c:

    # "I walk up to the side of the bed, reaching out tentatively before gently touching him on the arm."
    "Eu ando até o lado da cama, estendendo a mão timidamente antes de tocá-lo gentilmente no braço."

# game/a2s3.rpy:207
translate pt_br a2s3_a1964722:

    # "That seems to jolt him from his daze and he jerks away, gasping in surprise and fear as he pulls back and looks up at me."
    "Isso parece lançá-lo para fora de seu estado confuso e ele empurra minha mão, ofegando de surpresa e medo enquanto se afasta e olha para mim."

# game/a2s3.rpy:208
translate pt_br a2s3_fc9be712:

    # "I hold my hands up to show him that I mean no harm, and he stares at me for what feels like over a minute."
    "Levanto minhas mãos para cima visando mostrar que não tenho intenção de machucar e ele me encara pelo que parece ser mais de um minuto."

# game/a2s3.rpy:209
translate pt_br a2s3_6ee5a5a0:

    # "Finally, he mumbles out my name."
    "Finalmente, ele murmura meu nome."

# game/a2s3.rpy:212
translate pt_br a2s3_b6a1573b:

    # c "\"[mc]...\""
    c "\"[mc]...\""

# game/a2s3.rpy:213
translate pt_br a2s3_6a4fe0df:

    # "I nod slowly, not wanting to make any sudden movements."
    "Eu concordo com a cabeça lentamente, não querendo fazer movimentos bruscos."

# game/a2s3.rpy:214
translate pt_br a2s3_7bb2dc1f:

    # m "\"Yes, I'm [mc]. You're in the palace, in Amicus's old ro—\""
    m "\"Sim, eu sou o [mc]. Você tá no palácio, no quarto antigo do Amic—\""

# game/a2s3.rpy:216
translate pt_br a2s3_cabcb19c:

    # c "\"I know where I am, idiot.\""
    c "\"Eu sei onde eu estou, idiota.\""

# game/a2s3.rpy:217
translate pt_br a2s3_5e90c62d:

    # "Seems like he's returning to his old self."
    "Parece que ele está voltando ao seu antigo eu."

# game/a2s3.rpy:218
translate pt_br a2s3_4eb17ed0:

    # m "\"Well, that's good. You had a pretty bad reaction to...whatever that was.\""
    m "\"Ah, isso é bom. Você teve uma reação bem ruim a... seja lá o que era aquilo lá.\""

# game/a2s3.rpy:219
translate pt_br a2s3_de0b6e59:

    # "Cassius is pushing himself up to a sitting position, doing it slowly just like I had."
    "Cassius começa a sentar, fazendo isso lentamente, assim como eu fiz antes."

# game/a2s3.rpy:221
translate pt_br a2s3_2d149393:

    # "He lets his head hang for a while, probably going through the same dizzy spells I'd just experienced."
    "Ele deixa a cabeça abaixada por um tempo, provavelmente passando pela mesma sensação de tontura a qual eu acabei de experimentar."

# game/a2s3.rpy:222
translate pt_br a2s3_45d3e3ca:

    # "I wait patiently, deciding to move back over to the sofa while I do."
    "Eu espero pacientemente, decidindo voltar para o sofá enquanto isso."

# game/a2s3.rpy:223
translate pt_br a2s3_0b7801e4:

    # "His ears perk up as I sit down, and he looks back up at me."
    "Suas orelhas se levantam conforme eu me sento e ele olha de volta para mim."

# game/a2s3.rpy:225
translate pt_br a2s3_17392bd3:

    # c "\"What are you doing?\""
    c "\"O que você está fazendo?\""

# game/a2s3.rpy:226
translate pt_br a2s3_e499761a:

    # "I frown."
    "Eu arqueio as sobrancelhas."

# game/a2s3.rpy:227
translate pt_br a2s3_9d3344cb:

    # m "\"What do you mean?\""
    m "\"Como assim?\""

# game/a2s3.rpy:229
translate pt_br a2s3_8f096ec6:

    # c "\"I mean why are you still here? You may leave.\""
    c "\"Digo, por que você ainda está aqui? Pode ir embora.\""

# game/a2s3.rpy:230
translate pt_br a2s3_6aeeb2fb:

    # m "\"Uh, I guess I could. I just want to make sure you're okay first.\""
    m "\"É, acho que eu poderia. Mas quero ter certeza de que você tá bem primeiro.\""

# game/a2s3.rpy:231
translate pt_br a2s3_0cd26afd:

    # "Cassius lets out a soft, indignant snort."
    "Cassius solta um bufo leve e indignado."

# game/a2s3.rpy:233
translate pt_br a2s3_715926ff:

    # c "\"You think I believe that? You're dismissed.\""
    c "\"Você acha que eu acredito nisso? Está dispensado.\""

# game/a2s3.rpy:234
translate pt_br a2s3_612ffb84:

    # "I give him an incredulous look."
    "Eu lanço nele um olhar de incredulidade."

# game/a2s3.rpy:235
translate pt_br a2s3_c35973a7:

    # m "\"Seriously? First of all, this is Amicus's room, second, I'm a Khemian. I don't see you ordering Neferu around like that.\""
    m "\"Sério? Primeiro, esse é o quarto do Amicus, segundo, eu sou um khemiano. Não vejo você dando ordens ao Neferu por aí assim.\""

# game/a2s3.rpy:236
translate pt_br a2s3_957d5db4:

    # "This time Cassius lets out a louder snort."
    "Dessa vez Cassius solta um bufo mais alto."

# game/a2s3.rpy:238
translate pt_br a2s3_45893df9:

    # c "\"Ha! He's royalty, and an actual Khemian, you think that I'd pay you the same—\""
    c "\"Ha! Ele é da realeza e um khemiano de verdade, você acha que eu trataria você da mesma—\""

# game/a2s3.rpy:239
translate pt_br a2s3_d264ff08:

    # m "\"Khemians see all their citizens as equals. I'm worth just as much as he is in their eyes.\""
    m "\"Os khemianos enxergam todos os cidadãos deles como iguais. Eu tenho tanto valor quanto o Neferu aos olhos deles.\""

# game/a2s3.rpy:240
translate pt_br a2s3_33747a4c:

    # "Instead of snapping back, Cassius just lowers his head, eyes closed before he lets out a deep, forlorn sigh."
    "Em vez de retrucar, Cassius só abaixa a cabeça, os olhos fechados antes que ele solte um suspiro profundo e desamparado."

# game/a2s3.rpy:242
translate pt_br a2s3_243d2427:

    # c "\"I'm tired, if you wish to antagonize me please leave it for another time.\""
    c "\"Eu estou cansado, se você deseja me antagonizar, por favor, guarde isso para outra ocasião.\""

# game/a2s3.rpy:243
translate pt_br a2s3_7abd3a7f:

    # "I've been pushing the boundaries with Cassius on purpose to see what the limits are, and I'm getting more comfortable conversing with him without fear."
    "Eu venho forçando os limites com o Cassius de propósito para ver quão longe eu posso ir e fico mais confortável em conversar com ele sem medo."

# game/a2s3.rpy:244
translate pt_br a2s3_9924f442:

    # "Still, I'm a bit taken aback at Cassius's sudden tone of defeat."
    "Ainda assim, fico um pouco surpreso com o repentino tom de derrota dele."

# game/a2s3.rpy:245
translate pt_br a2s3_03173735:

    # "It's one that I haven't heard often."
    "É um o qual não presenciei muitas vezes."

# game/a2s3.rpy:246
translate pt_br a2s3_81b471df:

    # "We're both silent for a minute or so, then I finally speak up."
    "Nós dois ficamos em silêncio por um minuto ou mais, então eu finalmente falo."

# game/a2s3.rpy:247
translate pt_br a2s3_0d25a391:

    # m "\"Um...so what was that? That smoke stuff? It was a drug, right?\""
    m "\"Hm... então, o que era aquilo? Aquele troço de fumaça? Era uma droga, né?\""

# game/a2s3.rpy:248
translate pt_br a2s3_cd2f6cf9:

    # "Cassius is silent for a bit longer, and I wonder if he's going to ask me to leave again, but instead he just sighs and finally looks up, his eyes looking a bit more clear now."
    "Cassius fica em silêncio por mais um tempo e eu me pergunto se ele vai me pedir para sair de novo, em vez disso, ele simplesmente suspira e finalmente olha para cima, seus olhos parecendo um pouco mais claros agora."

# game/a2s3.rpy:250
translate pt_br a2s3_be6baee5:

    # c "\"It's called {i}somni{/i}, a plant from the southern region of this continent. It helps us connect to the parents.\""
    c "\"Se chama {i}somni{/i}, uma planta da região sul deste continente. Ajuda a nos conectar com os progenitores.\""

# game/a2s3.rpy:251
translate pt_br a2s3_6604d52a:

    # m "\"Yeah...you said it's the traditional way?\""
    m "\"É... você disse que era o jeito tradicional?\""

# game/a2s3.rpy:252
translate pt_br a2s3_16ef3920:

    # c "\"The old way, yes. Usually we communicate through parental tech, but as you know, they're not currently speaking to with us with that method.\""
    c "\"O jeito antigo, sim. Normalmente nós nos comunicamos através de tecnologia progenitora, mas como você sabe, eles não estão falando conosco por esse método no momento.\""

# game/a2s3.rpy:253
translate pt_br a2s3_9d772693:

    # m "\"Sooo...this forces it to happen?\""
    m "\"Entããão... isso força a comunicação a acontecer?\""

# game/a2s3.rpy:254
translate pt_br a2s3_8af938f0:

    # c "\"In a way.\""
    c "\"De certa forma.\""

# game/a2s3.rpy:255
translate pt_br a2s3_189a1c5e:

    # m "\"Does it work?\""
    m "\"E funciona?\""

# game/a2s3.rpy:257
translate pt_br a2s3_9aedace5:

    # "Cassius glares at me."
    "Cassius me encara."

# game/a2s3.rpy:258
translate pt_br a2s3_effd5a14:

    # c "\"You would know. You were there.\""
    c "\"Você saberia. Você estava lá.\""

# game/a2s3.rpy:259
translate pt_br a2s3_c106b8c3:

    # "I go silent, that statement coming as a surprise to me."
    "Eu fico em silêncio, essa afirmação vindo como uma surpresa para mim."

# game/a2s3.rpy:260
translate pt_br a2s3_7e1b3886:

    # "I'd seen Cassius, of course, but I'd thought it had only been part of the hallucination."
    "Eu vi o Cassius, é claro, mas achei que isso só tivesse sido parte da alucinação."

# game/a2s3.rpy:261
translate pt_br a2s3_f8335145:

    # m "\"You...saw me?\""
    m "\"Você... me viu?\""

# game/a2s3.rpy:262
translate pt_br a2s3_b0981877:

    # c "\"Oh please, simian...or whatever the hell you are. You're only trying to humiliate me further. I was right next to you.\""
    c "\"Ah, por favor, símio... ou seja lá que diabos você é. Só está tentando me humilhar ainda mais. Eu estava bem ao seu lado.\""

# game/a2s3.rpy:263
translate pt_br a2s3_3012968a:

    # "So that had been real?"
    "Então isso foi real?"

# game/a2s3.rpy:264
translate pt_br a2s3_49e934c9:

    # "I sit back on my hands, contemplating all of this."
    "Eu encosto no sofá, ponderando sobre tudo isso."

# game/a2s3.rpy:265
translate pt_br a2s3_f8afc45d:

    # "I've read about DMT experiences back on Earth, how if you break through, you can meet extra-dimensional beings that tell you the secrets of the universe."
    "Já li sobre experiências com drogas psicodélicas na Terra. Sobre como se você conseguir ultrapassar os limites, poderá encontrar seres extradimensionais que te contam os segredos do universo."

# game/a2s3.rpy:266
translate pt_br a2s3_40a40030:

    # "I would have considered my experience to be all in my head, but if Cassius was actually there..."
    "Eu consideraria minha experiência como sendo tudo fruto da minha imaginação, mas se o Cassius realmente foi parar lá..."

# game/a2s3.rpy:268
translate pt_br a2s3_3ee5b5fb:

    # "I notice then that Cassius is looking very closely at me, gauging my expression."
    "Percebo então que ele está olhando bem de perto para mim, avaliando minha expressão."

# game/a2s3.rpy:269
translate pt_br a2s3_df8ec4bc:

    # m "\"What?\""
    m "\"Que foi?\""

# game/a2s3.rpy:270
translate pt_br a2s3_5048311e:

    # c "\"He spoke to you, didn't he? What did he say?\""
    c "\"Ele falou com você, não falou? O que ele disse?\""

# game/a2s3.rpy:271
translate pt_br a2s3_104f1665:

    # m "\"Uhhh...\""
    m "\"Hã...\""

# game/a2s3.rpy:272
translate pt_br a2s3_d5c3c8d7:

    # "I try to think of what to say."
    "Eu tento pensar no que dizer."

# game/a2s3.rpy:273
translate pt_br a2s3_5af18bd8:

    # "If this is real, then I doubt telling Cassius everything will help me out in any way."
    "Se isso foi real, então duvido que contar tudo ao Cassius vai me ajudar de qualquer maneira que seja."

# game/a2s3.rpy:274
translate pt_br a2s3_14a6c9af:

    # "He must see the hesitation on my face, because his fur bristles."
    "Ele parece ver a hesitação em meu rosto, porque seus pelos se arrepiam."

# game/a2s3.rpy:276
translate pt_br a2s3_b95026ea:

    # c "\"The emperor demands you tell him what they told you!\""
    c "\"O imperador demanda que você conte o que eles lhe disseram!\""

# game/a2s3.rpy:277
translate pt_br a2s3_df069bc9:

    # "I glance up at Cassius, feeling less and less afraid of him with every threat he sends my way."
    "Eu olho para o Cassius, sentindo cada vez menos medo dele com cada ameaça que ele faz para mim."

# game/a2s3.rpy:278
translate pt_br a2s3_26fdfb6e:

    # "He really is all bark and no bite."
    "Cão que ladra não morde, de fato."

# game/a2s3.rpy:279
translate pt_br a2s3_f826fe04:

    # m "\"He just sort of asked me what I was doing there. That's it.\""
    m "\"Ele só meio que me perguntou o que eu tava fazendo lá. Basicamente isso.\""

# game/a2s3.rpy:280
translate pt_br a2s3_ac9af600:

    # "Cassius glares at me before finally seeming defeated once again, looking down."
    "Cassius me encara antes de finalmente parecer derrotado mais uma vez, olhando para baixo."

# game/a2s3.rpy:282
translate pt_br a2s3_337ac9ab:

    # m "\"But he seemed okay with me being here. He was a monitor too. I don't think Amicus is in trouble.\""
    m "\"Mas ele parecia de boa comigo estando aqui. Ele era um monitor, aliás. Não acho que o Amicus esteja encrencado.\""

# game/a2s3.rpy:283
translate pt_br a2s3_1050aea7:

    # "Cassius shakes his head."
    "Cassius balança a cabeça."

# game/a2s3.rpy:284
translate pt_br a2s3_fb41345e:

    # c "\"I don't trust anything he said. He was a demon.\""
    c "\"Eu não confio em nada do que ele disse. Ele era um demônio.\""

# game/a2s3.rpy:285
translate pt_br a2s3_3f739ce1:

    # "I sigh."
    "Eu suspiro."

# game/a2s3.rpy:286
translate pt_br a2s3_58e334f2:

    # m "\"What did they say to {i}you{/i}? You looked pretty scared.\""
    m "\"O que ele disse pra {i}você{/i}? Você parecia bem assustado.\""

# game/a2s3.rpy:288
translate pt_br a2s3_aaecfd3a:

    # c "\"I was not scared!\""
    c "\"Eu não estava assustado!\""

# game/a2s3.rpy:289
translate pt_br a2s3_5195cedf:

    # "I let out an involuntary laugh before I can stop it."
    "Eu solto uma risada involuntária antes que possa pará-la."

# game/a2s3.rpy:291
translate pt_br a2s3_f9563f37:

    # c "\"Damn you! I was simply unprepared for the experience; it was much more intense than the previous one I had. That's all.\""
    c "\"Seu maldito! Eu estava simplesmente despreparado para a experiência; foi muito mais intensa do que a anterior. Só isso.\""

# game/a2s3.rpy:293
translate pt_br a2s3_10943343:

    # "Cassius looks at the ground again, and I can see that the insides of his ears are a burning red."
    "Cassius olha para o chão de novo e consigo notar que o interior de suas orelhas brilham um vermelho ardente."

# game/a2s3.rpy:294
translate pt_br a2s3_1cbf4704:

    # "I know that laughing at him was a shitty move on my part."
    "Eu sei que rir dele foi uma atitude escrota da minha parte."

# game/a2s3.rpy:295
translate pt_br a2s3_bfe057cf:

    # "I should be working to get him on my side, to help Amicus."
    "Eu deveria cultivar uma camaradagem com ele, para ajudar o Amicus."

# game/a2s3.rpy:296
translate pt_br a2s3_da66a371:

    # "I make an effort to get my expression under control."
    "Faço um esforço para controlar minha expressão."

# game/a2s3.rpy:297
translate pt_br a2s3_632a46c3:

    # m "\"Listen, I'm not against you Cassius. Actually, I think we're working together here. I'm just...trying to figure out how best to help your brother.\""
    m "\"Escuta, eu não tô contra você, Cassius. Na verdade, acho que estamos no mesmo barco aqui. Eu só... tô tentando descobrir a melhor forma de ajudar o seu irmão.\""

# game/a2s3.rpy:298
translate pt_br a2s3_fd9f219c:

    # "Cassius continues to stare silently at the floor, though I see an ear twitch as if acknowledging what I'd just said."
    "Cassius continua encarando o chão silenciosamente, mas eu consigo ver uma orelha sacudindo, sinal de que ele está ouvindo o que estou dizendo."

# game/a2s3.rpy:299
translate pt_br a2s3_26625c55:

    # m "\"If we're going to work together, we need to be at least a little bit honest with each other. Maybe I could help you figure some stuff out.\""
    m "\"Se vamos trabalhar juntos, precisamos pelo menos ser um pouco honestos um com o outro. Talvez eu possa te ajudar a descobrir alguma coisa.\""

# game/a2s3.rpy:300
translate pt_br a2s3_2244dadb:

    # "I realize how hypocritical that is, especially considering that I'm hiding what the parents had just told me."
    "Eu percebo como isso é hipócrita, especialmente considerando que estou escondendo o que os progenitores acabaram de me dizer."

# game/a2s3.rpy:301
translate pt_br a2s3_72597da9:

    # "Cassius lets out a skeptical huff."
    "Cassius deixa escapar uma arfada de ceticismo."

# game/a2s3.rpy:303
translate pt_br a2s3_96858bb3:

    # c "\"You, help me?\""
    c "\"Você, me ajudar?\""

# game/a2s3.rpy:304
translate pt_br a2s3_499b85ea:

    # m "\"Yes.\""
    m "\"Sim.\""

# game/a2s3.rpy:306
translate pt_br a2s3_987694ec:

    # "Cassius seems to contemplate, then shakes his head."
    "Cassius parece contemplar a possibilidade, então ele balança a cabeça."

# game/a2s3.rpy:307
translate pt_br a2s3_3ea7a89e:

    # c "\"Well, nothing there could help us. They simply torment me when I try to communicate with them.\""
    c "\"Bem, nada lá poderia nos ajudar. Eles simplesmente me tormentam quando eu tento me comunicar.\""

# game/a2s3.rpy:308
translate pt_br a2s3_9ba15f5d:

    # m "\"Torment?\""
    m "\"Tormentam?\""

# game/a2s3.rpy:310
translate pt_br a2s3_0d89b7c4:

    # c "\"They appear as demons and taunt me. It seems that the parents truly do want to cut off contact with us...which I'm fine with.\""
    c "\"Eles aparecem como demônios e me provocam. Parece que os progenitores realmente querem cortar contato conosco... e tudo bem para mim.\""

# game/a2s3.rpy:311
translate pt_br a2s3_18d06ade:

    # "Cassius says that last bit with such meek defiance that I almost feel sorry for him."
    "Cassius fala essa última parte com uma provocação tão mansa que eu quase me sinto mal por ele."

# game/a2s3.rpy:312
translate pt_br a2s3_e312ddd5:

    # m "\"Maybe it was just the drug? I've heard plenty of stories of people freaking out on mind-altering stuff, especially if they have problems with anxiety—\""
    m "\"Talvez tenha sido só a droga? Eu já ouvi muitas histórias de pessoas enlouquecendo com coisas que alteram a mente, especialmente se elas têm problemas de ansiedade—\""

# game/a2s3.rpy:314
translate pt_br a2s3_df0a3e5c:

    # c "\"I do not have a weak mind, [mc].\""
    c "\"Eu não tenho uma mente fraca, [mc].\""

# game/a2s3.rpy:315
translate pt_br a2s3_9f208e16:

    # m "\"Th—that doesn't mean you have a weak mind, sometimes you just—\""
    m "\"I—isso não significa que você tem uma mente fraca, algumas vezes só—\""

# game/a2s3.rpy:317
translate pt_br a2s3_1c779b3e:

    # c "\"Enough. I will not have you speculating about my mental capacities.\""
    c "\"Chega. Não quero você especulando sobre minhas capacidades mentais.\""

# game/a2s3.rpy:318
translate pt_br a2s3_30409fb6:

    # "This time I'm the one sighing, wondering for the hundredth time how the hell this wolf is Amicus's brother."
    "Dessa vez, sou eu quem suspiro, me perguntando pela centésima vez como diabos esse lobo pode ser o irmão do Amicus."

# game/a2s3.rpy:319
translate pt_br a2s3_cdbbedc4:

    # m "\"So they didn't say anything to you?\""
    m "\"Então, eles não falaram nada pra você?\""

# game/a2s3.rpy:320
translate pt_br a2s3_37ba7ed3:

    # "Cassius pauses, a frown tugging at the corners of his mouth."
    "Cassius pausa, os cantos de sua boca virados para baixo."

# game/a2s3.rpy:322
translate pt_br a2s3_b6cb7ad3:

    # c "\"No.\""
    c "\"Não.\""

# game/a2s3.rpy:323
translate pt_br a2s3_83b2a1c1:

    # "I raise an eyebrow at him."
    "Eu levanto uma sobrancelha para ele."

# game/a2s3.rpy:325
translate pt_br a2s3_610c980e:

    # c "\"What? Of course they said things to me, but nothing useful.\""
    c "\"O que? É claro que eles disseram coisas para mim, mas nada que seja útil.\""

# game/a2s3.rpy:326
translate pt_br a2s3_4dd72ad2:

    # m "\"You sure?\""
    m "\"Você tem certeza?\""

# game/a2s3.rpy:328
translate pt_br a2s3_8a85f49b:

    # c "\"Of course I'm sure! The parents have turned on us. That's all that I need to know.\""
    c "\"É claro que eu tenho certeza! Os progenitores se voltaram contra nós. É tudo o que eu preciso saber.\""

# game/a2s3.rpy:330
translate pt_br a2s3_5945acb3:

    # "I think back to the conversation we'd had in the hallucination."
    "Eu penso de volta na conversa que nós tivemos na alucinação."

# game/a2s3.rpy:331
translate pt_br a2s3_fdacc4f0:

    # "The monitor had told both of us that Cassius isn't the emperor, and if Cassius had heard what I heard, then that's probably what he's thinking about right now."
    "O monitor falou para nós dois que o Cassius não era o imperador, e ele ouviu o que eu ouvi, então provavelmente é nisso que ele está pensando agora."

# game/a2s3.rpy:332
translate pt_br a2s3_c7109cc4:

    # "But I know now isn't the time to challenge him, and I can tell that he's still trying to recover from the trip."
    "Mas eu sei que agora não é hora de desafiá-lo e posso dizer que ele ainda está tentando se recuperar da viagem."

# game/a2s3.rpy:333
translate pt_br a2s3_47d846b6:

    # "Still, looking at him right now, staring at the ground, looking disheveled and defeated...I feel myself wanting to help him."
    "Ainda assim, olhando para ele agora, encarando o chão, com o pelo desgrenhado e postura de derrota... eu sinto que deveria ajudar ele."

# game/a2s3.rpy:334
translate pt_br a2s3_173823de:

    # "Out of everyone on this moon, he seems to be the most stressed out, and I feel bad for him despite everything that's happened."
    "De todos os que estão nessa lua, ele parece ser o mais estressado e me sinto mal por ele, apesar de tudo o que aconteceu."

# game/a2s3.rpy:336
translate pt_br a2s3_3e8aa343:

    # "But I know he doesn't want my pity right now."
    "Mas eu sei que ele não quer minha pena agora."

# game/a2s3.rpy:337
translate pt_br a2s3_f800d3e7:

    # "So, I eventually leave Cassius alone on the bed and wander back out into the halls, feeling as if weeks had past since I'd last been out here."
    "Então, eventualmente deixo Cassius sozinho na cama e volto para os corredores, sentindo como se tivessem passado semanas desde a última vez que estive aqui."

# game/a2s3.rpy:340
translate pt_br a2s3_ce0e3b47:

    # "I think back to what that dragon-like creature had told me, about how I'm here for a reason, that this has all been planned out."
    "Penso de volta no que aquela criatura parecida com um dragão me disse, sobre eu estar aqui por uma razão, que tudo isso foi planejado."

# game/a2s3.rpy:341
translate pt_br a2s3_c5b97e3c:

    # "Planned out by parents who seem to be completely frustrated at the behavior of the wolves and their inability to follow through on their \"plans\"."
    "Planejado por progenitores que parecem estar completamente frustrados com o comportamento dos lobos e sua inabilidade de seguir com os seus \"planos\"."

# game/a2s3.rpy:342
translate pt_br a2s3_913db4f3:

    # "For a brief moment, I wonder how much more smoothly things would have gone if I'd been abducted by someone like Neferu and taken to somewhere like Khemia."
    "Por um breve momento, me pergunto como as coisas teriam sido muito mais tranquilas se eu tivesse sido abduzido por alguém como o Neferu e levado para algum lugar como Khemia."

# game/a2s3.rpy:343
translate pt_br a2s3_587b5766:

    # "But then I wouldn't have met Amicus."
    "Mas aí eu não teria conhecido o Amicus."

# game/a2s3.rpy:344
translate pt_br a2s3_0a2e958e:

    # "Besides, it seems like it's just the wolves that are giving the parents problems, not the other siblings."
    "Além disso, parece que só os lobos estão causando problemas para os progenitores, não os outros membros da irmandade."

# game/a2s3.rpy:345
translate pt_br a2s3_0c2dcd59:

    # "Which reminds me of the only bit of advice that the parents had given me; \"watch the cat\"."
    "O que me faz lembrar do único fragmento de informação que os progenitores me deram; \"observe o gato\"."

# game/a2s3.rpy:346
translate pt_br a2s3_858a1c91:

    # "Spy on Alexios."
    "Espiar o Alexios."

# game/a2s3.rpy:347
translate pt_br a2s3_e16fb8bb:

    # "That's something that I think I can do, if I'm careful."
    "É algo que acho que consigo fazer, se for cuidadoso."

# game/a2s3.rpy:348
translate pt_br a2s3_d8606503:

    # "Despite the new level of scrutiny I've fallen under, I've also been walking around the halls of the palace for the past few days without incidence."
    "Apesar do novo nível de observação ao qual eu fui submetido, também andei pelos corredores do palácio esses dias sem incidentes."

# game/a2s3.rpy:349
translate pt_br a2s3_d37519ed:

    # "I've even come across Cato a few times, but for whatever reason, he's completely ignored me."
    "Eu até me deparei com o Cato algumas vezes, mas sejá lá por qual razão, ele me ignorou completamente."

# game/a2s3.rpy:350
translate pt_br a2s3_85150b3e:

    # "All for the better."
    "Tudo pelo bem maior."

# game/a2s3.rpy:351
translate pt_br a2s3_f079bab7:

    # "So, I start to scour the palace for the cat."
    "Então, começo a vasculhar o palácio procurando o gato."

# game/a2s3.rpy:352
translate pt_br a2s3_6998aa33:

    # "He's actually pretty hard to find when he's not looking for you, but I at least know that he's usually in the gardens, if not in the hallways watering the plants."
    "Na verdade ele é bem difícil de achar quando não está procurando por você, mas pelo menos eu sei que ele normalmente fica no jardim, se não nos corredores regando as plantas."

# game/a2s3.rpy:353
translate pt_br a2s3_45312fb4:

    # "So after eating a quick lunch, I decide to start my search in the gardens."
    "Então, depois de comer um lanche rápido, decido começar a minha procura pelo jardim."

# game/a2s3.rpy:355
translate pt_br a2s3_5f517eab:

    # "I look back and forth through the foliage as I walk quietly along the various pathways."
    "Olho de um lado para o outro através da folhagem enquanto caminho silenciosamente pelas várias estradinhas."

# game/a2s3.rpy:356
translate pt_br a2s3_cfdef975:

    # "It's quiet, pleasant, and peaceful, but after everything that's happened, it has an ominous edge to it, like something could jump out at me at any moment."
    "É calmo, agradável e pacífico, mas depois de tudo o que aconteceu, há uma aura sinistra e perigosa, como se alguma coisa fosse pular na minha cara a qualquer momento."

# game/a2s3.rpy:357
translate pt_br a2s3_86f667ea:

    # "I do this for about half-an-hour before I start to realize how fruitless this search might be."
    "Eu faço isso por cerca de meia hora antes de começar a perceber o quão infrutífera essa busca pode ser."

# game/a2s3.rpy:358
translate pt_br a2s3_f4df9b11:

    # "Alex would be hard to find even if he {i}was{/i} out here, and besides, he could even be all the way out in the city doing his \"ambassador work\", whatever that is."
    "Alex seria difícil de encontrar mesmo se ele {i}estivesse{/i} por aqui, além disso, ele poderia estar na cidade fazendo seu \"trabalho de embaixador\", seja lá o que isso signifique."

# game/a2s3.rpy:359
translate pt_br a2s3_ccc9dcb1:

    # "Just as I'm about to give up though, I hear something."
    "Mas no momento o qual estou prestes a desistir, ouço algo."

# game/a2s3.rpy:360
translate pt_br a2s3_e5ceecfd:

    # "Sniffling, gasping, and...crying?"
    "Fungados, arfadas, e... choro?"

# game/a2s3.rpy:362
translate pt_br a2s3_3e1f701d:

    # "I pause, listening."
    "Eu paro, ouvindo."

# game/a2s3.rpy:363
translate pt_br a2s3_d90eda6c:

    # "It's a bit difficult to hear through the slight rustling of leaves in the wind, but there's definitely someone out here that sounds upset."
    "É um pouco difícil de escutar através do leve farfalhar das folhas ao vento, mas definitivamente há alguém por aí que parece chateado."

# game/a2s3.rpy:364
translate pt_br a2s3_26cbff0c:

    # "I can't really tell who it might be since it sounds like they're trying to keep quiet."
    "Eu realmente não consigo dizer quem pode ser já que soa como se a pessoa em questão estivesse tentando não fazer barulho."

# game/a2s3.rpy:365
translate pt_br a2s3_7b9d1168:

    # "That, and there's another sound too; another voice, and this one I recognize."
    "Isso, e há outro som também; outra voz, e essa eu reconheço."

# game/a2s3.rpy:366
translate pt_br a2s3_6f35370e:

    # "Alex."
    "Alex."

# game/a2s3.rpy:367
translate pt_br a2s3_72efeb62:

    # "It's a soft murmuring sound, like he's soothing someone, probably the person who's crying."
    "É um som de murmúrio suave, como se ele estivesse confortando alguém, provavelmente a pessoa que está chorando."

# game/a2s3.rpy:368
translate pt_br a2s3_485c967e:

    # "I wait there a few moments, waiting to see if the sound fades or gets closer which would tell me if they're moving, but it stays constant."
    "Eu fico lá ouvindo por um instante, esperando para ver se o som desaparece ou fica mais perto, o que me diria se eles estão se movendo, mas permanece constante."

# game/a2s3.rpy:369
translate pt_br a2s3_b09a401a:

    # "So, convinced that they're sitting down, or at least standing in the same spot, I creep closer to where the sound is coming from."
    "Então, convencido de que eles estão sentados, ou pelo menos parados de pé em algum lugar, me aproximo da origem do som."

# game/a2s3.rpy:370
translate pt_br a2s3_fd499d2a:

    # "It's in a secluded part of the garden, coming from a small square that's surrounded by trees and bushes."
    "Fica em uma parte isolada do jardim, vindo de uma pequena praça cercada por árvores e arbustos."

# game/a2s3.rpy:371
translate pt_br a2s3_adfdb3fb:

    # "I'm familiar with this square, the one with the statue of Drusus, where I'd been laid out to die."
    "Eu reconheço essa praça, é a que tem a estátua de Drusus, onde fui deixado para morrer."

# game/a2s3.rpy:372
translate pt_br a2s3_0da0a36a:

    # "I know that I can't use the little path that leads to the statue; I'd be seen for sure, so I walk up to the bushes that surround it and start looking for a break in the various branches and leaves."
    "Eu sei que não posso usar o caminho que leva até a estátua; seria visto com certeza, então ando até os arbustos que a cercam e começo a procurar por uma fresta entre os vários galhos e folhas."

# game/a2s3.rpy:373
translate pt_br a2s3_fc10204f:

    # "The sobbing sound continues, and I can hear Alex's voice more clearly now."
    "O som dos soluços continua e eu consigo ouvir a voz do Alex mais claramente agora."

# game/a2s3.rpy:374
translate pt_br a2s3_3b0cca7e:

    # "I still can't quite tell exactly what he's saying, but I catch the occasional \"don't worry\" and, \"all is well\"."
    "Ainda não consigo ouvir exatamente o que ele está dizendo, mas capto o ocasional \"não se preocupe\" e, \"está tudo bem\"."

# game/a2s3.rpy:375
translate pt_br a2s3_ecc925d8:

    # "I can't imagine what's happening in there."
    "Não consigo imaginar o que está acontecendo ali."

# game/a2s3.rpy:376
translate pt_br a2s3_2cc0fe8f:

    # "I start to wonder if this is exactly what the parents had hoped I would come across, and my heart starts to hammer in my chest."
    "Começo a me perguntar se era exatamente com isso o que os progenitores esperavam que eu me deparasse, e meu coração começa a martelar no meu peito."

# game/a2s3.rpy:377
translate pt_br a2s3_badb0621:

    # "Am I about to find something that's going to help me out of the mess we're in?"
    "Estou prestes a descobrir alguma coisa que vai me ajudar a sair da bagunça que nós entramos?"

# game/a2s3.rpy:378
translate pt_br a2s3_9262a26e:

    # "I finally find a thinner coverage in the foliage and I'm able to see through."
    "Finalmente, consigo encontrar uma cobertura mais fina na folhagem e sou capaz de ver através dela."

# game/a2s3.rpy:380
translate pt_br a2s3_cabdd85a:

    # "First, I see Alex, his back to me, crouched on the ground in front of the statue."
    "Primeiro eu vejo o Alex, suas costas viradas para mim, de pernas cruzadas no chão em frente à estátua."

# game/a2s3.rpy:381
translate pt_br a2s3_e2d160f6:

    # "He's draped over something...someone, hugging them, his face pressed to the side of their head."
    "Ele se encontra debruçado sobre algo... alguém, o abraçando, seu rosto pressionado contra a lateral da cabeça da pessoa."

# game/a2s3.rpy:382
translate pt_br a2s3_c2442cc4:

    # "I can only see their ears and parts of their shoulder, but I know right away that it's Cassius."
    "Eu só consigo enxergar as orelhas e parte dos ombros, mas eu sei imediatamente que é o Cassius."

# game/a2s3.rpy:383
translate pt_br a2s3_cf2bae17:

    # "He's got his head bowed deeply toward the ground, his paws to his face, shaking with his sobs."
    "Ele está com a cabeça inclinada profundamente na direção do chão, as patas em seu rosto, tremendo com os soluços."

# game/a2s3.rpy:384
translate pt_br a2s3_53dd5f61:

    # "Alex hugs him tightly, whispering into his ear, clearly trying to comfort him."
    "Alex abraça ele apertado, sussurando em seu ouvido, claramente tentando confortá-lo."

# game/a2s3.rpy:385
translate pt_br a2s3_2b021a44:

    # "Cassius only responds with an occasional shake of his head before finally blurting out;"
    "Cassius apenas responde com um ocasional aceno de cabeça antes de finalmente deixar escapar uma frase;"

# game/a2s3.rpy:386
translate pt_br a2s3_3ed77c9e:

    # c "\"But am I a fraud?\""
    c "\"Mas eu sou uma fraude?\""

# game/a2s3.rpy:387
translate pt_br a2s3_0871b487:

    # "His voice squeaks uncharacteristically on the last word and Alex responds with a gentle \"shh\" before nuzzling the wolf's muzzle."
    "Sua voz chia estranhamente na última palavra e Alex responde com um suave \"shh\" antes de acariciar o focinho do lobo."

# game/a2s3.rpy:388
translate pt_br a2s3_7dcc6237:

    # "I watch for a few more moments before drawing back, feeling uncomfortable, knowing that this is a private moment between the two of them."
    "Eu observo por mais alguns momentos antes de me afastar, me sentindo desconfortável, sabendo que isso é um momento privado entre os dois."

# game/a2s3.rpy:389
translate pt_br a2s3_0e0e52bc:

    # "I know now that this won't exactly help me in any way aside from making me feel even worse for Cassius."
    "Eu sei que isso não vai exatamente me ajudar de forma alguma agora além de fazer eu me sentir ainda pior pelo Cassius."

# game/a2s3.rpy:390
translate pt_br a2s3_5b14b0a5:

    # "Still, I've found Alex, so I move away, toward a bench that's further up the path, one that gives me a good view of the entrance to the square and at a distance that won't make me seem suspicious."
    "Ainda assim, eu encontrei o Alex, então me afasto em direção a um banco mais adiante no caminho, um que me dá uma boa visão da entrada da praça e em uma distância que não vai me fazer parecer suspeito."

# game/a2s3.rpy:391
translate pt_br a2s3_77413236:

    # "A good ten minutes pass before there's any movement."
    "Uns bons dez minutos se passam antes que haja qualquer movimento."

# game/a2s3.rpy:394
translate pt_br a2s3_da1c4d63:

    # "First, Cassius comes out, in the process of straightening out his armor, his expression blank as he stalks off up the path, away from me."
    "Primeiro, Cassius sai, no processo de endireitar sua armadura, sua expressão em branco enquanto ele segue o caminho na direção contrária."

# game/a2s3.rpy:395
translate pt_br a2s3_9e9ce8ee:

    # "I wait a while...a good while, maybe another five minutes, wondering if Alex somehow took a different exit from the square."
    "Eu espero por um tempo... bastante tempo, talvez outros cinco minutos, me perguntando se o Alex de algum jeito pegou uma saída diferente da praça."

# game/a2s3.rpy:396
translate pt_br a2s3_159c8fd3:

    # "But at that moment, I see him walk out, looking completely neutral as he looks around."
    "Mas na mesma hora, vejo ele saindo, parecendo completamente neutro enquanto olha em volta."

# game/a2s3.rpy:397
translate pt_br a2s3_1afed2a8:

    # "I freeze up, positive that he's about to see me even though that would be okay, but he instead walks straight ahead, toward the pond."
    "Eu congelo, convencido de que ele está prestes a me ver, por mais que não seja um problema caso aconteça, mas ao invés disso, ele anda reto em direção à lagoa."

# game/a2s3.rpy:398
translate pt_br a2s3_564d4111:

    # "I watch him go for a while, then follow."
    "Eu assisto por um momento enquanto ele vai, então o sigo."

# game/a2s3.rpy:399
translate pt_br a2s3_f7698bbb:

    # "It feels strange trying to spy on the pet ambassador like this, especially when I have no idea what I'm doing."
    "Me sinto estranho tentando espiar o mascote embaixador desse jeito, especialmente quando eu não faço ideia do que estou fazendo."

# game/a2s3.rpy:400
translate pt_br a2s3_c068850d:

    # "But this is the only hint I was given to free Amicus, and if this is the only way, then I'm going to do it."
    "Mas essa é a única dica que me deram para libertar o Amicus e se esse é o único jeito, então é o que eu vou fazer."

# game/a2s3.rpy:404
translate pt_br a2s3_07921d2d:

    # "I find the cat at the pillars, already pulling away at the weeds."
    "Encontro o gato nos pilares, já puxando as ervas daninhas."

# game/a2s3.rpy:405
translate pt_br a2s3_b13fc527:

    # "I sigh and wait, watching for a while, realizing that this could last hours since Alex always seemed to enjoy weeding for some reason."
    "Eu suspiro e espero, assistindo por um tempo, percebendo que isso poderia durar horas já que o Alex sempre parece apreciar essa atividade por algum motivo."

# game/a2s3.rpy:406
translate pt_br a2s3_0f08c69c:

    # "The cat is so meticulous about gardening here, and I have to wonder why considering his efforts really wouldn't be all that visible in a garden this big."
    "O gato é tão meticuloso sobre jardinagem aqui e eu tenho que me perguntar o porquê considerando que seus esforços não seriam realmente tão visíveis em um jardim tão grande como esse."

# game/a2s3.rpy:407
translate pt_br a2s3_645aac99:

    # "But I remind myself of why I'm here and settle down on another bench, one that's also a good distance away so that I won't seem too suspicious if he sees me."
    "Mas eu me lembro por que estou aqui e me sento em outro banco, um que também se encontra a uma boa distância dele de forma que eu não pareça muito suspeito se ele me ver."

# game/a2s3.rpy:409
translate pt_br a2s3_83160dea:

    # "This time, I sit there for a few hours, occasionally adjusting the way I'm seated as my ass gets sore on the stone bench, and as the sun sets, I realize how boring spying actually is."
    "Dessa vez eu sento lá por algumas horas, ocasionalmente ajustando minha posição quando meu traseiro fica dolorido no banco de pedra. Assim que o sol se põe, percebo o quanto espionagem é uma atividade realmente tediosa."

# game/a2s3.rpy:412
translate pt_br a2s3_3ff4889b:

    # "Around the second hour, the sun has completely set, and I debate just giving up and trying another day."
    "Pela segunda hora, o sol já se pôs completamente e eu me pergunto se não é melhor desistir e tentar de novo outro dia."

# game/a2s3.rpy:413
translate pt_br a2s3_2908d44b:

    # "At that moment, a drone suddenly drifts up to me, making me jump and duck my head down a little bit, as if that will help hide me from Alex."
    "Naquele momento, um drone de repente vem até mim, me fazendo saltar e abaixar a cabeça um pouco como se isso fosse ajudar a me esconder do Alex."

# game/a2s3.rpy:414
translate pt_br a2s3_bc7eacdd:

    # com "\"Neferu requests—\""
    com "\"Neferu solicita—\""

# game/a2s3.rpy:415
translate pt_br a2s3_075fbd39:

    # m "\"Shh!\""
    m "\"Shh!\""

# game/a2s3.rpy:416
translate pt_br a2s3_e73188bb:

    # "I hiss at the drone, and Com's voice automatically dips into a whisper and goes on as if nothing had happened."
    "Eu mando o drone fazer silêncio e a voz do Com automaticamente abaixa para um sussurro e continua como se nada tivesse acontecido."

# game/a2s3.rpy:417
translate pt_br a2s3_b3e7e2c9:

    # com "\"—your location and if you need his assistance.\""
    com "\"—saber sua localização e se você precisa de sua assistência.\""

# game/a2s3.rpy:418
translate pt_br a2s3_df1716ff:

    # "Of course, at that exact moment, I see Alex strolling up the path, though he doesn't move toward the palace."
    "É claro que naquele exato momento eu vejo o Alex andando pelo caminho, apesar disso, ele não se move em direção ao palácio."

# game/a2s3.rpy:419
translate pt_br a2s3_711a1ab9:

    # "Instead, he starts walking up the path in my direction and I quickly stumble off the bench and into the bushes, praying that he didn't see me as I hide myself amongst the leaves."
    "Em vez disso, começa a vir pela estrada na minha direção e eu rapidamente tropeço para fora do banco e entro nos arbustos, rezando para que ele não tenha me visto conforme eu me escondo entre as folhas."

# game/a2s3.rpy:420
translate pt_br a2s3_61b29b73:

    # "The drone follows me, then pauses at the edge of the sidewalk."
    "O drone me segue, depois faz uma pausa na beira da calçada."

# game/a2s3.rpy:421
translate pt_br a2s3_ac271b31:

    # "I'm reminded that these things probably can't move off of the grid of the pathways."
    "Então eu me lembro que essas coisas provavelmente não podem se locomover para fora da grade imaginária nas estradas."

# game/a2s3.rpy:422
translate pt_br a2s3_93332754:

    # "Just through the leaves, I can see the damn thing's lights on, stubbornly waiting for my answer."
    "Através das folhas, consigo enxergar as luzes da maldita coisa acesas, teimosamente esperando por minha resposta."

# game/a2s3.rpy:423
translate pt_br a2s3_58e52d55:

    # "At the same time, I hear the soft scraping of Alex's sandals on the pathway as he moves closer."
    "Ao mesmo tempo eu ouço o arraste suave das sandálias do Alex no caminho enquanto ele se aproxima."

# game/a2s3.rpy:424
translate pt_br a2s3_735724c0:

    # "Damn it."
    "Merda."

# game/a2s3.rpy:425
translate pt_br a2s3_08595fdf:

    # "It would have been better if I'd just stayed on the bench."
    "Teria sido melhor se eu só tivesse ficado no banco."

# game/a2s3.rpy:426
translate pt_br a2s3_e4ef89bb:

    # "Now this drone is gonna reveal me to Alex while I'm hiding in the bushes like the most suspicious person in the palace."
    "Agora esse drone vai me revelar para o Alex enquanto eu me escondo nos arbustos como a pessoa mais suspeita do palácio."

# game/a2s3.rpy:427
translate pt_br a2s3_05e56529:

    # "I see the green tips of the cat's ears poke above the bushes as he hums softly."
    "Eu vejo as pontas verdes das orelhas do gato aparecerem em cima dos arbustos enquanto ele cantarola suavemente."

# game/a2s3.rpy:428
translate pt_br a2s3_028f0fde:

    # "I crouch lower in the foliage until I can't even see that."
    "Me agacho mais profundamente na folhagem até que eu não consiga mais ver."

# game/a2s3.rpy:429
translate pt_br a2s3_4bcb9725:

    # "I will the cat to just ignore the drone, but the humming stops and so do his footsteps, and I know that he's spotted it."
    "Quero que o gato só ignore o drone, mas o cantarolar para e também seus passos, com isso, noto que ele o avistou."

# game/a2s3.rpy:430
translate pt_br a2s3_b2db93a1:

    # al "\"Hmm, do you have a stray drone out here, Com?\""
    al "\"Hmm, você tem um drone perdido aqui, Com?\""

# game/a2s3.rpy:431
translate pt_br a2s3_395e81c6:

    # com "\"All drone machinery are accounted for, Alexios.\""
    com "\"Todos os drones estão contabilizados, Alexios.\""

# game/a2s3.rpy:432
translate pt_br a2s3_65843de9:

    # al "\"What's this one doing?\""
    al "\"E o que este está fazendo?\""

# game/a2s3.rpy:433
translate pt_br a2s3_60b8627f:

    # "I feel my heart stop, swallowing hard."
    "Eu sinto meu coração parar, engolindo em seco."

# game/a2s3.rpy:434
translate pt_br a2s3_167504cc:

    # "There's a pause, as if Com is calculating something."
    "Há uma pausa, como se Com estivesse calculando alguma coisa."

# game/a2s3.rpy:435
translate pt_br a2s3_9e0f1a19:

    # com "\"That information is classified, Alex.\""
    com "\"Esta informação está classificada, Alex.\""

# game/a2s3.rpy:436
translate pt_br a2s3_ffa4ea36:

    # al "\"By whom?\""
    al "\"Por quem?\""

# game/a2s3.rpy:437
translate pt_br a2s3_46622987:

    # com "\"Neferu.\""
    com "\"Neferu.\""

# game/a2s3.rpy:438
translate pt_br a2s3_40d45b29:

    # "There's a pause, then a chuckle as Alex's footsteps pick up again, moving further away to my left."
    "Há uma pausa, então uma risadinha à medida que os passos do Alex começam de novo, se movendo em frente na minha esquerda."

# game/a2s3.rpy:439
translate pt_br a2s3_2d1ab0ce:

    # al "\"Oh, that jackal.\""
    al "\"Ah, esse chacal.\""

# game/a2s3.rpy:440
translate pt_br a2s3_c9720e2f:

    # "I'm still holding my breath as I listen to the footsteps fade up the path before slowly rising up from my crouch, glaring at the drone."
    "Eu ainda prendo a minha respiração enquanto ouço os passos desaparecerem no caminho antes de me levantar lentamente do agachamento, olhando para o drone."

# game/a2s3.rpy:441
translate pt_br a2s3_0806f81e:

    # m "\"Tell Neferu that I'm busy, but that I'll be back tonight. I have some things to tell him.\""
    m "\"Fala pro Neferu que eu tô ocupado, mas que eu vou voltar hoje à noite. Tenho algumas coisas pra contar a ele.\""

# game/a2s3.rpy:442
translate pt_br a2s3_6cb70e13:

    # com "\"Message received. Thank you [mc].\""
    com "\"Mensagem recebida. Obrigado, [mc].\""

# game/a2s3.rpy:443
translate pt_br a2s3_3b1ce1f7:

    # m "\"Yeah, no problem.\""
    m "\"Aham, Cláudia, senta lá.\""

# game/a2s3.rpy:444
translate pt_br a2s3_ccc186fd:

    # "I say it sarcastically as the drone floats off in its slow, lazy way."
    "Eu falo isso sarcasticamente enquanto o drone flutua para longe daquele jeito devagar e preguiçoso."

# game/a2s3.rpy:445
translate pt_br a2s3_50b32fe0:

    # "At this point, the sun has set completely, and I have to wonder why Alexios has headed in that particular direction, leading either toward the gates of the palace, or the lake."
    "A essa altura o sol já se pôs completamente e eu tenho que me perguntar por que o Alexios foi por aquele caminho em particular, levando em direção aos portões do palácio ou ao lago."

# game/a2s3.rpy:446
translate pt_br a2s3_d121d419:

    # "I follow the path slowly, keeping my eyes peeled for the cat."
    "Eu sigo o caminho lentamente, mantendo os olhos abertos no gato."

# game/a2s3.rpy:447
translate pt_br a2s3_a3670907:

    # "At first, I'm almost positive that he would be heading for the gate, maybe on his way to the city."
    "A princípio eu tinha quase certeza de que ele iria para o portão, talvez a caminho da cidade."

# game/a2s3.rpy:448
translate pt_br a2s3_c560c87b:

    # "This would be the end of my little mission since I know I can't leave the boundaries of the palace without being...hurt somehow, probably killed."
    "Esse seria o fim da minha pequena missão já que eu sei que não posso deixar os limites do palácio sem ser... machucado de alguma forma, provavelmente morto."

# game/a2s3.rpy:450
translate pt_br a2s3_11959ebd:

    # "But instead, I spot the cat's form, just barely visible in front of the lake, its surface glinting from the light of the moon."
    "Mas em vez disso, me deparo com a silhueta do gato, mal dando para enxergar em frente ao lago, seus pelos brilhando com a luz da lua."

# game/a2s3.rpy:451
translate pt_br a2s3_6fa1e399:

    # "I stop and hide behind a tree, making sure that I'm not close to any of the lamp posts."
    "Eu paro e me escondo atrás de uma árvore, me certificando de que não estou perto de nenhum dos postes de luz."

# game/a2s3.rpy:452
translate pt_br a2s3_e0832dd9:

    # "I watch as Alex moves around under the little gazebo with the watercrafts under it."
    "Eu observo enquanto Alex perambula pelo pequeno gazebo com as embarcações embaixo dele."

# game/a2s3.rpy:453
translate pt_br a2s3_0ca70b0d:

    # "Sure enough, a few minutes later, he comes gliding out on the Sightseer."
    "Como esperado, alguns minutos depois ele começa a planar com o aero-observador."

# game/a2s3.rpy:454
translate pt_br a2s3_642c10c5:

    # "He floats over the shore, then out onto the lake...in the direction of the island."
    "Ele flutua sobre a costa, depois sobre o lago... indo em direção à ilha."

# game/a2s3.rpy:455
translate pt_br a2s3_1de5f45b:

    # "I know right away that I'm seeing something important."
    "Entendo imediatamente que estou vendo algo importante."

# game/a2s3.rpy:456
translate pt_br a2s3_de60c42a:

    # "There's nothing on the island for the cat to take care of, as far as I know, and unless he's going out there for a nighttime outing on the beach (extremely doubtful), then he's definitely doing something suspicious."
    "Não há nada na ilha para o gato tomar conta até onde sei e, a não ser que ele esteja indo até lá para um passeio noturno na praia (extremamente duvidoso), ele definitivamente está fazendo alguma coisa suspeita."

# game/a2s3.rpy:457
translate pt_br a2s3_14b2b93f:

    # "I wait for a while, watching as the dark form of the cat and the craft get smaller and smaller until they basically disappear, out in the direction of the island."
    "Eu espero por um tempo, observando enquanto a escura silhueta do gato e a embarcação ficam cada vez menores até que basicamente desaparecem na direção da ilha."

# game/a2s3.rpy:459
translate pt_br a2s3_0b3eacd5:

    # "Of course, I know I can't follow him out there right now, but I can definitely tell Neferu about it..."
    "É claro, eu sei que não posso segui-lo até lá agora, mas definitivamente posso contar ao Neferu sobre isso..."

# game/a2s3.rpy:462
translate pt_br a2s3_a94e54e2:

    # "Neferu is in his room when I arrive, tapping away at what looks like a transparent tablet."
    "Neferu está em seu quarto quando chego, usando o que parece ser um tablet transparente."

# game/a2s3.rpy:463
translate pt_br a2s3_0f7de105:

    # "It's an odd thing to see considering the non-existence of portable technology in this palace."
    "É uma coisa estranha de se ver, considerando a inexistência de tecnologia portátil nesse palácio."

# game/a2s3.rpy:464
translate pt_br a2s3_b94520a5:

    # "Maybe it's a Khemian thing."
    "Talvez seja algo khemiano."

# game/a2s3.rpy:465
translate pt_br a2s3_4e8bc6c1:

    # "As soon as he sees me though, the display slides back into into the small metal bar that it had been projecting out of as he turns to face me."
    "Mas assim que ele me vê, a tela desliza de volta para dentro da pequena barra de metal a partir da qual estava sendo projetada conforme ele vira a cabeça para me olhar."

# game/a2s3.rpy:468
translate pt_br a2s3_dfb0a9a7:

    # n "\"Hello, [mc]. You were gone for quite a while.\""
    n "\"Olá, [mc]. Você esteve fora por um bom tempo.\""

# game/a2s3.rpy:469
translate pt_br a2s3_7d1f6ae1:

    # m "\"Uh, yeah.\""
    m "\"Ah, sim.\""

# game/a2s3.rpy:471
translate pt_br a2s3_3eaaca64:

    # n "\"Care to share how your visit went with Cassius and, hopefully, Amicus?\""
    n "\"Se importa de compartilhar como foi sua visita ao Cassius e, espero que sim, ao Amicus?\""

# game/a2s3.rpy:472
translate pt_br a2s3_75e0b58a:

    # "It takes me a moment to remember exactly what he's talking about."
    "Me leva um tempo para me lembrar exatamente sobre o que ele está falando."

# game/a2s3.rpy:473
translate pt_br a2s3_9b63365d:

    # "After my little trip, everything that happened before it seems so distant."
    "Depois da minha pequena viagem, tudo o que aconteceu antes dela parece tão distante."

# game/a2s3.rpy:474
translate pt_br a2s3_70fbdc9b:

    # "I try to tell Neferu as much as I remember involving Cassius before the parent thing, and he seems impressed."
    "Eu tento contar ao Neferu tudo o que consigo lembrar envolvendo o Cassius antes da coisa com os progenitores e ele parece impressionado."

# game/a2s3.rpy:476
translate pt_br a2s3_c794ba4a:

    # n "\"Hm, I suppose bringing Cassius to our side won't be as difficult as I had previously thought. It seems he has similar misgivings about Cato.\""
    n "\"Hm, suponho que trazer Cassius para nosso lado não será tão difícil como eu pensava anteriormente. Parece que ele tem dúvidas semelhantes sobre o Cato.\""

# game/a2s3.rpy:477
translate pt_br a2s3_5d26a9db:

    # m "\"Yeah, and Amicus is doing okay, just a bit depressed about everything that's happening, obviously.\""
    m "\"É, e o Amicus tá bem, só um pouco deprimido com tudo o que tá acontecendo, obviamente.\""

# game/a2s3.rpy:478
translate pt_br a2s3_ad277b9e:

    # "I pause then, which Neferu notices."
    "Então, eu faço uma pausa, e Neferu nota."

# game/a2s3.rpy:480
translate pt_br a2s3_0e424b69:

    # n "\"Is there something else that happened?\""
    n "\"Há mais alguma coisa que aconteceu?\""

# game/a2s3.rpy:481
translate pt_br a2s3_2d6e9d1a:

    # "I take a deep breath, thinking how best to describe what I went through."
    "Eu respiro fundo, pensando na melhor forma de descrever o que eu passei."

# game/a2s3.rpy:482
translate pt_br a2s3_761a4a6f:

    # m "\"Well, when I was coming back, there was this weird smell coming from the meditation room...\""
    m "\"Então, quando eu tava voltando, tinha um cheiro estranho vindo da sala de meditação...\""

# game/a2s3.rpy:484
translate pt_br a2s3_dbf18efa:

    # "Neferu raises an eyebrow and I go on to explain how I'd ran into Cassius again, then everything that happened afterwards."
    "Neferu levanta uma sobrancelha e eu continuo explicando como me deparei com o Cassius de novo, depois tudo o que aconteceu em seguida."

# game/a2s3.rpy:485
translate pt_br a2s3_ff8d4d14:

    # "When I finish, the jackal is quiet, just watching me with a narrowed gaze."
    "Quando termino, o chacal fica quieto, só me observando com um olhar estreito."

# game/a2s3.rpy:486
translate pt_br a2s3_cd12aeec:

    # "This is usually the look he gives me when he's thinking hard about something, so I give him some time to respond."
    "Esse é normalmente seu olhar de quando está pensando muito em alguma coisa, então eu dou a ele algum tempo para responder."

# game/a2s3.rpy:487
translate pt_br a2s3_8a672997:

    # "When he does, it's hesitant and reserved, not usually something I hear from Neferu."
    "Quando ele responde, é hesitante e reservado, uma postura rara vindo do Neferu."

# game/a2s3.rpy:489
translate pt_br a2s3_b46c039a:

    # n "\"So it was a drug-induced hallucination, yes?\""
    n "\"Então foi uma alucinação induzida por drogas, não é?\""

# game/a2s3.rpy:490
translate pt_br a2s3_5daaa888:

    # m "\"Well, I guess so, but I think it was real too. Like, Cassius was there, and he remembers seeing me with him.\""
    m "\"É, acho que sim, mas eu também acho que foi real. Tipo, Cassius tava lá e ele se lembrou de me ver com ele.\""

# game/a2s3.rpy:491
translate pt_br a2s3_87959007:

    # n "\"Hmm...\""
    n "\"Hmm...\""

# game/a2s3.rpy:492
translate pt_br a2s3_3c6a4d52:

    # m "\"What's wrong?\""
    m "\"O que tem de errado?\""

# game/a2s3.rpy:494
translate pt_br a2s3_ebb48fdf:

    # n "\"Well, that is a very...primitive way to contact the parents. To put it bluntly, it does not work. It was a method used in the early days, during First Contact between sibling and parent.\""
    n "\"Bem, isso é uma forma muito... primitiva de contatar os progenitores. Francamente, não funciona. Era um método utilizado na antiguidade, durante o primeiro contato entre membro da irmandade e progenitor.\""

# game/a2s3.rpy:495
translate pt_br a2s3_af0f2387:

    # n "\"They visited multiple times and in between visits some siblings, especially the wolves, would try to contact them again via psychotropic drug use. This could occasionally bring visions of higher beings, though they were not the parents, of course—\""
    n "\"Eles visitaram várias vezes e, entre as visitas, alguns membros da irmandade, especialmente os lobos, tentaram entrar em contato com eles novamente pelo uso de drogas psicotrópicas. Isso poderia ocasionalmente trazer visões de seres superiores, mas eles não eram os progenitores, é claro—\""

# game/a2s3.rpy:496
translate pt_br a2s3_8c760ca8:

    # n "\"—simply imagined beings conjured up by a chemically-imbalanced brain.\""
    n "\"—simplesmente seres imaginados invocados por um cérebro desequilibrado quimicamente.\""

# game/a2s3.rpy:497
translate pt_br a2s3_bba76c1a:

    # n "\"This is likely what you experienced.\""
    n "\"Isso é provavelmente o que você viu.\""

# game/a2s3.rpy:499
translate pt_br a2s3_9381e4eb:

    # n "\"To truly contact the parents you must do it through parental tech; complicated machinery that is able to transcend dimensions.\""
    n "\"Para contatar os progenitores de verdade você precisa fazer isso através de tecnologia progenitora; maquinário complicado que é capaz de transcender dimensões.\""

# game/a2s3.rpy:500
translate pt_br a2s3_d071f605:

    # n "\"It is usually only usable by a single person, such as the emperor for the wolves or the pharaoh for my people.\""
    n "\"Normalmente só pode ser usado por uma pessoa de cada vez, assim como o imperador para os lobos e o faraó para o meu povo.\""

# game/a2s3.rpy:501
translate pt_br a2s3_62ae0fbc:

    # "Neferu stops talking at this point, allowing me to take all that information in."
    "Neferu para de falar nesse momento, me deixando absorver toda a informação."

# game/a2s3.rpy:502
translate pt_br a2s3_20552333:

    # "So maybe I had imagined it all...even if it had seemed so real."
    "Então talvez eu tenha imaginado tudo... mesmo que tenha parecido tão real."

# game/a2s3.rpy:503
translate pt_br a2s3_69f43a32:

    # m "\"They told me they had a plan for me and everything.\""
    m "\"Eles disseram que tinham um plano pra mim e tudo.\""

# game/a2s3.rpy:505
translate pt_br a2s3_5fe7770c:

    # n "\"Often times such drugs stroke the ego of the user. They make you feel as if you are at the center of the universe, as if you are important...not saying that you aren't.\""
    n "\"Muitas vezes essas drogas atingem o ego do usuário. Elas fazem você se sentir como se estivesse no centro do universo, como se você fosse importante... não que você não seja.\""

# game/a2s3.rpy:506
translate pt_br a2s3_72a7a166:

    # m "\"Have you tried it before?\""
    m "\"Você já usou antes?\""

# game/a2s3.rpy:508
translate pt_br a2s3_8f053829:

    # n "\"I've had brushes with such substances in my youth. Good for experiencing the fragility of reality and how we perceive it...but little else.\""
    n "\"Eu tive experiências com tais substâncias na minha juventude. São ótimas para experimentar a fragilidade da realidade e como nós a percebemos... mas nada muito além disso.\""

# game/a2s3.rpy:509
translate pt_br a2s3_0746d850:

    # m "\"I see.\""
    m "\"Entendo.\""

# game/a2s3.rpy:511
translate pt_br a2s3_9881b883:

    # n "\"Still, it sounds like you caught Cassius in a moment of vulnerability. He could trust you more because of it, if you treated the situation delicately.\""
    n "\"Ainda assim, parece que você pegou o Cassius em um momento de vulnerabilidade. Ele poderia confiar mais em você por causa disso, se você tratou a situação com delicadeza.\""

# game/a2s3.rpy:512
translate pt_br a2s3_8b3cd524:

    # m "\"Eh, maybe.\""
    m "\"É, talvez.\""

# game/a2s3.rpy:513
translate pt_br a2s3_225eba54:

    # "I think back to when I saw him crying in front of the statue, but I don't want to tell Neferu about that, not really feeling it would be all that useful...or appropriate to share."
    "Penso de volta em quando vi ele chorando na frente da estátua, mas não quero falar sobre isso com o Neferu, realmente sentindo que não seria tão útil... ou apropriado compartilhar."

# game/a2s3.rpy:514
translate pt_br a2s3_4b7395dc:

    # "But this reminds me of what else the \"parents\" had said to me."
    "Mas isso me lembra do que mais os \"progenitores\" me disseram."

# game/a2s3.rpy:515
translate pt_br a2s3_eeff0b6f:

    # m "\"Well, they also told me something else; to watch Alex.\""
    m "\"Inclusive... eles também me disseram outra coisa: observar o Alex.\""

# game/a2s3.rpy:517
translate pt_br a2s3_d09b5451:

    # n "\"Did they now?\""
    n "\"Disseram?\""

# game/a2s3.rpy:518
translate pt_br a2s3_7825d8aa:

    # m "\"Yeah, and I did. He's been acting weird ever since I got here, so I spied on him today and he sailed off to the island in the middle of the lake just now.\""
    m "\"Sim, e eu fiz isso. Ele tem agido estranho desde que eu vim pra cá, então espiei ele hoje e ele partiu pra ilha no meio do lago agora há pouco.\""

# game/a2s3.rpy:520
translate pt_br a2s3_282c0859:

    # "Neferu's got a strange, knowing smile on his face."
    "Neferu abre um sorriso estranho de epifania em seu rosto."

# game/a2s3.rpy:521
translate pt_br a2s3_df8ec4bc_1:

    # m "\"What?\""
    m "\"Que foi?\""

# game/a2s3.rpy:522
translate pt_br a2s3_5358b849:

    # n "\"I just find it interesting that you have similar suspicions of Alex that I did.\""
    n "\"Apenas acho interessante que você tenha suspeitas semelhantes às minhas sobre o Alex.\""

# game/a2s3.rpy:523
translate pt_br a2s3_9d3344cb_1:

    # m "\"What do you mean?\""
    m "\"Como assim?\""

# game/a2s3.rpy:524
translate pt_br a2s3_75ef5a57:

    # n "\"I've been studying the cat myself and noticed a few odd things as well, including his trips to the island.\""
    n "\"Venho observando o gato eu mesmo e também notei algumas coisas estranhas, incluindo suas viagens até a ilha.\""

# game/a2s3.rpy:525
translate pt_br a2s3_e499761a_1:

    # "I frown."
    "Eu arqueio as sobrancelhas."

# game/a2s3.rpy:526
translate pt_br a2s3_2d5bfaf9:

    # m "\"What? And you didn't tell me?\""
    m "\"O que? E você não me contou?\""

# game/a2s3.rpy:528
translate pt_br a2s3_ca79440d:

    # n "\"Well, this rather desperate situation we're in only came about very recently, and I had little use for this information until now.\""
    n "\"Essa situação bastante desesperadora que estamos vivendo surgiu muito recentemente e eu tinha pouco uso para esta informação, até agora.\""

# game/a2s3.rpy:529
translate pt_br a2s3_043ca616:

    # m "\"Well, what do you think he's doing?\""
    m "\"Então, o que você acha que ele tá fazendo?\""

# game/a2s3.rpy:530
translate pt_br a2s3_41b86fe4:

    # "Neferu shrugs."
    "Neferu dá de ombros."

# game/a2s3.rpy:532
translate pt_br a2s3_aeaac5a1:

    # n "\"I don't know as I've not yet followed him to the island. You can imagine that I'm planning to now that we could use Alex on our side as well.\""
    n "\"Eu não sei, já que ainda não o segui até a ilha. Você pode imaginar que estou planejando fazer isso agora que nós também poderíamos usar o Alex ao nosso favor.\""

# game/a2s3.rpy:533
translate pt_br a2s3_962e8e11:

    # m "\"Turn everyone against Cato?\""
    m "\"Fazer todo mundo se virar contra o Cato?\""

# game/a2s3.rpy:535
translate pt_br a2s3_d0c65d3d:

    # n "\"Yes.\""
    n "\"Sim.\""

# game/a2s3.rpy:536
translate pt_br a2s3_7d658e30:

    # m "\"So if he's doing something...bad, then we would use it as blackmail?\""
    m "\"Então, se ele tá fazendo algo... ruim, a gente poderia usar isso como chantagem?\""

# game/a2s3.rpy:537
translate pt_br a2s3_7baa2692:

    # n "\"Essentially. He is the closest person to Cassius and could possibly grant us access to classified information.\""
    n "\"Essencialmente. Ele é a pessoa mais próxima do Cassius e possivelmente poderia nos dar acesso a informação sigilosa.\""

# game/a2s3.rpy:538
translate pt_br a2s3_7606b520:

    # "I sigh, growing weary of all this backstabbing."
    "Eu suspiro, ficando cansado de toda essa apunhalada nas costas."

# game/a2s3.rpy:539
translate pt_br a2s3_9c6a0131:

    # m "\"If it's the only way to help Amicus, I guess.\""
    m "\"Se é o único jeito de ajudar o Amicus, tudo bem.\""

# game/a2s3.rpy:540
translate pt_br a2s3_f5b60196:

    # n "\"Oh, there are many ways, and I have a last resort plan in place.\""
    n "\"Ah, há muitas maneiras e eu tenho um plano como último recurso.\""

# game/a2s3.rpy:541
translate pt_br a2s3_0ad3065e:

    # "I wait, but Neferu doesn't go on."
    "Eu espero, mas Neferu não continua."

# game/a2s3.rpy:542
translate pt_br a2s3_51752a77:

    # m "\"Which is?\""
    m "\"Que é?\""

# game/a2s3.rpy:544
translate pt_br a2s3_d46621e4:

    # n "\"Well, considering Amicus's birthright, he still has the ability to challenge whoever is on the throne, but—\""
    n "\"Bem, considerando que o Amicus tem direito de nascença, ele ainda pode desafiar seja lá quem esteja no trono, mas—\""

# game/a2s3.rpy:545
translate pt_br a2s3_0b4eb0fa:

    # m "\"Really?\""
    m "\"Sério?\""

# game/a2s3.rpy:546
translate pt_br a2s3_85fd2a50:

    # "All this time Amicus could have just challenged Cassius again?"
    "Esse tempo todo o Amicus poderia só ter desafiado o Cassius de novo?"

# game/a2s3.rpy:547
translate pt_br a2s3_d4e88461:

    # "Then I realize that Neferu was about to go on."
    "Então eu percebo que o Neferu estava prestes a continuar."

# game/a2s3.rpy:548
translate pt_br a2s3_894de8f4:

    # m "\"But what?\""
    m "\"Mas o que?\""

# game/a2s3.rpy:549
translate pt_br a2s3_4d3539da:

    # n "\"A fight to the death, since the wolves love their violence, though the emperor would have to accept the challenge.\""
    n "\"É uma luta até a morte, já que os lobos amam sua violência, mas o imperador teria que aceitar o desafio.\""

# game/a2s3.rpy:550
translate pt_br a2s3_9b2ca29d:

    # "The thought of that instantly makes me feel sick."
    "Pensar nisso instantaneamente me deixa mal."

# game/a2s3.rpy:551
translate pt_br a2s3_c594807f:

    # m "\"No way.\""
    m "\"Nem fodendo.\""

# game/a2s3.rpy:552
translate pt_br a2s3_3a616230:

    # n "\"Again, last resort. I doubt Amicus would challenge his own brother, and I doubt Cassius would accept...at least at the moment.\""
    n "\"Mais uma vez, último recurso. Eu duvido que o Amicus desafiaria seu próprio irmão e duvido que Cassius aceitaria... ao menos no momento.\""

# game/a2s3.rpy:553
translate pt_br a2s3_f3c853be:

    # "I can't even begin to contemplate a situation like that, and Neferu quickly changes the subject."
    "Eu não consigo nem pensar em uma situação como essa e o Neferu rapidamente muda de assunto."

# game/a2s3.rpy:555
translate pt_br a2s3_b2545451:

    # n "\"Anyway, I should be off. I'd like to catch Alex in the act and based on previous observations I've made, I have another hour to do so.\""
    n "\"Enfim, eu deveria ir. Gostaria de pegar o Alex no ato e baseado nas observações que fiz anteriormente, tenho uma hora restante para fazer isso.\""

# game/a2s3.rpy:556
translate pt_br a2s3_580d26ec:

    # "I blink in surprise."
    "Eu pisco, surpreso."

# game/a2s3.rpy:557
translate pt_br a2s3_ae6802de:

    # m "\"Right now? Shouldn't we wait until like...tomorrow night?\""
    m "\"Agora? A gente não devia esperar tipo... até amanhã à noite?\""

# game/a2s3.rpy:558
translate pt_br a2s3_22c273f1:

    # n "\"He only goes once a week. Considering how urgent our situation is, I should get this done now.\""
    n "\"Ele só vai uma vez por semana. Considerando quão urgente é nossa situação, eu deveria fazer isso agora.\""

# game/a2s3.rpy:559
translate pt_br a2s3_a079e3a6:

    # m "\"Can I go too?\""
    m "\"Eu posso ir também?\""

# game/a2s3.rpy:561
translate pt_br a2s3_98a445e3:

    # n "\"[mc], remember what I said about needing to keep you safe?\""
    n "\"[mc], lembra do que falei sobre manter você seguro?\""

# game/a2s3.rpy:562
translate pt_br a2s3_a3075234:

    # m "\"Yeah, and it's Alex. What's he gonna do?\""
    m "\"Sim, mas é o Alex. O que ele vai fazer?\""

# game/a2s3.rpy:563
translate pt_br a2s3_a67f1180:

    # n "\"We should be prepared for anything.\""
    n "\"Nós deveriamos estar preparados para qualquer coisa.\""

# game/a2s3.rpy:564
translate pt_br a2s3_5af27dfd:

    # m "\"Well, I think it's better if we both go, in case something {i}does{/i} happen and you need my help.\""
    m "\"Olha, eu acho melhor se nós dois formos, no caso de alguma coisa {i}realmente{/i} acontecer e você precisar da minha ajuda.\""

# game/a2s3.rpy:565
translate pt_br a2s3_5c4223ed:

    # "Neferu lets out a soft sigh."
    "Neferu solta um leve suspiro."

# game/a2s3.rpy:567
translate pt_br a2s3_cf4e5756:

    # n "\"Alright.\""
    n "\"Tudo bem.\""

# game/a2s3.rpy:568
translate pt_br a2s3_9aa34d32:

    # "I'm surprised by how quickly he gives in."
    "Eu fico surpreso com o quão rápido ele aceita a ideia."

# game/a2s3.rpy:569
translate pt_br a2s3_1c57a4aa:

    # n "\"I suppose you deserve to be treated as an equal in these plans we're making.\""
    n "\"Suponho que você mereça ser tratado como um igual nesses planos que estamos fazendo.\""

# game/a2s3.rpy:571
translate pt_br a2s3_d3e6d46b:

    # n "\"Though if Amicus finds out I'm bringing you on these missions he'll have my hide.\""
    n "\"Mas se o Amicus descobrir que estou levando você nessas missões, ele vai fazer picadinho de mim.\""

# game/a2s3.rpy:572
translate pt_br a2s3_06d9a076:

    # m "\"I'll let him know I wanted to be part of it.\""
    m "\"Eu vou me certificar que ele saiba que foi escolha minha.\""

# game/a2s3.rpy:573
translate pt_br a2s3_057d75aa:

    # n "\"Mhm, as if that will convince him. Anyway, let's be off.\""
    n "\"Mhm, como se você fosse convencê-lo. Enfim, vamos indo.\""

# game/a2s3.rpy:574
translate pt_br a2s3_1f228d29:

    # m "\"Okay.\""
    m "\"Ok.\""

# game/a2s3.rpy:576
translate pt_br a2s3_99ececab:

    # "My excitement picks up as I get to my feet and follow Neferu to the door."
    "Minha animação aumenta quando eu me levanto e sigo o Neferu até a porta."

# game/a2s3.rpy:578
translate pt_br a2s3_6b465ff7:

    # n "\"If we run into anyone, especially Cato, we simply tell them we're out for an evening stroll, understood?\""
    n "\"Se nos depararmos com qualquer pessoa, especialmente o Cato, simplesmente contamos que vamos fazer um passeio noturno, tudo bem?\""

# game/a2s3.rpy:579
translate pt_br a2s3_08fec879:

    # m "\"Yep!\""
    m "\"Aham!\""

# game/a2s3.rpy:580
translate pt_br a2s3_530a7084:

    # "Despite the potentially dangerous situation we're going into, my mood is lifted knowing that things are finally moving again."
    "Apesar da situação potencialmente perigosa que nos enfiamos, meu humor vai à tona sabendo que as coisas finalmente estão de volta aos trilhos."

# game/a2s3.rpy:584
translate pt_br a2s3_3179fd09:

    # "Luckily, there's another Sightseer craft in the gazebo, though it looks much older and the floor on this one isn't transparent, which I'm fine with."
    "Felizmente, há outro aero-observador no gazebo, apesar de parecer muito mais velho e o piso desse não ser transparente, mas tudo bem para mim."

# game/a2s3.rpy:585
translate pt_br a2s3_13399214:

    # "I'd rather not gaze into the inky-blackness of the water beneath my feet while sailing to the island."
    "Eu prefiro não ficar encarando a escuridão da água por baixo dos meus pés enquanto vamos até a ilha."

# game/a2s3.rpy:586
translate pt_br a2s3_e38dc29b:

    # "Neferu is quiet most of the time, looking confident in everything he does as he prepares the craft."
    "Neferu fica quieto a maior parte do tempo, parecendo confiante em tudo o que faz enquanto prepara a embarcação."

# game/a2s3.rpy:587
translate pt_br a2s3_56f6a2ba:

    # "Finally, he reaches out his paw to chivalrously pull me on board."
    "Finalmente ele estende sua pata para me puxar a bordo de forma cavalheiresca."

# game/a2s3.rpy:588
translate pt_br a2s3_266781e6:

    # "The lake laps quietly around us as we approach the island; a black mass amongst the ripples of reflected moonlight in the waves."
    "O lago ondula silenciosamente ao nosso redor enquanto nos aproximamos da ilha; uma massa preta entre os fragmentos de luz do luar refletindo nas ondas."

# game/a2s3.rpy:589
translate pt_br a2s3_9cea541c:

    # "I immediately spot Alex's craft sitting on the beach near where we'd had our little picnic all those weeks ago."
    "Eu imediatamente me deparo com a embarcação do Alex parada na praia perto de onde fizemos nosso primeiro piquenique todas aquelas semanas atrás."

# game/a2s3.rpy:590
translate pt_br a2s3_c062703d:

    # "We travel a little further up the shore, out of sight of the craft before we drift onto the beach."
    "Subimos um pouco mais acima na costa, fora de vista da embarcação antes de seguirmos até a praia."

# game/a2s3.rpy:592
translate pt_br a2s3_be9c1a39:

    # "Neferu holds out a paw again to help me down, even though I don't need it."
    "Neferu estende uma pata outra vez para me ajudar a descer, mesmo que eu não precise disso."

# game/a2s3.rpy:593
translate pt_br a2s3_38fdfa2c:

    # "As I settle on the sand though, he leans in close to whisper in my ear."
    "Mas conforme piso na areia, ele se inclina perto para sussurrar em meu ouvido."

# game/a2s3.rpy:595
translate pt_br a2s3_419ca6cf:

    # n "\"Wait here. Unfortunately, I believe simian footfalls are louder than that of a jackal.\""
    n "\"Espere aqui. Infelizmente, acredito que os passos dos símios são mais altos que os de um chacal.\""

# game/a2s3.rpy:596
translate pt_br a2s3_c534a951:

    # m "\"Okay...but call me if something happens, or you need help.\""
    m "\"Ok... mas me chama se alguma coisa acontecer, ou se você precisar de ajuda.\""

# game/a2s3.rpy:598
translate pt_br a2s3_ef2a7f8f:

    # "I see a smile on Neferu's face, and though it's amused, it's not in a condescending way at all."
    "Eu vejo um sorriso no rosto do Neferu e, apesar de parecer entretido, não é condescendente de forma alguma."

# game/a2s3.rpy:599
translate pt_br a2s3_727c6bc3:

    # n "\"Of course, my friend.\""
    n "\"É claro, meu amigo.\""

# game/a2s3.rpy:601
translate pt_br a2s3_dd0b3514:

    # "And with that, the jackal disappears into the night, leaving me with only the little craft and the gentle sounds of the waves to keep me company."
    "Com isso, o chacal desaparece na noite, me deixando apenas com a pequena embarcação e os suaves barulhos das ondas como companhia."

# game/a2s3.rpy:602
translate pt_br a2s3_f9da8564:

    # "I don't have to wait long before I hear voices coming from further up the beach, and I know right away that it's Neferu and Alex."
    "Não preciso esperar muito até ouvir vozes mais à frente na praia e eu sei imediatamente que são Neferu e Alex."

# game/a2s3.rpy:603
translate pt_br a2s3_2ec4a2e8:

    # "I wait for a few moments to see if Neferu will call my name."
    "Eu espero um pouco para ver se Neferu vai chamar meu nome."

# game/a2s3.rpy:604
translate pt_br a2s3_1c4e1b96:

    # "When he doesn't, I frown and look around before quietly making my way toward the voices."
    "Isso não acontece, então olho em volta antes de silenciosamente seguir o caminho em direção às vozes."

# game/a2s3.rpy:605
translate pt_br a2s3_1fd1921c:

    # "It's not like I expect he needs my help, but I don't want to miss anything important, and I feel like the moment of confrontation with Alex should involve me."
    "Não é como se eu esperasse que ele viesse precisar da minha ajuda, mas não quero perder nada importante e sinto como se o momento de confrontação com o Alex devesse me envolver."

# game/a2s3.rpy:606
translate pt_br a2s3_0ab56287:

    # "As I get closer, I'm able to make out the words, and I see that the two of them are right on the edge of the woods, standing just a few feet apart."
    "Ao passo que chego mais perto, sou capaz de discernir as palavras e vejo que os dois estão bem no canto das árvores, parados a mais ou menos um metro longe do outro."

# game/a2s3.rpy:607
translate pt_br a2s3_5b6c992a:

    # "I crouch and hide along the tree line as I listen more closely to what they're saying."
    "Eu agacho e me escondo ao longo da linha das árvores enquanto ouço mais de perto o que eles estão falando."

# game/a2s3.rpy:609
translate pt_br a2s3_956ca017:

    # n "\"—beautiful night. I've always wanted to come to the island to gaze at the moon and planet, away from the lights of the palace.\""
    n "\"—linda noite. Eu sempre quis vir até a ilha para apreciar a vista da lua e do planeta longe das luzes do palácio.\""

# game/a2s3.rpy:611
translate pt_br a2s3_f8fed1a7:

    # al "\"Ohh, I see. It is incredibly beautiful here, isn't it?\""
    al "\"Ah, entendo. É incrivelmente bonito aqui, não é mesmo?\""

# game/a2s3.rpy:612
translate pt_br a2s3_9113e865:

    # "While he's speaking in his typical, pleasant tone, I can definitely tell that Alex seems a bit nervous, his voice tight and a bit out of breath."
    "Ainda que ele fale em seu tom típico e agradável, posso dizer definitivamente que o Alex parece um pouco nervoso, sua voz tensa e um pouco sem fôlego."

# game/a2s3.rpy:614
translate pt_br a2s3_3fd05764:

    # n "\"So...\""
    n "\"Então...\""

# game/a2s3.rpy:616
translate pt_br a2s3_2081b889:

    # al "\"Yes?\""
    al "\"Sim?\""

# game/a2s3.rpy:617
translate pt_br a2s3_07b65026:

    # "Alex looks around nervously."
    "Alex olha ao redor com nervosismo."

# game/a2s3.rpy:619
translate pt_br a2s3_bee043c8:

    # n "\"I heard you speaking just before I happened upon you. Is there someone else with you?\""
    n "\"Eu ouvi você falando pouco antes de vir até aqui. Há mais alguém com você?\""

# game/a2s3.rpy:621
translate pt_br a2s3_b2032c3b:

    # al "\"Me? Oh no, definitely not! You know, it's rather embarrassing, but sometimes I just talk to myself.\""
    al "\"Comigo? Ah, não, definitivamente não! Sabe, é muito embaraçoso, mas às vezes eu gosto de falar comigo mesmo.\""

# game/a2s3.rpy:623
translate pt_br a2s3_bd50f1a7:

    # n "\"Don't be embarrassed, it's something I do as well.\""
    n "\"Não fique envergonhado, é algo que eu costumo fazer também.\""

# game/a2s3.rpy:625
translate pt_br a2s3_af012a97:

    # al "\"O—oh, I see.\""
    al "\"A—ah, entendo.\""

# game/a2s3.rpy:626
translate pt_br a2s3_538388df:

    # "Alex seems to be relaxing a bit under Neferu's treatment, but tenses up again at the next sentence."
    "Alex parece relaxar um pouco sob o tratamento do Neferu, mas tensiona de novo com a próxima frase."

# game/a2s3.rpy:628
translate pt_br a2s3_16dde21c:

    # n "\"Though I usually don't whisper to trees. Now THAT is a bit odd.\""
    n "\"Embora eu não costume sussurrar para as árvores. Bem, ISSO é um pouco estranho.\""

# game/a2s3.rpy:630
translate pt_br a2s3_fb58ceda:

    # al "\"...\""
    al "\"...\""

# game/a2s3.rpy:631
translate pt_br a2s3_394a0668:

    # "I see Alex's ears flatten, though I'm a bit confused at the statement."
    "Eu vejo as orelhas do Alex caírem, embora eu tenha ficado um pouco confuso com a frase."

# game/a2s3.rpy:632
translate pt_br a2s3_1eb4c6e5:

    # "Whispering to trees?"
    "Sussurrar para as árvores?"

# game/a2s3.rpy:633
translate pt_br a2s3_ee6daf71:

    # al "\"I—I...\""
    al "\"Eu—eu...\""

# game/a2s3.rpy:634
translate pt_br a2s3_585527b2:

    # "Alex doesn't seem to have an answer ready and stutters in the most guilty way imaginable."
    "Alex parece não ter uma resposta pronta e gagueja da maneira mais culpada que se possa imaginar."

# game/a2s3.rpy:635
translate pt_br a2s3_b9bbe60a:

    # "Weirdly enough though, he sidles up closer to Neferu."
    "Porém, como se já não fosse estranho o suficiente, ele desliza para um pouco mais perto do Neferu."

# game/a2s3.rpy:638
translate pt_br a2s3_7912fc41:

    # al "\"N—Neferu, you're the one that's acting a bit odd right now, you know.\""
    al "\"N—Neferu, você é quem está agindo um pouco estranho agora, sabia.\""

# game/a2s3.rpy:639
translate pt_br a2s3_3052a070:

    # "The small cat's demeanor suddenly changes to a more...sultry approach, relaxing his shoulders and drifting a paw down his body."
    "O comportamento do pequeno gato muda repentinamente para uma abordagem mais... sensual, relaxando os ombros e deslizando uma pata pelo corpo."

# game/a2s3.rpy:640
translate pt_br a2s3_1e6abdb1:

    # "It doesn't seem natural at all though, unlike Neferu's smile as he stares down at the approaching cat."
    "Mas não parece nem um pouco natural, ao contrário do sorriso do Neferu enquanto olha para o gato se aproximando."

# game/a2s3.rpy:641
translate pt_br a2s3_3c19be9e:

    # "He's still smiling when Alex reaches up to cup his cheeks and kiss him right on the lips."
    "Ele ainda sorri quando o Alex vai para cima na direção de suas bochechas e o beija diretamente nos lábios."

# game/a2s3.rpy:642
translate pt_br a2s3_50aea7da:

    # "I blink, surprised at the sudden turn this scenario has taken."
    "Eu pisco, surpreso com a mudança repentina que esse cenário tomou."

# game/a2s3.rpy:643
translate pt_br a2s3_c8462a06:

    # "Neferu looks anything but surprised though, grinning throughout the kiss as Alex tries to kiss deeper."
    "Mas Neferu parece qualquer coisa menos surpreso, sorrindo durante o beijo enquanto Alex tenta beijar mais fundo."

# game/a2s3.rpy:644
translate pt_br a2s3_65d0b463:

    # "Finally, the cat seems to notice the lack of response from the jackal and he draws back, frowning."
    "Finalmente, o gato parece notar a falta de resposta do chacal e ele se afasta, franzindo a testa."

# game/a2s3.rpy:646
translate pt_br a2s3_aafda3e6:

    # "Neferu shakes his head."
    "Neferu balança a cabeça em desdém."

# game/a2s3.rpy:648
translate pt_br a2s3_4a8b1034:

    # n "\"Oh Alex, you know that's my technique. It will not work on me. Now why don't we have a look at that tree?\""
    n "\"Ah, Alex, você sabe que essa técnica é minha. Não vai funcionar comigo. Agora, por que não damos uma olhada naquela árvore?\""

# game/a2s3.rpy:650
translate pt_br a2s3_2d450de7:

    # "Alex freezes up, looking around, and that's when I think he spots me."
    "Alex congela, olhando em volta, e é nesse momento que eu acho que ele me viu."

# game/a2s3.rpy:652
translate pt_br a2s3_d411ebe1:

    # al "\"Who—who's that?\""
    al "\"Quem—quem está aí?\""

# game/a2s3.rpy:654
translate pt_br a2s3_e3b905f1:

    # "Neferu turns his head just slightly in my direction, and that's when Alex makes his move."
    "Neferu vira a cabeça ligeiramente em minha direção, e é nesse momento que Alex aproveita a oportunidade."

# game/a2s3.rpy:658
translate pt_br a2s3_c17847e4:

    # "He sends a kick sailing between the jackal's legs, and just as I'm readying myself to intervene, Neferu's paw is there, solidly stopping the attack."
    "Ele direciona um chute entre as pernas do chacal e exatamente quando eu me preparo para intervir, as patas do Neferu estão lá, firmemente bloqueando o ataque."

# game/a2s3.rpy:659
translate pt_br a2s3_7a3b51f6:

    # "There's a pause, Neferu holding Alex's leg, forcing him to balance on one foot as the jackal's smile turns smug."
    "Há uma pausa, Neferu segurando a perna do Alex, forçando-o a se equilibrar em um pé enquanto o sorriso do chacal se torna presunçoso."

# game/a2s3.rpy:660
translate pt_br a2s3_c08ac8b6:

    # n "\"What a pity that you're not the first to try such a move on me. I've learned people on this moon fight dirty.\""
    n "\"É uma pena que você não seja o primeiro a tentar isso. Aprendi que as pessoas nessa lua costumam jogar sujo.\""

# game/a2s3.rpy:661
translate pt_br a2s3_e24953f0:

    # "Alex squeaks, but balls up a fist anyway, sending a straight punch square into Neferu's stomach."
    "Alex chia, mas fecha o punho de qualquer maneira, golpeando um soco diretamente no estômago do Neferu."

# game/a2s3.rpy:663
translate pt_br a2s3_1bea7051:

    # "It connects with a hollow thud, bouncing off the jackal's abs like they're made of bricks, Neferu only grunting slightly in response."
    "O punho colide com um som oco, ricocheteando do abdômen do chacal como se fosse feito de tijolos, Neferu apenas grunhindo um pouco em resposta."

# game/a2s3.rpy:664
translate pt_br a2s3_275e7892:

    # n "\"Oof! Now that's a bit more like it!\""
    n "\"Oof! Agora nós estamos conversando!\""

# game/a2s3.rpy:667
translate pt_br a2s3_ac168f12:

    # "Suddenly, Neferu uses a leg to sweep Alex's only foot off the ground, sending the cat onto his back in the sand."
    "Subitamente, Neferu usa uma perna para dar uma rasteira no único pé do Alex ainda no chão, fazendo o gato cair de costas na areia."

# game/a2s3.rpy:668
translate pt_br a2s3_b96a7b0f:

    # "Neferu follows him down, pinning the cat there, almost engulfing Alex with his much bigger body."
    "Neferu o acompanha até o chão, prendendo o gato, quase engolindo o Alex com seu corpo muito maior."

# game/a2s3.rpy:670
translate pt_br a2s3_0e6edf73:

    # al "\"Ah! Get—get off me! Help!\""
    al "\"Ah! Sai—sai de cima de mim! Socorro!\""

# game/a2s3.rpy:672
translate pt_br a2s3_03b468a5:

    # "Alex spots me as I come out into the open, standing next to the two of them."
    "Alex me percebe quando saio do esconderijo, me aproximando dos dois."

# game/a2s3.rpy:673
translate pt_br a2s3_76b17575:

    # al "\"[mc]! Help me! The jackal's gone mad!\""
    al "\"[mc]! Me ajude! O chacal ficou louco!\""

# game/a2s3.rpy:674
translate pt_br a2s3_0d363baf:

    # "I fold my arms and stand over him, and Alex quickly realizes that I'm definitely not here to help him."
    "Eu cruzo meus braços e fico de pé ao seu lado, Alex logo percebe que eu definitivamente não estou lá para ajudá-lo."

# game/a2s3.rpy:676
translate pt_br a2s3_729ac122:

    # al "\"What are you two doing!? I told you I know nothing [mc], why must you keep attacking me like this!?\""
    al "\"O que vocês dois estão fazendo!? Eu disse que não sei de nada, [mc], por que você continua me atacando assim!?\""

# game/a2s3.rpy:677
translate pt_br a2s3_e1c6deb3:

    # "Alex continues to struggle meekly under the jackal, not even looking like he's trying to escape."
    "Alex continua falando docilmente sob o chacal, sem nem parecer que está tentando escapar."

# game/a2s3.rpy:679
translate pt_br a2s3_4004b731:

    # n "\"Attack {i}you{/i}? Then why is it {i}my{/i} stomach that is sore?\""
    n "\"Atacando {i}você{/i}? Então por que o {i}meu{/i} estômago que está dolorido?\""

# game/a2s3.rpy:680
translate pt_br a2s3_633b7772:

    # "Alex doesn't seem to be listening and tears start brimming in his eyes as he begins to sob."
    "Alex não parece estar ouvindo e lágrimas começam a brotar de seus olhos enquanto ele começa a soluçar."

# game/a2s3.rpy:681
translate pt_br a2s3_7650205b:

    # "Now I'm fully convinced that his sobs in the bathing room were all an act."
    "Agora eu estou totalmente convencido de que os soluços dele na sala de banhos eram completamente falsos."

# game/a2s3.rpy:683
translate pt_br a2s3_d168a122:

    # n "\"[mc].\""
    n "\"[mc].\""

# game/a2s3.rpy:684
translate pt_br a2s3_e3f17ba3:

    # "I turn my attention back to Neferu who's still smiling as always."
    "Volto minha atenção ao Neferu, ainda sorrindo como sempre."

# game/a2s3.rpy:685
translate pt_br a2s3_9648c2c0:

    # n "\"About ten paces directly in front of me is a large tree, larger than the others that surround it. Do you see it?\""
    n "\"Cerca de dez passos à minha frente há uma grande árvore, maior que as outras em sua volta. Consegue ver?\""

# game/a2s3.rpy:686
translate pt_br a2s3_074f0183:

    # "I look ahead and immediately see what Neferu's talking about, the tree noticeably larger than the others, its branches stretching dozens of feet into the air, the leaves looking like silver in the moonlight."
    "Eu olho para frente e imediatamente vejo a árvore da qual o Neferu falou, é visivelmente maior que as outras, seus galhos se estendendo por vários metros no ar, as folhas parecendo prata sob a luz do luar."

# game/a2s3.rpy:687
translate pt_br a2s3_499b85ea_1:

    # m "\"Yes.\""
    m "\"Sim.\""

# game/a2s3.rpy:688
translate pt_br a2s3_1c3e5518:

    # n "\"Go up to it, circle it, see if you can find a hollow.\""
    n "\"Vá até lá, circule-a, veja se consegue encontrar um buraco.\""

# game/a2s3.rpy:689
translate pt_br a2s3_bfec77e2:

    # "I do as I'm told, feeling a little apprehensive as I step just inside the dark woods."
    "Eu faço como ele diz, me sentindo um pouco apreensivo assim que dou um passo para dentro da pequena floresta escura."

# game/a2s3.rpy:691
translate pt_br a2s3_3b645b7b:

    # al "\"Wait...Neferu, [mc], I don't understand...why are you doing this?\""
    al "\"Espere... Neferu, [mc], eu não entendo... por que vocês estão fazendo isso?\""

# game/a2s3.rpy:692
translate pt_br a2s3_76ec2842:

    # "I realize at that moment how much I'm trusting Neferu here."
    "Eu percebo naquele momento o quanto eu estou depositando minha confiança no Neferu aqui."

# game/a2s3.rpy:693
translate pt_br a2s3_78b48531:

    # "I have no idea what's happening at all."
    "Eu não faço ideia do que está acontecendo."

# game/a2s3.rpy:694
translate pt_br a2s3_89d7ba99:

    # "The trunk of the tree is thick, enough that I wouldn't be able to touch hands if I were to hug it."
    "O tronco da árvore é grosso, o suficiente para eu não conseguir tocar minhas mãos se o abraçasse."

# game/a2s3.rpy:695
translate pt_br a2s3_09b6dbe3:

    # "I start looking for the hollow Neferu described, and as I walk around the tree, I immediately spot one on the other side of it."
    "Começo a procurar o buraco descrito pelo Neferu. Enquanto ando em volta da árvore, imediatamente me deparo com um no outro lado dela."

# game/a2s3.rpy:696
translate pt_br a2s3_29c38ec1:

    # "I look into the black hole, feeling a bit nervous at what I might find in there."
    "Eu olho dentro do buraco escuro, me sentindo um pouco nervoso com o que posso acabar encontrando lá."

# game/a2s3.rpy:697
translate pt_br a2s3_07112e54:

    # m "\"I foun—\""
    m "\"Eu encon—\""

# game/a2s3.rpy:699
translate pt_br a2s3_e172c8b4:

    # "I stop as a tiny, red light in the hollow flares to life with my voice before fading again."
    "Eu paro quando uma luzinha vermelha no buraco se acende com a minha voz antes de apagar de novo."

# game/a2s3.rpy:700
translate pt_br a2s3_6d5433a6:

    # m "\"What the...\""
    m "\"Mas que po...\""

# game/a2s3.rpy:701
translate pt_br a2s3_53363f3e:

    # "It happens again, pulsing to the sound of my voice."
    "Acontece de novo, pulsando com o som da minha voz."

# game/a2s3.rpy:703
translate pt_br a2s3_0440e11f:

    # n "\"You found it?\""
    n "\"Você encontrou?\""

# game/a2s3.rpy:704
translate pt_br a2s3_1858ddf2:

    # m "\"Yeah, and there's a little red light in there that's lighting up with my voice.\""
    m "\"Sim, e tem uma luzinha vermelha dentro que acende com a minha voz.\""

# game/a2s3.rpy:705
translate pt_br a2s3_6465f41e:

    # "I watch the hypnotic ebb and flow of the light as I speak."
    "Eu observo o fluxo hipnótico da luz enquanto falo."

# game/a2s3.rpy:707
translate pt_br a2s3_601cc133:

    # n "\"Thank you, [mc], you may come back now.\""
    n "\"Obrigado, [mc], você pode voltar agora.\""

# game/a2s3.rpy:708
translate pt_br a2s3_90abc67f:

    # "Gratefully, I return to the side of my Khemian friend, noticing that Alex's demeanor has completely changed now."
    "Grato, eu volto para o lado do meu amigo khemiano, notando agora que o comportamento do Alex mudou completamente."

# game/a2s3.rpy:710
translate pt_br a2s3_1aae4ff6:

    # "He's sullen, though almost expressionless as he lays under the jackal, not even pretending to be trying to escape at this point."
    "Ele está mal-humorado, mas quase sem expressão enquanto está sob o chacal, sem nem fingir estar tentando escapar a essa altura."

# game/a2s3.rpy:712
translate pt_br a2s3_2ea90c2e:

    # n "\"Well...that settles it, doesn't it, Alex?\""
    n "\"Bem... isso resolve, não é, Alex?\""

# game/a2s3.rpy:713
translate pt_br a2s3_da24c535:

    # "Alex remains silent, staring up at the sky."
    "Alex permanece em silêncio, encarando o céu."

# game/a2s3.rpy:714
translate pt_br a2s3_3ffe5d76:

    # m "\"What is it?\""
    m "\"O que é aquilo?\""

# game/a2s3.rpy:715
translate pt_br a2s3_1fbbdad4:

    # "Neferu looks up at me."
    "Neferu olha para mim."

# game/a2s3.rpy:717
translate pt_br a2s3_94ffbeda:

    # n "\"Classic Omorfan-parent tech. They often combine plant life and machinery to create their gadgets. Rather ingenious, and they've recently been sharing their knowledge with us on Khemia.\""
    n "\"Tecnologia clássica dos progenitores omorfanos. Eles costumam combinar plantas com máquinas para criar seus aparelhos, bastante engenhoso. Recentemente, eles têm compartilhado seu conhecimento conosco em Khemia.\""

# game/a2s3.rpy:718
translate pt_br a2s3_dd6235d3:

    # al "\"What a mistake that was.\""
    al "\"Que baita erro.\""

# game/a2s3.rpy:719
translate pt_br a2s3_e2f901be:

    # m "\"Wait, but what is it?\""
    m "\"Peraí, mas o que é, realmente?\""

# game/a2s3.rpy:720
translate pt_br a2s3_eefeb61a:

    # n "\"A communication device; it uses the branches as a massive antenna, capable of transmitting information great distances, though it's likely transmitting to Adastra City.\""
    n "\"Um dispositivo de comunicação; ele usa os galhos como uma grande antena, capaz de transmitir informação em grandes distâncias, embora provavelmente esteja transmitindo para a cidade de Adastra.\""

# game/a2s3.rpy:722
translate pt_br a2s3_eb1a9023:

    # n "\"There is likely a second spy there who then beams the information through a much more powerful machine...straight to Omorfa.\""
    n "\"É provável que haja um segundo espião lá que transmite a informação através de uma máquina muito mais poderosa... direto para Omorfa.\""

# game/a2s3.rpy:724
translate pt_br a2s3_7831bdd1:

    # "Neferu grins in Alex's face."
    "Neferu sorri na cara do Alex."

# game/a2s3.rpy:725
translate pt_br a2s3_67d458df:

    # n "\"Isn't that right, Alex?\""
    n "\"Não estou certo, Alex?\""

# game/a2s3.rpy:726
translate pt_br a2s3_9744069d:

    # "Once again, Alex remains silent, seeming to have shut down."
    "Mais uma vez, Alex permanece em silêncio, parecendo ter desligado."

# game/a2s3.rpy:728
translate pt_br a2s3_b19ec0ce:

    # n "\"So, do you want to be the one to tell Cassius, [mc]?\""
    n "\"Então, você quer ser a pessoa que vai contar ao Cassius, [mc]?\""

# game/a2s3.rpy:730
translate pt_br a2s3_78026940:

    # "That finally gets a reaction out of Alex, and he stiffens up, fur bristling out as he snarls at Neferu."
    "Isso finalmente tira uma reação do Alex e ele se enrijece, seu pelo arrepiando enquanto ele rosna para o Neferu."

# game/a2s3.rpy:731
translate pt_br a2s3_c309d903:

    # al "\"And for what reason, jackal? We're all spies here, including you...{i}especially{/i} you.\""
    al "\"E por qual motivo, chacal? Todos nós somos espiões aqui, incluindo você... {i}especialmente{/i} você.\""

# game/a2s3.rpy:733
translate pt_br a2s3_d6e6f378:

    # n "\"Oh? I have no idea what you're talking about, Alex.\""
    n "\"Hã? Eu não faço ideia do que você está falando, Alex.\""

# game/a2s3.rpy:734
translate pt_br a2s3_1a52eb7c:

    # "Neferu's tone says otherwise."
    "O tom do Neferu diz o contrário."

# game/a2s3.rpy:735
translate pt_br a2s3_482c82bf:

    # "Alex continues to glare up at the jackal, his fur starting to lay flat again."
    "Alex continua olhando para o chacal, seu pelo começando a se estabilizar de novo."

# game/a2s3.rpy:737
translate pt_br a2s3_c3e4019f:

    # al "\"Oh, you think I'm that stupid? You think I just let you fuck me without any regard to your intentions, without studying you? I know why you're here, jackal.\""
    al "\"Ah, você acha que eu sou tão idiota assim? Acha que eu apenas deixei você me foder sem levar em consideração as suas intenções, sem estudar você? Eu sei por que está aqui, chacal.\""

# game/a2s3.rpy:739
translate pt_br a2s3_d81b654c:

    # n "\"Do enlighten me, {i}cat{/i}.\""
    n "\"É mesmo? Elabore, {i}gato{/i}.\""

# game/a2s3.rpy:740
translate pt_br a2s3_fe851182:

    # al "\"You're floundering here, looking to make a name for yourself. The Pharaoh practically tossed you off the planet to attempt to cultivate a hopeless alliance on Adastra.\""
    al "\"Você está patinando na lama aqui, tentando criar um título para si mesmo. O Faraó praticamente jogou você do planeta para tentar cultivar uma aliança fadada ao fracasso em Adastra.\""

# game/a2s3.rpy:742
translate pt_br a2s3_e752945d:

    # "Neferu's eyes narrow."
    "Os olhos do Neferu se estreitam."

# game/a2s3.rpy:743
translate pt_br a2s3_bcc8c3bf:

    # al "\"How unfulfilling it must be to be the second-born; unable to escape the shadow of your brother, unable to make father proud, stuck on this moon getting your balls kicked in by the bigot wolves.\""
    al "\"Quão insatisfatória deve ser a posição de segundo filho; incapaz de escapar da sombra de seu irmão, incapaz de deixar o pai orgulhoso, preso nesta lua, tendo suas bolas esmagadas pelos lobos intolerantes.\""

# game/a2s3.rpy:744
translate pt_br a2s3_3d740f39:

    # "Alex sounds and looks almost unrecognizable."
    "Alex soa e parece quase irreconhecível."

# game/a2s3.rpy:745
translate pt_br a2s3_c83cacd1:

    # al "\"Even your sisters; the third and fourth-born, have secured positions of greater prestige than you.\""
    al "\"Até suas irmãs; terceira e quarta nascidas, garantiram posições de maior prestígio que você.\""

# game/a2s3.rpy:747
translate pt_br a2s3_5c50ac7c:

    # "I see Neferu grip tighter into Alex, but the cat goes on."
    "Eu noto Neferu apertando o Alex com mais força, mas o gato continua."

# game/a2s3.rpy:748
translate pt_br a2s3_eb059068:

    # al "\"In an era when the royal family has already given up so much power, you're desperate behind that facade of confidence, terrified of withering away into historical insignificance.\""
    al "\"Numa época em que a família real já desistiu de tanto poder, você está desesperado por trás desta fachada de confiança, aterrorizado de definhar em insignificância histórica.\""

# game/a2s3.rpy:749
translate pt_br a2s3_7d098f87:

    # al "\"You'll be less than a footnote in the Khemian history books.\""
    al "\"Você será menos que uma nota de rodapé nos livros de história khemianos.\""

# game/a2s3.rpy:750
translate pt_br a2s3_d64b55c3:

    # "Neferu isn't smiling anymore, and I can tell that he's been caught off-guard just as much as me by the cat's complete change in character."
    "Neferu não está mais sorrindo e posso dizer que ele foi pego de surpresa tanto quanto eu pela mudança completa no semblante do gato."

# game/a2s3.rpy:751
translate pt_br a2s3_8e278c19:

    # "Still, he keeps his hold on the cat, remarking coolly:"
    "Ainda assim, ele continua o prendendo, respondendo friamente:"

# game/a2s3.rpy:752
translate pt_br a2s3_76809927:

    # n "\"I would choose my words more carefully if I were you, considering your position right now. As I was saying, we'll be reporting this to the emperor as soon as we return to the palace.\""
    n "\"Eu escolheria minhas palavras com mais cuidado se fosse você, considerando sua posição agora. Como estava dizendo, reportaremos isso ao imperador assim que voltarmos para o palácio.\""

# game/a2s3.rpy:753
translate pt_br a2s3_1b3a7266:

    # "Alex seems to deflate again, apparently satisfied with the hits he'd gotten in on the jackal."
    "Alex parece relaxar de novo, aparentemente satisfeito com os golpes verbais que deu no chacal."

# game/a2s3.rpy:754
translate pt_br a2s3_563bb06f:

    # al "\"What do you want?\""
    al "\"O que você quer?\""

# game/a2s3.rpy:756
translate pt_br a2s3_c79f82d9:

    # n "\"Hm?\""
    n "\"Hm?\""

# game/a2s3.rpy:757
translate pt_br a2s3_0be5fa8b:

    # al "\"Don't play stupid, what do you want from me? You've known I was a spy since you first got here and you're only doing this now because you want something.\""
    al "\"Não se faça de idiota, o que quer de mim? Você sabia que eu era um espião desde que chegou aqui e só está fazendo isso agora porque precisa de algo.\""

# game/a2s3.rpy:761
translate pt_br a2s3_6b6518f6:

    # n "\"Oh, how considerate of you, well...\""
    n "\"Ah, que atencioso de sua parte, bem...\""

# game/a2s3.rpy:762
translate pt_br a2s3_1fbbdad4_1:

    # "Neferu looks up at me."
    "Neferu olha para mim."

# game/a2s3.rpy:764
translate pt_br a2s3_f792ff23:

    # n "\"What do you think we want, [mc]?\""
    n "\"O que você acha que nós queremos, [mc]?\""

# game/a2s3.rpy:765
translate pt_br a2s3_1903be76:

    # m "\"Full access to the archives.\""
    m "\"Acesso total aos arquivos.\""

# game/a2s3.rpy:766
translate pt_br a2s3_f790a578:

    # "Alex snorts."
    "Alex bufa."

# game/a2s3.rpy:767
translate pt_br a2s3_d6e1b454:

    # al "\"I don't have that.\""
    al "\"Eu não tenho isso.\""

# game/a2s3.rpy:769
translate pt_br a2s3_2b7243e8:

    # n "\"Then get it. We know how close you are to Cassius. Make something up as to why you need it, then grant us access.\""
    n "\"Então mexa seus pauzinhos. Sabemos quão próximo você é do Cassius. Invente um motivo pelo qual você precisa e conceda-nos acesso.\""

# game/a2s3.rpy:770
translate pt_br a2s3_4d558b87:

    # al "\"For what reason?\""
    al "\"E para que?\""

# game/a2s3.rpy:771
translate pt_br a2s3_53c4d5d3:

    # n "\"To help Amicus. Cassius will not be harmed by this. You have until next week, otherwise the emperor will know of your treason.\""
    n "\"Para ajudar o Amicus. Cassius não será prejudicado por isso. Você tem até a próxima semana, caso contrário, o imperador saberá sobre sua traição.\""

# game/a2s3.rpy:772
translate pt_br a2s3_47e50a4d:

    # "Alex remains quiet, and Neferu seems satisfied with that, pushing off the cat and getting to his feet."
    "Alex permanece quieto e Neferu parece satisfeito com isso, largando do gato e se levantando."

# game/a2s3.rpy:774
translate pt_br a2s3_8ce4c26f:

    # n "\"Let us be off.\""
    n "\"Vamos indo.\""

# game/a2s3.rpy:775
translate pt_br a2s3_af313c62:

    # "The jackal speaks briskly to me before turning on his heel and making his way back to the craft."
    "O chacal fala rapidamente comigo antes de se virar e seguir o caminho de volta à embarcação."

# game/a2s3.rpy:777
translate pt_br a2s3_6b3fe700:

    # "I look down at Alex, watching as the cat simply stares at the moons, not even acknowledging me."
    "Eu olho de volta para o Alex, observando enquanto o gato simplesmente encara as luas, sem nem reconhecer minha existência."

# game/a2s3.rpy:780
translate pt_br a2s3_fc2931e2:

    # "The way back is a bit awkward, Neferu quiet, clearly upset."
    "O caminho de volta é um pouco estranho, Neferu quieto, claramente chateado."

# game/a2s3.rpy:781
translate pt_br a2s3_493b215d:

    # "I haven't really ever seen him like this before, and I have to remind myself that I probably rarely see the real Neferu."
    "Eu realmente nunca tinha visto ele desse jeito antes e preciso me lembrar que eu raramente vejo o verdadeiro Neferu."

# game/a2s3.rpy:782
translate pt_br a2s3_3fe194b7:

    # "He's putting on an act just like Alex, just like they both have to."
    "Ele está performando o tempo todo assim como o Alex, exatamente como precisam fazer."

# game/a2s3.rpy:783
translate pt_br a2s3_80a8cfbc:

    # "And though I'm curious about his family situation, I have enough sense not to pry."
    "E embora eu esteja curioso sobre a situação da família dele, tenho bom senso o suficiente para não me intrometer."

# game/a2s3.rpy:784
translate pt_br a2s3_8e87d929:

    # "Instead, I ask what I'm most worried about:"
    "Em vez disso, pergunto sobre o que me deixa mais preocupado:"

# game/a2s3.rpy:785
translate pt_br a2s3_4607deff:

    # m "\"What's to stop Alex from betraying us? He could just as easily tell Cassius about our plot.\""
    m "\"O que impede o Alex de nos trair? Ele poderia facilmente contar pro Cassius sobre o plano.\""

# game/a2s3.rpy:786
translate pt_br a2s3_f997806a:

    # "The jackal is staring off into the water, his elbows on the railing of the Sightseer as he hunches over."
    "O chacal está encarando a água, seus cotovelos repousando no parapeito do aero-observador."

# game/a2s3.rpy:787
translate pt_br a2s3_78abd7c7:

    # n "\"He won't. He can't bear the thought of Cassius knowing of his betrayal.\""
    n "\"Ele não vai nos entregar. Não suporta a ideia do Cassius descobrindo sobre sua traição.\""

# game/a2s3.rpy:788
translate pt_br a2s3_9113d5f8:

    # "The usual confidence and natural smugness that's usually in the jackal's voice is completely missing, his tone flat."
    "A confiança habitual e a natural presunção que normalmente transparecem na voz do chacal estão completamente ausentes, seu tom monótono."

# game/a2s3.rpy:789
translate pt_br a2s3_4dd72ad2_1:

    # m "\"You sure?\""
    m "\"Você tem certeza?\""

# game/a2s3.rpy:791
translate pt_br a2s3_9a4717be:

    # n "\"Yes. His love for Cassius is almost equal to that of his loyalty to Omorfa, which is why I assured him that Cassius wouldn't be harmed by our plans. We have little to worry about.\""
    n "\"Sim. Seu amor pelo Cassius é quase igual ao de sua lealdade a Omorfa e foi por isso que eu assegurei que Cassius não seria prejudicado por nossos planos. Temos pouco com o que nos preocupar.\""

# game/a2s3.rpy:792
translate pt_br a2s3_3dc275e5:

    # "The jackal's mood puts me off from asking any more questions, and we sail the rest of the way to the palace in silence."
    "O humor do chacal me impede de fazer mais perguntas e navegamos o resto do caminho até o palácio em silêncio."

# game/a2s3.rpy:796
translate pt_br a2s3_9272fc51:

    # "Three days later, Alex is able to gain full access to the archives."
    "Três dias depois, Alex consegue obter acesso total aos arquivos."

# game/a2s3.rpy:797
translate pt_br a2s3_c5a21186:

    # "He doesn't explain to us how he did it, instead simply notifying Neferu of the specific time he'd open the archives for us and to be ready."
    "Ele não explica para nós como fez isso, simplesmente notifica Neferu sobre o horário específico em que ele abriria os arquivos para nós e para estarmos preparados."

# game/a2s3.rpy:798
translate pt_br a2s3_88e0c2b3:

    # "I don't have to argue to come along this time, instead Virginia tells me that I'll need to go if we're to erase my profile from the palace's database."
    "Eu não preciso argumentar para vir junto dessa vez, em vez disso, Virginia me diz que eu preciso ir se quisermos apagar meu perfil do banco de dados do palácio."

# game/a2s3.rpy:799
translate pt_br a2s3_6c31cd06:

    # "Doing this will allow me to leave the palace without being killed by Com; just another last resort in case things go bad."
    "Fazer isso me permitirá sair do palácio sem ser morto pelo Com; apenas um outro último recurso, no caso das coisas irem de mal a pior."

# game/a2s3.rpy:800
translate pt_br a2s3_ea3f7231:

    # "Neferu stays behind this time, deciding it to be best considering he's not exactly needed for what we're about to do."
    "Neferu fica para trás dessa vez, decidindo que é melhor considerando que a presença dele não é exatamente necessária para o que nós estamos prestes a fazer."

# game/a2s3.rpy:802
translate pt_br a2s3_13e811f3:

    # "Alex walks stiffly ahead of us, not speaking or really acknowledging us in any way."
    "Alex caminha rigidamente à nossa frente, sem falar ou reconhecer nossa presença de qualquer maneira."

# game/a2s3.rpy:803
translate pt_br a2s3_1f9c1f4a:

    # "I find it unnerving after knowing the cat for so long, though Virginia doesn't seem bothered at all."
    "Acho isso irritante depois de conhecer o gato por tanto tempo, embora Virginia não pareça incomodada de forma alguma."

# game/a2s3.rpy:804
translate pt_br a2s3_42f4d75c:

    # "We walk to a portion of the palace that I haven't been to very often, mostly because I was never shown the area."
    "Nós caminhamos até uma parte do palácio na qual eu não estive com muita frequência, principalmente por que nunca me mostraram a área."

# game/a2s3.rpy:806
translate pt_br a2s3_0f6d0f45:

    # "Alex comes to a door that he presses his hand to, and unlike the other black panels, this one flashes a green color before the door opens."
    "Alex chega em uma porta na qual ele pressiona uma pata e, ao contrário dos outros painéis pretos, esse pisca uma luz verde antes da porta se abrir."

# game/a2s3.rpy:810
translate pt_br a2s3_871a640b:

    # "We walk inside the room, and I get my first look at the archive."
    "Nós entramos na sala e eu tenho meu primeiro vislumbre do arquivo."

# game/a2s3.rpy:811
translate pt_br a2s3_0f5eae29:

    # "I guess I'd expected rows of bookshelves, full of some type of digital storage, or whatever the wolves might use."
    "Acho que eu esperava filas de estantes cheias de algum tipo de armazenamento digital, ou seja lá o que os lobos devem usar."

# game/a2s3.rpy:812
translate pt_br a2s3_cb36a58e:

    # "Instead, I'm greeted by the sight of a giant, blue, glowing, sphere, with a honeycomb pattern covering its surface."
    "Em vez disso, sou recebido com a visão de uma esfera gigante, azul e brilhante, com um padrão de favo de mel cobrindo sua superfície."

# game/a2s3.rpy:813
translate pt_br a2s3_a5e4fbda:

    # "What's most striking about it though is the swirling characters that appear and disappear just over the surface."
    "O mais impressionante, porém, são os símbolos deslizando que aparecem e desaparecem logo acima da superfície."

# game/a2s3.rpy:814
translate pt_br a2s3_774b3e86:

    # "They're symbols I don't recognize, not any that I've seen on Adastra before."
    "São símbolos os quais eu não reconheço, nenhum que eu já tinha visto em Adastra antes."

# game/a2s3.rpy:815
translate pt_br a2s3_15aabad5:

    # "Sitting in front of the floating sphere are two stone dragons, mouths open in silent snarls."
    "Em frente à esfera flutuante estão dois dragões de pedra, as bocas abertas em rosnados silenciosos."

# game/a2s3.rpy:817
translate pt_br a2s3_59eb49d6:

    # "Alex seems to be in a hurry as he walks up to the globe."
    "Alex parece estar com pressa enquanto caminha até o globo."

# game/a2s3.rpy:818
translate pt_br a2s3_1a335fee:

    # "Without hesitation, he sticks his paw into the swirling blue and the characters and swirls seem to congregate around it before the whole thing pulses."
    "Sem hesitação, ele coloca a pata no azul rodopiante e os símbolos e redemoinhos parecem se aglomerar ao redor dela antes da coisa toda começar a pulsar."

# game/a2s3.rpy:819
translate pt_br a2s3_6ccb79d3:

    # "This seems to satisfy the cat as he turns away."
    "Isso parece satisfazer o gato enquanto ele recua."

# game/a2s3.rpy:820
translate pt_br a2s3_8cda2afe:

    # al "\"That should give you full access. You're on your own from here.\""
    al "\"Isso deve lhes dar acesso total. Vocês estão por conta própria a partir daqui.\""

# game/a2s3.rpy:822
translate pt_br a2s3_ffa5a246:

    # "With that, the cat leaves."
    "Com isso, o gato vai embora."

# game/a2s3.rpy:823
translate pt_br a2s3_364de252:

    # "I watch him disappear out the door, for the first time feeling a bit sad at how our relationship has changed."
    "Eu observo ele desaparecer pela porta, pela primeira vez me sentindo um pouco triste com a forma que nosso relacionamento mudou."

# game/a2s3.rpy:824
translate pt_br a2s3_8a6ea339:

    # "Virginia remains unbothered though, walking up to the blue sphere as I follow."
    "Mas Virginia permanece despreocupada, caminhando até a esfera azul enquanto eu a sigo."

# game/a2s3.rpy:826
translate pt_br a2s3_7e12e528:

    # "I stand there awkwardly for a moment before clearing my throat."
    "Eu fico ali sem jeito por um momento antes de pigarrear."

# game/a2s3.rpy:827
translate pt_br a2s3_f9788f64:

    # m "\"So what is this thing?\""
    m "\"Então, o que é essa coisa?\""

# game/a2s3.rpy:828
translate pt_br a2s3_38208612:

    # v "\"The archive.\""
    v "\"O arquivo.\""

# game/a2s3.rpy:829
translate pt_br a2s3_9f1039c1:

    # m "\"Yeah, but it looks—\""
    m "\"Sim, mas parece—\""

# game/a2s3.rpy:830
translate pt_br a2s3_facdf448:

    # v "\"It's parental, yes, and no, I don't know how it works. It was also used as the method of communication with the parents before they ceased contact, hence the meditation pillow.\""
    v "\"É tecnologia progenitora, sim, e não, eu não sei como funciona. Também era utilizado como método de comunicação com os progenitores antes deles cessarem o contato, por isso há um travesseiro de meditação.\""

# game/a2s3.rpy:831
translate pt_br a2s3_ffa7dd1c:

    # "Virginia gestures at the pillow before she leans forward slightly, a streak of blue light wrapping around her head briefly before she leans back."
    "Virginia gesticula para o travesseiro antes de se inclinar um pouco para frente, uma faixa de luz azul envolvendo sua cabeça brevemente antes de se inclinar de volta."

# game/a2s3.rpy:833
translate pt_br a2s3_21cfe5d6:

    # v "\"It connects to the host's brain, similar to the lingua and operates on mind-control.\""
    v "\"Ele se conecta ao cérebro do hospedeiro, semelhante ao interpretus, e opera sob controle mental.\""

# game/a2s3.rpy:834
translate pt_br a2s3_8c4e5c77:

    # m "\"Wow.\""
    m "\"Uau.\""

# game/a2s3.rpy:835
translate pt_br a2s3_e512b0f6:

    # v "\"Yes, I haven't used it often, but it's fairly easy to control. You'll find out soon enough.\""
    v "\"Sim, eu não o usei com frequência, mas é bem fácil de controlar. Você descobrirá em breve.\""

# game/a2s3.rpy:836
translate pt_br a2s3_2d6ee573:

    # m "\"Oh.\""
    m "\"Ah.\""

# game/a2s3.rpy:837
translate pt_br a2s3_e782780e:

    # "I feel a bit nervous, but Virginia focuses back on the blue globe."
    "Eu me sinto um pouco nervoso, mas Virginia foca de volta no globo azul."

# game/a2s3.rpy:839
translate pt_br a2s3_2a079b62:

    # "Suddenly, a small screen appears over the sphere, and I see what looks like the amphitheater."
    "De repente, uma pequena tela aparece sobre a esfera, e eu vejo o que parece ser o anfiteatro."

# game/a2s3.rpy:840
translate pt_br a2s3_6c07d12d:

    # v "\"Hmmm...what day was the final trial?\""
    v "\"Hmmm... que dia foi o último julgamento?\""

# game/a2s3.rpy:841
translate pt_br a2s3_a5076383:

    # "I'm about to answer when suddenly Virginia just waves me into silence, focusing on the screen again."
    "Eu estou prestes a responder quando, de repente, Virginia acena para que eu fique em silêncio, concentrando-se na tela de novo."

# game/a2s3.rpy:842
translate pt_br a2s3_cfb08b2e:

    # "I see the scene change to a bloody sunset, and I feel the same anxiety I'd felt that day as I see Cato and Amicus appear on the screen, followed by me and Cassius."
    "Vejo o enquadramento mudar para um pôr do sol sangrento e sinto a mesma ansiedade que senti naquele dia enquanto observo Cato e Amicus aparecerem na tela, seguidos por mim e Cassius."

# game/a2s3.rpy:843
translate pt_br a2s3_0bcf83cb:

    # "The angle is high, and the scene is a bit distant, probably from the palace, but I can make everyone out clearly."
    "O ângulo é alto e o enquadramento é um pouco distante, provavelmente do palácio, mas eu consigo discernir todos claramente."

# game/a2s3.rpy:844
translate pt_br a2s3_a4d8c44c:

    # "Cassius strips and hurries down the steps to the amphitheater, and I want to look away, but don't as Cato turns on Amicus and punches him in the face."
    "Cassius tira a roupa e corre os degraus até o centro do anfiteatro, não desvio o olhar apesar de querer enquanto o Cato se vira para o Amicus e dá um soco no rosto dele."

# game/a2s3.rpy:846
translate pt_br a2s3_d9c296f2:

    # "Virginia's reaction is small but noticeable, clearly surprised by Cato's brutality."
    "A reação da Virginia é pequena, mas perceptível, claramente surpresa com a brutalidade do Cato."

# game/a2s3.rpy:847
translate pt_br a2s3_f538bf47:

    # "What follows is the awkward, staged posing, and the pin."
    "O que se segue é a pose desajeitada encenada e o palco."

# game/a2s3.rpy:848
translate pt_br a2s3_4e4520d2:

    # "Then, the footage of me using the nervo on Cassius."
    "E então, a filmagem do momento no qual eu uso o nervo no Cassius."

# game/a2s3.rpy:849
translate pt_br a2s3_cd12ba09:

    # "This is followed by Amicus tearing off Cato's visor."
    "Isso é seguido pelo Amicus arrancando o visor do Cato."

# game/a2s3.rpy:850
translate pt_br a2s3_6a254cb7:

    # "After that, I run off-screen, and I get to watch as drones descend on Amicus and he suddenly goes limp as they, I assume, stun him."
    "Depois disso, eu corro para fora da tela e assisto os drones descerem até o Amicus e ele fica todo mole quando eles, suponho, o desmaiam."

# game/a2s3.rpy:851
translate pt_br a2s3_f9258bd7:

    # "Virginia watches all of this with an open mouth until Amicus is escorted away and Cato is picked up by a small ship that lands in the middle of the amphitheater."
    "Virginia assiste tudo isso de boca aberta até o Amicus ser escoltado para longe e Cato ser levado por uma pequena nave que pousa no meio do anfiteatro."

# game/a2s3.rpy:852
translate pt_br a2s3_66c3ca4e:

    # "Then she shakes her head."
    "Então ela balança a cabeça."

# game/a2s3.rpy:853
translate pt_br a2s3_2dce5ff1:

    # v "\"Males...\""
    v "\"Homens...\""

# game/a2s3.rpy:854
translate pt_br a2s3_3d9ff6a8:

    # "Virginia sighs out in frustration as the screen fades."
    "Virginia suspira de frustração conforme a tela desaparece."

# game/a2s3.rpy:855
translate pt_br a2s3_0f8f6996:

    # m "\"So you got the footage?\""
    m "\"Então, você pegou a filmagem?\""

# game/a2s3.rpy:857
translate pt_br a2s3_40b99dca:

    # v "\"I've filed it away to a domain accessible by both me and Neferu. We'll figure out a way to use it delicately.\""
    v "\"Eu a arquivei em um domínio acessível por mim e Neferu. Vamos descobrir uma maneira de utilizá-la cuidadosamente.\""

# game/a2s3.rpy:858
translate pt_br a2s3_83fd8e46:

    # m "\"And the investigation into the crash?\""
    m "\"E a investigação sobre o acidente?\""

# game/a2s3.rpy:859
translate pt_br a2s3_a591bd5e:

    # "This is something that I'd brought up to Virginia and Neferu before we came here, even though both seemed skeptical that it could be useful in any way."
    "Isso é algo que eu citei na conversa com Virginia e Neferu antes de virmos até aqui, mesmo que ambos parecessem céticos de que isso poderia ser útil de qualquer forma."

# game/a2s3.rpy:860
translate pt_br a2s3_ffa1a384:

    # "That even Cato wouldn't be so devious as to kill his own friend, a friend that happened to be the emperor."
    "Que nem o Cato seria tão desonesto a ponto de matar seu próprio amigo, um amigo que por acaso era o imperador."

# game/a2s3.rpy:862
translate pt_br a2s3_1a3feec2:

    # "Even now, Virginia sighs as if it's an annoying inconvenience, but focuses for a moment until she seems satisfied."
    "Mesmo agora, Virginia suspira como se fosse uma inconveniência irritante, mas se concentra por um momento até parecer satisfeita."

# game/a2s3.rpy:863
translate pt_br a2s3_a59b96d7:

    # v "\"Done, all documents related to the investigation are now in the same location. We'll go over it later...well, at least you and Neferu can.\""
    v "\"Feito, todos os documentos relacionados à investigação estão agora no mesmo lugar. Vamos falar sobre isso mais tarde... bem, você e o Neferu pelo menos.\""

# game/a2s3.rpy:864
translate pt_br a2s3_3b1ed4fc:

    # "There's a momentary pause."
    "Há uma pausa momentânea."

# game/a2s3.rpy:865
translate pt_br a2s3_e7d5566d:

    # m "\"Well, that was easy.\""
    m "\"É, isso foi fácil.\""

# game/a2s3.rpy:867
translate pt_br a2s3_59b6666d:

    # v "\"What did you expect? Parental tech makes everything fast and easy.\""
    v "\"O que você esperava? Tecnologia progenitora faz tudo ser rápido e fácil.\""

# game/a2s3.rpy:868
translate pt_br a2s3_ad361723:

    # m "\"Yeah, I suppose.\""
    m "\"É, suponho que sim.\""

# game/a2s3.rpy:869
translate pt_br a2s3_f856689c:

    # v "\"So...are you ready to use it?\""
    v "\"Então... você está pronto para usá-lo?\""

# game/a2s3.rpy:870
translate pt_br a2s3_790983c9:

    # m "\"I—I think so.\""
    m "\"Eu—eu acho que sim.\""

# game/a2s3.rpy:871
translate pt_br a2s3_ca601d26:

    # "Virginia smiles at me."
    "Virginia sorri para mim."

# game/a2s3.rpy:872
translate pt_br a2s3_8d3c566e:

    # v "\"Don't worry, it's easy. Simply keep your mind clear of anything except your objective; your profile and how it should be wiped clean from the archive.\""
    v "\"Não se preocupe, é fácil. Simplesmente mantenha sua mente livre de qualquer coisa que não seja seu objetivo; seu registro e como ele deveria ser apagado dos arquivos.\""

# game/a2s3.rpy:873
translate pt_br a2s3_7a54ef63:

    # m "\"My profile...\""
    m "\"Meu registro...\""

# game/a2s3.rpy:874
translate pt_br a2s3_d70c5ad0:

    # "I try to think up how I should imagine a profile, but Virginia stops me."
    "Eu tento pensar em como deveria imaginar um registro, mas Virginia me para."

# game/a2s3.rpy:875
translate pt_br a2s3_bf33af45:

    # v "\"You're already thinking too much. Just this; your profile, wipe it from the archives.\""
    v "\"Você já está pensando demais. Só isso: seu registro, apague-o do arquivo.\""

# game/a2s3.rpy:877
translate pt_br a2s3_f9f7e2cd:

    # "I swallow hard, but allow Virginia to gently push me forward until one of the tendrils touches my head."
    "Eu engulo seco, mas permito que Virginia me empurre gentilmente para a frente até um dos fios tocar minha cabeça."

# game/a2s3.rpy:878
translate pt_br a2s3_b7026e49:

    # "It's a cool feeling at first, then suddenly my body seize up involuntarily as it feels like my entire brain twitches."
    "É uma sensação legal no começo, mas de repente meu corpo se contrai involuntariamente e sinto como se meu cérebro inteiro estivesse se contraindo."

# game/a2s3.rpy:879
translate pt_br a2s3_d31d9f92:

    # v "\"Keep focused on your objective.\""
    v "\"Se concentre em seu objetivo.\""

# game/a2s3.rpy:881
translate pt_br a2s3_e3950d90:

    # "My profile, gone...my profile, erase it...my profile...delete from the archives..."
    "Meu registro, sem vestígios... meu registro, apague... meu registro... delete dos arquivos..."

# game/a2s3.rpy:885
translate pt_br a2s3_0c01baca:

    # "A dagger, screams, pain, blood, hissing breath, spurting red, absolute anguish—"
    "Uma adaga, gritos, dor, sangue, respiração ofegante, um jorro vermelho, angústia absoluta—"

# game/a2s3.rpy:886
translate pt_br a2s3_92294901:

    # a "\"[mc]! No, please! Don't leave me here! Please, come back to me! You can't leave me to be alone like this!\""
    a "\"[mc]! Não, por favor! Não me deixe aqui! Por favor, volte para mim! Você não pode me deixar sozinho assim!\""

# game/a2s3.rpy:887
translate pt_br a2s3_67ea409f:

    # "Amicus screams right into my ear, and I've never heard him sound like this before."
    "Amicus grita bem no meu ouvido e eu nunca ouvi ele falando desse jeito antes."

# game/a2s3.rpy:888
translate pt_br a2s3_246f80e7:

    # "It's horrible, and I know I need to comfort him, to tell him I'm not leaving, but my voice is gone and air hisses from my throat."
    "É horrível e eu sei que preciso confortá-lo, dizer a ele que eu não vou embora, mas minha voz se foi e ar sai da minha garganta de forma áspera."

# game/a2s3.rpy:889
translate pt_br a2s3_7af048ec:

    # a "\"No, no, no...speak to me!\""
    a "\"Não, não, não... fale comigo!\""

# game/a2s3.rpy:890
translate pt_br a2s3_410b1b90:

    # "Amicus's voice rises in pitch, panicking, becoming desperate."
    "O tom de voz do Amicus aumenta em timbre, entrando em pânico, totalmente desesperado."

# game/a2s3.rpy:891
translate pt_br a2s3_94b54f13:

    # "Then it all stops."
    "E então, tudo para."

# game/a2s3.rpy:892
translate pt_br a2s3_a20cefa7:

    # "..."
    "..."

# game/a2s3.rpy:893
translate pt_br a2s3_7b3a49ae:

    # mon "\"You can prevent this...\""
    mon "\"Você pode impedir isso...\""

# game/a2s3.rpy:894
translate pt_br a2s3_a20cefa7_1:

    # "..."
    "..."

# game/a2s3.rpy:895
translate pt_br a2s3_4a623aa4:

    # mon "\"But only if you submit yourself to the benevolent will of the parents..."
    mon "\"Mas somente caso se submeta à vontade benevolente dos progenitores..."

# game/a2s3.rpy:896
translate pt_br a2s3_a20cefa7_2:

    # "..."
    "..."

# game/a2s3.rpy:897
translate pt_br a2s3_30bfd9a1:

    # mon "\"Will you?\""
    mon "\"Você está de acordo?\""

# game/a2s3.rpy:903
translate pt_br a2s3_a20cefa7_3:

    # "..."
    "..."

# game/a2s3.rpy:906
translate pt_br a2s3_a20cefa7_4:

    # "..."
    "..."

# game/a2s3.rpy:909
translate pt_br a2s3_4bd6c2b6:

    # "I gasp and pull back, head reeling."
    "Eu ofego e sou puxado de volta, cabeça cambaleando."

# game/a2s3.rpy:910
translate pt_br a2s3_cc6f60f2:

    # "I feel soft but strong paws grip me around the shoulders."
    "Sinto patas macias, porém fortes, me agarrando pelos ombros."

# game/a2s3.rpy:912
translate pt_br a2s3_c6bb4c15:

    # v "\"Are you alright?\""
    v "\"Você está bem?\""

# game/a2s3.rpy:913
translate pt_br a2s3_bb7373a7:

    # "I look around, wide-eyed, feeling almost sick as that weird feeling of control in brain suddenly leaves."
    "Eu olho em volta com os olhos arregalados, quase me sentindo mal enquanto a estranha sensação de controle mental repentinamente desaparece."

# game/a2s3.rpy:914
translate pt_br a2s3_9046708a:

    # m "\"I—\""
    m "\"Eu—\""

# game/a2s3.rpy:915
translate pt_br a2s3_0d8e8ad8:

    # "I don't know what to say, and Virginia glances back at the sphere."
    "Eu não sei o que dizer e Virginia olha de volta para a esfera."

# game/a2s3.rpy:916
translate pt_br a2s3_c29f80bf:

    # v "\"Might not be suited to a simian brain. Com?\""
    v "\"Talvez não seja adequado para um cérebro símio, Com?\""

# game/a2s3.rpy:917
translate pt_br a2s3_3e3b21b8:

    # com "\"Yes Virginia?\""
    com "\"Sim, Virginia?\""

# game/a2s3.rpy:918
translate pt_br a2s3_8382f04e:

    # v "\"Locate [mc]'s profile.\""
    v "\"Localize o registro do [mc].\""

# game/a2s3.rpy:919
translate pt_br a2s3_35be8e76:

    # com "\"There is no such profile archived.\""
    com "\"Não existe tal registro nos arquivos.\""

# game/a2s3.rpy:920
translate pt_br a2s3_ea8a57d9:

    # v "\"Well, you did it at least. Let's get you back to Neferu's room.\""
    v "\"Bem, pelo menos você fez o que tinha que fazer. Vamos levá-lo de volta para o quarto do Neferu.\""

# game/a2s3.rpy:922
translate pt_br a2s3_b60a855c:

    # "We walk through the halls, Virginia having to help because of my unsteady feet."
    "Andamos pelos corredores, Virginia tendo que me ajudar por causa da minha instabilidade na caminhada."

# game/a2s3.rpy:923
translate pt_br a2s3_5e0839c1:

    # "I'm stunned, feeling as if I'd just come up from another drug trip."
    "Fiquei atordoado, sentindo como se tivesse acabado de voltar de outra viagem nas drogas."

# game/a2s3.rpy:924
translate pt_br a2s3_1bcdec4d:

    # "But it's not what I felt, or even the visions of violence that have me shaken up."
    "Mas não foi o que senti e nem mesmo as visões de violência que me abalaram."

# game/a2s3.rpy:925
translate pt_br a2s3_28d93abb:

    # "It's Amicus's screams of despair that linger in my head..."
    "Foram os gritos de desespero do Amicus que ficaram na minha cabeça..."

# game/a2s3.rpy:926
translate pt_br a2s3_0728594f:

    # "I have to see him as soon as possible."
    "Eu tenho que vê-lo o mais rápido possível."

# game/a2s3.rpy:927
translate pt_br a2s3_3d1cf249:

    # "I have to make sure he's all right."
    "Eu preciso ter certeza de que ele está bem."

# game/a2s3.rpy:932
translate pt_br a2s3_93b5e4b6:

    # a "\"Mmmh, you smell so good...\""
    a "\"Mmmh, você cheira tão bem...\""

# game/a2s3.rpy:934
translate pt_br a2s3_7278cbec:

    # "Amicus has me pinned to the floor on the little blanket that I brought with me."
    "Amicus me mantém preso ao chão em cima do pequeno cobertor que eu trouxe comigo."

# game/a2s3.rpy:935
translate pt_br a2s3_c6cdbe29:

    # "He's smothering me with his big body, grinding down against me as he licks and nips at my neck."
    "Ele está me sufocando com seu grande corpo, se amassando contra mim enquanto lambe e belisca meu pescoço."

# game/a2s3.rpy:936
translate pt_br a2s3_01ffd205:

    # "I haven't even been here more than a minute."
    "Eu não estive aqui por mais de um minuto."

# game/a2s3.rpy:937
translate pt_br a2s3_4caab3a4:

    # m "\"W—wait, what if...what if Com sees...\""
    m "\"E—espera, e se... e se o Com ver...\""

# game/a2s3.rpy:938
translate pt_br a2s3_9ee7f23e:

    # "I gasp around the licks and Amicus responds by holding my head in his giant paws, keeping me steady as he starts to push his hips against me, his thighs forcing my legs upward."
    "Eu solto arfadas com as lambidas do Amicus e ele responde segurando minha cabeça com suas grandes patas, me mantendo firme enquanto começa a empurrar seu quadril contra mim, suas coxas forçando minhas pernas para cima."

# game/a2s3.rpy:939
translate pt_br a2s3_07725523:

    # "Amicus mumbles into my throat."
    "Amicus murmura na minha garganta."

# game/a2s3.rpy:941
translate pt_br a2s3_0a545422:

    # a "\"Then let him watch.\""
    a "\"Então o deixe assistir.\""

# game/a2s3.rpy:942
translate pt_br a2s3_32bdd994:

    # "Com isn't watching, as far as I know."
    "Com não está observando, até onde eu sei."

# game/a2s3.rpy:943
translate pt_br a2s3_aac2bdca:

    # "Somehow I'd been able to convince Cassius to give us more privacy."
    "De algum jeito eu fui capaz de convencer o Cassius a nos dar mais privacidade."

# game/a2s3.rpy:944
translate pt_br a2s3_9edc050c:

    # "Actually, I think I'd just grossed him out when I'd asked, wrinkling his nose as he instructed Com to keep the drone at the top of the ladder this time."
    "Na verdade, acho que só acabei o enojando quando perguntei, ele torcendo o nariz enquanto dava instruções ao Com para manter o drone no topo da escada dessa vez."

# game/a2s3.rpy:945
translate pt_br a2s3_1d3c9fdb:

    # "At that moment, I feel the wolf's hard length pressing at my ass, and even though I'm in my underwear and robes, I pull back."
    "Naquele momento, sinto o rígido comprimento do lobo pressionando contra meu traseiro e, por mais que eu esteja vestido, me afasto."

# game/a2s3.rpy:946
translate pt_br a2s3_92f51ad4:

    # m "\"Whoa, not now, Amicus!\""
    m "\"Ei, agora não, Amicus!\""

# game/a2s3.rpy:947
translate pt_br a2s3_ec6e5d34:

    # "Amicus goes on nuzzling me, moving to my face and locking lips with me for several seconds while he continues to push his hips against me."
    "Amicus continua me acariciando, movendo até o meu rosto e travando seus lábios com os meus por vários segundos enquanto continua a empurrar o quadril contra mim."

# game/a2s3.rpy:948
translate pt_br a2s3_06e18670:

    # "He finally pulls back a little."
    "Ele finalmente se afasta um pouco."

# game/a2s3.rpy:949
translate pt_br a2s3_68b3923e:

    # a "\"I know, I'm just playing around a little. I've been down here too long. I love you, everything about you.\""
    a "\"Eu sei, só estou brincando um pouco. Eu estive aqui embaixo por muito tempo. Eu amo você, tudo em você.\""

# game/a2s3.rpy:950
translate pt_br a2s3_ba52966f:

    # m "\"Clearly.\""
    m "\"Claramente.\""

# game/a2s3.rpy:951
translate pt_br a2s3_66a49acb:

    # "That's all I'm able to say before he starts to kiss me again, licking and sucking and I'm at least glad that it tastes like they're providing him with that mouthwash stuff down here."
    "Isso é tudo o que eu sou capaz de dizer antes dele começar a me beijar de novo, lambendo e chupando e eu pelo menos fico grato que o gosto deixa implícito que eles estão fornecendo aquele negócio que parece um enxaguante bucal aqui."

# game/a2s3.rpy:952
translate pt_br a2s3_0085f6c6:

    # "I've never seen Amicus so horny before, which is saying something, his paws gripping and stroking at me almost desperately as his muzzle kisses every inch of my neck and face."
    "Eu nunca vi o Amicus tão excitado antes, e isso levando em conta como ele costuma ser, suas patas me apertam e me acariciam quase desesperadamente enquanto seu focinho beija cada centímetro do meu pescoço e rosto."

# game/a2s3.rpy:953
translate pt_br a2s3_615d91bd:

    # "He pushes his body down against mine, his considerable chest and belly crushing me flat against the ground."
    "Ele empurra seu corpo contra o meu, seu peito e barriga consideráveis me esmagando contra o chão."

# game/a2s3.rpy:954
translate pt_br a2s3_52dd0c3d:

    # "But when his muzzle starts dipping down lower, snuffling against my chest and under my robes, I decide that I've had enough."
    "Mas, quando o focinho dele começa a descer, fungando contra meu peito e sob minhas vestes, eu decido que já tive o suficiente."

# game/a2s3.rpy:955
translate pt_br a2s3_2dac718b:

    # "I reach around to grab his upraised rear, getting a handful of thick, furry ass as my fingers squeeze dangerously close to the spot under his tail."
    "Eu estendo a mão para agarrar seu traseiro empinado, sentindo uma bunda grande e peluda conforme meus dedos se aproximam perigosamente do local embaixo da sua cauda."

# game/a2s3.rpy:957
translate pt_br a2s3_a9ba8a6b:

    # "Predictably, Amicus gasps in surprise and pulls back, quickly sitting up so that his rear is safely pressed against the blanket and I have room to finally sit up myself."
    "Previsivelmente, Amicus bufa de surpresa e se afasta, se sentando rapidamente para que seu traseiro seja pressionado com segurança contra o cobertor e eu finalmente tenha espaço para me sentar."

# game/a2s3.rpy:959
translate pt_br a2s3_e23ab2c5:

    # a "\"What was that for?\""
    a "\"Por que fez isso?\""

# game/a2s3.rpy:960
translate pt_br a2s3_e08b4e80:

    # m "\"For not letting me catch my breath. And I know you don't like things near your butt.\""
    m "\"Por não me deixar recuperar o fôlego. E eu sei que você não gosta de coisas perto da sua bunda.\""

# game/a2s3.rpy:962
translate pt_br a2s3_1030ec27:

    # a "\"Well, emperors shouldn't have things near their butt.\""
    a "\"Bem, imperadores não deveriam ter coisas perto de suas bundas.\""

# game/a2s3.rpy:963
translate pt_br a2s3_7dda34ba:

    # "I roll my eyes at his silly, but understandable insecurity, and crawl up to Amicus to sit in his lap, the wolf eagerly pulling me in."
    "Eu reviro os olhos com essa boba, porém compreensível, insegurança e rastejo até o Amicus para sentar em seu colo, o lobo ansiosamente me puxando."

# game/a2s3.rpy:965
translate pt_br a2s3_891ef0b0:

    # a "\"I love you.\""
    a "\"Eu te amo.\""

# game/a2s3.rpy:966
translate pt_br a2s3_8c5fe2d6:

    # m "\"I love you too.\""
    m "\"Eu também te amo.\""

# game/a2s3.rpy:967
translate pt_br a2s3_1d444008:

    # "Amicus rubs his paws up and down my arms and shoulders, still just feeling me out."
    "Amicus esfrega as patas para cima e para baixo em meus braços e ombros, me sentindo."

# game/a2s3.rpy:968
translate pt_br a2s3_79669a53:

    # a "\"I can't wait to get out of here. No more hiding when I'm emperor. I'm going to show you the real Adastra. Being stuck behind these walls is not how the emperor's beautiful lover should be treated.\""
    a "\"Eu mal posso esperar para sair daqui. Sem mais me esconder quando eu for imperador. Eu vou te mostrar a verdadeira Adastra. Ficar por trás dessas paredes não é como o belo amante do imperador deveria ser tratado.\""

# game/a2s3.rpy:969
translate pt_br a2s3_6841bdd1:

    # "I touch back, pressing my hands over his paws and resting my head against his chest, listening to the rumble of his voice."
    "Eu toco de volta, pressionando minhas mãos sobre suas patas e repousando minha cabeça contra seu peito, sentindo a vibração de sua voz."

# game/a2s3.rpy:970
translate pt_br a2s3_b909f7f4:

    # m "\"Oh? And what's the real Adastra?\""
    m "\"Hm? E qual é a verdadeira Adastra?\""

# game/a2s3.rpy:971
translate pt_br a2s3_48c01a4b:

    # "Amicus pulls his paw away for just a moment to wave it dismissively before returning it to press against my chest."
    "Amicus afasta sua pata apenas por um momento para acenar com desdém antes de retornar e pressionar contra meu peito."

# game/a2s3.rpy:972
translate pt_br a2s3_db258f43:

    # a "\"These politics...it doesn't represent the moon's true face. I need to take you to other cities and landscapes. The people are vastly different too, from region to region.\""
    a "\"Essa política... ela não representa a verdadeira face da lua. Eu preciso levar você para outras cidades e paisagens. As pessoas são muito diferentes também, de região para região.\""

# game/a2s3.rpy:973
translate pt_br a2s3_31e1b1cd:

    # m "\"Mmmh.\""
    m "\"Mmmh.\""

# game/a2s3.rpy:974
translate pt_br a2s3_f3979d53:

    # "I listen to him contentedly for a few minutes, happy to just hear him speak again, reminded of how easy it is for us to just talk to each other."
    "Eu o ouço alegremente por alguns minutos, contente só por estar ouvindo ele falar de novo, lembrando de como é fácil pra nós conversarmos um com o outro."

# game/a2s3.rpy:975
translate pt_br a2s3_3833f919:

    # "And we actually have time to talk."
    "E nós temos tempo para conversar, na verdade."

# game/a2s3.rpy:976
translate pt_br a2s3_d20dfa1a:

    # "Cato is in a different city on official business, so Cassius had granted us at least a little more time than the last visit."
    "Cato foi até uma cidade diferente para cuidar de assuntos oficiais, então Cassius nos deu um pouco mais de tempo do que na última visita."

# game/a2s3.rpy:977
translate pt_br a2s3_2d73b835:

    # "Amicus rocks back and forth as I pet the fur on his chest, listening to his heartbeat."
    "Amicus balança para frente e para trás enquanto eu afago o pelo em seu peito, ouvindo seus batimentos cardíacos."

# game/a2s3.rpy:978
translate pt_br a2s3_e3db0036:

    # "It's clear that they allow him to bathe down here, but the lack of any perfume leaves only the slight smell of his natural musk."
    "Já ficou claro que eles permitem que ele tome banho aqui embaixo, mas a falta de perfume deixa apenas o seu leve cheiro almíscar natural."

# game/a2s3.rpy:979
translate pt_br a2s3_42c94263:

    # "While I miss the lavender smell I'm used to, I don't mind the masculine scent he's giving off, especially after our little reunion just now."
    "Por mais que eu sinta falta do cheiro de lavanda com o qual me acostumei, não me importo com o aroma masculino que ele exala, especialmente depois da nossa pequena reunião agora há pouco."

# game/a2s3.rpy:980
translate pt_br a2s3_9f31d986:

    # "I want to sit here forever, feeling completely calm and safe for the first time this week."
    "Eu quero ficar sentado aqui para sempre, me sentindo completamente calmo e seguro pela primeira vez essa semana."

# game/a2s3.rpy:981
translate pt_br a2s3_13af0719:

    # "I know it has to end though, and there's so much to tell the wolf, so I pull back, looking up at Amicus's face."
    "Mas eu sei que precisa acabar e tem muito mais para dizer ao lobo, então eu me afasto, olhando para o rosto do Amicus."

# game/a2s3.rpy:982
translate pt_br a2s3_2e87079d:

    # m "\"Amicus?\""
    m "\"Amicus?\""

# game/a2s3.rpy:984
translate pt_br a2s3_8ca1d22f:

    # a "\"Yes?\""
    a "\"Sim?\""

# game/a2s3.rpy:985
translate pt_br a2s3_f5372419:

    # m "\"I need to talk to you about something.\""
    m "\"Eu preciso falar com você sobre uma coisa.\""

# game/a2s3.rpy:986
translate pt_br a2s3_a3442c9b:

    # a "\"Go on.\""
    a "\"Fale.\""

# game/a2s3.rpy:987
translate pt_br a2s3_dd3a67eb:

    # "Amicus leans down, pressing his nose against my hair and inhaling deeply."
    "Amicus se inclina, pressionando seu nariz contra meu cabelo e inalando profundamente."

# game/a2s3.rpy:988
translate pt_br a2s3_6d980443:

    # m "\"It's...about the parents, I think. I need to talk to you about something they showed me.\""
    m "\"É sobre... os progenitores, eu acho. Eu preciso falar com você sobre algo que eles me mostraram.\""
