# game/a1s1.rpy:7
translate pt_br a1s1_77486a68:

    # unk "\"It's so...large.\""
    unk "\"É tão... enorme.\""

# game/a1s1.rpy:8
translate pt_br a1s1_74c91a88:

    # unk "\"It's too much. How do they get anything done?\""
    unk "\"É demais. Como eles conseguem fazer qualquer coisa?\""

# game/a1s1.rpy:9
translate pt_br a1s1_96bd9843:

    # com "\"Sensing doubt. Shall we proceed with the directive, Amicus?\""
    com "\"Detectando dúvida. Devemos proceder com a diretiva, Amicus?\""

# game/a1s1.rpy:10
translate pt_br a1s1_47478835:

    # a "\"I don't know...Are you sure they're level five?\""
    a "\"Eu não sei... Tem certeza que eles são nível 5?\""

# game/a1s1.rpy:11
translate pt_br a1s1_b8ca3f57:

    # com "\"Data from mission 32-65-193 indicates primate species with level five intelligence and—\""
    com "\"Dados da missão 32-65-193 indicam espécie primata com inteligência nível cinco e—\""

# game/a1s1.rpy:12
translate pt_br a1s1_d83ceef6:

    # a "\"Understood. Thank you.\""
    a "\"Entendido. Obrigado.\""

# game/a1s1.rpy:13
translate pt_br a1s1_4392f7c4:

    # com "\"Most recent data indicates that all uplift attempts failed.\""
    com "\"Dados mais recentes indicam que todas as tentativas de elevação falharam.\""

# game/a1s1.rpy:14
translate pt_br a1s1_a986817b:

    # a "\"Ha, that figures. Why did we try to uplift here in the first place?\""
    a "\"Hah, isso explica. Por que tentamos elevar aqui em primeiro lugar?\""

# game/a1s1.rpy:15
translate pt_br a1s1_932c06f3:

    # com "\"Sensing doubt. Shall we procee—\""
    com "\"Detectando dúvida. Devemos proce—\""

# game/a1s1.rpy:16
translate pt_br a1s1_18bdccdf:

    # a "\"Name of the planet?\""
    a "\"Nome do planeta?\""

# game/a1s1.rpy:17
translate pt_br a1s1_ed058531:

    # com "\"Earth.\""
    com "\"Terra.\""

# game/a1s1.rpy:18
translate pt_br a1s1_5af60aea:

    # a "\"Location of Romanus uplift?\""
    a "\"Localização da elevação de Romanus?\""

# game/a1s1.rpy:19
translate pt_br a1s1_182bff7d:

    # com "\"The city of Rome, in the state of Italy.\""
    com "\"Cidade de Roma. No estado da Itália.\""

# game/a1s1.rpy:20
translate pt_br a1s1_859172a1:

    # a "\"Is the probe there?\""
    a "\"A sonda está lá?\""

# game/a1s1.rpy:21
translate pt_br a1s1_283efa32:

    # com "\"It has arrived.\""
    com "\"Ela chegou.\""

# game/a1s1.rpy:22
translate pt_br a1s1_8a70dce5:

    # a "\"Give me a visual...Zoom in.\""
    a "\"Me dê uma visão do lugar...\""

# game/a1s1.rpy:23
translate pt_br a1s1_a20cefa7:

    # "..."
    "..."

# game/a1s1.rpy:24
translate pt_br a1s1_e1fda613:

    # a "\"That...doesn't look like Adastra at all.\""
    a "\"Isso... não parece com Adastra nem um pouco.\""

# game/a1s1.rpy:25
translate pt_br a1s1_03043a4b:

    # com "\"Reminder that uplift failed. Ruins of uplift attempt remain.\""
    com "\"Lembrete de falha na elevação. As ruínas da tentativa ainda estão lá.\""

# game/a1s1.rpy:26
translate pt_br a1s1_3e9384a3:

    # a "\"Show me the ruins.\""
    a "\"Me mostre as ruínas.\""

# game/a1s1.rpy:27
translate pt_br a1s1_a20cefa7_1:

    # "..."
    "..."

# game/a1s1.rpy:28
translate pt_br a1s1_1124cc1e:

    # com "\"Showing the Roman Forum.\""
    com "\"Mostrando o fórum romano.\""

# game/a1s1.rpy:29
translate pt_br a1s1_abaf999a:

    # a "\"...\""
    a "\"...\""

# game/a1s1.rpy:30
translate pt_br a1s1_3f3d25dd:

    # com "\"Sensing doubt—\""
    com "\"Detectando dúvida—\""

# game/a1s1.rpy:31
translate pt_br a1s1_bf7a2451:

    # a "\"Shut up, please.\""
    a "\"Silêncio, por favor.\""

# game/a1s1.rpy:32
translate pt_br a1s1_2160ca6a:

    # com "\"...\""
    com "\"...\""

# game/a1s1.rpy:33
translate pt_br a1s1_11cb2ffa:

    # a "\"What the hell are they even saying? That's not the Language. It's all messed up.\""
    a "\"O que diabos eles estão falando, sequer? Não é nosso idioma. Está todo... bagunçado.\""

# game/a1s1.rpy:34
translate pt_br a1s1_a20cefa7_2:

    # "..."
    "..."

# game/a1s1.rpy:35
translate pt_br a1s1_11847be3:

    # com "\"Sensing—\""
    com "\"Detectando—\""

# game/a1s1.rpy:36
translate pt_br a1s1_f76ffc40:

    # a "\"That creature there.\""
    a "\"Aquela criatura ali.\""

# game/a1s1.rpy:37
translate pt_br a1s1_636be05a:

    # com "\"They are called humans.\""
    com "\"Eles se chamam humanos.\""

# game/a1s1.rpy:38
translate pt_br a1s1_8f687ee2:

    # a "\"Get closer.\""
    a "\"Chegue mais perto.\""

# game/a1s1.rpy:39
translate pt_br a1s1_a20cefa7_3:

    # "..."
    "..."

# game/a1s1.rpy:40
translate pt_br a1s1_ba943069:

    # a "\"It's a human?\""
    a "\"É um humano?\""

# game/a1s1.rpy:41
translate pt_br a1s1_14fbafac:

    # com "\"Collecting data...he appears to be a young male human.\""
    com "\"Coletando dados... Ele parece ser um jovem humano do gênero masculino.\""

# game/a1s1.rpy:42
translate pt_br a1s1_a20cefa7_4:

    # "..."
    "..."

# game/a1s1.rpy:43
translate pt_br a1s1_97898fd5:

    # a "\"Initiate landing sequence.\""
    a "\"Inicie a sequência de aterrissagem.\""

# game/a1s1.rpy:44
translate pt_br a1s1_1f33b800:

    # com "\"Have you located the directive?\""
    com "\"Você localizou a diretiva?\""

# game/a1s1.rpy:45
translate pt_br a1s1_bcc81977:

    # a "\"Yes.\""
    a "\"Sim.\""

# game/a1s1.rpy:46
translate pt_br a1s1_47cb0a76:

    # com "\"Warning that full Nexus analysis is incomple—\""
    com "\"Aviso que a análise total do Nexus está incomple—\""

# game/a1s1.rpy:47
translate pt_br a1s1_cb929e37:

    # a "\"Now, please. We cannot waste time outside of the Stretch Drive.\""
    a "\"Agora, por favor. Não podemos desperdiçar tempo fora da dobra espacial.\""

# game/a1s1.rpy:48
translate pt_br a1s1_a20cefa7_5:

    # "..."
    "..."

# game/a1s1.rpy:49
translate pt_br a1s1_b208b2a0:

    # com "\"Initiating landing sequence.\""
    com "\"Iniciando sequência de aterrissagem.\""

# game/a1s1.rpy:55
translate pt_br a1s1_eb0977cc:

    # "It's hard to believe that I'm actually here."
    "É difícil de acreditar que eu realmente estou aqui."

# game/a1s1.rpy:56
translate pt_br a1s1_6d8e1a2e:

    # "After years of fantasizing about it, I'm in Rome..."
    "Depois de anos fantasiando sobre isso, finalmente em Roma."

# game/a1s1.rpy:57
translate pt_br a1s1_8c69ffb6:

    # "I've been bouncing around with my friends like an idiot all day."
    "Fiquei perambulando por aí com os meus amigos igual um idiota o dia todo."

# game/a1s1.rpy:58
translate pt_br a1s1_579c818a:

    # "Yeah, I look like a total tourist, but this is what I've been saving up for for the past two years.."
    "Sim, eu pareço um completo turista, mas é para isso que eu estive economizando nos últimos dois anos..."

# game/a1s1.rpy:59
translate pt_br a1s1_aa3b9076:

    # "A whole semester in Rome with the study abroad program."
    "Um semestre inteiro de intercâmbio em Roma."

# game/a1s1.rpy:60
translate pt_br a1s1_6237c183:

    # "All the conversations I've had with my parents about what a waste of money it would be evaporates from my brain as I take in the view."
    "Todas as conversas que tive com meus pais sobre o desperdício de dinheiro que essa viagem seria evaporam do meu cérebro conforme admiro a vista."

# game/a1s1.rpy:61
translate pt_br a1s1_e3fca3b1:

    # "We only have a few hours, so we move from the Forum to Palatine Hill, then finally to a nearby disco where I get just a little drunk."
    "Nós só temos algumas horas, então vamos do Fórum ao Monte Palatino, até finalmente chegarmos em uma boate ali perto, onde eu fico ligeiramente bêbado."

# game/a1s1.rpy:62
translate pt_br a1s1_fb087acd:

    # "Before I know it, it's two in the morning and somehow my friends and I are able to stumble to a taxi that takes us back to our apartments."
    "Antes de me dar conta, são duas da manhã e, de algum jeito, meus amigos conseguem achar um táxi que nos leva de volta aos apartamentos."

# game/a1s1.rpy:64
translate pt_br a1s1_51699130:

    # "I walk unsteadily through the darkness, glad that I have the place to myself for now."
    "Eu ando cambaleando pela escuridão, grato por ter o lugar só para mim por enquanto."

# game/a1s1.rpy:65
translate pt_br a1s1_f27ceb0a:

    # "Apparently my group was the first to arrive and my assigned flatmates won't be here for a few days at least."
    "Aparentemente meu grupo foi o primeiro a chegar e meus colegas vizinhos de apartamento não estarão aqui por pelo menos alguns dias."

# game/a1s1.rpy:66
translate pt_br a1s1_0ebb061a:

    # "I open the door to my room and move my hand along the wall."
    "Eu abro a porta e arrasto minha mão pela parede, procurando o interruptor."

# game/a1s1.rpy:69
translate pt_br a1s1_b12fd0d3:

    # "I stumble in then sit on my bed, bouncing happily for a moment."
    "Cambaleio um pouco até sentar na cama, balançando alegremente por um momento."

# game/a1s1.rpy:70
translate pt_br a1s1_b8fd2e60:

    # "I think about going out onto the balcony, but I've been walking all day and it feels too nice to be sitting down."
    "Penso em ir na sacada, mas estive andando o dia todo e um descanso é tudo o que eu preciso agora."

# game/a1s1.rpy:71
translate pt_br a1s1_2e1bfeb1:

    # "Plus it might not be a great idea considering the state I'm in right now."
    "Além de que talvez não seja uma boa ideia considerando o meu estado."

# game/a1s1.rpy:72
translate pt_br a1s1_84af68c2:

    # "Still, just knowing the magic of the city is just outside my window is going to make it hard to sleep."
    "Ainda assim, saber que a magia da cidade está bem atrás da minha janela vai dificultar que eu adormeça."

# game/a1s1.rpy:73
translate pt_br a1s1_e8a976a1:

    # "I sigh happily and look around my little room."
    "Eu suspiro alegremente e dou uma olhada no meu quartinho."

# game/a1s1.rpy:74
translate pt_br a1s1_47dfdd03:

    # "Actually I'm told that it's kinda big by this city's standards."
    "Me disseram que é meio grande para os padrões dessa cidade, na verdade."

# game/a1s1.rpy:75
translate pt_br a1s1_4f58cf74:

    # "It's still a little bare since I just moved in today."
    "Ainda está um pouco vazio desde que me mudei para cá hoje."

# game/a1s1.rpy:76
translate pt_br a1s1_3e2aaead:

    # "I'd basically just dropped my suitcases next to the door before running out again."
    "Basicamente eu só joguei minhas malas perto da porta antes de voltar para fora."

# game/a1s1.rpy:77
translate pt_br a1s1_6215143f:

    # "I glance at them, but decide I'm way too tired right now to unpack even if my pajamas are in there."
    "Dou uma olhada de relance nelas, mas decido que estou muito cansado agora para desempacotar, mesmo com meu pijama estando lá dentro."

# game/a1s1.rpy:78
translate pt_br a1s1_0eec5d81:

    # "It's fine if I'm just laying on top of the covers."
    "Tudo bem se eu só deitar em cima das cobertas."

# game/a1s1.rpy:79
translate pt_br a1s1_90c175e6:

    # "I'll get to it tomorrow."
    "Eu resolvo isso amanhã."

# game/a1s1.rpy:80
translate pt_br a1s1_80c63e49:

    # "In the meantime I just lay back, smiling in the afterglow of today's excitement."
    "No meio tempo, me inclino e deito na cama, sorrindo depois da animação de hoje."

# game/a1s1.rpy:81
translate pt_br a1s1_dc73bb42:

    # "And tomorrow I'll get to see even more!"
    "E amanhã eu vou poder ver ainda mais!"

# game/a1s1.rpy:82
translate pt_br a1s1_8bfc9a3d:

    # "Damn it, I need to calm down."
    "Caramba, preciso me acalmar."

# game/a1s1.rpy:83
translate pt_br a1s1_1a007b80:

    # "No way am I gonna have the energy I'll need tomorrow if I'm up all night."
    "Nem ferrando que vou ter a energia que preciso para amanhã se ficar acordado a noite toda."

# game/a1s1.rpy:84
translate pt_br a1s1_9d4782e4:

    # "I've got the whole semester and on top of that school doesn't actually start for another two weeks!"
    "Eu tenho o semestre inteiro e, ainda por cima, as aulas só vão começar em duas semanas!"

# game/a1s1.rpy:85
translate pt_br a1s1_e391e053:

    # "There's plenty of time."
    "Tem bastante tempo."

# game/a1s1.rpy:86
translate pt_br a1s1_27b7ecc1:

    # "Just relax for now and enjoy it."
    "Só relaxa por enquanto e aproveita."

# game/a1s1.rpy:87
translate pt_br a1s1_665fd18a:

    # "With that thought in my head, I start to drift off..."
    "Com isso em mente, começo a adormecer..."

# game/a1s1.rpy:90
translate pt_br a1s1_d0394d24:

    # "Something moves..."
    "Alguma coisa se mexe..."

# game/a1s1.rpy:91
translate pt_br a1s1_ccfa018c:

    # "I lay there in the dark, wondering if I'd dreamed it."
    "Eu permaneço deitado no escuro, me perguntando se sonhei com esse som."

# game/a1s1.rpy:92
translate pt_br a1s1_0ab0e04b:

    # "I had been dreaming, even though I can't remember exactly what it was about."
    "Eu estava sonhando, mesmo que não consiga lembrar exatamente sobre o que era."

# game/a1s1.rpy:93
translate pt_br a1s1_32ef38ec:

    # "Something about a portal, maybe?"
    "Algo sobre um portal, talvez?"

# game/a1s1.rpy:94
translate pt_br a1s1_8fb59446:

    # "I listen for a while, but there's no other sound...just the occasional soft {i}whoosh{/i} of a car passing by outside my balcony."
    "Fico escutando por um momento, mas não tem nenhum outro som... só o leve ocasional {i}whoosh{/i} dos carros passando depois da sacada."

# game/a1s1.rpy:95
translate pt_br a1s1_05af45b3:

    # "I shift around a little; the suffocating humidity is making the sheets stick to my skin and I wonder if maybe there's a fan in the closet."
    "Me desloco um pouco; a umidade sufocante está fazendo os lençóis colarem na minha pele e eu me pergunto se talvez existe um ventilador no armário."

# game/a1s1.rpy:96
translate pt_br a1s1_08870c26:

    # "I finally sit up in bed, realizing that there's no way I'm going to fall back to sleep like this."
    "Finalmente, sento na cama, me dando conta de que com certeza não vou conseguir voltar a dormir assim."

# game/a1s1.rpy:97
translate pt_br a1s1_a4812f89:

    # "I could at least try sliding open the balcony door, though I'm not sure that will do me any good."
    "Eu poderia pelo menos tentar abrir a porta da varanda, embora não tenha certeza se isso vai ajudar."

# game/a1s1.rpy:98
translate pt_br a1s1_362ef336:

    # "Worth a try, I guess."
    "Vale a tentativa, eu acho."

# game/a1s1.rpy:99
translate pt_br a1s1_252d7c3a:

    # "I groggily slide out of bed and try to slide the glass door open, but it doesn't budge."
    "Um pouco grogue, deslizo para fora da cama e tento abrir a porta de vidro, mas ela não se mexe."

# game/a1s1.rpy:100
translate pt_br a1s1_04a30081:

    # "I struggle for a few more seconds before sighing and moving toward the door to find the light switch."
    "Faço esforço por mais alguns segundos antes de suspirar e me mover em direção à parede, tentando encontrar o interruptor."

# game/a1s1.rpy:101
translate pt_br a1s1_e69927e9:

    # "My feet slide along the semi-cool wooden floor, which feels great, while my hands stretch out in front of me, searching for the wall."
    "Meu pé desliza ao longo do piso de madeira frio, dando uma ótima sensação enquanto meus braços se esticam na minha frente, procurando pela parede."

# game/a1s1.rpy:102
translate pt_br a1s1_b318b6c4:

    # "Right then I remember that I was woken up by noises, and I imagine some intruder standing there in the dark, waiting for me to bump into him."
    "É quando me lembro que fui acordado por barulhos e imagino algum intruso em pé no meio do escuro, esperando eu colidir com ele."

# game/a1s1.rpy:103
translate pt_br a1s1_c34a963b:

    # "Feeling the hairs stand up on the back of my neck, I quicken my pace and find the wall, fumbling around until—"
    "Sentindo os pelos arrepiarem na nuca, apresso o passo e encontro a parede, passando a mão cegamente por ela, até que—"

# game/a1s1.rpy:106
translate pt_br a1s1_c0f5fb34:

    # "I quickly glance around the room, relieved that it's empty."
    "Rapidamente dou uma olhada no quarto, aliviado por estar vazio."

# game/a1s1.rpy:107
translate pt_br a1s1_8e109e4e:

    # "My parents had warned me about the crime rate here."
    "Meus pais me avisaram sobre a taxa de criminalidade daqui."

# game/a1s1.rpy:108
translate pt_br a1s1_78091602:

    # "While the city is technically safe in terms of murder, robberies and muggings are apparently pretty common."
    "Mesmo que a cidade seja tecnicamente segura em termos de assassinato, roubos e assaltos são aparentemente bem comuns."

# game/a1s1.rpy:109
translate pt_br a1s1_d7a03ac3:

    # "I had shrugged it off at the time, but now that I'm alone—."
    "Eu não me importei na hora, mas agora que estou aqui sozinho—."

# game/a1s1.rpy:110
translate pt_br a1s1_898503d3:

    # "I make my way to the balcony, looking for the lock before finally seeing that there's a latch near the top of the door."
    "Sigo o caminho até a sacada, procurando pela tranca antes de finalmente notar uma trava próxima ao topo da porta."

# game/a1s1.rpy:111
translate pt_br a1s1_5da9fad8:

    # "I unhook it and slowly slide the door open."
    "Eu destranco e lentamente deslizo a porta até ficar aberta."

# game/a1s1.rpy:112
translate pt_br a1s1_2e2d6b3d:

    # "I'm disappointed to find that the air wafting from outside is almost as stuffy as the air inside."
    "Fico desapontado ao perceber que o ar de fora é quase tão abafado quanto o ar de dentro."

# game/a1s1.rpy:113
translate pt_br a1s1_c35db7eb:

    # "Still, I take the moment to stare out at the lights of the city for a while."
    "Ainda assim, aproveito o momento para admirar um pouco as luzes da cidade."

# game/a1s1.rpy:114
translate pt_br a1s1_da1a8ad6:

    # "Even though I'm more interested in the ruins, the city itself is undeniably beautiful."
    "Mesmo que as ruínas sejam mais do meu interesse, a cidade em si é inegavelmente bonita."

# game/a1s1.rpy:115
translate pt_br a1s1_b7f5d943:

    # "Nothing like my hometown."
    "Não parece nada com a minha cidade natal."

# game/a1s1.rpy:116
translate pt_br a1s1_6904e3bb:

    # "That's when I notice that there's a strange smell in the air, like burning rubber."
    "É quando percebo que tem um cheiro estranho no ar, algo como borracha queimada."

# game/a1s1.rpy:117
translate pt_br a1s1_daf99835:

    # "I stick my head out a bit further, looking around for the source, but I see nothing."
    "Inclino minha cabeça um pouco para a frente, procurando ao redor pela fonte, mas não vejo nada."

# game/a1s1.rpy:118
translate pt_br a1s1_6c43b34c:

    # "Maybe that's normal here?"
    "Talvez isso seja normal por aqui?"

# game/a1s1.rpy:119
translate pt_br a1s1_4992f925:

    # "I look back at the clock on the wall."
    "Olho para trás no relógio da parede."

# game/a1s1.rpy:120
translate pt_br a1s1_e806431f:

    # "4 A.M."
    "4 A.M."

# game/a1s1.rpy:121
translate pt_br a1s1_6be2e3e0:

    # "I sigh and shuffle back to the bed, only realizing that I've left the light on once I've already fallen back-first onto the covers."
    "Eu suspiro e arrasto os pés pelo chão até a cama, só me dando conta de ter deixado as luzes ligadas ao cair de costas em cima dela."

# game/a1s1.rpy:122
translate pt_br a1s1_02c81aa4:

    # "I sigh and will myself to get up, but the tiredness has returned and the heavy humidity is almost like a warm blanket pressing down on me."
    "Um muxoxo escapa de mim e tento me convencer a levantar, mas o cansaço voltou e a umidade já é quase como um cobertor quente pressionando meu corpo."

# game/a1s1.rpy:123
translate pt_br a1s1_5ac8571f:

    # "I close my eyes..."
    "Eu fecho meus olhos..."

# game/a1s1.rpy:124
translate pt_br a1s1_57d42554:

    # "I'll get up and turn it off in a second, just need to rest my eyes for a bit."
    "Vou levantar e desligar em um segundo, só preciso descansá-los um pouco."

# game/a1s1.rpy:125
translate pt_br a1s1_cd8e5236:

    # "Just for a bit..."
    "Só um pouquinho..."

# game/a1s1.rpy:127
translate pt_br a1s1_8611e73d:

    # "Something moves again."
    "Alguma coisa se mexe de novo..."

# game/a1s1.rpy:128
translate pt_br a1s1_381269ae:

    # "And there's another smell in the air."
    "E agora tem outro cheiro no ar."

# game/a1s1.rpy:129
translate pt_br a1s1_5e98d232:

    # "A good smell this time."
    "Um aroma agradável dessa vez."

# game/a1s1.rpy:130
translate pt_br a1s1_029b4424:

    # "Something floral."
    "Algo floral."

# game/a1s1.rpy:131
translate pt_br a1s1_6a7dbfa7:

    # "It reminds me of lavender."
    "Me lembra lavanda."

# game/a1s1.rpy:132
translate pt_br a1s1_0c804584:

    # "And that's when something hard and sharp presses into my left eye socket, just above the eye."
    "E é nesse instante que algo duro e afiado pressiona no meu olho esquerdo, bem em cima da pálpebra."

# game/a1s1.rpy:133
translate pt_br a1s1_7600de99:

    # "It doesn't really hurt, but it shocks me awake."
    "Não dói, exatamente, mas me acorda na hora."

# game/a1s1.rpy:138
translate pt_br a1s1_a20cefa7_6:

    # "..."
    "..."

# game/a1s1.rpy:139
translate pt_br a1s1_3fe64fc1:

    # "It leans over me, something shiny in its grip which it's pulling back from my head."
    "Ele se inclina sobre mim, algo brilhante em suas garras puxando de volta da minha cabeça."

# game/a1s1.rpy:143
translate pt_br a1s1_dc3047f8:

    # unk "\"Av—\""
    unk "\"Av—\""

# game/a1s1.rpy:144
translate pt_br a1s1_15c53b8c:

    # m "\"AH!\""
    m "\"AH!\""

# game/a1s1.rpy:149
translate pt_br a1s1_b9d9d082:

    # "I kick out with both feet, hitting the thing leaning over me in its body."
    "Eu chuto com os dois pés, atingindo o sujeito antes inclinado sobre mim, em seu corpo."

# game/a1s1.rpy:150
translate pt_br a1s1_20f11e71:

    # unk "\"{i}Edapol{/i}!\""
    unk "\"{i}Edapol{/i}!\""

# game/a1s1.rpy:151
translate pt_br a1s1_d7dc44a6:

    # "It lets out a surprised grunt, stumbling back and falling on its rear while I scramble back on my bed, pressing myself against the wall."
    "A besta solta um grunhido surpreso, tropeçando e caindo de bunda enquanto eu me arrasto para trás em cima da cama, me pressionando contra a parede."

# game/a1s1.rpy:153
translate pt_br a1s1_8c3ac6c9:

    # "Almost immediately it scrambles back up, revealing its massive build and its masculine shape."
    "Quase que instantaneamente, ele fica de volta em pé, revelando seu aspecto massivo e fisionomia masculina."

# game/a1s1.rpy:154
translate pt_br a1s1_76328ece:

    # "It...he adjusts his cape and smooths down his fur before rubbing at his chest, giving me an odd look."
    "A besta... ele, ajusta sua capa e alisa o pelo antes de massagear o peito, me lançando um olhar estranho."

# game/a1s1.rpy:156
translate pt_br a1s1_19d89cff:

    # "Then he fixes a smile back on his face."
    "E então ele fixa um sorriso de volta no rosto."

# game/a1s1.rpy:158
translate pt_br a1s1_46e56750:

    # unk "\"{i}Ave{/i}!\""
    unk "\"{i}Ave{/i}!\""

# game/a1s1.rpy:159
translate pt_br a1s1_a20cefa7_7:

    # "..."
    "..."

# game/a1s1.rpy:160
translate pt_br a1s1_61f958ee:

    # "I stare."
    "Eu fico encarando."

# game/a1s1.rpy:161
translate pt_br a1s1_8ecf0e79:

    # "That's all I can do is stare."
    "É tudo o que eu consigo fazer agora: encarar."

# game/a1s1.rpy:163
translate pt_br a1s1_4ac0e2c9:

    # "He stares back at me for a moment, then clears his throat."
    "Ele encara de volta por um instante e então limpa a garganta com um pigarreio."

# game/a1s1.rpy:165
translate pt_br a1s1_ef18f8da:

    # unk "\"{i}Ave/{/i}Hello!\""
    unk "\"{i}Ave/{/i}Olá!\""

# game/a1s1.rpy:166
translate pt_br a1s1_1f3dc6b4:

    # "The space above my left eye throbs and it sounds like I'm hearing two things at once from the same voice."
    "Sinto um espasmo em cima do meu olho esquerdo e é como se eu estivesse escutando duas coisas ao mesmo tempo, vindo da mesma voz."

# game/a1s1.rpy:168
translate pt_br a1s1_3abe4791:

    # unk "\"Erm...{i}Potes intellegere{/i}?/Do you understand?\""
    unk "\"Erm...{i}Potes intellegere{/i}?/Você me entende?\""

# game/a1s1.rpy:169
translate pt_br a1s1_bad04be6:

    # "Again the bizarre twitching in my eye, in my brain, and hearing two things at once."
    "De novo, a palpitação bizarra no meu olho, no meu cérebro, e escutando duas coisas ao mesmo tempo."

# game/a1s1.rpy:170
translate pt_br a1s1_5110002c:

    # "I feel like I'm going to be sick."
    "Acho que vou passar mal."

# game/a1s1.rpy:171
translate pt_br a1s1_75456ed8:

    # "The room shifts and swirls a bit, then slowly starts to settle again."
    "A sala se mexe e gira um pouco, depois lentamente começa a voltar ao normal."

# game/a1s1.rpy:172
translate pt_br a1s1_fc81a5c8:

    # "The twitching in my head turns into a dull throb."
    "O tremor na minha cabeça torna-se uma pulsação maçante."

# game/a1s1.rpy:173
translate pt_br a1s1_a30a72be:

    # "I'm having a nightmare."
    "Eu estou tendo um pesadelo."

# game/a1s1.rpy:174
translate pt_br a1s1_58a88ee1:

    # unk "\"Do you understand me?\""
    unk "\"Você consegue me entender?\""

# game/a1s1.rpy:175
translate pt_br a1s1_52f2f765:

    # "I stare at him and he stares back."
    "Eu olho para ele e ele olha para mim."

# game/a1s1.rpy:176
translate pt_br a1s1_1a5a09c6:

    # unk "\"Com, I don't know if the chip is working...\""
    unk "\"Com, eu não sei se o chip está funcionando...\""

# game/a1s1.rpy:177
translate pt_br a1s1_b675898e:

    # m "\"Wh—what?\""
    m "\"O-O que?\""

# game/a1s1.rpy:178
translate pt_br a1s1_9866d76f:

    # "The creature raises its hand to its head, rubbing at it."
    "A criatura levanta a mão até a cabeça, esfregando-a."

# game/a1s1.rpy:179
translate pt_br a1s1_e334ae29:

    # unk "\"Well, he can speak, and it's translating. Can you understand me?\""
    unk "\"Bem, ele pode falar, e está traduzindo. Você consegue me entender?\""

# game/a1s1.rpy:180
translate pt_br a1s1_250b5d45:

    # "When am I going to wake up?"
    "Quando é que eu vou acordar?"

# game/a1s1.rpy:181
translate pt_br a1s1_bfea2ba9:

    # "He keeps staring at me and automatically I respond to him."
    "Ele continua me encarando e eu automaticamente respondo:"

# game/a1s1.rpy:182
translate pt_br a1s1_6cd16775:

    # m "\"Y—yes?\""
    m "\"S-Sim?\""

# game/a1s1.rpy:184
translate pt_br a1s1_9b656bf8:

    # unk "\"Ah! Good, seems it's finally working now. They take a moment to adjust to the host brain.\""
    unk "\"Ah! Ótimo, parece que finalmente está funcionando. Eles levam um tempo para ajustar ao cérebro do hospedeiro.\""

# game/a1s1.rpy:185
translate pt_br a1s1_f2c92989:

    # "I struggle to keep up with his words."
    "Tenho dificuldade em acompanhar as palavras dele."

# game/a1s1.rpy:186
translate pt_br a1s1_eab50ecf:

    # "I'm still hearing what he's saying."
    "Ainda ouço o que ele diz de fundo."

# game/a1s1.rpy:187
translate pt_br a1s1_adf532a3:

    # "It's almost Italian with the inflections and the rolling R's, but at the same time it's definitely not Italian..."
    "É quase italiano com as inflexões e os R's no céu da boca, mas, ao mesmo tempo, definitivamente não é italiano..."

# game/a1s1.rpy:188
translate pt_br a1s1_1190b528:

    # "Still, I can understand what he's saying, like he's speaking my own language at the same time."
    "Ainda assim, consigo entender o que ele diz, como se estivesse falando minha língua nativa ao mesmo tempo."

# game/a1s1.rpy:189
translate pt_br a1s1_21fe1f2e:

    # "It makes it hard to concentrate."
    "É difícil de se concentrar."

# game/a1s1.rpy:191
translate pt_br a1s1_3ffcf84d:

    # unk "\"What is your name?\""
    unk "\"Qual é o seu nome?\""

# game/a1s1.rpy:196
translate pt_br a1s1_cdacc0ec:

    # "His expectant look almost forces the answer out of my mouth."
    "Seu olhar de expectativa praticamente força a resposta para fora da minha boca."

# game/a1s1.rpy:197
translate pt_br a1s1_31294dd3:

    # m "\"[mc]...\""
    m "\"[mc]...\""

# game/a1s1.rpy:198
translate pt_br a1s1_aaa503b5:

    # unk "\"[mc]? Beautiful! I am Amicus.\""
    unk "\"[mc]? Bonito! Eu sou o Amicus.\""

# game/a1s1.rpy:199
translate pt_br a1s1_cd4de8f7:

    # "The confusing double language I was hearing is starting to fade, and now only my own language comes from his mouth."
    "A confusa voz dupla que eu estava ouvindo começa a desaparecer e agora apenas o meu próprio idioma sai da boca dele."

# game/a1s1.rpy:200
translate pt_br a1s1_5ef2ce8b:

    # "It's odd, the words not quite matching up with his lips."
    "É estranho, as palavras não exatamente combinando com o movimento dos lábios."

# game/a1s1.rpy:201
translate pt_br a1s1_b08d468a:

    # "What's even more distracting are the massive canines that continue to flash behind those lips."
    "E o que chama ainda mais atenção são os caninos enormes que continuam brilhando por trás desses lábios."

# game/a1s1.rpy:202
translate pt_br a1s1_9c9f6724:

    # "I need to get the hell out of here."
    "Eu tenho que dar o fora daqui."

# game/a1s1.rpy:203
translate pt_br a1s1_158b9c11:

    # "Dream or not, I don't like the look of the teeth and claws on this thing."
    "Sonho ou não, não gosto da aparência dos dentes e das garras desse bicho."

# game/a1s1.rpy:205
translate pt_br a1s1_5e7e3d67:

    # a "\"Ah, is the Lingua having troubles again?\""
    a "\"Ah, o interpretus está com problemas outra vez?\""

# game/a1s1.rpy:206
translate pt_br a1s1_07641443:

    # "I don't respond, instead glancing at the door just to the right and behind this...Amicus."
    "Eu não respondo, em vez disso, olho para a porta bem na direita e atrás desse... Amicus."

# game/a1s1.rpy:207
translate pt_br a1s1_b4002846:

    # "He frowns."
    "Ele arqueia as sobrancelhas."

# game/a1s1.rpy:209
translate pt_br a1s1_2fb5f55d:

    # a "\"Com, you told me they're level 5. I can't even speak with it!\""
    a "\"Com, você me disse que eles são nível 5. Eu não consigo nem conversar com esse aí!\""

# game/a1s1.rpy:210
translate pt_br a1s1_7de0ee82:

    # "It takes me a moment to realize he's not talking to me."
    "Leva um tempo até eu perceber que ele não está falando comigo."

# game/a1s1.rpy:211
translate pt_br a1s1_4bbc02a0:

    # "I hear a soft chatter coming from the wolf, like someone's talking to him from a phone, but I can't see anything."
    "Eu escuto uma vozinha vindo da direção do lobo, como se alguém estivesse falando com ele por um telefone, mas não consigo ver nada."

# game/a1s1.rpy:212
translate pt_br a1s1_db48a3ea:

    # a "\"Yeah? Well he kicked me in the chest!\""
    a "\"É? Bem, ele me deu um chute no peito!\""

# game/a1s1.rpy:213
translate pt_br a1s1_75f5601c:

    # "Amicus rubs at his chest with a frown."
    "Amicus esfrega o peito com uma careta no rosto."

# game/a1s1.rpy:214
translate pt_br a1s1_636bc604:

    # "More muffled speaking."
    "Mais falatório abafado."

# game/a1s1.rpy:216
translate pt_br a1s1_59ab6cfe:

    # a "\"Of course I didn't! He just kicked me! He's looking at me like he has no idea—\""
    a "\"Mas é claro que não! Ele simplemente me chutou! Está olhando para mim como se não tivesse ideia—\""

# game/a1s1.rpy:217
translate pt_br a1s1_ef6a8ae0:

    # "More muffled speaking interrupts him."
    "Mais fala abafada o interrompe."

# game/a1s1.rpy:219
translate pt_br a1s1_a34128dd:

    # a "\"Oh...Wait, what!?\""
    a "\"Ah... Espera, o que!?\""

# game/a1s1.rpy:221
translate pt_br a1s1_e0f3c827:

    # a "\"Are you serious?\""
    a "\"É sério?\""

# game/a1s1.rpy:222
translate pt_br a1s1_cd9f95da:

    # "Now he looks pissed and I press myself harder against the wall, trying to work up the courage to make a break for the door."
    "Agora ele parece irritado com alguma coisa e eu me pressiono com mais força contra a parede, tentando criar coragem para correr até a porta."

# game/a1s1.rpy:223
translate pt_br a1s1_2d88f30a:

    # a "\"How—Wait, so you're always offering me opinions on my mood, but you couldn't offer THAT!?\""
    a "\"Como—Espera, então você está sempre dando pitaco sobre meu humor, mas não podia comentar sobre ISSO!?\""

# game/a1s1.rpy:224
translate pt_br a1s1_ae57adfd:

    # "More muffled babbling, but the wolf thing interrupts it with a snarl."
    "Mais tagarelisse abafada, porém o lobo interrompe com um rosnado."

# game/a1s1.rpy:225
translate pt_br a1s1_17fe186c:

    # a "\"Well what the hell do I do now!?\""
    a "\"O que eu faço agora, me diz!?\""

# game/a1s1.rpy:226
translate pt_br a1s1_f892c4df:

    # "His lips are drawn back and now I get to have a real good view of those canines."
    "Os lábios dele estão para trás e agora eu tenho uma boa visão dos caninos."

# game/a1s1.rpy:227
translate pt_br a1s1_3b34be8e:

    # "I stare wide-eyed at them, and that's when he seems to notice me again."
    "Eu encaro de olhos bem abertos, e é nesse momento que ele parece me notar de novo."

# game/a1s1.rpy:229
translate pt_br a1s1_e51d5ae8:

    # "He readjusts his expression into a smile, but I can still see a fang poking out."
    "Ele reajusta sua expressão em um sorriso, mas eu ainda consigo ver uma presa saindo da boca."

# game/a1s1.rpy:230
translate pt_br a1s1_5c894071:

    # a "\"Heeey, listen...\""
    a "\"Entããão, assim...\""

# game/a1s1.rpy:231
translate pt_br a1s1_17f03fa3:

    # "Something about the way he acts; his expressions, demeanor..."
    "Alguma coisa sobre como ele age; suas expressões, comportamento..."

# game/a1s1.rpy:232
translate pt_br a1s1_6a959af9:

    # "He's so...human."
    "Ele é tão... humano."

# game/a1s1.rpy:233
translate pt_br a1s1_faded846:

    # a "\"Could you...could you come with me outside for a quick moment?\""
    a "\"Você pode... pode vir comigo aqui fora um momentinho?\""

# game/a1s1.rpy:234
translate pt_br a1s1_d6527c60:

    # "For some reason the realization of his human-ness makes me absolutely positive that this is a dream."
    "Por algum motivo a percepção da humanidade dele me deixa absolutamente convicto de que isso é um sonho."

# game/a1s1.rpy:235
translate pt_br a1s1_54d3d854:

    # "This must be a character from a game, or movie that I'd seen."
    "Deve ser um personagem de um jogo, ou um filme que eu assisti."

# game/a1s1.rpy:236
translate pt_br a1s1_c953fec1:

    # "I shake my head slowly at him."
    "Lentamente nego com a cabeça."

# game/a1s1.rpy:237
translate pt_br a1s1_ea632bd1:

    # a "\"Ah..um, please?\""
    a "\"É... hm, por favor?\""

# game/a1s1.rpy:238
translate pt_br a1s1_6b056a7b:

    # "I just stare, still waiting to wake up."
    "Eu só fico olhando, ainda esperando acordar."

# game/a1s1.rpy:239
translate pt_br a1s1_bcd268af:

    # "I've had dreams where I couldn't wake up before. This is just one of those."
    "Eu já tive sonhos dos quais não conseguia acordar antes. Esse é só mais um deles."

# game/a1s1.rpy:240
translate pt_br a1s1_f5dad1d4:

    # "I remember reading somewhere that if you aren't sure you're dreaming you can plug your nose."
    "Eu lembro de ter lido em algum lugar que, se você não tem certeza que está sonhando, pode tapar o seu nariz."

# game/a1s1.rpy:241
translate pt_br a1s1_fdb04c62:

    # "If you can still breathe, then it's definitely a dream."
    "Se ainda conseguir respirar, então definitivamente é um sonho."

# game/a1s1.rpy:242
translate pt_br a1s1_12fe202d:

    # "But I remain frozen against the wall."
    "Mas eu continuo paralisado contra a parede."

# game/a1s1.rpy:244
translate pt_br a1s1_6e2be873:

    # "The massive wolf sighs."
    "O grande lobo suspira."

# game/a1s1.rpy:245
translate pt_br a1s1_89e0fbad:

    # "Then his paw suddenly moves to his waist."
    "E então sua pata de repente vai até a cintura."

# game/a1s1.rpy:246
translate pt_br a1s1_ff6d139f:

    # "I only have a moment to see some sort of device with multi-colored lights before he moves and my entire body seizes up and things go black..."
    "Eu só consigo ver algum tipo de dispositivo com luzes coloridas antes dele se mexer, meu corpo ficar mole e minha visão escurecer..."

# game/a1s1.rpy:250
translate pt_br a1s1_b4e715e2:

    # "My body feels strangely numb."
    "Sinto meu corpo estranhamente entorpecido."

# game/a1s1.rpy:251
translate pt_br a1s1_76ffee5f:

    # "It's like when I wake up with a dead leg or arm, except right now it's my entire body."
    "É como nas vezes em que eu acordo com um braço ou perna dormentes, com exceção de que agora é o meu corpo inteiro."

# game/a1s1.rpy:252
translate pt_br a1s1_d03f3ae5:

    # "The only thing I can really feel is a sharp, cold pain behind and above my left eye."
    "A única coisa que eu realmente sinto é uma fina dor gelada atrás e acima do meu olho esquerdo."

# game/a1s1.rpy:253
translate pt_br a1s1_d2021c3d:

    # "I try to wiggle my fingers and hands, wondering if I'm having some sort of sleep paralysis."
    "Eu tento mexer meus dedos e mãos, me perguntando se isso é algum tipo de paralisia do sono."

# game/a1s1.rpy:254
translate pt_br a1s1_10f45fad:

    # "They move, at least I think they do; everything's so dark."
    "Eles se movem, ao menos eu acho que sim; está tudo tão escuro..."

# game/a1s1.rpy:255
translate pt_br a1s1_9c3ec7b9:

    # "Am I still in the apartment?"
    "Eu ainda estou no apartamento?"

# game/a1s1.rpy:256
translate pt_br a1s1_00f2b5db:

    # "Usually there's a little bit of light coming from the balcony because of the street lamps, but everything is pitch-black."
    "Casualmente aparece um raio de luz vindo da sacada por causa dos postes de iluminação na estrada, mas está tudo completamente escuro."

# game/a1s1.rpy:257
translate pt_br a1s1_9b39a63c:

    # "I start to feel a little panicky, both from the numb feeling and also the idea that I might have gone blind somehow."
    "Eu começo a me sentir um pouco apavorado, tanto por conta da sensação de entorpecimento quanto pela ideia de que eu possa ter ficado cego de alguma forma."

# game/a1s1.rpy:258
translate pt_br a1s1_dae82f25:

    # "I try to remember what happened last."
    "Tento me lembrar qual foi a última coisa que aconteceu."

# game/a1s1.rpy:259
translate pt_br a1s1_289b5d1f:

    # "Did I go out somewhere, maybe a club?"
    "Eu fui a algum lugar? Talvez uma festa?"

# game/a1s1.rpy:260
translate pt_br a1s1_6e857eba:

    # "The disco."
    "A boate."

# game/a1s1.rpy:261
translate pt_br a1s1_ee08ab67:

    # "Did I take something?"
    "Eu tomei alguma coisa?"

# game/a1s1.rpy:262
translate pt_br a1s1_075ec059:

    # "I start to push myself up and that's when I feel something soft under my hands...and something very hard under it, like concrete."
    "Começo a me empurrar para cima e é quando sinto algo macio sob minhas mãos... e algo muito duro embaixo disso, como concreto."

# game/a1s1.rpy:263
translate pt_br a1s1_73cf309b:

    # "I'm definitely not in a bed right now."
    "Eu definitivamente não estou em uma cama agora."

# game/a1s1.rpy:264
translate pt_br a1s1_cef37a22:

    # "Now I really am starting to panic, wondering if I've been kidnapped."
    "Agora eu realmente estou começando a entrar em pânico, será que fui sequestrado?"

# game/a1s1.rpy:265
translate pt_br a1s1_7e1507a7:

    # "I get on my hands and knees, thankful that at least the numb feeling is going away."
    "Começo a sentir minhas mãos e joelhos, grato de que pelo menos a sensação de dormência está se dissipando."

# game/a1s1.rpy:266
translate pt_br a1s1_31be5b3f:

    # "I'm also relieved to find out I'm not blind; I see a soft glow of light outlining what's roughly the shape of a door in front of me."
    "Também fico aliviado em descobrir que não fiquei cego; enxergo um brilho suave de luz delineando o que é provavelmente o formato de uma porta na minha frente."

# game/a1s1.rpy:267
translate pt_br a1s1_4fdbaef1:

    # "I open my mouth, about to call out before I force it shut again."
    "Eu abro a boca, prestes a chamar alguém, até que me forço a fechá-la de novo."

# game/a1s1.rpy:268
translate pt_br a1s1_0ba1121e:

    # "I have no idea where I am, or how I got here, but I'm not liking the signs."
    "Eu não faço ideia de onde estou, ou como cheguei aqui, mas não estou gostando dos sinais."

# game/a1s1.rpy:269
translate pt_br a1s1_835e8790:

    # "My head throbs a little and I close my eyes tight, trying to steady my breathing, listening to my heart pound."
    "Minha cabeça lateja um pouco e eu fecho os olhos com força, tentando estabilizar minha respiração, ouvindo meu coração bater."

# game/a1s1.rpy:270
translate pt_br a1s1_dc20e7df:

    # "I definitely got back to my apartment and I remember going to bed, and then I remember..."
    "Eu definitivamente voltei para o meu apartamento e lembro de ter ido para a cama, e então me lembro..."

# game/a1s1.rpy:271
translate pt_br a1s1_a0aa26ec:

    # "My eyes fly open as I remember that...wolf creature, staring at me with those blue eyes."
    "Meus olhos arregalam quando eu lembro daquela... criatura meio lobo, me encarando com aqueles olhos azuis."

# game/a1s1.rpy:272
translate pt_br a1s1_cb7874a8:

    # "And those teeth!"
    "E aqueles dentes!"

# game/a1s1.rpy:273
translate pt_br a1s1_0103c0fe:

    # "Oh my God, there's no way, there's no fucking way."
    "Ai meu deus, não tem como, nem fodendo..."

# game/a1s1.rpy:274
translate pt_br a1s1_ec49e5ca:

    # "I open my eyes again and stare at the soft light, trying to listen."
    "Eu abro meus olhos novamente e examino a suave luz, tentando escutar algo."

# game/a1s1.rpy:275
translate pt_br a1s1_d61f7ee1:

    # "There's a constant hum of some kind, a whirring of a large machine."
    "Há um rangido constante de algum tipo, um estridor de uma grande máquina."

# game/a1s1.rpy:276
translate pt_br a1s1_ab5e021d:

    # "It's gentle and almost soothing, but it makes me think I'm in some sort of vehicle."
    "É agradável e quase reconfortante, mas me faz pensar que estou em algum tipo de veículo."

# game/a1s1.rpy:277
translate pt_br a1s1_30bd4fdc:

    # "But I don't feel anything, no bumps or turns..."
    "Mas não sinto nada, solavancos ou curvas..."

# game/a1s1.rpy:278
translate pt_br a1s1_e291e558:

    # "I slowly crawl toward the door, listening as hard as I can for voices, or movement, anything that might tell me someone's nearby."
    "Eu rastejo lentamente em direção à porta, tentando escutar o máximo que posso por vozes ou movimento, qualquer coisa que possa me dizer se há alguém por perto."

# game/a1s1.rpy:279
translate pt_br a1s1_0f6961e2:

    # "As I get closer to the door I do hear something, a type of beeping and chirping."
    "À medida que chego mais perto da porta, de fato escuto alguma coisa, uma espécie de bipe e chilreado."

# game/a1s1.rpy:280
translate pt_br a1s1_805651df:

    # "I stay in that position for what feels like a solid fifteen minutes, not hearing anything more."
    "Eu fico nessa posição pelo que parecem ser sólidos quinze minutos, sem escutar mais nada."

# game/a1s1.rpy:281
translate pt_br a1s1_59eadde4:

    # "I think about trying to open the door, but I realize that might not be a great idea."
    "Eu penso em tentar abrir a porta, mas percebo que talvez isso não seja uma boa ideia."

# game/a1s1.rpy:282
translate pt_br a1s1_10bc3e4b:

    # "I still don't know if that wolf is real...no, I know he isn't real."
    "Eu ainda não sei se aquele lobo é real... não, eu sei que ele não é real."

# game/a1s1.rpy:283
translate pt_br a1s1_f05fef11:

    # "What's more likely is that someone slipped something into my drink and I hallucinated everything."
    "É muito mais provável que alguém tenha colocado algo na minha bebida e eu alucinei tudo."

# game/a1s1.rpy:284
translate pt_br a1s1_c63e16de:

    # "I had laughed off my parents' warnings that tourists are vulnerable in Rome, but now that doesn't seem so crazy."
    "Eu ri quando meus pais me alertaram sobre a vulnerabilidade dos turistas em Roma, mas agora eu entendo o que eles queriam dizer."

# game/a1s1.rpy:285
translate pt_br a1s1_538547c6:

    # "Someone had drugged me, followed me to my apartment, then kidnapped me."
    "Alguém me drogou, me seguiu até meu apartamento, e então me sequestrou."

# game/a1s1.rpy:286
translate pt_br a1s1_fc6ea5f3:

    # "I need something, a weapon, before I try opening the door."
    "Eu preciso de alguma coisa para usar como arma antes de tentar abrir a porta."

# game/a1s1.rpy:287
translate pt_br a1s1_539b7556:

    # "I feel like I'm in a closet of some kind so there's probably something here that I can use..."
    "Sinto que estou em alguma espécie de armário, então provavelmente há algo aqui que eu possa usar..."

# game/a1s1.rpy:288
translate pt_br a1s1_36d81232:

    # "Slowly, I get on my knees and start moving forward, waving my hands out in front of me."
    "Lentamente me levanto e começo a andar de joelhos para frente, esticando meus braços, tentando sentir alguma coisa."

# game/a1s1.rpy:289
translate pt_br a1s1_0f0e81ad:

    # "If I can find the shelves then I can just feel around for something solid and—"
    "Se eu encontrar as prateleiras, posso simplesmente procurar por algo sólido e—"

# game/a1s1.rpy:291
translate pt_br a1s1_70ae9824:

    # "My hand sweeps what feels like a box and what follows is a clang of metal as something falls to the floor."
    "Minha mão arrasta o que parece ser uma caixa e o que se segue é um tinido de metal à medida que algo cai no chão."

# game/a1s1.rpy:292
translate pt_br a1s1_a8aedc81:

    # "I cringe, squeezing my eyes shut as the sound echoes around the room I'm in."
    "Eu encolho com o som, apertando meus olhos com força enquanto ele ecoa através do cômodo no qual me encontro."

# game/a1s1.rpy:293
translate pt_br a1s1_97acbeef:

    # "I kneel there in complete silence, stunned."
    "Fico de joelhos, em completo silêncio, sem mover um músculo."

# game/a1s1.rpy:294
translate pt_br a1s1_74d4cc3a:

    # "And that's when light spills over my body, followed by a large shadow."
    "E é nesse momento que uma luz se derrama sobre todo meu corpo, seguida de uma larga sombra."

# game/a1s1.rpy:295
translate pt_br a1s1_8a1ee62e:

    # a "\"Oh hey, you're awake! Did you know he was awake?\""
    a "\"Ah, oi, você acordou!; Com, você sabia que ele estava acordado?\""

# game/a1s1.rpy:296
translate pt_br a1s1_153b1bf3:

    # unk "\"Yes, for approximately .2 hours—\""
    unk "\"Sim, por aproximadamente 2 horas—\""

# game/a1s1.rpy:297
translate pt_br a1s1_dcb96c62:

    # a "\"I swear to the Gods, why are you so useless?\""
    a "\"Pelo amor dos deuses, por que você é tão inútil?\""

# game/a1s1.rpy:298
translate pt_br a1s1_a5c77630:

    # "I sit there, not having turned around yet, but the shadow gets bigger and I feel him looming over me."
    "Fico parado, ainda sem ter me virado, mas a sombra fica maior e eu o sinto pairando sobre mim."

# game/a1s1.rpy:299
translate pt_br a1s1_2d45f00c:

    # "I get a whiff of lavender."
    "O cheiro de lavanda de antes voltou."

# game/a1s1.rpy:300
translate pt_br a1s1_758ccfed:

    # "Finally, I slowly turn my head and see the wolf."
    "Por fim, vagarosamente viro minha cabeça e me deparo com o lobo."

# game/a1s1.rpy:304
translate pt_br a1s1_d58c4651:

    # "He towers over me, his broad muzzle pointed down so that he can look me right in the eye."
    "Ele se eleva sobre mim, seu largo focinho apontado para baixo de forma que ele possa me olhar diretamente nos olhos."

# game/a1s1.rpy:305
translate pt_br a1s1_a0f5fdc4:

    # "While his size and general demeanor are intimidating, his eyes are warm and friendly."
    "Mesmo que seu tamanho e conduta geral sejam intimidadores, os olhos são calorosos e amigáveis."

# game/a1s1.rpy:306
translate pt_br a1s1_88fd5c4f:

    # "That doesn't really matter to me right now as I realize that I hadn't been dreaming or hallucinating earlier..."
    "Mas isso não tem tanta importância agora que percebi o fato de não estar sonhando ou alucinando mais cedo..."

# game/a1s1.rpy:307
translate pt_br a1s1_9389d513:

    # "...or the dream/hallucination is ongoing."
    "...ou o sonho/alucinação ainda está acontecendo."

# game/a1s1.rpy:308
translate pt_br a1s1_38aad77c:

    # "The wolf moves toward me and I immediately scoot back until the shelves behind me dig into my spine."
    "O lobo movimenta-se em minha direção e eu imediatamente deslizo, recuando, até as prateleiras atrás de mim colidirem com minhas costas."

# game/a1s1.rpy:309
translate pt_br a1s1_8a6c55e4:

    # "I vaguely notice the metal thing that I'd knocked over earlier."
    "Vagamente percebo a coisa de metal que deixei cair antes."

# game/a1s1.rpy:310
translate pt_br a1s1_053230ef:

    # "It's a polygon-shaped thing with a long cord running out of it."
    "É um objeto de formato poligonal com uma longa corda saindo dele."

# game/a1s1.rpy:311
translate pt_br a1s1_b526df15:

    # unk "\"Remember the human doesn't know about the {i}Galaxias{/i}; proceed with caution.\""
    unk "\"Lembre-se de que o humano não possui conhecimento acerca da {i}congregação galáctica{/i}; prossiga com cuidado.\""

# game/a1s1.rpy:312
translate pt_br a1s1_790bfe0c:

    # "The wolf's ears flick before he visibly tries to right his expression into a smile."
    "As orelhas do lobo sacodem antes dele visivelmente tentar corrigir sua expressão em um sorriso."

# game/a1s1.rpy:314
translate pt_br a1s1_fc469198:

    # a "\"H—hello human, sorry, I mean [mc], right?\""
    a "\"O-olá humano, desculpe, digo, [mc], certo?\""

# game/a1s1.rpy:315
translate pt_br a1s1_038f75e9:

    # "Again, I get caught up in watching the movements of his mouth counter to what I'm hearing in my brain."
    "Novamente, percebo os movimentos de sua boca contrariarem o que ouço em meu cérebro."

# game/a1s1.rpy:316
translate pt_br a1s1_96ce96fd:

    # "Then I notice that he's waiting, watching me intently."
    "Então, noto que ele espera uma resposta, me observando atentamente."

# game/a1s1.rpy:317
translate pt_br a1s1_0027a5a0:

    # "I open my mouth, then close it, then nod."
    "Eu abro minha boca, a fecho e depois aceno com a cabeça."

# game/a1s1.rpy:319
translate pt_br a1s1_b1003efd:

    # "The wolf still stares at me, seeming not to understand."
    "O lobo continua me encarando, parecendo não entender."

# game/a1s1.rpy:320
translate pt_br a1s1_128c51ae:

    # a "\"Right?\""
    a "\"Certo?\""

# game/a1s1.rpy:321
translate pt_br a1s1_c8af9c77:

    # "The silence stretches on until I finally force myself to speak."
    "O silêncio se estende até eu finalmente me forçar a falar."

# game/a1s1.rpy:322
translate pt_br a1s1_499b85ea:

    # m "\"Yes.\""
    m "\"Sim.\""

# game/a1s1.rpy:323
translate pt_br a1s1_ac0729a6:

    # "It comes out in barely a whisper."
    "A voz mal sai da minha boca, quase que um sussuro."

# game/a1s1.rpy:325
translate pt_br a1s1_8dad4b44:

    # a "\"Great! So now that we understand that, I can tell you that I'm from the star {i}Stella Vita{/i}, very far from here.\""
    a "\"Ótimo! Agora que nos entendemos, posso te dizer que venho da estrela {i}Stella Vita{/i}, fica muito longe daqui.\""

# game/a1s1.rpy:326
translate pt_br a1s1_d2535d3d:

    # "The wolf sets his paws far apart, his eyes wide as he emphasizes the distance."
    "O lobo mira suas patas ao longe, seus olhos arregalados conforme ele enfatiza a distância."

# game/a1s1.rpy:327
translate pt_br a1s1_960bba08:

    # "He's talking to me in a way one might to a very dumb two-year-old."
    "Ele está falando comigo de um jeito que alguém falaria com uma criança de dois anos muito idiota."

# game/a1s1.rpy:328
translate pt_br a1s1_80b66eda:

    # a "\"I live on a moon called Adastra. Do you know what a moon is? You live on what's called a planet.\""
    a "\"Eu vivo em uma lua, o nome dela é Adastra. Você sabe o que é uma lua? Você vive no que nós chamamos de planeta.\""

# game/a1s1.rpy:329
translate pt_br a1s1_b4df7430:

    # "I stare at him for a moment, almost offended despite my continuing shock."
    "Eu o encaro por um instante, quase ofendido, apesar do choque contínuo."

# game/a1s1.rpy:331
translate pt_br a1s1_5b7aec9d:

    # "Amicus smiles gently."
    "Amicus sorri gentilmente."

# game/a1s1.rpy:332
translate pt_br a1s1_769c331f:

    # a "\"A moon is a large—\""
    a "\"Uma lua é uma enorme—\""

# game/a1s1.rpy:333
translate pt_br a1s1_6900e072:

    # m "\"I know what a moon is.\""
    m "\"Eu sei o que é uma lua.\""

# game/a1s1.rpy:335
translate pt_br a1s1_f77dfa4a:

    # "Amicus blinks at me."
    "Amicus pisca para mim."

# game/a1s1.rpy:336
translate pt_br a1s1_a482770e:

    # m "\"We have one.\""
    m "\"Nós temos uma.\""

# game/a1s1.rpy:337
translate pt_br a1s1_2cbda01f:

    # "My words feel automatic...actually everything feels like it's on auto-pilot right now."
    "Minhas palavras têm uma carga automática... Na verdade, tudo parece estar funcionando em piloto automático agora."

# game/a1s1.rpy:339
translate pt_br a1s1_f54a9733:

    # a "\"Oh! Well, I didn't know that. That's great!\""
    a "\"Ah! Bem, eu não sabia disso. Isso é ótimo.\""

# game/a1s1.rpy:340
translate pt_br a1s1_6a9a5981:

    # "There's an awkward silence as the two of us stare at each other."
    "Há um silêncio constrangedor enquanto nós encaramos um ao outro."

# game/a1s1.rpy:341
translate pt_br a1s1_2d16ed10:

    # "The initial fear is wearing off."
    "O medo inicial começa a se dissipar."

# game/a1s1.rpy:342
translate pt_br a1s1_365e654c:

    # "I feel that if this alien is meaning to hurt me, he would have done it by now."
    "Eu sinto que se esse alienígena tivesse a intenção de me machucar, ele já teria feito isso."

# game/a1s1.rpy:343
translate pt_br a1s1_7fcc53a5:

    # "At least...for now."
    "Pelo menos... por enquanto."

# game/a1s1.rpy:344
translate pt_br a1s1_f36df3b1:

    # "Amicus rubs his paws together nervously."
    "Amicus esfrega as mãos, parecendo nervoso."

# game/a1s1.rpy:345
translate pt_br a1s1_68298918:

    # a "\"Um...are you hungry?\""
    a "\"Hm... você está com fome?\""

# game/a1s1.rpy:346
translate pt_br a1s1_0a18126c:

    # "He motions at his mouth, then rubs his stomach while licking his lips."
    "Ele faz um gesto com a boca, depois esfrega sua barriga enquanto lambe os beiços."

# game/a1s1.rpy:348
translate pt_br a1s1_ead8f92b:

    # a "\"Mmmmmh.\""
    a "\"Mmmmmh.\""

# game/a1s1.rpy:349
translate pt_br a1s1_16af2423:

    # "Again, gestures and expressions that I have no trouble interpreting."
    "Mais uma vez, gestos e expressões os quais não tenho problema algum em interpretar."

# game/a1s1.rpy:350
translate pt_br a1s1_f4de058d:

    # "The only alien thing about him is his appearance."
    "A única coisa alienígena sobre ele é sua aparência."

# game/a1s1.rpy:351
translate pt_br a1s1_15ceed41:

    # m "\"I—I don't know.\""
    m "\"Eu—eu não sei.\""

# game/a1s1.rpy:353
translate pt_br a1s1_92b2af0b:

    # "The wolf frowns, almost looking frustrated."
    "O lobo faz uma careta, parecendo frustrado."

# game/a1s1.rpy:354
translate pt_br a1s1_e91da4e9:

    # "His slow speech gets even slower."
    "Seu lento discurso torna-se ainda mais lento."

# game/a1s1.rpy:355
translate pt_br a1s1_bca898d5:

    # a "\"Well...why don't we give it a try, then?\""
    a "\"É... podemos tentar comer, que tal?\""

# game/a1s1.rpy:356
translate pt_br a1s1_362b6ad3:

    # "I guess my answers don't exactly make me seem intelligent."
    "Acho que minhas respostas não exatamente me fazem parecer inteligente."

# game/a1s1.rpy:357
translate pt_br a1s1_3d741ce9:

    # "But I don't know how else to respond."
    "Mas eu não sei como deveria responder."

# game/a1s1.rpy:359
translate pt_br a1s1_84865bfb:

    # a "\"Why don't you come out onto the deck with me? I'll make something.\""
    a "\"Por que não vem para o convés comigo? Eu faço alguma coisa para você.\""

# game/a1s1.rpy:360
translate pt_br a1s1_643c336d:

    # "Amicus gives an exaggerated \"come on\" gesture with both paws as he walks backwards...straight into the wall as he misses the door."
    "Amicus faz um gesto exagerado de \"Qual é? Vamos lá...\" com as duas patas enquanto anda de costas... diretamente até a parede, errando a porta."

# game/a1s1.rpy:364
translate pt_br a1s1_216c9f25:

    # a "\"Ow! Uh, yeah, let's go human.\""
    a "\"Au! Hã, é, vamos, humano.\""

# game/a1s1.rpy:365
translate pt_br a1s1_1ee0652a:

    # "He rubs the back of his head with a wince before turning and walking out the door."
    "Ele esfrega a nuca, se retraindo antes de virar e sair pela porta."

# game/a1s1.rpy:368
translate pt_br a1s1_209a8389:

    # "I stare at the open door for a moment before slowly getting up and following him, walking over a brown shag rug; the soft thing I'd been laying on."
    "Eu fico encarando a porta aberta por um tempo antes de me levantar lentamente e segui-lo, andando sobre um tapete felpudo marrom; a coisa macia na qual estava deitado."

# game/a1s1.rpy:371
translate pt_br a1s1_1c3668e4:

    # "That's when I'm standing in the middle of what looks like something straight out of a sci-fi movie."
    "É nesse momento que me vejo no meio de algo que parece ter saído diretamente de um filme de ficção científica."

# game/a1s1.rpy:372
translate pt_br a1s1_d3aafc8b:

    # "It's small and cramped, but the amount of unfamiliar, glowing technology is almost overwhelming."
    "É pequeno e apertado, mas a quantidade de tecnologia desconhecida com painéis e botões brilhantes é quase esmagadora."

# game/a1s1.rpy:373
translate pt_br a1s1_2f49535c:

    # "Glass panels cover almost every inch of the walls around me, displaying images and characters that I can't even come close to understanding."
    "Painéis de vidro cobrem quase cada centímetro das paredes ao meu redor, exibindo imagens e símbolos que não chego nem perto de compreender."

# game/a1s1.rpy:374
translate pt_br a1s1_a16ecf0e:

    # "Straight ahead of me are large windows, looking out into blackness dotted with specks of light."
    "Bem na minha frente, há grandes janelas e, depois delas, uma escuridão cheia de pontinhos de luz."

# game/a1s1.rpy:375
translate pt_br a1s1_9faf8a1c:

    # "Specks of light..."
    "Pontinhos de luz..."

# game/a1s1.rpy:376
translate pt_br a1s1_b8d229da:

    # "I'm in a space ship."
    "Eu estou em uma nave espacial."

# game/a1s1.rpy:377
translate pt_br a1s1_e4f61777:

    # "Where the hell is he taking me?"
    "Onde diabos ele está me levando?"

# game/a1s1.rpy:378
translate pt_br a1s1_3ea9be29:

    # "Amicus is over to my right side, messing with what I can only describe as a large Espresso machine growing out of the side of the spaceship."
    "Amicus se encontra do meu lado direito, mexendo com o que só posso descrever como uma máquina gigante de café expresso que parece estar anexada ao canto da nave."

# game/a1s1.rpy:379
translate pt_br a1s1_2d070ccd:

    # "He's holding a cup under a nozzle, ducking down a little to stare at the opening."
    "Ele segura uma caneca embaixo de um bico, curvando-se um pouco para enxergar a abertura."

# game/a1s1.rpy:380
translate pt_br a1s1_56536181:

    # "He notices me looking."
    "Ele me nota observando."

# game/a1s1.rpy:382
translate pt_br a1s1_eac2e36f:

    # a "\"Heh, takes a while to warm up...I have to warn you that it's not very good, but it's probably better than most of what you eat on your moon...planet, I mean.\""
    a "\"Hehe, demora um pouco até esquentar... vou ser sincero com você, não é lá muito gostoso, mas provavelmente é melhor que muito do que você come na sua lua... digo, planeta.\""

# game/a1s1.rpy:383
translate pt_br a1s1_eef02891:

    # "Just as he's talking a very thick globule of brown sludge shoots out of the nozzle, half of it missing the cup."
    "Enquanto ele fala, uma bola muito espessa de lodo marrom sai do bico, metade caindo para fora da caneca."

# game/a1s1.rpy:385
translate pt_br a1s1_8b9e4bab:

    # a "\"Ah, dammit.\""
    a "\"Ah, porcaria.\""

# game/a1s1.rpy:386
translate pt_br a1s1_e3acdd97:

    # "The wolf hastily moves the cup to catch the rest of it while reaching over with his other paw to snatch up a rag from a hook on the side of the machine."
    "O lobo move a caneca apressadamente para pegar o restante enquanto estende a outra pata, tentando alcançar o pano em um gancho na lateral da máquina."

# game/a1s1.rpy:388
translate pt_br a1s1_7edc4041:

    # a "\"Sorry, this thing is near broken. Do you want to sit down?\""
    a "\"Desculpe, essa coisa está quase quebrando. Você quer se sentar?\""

# game/a1s1.rpy:389
translate pt_br a1s1_a133266e:

    # "He nods his head over at one of the two seats in front of the windows."
    "Ele acena com a cabeça para um dos dois assentos em frente à janela."

# game/a1s1.rpy:390
translate pt_br a1s1_39269607:

    # a "\"Just, uh, don't touch any of the bright lights, okay?\""
    a "\"Só, hã, não toque em nenhuma das luzes brilhantes, ok?\""

# game/a1s1.rpy:392
translate pt_br a1s1_fce7187e:

    # "I make my way over to the front of the deck, still waiting to wake up."
    "Sigo o caminho até a frente do convés, ainda esperando acordar."

# game/a1s1.rpy:393
translate pt_br a1s1_68e55c7a:

    # "I stand beside the seat, reaching out to touch the soft red bristles of the helmet and the wings on the sides."
    "Eu fico de pé ao lado do assento, estendendo o braço para tocar nas cerdas vermelhas suaves do capacete e asas nas laterais."

# game/a1s1.rpy:394
translate pt_br a1s1_ab97a796:

    # "This only enforces the feeling that I'm hallucinating or dreaming."
    "Isso apenas reforça a sensação de que estou alucinando ou sonhando."

# game/a1s1.rpy:395
translate pt_br a1s1_64650b80:

    # "There's a strange Roman influence to Amicus and the ship, one that's almost cartoonish."
    "Há uma estranha influência romana no Amicus e na nave espacial, quase que cartunesca."

# game/a1s1.rpy:396
translate pt_br a1s1_bcab87f8:

    # "Has my obsession over Rome gone too far?"
    "Teria minha obsessão com Roma ido longe demais?"

# game/a1s1.rpy:397
translate pt_br a1s1_24c0ed8a:

    # "I can just imagine myself in some Italian hospital right now, babbling about Roman wolf aliens."
    "Eu só consigo me imaginar em algum hospital italiano agora, balbuciando sobre lobos alienígenas romanos."

# game/a1s1.rpy:399
translate pt_br a1s1_972bf95c:

    # a "\"Go on and sit.\""
    a "\"Fique à vontade, pode sentar.\""

# game/a1s1.rpy:400
translate pt_br a1s1_a849b504:

    # "Amicus plants himself heavily in the seat next to mine, holding two cups of what looks like brown sludge."
    "Amicus se afunda no assento ao lado do meu, segurando duas canecas do lodo marrom."

# game/a1s1.rpy:401
translate pt_br a1s1_0cec13dc:

    # "He holds one out to me."
    "Ele oferece uma para mim."

# game/a1s1.rpy:402
translate pt_br a1s1_d081d670:

    # "I take it gingerly before sitting down."
    "Eu seguro com cuidado antes de me sentar."

# game/a1s1.rpy:403
translate pt_br a1s1_1b119778:

    # "Looking into the cup, the \"food\" has the consistency and look of half-melted chocolate ice cream."
    "Olhando para a caneca, a \"comida\" possui a consistência e aparência de sorvete de chocolate derretido."

# game/a1s1.rpy:404
translate pt_br a1s1_6b4da191:

    # "Except it's warm and smells like dirt, like literal mud."
    "Exceto que é quente e cheira a terra, como se fosse lama."

# game/a1s1.rpy:405
translate pt_br a1s1_a1137124:

    # "I scrunch my nose up at it, which Amicus notices."
    "Eu torço o nariz com a refeição e o Amicus percebe."

# game/a1s1.rpy:407
translate pt_br a1s1_cee7e6e4:

    # a "\"Haha! yeah, it's not the best. I actually had some good food that I brought along with me, but I ate it all before I got here.\""
    a "\"Haha! É, não é das melhores. Na verdade, eu trouxe um rango legal comigo, mas comi tudo antes de chegar aqui.\""

# game/a1s1.rpy:408
translate pt_br a1s1_a167fbc5:

    # "The wolf shrugs then settles excitedly into his seat."
    "O lobo encolhe os ombros e senta entusiasmado em seu assento."

# game/a1s1.rpy:410
translate pt_br a1s1_1ec87302:

    # a "\"So tell me about where you're from! What's life like on Earth?\""
    a "\"Então, me diz de onde você é! Como é a vida na Terra?\""

# game/a1s1.rpy:411
translate pt_br a1s1_ddb84a43:

    # m "\"Um, it's...okay?\""
    m "\"Ah, é... ok?\""

# game/a1s1.rpy:413
translate pt_br a1s1_b7935aed:

    # a "\"Okay, well, what's your occupation?\""
    a "\"Ok, bem, qual é a sua ocupação?\""

# game/a1s1.rpy:414
translate pt_br a1s1_71d94276:

    # m "\"I'm...a student.\""
    m "\"Eu sou... um estudante.\""

# game/a1s1.rpy:415
translate pt_br a1s1_41b525ab:

    # a "\"Oh, what discipline?\""
    a "\"Ah, e o que estuda?\""

# game/a1s1.rpy:416
translate pt_br a1s1_37fe3f5e:

    # "I try to adjust to the surreal feeling of talking to this wolf."
    "Eu tento me ajustar ao sentimento surreal de estar falando com esse lobo."

# game/a1s1.rpy:417
translate pt_br a1s1_26b29875:

    # m "\"I don't know yet. I was looking into history; Greek and Roman studies.\""
    m "\"Eu não sei ainda. Tava pensando em história; estudos gregos e romanos.\""

# game/a1s1.rpy:418
translate pt_br a1s1_5d398362:

    # a "\"Hm...\""
    a "\"Hm...\""

# game/a1s1.rpy:419
translate pt_br a1s1_582f5743:

    # "That seems confusing to him for some reason."
    "Isso soa confuso para ele por alguma razão."

# game/a1s1.rpy:420
translate pt_br a1s1_d36b52a8:

    # a "\"Do you have an emperor? What's he like?\""
    a "\"Você tem um imperador? Como ele é?\""

# game/a1s1.rpy:421
translate pt_br a1s1_9197e014:

    # "I catch myself staring at his mouth again, at the weird way his mouth is un-synced with his words."
    "Eu me pego encarando a boca dele outra vez, observando o jeito estranho de como os lábios se movem não sincronizando com as palavras."

# game/a1s1.rpy:422
translate pt_br a1s1_544f5dd5:

    # m "\"N—no...\""
    m "\"N—não...\""

# game/a1s1.rpy:424
translate pt_br a1s1_8a6defb9:

    # a "\"Then how—\""
    a "\"Então como—\""

# game/a1s1.rpy:425
translate pt_br a1s1_4fd30174:

    # "I interrupt him."
    "Eu o interrompo."

# game/a1s1.rpy:426
translate pt_br a1s1_3d9c52d8:

    # m "\"Why isn't your mouth matching up with the sounds you're making?\""
    m "\"Por que os movimentos da sua boca não combinam com os sons que você tá fazendo?\""

# game/a1s1.rpy:427
translate pt_br a1s1_72e548c1:

    # a "\"Eh?\""
    a "\"Hein?\""

# game/a1s1.rpy:428
translate pt_br a1s1_88475498:

    # "Even with the space ship and alien around me, it's the weird distortion of feeling like I'm watching a dubbed movie that has me most unsettled."
    "Mesmo com uma nave espacial e um alienígena ao meu redor, é a estranha sensação de como se eu estivesse assistindo a um filme dublado que me deixa mais perplexo."

# game/a1s1.rpy:430
translate pt_br a1s1_0e2194aa:

    # a "\"Oh!\""
    a "\"Ah!\""

# game/a1s1.rpy:431
translate pt_br a1s1_11b8dc0c:

    # "Amicus points a finger at me to a spot just above my left eye."
    "Amicus aponta um dedo para mim em um local bem acima do meu olho esquerdo."

# game/a1s1.rpy:432
translate pt_br a1s1_6ea5a501:

    # a "\"I gave you a Lingua. It helps you understand me.\""
    a "\"Eu dei a você um interpretus. Ele te ajuda a me entender.\""

# game/a1s1.rpy:433
translate pt_br a1s1_c67597be:

    # "I stare at him, but he doesn't offer anything more."
    "Eu fico encarando, mas ele não fala mais nada."

# game/a1s1.rpy:434
translate pt_br a1s1_98dbe3cb:

    # m "\"...How?\""
    m "\"...Como?\""

# game/a1s1.rpy:436
translate pt_br a1s1_ac8a2ce6:

    # a "\"Oh, well it, uh, sort of attaches to the language center in the brain.\""
    a "\"Ah, bem, ele... ele meio que se conecta ao centro de comunicação do cérebro.\""

# game/a1s1.rpy:437
translate pt_br a1s1_08791113:

    # a "\"It's very smart; it learns from the host brain and is able to interpret the eight major Galaxias languages for them.\""
    a "\"É bem inteligente; ele aprende através do hospedeiro e é capaz de interpretar os 8 principais idiomas da congregação galáctica.\""

# game/a1s1.rpy:438
translate pt_br a1s1_920b6365:

    # m "\"And...how does it do that?\""
    m "\"E... como ele faz isso?\""

# game/a1s1.rpy:440
translate pt_br a1s1_d4fc81df:

    # a "\"Uh, well, our brains are structured in similar ways, at least among Sapients, so it works almost universally.\""
    a "\"Ah, bem, nossos cérebros são estruturados de formas similares, ao menos entre sapientes, então ele funciona praticamente de forma universal.\""

# game/a1s1.rpy:441
translate pt_br a1s1_7827e68d:

    # a "\"Honestly, it's parental tech, so I'm not fully sure of how it works. None of us do, but it does work.\""
    a "\"Para falar a verdade, é tecnologia dos progenitores, então eu não tenho tanta certeza de como funciona. Nenhum de nós tem, mas funciona.\""

# game/a1s1.rpy:442
translate pt_br a1s1_bd610ca3:

    # "Amicus continues to look at me, clearly concerned about something."
    "Amicus continua olhando para mim, claramente preocupado com alguma coisa."

# game/a1s1.rpy:443
translate pt_br a1s1_8417fadc:

    # "But I'm concerned, too."
    "Mas eu também estou preocupado."

# game/a1s1.rpy:444
translate pt_br a1s1_e023eaa1:

    # m "\"How did you get it...into my brain.\""
    m "\"Como você colocou isso... no meu cérebro?\""

# game/a1s1.rpy:445
translate pt_br a1s1_1ecffb06:

    # a "\"Uh...\""
    a "\"Hã...\""

# game/a1s1.rpy:447
translate pt_br a1s1_42570b6d:

    # a "\"You know, you ask a lot of questions.\""
    a "\"Sabe, você faz muitas perguntas.\""

# game/a1s1.rpy:448
translate pt_br a1s1_e3a5312e:

    # "I stare at him."
    "Eu fico o encarando."

# game/a1s1.rpy:449
translate pt_br a1s1_d2d0a020:

    # m "\"Well, this is all kind of new to me. Should I not be asking questions?\""
    m "\"Olha, isso é tudo muito novo pra mim. Eu não deveria estar fazendo perguntas?\""

# game/a1s1.rpy:451
translate pt_br a1s1_dc36b687:

    # a "\"It's fine. I've just never had a child ask me questions, really. Anyway, there's a device that inserts it. I was lucky to find one left over on the ship.\""
    a "\"Não, tudo bem. É que um infante nunca me fez tantas perguntas antes, sério. Enfim, tem um dispositivo que o insere. Eu tive sorte de encontrar um sobrando na nave.\""

# game/a1s1.rpy:452
translate pt_br a1s1_fa44efc7:

    # "Inserts it."
    "O insere."

# game/a1s1.rpy:453
translate pt_br a1s1_1868ae8c:

    # "I rub the spot between my eye and eye socket, the skin slightly tender."
    "Eu esfrego o local entre meu olho e a sobrancelha e percebo a pele ligeiramente macia."

# game/a1s1.rpy:455
translate pt_br a1s1_ff482f7a:

    # a "\"Does it hurt? That should wear off in a few hours.\""
    a "\"Está doendo? Deveria melhorar em algumas horas.\""

# game/a1s1.rpy:456
translate pt_br a1s1_1756ca87:

    # "I stare at Amicus for a few moments, then down into my cup, feeling a bit sick."
    "Eu fico encarando o Amicus por alguns instantes, depois viro os olhos para a minha caneca, me sentindo um pouco mal."

# game/a1s1.rpy:457
translate pt_br a1s1_04aa5eb6:

    # "Staring at the brown mush isn't helping."
    "Olhar fixamente para esta papa marrom não está ajudando."

# game/a1s1.rpy:459
translate pt_br a1s1_fcf502c8:

    # a "\"Need help with that? You can eat it like this.\""
    a "\"Precisa de ajuda com isso? Você pode comer assim:\""

# game/a1s1.rpy:460
translate pt_br a1s1_d7063bef:

    # "He dips his muzzle down toward his own cup."
    "Ele mergulha o focinho em direção a sua própria caneca."

# game/a1s1.rpy:461
translate pt_br a1s1_a4e5521c:

    # "He sticks out a long, thick, pink tongue, pressing it into the sludge before cupping it and bringing it back up into his mouth."
    "Põe para fora uma longa e grossa língua rosa, pressionando no lodo antes de levar de volta à boca."

# game/a1s1.rpy:462
translate pt_br a1s1_ad6356a8:

    # "He pulls a bit of a face before smiling."
    "Ele faz uma careta antes de esboçar um sorriso."

# game/a1s1.rpy:464
translate pt_br a1s1_4be88848:

    # a "\"Not terrible!\""
    a "\"Não é terrivel!\""

# game/a1s1.rpy:465
translate pt_br a1s1_11a936d8:

    # "Then he looks at me a bit closer."
    "Então ele olha para mim um pouco mais de perto."

# game/a1s1.rpy:467
translate pt_br a1s1_8971992d:

    # a "\"Wait, you do have a tongue, right?\""
    a "\"Espera, você tem uma língua, não é?\""

# game/a1s1.rpy:468
translate pt_br a1s1_a4fc5b6b:

    # "I stare back at him for a moment before setting the cup to the side on the armrest."
    "Eu o encaro de volta por um momento antes de deixar a caneca no apoio de braço."

# game/a1s1.rpy:471
translate pt_br a1s1_9e2304d6:

    # m "\"What are you doing?\""
    m "\"O que você tá fazendo?\""

# game/a1s1.rpy:473
translate pt_br a1s1_c42c8b9e:

    # a "\"Huh?\""
    a "\"Ãhn?\""

# game/a1s1.rpy:474
translate pt_br a1s1_d63c7aaa:

    # m "\"What is all this, where are you taking me?\""
    m "\"O que é tudo isso, pra onde você tá me levando?\""

# game/a1s1.rpy:475
translate pt_br a1s1_601967be:

    # "At this point I'm starting to get over the shock."
    "A essa altura, estou começando a superar o choque."

# game/a1s1.rpy:476
translate pt_br a1s1_a2a6a213:

    # "I'm also starting to get annoyed at this alien's complete disregard for...basically everything to do with me."
    "Também estou começando a ficar irritado com a completa desconsideração desse alienígena palerma com... basicamente tudo que me diz respeito."

# game/a1s1.rpy:477
translate pt_br a1s1_2551b837:

    # m "\"You kidnapped me, you left me in a closet, you're feeding me what looks like shit, and now you tell me you jabbed something into my brain?\""
    m "\"Você me sequestrou, me largou em um armário, tá me alimentando com esse troço que parece merda e agora me diz que espetou uma coisa no meu cérebro?\""

# game/a1s1.rpy:479
translate pt_br a1s1_96863100:

    # "Amicus actually flinches at that."
    "Amicus se encolhe com a última frase."

# game/a1s1.rpy:480
translate pt_br a1s1_af059a4e:

    # a "\"D-does it still hurt? I can give you a pain manager—\""
    a "\"A-Ainda dói? Eu posso te dar algo para a dor—\""

# game/a1s1.rpy:481
translate pt_br a1s1_76231e5e:

    # m "\"I don't really want anything from you. What is all of this?\""
    m "\"Eu realmente não tô interessado em nada vindo de você. O que tá acontecendo?\""

# game/a1s1.rpy:482
translate pt_br a1s1_d841db44:

    # "The wolf just stares at me, wide-eyed."
    "O lobo apenas olha para mim com os olhos arregalados."

# game/a1s1.rpy:483
translate pt_br a1s1_4da4b17f:

    # "It's like he didn't even consider me being capable of being upset."
    "É como se ele nem me considerasse capaz de ficar irritado."

# game/a1s1.rpy:484
translate pt_br a1s1_39a9302d:

    # a "\"Hey, it's okay—\""
    a "\"Ei, está tudo bem—\""

# game/a1s1.rpy:485
translate pt_br a1s1_d274d0cb:

    # m "\"You kidnapped me.\""
    m "\"Você me sequestrou.\""

# game/a1s1.rpy:486
translate pt_br a1s1_5b62667a:

    # "I feel myself getting more panicked, both from the realization of what's happened and what's currently happening."
    "Sinto que estou entrando em pânico, tanto pela percepção sobre o que aconteceu, quanto pelo que está acontecendo."

# game/a1s1.rpy:487
translate pt_br a1s1_e9db3d3f:

    # a "\"No! Well, I mean—\""
    a "\"Não! Bem, quer dizer—\""

# game/a1s1.rpy:488
translate pt_br a1s1_7eb2e208:

    # m "\"You like, tazed me or something!\""
    m "\"Você tipo, usou um taser ou algo assim!\""

# game/a1s1.rpy:489
translate pt_br a1s1_3c8805f7:

    # a "\"What?\""
    a "\"O que?\""

# game/a1s1.rpy:490
translate pt_br a1s1_f0910897:

    # m "\"You electrocuted me.\""
    m "\"Você me eletrocutou.\""

# game/a1s1.rpy:491
translate pt_br a1s1_7c665dcb:

    # a "\"No! It's not electricity.\""
    a "\"Não! Não era eletricidade.\""

# game/a1s1.rpy:492
translate pt_br a1s1_45fa820f:

    # m "\"That doesn't make it better!\""
    m "\"Isso não deixa a situação menos pior!\""

# game/a1s1.rpy:493
translate pt_br a1s1_1ae3b06c:

    # "For a brief moment I think about overpowering this wolf, somehow turning the ship around if I can figure it out."
    "Por um breve instante, penso em atacar esse lobo e, de alguma forma, dar a volta com a nave se eu conseguir descobrir como fazer isso."

# game/a1s1.rpy:494
translate pt_br a1s1_ebed2e1c:

    # com "\"Sensing hostile intent. Proceed with caution, Amicus.\""
    com "\"Identificando intenção hostil. Prossiga com cuidado, Amicus.\""

# game/a1s1.rpy:496
translate pt_br a1s1_bb80c469:

    # "Amicus doesn't say anything and I see him gripping into his cup tightly."
    "Amicus não diz nada e eu o observo apertando sua caneca com força."

# game/a1s1.rpy:497
translate pt_br a1s1_482cc6e6:

    # "I get the odd feeling that he didn't expect me to point these things out to him."
    "Eu tenho a estranha sensação de que ele não esperava que eu falasse essas coisas para ele."

# game/a1s1.rpy:498
translate pt_br a1s1_fa40c7d5:

    # "Did he think that I was that unintelligent?"
    "Será que ele pensou que eu era idiota?"

# game/a1s1.rpy:499
translate pt_br a1s1_f133bbd8:

    # "I can tell he's calculating something in his head right now, and that makes me nervous."
    "Posso dizer que ele está planejando algo na cabeça agora, e isso está me deixando nervoso."

# game/a1s1.rpy:500
translate pt_br a1s1_32db0c6a:

    # "Maybe I should have just played dumb."
    "Talvez eu devesse simplesmente ter fingido ser um retardado."

# game/a1s1.rpy:501
translate pt_br a1s1_4877c7bc:

    # "We stare at each other for a long while until Amicus's steely gaze forces me to look away."
    "Ficamos encarando um ao outro por um longo período de tempo até o olhar penetrante do Amicus me forçar a desviar o olhar."

# game/a1s1.rpy:502
translate pt_br a1s1_323887e5:

    # "I choose to glance up at the ceiling, deciding to change the subject and give myself some time to just think."
    "Eu escolho olhar para o teto, decidindo mudar de assunto e me dar algum tempo para pensar."

# game/a1s1.rpy:503
translate pt_br a1s1_03388e1b:

    # m "\"What is that thing?\""
    m "\"O que é isso?\""

# game/a1s1.rpy:504
translate pt_br a1s1_256eb462:

    # "Amicus clears his throat."
    "Amicus pigarreia."

# game/a1s1.rpy:505
translate pt_br a1s1_3c8805f7_1:

    # a "\"What?\""
    a "\"O que?\""

# game/a1s1.rpy:506
translate pt_br a1s1_b8592b9d:

    # m "\"That voice.\""
    m "\"Essa voz.\""

# game/a1s1.rpy:507
translate pt_br a1s1_938ffb0c:

    # "I nod up at the ceiling, in the vague direction where I heard the sound come from."
    "Eu aceno com a cabeça para o teto, na vaga direção de onde escutei o som vindo."

# game/a1s1.rpy:508
translate pt_br a1s1_cdb07352:

    # "The thing that can apparently sense my hostile intents."
    "A coisa que aparentemente consegue sentir minhas intenções hostis."

# game/a1s1.rpy:510
translate pt_br a1s1_0e2194aa_1:

    # a "\"Oh!\""
    a "\"Ah!\""

# game/a1s1.rpy:511
translate pt_br a1s1_886f7b57:

    # "Amicus looks up at the ceiling too."
    "Amicus também olha para o teto."

# game/a1s1.rpy:513
translate pt_br a1s1_63cb0efc:

    # a "\"That's Computatrum, or Com. He's pretty annoying, aren't you Com?\""
    a "\"É o Computatrum, ou Com. Ele é bem irritante, não é, Com?\""

# game/a1s1.rpy:514
translate pt_br a1s1_2d68c962:

    # com "\"I can provide diagnostics on the ship, on the mood and competence of crew mates, on—\""
    com "\"Posso providenciar diagnósticos sobre a nave, sobre o humor e competência da equipe, sobre—\""

# game/a1s1.rpy:515
translate pt_br a1s1_59602e0d:

    # a "\"Thank you, Com. Anyway, he's not actually a sapient. He's a program that can process language and spit out information stored in his database.\""
    a "\"Obrigado, Com. Enfim, ele não é um sapiente, na verdade. É um programa que pode processar linguagem e prover informações armazenadas em seu banco de dados.\""

# game/a1s1.rpy:516
translate pt_br a1s1_54bca475:

    # "Amicus pauses."
    "Amicus pausa."

# game/a1s1.rpy:517
translate pt_br a1s1_8192385a:

    # a "\"I'm sorry, you probably don't understand what I'm talking about.\""
    a "\"Me desculpe, você provavelmente não faz ideia do que eu estou falando.\""

# game/a1s1.rpy:518
translate pt_br a1s1_e2564d96:

    # m "\"Um, I think I do. Artificial intelligence, maybe?\""
    m "\"Hm, acho que sei sim. É tipo uma inteligência artificial?\""

# game/a1s1.rpy:519
translate pt_br a1s1_8ff60a1b:

    # "I reach instinctively for the pocket of my jeans, but I remember that I left my phone on the bedside table."
    "Instintivamente toco o bolso da minha calça jeans, mas lembro que deixei o celular em cima da mesa de cabeceira."

# game/a1s1.rpy:521
translate pt_br a1s1_047dc754:

    # "Amicus's eyes widen once again, and again I wonder if I should be keeping my mouth shut."
    "Amicus fica de olhos arregalados mais uma vez e, novamente, me pergunto se não deveria ficar de boca fechada."

# game/a1s1.rpy:522
translate pt_br a1s1_dacff7bd:

    # "Revealing how much I know seems to be some sort of trigger for him."
    "Revelar o quanto sei parece ser algum tipo de gatilho para ele."

# game/a1s1.rpy:524
translate pt_br a1s1_ac9ae423:

    # a "\"Ah...So, have you been in space before?\""
    a "\"Ah... então, você já esteve no espaço antes?\""

# game/a1s1.rpy:525
translate pt_br a1s1_2088f2ec:

    # m "\"Um, no.\""
    m "\"Hm, não.\""

# game/a1s1.rpy:526
translate pt_br a1s1_0d90c929:

    # "I look out the window, staring at the stars."
    "Eu olho para a janela, observando as estrelas."

# game/a1s1.rpy:527
translate pt_br a1s1_c3e08507:

    # a "\"Okay...have your people ever been to space?\""
    a "\"Ok... seu povo já esteve no espaço?\""

# game/a1s1.rpy:528
translate pt_br a1s1_edee423f:

    # m "\"Uh, no, no we haven't.\""
    m "\"Ah, não, não estivemos.\""

# game/a1s1.rpy:529
translate pt_br a1s1_c05066d5:

    # a "\"Do you know what atoms are, nuclear energy, maybe?\""
    a "\"Vocês sabem o que são átomos, energia nuclear, talvez?\""

# game/a1s1.rpy:530
translate pt_br a1s1_c651d0c8:

    # m "\"No.\""
    m "\"Não.\""

# game/a1s1.rpy:531
translate pt_br a1s1_59475080:

    # com "\"Based on Nexus analysis on Earth, these statements appear to be misleading, Amicus.\""
    com "\"Com base na análise do Nexus da Terra, estas declarações parecem ser enganosas, Amicus.\""

# game/a1s1.rpy:532
translate pt_br a1s1_98066696:

    # "I glance at the ceiling again, realizing now that I've got a constant spy above me."
    "Eu olho para o teto de novo, percebendo agora que há um espião constante bem em cima de mim."

# game/a1s1.rpy:533
translate pt_br a1s1_c5ee7b6e:

    # "I look back at Amicus and we stare at each other in silence for a long moment."
    "Olho de volta para o Amicus e nós nos encaramos em silêncio por um longo tempo."

# game/a1s1.rpy:534
translate pt_br a1s1_26559216:

    # "Then I realize how absurd all of this is."
    "Então eu percebo o quão absurdo é tudo isso."

# game/a1s1.rpy:535
translate pt_br a1s1_f5a3b597:

    # m "\"What do you want with me?\""
    m "\"O que você quer comigo?\""

# game/a1s1.rpy:536
translate pt_br a1s1_96fb641a:

    # "Amicus looks away, seeming to think."
    "Amicus desvia o olhar, parecendo pensar."

# game/a1s1.rpy:538
translate pt_br a1s1_3b13900b:

    # a "\"Well, it's...it's part of a program on my planet to introduce new aliens to the Galaxias.\""
    a "\"Bem, é... é parte de um programa no meu planeta para introduzir novos alienígenas na congregação galáctica.\""

# game/a1s1.rpy:539
translate pt_br a1s1_d18dcfb8:

    # m "\"What is that?\""
    m "\"E o que é isso?\""

# game/a1s1.rpy:541
translate pt_br a1s1_e2ed25f4:

    # a "\"It's the greater galactic civilization, [mc]. It's a gradual strategy to slowly introduce Earth to the idea of other Sapients.\""
    a "\"É uma grandiosa civilização galáctica, [mc]. Você faz parte de uma estratégia gradual para introduzir lentamente a Terra à existência de outros sapientes.\""

# game/a1s1.rpy:542
translate pt_br a1s1_86b13a5c:

    # m "\"Oh...is this happening to other humans?\""
    m "\"Ah... isso tá acontecendo com outros humanos?\""

# game/a1s1.rpy:543
translate pt_br a1s1_bcc81977_1:

    # a "\"Yes.\""
    a "\"Sim.\""

# game/a1s1.rpy:544
translate pt_br a1s1_1ead6d40:

    # "I contemplate this for a moment."
    "Eu fico ponderando sobre isso por um momento."

# game/a1s1.rpy:545
translate pt_br a1s1_d543c2a0:

    # m "\"And...when you're done showing me you'll take me back?\""
    m "\"E... quando você terminar de me mostrar, vai me levar de volta?\""

# game/a1s1.rpy:546
translate pt_br a1s1_ae8abdc8:

    # "There's a momentary pause that I don't like very much."
    "Há uma pausa momentânea a qual não me passa muita segurança."

# game/a1s1.rpy:547
translate pt_br a1s1_4eb44ffd:

    # a "\"...Yes.\""
    a "\"...Sim.\""

# game/a1s1.rpy:548
translate pt_br a1s1_b50e6068:

    # "I imagine that I'd hear \"these statements appear to be misleading\" from Com right now, if he were on my side."
    "Imaginei que iria escutar \"essas alegações parecem ser enganosas\" do Com agora, se ele estivesse do meu lado."

# game/a1s1.rpy:549
translate pt_br a1s1_c759c599:

    # "I look into my cup of brown sludge again."
    "Eu olho para a minha caneca de lodo marrom outra vez."

# game/a1s1.rpy:550
translate pt_br a1s1_2d777753:

    # m "\"Well, to be honest I'm not all that interested. So could you just take me back...now?\""
    m "\"Olha, pra ser honesto, eu não tô tão interessado. Então você podia só... me levar de volta... agora?\""

# game/a1s1.rpy:552
translate pt_br a1s1_594096e1:

    # "Amicus stares at me."
    "Amicus lança um olhar fixo em mim."

# game/a1s1.rpy:553
translate pt_br a1s1_b5dc73e5:

    # m "\"I've got school and...and a family...they don't know where I am right now.\""
    m "\"Eu tenho faculdade e... e uma família... eles não sabem onde eu tô agora.\""

# game/a1s1.rpy:555
translate pt_br a1s1_47f76efe:

    # a "\"Wh—uh—I, I mean, don't you want to see the galaxy? I really think that it would be amazing for someone like you that hasn't seen it before.\""
    a "\"O qu—É—Eu, digo, você não quer ver a galáxia? Eu realmente acho que seria incrível para alguém como você que nunca viu antes.\""

# game/a1s1.rpy:556
translate pt_br a1s1_a10d5c8a:

    # "The wolf starts fidgeting with his paws, not looking at me, choosing to stare out the windows."
    "O lobo começa a dedilhar desatentamente, sem olhar para mim, escolhendo olhar na direção da janela."

# game/a1s1.rpy:557
translate pt_br a1s1_4bae6b94:

    # "He isn't wrong."
    "Ele não está errado."

# game/a1s1.rpy:558
translate pt_br a1s1_b60f3d48:

    # "It would be pretty cool to see the galaxy, but not with someone like him who kidnapped me, taking me somewhere for a reason that he isn't telling me."
    "Seria muito legal ver a galáxia, mas não com alguém como ele que me sequestrou, me levando para algum lugar por um motivo que não está me contando."

# game/a1s1.rpy:559
translate pt_br a1s1_bb1aa492:

    # m "\"No, no I actually want to go home right now.\""
    m "\"Não, não, na verdade, eu quero ir pra casa agora.\""

# game/a1s1.rpy:560
translate pt_br a1s1_762e3985:

    # "Amicus stares at me for a full ten seconds before looking away."
    "Amicus me encara por um total de dez segundos antes de desviar o olhar."

# game/a1s1.rpy:562
translate pt_br a1s1_0d413744:

    # a "\"How about we wait until we get to my home then we can discuss it?\""
    a "\"Que tal esperar até chegarmos na minha casa e lá nós discutimos sobre isso?\""

# game/a1s1.rpy:563
translate pt_br a1s1_7daae42b:

    # m "\"No. Take me back.\""
    m "\"Não. Me leva de volta.\""

# game/a1s1.rpy:564
translate pt_br a1s1_42720994:

    # "I feel my heart hammering in my chest as I start to realize that this alien is definitely not going to take me back."
    "Sinto meu coração martelar no meu peito à medida que começo a perceber que esse alienígena definitivamente não vai me levar de volta."

# game/a1s1.rpy:566
translate pt_br a1s1_b3660930:

    # "I stand up and Amicus flinches and brings his paws up to his chest, as if I'm going to attack him."
    "Eu levanto e o Amicus se encolhe, levando as patas ao peito como se eu fosse atacá-lo."

# game/a1s1.rpy:568
translate pt_br a1s1_f8f0cd8e:

    # "We stay like that for a moment."
    "Nós ficamos assim por um tempo."

# game/a1s1.rpy:569
translate pt_br a1s1_5f8a45ea:

    # "I'm breathing hard, staring down at the wolf while Amicus stares back up at me, wide-eyed."
    "Eu respiro com dificuldade, encarando o lobo enquanto Amicus olha para mim com os olhos arregalados."

# game/a1s1.rpy:570
translate pt_br a1s1_c09f5fab:

    # "Finally, Amicus lets out a big sigh, looking back out the window."
    "Finalmente, Amicus solta um grande suspiro, olhando de volta para a janela."

# game/a1s1.rpy:572
translate pt_br a1s1_a8c26014:

    # a "\"Okay, I'm going to take you back. I'm sorry.\""
    a "\"Ok, eu vou te levar de volta. Me desculpe.\""

# game/a1s1.rpy:573
translate pt_br a1s1_7a4687bc:

    # "I watch him for a moment, looking for signs of sincerity, but he still won't look at me."
    "Eu o observo por um momento, procurando por sinais de sinceridade, mas ele se recusa a olhar para mim."

# game/a1s1.rpy:574
translate pt_br a1s1_0b4eb0fa:

    # m "\"Really?\""
    m "\"Sério?\""

# game/a1s1.rpy:575
translate pt_br a1s1_1f433de6:

    # a "\"Yes...but it's complicated. We're, uh, on a trajectory for Adastra. It'll take time for us to turn around.\""
    a "\"Sim... mas, é complicado. Nós, hã... estamos na trajetória para Adastra. Vai levar tempo até eu conseguir dar a volta.\""

# game/a1s1.rpy:576
translate pt_br a1s1_faeab43b:

    # "I keep watching him, not sure what to do."
    "Eu continuo o observando, sem saber o que fazer."

# game/a1s1.rpy:577
translate pt_br a1s1_23bbffc2:

    # "I feel like he's lying, but if he is there's really nothing I can do about it."
    "Eu sinto que ele está mentindo e, se realmente estiver, não poderei fazer nada sobre isso."

# game/a1s1.rpy:578
translate pt_br a1s1_40d8d1c1:

    # "I'm stuck here with him, probably millions of miles from Earth, with no way of knowing how to get back."
    "Estou preso aqui com ele, provavelmente a milhares de quilômetros da Terra, sem nenhuma forma de saber como voltar."

# game/a1s1.rpy:579
translate pt_br a1s1_7da27250:

    # "So I just stand there, arms folded tightly against my chest, staring out the window, too."
    "Então eu só fico lá com os braços cruzados firmemente contra o peito, também olhando para a janela."

# game/a1s1.rpy:580
translate pt_br a1s1_f617df9b:

    # "That's when I see a star brighter than all of the others, almost too bright to look at."
    "É nesse momento que percebo uma estrela brilhando mais do que todas as outras, quase brilhante demais para ficar olhando."

# game/a1s1.rpy:581
translate pt_br a1s1_f23bde36:

    # m "\"Is that the sun?\""
    m "\"Aquilo é o sol?\""

# game/a1s1.rpy:582
translate pt_br a1s1_66a01596:

    # a "\"The what?\""
    a "\"Como?\""

# game/a1s1.rpy:583
translate pt_br a1s1_8418c46f:

    # m "\"Is that my star? My planet's star.\""
    m "\"É a minha estrela? A estrela do meu planeta.\""

# game/a1s1.rpy:584
translate pt_br a1s1_8b5fc7d5:

    # "Amicus squints in the direction I'm looking in."
    "Amicus aperta os olhos na direção a qual estou olhando."

# game/a1s1.rpy:586
translate pt_br a1s1_a2889e7f:

    # a "\"Oh...Oh, yeah! Yeah, that's your star...I can't remember the name we have for it. It's a bunch of numbers.\""
    a "\"Ah... Ah, sim! Sim, essa é sua estrela... não consigo lembrar o nome que demos a ela. É um monte de números.\""

# game/a1s1.rpy:587
translate pt_br a1s1_6358c0bf:

    # m "\"How far away are we?\""
    m "\"Quão longe a gente tá?\""

# game/a1s1.rpy:589
translate pt_br a1s1_e5c37924:

    # a "\"Not far. We could get back there in no time.\""
    a "\"Não muito. Poderíamos voltar para lá em pouco tempo.\""

# game/a1s1.rpy:590
translate pt_br a1s1_2f21f96b:

    # "Amicus stands up next to me, seeming to stretch."
    "Amicus se levanta para perto de mim, parecendo se esticar."

# game/a1s1.rpy:592
translate pt_br a1s1_dd30b674:

    # m "\"So...are we going back?\""
    m "\"Então... a gente vai voltar?\""

# game/a1s1.rpy:593
translate pt_br a1s1_7bbd1710:

    # a "\"Yeah, yeah, just gotta do it in a way that doesn't waste too much energy. I still have to get back to Adastra after all.\""
    a "\"Sim, sim, só preciso fazer isso de um jeito que não desperdice muita energia. Ainda tenho que voltar para Adastra, afinal.\""

# game/a1s1.rpy:594
translate pt_br a1s1_b37ab19d:

    # "I stare in the direction of the Sun again, my gaze slightly averted from the piercing dot."
    "Eu olho na direção do sol mais uma vez, meu olhar ligeiramente desviado do pontinho penetrante."

# game/a1s1.rpy:595
translate pt_br a1s1_2b87c86d:

    # "How long has it been since I was kidnapped?"
    "Quanto tempo passou desde que eu fui sequestrado?"

# game/a1s1.rpy:596
translate pt_br a1s1_11b65f7b:

    # "I wonder if my friends have alerted the school, or even the authorities."
    "Eu me pergunto se meus amigos avisaram a faculdade, ou mesmo as autoridades."

# game/a1s1.rpy:597
translate pt_br a1s1_92830ed6:

    # "How am I going to explain this?"
    "Como eu vou explicar isso?"

# game/a1s1.rpy:598
translate pt_br a1s1_7a0cd758:

    # "There's a movement to my right and just as I'm turning to look, something cold presses into the side of my neck."
    "Há um movimento à minha direita que, assim que me viro para olhar, algo gelado pressiona contra a lateral do meu pescoço."

# game/a1s1.rpy:599
translate pt_br a1s1_647ea463:

    # "A familiar sensation of my muscles tightening up makes me slam back into the seat."
    "A familiar sensação dos meus músculos contraindo me fazem cair de novo no assento."

# game/a1s1.rpy:600
translate pt_br a1s1_2ea99556:

    # "At the same time my mind seems to wipe clean...empty."
    "Ao mesmo tempo minha mente parece limpa... vazia."

# game/a1s1.rpy:601
translate pt_br a1s1_d377dc01:

    # "Suddenly I'm surrounded by soft and warm gray fur."
    "De repente me vejo cercado por pelo cinza, suave e quente."

# game/a1s1.rpy:602
translate pt_br a1s1_b3271f6c:

    # "I feel like a limp blanket as I'm flopped around, my muscles like jelly."
    "Me sinto como um cobertor mole conforme sou carregado, meus músculos parecem geleia."

# game/a1s1.rpy:603
translate pt_br a1s1_edc4567c:

    # "It's not a bad feeling, in fact I kinda feel great."
    "Não é uma sensação ruim... na verdade, meio que me sinto ótimo."

# game/a1s1.rpy:604
translate pt_br a1s1_7e971bed:

    # "I would smile if my facial muscles were working."
    "Eu sorriria se meus músculos faciais estivessem funcionando."

# game/a1s1.rpy:605
translate pt_br a1s1_29b03dcb:

    # "I'm laid on the ground and then my arms are pushed behind me."
    "Sou deitado no chão e, em seguida, meus braços são puxados para trás de mim."

# game/a1s1.rpy:606
translate pt_br a1s1_b0c2122b:

    # "Something starts to wind around my wrists."
    "Algo começa a enrolar nos meus pulsos."

# game/a1s1.rpy:607
translate pt_br a1s1_d4ebc398:

    # com "\"Still detecting consciousness from the human. Insufficient charge used.\""
    com "\"Ainda detectando consciência no humano. Carga insuficiente utilizada.\""

# game/a1s1.rpy:608
translate pt_br a1s1_3b3358d1:

    # a "\"I used it on the lowest setting. I think I hit him with too much last time. Looks like he's mostly out anyway, though.\""
    a "\"Eu usei na configuração mínima. Acho que o atingi com muita força da última vez. Ele parece bem ausente para mim agora, de qualquer forma.\""

# game/a1s1.rpy:609
translate pt_br a1s1_9ede3f11:

    # "I hear ragged breathing in my ear as my arms are jerked around."
    "Eu ouço uma respiração irregular no meu ouvido enquanto meus braços são puxados."

# game/a1s1.rpy:610
translate pt_br a1s1_c0c447f0:

    # a "\"Dammit! He's more sapient than any child I've known!\""
    a "\"Droga! Ele é mais sapiente do que qualquer {i}infante{/i} que eu já conheci!\""

# game/a1s1.rpy:611
translate pt_br a1s1_b5be8675:

    # com "\"Sensing distress. Would you like a stress tablet Amicus?\""
    com "\"Identificando angústia. Gostaria de um calmante, Amicus?\""

# game/a1s1.rpy:612
translate pt_br a1s1_b83d63f0:

    # a "\"Maybe even as intelligent as a Wolf...Well, almost. If they've been to space then they're far past level five.\""
    a "\"Talvez até tão inteligente quanto um lobo... bem, quase. Se eles já estiveram no espaço, então com certeza já estão bem longe do nível cinco.\""

# game/a1s1.rpy:613
translate pt_br a1s1_eb0264fc:

    # "I try to open my eyes but the eyelids are too heavy to lift."
    "Eu tento abrir meus olhos, mas as pálpebras estão muito pesadas para levantar."

# game/a1s1.rpy:614
translate pt_br a1s1_979b3334:

    # a "\"Maybe level ten?\""
    a "\"Talvez nível dez?\""

# game/a1s1.rpy:615
translate pt_br a1s1_83d8c327:

    # "My brain isn't really working either."
    "Meu cérebro também não está realmente funcionando."

# game/a1s1.rpy:616
translate pt_br a1s1_56b2818a:

    # "I can't seem to focus."
    "Eu não consigo focar."

# game/a1s1.rpy:617
translate pt_br a1s1_28de12eb:

    # "Padded footsteps move around my head."
    "Passos alcochoados se movem ao redor da minha cabeça."

# game/a1s1.rpy:620
translate pt_br a1s1_2f8c7d04:

    # "Then I hear what sounds like an alarm, followed by something I can't really explain..."
    "Então, escuto o que soa como um alarme seguido de algo que realmente não consigo explicar..."

# game/a1s1.rpy:621
translate pt_br a1s1_bff90061:

    # "My mind startles as that deep voice starts up again."
    "Minha mente se assusta quando aquela profunda voz pode ser ouvida outra vez."

# game/a1s1.rpy:622
translate pt_br a1s1_9d5bb6ba:

    # a "\"What do I do now? I've messed this up about as badly as I could have.\""
    a "\"O que eu faço agora? Consegui a proeza de estragar tudo o máximo possível.\""

# game/a1s1.rpy:623
translate pt_br a1s1_a20cefa7_8:

    # "..."
    "..."

# game/a1s1.rpy:624
translate pt_br a1s1_f066ccfb:

    # a "\"Solutions, Com?\""
    a "\"Soluções, Com?\""

# game/a1s1.rpy:625
translate pt_br a1s1_65b6956e:

    # com "\"Solutions: Consider returning the human back to Earth. If no evidence is left behind it is unlikely his statements would be believed.\""
    com "\"Soluções: Considere retornar o humano à Terra. Se nenhuma evidência for deixada para trás, é improvável que suas alegações sejam levadas a sério.\""

# game/a1s1.rpy:626
translate pt_br a1s1_b0ab74af:

    # a "\"...Uh, too late for that since I just activated the Stretch Drive.\""
    a "\"...Hã, tarde demais para isso já que eu acabei de ativar a dobra espacial.\""

# game/a1s1.rpy:627
translate pt_br a1s1_e96ce7c7:

    # com "\"Yes, that was inadvisable.\""
    com "\"Sim, isto era desaconselhável.\""

# game/a1s1.rpy:628
translate pt_br a1s1_f0807289:

    # a "\"Yeah, well, I don't know how advanced his species is. If he was being misleading then that means they're space-faring. They could have patrols in their star system.\""
    a "\"É, mas eu também não sei o quão avançada é a espécie dele. Se ele estava mentindo, então isso pode significar que eles já viajam pelo espaço. Poderiam ter patrulhas no sistema estelar deles.\""

# game/a1s1.rpy:629
translate pt_br a1s1_6e20bf3e:

    # a "\"I wanted to get out as soon as possible...You know you could have offered the solution before I did that.\""
    a "\"Eu só preciso ir embora o mais rápido possível... Você bem que poderia ter citado essa solução antes de eu ativar a dobra.\""

# game/a1s1.rpy:630
translate pt_br a1s1_9d17ba6e:

    # com "\"You've set me to minimal interruptions.\""
    com "\"Você me colocou no modo de interrupções reduzidas.\""

# game/a1s1.rpy:631
translate pt_br a1s1_4b9d9830:

    # a "\"Next solution.\""
    a "\"Próxima solução.\""

# game/a1s1.rpy:632
translate pt_br a1s1_770172aa:

    # com "\"Consider termination of the human and incineration of the remains through the radiation of the Stretch Drive—\""
    com "\"Considere a execução do humano e a incineração dos restos mortais através da radiação da dobra espacial.—\""

# game/a1s1.rpy:633
translate pt_br a1s1_a7afb2bf:

    # a "\"{i}Edapol! {/i}No! Next solution.\""
    a "\"{i}Edapol!{/i} De jeito nenhum! Próxima solução.\""

# game/a1s1.rpy:634
translate pt_br a1s1_69dd9dd2:

    # com "\"Consider taking the human to Adastra and use him as your pet as you originally planned.\""
    com "\"Considere levar o humano para Adastra e usá-lo como seu mascote, assim como originalmente planejou.\""

# game/a1s1.rpy:635
translate pt_br a1s1_1db081d4:

    # com "\"From there you may pass him off as less sapient. It is unlikely you will be questioned.\""
    com "\"Lá, você precisa passar a impressão de que ele não é inteligente. Desta forma, pode evitar perguntas.\""

# game/a1s1.rpy:636
translate pt_br a1s1_a20cefa7_9:

    # "..."
    "..."

# game/a1s1.rpy:637
translate pt_br a1s1_6359f6b8:

    # a "\"I don't know. He already despises me and after what I just did...\""
    a "\"Eu não sei. Ele já me despreza, e agora depois do que eu acabei de fazer...\""

# game/a1s1.rpy:638
translate pt_br a1s1_84de36c4:

    # com "\"Amicus, alternative solutions point to a higher likelihood that the Monitors will be alerted to your actions.\""
    com "\"Amicus, soluções alternativas apontam para uma grande probabilidade dos monitores serem alertados sobre suas ações.\""

# game/a1s1.rpy:639
translate pt_br a1s1_a20cefa7_10:

    # "..."
    "..."

# game/a1s1.rpy:640
translate pt_br a1s1_b378af8d:

    # com "\"Proceed with caution.\""
    com "\"Prossiga com cautela.\""

# game/a1s1.rpy:641
translate pt_br a1s1_5fe437de:

    # a "\"Com, please wipe the last ten minutes of conversation...then go into sleep mode until I wake you. I need to think.\""
    a "\"Com, por favor, apague os últimos dez minutos de conversa... depois entre no modo de suspensão até que eu o ative novamente. Eu preciso pensar.\""

# game/a1s1.rpy:642
translate pt_br a1s1_beb8c686:

    # com "\"Wiping memory. Entering sleep mode.\""
    com "\"Apagando dados. Entrando em modo de suspensão.\""

# game/a1s1.rpy:643
translate pt_br a1s1_9683989d:

    # "A few more moments of silence go by and I feel a wave of fatigue."
    "Alguns momentos de silêncio se passam e eu sinto uma onda de cansaço."

# game/a1s1.rpy:644
translate pt_br a1s1_519e54d3:

    # "I start to fall asleep."
    "Eu começo a pegar no sono."

# game/a1s1.rpy:645
translate pt_br a1s1_9caf9af4:

    # "The padded footsteps move closer to me and I feel a presence looming."
    "Os passos acolchoados se aproximam de mim e eu sinto uma presença iminente."

# game/a1s1.rpy:646
translate pt_br a1s1_5684fecb:

    # "Then something heavy and soft rests on my forearm."
    "Então algo pesado e macio repousa sobre meu antebraço."

# game/a1s1.rpy:647
translate pt_br a1s1_8a44d64c:

    # a "\"I'm sorry...This was a mistake.\""
    a "\"Eu sinto muito... isso foi um erro.\""

# game/a1s1.rpy:648
translate pt_br a1s1_87b70147:

    # "Then I'm dragged for a short while before I come to rest on something shaggy and soft."
    "Então eu sou arrastado por um breve momento antes de ser deixado em algo desgrenhado e macio."

# game/a1s1.rpy:649
translate pt_br a1s1_e765c4d6:

    # "Then silence...."
    "E então, silêncio...."

# game/a1s1.rpy:650
translate pt_br a1s1_be52cd10:

    # "Then sleep..."
    "Um sono profundo..."

# game/a1s1.rpy:655
translate pt_br a1s1_af4532e8:

    # "I float in a void of nothingness."
    "Eu flutuo em um vazio de absoluto nada."

# game/a1s1.rpy:656
translate pt_br a1s1_22cb48e2:

    # "Not even blackness...nothingness."
    "Não há sequer escuridão... apenas o nada."

# game/a1s1.rpy:657
translate pt_br a1s1_e84417a1:

    # "The feeling of having no sense of self, the boundaries of my being having no boundaries..."
    "A sensação de perder o ego, os limites do meu ser não mais possuindo limites..."

# game/a1s1.rpy:658
translate pt_br a1s1_60c108bb:

    # "It makes me panic."
    "Isso me faz entrar em pânico."

# game/a1s1.rpy:659
translate pt_br a1s1_a97e4f67:

    # "I'm still here, but nothing else exists."
    "Ainda estou aqui, mas nada mais existe."

# game/a1s1.rpy:660
translate pt_br a1s1_36dfb867:

    # "Am I all there is?"
    "Eu sou tudo o que há?"

# game/a1s1.rpy:661
translate pt_br a1s1_0242aa20:

    # "I feel the borders of my sanity start to bend and break."
    "Sinto as bordas da minha sanidade começarem a se contorcer e quebrar."

# game/a1s1.rpy:662
translate pt_br a1s1_80384914:

    # "It only lasts a moment before something massive and all-encompassing grabs hold of me."
    "Dura apenas um breve momento antes de algo enorme e abrangente me segurar."

# game/a1s1.rpy:663
translate pt_br a1s1_d3cfade7:

    # "Instantly I'm comforted, calmed by a sense of complete security."
    "Instantaneamente, me sinto confortado, acalmado por uma completa sensação de segurança."

# game/a1s1.rpy:664
translate pt_br a1s1_3a72158c:

    # "\"All is as it should be...\""
    "\"Tudo está como deveria estar...\""

# game/a1s1.rpy:669
translate pt_br a1s1_3b6ab3ad:

    # "I crack my eyes open to a gray ceiling, the familiar hum of the ship in my ears."
    "Eu arregalo os olhos e me deparo com um teto cinza, a nave emite o familiar ruído nos meus ouvidos."

# game/a1s1.rpy:670
translate pt_br a1s1_adc8153d:

    # "My back aches as I feel my hands bunched up underneath me, making me arch uncomfortably."
    "Minhas costas doem e sinto minhas mãos amarradas embaixo de mim, causando um arqueamento desconfortável."

# game/a1s1.rpy:671
translate pt_br a1s1_d65aa1ab:

    # "The numbness isn't there like last time."
    "A sensação de entorpecimento não está lá como da última vez."

# game/a1s1.rpy:672
translate pt_br a1s1_e3cf1733:

    # "Instead it just feels like I woke up from a deep sleep."
    "Em vez disso, apenas parece que acordei depois de um sono profundo."

# game/a1s1.rpy:673
translate pt_br a1s1_f9acd018:

    # "I can tell I'm back in the utility closet laying on the shag rug, but the door is open, allowing me to actually see."
    "Consigo identificar que estou de volta ao armário, deitado no tapete felpudo. Mas agora a porta foi deixada entreaberta, tornando possível ver melhor."

# game/a1s1.rpy:674
translate pt_br a1s1_04820179:

    # "Slowly, I turn my head just a bit and I'm able to vaguely make out the small deck that I'd just been in."
    "Lentamente, viro minha cabeça um pouco e sou capaz de identificar o pequeno convés no qual estava antes."

# game/a1s1.rpy:675
translate pt_br a1s1_082f61b0:

    # "I see Amicus to the far right, both his paws resting on the counter with the food dispenser, looking down at a panel."
    "Vejo o Amicus no canto direito, as duas patas descansando no balcão da máquina de comida, olhando para um painel abaixo."

# game/a1s1.rpy:676
translate pt_br a1s1_ca0a79ee:

    # "He's got his back to me at an angle, one foot crossed behind the other, his tail swishing back and forth while he mumbles to himself."
    "Ele está de costas para mim em um certo ângulo, pernas cruzadas e seu rabo balançando de um lado para o outro enquanto ele murmura algo para si mesmo."

# game/a1s1.rpy:677
translate pt_br a1s1_92dd477f:

    # "As slowly as I can, I turn over onto my side, trying not to let out a groan of relief as my back and hands are relieved of pressure."
    "Tão lentamente quanto consigo, me viro de lado, tentando não soltar um grunhido de alívio quando minhas costas e mãos são liberadas da pressão do meu peso."

# game/a1s1.rpy:678
translate pt_br a1s1_3cfc9d0c:

    # "I grimace through the pain of having blood rush back into my fingers."
    "Acabo fazendo uma careta com a sensação dolorosa do sangue correndo de volta para os meus dedos."

# game/a1s1.rpy:679
translate pt_br a1s1_b2fce196:

    # "That's when I realize that my hands are tied at the wrists behind my back with a cord of some kind."
    "É aí que percebo que minhas mãos foram amarradas nos pulsos e atrás das minhas costas com algum tipo de corda."

# game/a1s1.rpy:680
translate pt_br a1s1_c41ac249:

    # "The ends of it dangle through my fingers and it feels smooth and metallic."
    "Posso sentir as extremidades da corda nos meus dedos e ela possui uma textura macia e metálica ao mesmo tempo."

# game/a1s1.rpy:681
translate pt_br a1s1_35e07eeb:

    # "Some slow movements with my hands tells me immediately that they haven't been tied well."
    "Alguns lentos movimentos com minhas mãos me fazem perceber imediatamente que elas não foram bem amarradas."

# game/a1s1.rpy:682
translate pt_br a1s1_3fe34707:

    # "My left hand is fairly secure, but the loop around my right is loose."
    "A minha mão esquerda se encontra firme e apertada, mas o laço em volta da mão direita está meio solto."

# game/a1s1.rpy:683
translate pt_br a1s1_f12e3d58:

    # "I get the feeling that if I pull hard enough, I might be able to slip it—"
    "Tenho a sensação de que se eu puxar o suficiente, pode ser que ela se solte—"

# game/a1s1.rpy:684
translate pt_br a1s1_ffb8948f:

    # "And just like that it comes out."
    "E exatamente assim consigo me soltar."

# game/a1s1.rpy:685
translate pt_br a1s1_95e75613:

    # "My shoulder jerks when I do it and I freeze, waiting to see if Amicus might notice."
    "Meu ombro estremece quando faço isso e tenho calafrios com a possibilidade do Amicus me notar."

# game/a1s1.rpy:686
translate pt_br a1s1_d2661139:

    # "He goes on staring down at the panel, leaning forward to rest his chin on a fist."
    "Ele continua encarando o painel, inclinado para frente, repousando o queixo em um dos punhos."

# game/a1s1.rpy:687
translate pt_br a1s1_07d78f36:

    # a "\"Cassius is probably going to figure it out right away. I know it.\""
    a "\"Cassius provavelmente vai descobrir logo de cara. Eu tenho certeza.\""

# game/a1s1.rpy:688
translate pt_br a1s1_2306b59a:

    # "Amicus sighs and hunches over further."
    "Amicus suspira e se encolhe um pouco mais."

# game/a1s1.rpy:689
translate pt_br a1s1_9590e57c:

    # "I let out the breath I'm holding as quietly as I can before I start looking around, moving my head as little as possible."
    "Eu solto a respiração que estava segurando da forma mais lenta e silenciosa que consigo antes de começar a olhar em volta, movendo minha cabeça o mínimo possível."

# game/a1s1.rpy:690
translate pt_br a1s1_9ebb5349:

    # "On the shelves are a variety of different objects that I can't identify."
    "Nas prateleiras, consigo enxergar uma variedade de objetos diferentes que não consigo identificar."

# game/a1s1.rpy:691
translate pt_br a1s1_d6144df5:

    # "They all have a heavy, industrial look to them and I know that I could use any of them as a weapon."
    "Todos eles possuem uma aparência industrial e pesada, eu poderia usar qualquer um deles como arma."

# game/a1s1.rpy:692
translate pt_br a1s1_96f64e4f:

    # "There's a long, pipe-like object at the end of the bottom shelf and I imagine hefting that in both hands, bringing the end of it down on the top of that stupid wolf's—"
    "Há um objeto no final da prateleira inferior que se parece com um cano e eu me imagino segurando essa coisa com as duas mãos, batendo com uma das extremidades bem na cabeça desse lobo estú—"

# game/a1s1.rpy:693
translate pt_br a1s1_e03e911f:

    # "Amicus suddenly straightens up and I stiffen, closing my eyes."
    "Amicus de repente corrige a postura e eu congelo, fechando meus olhos."

# game/a1s1.rpy:695
translate pt_br a1s1_afa08184:

    # "I hear the wolf move, padding in my direction."
    "Ouço o lobo se mexer, caminhando na minha direção."

# game/a1s1.rpy:696
translate pt_br a1s1_9c2c94b7:

    # "That continues until there's a pause and I can feel his presence standing in the doorway."
    "Isso continua até ter uma pausa e eu consigo sentir a presença dele parado atrás da porta."

# game/a1s1.rpy:697
translate pt_br a1s1_dad04d86:

    # "I crack open an eye, just a tiny bit to see what he might be doing."
    "Eu abro ligeiramente um dos meus olhos, só para observar um pouco seja lá o que ele esteja fazendo."

# game/a1s1.rpy:698
translate pt_br a1s1_fd0775d1:

    # "I get a vague image of him standing over me, looking down."
    "Enxergo uma vaga imagem dele em pé na minha frente, olhando para baixo."

# game/a1s1.rpy:699
translate pt_br a1s1_fa90945b:

    # a "\"Hello? Uh, human? [mc]?\""
    a "\"Olá? É... humano? [mc]?\""

# game/a1s1.rpy:700
translate pt_br a1s1_f4b1201a:

    # "I don't move and I breathe as evenly as I can."
    "Eu não me mexo e tento respirar da forma mais normal que consigo."

# game/a1s1.rpy:701
translate pt_br a1s1_ea4eb6bf:

    # a "\"Hello?\""
    a "\"Olá?\""

# game/a1s1.rpy:702
translate pt_br a1s1_5ca5b8e6:

    # "He must know I'm awake; I can feel myself shaking from all the tension."
    "Ele deve saber que eu estou acordado. Posso sentir meu corpo estremecendo por causa da tensão."

# game/a1s1.rpy:703
translate pt_br a1s1_b862337b:

    # a "\"Dammit...\""
    a "\"Merda...\""

# game/a1s1.rpy:704
translate pt_br a1s1_04afa751:

    # "Amicus mumbles to himself as he turns away, moving back towards the deck."
    "Amicus murmura para si mesmo enquanto se vira, movendo-se de volta em direção ao convés."

# game/a1s1.rpy:706
translate pt_br a1s1_c26fdbfc:

    # "That's when I realize that this might be my best chance to make my move."
    "É quando eu percebo que talvez essa pode ser a melhor chance que eu tenho de fazer alguma coisa."

# game/a1s1.rpy:707
translate pt_br a1s1_d75d5f2c:

    # "He's not going to take me back."
    "Ele não vai me levar de volta para casa."

# game/a1s1.rpy:708
translate pt_br a1s1_4dffe11b:

    # "He's knocked me out twice and that's reason enough to do what I'm about to do."
    "Ele já me neutralizou duas vezes e isso é razão o suficiente para fazer o que eu estou prestes a fazer."

# game/a1s1.rpy:709
translate pt_br a1s1_4c26b911:

    # "As quietly as I can, I roll over and reach out for the metal pipe."
    "O mais silenciosamente possível, rolo até as prateleiras e alcanço o cano de metal."

# game/a1s1.rpy:710
translate pt_br a1s1_e1ba0061:

    # "By some miracle I manage not to clang it against the metal rack it's on."
    "Por algum milagre divino eu consigo não batê-lo contra a prateleira, que também é de metal, evitando barulhos."

# game/a1s1.rpy:711
translate pt_br a1s1_79ce504e:

    # "Quietly, I bring it up in both hands as I stand."
    "Silenciosamente, o seguro com as duas mãos e fico de pé."

# game/a1s1.rpy:712
translate pt_br a1s1_0ccb14a2:

    # "It's heavy, a lot heavier than I expected, but I can manage it."
    "É bem pesado, muito mais pesado do que eu achei que seria, mas consigo carregar."

# game/a1s1.rpy:713
translate pt_br a1s1_df41eb16:

    # "I focus on the retreating wolf's back and move at a half-run, my bare feet allowing me to quietly pad toward him."
    "Eu foco em ir até as costas do lobo e me movo em uma meia corrida, meus pés descalços me possibilitando pisar no chão sem fazer muito barulho em sua direção."

# game/a1s1.rpy:714
translate pt_br a1s1_3eea3b93:

    # "Despite that, I see his ears come up at the last second, his body starting to shift in a way that tells me he's about to turn around."
    "Apesar disso, noto as orelhas dele subindo no último segundo, o corpo dele começando a se mover de um jeito que me diz que ele está prestes a se virar."

# game/a1s1.rpy:715
translate pt_br a1s1_1fbcb7e8:

    # "And I swing."
    "E então eu ataco."

# game/a1s1.rpy:716
translate pt_br a1s1_07f83414:

    # "What happens next is something that I can't explain."
    "O que acontece em seguida é algo que eu não consigo explicar."

# game/a1s1.rpy:717
translate pt_br a1s1_e11232a2:

    # "I aim for his head, wanting to cause as much damage as possible, not really thinking about the consequences of what might happen if I seriously injure, or even kill him."
    "Eu miro na cabeça, tentando causar o máximo de dano possível, sem pensar muito nas consequências do que pode acontecer se eu machucá-lo gravemente, ou até matá-lo."

# game/a1s1.rpy:718
translate pt_br a1s1_1e68a446:

    # "But for some inexplicable reason, the trajectory of my swing suddenly dips down, as if caused by some invisible magnet, making me miss Amicus's head."
    "Mas, por alguma razão inexplicável, a trajetória das minhas mãos de repente desvia um pouco, como se algum imã invisível estivesse puxando, me fazendo errar a cabeça do Amicus."

# game/a1s1.rpy:719
translate pt_br a1s1_1a3b3c7e:

    # "The strange force doesn't lessen the power of my swing though, and it carries through to land with a hard, meaty thump into the side of the wolf's thick neck."
    "Porém, o estranho desvio não diminuiu a força do impacto e o cano continua até aterrissar com uma pancada forte ao lado do pescoço carnudo do lobo."

# game/a1s1.rpy:722
translate pt_br a1s1_c55b5547:

    # a "\"AAAGH!\""
    a "\"AAAGH!\""

# game/a1s1.rpy:725
translate pt_br a1s1_220f1ecb:

    # "Amicus cringes, both paws moving to cover the back and side of his neck, dropping into a crouch."
    "Amicus se contorce, as duas patas se movendo até cobrir a parte de trás e a lateral do pescoço, ele se agacha um pouco."

# game/a1s1.rpy:726
translate pt_br a1s1_e12b7851:

    # "He looks back at me, his eyes wide and wild, an expression that sends a shot of fear into my body."
    "Ele olha para trás e me vê, seus olhos arregalados e selvagens, uma expressão que espalha uma onda de medo pelo meu corpo."

# game/a1s1.rpy:727
translate pt_br a1s1_41594fa7:

    # "I suddenly see him as a wild animal; a wild, scared, and very angry animal."
    "De repente eu o enxergo como um animal selvagem; confuso, assustado, e com muita raiva."

# game/a1s1.rpy:728
translate pt_br a1s1_33f5552a:

    # "I raise the pipe again, over my head to bring down on the head I'd just missed."
    "Eu levanto o cano outra vez acima da minha cabeça com o objetivo de bater na que acabei de errar."

# game/a1s1.rpy:729
translate pt_br a1s1_7acd7c83:

    # "But Amicus is fast."
    "Mas o Amicus é mais rápido."

# game/a1s1.rpy:731
translate pt_br a1s1_82b5acdc:

    # "He leaps up from the crouch, in an upward and forward motion straight into my chest."
    "Ele pula do agachamento em um movimento para cima e em frente direto no meu peito."

# game/a1s1.rpy:734
translate pt_br a1s1_1477c2fa:

    # "I wheeze, but manage to stay on my feet as the wolf carries me backward to slam against the wall of the deck."
    "Eu solto um chiado, mas consigo ficar de pé conforme o lobo me carrega para trás, visando me bater contra a parede do convés."

# game/a1s1.rpy:735
translate pt_br a1s1_5a041a38:

    # "Amicus snarls into my face, teeth bared, one eye wincing shut."
    "Amicus rosna na minha cara, os dentes à mostra e um olho se fechando."

# game/a1s1.rpy:736
translate pt_br a1s1_2a6c6991:

    # "I struggle but there's no way; he handles me like a rag doll, like a toy."
    "Eu me esforço para soltar, mas não tem jeito; ele me segura como se eu fosse um mero boneco de pano, um brinquedo."

# game/a1s1.rpy:737
translate pt_br a1s1_4c3fd121:

    # "This must be how someone feels during a wild animal attack, completely helpless, suddenly wondering why evolution left us so damn defenseless."
    "Deve ser assim que as pessoas se sentem durante um ataque de animal selvagem, completamente desamparadas, eu me pergunto por que a evolução nos deixou tão atrozmente indefesos."

# game/a1s1.rpy:738
translate pt_br a1s1_d9341b94:

    # a "\"What the HELL are you doing!? AGH!\""
    a "\"Mas que PORRA você está fazendo!? AGH!\""

# game/a1s1.rpy:739
translate pt_br a1s1_9fa68862:

    # "Amicus yells at me as he lets go of one of my wrists to put a paw to his neck, cringing as he does."
    "Amicus grita comigo enquanto solta um dos meus pulsos para colocar uma pata em seu pescoço, fazendo uma careta no processo."

# game/a1s1.rpy:740
translate pt_br a1s1_58892681:

    # a "\"Dammit!\""
    a "\"Francamente!\""

# game/a1s1.rpy:741
translate pt_br a1s1_fe75f468:

    # "I struggle with my freed hand, grabbing Amicus's face and trying to gouge his eyes and nose."
    "Eu luto com a minha mão livre, agarrando o rosto do Amicus e tentando amassar seus olhos e nariz."

# game/a1s1.rpy:742
translate pt_br a1s1_775d77b6:

    # "The wolf immediately lets go of his neck and grabs the pipe."
    "O lobo imediatamente solta o seu pescoço e agarra o cano."

# game/a1s1.rpy:743
translate pt_br a1s1_fb846981:

    # "He wrenches it away, but I try to hold on and almost get lifted off my feet."
    "Ele tenta soltar o cano da minha mão, mas eu seguro firme e quase tenho meus pés levantados do chão."

# game/a1s1.rpy:744
translate pt_br a1s1_51b243f1:

    # "He swings it one way, then violently in the other direction, throwing me to the floor of the deck as I lose my grip on my weapon."
    "Ele balança para um lado e depois violentamente para o outro, me jogando no chão do convés enquanto perco a firmeza no cano e ele solta da minha mão."

# game/a1s1.rpy:745
translate pt_br a1s1_f4107cda:

    # "Amicus advances on me as I lay flat on my back, staring up at him wide-eyed, realizing how big of a mistake I've made thinking I could handle a seven foot tall, muscle-bound wolf."
    "Amicus avança em mim conforme eu caio deitado de costas, encarando ele com os olhos arregalados, percebendo o grande erro que cometi em pensar que poderia lidar com um lobo musculoso de 2 metros de altura."

# game/a1s1.rpy:746
translate pt_br a1s1_fff456f7:

    # "I wonder if he's going to come at me with the pipe, but he throws it to the side."
    "Por um momento, acho que ele vai me bater com o cano, mas o joga para o lado em vez disso."

# game/a1s1.rpy:748
translate pt_br a1s1_cce65878:

    # "He starts to lean over me, still snarling."
    "Ele começa a se inclinar sobre mim, ainda rosnando."

# game/a1s1.rpy:749
translate pt_br a1s1_99b67aba:

    # a "\"You little prick! This time I'll bind you up to your shoulders, how does that sound?\""
    a "\"Seu zé ruela desgraçado! Dessa vez eu vou amarrar você até os ombros, tá feliz agora?\""

# game/a1s1.rpy:750
translate pt_br a1s1_2743c03b:

    # "He grabs up one of my arms, trying to pull me up, but I go limp."
    "Ele agarra um dos meus braços, tentando me puxar para cima, mas eu fico mole."

# game/a1s1.rpy:751
translate pt_br a1s1_af93e9d1:

    # a "\"Get UP! Otherwise I'll make you.\""
    a "\"LEVANTE-SE! Ou eu mesmo vou fazer você levantar!\""

# game/a1s1.rpy:752
translate pt_br a1s1_2f997317:

    # "He grabs my other arm."
    "Ele agarra meu outro braço."

# game/a1s1.rpy:753
translate pt_br a1s1_697276fd:

    # "That's when I notice his wide stance over me and a particular bulge between his legs."
    "É nesse momento que eu percebo a ampla posição dele sobre mim e uma peculiar protuberância entre suas pernas."

# game/a1s1.rpy:754
translate pt_br a1s1_ff041fc3:

    # "I hardly think about it; drawing back one foot I launch it as hard as I can into his crotch."
    "Sem nem pensar direito, levanto minha perna para trás e chuto com o máximo de força possível em sua virilha."

# game/a1s1.rpy:757
translate pt_br a1s1_aeb647aa:

    # "I feel a distinctly soft form get flattened under my foot as it gets trapped between the force of my kick and the substantial weight of Amicus's body."
    "Sinto uma distinta forma macia ser achatada sobre meu pé à medida que ela fica presa entre a força do meu chute e o peso substancial do corpo do Amicus."

# game/a1s1.rpy:758
translate pt_br a1s1_571ab292:

    # "If there was any doubt in my mind that this male alien would be affected any differently compared to a male human, his reaction quashed it."
    "Se eu tinha qualquer dúvida na minha cabeça de que esse alienígena seria afetado de qualquer forma diferente à de um homem humano, a reação dele esclarece."

# game/a1s1.rpy:759
translate pt_br a1s1_4c281ae3:

    # "Amicus freezes, eyes wide, hunching over me even further while his thighs snap together, trapping my foot."
    "Amicus congela, olhos arregalados, se curvando sobre mim ainda mais enquanto suas coxas se apertam uma contra a outra, prendendo o meu pé."

# game/a1s1.rpy:760
translate pt_br a1s1_8dbecf4c:

    # "We both stay frozen for an awkward length of time as I stare at what I'd just done."
    "Nós dois ficamos paralisados por um período de tempo constrangedor enquanto eu encaro o que acabei de fazer."

# game/a1s1.rpy:761
translate pt_br a1s1_c3b7dacc:

    # "And that's when I see that device hanging on his waistband, the one that he'd been using to knock me out."
    "É quando eu noto aquele dispositivo que ele usou para me desmaiar preso em seu cinto."

# game/a1s1.rpy:763
translate pt_br a1s1_5fba915e:

    # "I struggle to pull my foot free of the surprisingly tight embrace of his thighs while at the same time pulling my hands out of his now limp grasp."
    "Eu luto para tentar libertar o meu pé do aperto surpreendentemente firme que ele deu com as coxas ao mesmo tempo que tento tirar minhas mãos de suas patas, agora meio moles."

# game/a1s1.rpy:764
translate pt_br a1s1_49e943ab:

    # "I reach for his waist, grabbing the device."
    "Eu alcanço sua cintura, pegando o dispositivo."

# game/a1s1.rpy:765
translate pt_br a1s1_54fda360:

    # "Amicus, probably distracted by the unexpected nutshot, doesn't seem to notice and I finally yank my foot free."
    "Amicus, provavelmente distraído com o ataque inesperado, parece não perceber e, finalmente, consigo remover meu pé das coxas dele."

# game/a1s1.rpy:766
translate pt_br a1s1_7fafa09b:

    # "As I stumble to my feet the alien half-heartedly grabs at me and I struggle against his paws before reaching for his red cape and pulling it over his head."
    "Enquanto tropeço com meu pé, o alienígena me agarra sem entusiasmo e eu luto contra as patas dele até segurar sua capa vermelha e puxá-la sobre sua cabeça."

# game/a1s1.rpy:767
translate pt_br a1s1_dde9d034:

    # "Amicus finally stumbles back, one paw flying to his crotch, the other struggling with his cape as he stays bent over, mouth hanging open, making a weird gasping sound like he was holding his breath."
    "Amicus finalmente tropeça para trás, uma pata voando em sua virilha e a outra em sua capa enquanto ele fica curvado, sua boca aberta soltando um ganido estranho e ofegante como se ele estivesse com dificuldade para respirar."

# game/a1s1.rpy:768
translate pt_br a1s1_1b1c7a26:

    # "I look at the device in my hands, desperately trying to understand how to use it."
    "Eu olho para o dispositivo em minhas mãos, tentando desesperadamente entender como usá-lo."

# game/a1s1.rpy:769
translate pt_br a1s1_d8d7ebee:

    # "A glass panel takes up most of the face of the device, like a phone, but two metal prongs stick out one end."
    "Um painel de vidro compõe boa parte do dispositivo, como em um smartphone, mas com duas pontas grossas de metal em uma das extremidades."

# game/a1s1.rpy:770
translate pt_br a1s1_7e8b5f55:

    # "I frantically push at the screen and it comes to life, displaying a vertical bar."
    "Pressiono freneticamente a tela do dispositivo e ela ganha vida, exibindo uma barra vertical."

# game/a1s1.rpy:771
translate pt_br a1s1_cd09a14c:

    # "About a tenth of it is filled from the bottom with a light blue color."
    "Aproximadamente um décimo dela é preenchida por uma luz azul clara a partir da base."

# game/a1s1.rpy:772
translate pt_br a1s1_39f052cf:

    # "I push at it with my thumb, waiting for something to happen, for electricity to start arcing between the prongs, or something."
    "Eu pressiono com o meu polegar, esperando algo acontecer, como raios elétricos pulando entre uma ponta e outra, ou algo assim."

# game/a1s1.rpy:773
translate pt_br a1s1_e92443cf:

    # "Instead the bar fills with the slide of my thumb."
    "Em vez disso, a barra enche com o deslizar do meu polegar."

# game/a1s1.rpy:774
translate pt_br a1s1_be8eec5a:

    # "I push it all the way up until the color turns a dark violet."
    "Eu deslizo completamente até o topo, a cor se transforma em um violeta escuro."

# game/a1s1.rpy:776
translate pt_br a1s1_46741042:

    # "I hear a snarl and see Amicus finally tear the cape off before he comes at me again, one paw still over his crotch, the other reaching out for me."
    "Ouço um rosnado e vejo o Amicus finalmente arrancando a capa fora antes de caminhar na minha direção de novo, uma pata ainda na virilha e a outra tentando me alcançar."

# game/a1s1.rpy:777
translate pt_br a1s1_ed1dce34:

    # "I don't have time to think, I just duck under his approaching paw and press the prongs as hard as I can into his body."
    "Não tenho tempo para pensar, simplesmente me desvio da pata vindo na minha direção e pressiono as pontas de metal o mais forte que consigo no corpo dele."

# game/a1s1.rpy:781
translate pt_br a1s1_b14259cd:

    # "It sinks into his stomach and I hear the wolf make a {i}huff{/i} sound into my ear."
    "Elas afundam em sua barriga e eu escuto o lobo soltando um som de {i}uff{/i} próximo a meu ouvido."

# game/a1s1.rpy:782
translate pt_br a1s1_9108ee77:

    # "There's a pause as nothing seems to happen, then I press harder and squeeze the device and the result is instant."
    "Há uma pausa e nada parece acontecer, então eu pressiono com mais força, apertando o dispositivo, o resultado é instantâneo."

# game/a1s1.rpy:784
translate pt_br a1s1_84491e6b:

    # "There's no sound, but Amicus's body seizes violently, shaking as if he's having a seizure."
    "Não escuto nenhum som, mas o corpo do Amicus balança violentamente, estremecendo como se ele estivesse tendo uma convulsão."

# game/a1s1.rpy:785
translate pt_br a1s1_e9ac8279:

    # "The muscles in his stomach tense hard and push the device back out a few inches."
    "Os músculos do seu abdômen tensionam e empurram o aparelho de volta alguns centímetros."

# game/a1s1.rpy:786
translate pt_br a1s1_4058744f:

    # "I hold it there, not wanting to let up in case it isn't enough, in case he'll just recover and come at me again."
    "Eu continuo segurando pois não quero que saia na hipótese de não ser o suficiente para causar um desmaio, evitando que ele se recupere e tente me neutralizar outra vez."

# game/a1s1.rpy:787
translate pt_br a1s1_399e17e7:

    # "After a few seconds the wolf's seizing and shuddering stops on its own."
    "Depois de alguns segundos, a tremedeira do lobo para por conta própria."

# game/a1s1.rpy:788
translate pt_br a1s1_1bbe88f5:

    # "I start to pull back and get a glimpse of Amicus's face."
    "Eu começo a puxar o dispositivo para trás e ganho um vislumbre do rosto do Amicus."

# game/a1s1.rpy:789
translate pt_br a1s1_020ecd18:

    # "His muzzle hangs open, foam and drool hanging from his chin, his eyes rolling back in his head."
    "A boca dele aberta, espuma e baba penduradas no queixo e os olhos revirando para trás."

# game/a1s1.rpy:790
translate pt_br a1s1_b9306b4e:

    # "It's a scary sight, so I try to back away and Amicus comes with me, the contact with the device having been the only thing keeping him balanced."
    "É uma visão assustadora, então eu tento me afastar, mas o Amicus vem junto, o contato com o dispositivo sendo a única coisa que o mantinha em pé."

# game/a1s1.rpy:793
translate pt_br a1s1_0ac79c93:

    # "His weight takes me down and the next thing I know is that I'm flat on my back, struggling to breathe as Amicus's incredible weight crushes me into the metal deck."
    "O seu peso me empurra para baixo e depois estou completamente deitado no chão, me esforçando para respirar enquanto o incrível peso do Amicus me esmaga contra o piso de metal."

# game/a1s1.rpy:794
translate pt_br a1s1_af2c94a3:

    # "He practically envelopes me with his soft, furry body, his big head resting on my chest."
    "Ele praticamente me envelopa com seu corpo macio e peludo, sua grande cabeça repousando no meu peito."

# game/a1s1.rpy:795
translate pt_br a1s1_fa4bd332:

    # "I stare down at him, watching as his black lips and eyelids twitch, his tongue hanging out as he makes sporadic snorting sounds."
    "Eu inclino meu rosto e olho para ele, observando os espasmos em seus lábios pretos e nas pálpebras, sua língua pendurada para fora enquanto ele bufa esporadicamente."

# game/a1s1.rpy:796
translate pt_br a1s1_20d70cce:

    # "I gasp and strain as I spend the next minute working myself out from under him, grimacing as his foamy drool smears on my chest."
    "Eu suspiro e tensiono os músculos enquanto gasto o próximo minuto tentando tirar meu corpo debaixo do dele, meu rosto se contorcendo em nojo conforme a baba espumosa desliza da boca e suja minha roupa na região do peito."

# game/a1s1.rpy:797
translate pt_br a1s1_52e804e4:

    # "Finally, I manage to break free of his dead weight and crawl a few feet away, spending a few moments catching my breath."
    "Finalmente, consigo me libertar de seu peso morto e rastejo por uma pequena distância, tomando algum tempo para recuperar o fôlego."

# game/a1s1.rpy:798
translate pt_br a1s1_b7cd334b:

    # "I look back at his still-twitching form, his rump stuck slightly up in the air."
    "Eu olho para ele, seu corpo ainda trêmulo e seu traseiro levemente empinado no ar."

# game/a1s1.rpy:799
translate pt_br a1s1_10de3b99:

    # "I wonder how long I have before he wakes up."
    "Me pergunto quanto tempo eu tenho até que ele acorde."

# game/a1s1.rpy:800
translate pt_br a1s1_43a040f6:

    # "There's a long, shiny, thin cord around my left wrist and I start to work at the knot."
    "Há um longo, brilhante e fino cordão em volta do meu pulso esquerdo e eu começo a tentar desamarrá-lo."

# game/a1s1.rpy:801
translate pt_br a1s1_d447fbee:

    # "It's a strange material; smooth and metallic, yet it bends as easily as rope."
    "É um material estranho; suave e metálico, ainda assim, se dobra tão fácil quanto uma corda comum."

# game/a1s1.rpy:802
translate pt_br a1s1_66c4f01b:

    # "It's a pain in the ass getting it undone, though."
    "Em compensação, é uma baita dor de cabeça tentar desfazer esse nó."

# game/a1s1.rpy:803
translate pt_br a1s1_8714ba7d:

    # "It's like the dumb wolf just put as many knots into it as he could."
    "É como se esse lobo idiota simplesmente tentou fazer o máximo de nós que conseguiu."

# game/a1s1.rpy:804
translate pt_br a1s1_b9dbd443:

    # "He probably had no idea of what he was doing and now it makes sense why I was able to get out of it so easily."
    "Ele provavelmente não fazia ideia do que estava fazendo e agora faz sentido o porquê de eu ter conseguido me libertar tão facilmente."

# game/a1s1.rpy:805
translate pt_br a1s1_a8d0a848:

    # "While I'm undoing the mess I keep looking over at him."
    "Enquanto desfaço a bagunça, continuo olhando para ele volta e meia."

# game/a1s1.rpy:806
translate pt_br a1s1_39ecb235:

    # "The twitches and snorts are subsiding, which I'm not sure is a good thing or not."
    "Os espasmos e bufadas diminuíram, o que eu não tenho certeza se é uma coisa boa ou não."

# game/a1s1.rpy:807
translate pt_br a1s1_b2333d2b:

    # m "\"Come on...\""
    m "\"Anda...\""

# game/a1s1.rpy:808
translate pt_br a1s1_bc3ed4a0:

    # "I grunt as I finally pull the last tangle out, straightening the metal rope thing out in both my hands."
    "Eu resmungo até finalmente soltar o último fio emaranhado, endireitando a corda de metal com as duas mãos."

# game/a1s1.rpy:809
translate pt_br a1s1_a1c28065:

    # "I look between it and the knocked out wolf in front of me, giving my head a little shake."
    "Eu olho entre ela e o lobo nocauteado na minha frente, dando uma leve chacoalhada com a cabeça."

# game/a1s1.rpy:810
translate pt_br a1s1_24765329:

    # m "\"What the fuck is even happening.\""
    m "\"Mas que porra tá acontecendo nesse caralho?\""

# game/a1s1.rpy:811
translate pt_br a1s1_7ce057fa:

    # "I get to work, planting my butt on Amicus's as I pull both of his paws behind his back."
    "Eu começo a colocar o plano em prática, plantando meu traseiro na bunda do Amicus enquanto puxo suas patas atrás das costas."

# game/a1s1.rpy:812
translate pt_br a1s1_dd88d670:

    # "I have some difficulty keeping my balance as I lift his heavy arms and start winding the rope around his wrists."
    "Tenho um pouco de dificuldade em manter o equilíbrio conforme levanto os braços pesados dele e começo a enrolar a corda em volta de seus pulsos."

# game/a1s1.rpy:813
translate pt_br a1s1_507b671e:

    # "I'm not exactly an expert at tying hands behind backs either, but I feel far more confident in my work than Amicus ever should have in his own."
    "Também não sou exatamente um especialista em amarrar mãos atrás de costas, mas me sinto muito mais confiante no meu trabalho do que o Amicus deveria estar no dele."

# game/a1s1.rpy:814
translate pt_br a1s1_8858af24:

    # "I guess his carelessness makes some sort of sense considering I'm a tiny human and he's a giant canine."
    "Acho que o descuido dele faz algum sentido considerando que eu sou um humano pequeno e ele um canino gigante."

# game/a1s1.rpy:815
translate pt_br a1s1_4069dac7:

    # "He probably thought he'd just be able to toss me back in the closet if I got free."
    "Ele provavelmente achou que poderia simplesmente me jogar de volta no armário se eu fugisse de novo."

# game/a1s1.rpy:816
translate pt_br a1s1_f6e11450:

    # "I look over my work, somewhat satisfied with how neat and tight the binding is."
    "Eu afasto meu rosto e contemplo minha façanha, um pouco satisfeito com a forma organizada e firme dos nós."

# game/a1s1.rpy:817
translate pt_br a1s1_1865a3ba:

    # "I shift and almost slide off the wolf's ass, forcing me to put my hands back and steady myself on his thighs."
    "Ao me deslocar, quase escorrego para fora do traseiro do lobo, me forçando a estabilizar o equilíbrio usando suas coxas como suporte."

# game/a1s1.rpy:818
translate pt_br a1s1_e75ff83a:

    # "They're thick and heavily muscled, and that makes me realize that they might also be a problem."
    "Elas são grossas e bem musculosas, isso me faz perceber que talvez também sejam um problema se ficarem soltas."

# game/a1s1.rpy:819
translate pt_br a1s1_83bbf679:

    # "While binding his arms is a start, I have no doubt in my mind he'd be able to take me out with a few nasty kicks."
    "Mesmo que amarrar os braços dele já seja um começo, eu não tenho dúvida que ele seria capaz de me derrubar com alguns chutes sorrateiros."

# game/a1s1.rpy:820
translate pt_br a1s1_2a9735f5:

    # "I stand up and start looking around for more of that rope, but that's when I notice something strange happening outside the windows."
    "Me levanto e começo a procurar ao redor por mais dessa corda, mas é nesse momento que percebo uma coisa estranha acontecendo fora das janelas."

# game/a1s1.rpy:821
translate pt_br a1s1_fe576099:

    # "Thin streaks of white light stretch and bend, moving slowly from the front before arcing in long lines to the sides and disappearing from sight."
    "Linhas finas de luz se esticam e dobram, movendo-se lentamente, partindo da frente até formar longos traços nas laterais e desaparecerendo de vista."

# game/a1s1.rpy:822
translate pt_br a1s1_53ea1c99:

    # "I stare, mesmerized, then suddenly feel sick at the sight."
    "Eu fico encarando, hipnotizado, me sentindo enjoado logo em seguida."

# game/a1s1.rpy:823
translate pt_br a1s1_6600e992:

    # "I avert my eyes, looking at the wall while I watch the strange light show out of the corner of my eye."
    "Desvio o olhar até a parede enquanto observo o show de luzes estranhas no canto da visão panorâmica."

# game/a1s1.rpy:824
translate pt_br a1s1_1e9902e6:

    # "Are those stars? Are we in some sort of worm hole or, what was it called, hyperspace?"
    "Isso são estrelas? Estamos em algum tipo de buraco de minhoca ou, como é o nome... hiperespaço?"

# game/a1s1.rpy:825
translate pt_br a1s1_c8290883:

    # "I start to get the feeling that I'm very, very far from Earth now, which makes me feel even more sick."
    "Começo a ter a sensação de que estou muito, muito longe da Terra agora, o que faz o enjoo ficar ainda pior."

# game/a1s1.rpy:826
translate pt_br a1s1_cbc3592a:

    # "I want to keep my mind off of it, so I set about searching the deck for more of the metal rope, trying to ignore that we might be moving at the speed of light into the depths of space."
    "Eu quero parar de pensar nisso, então volto a procurar por mais da corda de metal pelo convés, tentando ignorar que talvez eu esteja me movendo na velocidade da luz em direção às profundezas do espaço."

# game/a1s1.rpy:827
translate pt_br a1s1_87c99906:

    # "I don't have much luck; most everything in the ship is flush to its surface with very few moving parts."
    "Não tenho muita sorte; quase tudo na nave é nivelado à superfície, com pouquíssimas partes móveis."

# game/a1s1.rpy:828
translate pt_br a1s1_ceb823a8:

    # "I end up going back to the utility closet and that's when I see that metal polygon with the long cord sticking out of it, the one I'd knocked off the shelf earlier."
    "Acabo recorrendo ao armário e é aí que me lembro do polígono de metal com um fio saindo que eu tinha derrubado da prateleira antes."

# game/a1s1.rpy:829
translate pt_br a1s1_82aeb659:

    # "I lean over and pull at it, deciding that it should hold, even if it's more plastic-y and not metal."
    "Eu me inclino para puxá-lo, acreditando que vai servir, mesmo que lembre mais plástico do que metal."

# game/a1s1.rpy:830
translate pt_br a1s1_97c8d841:

    # "Five minutes later and I have his legs bound together."
    "Cinco minutos se passam e as pernas dele estão amarradas."

# game/a1s1.rpy:831
translate pt_br a1s1_4fda4b14:

    # "I search around for the taser for another minute before finding it pinned between Amicus's chest and the deck."
    "Eu procuro o taser por mais um minuto antes de encontrá-lo preso entre o peito do Amicus e o piso."

# game/a1s1.rpy:832
translate pt_br a1s1_033398ee:

    # "I'm hot and sweaty as I finally sit back against the opposite wall, staring at the face-down wolf and his bindings."
    "Com calor e suado, decido sentar no chão apoiando minhas costas na parede oposta ao lobo, olhando para ele, o dito cujo com a cara no chão e de bruços."

# game/a1s1.rpy:833
translate pt_br a1s1_337cc2e4:

    # "I weigh the taser in my hand, going over scenarios in my mind for what I'm going to say to him when he wakes back up..."
    "Eu seguro o taser na minha mão, imaginando cenários na minha mente sobre o que falar quando ele acordar..."

# game/a1s1.rpy:836
translate pt_br a1s1_24963ce4:

    # "I'm not sure how long it takes; an hour, maybe two before Amicus starts to stir."
    "Não sei quanto tempo se passa; uma hora, talvez duas antes do Amicus começar a se mexer."

# game/a1s1.rpy:837
translate pt_br a1s1_7693e9e2:

    # "First he groans, then he rolls over a few times, then draws up his bound legs before trying to work his paws free."
    "Primeiro ele gane, depois rola algumas vezes no chão e estica para cima as pernas atadas antes de tentar libertar as patas."

# game/a1s1.rpy:838
translate pt_br a1s1_dc4b67b0:

    # "Finally, he opens his eyes and because he's on his side, I'm the first thing he sees."
    "Finalmente, ele abre os olhos e, por eu estar ao seu lado, sou a primeira coisa que ele vê."

# game/a1s1.rpy:839
translate pt_br a1s1_2e497fe4:

    # "He squints, frowns, then groans again, turning over onto his stomach."
    "Ele aperta os olhos, arqueia as sobrancelhas e geme outra vez, virando de bruços."

# game/a1s1.rpy:843
translate pt_br a1s1_fcdd355c:

    # a "\"What the hell?\""
    a "\"Mas que porra?\""

# game/a1s1.rpy:844
translate pt_br a1s1_1479e231:

    # "I clear my throat and swallow, trying not to show how nervous I am."
    "Eu pigarreio e engulo seco, tentando não mostrar quão nervoso eu me sinto."

# game/a1s1.rpy:845
translate pt_br a1s1_d90b82a6:

    # m "\"Yeah, what the hell. You tazed me again.\""
    m "\"É, mas que porra. Você usou o taser em mim de novo.\""

# game/a1s1.rpy:847
translate pt_br a1s1_3c8805f7_2:

    # a "\"What?\""
    a "\"O que?\""

# game/a1s1.rpy:848
translate pt_br a1s1_48ae054f:

    # "Amicus turns his head to look at me again, then looks away, letting out another groan."
    "Amicus vira a cabeça para olhar em minha direção novamente, depois desvia o olhar, soltando outro ganido."

# game/a1s1.rpy:850
translate pt_br a1s1_7a736a4b:

    # a "\"Ohh, my stomach. What did you do?\""
    a "\"Ai... meu estômago. O que foi que você fez?\""

# game/a1s1.rpy:851
translate pt_br a1s1_44f6da45:

    # m "\"Exactly what you did to me.\""
    m "\"Exatamente o que você fez comigo.\""

# game/a1s1.rpy:852
translate pt_br a1s1_2afb3018:

    # "I hold up my taser, turning it in the light so that the wolf can fully see it."
    "Eu levanto o taser, virando-o para a luz de forma que o lobo consiga vê-lo."

# game/a1s1.rpy:853
translate pt_br a1s1_2fa5552f:

    # "Amicus stares at it for a moment before letting his face fall back to the floor of the deck."
    "Amicus o encara por um momento antes de deixar seu rosto cair de novo no chão do convés."

# game/a1s1.rpy:855
translate pt_br a1s1_631c3f7d:

    # a "\"Oh Gods, I feel like I'm on fire...did you use it at full power? What the hell is wrong with you!?\""
    a "\"Ah, deuses, é como se eu estivesse queimando vivo... Você usou na carga total? Mas que merda há de errado com você!?\""

# game/a1s1.rpy:856
translate pt_br a1s1_dbfd776e:

    # "Despite my fear and anxiety over this entire situation, I'm able to feel indignant."
    "Apesar do medo e ansiedade por causa de toda essa situação, eu consigo ficar indignado."

# game/a1s1.rpy:857
translate pt_br a1s1_f79d6da1:

    # m "\"Me!? You did the same to me, then lied to me, then tazed me AGAIN, then tied me up. You're crazy!\""
    m "\"Comigo!? Você fez a mesma coisa contra mim, daí mentiu pra mim, me desmaiou OUTRA VEZ, e então me amarrou. Você é doido!\""

# game/a1s1.rpy:859
translate pt_br a1s1_241eb306:

    # a "\"I would NEVER use full power on ANYONE. Uggghhh.\""
    a "\"Eu NUNCA usaria a carga total em NINGUÉM. Arggghhh.\""

# game/a1s1.rpy:860
translate pt_br a1s1_2aa72739:

    # "Amicus seems to ignore my rant as he rolls onto his back, arching over his tied paws, probably stretching out the muscles that I'd hit with the taser."
    "Amicus parece ignorar meu discurso enquanto rola para ficar de costas, arqueando sobre as patas amarradas, provavelmente alongando os músculos que eu atingi com o taser."

# game/a1s1.rpy:861
translate pt_br a1s1_3544bdcb:

    # "I wait a while longer, listening to the grunts, groans, and complaints as Amicus continues to whine."
    "Eu espero um pouco, escutando os grunhidos, resmungos e reclamações enquanto Amicus continua choramingando."

# game/a1s1.rpy:862
translate pt_br a1s1_d2816400:

    # "I'm not that stupid, though."
    "Mas eu não sou tão idiota."

# game/a1s1.rpy:863
translate pt_br a1s1_db16d373:

    # "I can tell he's stalling for time, trying to figure out a way to get out of this."
    "Posso dizer que ele está tentando ganhar tempo, tentando descobrir uma maneira de escapar disso."

# game/a1s1.rpy:864
translate pt_br a1s1_1950528a:

    # "I stand up."
    "Eu levanto."

# game/a1s1.rpy:865
translate pt_br a1s1_a05f8ccf:

    # m "\"Take me home.\""
    m "\"Me leva pra casa.\""

# game/a1s1.rpy:866
translate pt_br a1s1_cef44645:

    # "Amicus opens one eye, glaring at me."
    "Amicus abre um dos olhos, olhando para mim."

# game/a1s1.rpy:868
translate pt_br a1s1_3c8805f7_3:

    # a "\"What?\""
    a "\"O que?\""

# game/a1s1.rpy:869
translate pt_br a1s1_3e0e781e:

    # m "\"I said take me home.\""
    m "\"Eu disse me leva pra casa.\""

# game/a1s1.rpy:871
translate pt_br a1s1_f8801f6f:

    # "Amicus goes quiet for a moment, his eyes closed, then he forces himself to sit up, visibly cringing as he's forced to use his stomach muscles."
    "Amicus fica quieto por um momento, de olhos fechados, então ele se esforça um pouco para se sentar, visivelmente se encolhendo de dor por precisar usar os músculos do abdômen."

# game/a1s1.rpy:872
translate pt_br a1s1_052ed4a0:

    # "He scoots back with more complaints until he plants his back against the wall behind him."
    "Ele recua com mais reclamações, até se encostar na parede atrás de si."

# game/a1s1.rpy:873
translate pt_br a1s1_8ef55b42:

    # "I see his shoulders shift, his biceps bulging and can tell that he's working and testing the restraints."
    "Vejo seus ombros se mexerem, os bíceps se inchando e, com isso, posso concluir que ele está tentando arrebentar a corda."

# game/a1s1.rpy:874
translate pt_br a1s1_773caa22:

    # "I raise the taser."
    "Eu levanto o taser."

# game/a1s1.rpy:875
translate pt_br a1s1_0a4c5353:

    # m "\"Stop moving or I'm gonna hit you again.\""
    m "\"Para de se mexer ou eu vou enfiar isso em você de novo.\""

# game/a1s1.rpy:877
translate pt_br a1s1_249f2c03:

    # a "\"Fuck off.\""
    a "\"Vá se foder.\""

# game/a1s1.rpy:878
translate pt_br a1s1_211ba9fb:

    # "I move toward him, brandishing the taser like a sword."
    "Eu me aproximo dele, oscilando o taser como se fosse uma espada."

# game/a1s1.rpy:880
translate pt_br a1s1_6e0e0854:

    # a "\"Hey, hey, HEY!\""
    a "\"Ei, ei, EI!\""

# game/a1s1.rpy:881
translate pt_br a1s1_9de7b642:

    # "Amicus kicks his feet up, trying to block my attack."
    "Amicus dá um chute para cima, tentando bloquear o meu ataque."

# game/a1s1.rpy:883
translate pt_br a1s1_bb38f7d4:

    # "Now I see real fear in his eyes."
    "Agora sim enxergo medo de verdade nos olhos dele."

# game/a1s1.rpy:884
translate pt_br a1s1_209e064c:

    # m "\"Then stop moving and tell me how we get back!\""
    m "\"Então para de se mexer e me diz como a gente volta!\""

# game/a1s1.rpy:885
translate pt_br a1s1_42ea5d47:

    # "I don't really want to shock him again."
    "Eu não quero mesmo desmaiá-lo de novo."

# game/a1s1.rpy:886
translate pt_br a1s1_a1394111:

    # "It did look really painful and on top of that I don't want to knock him out for hours while our little ship is hurtling through space."
    "Aquilo pareceu realmente doloroso e, além disso, não quero que ele fique desmaiado por mais horas enquanto a nave vai mais longe no espaço."

# game/a1s1.rpy:887
translate pt_br a1s1_4c3706c6:

    # "Amicus glares at me for a moment, his feet still in the air before he slowly lowers them."
    "Amicus me encara por um momento, seus pés ainda no ar até que ele começa a abaixá-los lentamente."

# game/a1s1.rpy:889
translate pt_br a1s1_987ecee1:

    # a "\"I'll...show you if you let me go.\""
    a "\"Eu... te mostro se você me soltar.\""

# game/a1s1.rpy:890
translate pt_br a1s1_77da021f:

    # "I actually laugh and the sound seems to startle the wolf."
    "Eu dou uma gargalhada com essa frase e o som parece deixar o lobo assustado."

# game/a1s1.rpy:891
translate pt_br a1s1_d861dde5:

    # m "\"Are you kidding me? Why should I trust you at ALL after what you've done to me.\""
    m "\"Tá de sacanagem comigo? Por que eu deveria confiar em você depois de TUDO o que você fez?\""

# game/a1s1.rpy:892
translate pt_br a1s1_2fcfdb70:

    # "Amicus's ears flatten."
    "As orelhas do Amicus se abaixam."

# game/a1s1.rpy:893
translate pt_br a1s1_03ac5185:

    # m "\"Tell me where the hell you're taking me and why, otherwise I WILL zap you again.\""
    m "\"Me conta logo onde que você tá me levando e por quê, senão eu vou enfiar esse negócio em você de novo.\""

# game/a1s1.rpy:895
translate pt_br a1s1_bec79dea:

    # a "\"Wh—I...\""
    a "\"O q—Eu...\""

# game/a1s1.rpy:896
translate pt_br a1s1_6e5ab8a9:

    # "He seems at a loss for words."
    "Ele parece sem palavras."

# game/a1s1.rpy:897
translate pt_br a1s1_082d1406:

    # m "\"Hm?\""
    m "\"Hm?\""

# game/a1s1.rpy:899
translate pt_br a1s1_203d9ea9:

    # a "\"I...can't tell you.\""
    a "\"Eu... não posso te contar.\""

# game/a1s1.rpy:900
translate pt_br a1s1_c7b19f48:

    # "I glare and for a moment I consider just jabbing him again right then and there."
    "Eu o encaro, incrédulo, e por um breve momento penso se não seria uma boa ideia só desmaiar ele de novo."

# game/a1s1.rpy:901
translate pt_br a1s1_2558be92:

    # m "\"Why not?\""
    m "\"Por que não?\""

# game/a1s1.rpy:903
translate pt_br a1s1_a316e54e:

    # "The wolf remains silent as he looks away from me."
    "O lobo permanece em silêncio e desvia o olhar de mim."

# game/a1s1.rpy:904
translate pt_br a1s1_15ba54a7:

    # "I feel myself getting even more angry."
    "Sinto minha raiva aumentando cada vez mais."

# game/a1s1.rpy:905
translate pt_br a1s1_66882f4d:

    # "I'm tired of this alien holding me hostage."
    "Já cansei desse alienígena me mantendo como refém."

# game/a1s1.rpy:906
translate pt_br a1s1_300292c4:

    # m "\"Well, I guess I'll just have to figure it out on my own, then.\""
    m "\"Pois é, acho que vou ter que descobrir como fazer isso sozinho, então.\""

# game/a1s1.rpy:909
translate pt_br a1s1_2104fa6c:

    # "I turn away and start moving toward the front of the deck."
    "Eu me afasto e começo a me mover em direção à frente do convés."

# game/a1s1.rpy:910
translate pt_br a1s1_00cfaef0:

    # "Amicus shifts around behind me."
    "Amicus se mexe atrás de mim."

# game/a1s1.rpy:912
translate pt_br a1s1_55026a02:

    # a "\"What!? You don't know the first thing about this ship. Don't—\""
    a "\"O que!? Você não faz ideia de como pilotar essa nave. Nem—\""

# game/a1s1.rpy:913
translate pt_br a1s1_bfc07adc:

    # "The big wolf grunts as he tries to get his feet under him."
    "O grande lobo resmunga enquanto tenta ficar de pé."

# game/a1s1.rpy:915
translate pt_br a1s1_cd38769c:

    # a "\"Don't touch anything!\""
    a "\"Não toque em nada!\""

# game/a1s1.rpy:917
translate pt_br a1s1_fac31667:

    # "I ignore him and move to the panels, looking them over."
    "Eu o ignoro e ando até os painéis, dando uma olhada neles."

# game/a1s1.rpy:918
translate pt_br a1s1_04238e7f:

    # "The big one in the middle looks promising and I start poking at it."
    "O maior de todos, no meio, parece promissor e eu começo a cutucá-lo."

# game/a1s1.rpy:919
translate pt_br a1s1_61bfbf1e:

    # "I know I won't be able to figure out how to turn the ship around, but the wolf's worry over me touching the panels gives me an idea."
    "Eu sei que não vou conseguir descobrir como dar a volta nessa coisa, mas talvez a preocupação do lobo comigo mexendo aleatoriamente nesses botões sirva como guia para ter alguma ideia."

# game/a1s1.rpy:920
translate pt_br a1s1_a5cb80d7:

    # "I can probably mess things up to the point where he'll HAVE to tell me what he's doing, or even how I might be able to get back."
    "Provavelmente eu posso estragar tudo ao ponto que ele TERÁ que me dizer o que está fazendo comigo, ou pelo menos como eu volto para casa."

# game/a1s1.rpy:921
translate pt_br a1s1_34c56a12:

    # "There aren't many other options aside from torturing him, something I don't really want to do."
    "Também não tenho muitas alternativas além de torturá-lo, algo que eu realmente não gostaria de fazer."

# game/a1s1.rpy:922
translate pt_br a1s1_ac0fd900:

    # "The lines and shapes move with my finger and Roman numerals pop up randomly here and there."
    "As linhas e formas se movem com o deslizar do meu dedo e números romanos são exibidos aleatoriamente aqui e ali."

# game/a1s1.rpy:923
translate pt_br a1s1_de82b99b:

    # a "\"Hey...what...are you doing?\""
    a "\"Ei... o que... você está fazendo?\""

# game/a1s1.rpy:924
translate pt_br a1s1_816b3a4b:

    # "Amicus huffs and puffs behind me, just as a circle appears and compresses around my finger, like it's zeroed in on something."
    "Amicus bufa e sopra atrás de mim ao mesmo tempo que um círculo aparece e comprime ao redor do meu dedo, como se estivesse apontando para algo."

# game/a1s1.rpy:925
translate pt_br a1s1_6ef00a2c:

    # "I look back to see Amicus hobbling up onto his tied together feet, looking just about ready to topple over."
    "Olho para trás e vejo o Amicus mancando sobre seus pés amarrados, quase caindo."

# game/a1s1.rpy:927
translate pt_br a1s1_60384470:

    # a "\"You have no idea what—\""
    a "\"Você não faz ideia do que—\""

# game/a1s1.rpy:928
translate pt_br a1s1_df946a3b:

    # "I feel a soft vibration under my finger not unlike my phone's haptic feedback."
    "Sinto uma vibração suave sob o meu dedo, não muito diferente do feedback tátil do meu celular."

# game/a1s1.rpy:929
translate pt_br a1s1_21f2d835:

    # com "\"Overriding sleep mode. Locked on to Stella 556425.\""
    com "\"Sobrepondo modo de suspensão. Bloqueado em Stella 556425.\""

# game/a1s1.rpy:931
translate pt_br a1s1_b509f5b1:

    # a "\"NO! Com, stop last directive!\""
    a "\"NÃO! Com, cancele a última ordem!\""

# game/a1s1.rpy:932
translate pt_br a1s1_29c57a0f:

    # com "\"Voice commands for piloting are reserved for the emperor, Amicus.\""
    com "\"Comandos de voz para pilotagem são de exclusividade do imperador, Amicus.\""

# game/a1s1.rpy:934
translate pt_br a1s1_dfff6d75:

    # a "\"Human, stop!\""
    a "\"Humano, pare!\""

# game/a1s1.rpy:935
translate pt_br a1s1_cf0ce5d4:

    # "Amicus starts hopping toward me on his bound feet and I scramble to the side so he doesn't run into me."
    "Amicus começa a pular em minha direção com os pés atados e eu deslizo para o lado, evitando que ele esbarre em mim."

# game/a1s1.rpy:936
translate pt_br a1s1_f34a2ef9:

    # a "\"No, no, no!\""
    a "\"Não, não, não!\""

# game/a1s1.rpy:937
translate pt_br a1s1_b9556f4d:

    # "The wolf stares down at the panel and I look out the window as the stars seem to curve all the way to my right, making me feel sick again and the next thing I know—"
    "O lobo olha para baixo no painel e eu vejo através da janela enquanto as estrelas parecem se curvar todo o caminho à minha direita, me causando vertigem novamente e a próxima coisa que eu enxergo é—"

# game/a1s1.rpy:941
translate pt_br a1s1_b2799851:

    # "The cabin is lit up by an ominous red glow."
    "A cabine é iluminada por um sinistro brilho vermelho."

# game/a1s1.rpy:943
translate pt_br a1s1_4e63b230:

    # "The windows suddenly tint, blocking the worst of the light and that's when I'm able to see a massive ball of fire in front of the ship."
    "As janelas escurecem de repente, bloqueando o pior da luz, e é aí que eu noto uma bola de fogo gigantesca na frente da nave."

# game/a1s1.rpy:944
translate pt_br a1s1_c14b867c:

    # "The size of it is incredible."
    "O tamanho é colossal e incrível."

# game/a1s1.rpy:945
translate pt_br a1s1_43e0695f:

    # com "\"Orbital trajectory will intersect with photosphere. Ensure safety straps are in place. Making corrective maneuvers.\""
    com "\"A trajetória orbital interseccionará com a fotosfera, certifique-se de que os cintos de segurança estão no lugar. Aplicando manobras corretivas.\""

# game/a1s1.rpy:946
translate pt_br a1s1_2d5b5342:

    # "I only have a moment to wonder what the hell Com is talking about before Amicus and I are thrown sideways into the left window of the ship."
    "Eu tenho apenas um momento para me perguntar do que diabos o Com está falando antes de eu e o Amicus sermos lançados em direção à janela esquerda da nave."

# game/a1s1.rpy:947
translate pt_br a1s1_c4817402:

    # "The impact is mostly cushioned by Amicus's body and I hear him yell and curse under me."
    "O impacto é majoritariamente amortecido pelo corpo do Amicus e eu o escuto gritar e xingar atrás de mim."

# game/a1s1.rpy:949
translate pt_br a1s1_ff1f31fe:

    # a "\"MOVE! GET IN THE SEAT!\""
    a "\"ANDA! SENTA NA CADEIRA!\""

# game/a1s1.rpy:950
translate pt_br a1s1_a7217bce:

    # "I struggle to reach out to the seat in front of me, but I can barely lift my hand."
    "Eu luto para alcançar o assento na minha frente, mas eu mal consigo levantar minha mão."

# game/a1s1.rpy:951
translate pt_br a1s1_e2f00504:

    # "The gravity of the star is so powerful it feels like it's going to suck out my soul."
    "A gravidade da estrela é tão poderosa que é como se ela fosse sugar minha alma."

# game/a1s1.rpy:952
translate pt_br a1s1_1319dd6f:

    # "Then I'm suddenly boosted up by something behind me and I look back, the movement making me feel like my neck is going to break."
    "De repente, sou impulsionado por algo atrás de mim, virando a cabeça para averiguar, o movimento me fazendo sentir como se eu fosse quebrar meu pescoço."

# game/a1s1.rpy:953
translate pt_br a1s1_e626bc22:

    # "I see Amicus with his back planted against the window, his feet pushing me up to the seat."
    "Eu vejo o Amicus enfornado contra a janela, seus pés me empurrando até o assento."

# game/a1s1.rpy:954
translate pt_br a1s1_c271fa10:

    # "I manage to grab the armrest and pull myself into it."
    "Consigo alcançar o braço da cadeira e me puxar para dentro dela."

# game/a1s1.rpy:955
translate pt_br a1s1_b1825b6e:

    # "Now the left armrest is digging painfully into my back, making it feel as if a professional wrestler is slamming me into a back breaker."
    "Agora o apoio de braço pressiona dolorosamente contra as minhas costas, como se um lutador profissional estivesse me dando uma voadora."

# game/a1s1.rpy:956
translate pt_br a1s1_92835a48:

    # "Amicus jumps from the window, high enough that his feet land against the right side of my chair."
    "Amicus se impulsiona contra a janela e pula, alto o suficiente para que seus pés pousem do lado direito da minha cadeira."

# game/a1s1.rpy:958
translate pt_br a1s1_2dba6ea7:

    # "Then he jumps again, managing to wedge himself in the footwell of the opposite seat."
    "Então ele pula de novo, conseguindo se enfiar com os pés no assento oposto."

# game/a1s1.rpy:959
translate pt_br a1s1_cd243b41:

    # com "\"Heat shields are compromised. Expect heat damage to outer layer of ship in 30 seconds.\""
    com "\"Escudos térmicos comprometidos. Danos térmicos são esperados na camada externa da nave em 30 segundos.\""

# game/a1s1.rpy:960
translate pt_br a1s1_5f694945:

    # "With a great deal of snarling and gasping, he pushes himself awkwardly into the seat, both feet planted against the panels in front of him for leverage."
    "Com uma grande quantidade de rosnados e ganidos, ele se empurra desjeitosamente contra o banco com os dois pés pressionados contra os painéis à sua frente para impulsionar."

# game/a1s1.rpy:961
translate pt_br a1s1_8bf1646e:

    # "He turns to me, teeth bared, a determined look in his eyes."
    "Ele se vira para mim com os dentes à mostra e um olhar determinado."

# game/a1s1.rpy:962
translate pt_br a1s1_bc262306:

    # a "\"Look at your right armrest! Do you see the green panel between the red buttons!?\""
    a "\"Olhe no seu apoio de braço! Vê esse painel verde entre os botões vermelhos!?\""

# game/a1s1.rpy:963
translate pt_br a1s1_88e05b31:

    # "Through the shock I'm somehow able to understand him and look down."
    "Apesar do choque, de algum jeito eu consigo entendê-lo e olhar para baixo."

# game/a1s1.rpy:964
translate pt_br a1s1_fdcef024:

    # a "\"Now, drag your finger across it to the left, it'll steer the ship!\""
    a "\"Faça o seguinte, deslize o dedo sobre ele para a esquerda, isso vai conduzir a nave!\""

# game/a1s1.rpy:965
translate pt_br a1s1_1b074d8a:

    # "I feel panic starting to rise in my chest at the idea of steering a goddamn spaceship."
    "Eu sinto o pânico começando a subir no meu peito ao me deparar com a ideia de dirigir uma maldita nave espacial."

# game/a1s1.rpy:966
translate pt_br a1s1_486a0250:

    # m "\"What!?\""
    m "\"O que!?\""

# game/a1s1.rpy:967
translate pt_br a1s1_ce8eb89f:

    # a "\"Just do it! Point us away from the star!\""
    a "\"Faça isso logo de uma vez! Aponte para longe da estrela!\""

# game/a1s1.rpy:968
translate pt_br a1s1_1f4abbb6:

    # "I do as I'm told, sliding a thumb gingerly over the green panel."
    "Eu faço como ele diz, deslizando o polegar cuidadosamente sobre o painel verde."

# game/a1s1.rpy:969
translate pt_br a1s1_f9d2d076:

    # "And slowly the ship turns, pointing away from the star, shifting the incredible force of gravity until it's pulling us back into the seats."
    "Lentamente, a nave gira, apontando para longe da estrela, deslocando a incrível força da gravidade de modo que ela começa a nos puxar contra os assentos."

# game/a1s1.rpy:970
translate pt_br a1s1_e4599b3d:

    # a "\"Now...now see that lever in between us!?\""
    a "\"Agora... está vendo essa alavanca entre nós!?\""

# game/a1s1.rpy:971
translate pt_br a1s1_ba9c3ac4:

    # m "\"Yeah!\""
    m "\"Sim!\""

# game/a1s1.rpy:972
translate pt_br a1s1_f663d1d7:

    # a "\"Pull it down!\""
    a "\"Puxe para baixo!\""

# game/a1s1.rpy:973
translate pt_br a1s1_459ab3e4:

    # "Now reaching my hand out is almost impossible as it gets pulled back toward the star behind us."
    "Estender minha mão é quase impossível enquanto ela é puxada pela estrela atrás de nós."

# game/a1s1.rpy:974
translate pt_br a1s1_0a5dfde7:

    # "Gritting my teeth, I lean forward as hard as I can, practically throwing myself forward and grabbing onto the lever."
    "Cerrando os dentes, me inclino para frente o mais forte que consigo, praticamente me jogando e agarrando a alavanca."

# game/a1s1.rpy:975
translate pt_br a1s1_ce9fad3a:

    # "Then gravity does the rest of the work and the lever comes down hard."
    "A gravidade faz o resto do trabalho e a alavanca desce com força."

# game/a1s1.rpy:976
translate pt_br a1s1_1afa6c1e:

    # "I lose my grip and get thrown back into my seat."
    "Perco a firmeza na mão e sou jogado de volta na cadeira."

# game/a1s1.rpy:979
translate pt_br a1s1_f0172b9a:

    # "The gravity increases two-fold and for a moment it feels like my entire body is being crushed into a pancake."
    "A gravidade dobra a intensidade e por um momento parece que o meu corpo inteiro vai ser esmagado e virar uma panqueca."

# game/a1s1.rpy:983
translate pt_br a1s1_b95a3d23:

    # "And then the burning orange light is gone and the deck goes black."
    "Então a luz laranja some e o convés fica escuro."

# game/a1s1.rpy:985
translate pt_br a1s1_79c1dcbe:

    # com "\"Running diagnostics...Amicus?\""
    com "\"Executando diagnósticos... Amicus?\""

# game/a1s1.rpy:986
translate pt_br a1s1_a20cefa7_11:

    # "..."
    "..."

# game/a1s1.rpy:987
translate pt_br a1s1_c36a13ce:

    # a "\"Yes, Com?\""
    a "\"Sim, Com?\""

# game/a1s1.rpy:988
translate pt_br a1s1_0c2a0d72:

    # com "\"Damage to the ship is severe. Recovery mode is required.\""
    com "\"Os danos à nave são severos. Solicita-se a entrada no modo de recuperação.\""

# game/a1s1.rpy:989
translate pt_br a1s1_a20cefa7_12:

    # "..."
    "..."

# game/a1s1.rpy:990
translate pt_br a1s1_e6f10430:

    # a "\"Enter recovery mode.\""
    a "\"Entrar no modo de recuperação.\""

# game/a1s1.rpy:991
translate pt_br a1s1_b36aba0c:

    # com "\"Standby.\""
    com "\"Aguarde.\""

# game/a1s1.rpy:992
translate pt_br a1s1_a20cefa7_13:

    # "..."
    "..."

# game/a1s1.rpy:997
translate pt_br a1s1_53ebd070:

    # "We sit in silence for a long, long time."
    "Sentamos em silêncio por um longo, longo tempo."

# game/a1s1.rpy:998
translate pt_br a1s1_a3762f20:

    # "I lean against the seat with both feet drawn up to my chest, feeling numb and shaky."
    "Eu me encosto no assento com as coxas apoiadas contra o peito, me sentindo entorpecido e trêmulo."

# game/a1s1.rpy:999
translate pt_br a1s1_60553089:

    # "I also feel stupid, embarrassed, and kind of guilty."
    "Eu também me sinto estúpido, envergonhado, e um pouco culpado."

# game/a1s1.rpy:1000
translate pt_br a1s1_05993c8d:

    # "On one hand I nearly just got us both killed."
    "Por um lado, eu quase acabei de matar nós dois."

# game/a1s1.rpy:1001
translate pt_br a1s1_17873bdb:

    # "But on the other hand this crazy alien almost killed {i}me{/i} by bringing me here in the first place."
    "Mas por outro, esse alienígena maluco quase {i}me{/i} matou só por me trazer aqui em primeiro lugar."

# game/a1s1.rpy:1002
translate pt_br a1s1_350830fa:

    # "At least it feels that way."
    "Ao menos é isso o que parece."

# game/a1s1.rpy:1003
translate pt_br a1s1_34178ec1:

    # "I still don't know what his ultimate plan is with me."
    "Ainda não sei qual é o plano mirabolante dele me envolvendo."

# game/a1s1.rpy:1004
translate pt_br a1s1_49786a05:

    # "I wonder for the hundredth time if I'm going to wake up."
    "Me pergunto pela centésima vez se vou acordar."

# game/a1s1.rpy:1005
translate pt_br a1s1_7b4eb03b:

    # "I plug my nose and try to breathe through my nostrils."
    "Tapo o meu nariz e tento respirar pelas narinas."

# game/a1s1.rpy:1006
translate pt_br a1s1_061ad74f:

    # "No air comes through."
    "Nenhum ar passa."

# game/a1s1.rpy:1007
translate pt_br a1s1_9c1278a5:

    # "I sigh and look out the window, at the blue glow that we've found ourselves in."
    "Suspiro e olho pela janela, na direção do brilho azul que se espalha pelo convés, vindo do lado de fora."

# game/a1s1.rpy:1008
translate pt_br a1s1_b8e14a66:

    # "The star that we'd just escaped is far away now, though it's still an almost-blinding tiny orb far to my left, kind of like the sun was not too long ago."
    "A estrela a qual acabamos de escapar já se encontra distante, embora ainda seja uma pequena esfera bem brilhante ao longe na minha esquerda, igual ao sol não muito tempo atrás."

# game/a1s1.rpy:1009
translate pt_br a1s1_a8f16323:

    # "It's lighting up all of this dust that's around us with an eerie blue glow."
    "Ela ilumina toda essa poeira ao redor da nave com um brilho azul misterioso."

# game/a1s1.rpy:1010
translate pt_br a1s1_035489b0:

    # "It's kind of calming."
    "Até que é um pouco relaxante, eu diria."

# game/a1s1.rpy:1012
translate pt_br a1s1_c80a7ea9:

    # "I look over at Amicus and see him slumped in his chair, looking out the window."
    "Olho para o Amicus e o vejo afundado na cadeira, olhando pela janela."

# game/a1s1.rpy:1013
translate pt_br a1s1_63be3a5d:

    # "His shoulders are hunched, ears drooping, and his head down."
    "Os ombros curvados, orelhas caídas e a cabeça baixa."

# game/a1s1.rpy:1014
translate pt_br a1s1_8db324c3:

    # "He's on the edge of his seat because his arms are still tied behind his back, forcing him to lean forward a bit."
    "Ele se apoia na beira do assento porque os braços ainda estão amarrados nas costas, o forçando a se inclinar um pouco para frente."

# game/a1s1.rpy:1015
translate pt_br a1s1_fe5cde7c:

    # "Com hasn't spoken since we went into \"recovery mode\" and the ship hasn't moved at all."
    "Com não falou nada desde que entramos no \"modo de recuperação\" e a nave não se moveu um centímetro."

# game/a1s1.rpy:1016
translate pt_br a1s1_fdf72a54:

    # "The usual hum isn't even there."
    "Nem se ouve mais o constante zumbido de antes."

# game/a1s1.rpy:1017
translate pt_br a1s1_94397e0d:

    # "It's like everything is turned off."
    "É como se tudo tivesse sido desligado."

# game/a1s1.rpy:1018
translate pt_br a1s1_19de60eb:

    # "I finally decide to break the silence."
    "Eu finalmente decido quebrar o silêncio."

# game/a1s1.rpy:1019
translate pt_br a1s1_2e87079d:

    # m "\"Amicus?\""
    m "\"Amicus?\""

# game/a1s1.rpy:1020
translate pt_br a1s1_40f454f2:

    # "I see his ears flick, but he keeps his head down, not even looking at me."
    "Vejo as orelhas dele sacudirem, mas ele continua de cabeça baixa, nem sequer olhando para mim."

# game/a1s1.rpy:1021
translate pt_br a1s1_a12bf6c9:

    # "I swallow, then try again."
    "Eu engulo seco, então tento de novo."

# game/a1s1.rpy:1022
translate pt_br a1s1_74b1ef73:

    # m "\"Amicus.\""
    m "\"Amicus.\""

# game/a1s1.rpy:1023
translate pt_br a1s1_74b02210:

    # "I see his shoulders rise and fall in a deep sigh, but he keeps silent."
    "Vejo seus ombros subirem e descerem em um profundo suspiro, mas ele continua em silêncio."

# game/a1s1.rpy:1024
translate pt_br a1s1_0f7586f5:

    # "I'm about to just give up and slump back in my seat when he suddenly responds."
    "Fico prestes a desistir e ficar na minha quando ele de repente responde."

# game/a1s1.rpy:1025
translate pt_br a1s1_3c8805f7_4:

    # a "\"What?\""
    a "\"O que?\""

# game/a1s1.rpy:1026
translate pt_br a1s1_604e6184:

    # m "\"What's happening?\""
    m "\"O que tá acontecendo?\""

# game/a1s1.rpy:1028
translate pt_br a1s1_f20929c0:

    # "The wolf turns to glare at me."
    "O lobo se vira para me encarar."

# game/a1s1.rpy:1029
translate pt_br a1s1_d0761464:

    # a "\"What do you mean 'what's happening'? you broke the ship.\""
    a "\"Como assim \"O que tá acontecendo?\". Você quebrou a nave.\""

# game/a1s1.rpy:1031
translate pt_br a1s1_d45b6579:

    # "He turns away and continues to sulk."
    "Ele desvia o olhar e continua com o mau humor."

# game/a1s1.rpy:1032
translate pt_br a1s1_4f9b6fbc:

    # "I feel a little anger at that and I realize that this alien isn't alien at all."
    "Sinto um pouco de raiva por causa disso e percebo que esse alienígena não é tão alienígena quanto eu pensava."

# game/a1s1.rpy:1033
translate pt_br a1s1_3982a2ed:

    # "He's acting just like an upset human kid that didn't get his way."
    "Ele está agindo exatamente como uma criança humana chateada por não conseguir o que queria."

# game/a1s1.rpy:1034
translate pt_br a1s1_734730b6:

    # "It makes me a little less afraid of him."
    "Isso faz com que eu sinta um pouco menos de medo dele."

# game/a1s1.rpy:1035
translate pt_br a1s1_def4f1e1:

    # m "\"Excuse me? Do I have to go through the list of shit that you did to me?\""
    m "\"Hein? Eu tenho mesmo que listar aqui de novo todas as burradas que você fez comigo?\""

# game/a1s1.rpy:1037
translate pt_br a1s1_c653dfba:

    # "Amicus turns to me again and I can almost see his mind working to think of some sort of comeback."
    "Amicus se vira para mim outra vez e eu posso sentir sua mente trabalhando para pensar em alguma forma de contra-ataque verbal."

# game/a1s1.rpy:1038
translate pt_br a1s1_36cafdff:

    # a "\"Well, I think you topped it by nearly throwing us into a star, human!\""
    a "\"É, eu acho que você superou a lista inteira quase nos jogando dentro de uma estrela, humano!\""

# game/a1s1.rpy:1039
translate pt_br a1s1_671aad74:

    # m "\"You shouldn't have kidnapped me in the first place, {i}wolf{/i}.\""
    m "\"Você não deveria ter me sequestrado para começo de conversa, {i}lobo{/i}.\""

# game/a1s1.rpy:1040
translate pt_br a1s1_1dc9a05f:

    # a "\"I should be calling you child since that's what you are.\""
    a "\"Eu deveria estar te chamando de infante já que é isso o que você é.\""

# game/a1s1.rpy:1041
translate pt_br a1s1_3523184b:

    # m "\"Well this child outsmarted you, zapped you, and tied you up.\""
    m "\"O mesmo infante que foi mais esperto que você, te desmaiou e amarrou depois.\""

# game/a1s1.rpy:1043
translate pt_br a1s1_9a8a2db3:

    # "I see him bristle, the hackles rising on his shoulders like a dog."
    "Eu noto os pelos do Amicus, todos eles se arrepiando nos ombros como os de um cachorro."

# game/a1s1.rpy:1044
translate pt_br a1s1_81cbce4e:

    # a "\"You could have KILLED me. That setting is meant for creatures three times my size!\""
    a "\"Você poderia ter me MATADO. Aquela configuração serve para criaturas três vezes o meu tamanho!\""

# game/a1s1.rpy:1045
translate pt_br a1s1_cef052dc:

    # m "\"How was I supposed to know!? I don't know anything about what's going on!\""
    m "\"E como é que eu ia saber!? Eu não entendo patavinas do que tá acontecendo aqui!\""

# game/a1s1.rpy:1046
translate pt_br a1s1_5333b4c9:

    # a "\"I told you what's going on—\""
    a "\"Eu contei para você o que está acontecendo—\""

# game/a1s1.rpy:1047
translate pt_br a1s1_99efae27:

    # m "\"You really think I'm stupid, don't you.\""
    m "\"Você realmente acha que eu sou idiota, né?\""

# game/a1s1.rpy:1049
translate pt_br a1s1_a0a98c03:

    # "Amicus pouts and turns away again."
    "Amicus faz um biquinho de birra e se vira de novo."

# game/a1s1.rpy:1050
translate pt_br a1s1_64a84c4f:

    # m "\"I think you thought I was some stupid alien you could just take advantage of. I can tell you've been lying to me this whole time.\""
    m "\"Acho que você pensou que eu era um alienígena acéfalo qualquer que você podia simplesmente tirar vantagem. Eu posso dizer com certeza que você tá mentindo pra mim esse tempo todo.\""

# game/a1s1.rpy:1051
translate pt_br a1s1_70ea6b73:

    # "Amicus flattens his ears even more, shoulders bunching up."
    "Amicus abaixa ainda mais suas orelhas e encolhe para dentro dos ombros."

# game/a1s1.rpy:1052
translate pt_br a1s1_b1b9128c:

    # m "\"Is that what you and your people do? Kidnapping and lying to everyone you meet—\""
    m "\"É isso o que você e o seu povo fazem? Sequestrar e mentir pra todo mundo que vocês conhecem—\""

# game/a1s1.rpy:1054
translate pt_br a1s1_157d5187:

    # "Now his hackles really raise up and he turns on me fast."
    "Agora os pelos dele realmente ficam de pé e ele se vira para mim bem rápido."

# game/a1s1.rpy:1055
translate pt_br a1s1_d41bc9db:

    # "I try not to lean back."
    "Eu tento não recuar."

# game/a1s1.rpy:1056
translate pt_br a1s1_7f1a5b27:

    # "Despite the similarities, he's still a wolf, and those teeth are terrifying."
    "Apesar das semelhanças humanas, ele ainda é um lobo, e aqueles dentes são assustadores."

# game/a1s1.rpy:1057
translate pt_br a1s1_d93bf076:

    # a "\"I do NOT lie...I—I...\""
    a "\"Eu NÃO minto... Eu—Eu...\""

# game/a1s1.rpy:1058
translate pt_br a1s1_923bd551:

    # "The wolf's righteous indignation seems to deflate."
    "A repentina indignação do lobo parece esvaziar."

# game/a1s1.rpy:1060
translate pt_br a1s1_dfdb5c47:

    # a "\"The situation is too complicated for you to understand.\""
    a "\"A situação é muito complicada para você entender.\""

# game/a1s1.rpy:1061
translate pt_br a1s1_af78b41c:

    # "I glare at him."
    "Eu fico encarando ele."

# game/a1s1.rpy:1062
translate pt_br a1s1_7d7dd8f5:

    # m "\"Who's tied up again?\""
    m "\"E quem é que tá amarrado aqui?\""

# game/a1s1.rpy:1063
translate pt_br a1s1_c0c56b45:

    # "Amicus doesn't take the bait this time and remains slumped."
    "Amicus não morde a isca dessa vez e permanece afundado no assento."

# game/a1s1.rpy:1064
translate pt_br a1s1_ea48f145:

    # a "\"I guess it doesn't matter now. We're probably going to die out here with how badly the ship is burned.\""
    a "\"Acho que isso não importa mais agora. Nós provavelmente vamos morrer aqui fora tendo em vista a gravidade do dano na nave.\""

# game/a1s1.rpy:1065
translate pt_br a1s1_96350b7d:

    # "That makes my stomach twist a bit."
    "Isso faz meu estômago embrulhar um pouco."

# game/a1s1.rpy:1066
translate pt_br a1s1_d945d777:

    # "I want to ask him if he's just moping or if he actually thinks we're going to die."
    "Eu quero perguntar se ele só está deprimido ou realmente acha que nós vamos morrer."

# game/a1s1.rpy:1067
translate pt_br a1s1_2c49dbb6:

    # "But another long moment of silence stretches between us."
    "Mas outro momento de silêncio se estende entre nós."

# game/a1s1.rpy:1068
translate pt_br a1s1_e1ab004f:

    # "I look out the window again, at the towering clouds of dust in front of us."
    "Eu olho para a janela outra vez, em direção às imensas nuvens de poeira na nossa frente."

# game/a1s1.rpy:1069
translate pt_br a1s1_6ad35356:

    # m "\"Well...if that's the case, then can you just tell me what's going on?\""
    m "\"Olha, se é assim... então você pode me dizer o que tá acontecendo de verdade?\""

# game/a1s1.rpy:1070
translate pt_br a1s1_b378ae4f:

    # "Amicus goes on staring out his window."
    "Amicus continua olhando pela janela."

# game/a1s1.rpy:1071
translate pt_br a1s1_f10d1e85:

    # "I sigh and lean back, resigned to the idea that I might not ever know why I was dragged out to space to simply get stuck and die in a dust cloud."
    "Eu suspiro e me inclino para trás, conformado com a ideia de que provavelmente nunca vou saber porque fui levado ao espaço para simplemente ficar preso e morrer em uma nuvem de poeira."

# game/a1s1.rpy:1072
translate pt_br a1s1_fa931998:

    # "Then Amicus speaks."
    "Então o Amicus começa a falar."

# game/a1s1.rpy:1074
translate pt_br a1s1_a33e8585:

    # a "\"I...made some mistakes.\""
    a "\"Eu... pisei na bola.\""

# game/a1s1.rpy:1075
translate pt_br a1s1_3819ac9d:

    # "I glance at him, waiting, not wanting to say anything in case he stops talking."
    "Eu olho para ele, esperando, tentando não falar nada caso ele pare de falar por causa disso."

# game/a1s1.rpy:1076
translate pt_br a1s1_fb06a620:

    # a "\"I didn't know your species wasn't part of the {i}Galaxias{/i}. It's...very illegal to make First Contact without authorization from a parent.\""
    a "\"Eu não sabia que sua espécie não fazia parte da {i}congregação galáctica{/i}. É bem... ilegal fazer primeiro contato sem a autorização de um {i}progenitor{/i}.\""

# game/a1s1.rpy:1077
translate pt_br a1s1_c3385ac4:

    # m "\"Parent?\""
    m "\"Progenitor?\""

# game/a1s1.rpy:1078
translate pt_br a1s1_bb90bd34:

    # a "\"The authorities of the galaxy.\""
    a "\"São as autoridades da galáxia.\""

# game/a1s1.rpy:1079
translate pt_br a1s1_ff1a0c0a:

    # "I frown and Amicus looks at the confusion on my face."
    "Faço uma careta e o Amicus nota a confusão em meu rosto."

# game/a1s1.rpy:1080
translate pt_br a1s1_e7759761:

    # a "\"How can I put this simply...\""
    a "\"Como eu posso explicar de um jeito simples...\""

# game/a1s1.rpy:1081
translate pt_br a1s1_a366f2f7:

    # a "\"There are three levels in the {i}Galaxias{/i}. At the very top are the parents. They arrived from beyond our galaxy to spread their culture here.\""
    a "\"Existem três níveis hierárquicos na {i}congregação galáctica{/i}. No topo ficam os progenitores. Eles vieram de fora da nossa galáxia para disseminar a cultura deles por aqui.\""

# game/a1s1.rpy:1082
translate pt_br a1s1_4ad4d594:

    # "Amicus glances at me."
    "Amicus fixa um olhar em mim."

# game/a1s1.rpy:1083
translate pt_br a1s1_4039690e:

    # a "\"You know what a galaxy is, that there are others outside of our own?\""
    a "\"Você sabe o que é uma galáxia e que existem outras além da nossa?\""

# game/a1s1.rpy:1084
translate pt_br a1s1_c806ebc0:

    # m "\"Yeah.\""
    m "\"Sim.\""

# game/a1s1.rpy:1086
translate pt_br a1s1_670bed70:

    # "Amicus lets out a breathy chuckle."
    "Amicus solta uma risadinha ofegante."

# game/a1s1.rpy:1087
translate pt_br a1s1_55d88b3e:

    # a "\"Of course, I probably should have expected that. So you must know then that intergalactic travel is incredibly advanced, almost god-like and that's what they are—\""
    a "\"É claro, eu já devia esperar isso. Você deve saber então que viagem intergaláctica é incrivelmente avançada, quase uma coisa limitada a deuses, e é exatamente isso o que eles são—\""

# game/a1s1.rpy:1088
translate pt_br a1s1_c594d0e2:

    # a "\"—Gods. There are eight of them that are still present in our Galaxy, though they rarely communicate with us these days\""
    a "\"—Deuses. Há 8 deles presentes na nossa galáxia. Apesar disso, eles raramente se comunicam conosco nos dias de hoje.\""

# game/a1s1.rpy:1089
translate pt_br a1s1_8f680690:

    # a "\"Then there are the siblings. That's what my species is a part of. The galaxy was scoped out by the parents at the very start to find the most intelligent and capable species.\""
    a "\"Depois, temos a {i}irmandade{/i}. É o grupo em que a minha espécie se encontra. A galáxia foi inspecionada pelos progenitores desde o início para encontrar as espécies mais inteligentes e capazes.\""

# game/a1s1.rpy:1090
translate pt_br a1s1_61dfd3ff:

    # a "\"They each selected one, and we were the ones chosen and uplifted by the Romanus.\""
    a "\"Cada um deles escolheu uma espécie diferente, nós lobos fomos escolhidos e elevados por Romanus.\""

# game/a1s1.rpy:1091
translate pt_br a1s1_c619cdb1:

    # "The note of pride in Amicus's voice is obvious."
    "O tom de orgulho na voz do Amicus é bem óbvio."

# game/a1s1.rpy:1092
translate pt_br a1s1_635ad1d4:

    # a "\"From then on it has been our mission to increase intelligence in promising species and to teach them our philosophy and culture, to uplift.\""
    a "\"Desde então, tem sido nossa missão elevar a inteligência de espécies promissoras e ensiná-las nossa filosofia e cultura, isso se chama elevar uma espécie.\""

# game/a1s1.rpy:1093
translate pt_br a1s1_27e1df5d:

    # "I try to make sense of that in terms I can understand."
    "Eu tento fazer sentido disso em termos que eu consiga entender."

# game/a1s1.rpy:1094
translate pt_br a1s1_f7cd4eb2:

    # m "\"So you spread their culture for the parents? They're like your God and your species are like missionaries?\""
    m "\"Então vocês disseminam a cultura do povo de vocês servindo os progenitores? Eles são tipo os deuses e sua espécie os missionários?\""

# game/a1s1.rpy:1095
translate pt_br a1s1_f887bb98:

    # "Amicus shrugs."
    "Amicus dá de ombros."

# game/a1s1.rpy:1096
translate pt_br a1s1_ed35e5da:

    # a "\"Yeah, sort of like that.\""
    a "\"Sim, algo desse tipo.\""

# game/a1s1.rpy:1097
translate pt_br a1s1_5e7f358c:

    # "That doesn't sound so great, especially when I compare it to things that have happened on Earth."
    "Isso não parece tão legal, especialmente quando comparo com coisas que aconteceram na Terra."

# game/a1s1.rpy:1098
translate pt_br a1s1_e1a51d7b:

    # "Mass galactic assimilation..."
    "Assimilação galáctica em massa..."

# game/a1s1.rpy:1099
translate pt_br a1s1_f28e91c5:

    # m "\"So...why are they doing this? If they got here at the same time and did the same thing, does that mean they're working together—\""
    m "\"Então... por que eles estão fazendo isso? Se eles chegaram aqui ao mesmo tempo e fizeram a mesma coisa, isso significa que estão trabalhando juntos?—\""

# game/a1s1.rpy:1100
translate pt_br a1s1_3122b23f:

    # "Amicus shakes his head."
    "Amicus balança a cabeça em negação."

# game/a1s1.rpy:1101
translate pt_br a1s1_9247501e:

    # a "\"We don't really know all of the reasons for what the parents do, but we compete with the other siblings.\""
    a "\"Nós não sabemos de fato todas as razões por trás das decisões dos progenitores, mas competimos com os outros irmãos.\""

# game/a1s1.rpy:1102
translate pt_br a1s1_8a3b9f50:

    # a "\"But that brings me to the rest of the Sapients in the galaxy; the children. The siblings uplift these children and bring them into our fold under the direction of our parents.\""
    a "\"E isso me leva ao resto dos sapientes na galáxia: os {i}infantes{/i}. A irmandade eleva esses infantes e os adiciona à nossa hierarquia sob a direção dos progenitores.\""

# game/a1s1.rpy:1103
translate pt_br a1s1_13387842:

    # a "\"Again, they haven't told us exactly what's going on, but we came to the conclusion that it's some sort of competition, and we mean to win for our parents.\""
    a "\"Mais uma vez, eles não nos disseram exatamente o que está acontecendo, mas nós chegamos à conclusão de que é alguma espécie de competição e que nós somos responsáveis por ganhar para o nosso progenitor em questão.\""

# game/a1s1.rpy:1104
translate pt_br a1s1_9ac126e6:

    # m "\"So, I'm a...child?\""
    m "\"Então, eu sou um... infante?\""

# game/a1s1.rpy:1106
translate pt_br a1s1_52720943:

    # a "\"Well...no, not really. I've been calling you that, but you're not part of the {i}Galaxias{/i}, and that's where I've made my mistake.\""
    a "\"Bem... não, na verdade não. Eu venho te chamando disso, mas você não faz parte da {i}congregação galáctica{/i}, e foi aí que eu pisei na bola.\""

# game/a1s1.rpy:1108
translate pt_br a1s1_57a4b39c:

    # a "\"Like I said, it was illegal for me to contact you, but I didn't know.\""
    a "\"Como eu disse, era ilegal entrar em contato com você, mas eu não sabia disso.\""

# game/a1s1.rpy:1109
translate pt_br a1s1_13508b9d:

    # m "\"How did you not know that? Shouldn't you have a...record of this type of stuff?\""
    m "\"Como você não sabia disso? Você não deveria ter um... registro desse tipo de coisa?\""

# game/a1s1.rpy:1110
translate pt_br a1s1_39c46f91:

    # a "\"That's the confusing part to me. I found Earth in the Library, so there was a record of it, but there wasn't much. Just a few footnotes about a sapient species there.\""
    a "\"Essa é a parte que me deixa confuso. Eu encontrei a Terra no arquivo, então havia um registro, mas sem muita informação. Só algumas notas de rodapé sobre uma espécie sapiente vivendo lá.\""

# game/a1s1.rpy:1111
translate pt_br a1s1_6ff16e36:

    # a "\"But because that record exists, I know that your species was uplifted to child status at some point.\""
    a "\"E pela existência desse registro é que eu sei que sua espécie foi elevada ao status de infante em algum momento.\""

# game/a1s1.rpy:1112
translate pt_br a1s1_75c6be41:

    # m "\"In Rome?\""
    m "\"Em Roma?\""

# game/a1s1.rpy:1113
translate pt_br a1s1_7072f7b6:

    # a "\"Presumably, but sometimes the species is unable to be uplifted for different reasons; too aggressive, too docile, too unintelligent.\""
    a "\"Presumivelmente, mas algumas vezes as espécies ficam incapazes de passar pela elevação por diferentes razões: muito agressivas, muito dóceis, pouco inteligentes.\""

# game/a1s1.rpy:1114
translate pt_br a1s1_4ad4d594_1:

    # "Amicus glances at me."
    "Amicus lança um olhar em mim."

# game/a1s1.rpy:1115
translate pt_br a1s1_c5c3332b:

    # a "\"I thought this is what happened to your species.\""
    a "\"Eu acho que foi isso que aconteceu com a sua espécie.\""

# game/a1s1.rpy:1116
translate pt_br a1s1_0be68fb6:

    # m "\"Then if we've been uplifted doesn't that mean that you've already made First Contact?\""
    m "\"Então, se nós já fomos elevados, isso não significa que o primeiro contato já foi feito?\""

# game/a1s1.rpy:1117
translate pt_br a1s1_9a0ba985:

    # a "\"Yes, but you're still not part of the Galaxias. That's why I made the mistake. You {i}should{/i} know about it, but you don't. Knowledge of other intelligent life is sacred and for whatever reason your species lost it.\""
    a "\"Sim, mas vocês ainda não fazem parte da congregação galáctica. Foi por isso que eu errei. Vocês {i}deveriam{/i} saber disso, mas não sabem. O conhecimento sobre outras formas de vida inteligente é sagrado e, por algum motivo, sua espécie perdeu esse conhecimento.\""

# game/a1s1.rpy:1118
translate pt_br a1s1_222f62dc:

    # a "\"So it doesn't matter that we've made contact before; if the knowledge of the {i}Galaxias{/i} has been lost, then any form of communication between us is First Contact all over again.\""
    a "\"Portanto, não importa se nós já fizemos contato antes; se o conhecimento sobre a {i}congregação galáctica{/i} foi perdido, então qualquer forma de contato entre nós é primeiro contato outra vez.\""

# game/a1s1.rpy:1119
translate pt_br a1s1_392197d0:

    # a "\"And while uplift has been canceled with species in the past, we don't completely cut off contact; they're permanently part of the {i}Galaxias{/i}. I've never heard of something like this happening before, so I panicked. Com—\""
    a "\"E, por mais que a elevação tenha sido cancelada com outras espécies antes, não cortamos contato por completo; elas se tornam parte da {i}congregação galáctica{/i}. Eu nunca tinha visto um caso como o da sua espécie, então entrei em pânico. O Com—\""

# game/a1s1.rpy:1120
translate pt_br a1s1_fb1be156:

    # "Amicus glances at the ceiling."
    "Amicus olha para o teto."

# game/a1s1.rpy:1121
translate pt_br a1s1_82350eb8:

    # a "\"—wasn't able to tell me that until he connected to your Nexus.\""
    a "\"—não foi capaz de me informar sobre isso até se conectar com o nexus do seu planeta.\""

# game/a1s1.rpy:1122
translate pt_br a1s1_6d4e410e:

    # m "\"Nexus?\""
    m "\"Nexus?\""

# game/a1s1.rpy:1123
translate pt_br a1s1_e6d6088e:

    # "Another word that doesn't translate."
    "Outra palavra que não traduz."

# game/a1s1.rpy:1124
translate pt_br a1s1_48340125:

    # a "\"Like, the technology that connects places, people, information—\""
    a "\"É como... a tecnologia que conecta lugares, pessoas, informação—\""

# game/a1s1.rpy:1125
translate pt_br a1s1_626d9018:

    # m "\"The internet?\""
    m "\"Internet?\""

# game/a1s1.rpy:1126
translate pt_br a1s1_7d75dc6c:

    # a "\"If that's your word for it.\""
    a "\"Se é essa a palavra que vocês usam...\""

# game/a1s1.rpy:1127
translate pt_br a1s1_fd7e81eb:

    # m "\"So...\""
    m "\"Então...\""

# game/a1s1.rpy:1128
translate pt_br a1s1_98b63e80:

    # "I try to understand everything I'm being told."
    "Eu tento entender tudo o que está sendo dito a mim."

# game/a1s1.rpy:1129
translate pt_br a1s1_38d8cc39:

    # m "\"Why didn't you just tell me all of this before you kidnapped me...or knocked me out.\""
    m "\"Por que você só não contou tudo isso pra mim de uma vez antes de me sequestrar... ou nocautear.\""

# game/a1s1.rpy:1130
translate pt_br a1s1_1d3dd843:

    # "I see Amicus's ears flatten and he looks away, clearly ashamed."
    "Eu vejo as orelhas do Amicus caírem enquanto ele desvia o olhar, claramente envergonhado."

# game/a1s1.rpy:1131
translate pt_br a1s1_846465a3:

    # a "\"I don't know. I didn't fully understand the intelligence of your species yet. I thought I could just...lead you to believe things.\""
    a "\"Eu não sei. Ainda não tinha conhecimento da capacidade intelectual da sua espécie. Eu achei que poderia apenas... convencer você a acreditar em coisas.\""

# game/a1s1.rpy:1132
translate pt_br a1s1_0180610d:

    # "I don't say anything and Amicus shifts uncomfortably."
    "Não digo nada e o Amicus se mexe desconfortavelmente."

# game/a1s1.rpy:1133
translate pt_br a1s1_6b053d84:

    # a "\"Leaving you on Earth after you saw me...you might have gone to the authorities on your planet with that knowledge which might have lead to a Monitor being alerted.\""
    a "\"Deixar você na Terra depois de me ver... você provavelmente teria avisado às autoridades do seu planeta e isso poderia fazer com que um monitor fosse alertado.\""

# game/a1s1.rpy:1134
translate pt_br a1s1_e27fdc8d:

    # "Amicus answers my question before I can ask it."
    "Amicus responde à minha pergunta antes que eu possa perguntá-la."

# game/a1s1.rpy:1135
translate pt_br a1s1_daea3945:

    # a "\"Monitors are basically the ears and eyes of the parents. They monitor the galaxy.\""
    a "\"Monitores são basicamente os olhos e ouvidos dos progenitores. Eles monitoram a galáxia.\""

# game/a1s1.rpy:1136
translate pt_br a1s1_dfb54641:

    # m "\"And what happens if they're alerted?\""
    m "\"E o que acontece se eles forem alertados?\""

# game/a1s1.rpy:1137
translate pt_br a1s1_6d85daed:

    # "Amicus sighs deeply."
    "Amicus suspira profundamente."

# game/a1s1.rpy:1138
translate pt_br a1s1_02271e86:

    # a "\"I don't know. It hasn't happened in a long time and I don't think anyone has ever broken this particular law. It's one of the most important laws we're supposed to follow. Knowing I'd broken it...\""
    a "\"Eu não sei. Isso não acontece há muito tempo e eu acho que ninguém jamais violou esta lei em particular. É uma das leis mais importantes que nós devemos seguir. Saber que eu tinha violado essa lei...\""

# game/a1s1.rpy:1139
translate pt_br a1s1_54bca475_1:

    # "Amicus pauses."
    "Amicus pausa."

# game/a1s1.rpy:1140
translate pt_br a1s1_f8f87ce5:

    # m "\"Scared you?\""
    m "\"Te assustou?\""

# game/a1s1.rpy:1141
translate pt_br a1s1_8f726726:

    # "Amicus shakes his head but doesn't say anything."
    "Amicus balança a cabeça em afirmação, mas não fala nada."

# game/a1s1.rpy:1142
translate pt_br a1s1_fedb4933:

    # "I try to piece all of this together in my head."
    "Eu tento juntar todos os pedaços disso na minha cabeça."

# game/a1s1.rpy:1143
translate pt_br a1s1_dec48a5e:

    # m "\"So then you panicked and kidnapped me?\""
    m "\"Então você entrou em pânico e me sequestrou?\""

# game/a1s1.rpy:1144
translate pt_br a1s1_ca821773:

    # a "\"It was either that or kill you...or leave you and hope for the best, but that was a risk that I felt I couldn't take at the time.\""
    a "\"Era fazer isso ou te matar... ou deixar você lá e torcer pelo melhor, mas esse era um risco que eu achava que não podia correr no momento.\""

# game/a1s1.rpy:1145
translate pt_br a1s1_1c4605d3:

    # "Amicus seems to shrink in his seat."
    "Amicus parece se encolher em seu assento."

# game/a1s1.rpy:1146
translate pt_br a1s1_d53ef6e5:

    # a "\"And I guess I just didn't want to tell you because I knew I'd disrupted your life in a terrible way...I thought I might be able to make you forget and want to stay with me if you saw my home.\""
    a "\"Acho que só não queria contar a você porque sabia que tinha interrompido sua vida de uma maneira terrível... Pensei que seria capaz de fazer você esquecer e querer ficar comigo se visse minha casa.\""

# game/a1s1.rpy:1147
translate pt_br a1s1_a5b92aaa:

    # m "\"But why? Why did you do it in the first place? What do you want from me?\""
    m "\"Mas por que? Por que você fez isso em primeiro lugar? O que você quer comigo?\""

# game/a1s1.rpy:1148
translate pt_br a1s1_a5ebcc0b:

    # "Amicus looks at me for a long while, probably debating on how much to tell me, then he turns away."
    "Amicus olha para mim por um longo momento, provavelmente pensando no quanto pode me dizer, depois volta à posição anterior."

# game/a1s1.rpy:1149
translate pt_br a1s1_ca8be25f:

    # a "\"I needed a pet.\""
    a "\"Eu queria um mascote.\""

# game/a1s1.rpy:1150
translate pt_br a1s1_61d5f247:

    # m "\"Excuse me?\""
    m "\"Como é?\""

# game/a1s1.rpy:1151
translate pt_br a1s1_e9a7f917:

    # "Amicus shrinks up even more in his chair."
    "Amicus se encolhe ainda mais em sua cadeira."

# game/a1s1.rpy:1152
translate pt_br a1s1_d6e9d058:

    # a "\"It's a very long story.\""
    a "\"É uma longa história.\""

# game/a1s1.rpy:1153
translate pt_br a1s1_57c93327:

    # "I glare at the back of his head."
    "Eu fico encarando a parte de trás da cabeça dele."

# game/a1s1.rpy:1154
translate pt_br a1s1_1fba1f80:

    # m "\"Well, if we're going to be here a while then I have time.\""
    m "\"Pode contar, se a gente vai ficar aqui por um tempo, então eu posso ouvir.\""

# game/a1s1.rpy:1155
translate pt_br a1s1_59e1c99b:

    # "Amicus goes on staring out the window."
    "Amicus volta a olhar para a janela."

# game/a1s1.rpy:1156
translate pt_br a1s1_301e94d3:

    # a "\"My father was the emperor. The throne was mine to take, but my brother has challenged me, so now we're both competing for it.\""
    a "\"Meu pai era o imperador. O trono era meu para governar, mas meu irmão me desafiou, então agora nós estamos competindo por ele.\""

# game/a1s1.rpy:1157
translate pt_br a1s1_5295c07b:

    # "Amicus looks at me out of the corner of his eye for my reaction."
    "Amicus olha de soslaio na minha direção para ver como eu reajo."

# game/a1s1.rpy:1158
translate pt_br a1s1_a5e86746:

    # "His expression tells me I should be impressed, but learning he might be an influential figure among his people doesn't really seem too crazy after the events of the past day or so."
    "A expressão dele me diz que eu deveria estar impressionado, mas aprender que ele é uma figura de influência entre seu povo não soa tão maluco depois dos eventos desse dia."

# game/a1s1.rpy:1159
translate pt_br a1s1_b7fd9907:

    # m "\"And getting a 'pet' will help you how?\""
    m "\"E ter um \"mascote\" vai te ajudar como?\""

# game/a1s1.rpy:1160
translate pt_br a1s1_b902c878:

    # a "\"My brother has one...a sibling species, which means that his pet is on the same level of the hierarchy as us.\""
    a "\"Meu irmão tem um... de uma espécie da irmandade, o que significa que o mascote dele está no mesmo nível de hierarquia que nós.\""

# game/a1s1.rpy:1161
translate pt_br a1s1_e499761a:

    # "I frown."
    "Eu levanto uma sobrancelha."

# game/a1s1.rpy:1162
translate pt_br a1s1_5e66bbc7:

    # m "\"Oh? And that's unusual?\""
    m "\"E isso é incomum?\""

# game/a1s1.rpy:1163
translate pt_br a1s1_c02d8683:

    # a "\"Definitely. It shouldn't even be legal, but somehow he {i}negotiated{/i} it. They signed a contract and everything.\""
    a "\"Definitivamente. Não deveria nem ser legal, mas de algum jeito ele {i}negociou{/i} o mascote. Assinaram um contrato e tudo.\""

# game/a1s1.rpy:1164
translate pt_br a1s1_6a20a80d:

    # "I shake my head."
    "Eu balanço minha cabeça."

# game/a1s1.rpy:1165
translate pt_br a1s1_f5cfbdcd:

    # m "\"So what does having a pet do?\""
    m "\"Então, o que um mascote faz?\""

# game/a1s1.rpy:1166
translate pt_br a1s1_f887bb98_1:

    # "Amicus shrugs."
    "Amicus encolhe os ombros."

# game/a1s1.rpy:1167
translate pt_br a1s1_df4a18ee:

    # a "\"It's a good status symbol to have. The fact that my brother was able to obtain such a prestigious pet shows his skill at negotiation and has put me at a huge disadvantage.\""
    a "\"É um bom símbolo de status para se ter. O fato de que meu irmão foi capaz de obter um mascote tão prestigioso põe em evidência suas habilidades de negociação e isso me deixa em grande desvantagem.\""

# game/a1s1.rpy:1168
translate pt_br a1s1_24a774ec:

    # a "\"I needed to do something even more grand to impress my father's advisor. He's the one that will choose between us.\""
    a "\"Eu precisava fazer algo ainda mais grandioso para impressionar o conselheiro do meu pai. Ele é quem vai escolher entre mim e meu irmão.\""

# game/a1s1.rpy:1169
translate pt_br a1s1_669cc616:

    # m "\"By kidnapping me?\""
    m "\"E você ia impressionar ele me sequestrando?\""

# game/a1s1.rpy:1170
translate pt_br a1s1_2df92d67:

    # "Amicus growls."
    "Amicus resmunga."

# game/a1s1.rpy:1171
translate pt_br a1s1_a77916e8:

    # a "\"That wasn't part of the plan. I thought you'd know what I was and be amazed that a Wolf had come back to your species.\""
    a "\"Isso não fazia parte do plano. Eu achei que você saberia o que eu era e ficaria maravilhado com um lobo voltando por sua espécie.\""

# game/a1s1.rpy:1172
translate pt_br a1s1_dd423124:

    # a "\"I was going to make a deal with you, like my brother did with his pet. I wanted a sapient that no one had seen in a long time.\""
    a "\"Eu ia fazer um acordo com você, como meu irmão fez com o mascote dele. Eu queria um sapiente que ninguém viu há muito tempo.\""

# game/a1s1.rpy:1177
translate pt_br a1s1_f0acabc1:

    # "So that's why I'm here; to be used as some pawn in some power struggle in some alien empire far away?"
    "Então é por isso que eu estou aqui; ser usado como um peão em uma luta pelo poder de um império alienígena distante?"

# game/a1s1.rpy:1178
translate pt_br a1s1_f5aa93b2:

    # m "\"So why can't you take me back? What if I promise not to say anything?\""
    m "\"Então por que você não pode me levar de volta? E se eu prometer não falar nada pra ninguém?\""

# game/a1s1.rpy:1179
translate pt_br a1s1_875dd49e:

    # a "\"I...would take you back if I could. I realize now that that would have been the better option, but I can't.\""
    a "\"Eu... te levaria de volta se eu pudesse. Eu percebo agora que teria sido a melhor opção, mas eu não posso.\""

# game/a1s1.rpy:1180
translate pt_br a1s1_2558be92_1:

    # m "\"Why not?\""
    m "\"Por que não?\""

# game/a1s1.rpy:1182
translate pt_br a1s1_0fca803d:

    # a "\"First of all, the ship might be damaged beyond repair. Secondly, there isn't enough power to get back. Earth was on the outer reaches of how far I could travel. I need the rest to return home.\""
    a "\"Primeiro de tudo, a nave foi danificada demais. Segundo, não há energia suficiente para voltar. A Terra estava nos limites externos do quão longe eu podia viajar. Eu preciso do resto para voltar para casa.\""

# game/a1s1.rpy:1183
translate pt_br a1s1_16c59561:

    # "I manage to stop myself from telling the wolf that all of this is his fault and shouldn't be my problem at all."
    "Eu consigo evitar dizer para o lobo que tudo isso é culpa dele e não deveria ser problema meu."

# game/a1s1.rpy:1184
translate pt_br a1s1_7690c5ed:

    # m "\"Well, can we get more power when we get to your home, then go back to Earth?\""
    m "\"A gente não pode pegar mais energia quando voltar pra sua casa e depois voltar pra Terra?\""

# game/a1s1.rpy:1185
translate pt_br a1s1_d90afce6:

    # a "\"No, it's...it's a type of power that the parents produce. We're not able to harness it...yet.\""
    a "\"Não, isso é... é um tipo de energia que só os progenitores conseguem produzir. Nós não somos capazes de fabricar... ainda.\""

# game/a1s1.rpy:1186
translate pt_br a1s1_8a740824:

    # m "\"So get more from them, from wherever you got the power in the first place.\""
    m "\"Então pede mais pra eles, do mesmo lugar que você pegou a energia antes.\""

# game/a1s1.rpy:1188
translate pt_br a1s1_07745109:

    # "Amicus leans his head against the headrest."
    "Amicus encosta a cabeça na cadeira."

# game/a1s1.rpy:1189
translate pt_br a1s1_c88d4de4:

    # a "\"Our parents authorizes and distributes it, and for whatever reason, they stopped supplying it when we lost our emperor.\""
    a "\"Nossos progenitores que a autorizam e distribuem e, seja lá qual for o motivo, eles pararam de fornecer quando nós perdemos o imperador.\""

# game/a1s1.rpy:1190
translate pt_br a1s1_73e42e69:

    # "I feel myself growing more and more frustrated."
    "Eu sinto minha frustração aumentando cada vez mais."

# game/a1s1.rpy:1191
translate pt_br a1s1_1f0624bf:

    # m "\"Then how the hell are you using it now?\""
    m "\"Então como diabos você tá usando ela agora?\""

# game/a1s1.rpy:1192
translate pt_br a1s1_f5f4dc21:

    # "A moment of silence goes by."
    "Um momento de silêncio se passa."

# game/a1s1.rpy:1193
translate pt_br a1s1_19effa26:

    # a "\"This was my father's ship. Only the emperor has constant access to the technology. I...borrowed it to get to you.\""
    a "\"Essa era a nave do meu pai. Só o imperador tem constante acesso à tecnologia. Eu... peguei ela emprestada para chegar até você.\""

# game/a1s1.rpy:1194
translate pt_br a1s1_af78b41c_1:

    # "I glare at him."
    "Eu olho feio para ele."

# game/a1s1.rpy:1195
translate pt_br a1s1_75bbb209:

    # m "\"You mean stole it? You know, you're pretty dishonest for someone who says they never lie.\""
    m "\"Você quis dizer \"roubei\"? Sabe, você é bem desonesto pra alguém que diz que nunca mente.\""

# game/a1s1.rpy:1197
translate pt_br a1s1_c592f25a:

    # "Another soft, rumbling growl from him."
    "Outro rosnado suave e estridente pode ser ouvido da boca dele."

# game/a1s1.rpy:1198
translate pt_br a1s1_0ef784a3:

    # a "\"Times are desperate.\""
    a "\"Dá um tempo!\""

# game/a1s1.rpy:1199
translate pt_br a1s1_ae3bea37:

    # m "\"Ask your dad to take me back, then.\""
    m "\"Pede pro seu pai me levar de volta, então.\""

# game/a1s1.rpy:1200
translate pt_br a1s1_c537b6ab:

    # a "\"If you didn't gather from earlier, he's dead. So no one has access to it right now...I'm just using up what was left.\""
    a "\"Se você não entendeu ainda, ele está morto. Então ninguém tem acesso à tecnologia agora... Eu só estou usando o que sobrou.\""

# game/a1s1.rpy:1201
translate pt_br a1s1_81a185a8:

    # "I stare at Amicus for a while, words failing me."
    "Eu fico encarando o Amicus por um momento, as palavras me falhando."

# game/a1s1.rpy:1202
translate pt_br a1s1_7e4cc33e:

    # a "\"Listen, I didn't want to do all those things I did to you. I'm protecting us both.\""
    a "\"Escuta, eu não quis fazer todas essas coisas que eu fiz com você. Estou protegendo a nós dois.\""

# game/a1s1.rpy:1203
translate pt_br a1s1_e33f02ef:

    # "I laugh."
    "Eu solto uma risada."

# game/a1s1.rpy:1204
translate pt_br a1s1_de93a4a7:

    # m "\"Oh, really?\""
    m "\"Nossa, é mesmo?\""

# game/a1s1.rpy:1205
translate pt_br a1s1_4495ce05:

    # a "\"Yes! I was planning to bring you to the palace to live a good life and forget your old one...then when you started asking those questions I realized your intelligence is much higher than I thought it would be. Then Com thought you might attack me...I made mistakes.\""
    a "\"Sim! Eu planejava levar você para o palácio, para viver uma boa vida e esquecer da sua antiga... quando você começou a fazer aquelas perguntas eu percebi que sua inteligência é muito maior do que eu pensava. Depois Com pensou que você ia me atacar... eu fiz merda.\""

# game/a1s1.rpy:1207
translate pt_br a1s1_d1a4dc23:

    # "Amicus lets out another huge sigh and slumps in the seat, looking away."
    "Amicus solta outro suspiro enorme e se afunda no assento, olhando para longe."

# game/a1s1.rpy:1208
translate pt_br a1s1_4222a394:

    # "Several minutes go by in silence, both of us staring out into the eerie blue."
    "Vários minutos se passam em silêncio, ambos encarando o azul misterioso."

# game/a1s1.rpy:1209
translate pt_br a1s1_6795a6f1:

    # m "\"So what now? What are your plans?\""
    m "\"Então, o que acontece agora? Quais são os seus planos?\""

# game/a1s1.rpy:1210
translate pt_br a1s1_979ad8ae:

    # "Amicus is the one to laugh this time."
    "Amicus é quem começa a rir dessa vez."

# game/a1s1.rpy:1212
translate pt_br a1s1_ea8f4e03:

    # a "\"Get out of these bonds, if you'd let me.\""
    a "\"Sair dessas amarras, se você deixar.\""

# game/a1s1.rpy:1213
translate pt_br a1s1_1e0866bf:

    # "I look at him incredulously."
    "Eu lanço um olhar incrédulo nele."

# game/a1s1.rpy:1215
translate pt_br a1s1_f334dfb6:

    # "Amicus sighs."
    "Amicus suspira."

# game/a1s1.rpy:1216
translate pt_br a1s1_97bb4540:

    # a "\"Listen, you have no idea how to handle this ship. I can at least run diagnostics to see what we can do about this.\""
    a "\"Escuta, você não faz ideia de como manejar essa nave. Eu posso pelo menos executar os diagnósticos para ver o que podemos fazer.\""

# game/a1s1.rpy:1217
translate pt_br a1s1_f5fc74a4:

    # m "\"What's to stop you from knocking me out again?\""
    m "\"E o que vai te impedir de me nocautear de novo?\""

# game/a1s1.rpy:1218
translate pt_br a1s1_89843a26:

    # a "\"If you don't attack me or hit me with the Nervo again, then I won't have to.\""
    a "\"Se você não me atacar com o {i}nervo{/i} de novo, então eu não vou precisar.\""

# game/a1s1.rpy:1219
translate pt_br a1s1_1a929e36:

    # "I look to my left armrest and pick up the little taser device."
    "Olho para o apoio de braço esquerdo da cadeira e pego o pequeno dispositivo que parece um taser."

# game/a1s1.rpy:1220
translate pt_br a1s1_45972660:

    # m "\"This?\""
    m "\"Isso aqui?\""

# game/a1s1.rpy:1222
translate pt_br a1s1_9ad83078:

    # "Amicus eyes it uneasily."
    "Amicus encara aflito o dispositivo."

# game/a1s1.rpy:1223
translate pt_br a1s1_a61ebafe:

    # a "\"Yeah...\""
    a "\"Sim...\""

# game/a1s1.rpy:1224
translate pt_br a1s1_9943ddc6:

    # m "\"How can I trust you after everything that's happened?\""
    m "\"Por que eu deveria confiar em você depois de tudo o que aconteceu?\""

# game/a1s1.rpy:1225
translate pt_br a1s1_4f2092c2:

    # a "\"I give you my word.\""
    a "\"Eu lhe dou minha palavra.\""

# game/a1s1.rpy:1226
translate pt_br a1s1_e499761a_1:

    # "I frown."
    "Eu arqueio as sobrancelhas."

# game/a1s1.rpy:1227
translate pt_br a1s1_d2b6b47a:

    # m "\"And you could go back on it just as easily.\""
    m "\"E você pode voltar atrás com a mesma facilidade.\""

# game/a1s1.rpy:1229
translate pt_br a1s1_93d01137:

    # a "\"I would never do that! I don't make promises lightly, [mc].\""
    a "\"Eu jamais faria isso! Não faço promessas em vão, [mc].\""

# game/a1s1.rpy:1230
translate pt_br a1s1_215d03c2:

    # "Amicus is so indignant that I actually believe him."
    "Amicus fica tão indignado com isso que eu acredito nele."

# game/a1s1.rpy:1231
translate pt_br a1s1_29333bbf:

    # "Or he's just a really good actor."
    "Ou isso só significa que ele é um ótimo ator."

# game/a1s1.rpy:1232
translate pt_br a1s1_2a6088ff:

    # "Either way, I'm going to have to let him go at some point, especially if we really can't get back to Earth."
    "De qualquer forma, eu realmente vou ter que soltá-lo alguma hora, especialmente se quiser voltar para a Terra."

# game/a1s1.rpy:1233
translate pt_br a1s1_a4e12baa:

    # "So I make my decision."
    "Então eu tomo minha decisão."

# game/a1s1.rpy:1234
translate pt_br a1s1_a008448f:

    # m "\"If I let you go, you have to find a way to get me back to Earth.\""
    m "\"Se eu te soltar, você vai ter que achar um jeito de me levar de volta pra Terra.\""

# game/a1s1.rpy:1236
translate pt_br a1s1_fb81144d:

    # "Amicus thinks for a moment."
    "Amicus pensa por um momento."

# game/a1s1.rpy:1237
translate pt_br a1s1_2c36f1a9:

    # a "\"I can do that if I become emperor.\""
    a "\"Eu posso fazer isso se eu me tornar imperador.\""

# game/a1s1.rpy:1238
translate pt_br a1s1_0d4dae44:

    # m "\"And how long will that take?\""
    m "\"E quanto tempo isso vai levar?\""

# game/a1s1.rpy:1239
translate pt_br a1s1_f887bb98_2:

    # "Amicus shrugs."
    "Amicus dá de ombros."

# game/a1s1.rpy:1240
translate pt_br a1s1_51161834:

    # a "\"A few months if all goes well. With your help it could be even faster. You're...very clever. More intelligent than some wolves I know, even.\""
    a "\"Alguns meses se tudo der certo. Com a sua ajuda pode ser ainda mais rápido. Você é muito... esperto. Mais inteligente que alguns lobos que eu conheço, inclusive.\""

# game/a1s1.rpy:1241
translate pt_br a1s1_be8a4a84:

    # m "\"Months? My parents are probably freaking out by now...school starts in a few weeks!\""
    m "\"Meses? Meus pais provavelmente já estão ficando loucos agora... e a faculdade começa em duas semanas!\""

# game/a1s1.rpy:1242
translate pt_br a1s1_bc78ac5f:

    # "All of these things seem so distant now."
    "Todas essas coisas parecem tão distantes agora."

# game/a1s1.rpy:1243
translate pt_br a1s1_e0a11c00:

    # "Amicus frowns."
    "Amicus arqueia as sobrancelhas."

# game/a1s1.rpy:1244
translate pt_br a1s1_afb8ae99:

    # a "\"I'm sorry, but I can't do anything. I need to be an emperor to even talk to the parents.\""
    a "\"Sinto muito, mas eu não posso fazer nada. Eu preciso ser imperador até se eu quiser falar com os progenitores.\""

# game/a1s1.rpy:1245
translate pt_br a1s1_4b66f979:

    # "I think, but again I don't have many options."
    "Eu penso, mas, mais uma vez, não tenho tantas opções."

# game/a1s1.rpy:1246
translate pt_br a1s1_45748d7b:

    # "I look Amicus in the eye."
    "Eu olho para o Amicus diretamente nos olhos."

# game/a1s1.rpy:1247
translate pt_br a1s1_1ff0bd1f:

    # m "\"You promise?\""
    m "\"Você promete?\""

# game/a1s1.rpy:1249
translate pt_br a1s1_13415661:

    # a "\"You have my word.\""
    a "\"Você tem minha palavra.\""

# game/a1s1.rpy:1250
translate pt_br a1s1_304d84c2:

    # "For a moment I sit there, contemplating."
    "Por um momento eu fico sentado, ponderando."

# game/a1s1.rpy:1251
translate pt_br a1s1_b4225f49:

    # "Then I sit up straight."
    "Então corrijo minha postura."

# game/a1s1.rpy:1252
translate pt_br a1s1_67ff07f9:

    # m "\"Alright, stand up.\""
    m "\"Tá certo, levanta.\""

# game/a1s1.rpy:1254
translate pt_br a1s1_47563fc0:

    # "Amicus perks up then hops to his bound feet, almost falling over."
    "Amicus se anima e levanta, equilibrando-se em seus pés atados, quase caindo."

# game/a1s1.rpy:1256
translate pt_br a1s1_a4ac641e:

    # "I'm sure to place the Nervo close by behind me, just in case."
    "Eu me certifico de colocar o nervo atrás de mim, só por precaução."

# game/a1s1.rpy:1257
translate pt_br a1s1_313097f8:

    # "A few minutes later and the wolf is free."
    "Alguns minutos se passam e o lobo está livre."

# game/a1s1.rpy:1259
translate pt_br a1s1_3a039d30:

    # "We both regard each other wearily for a few moments before Amicus finally sighs."
    "Cansados, nós dois nos encaramos por alguns instantes até que o Amicus finalmente suspira."

# game/a1s1.rpy:1260
translate pt_br a1s1_c2ca825f:

    # a "\"Listen, I have no reason to...incapacitate you now that you know everything, but if it makes you feel better you can hang on to the Nervo until we get to Adastra.\""
    a "\"Escuta, eu não tenho razão nenhuma para... incapacitar você, agora que já sabe de tudo. Mas, se isso faz você se sentir melhor, pode ficar com o nervo até chegarmos em Adastra.\""

# game/a1s1.rpy:1261
translate pt_br a1s1_0b848ce8:

    # a "\"That a fair exchange?\""
    a "\"É uma troca justa?\""

# game/a1s1.rpy:1262
translate pt_br a1s1_37a44bcc:

    # "I look back at the little device."
    "Eu olho de volta para o dispositivo."

# game/a1s1.rpy:1263
translate pt_br a1s1_28e9eca7:

    # "While I have little reason to trust Amicus, the wolf has virtually no reason to trust me."
    "Embora eu tenha algum motivo para confiar no Amicus, o lobo tem virtualmente nenhuma razão para confiar em mim."

# game/a1s1.rpy:1264
translate pt_br a1s1_e98ea258:

    # "I consider it, then shake my head."
    "Eu penso um pouco, então balanço minha cabeça."

# game/a1s1.rpy:1265
translate pt_br a1s1_ac33b6fb:

    # m "\"Can we put it away somewhere? I'd rather just not be thinking about it.\""
    m "\"A gente pode guardar ele em outro lugar? Eu prefiro não pensar nisso.\""

# game/a1s1.rpy:1267
translate pt_br a1s1_ef689f1d:

    # "Amicus looks at me in surprise, then rubs his stomach where I jabbed him."
    "Amicus olha para mim, surpreso, então esfrega a barriga na região onde eu o atingi."

# game/a1s1.rpy:1268
translate pt_br a1s1_d5f0f775:

    # a "\"Okay, yeah, that sounds like a deal to me.\""
    a "\"Ok, tudo bem, parece um acordo para mim.\""

# game/a1s1.rpy:1270
translate pt_br a1s1_35dd5f05:

    # "Amicus holds out a paw and I look down at the thick, black pads on his fingers and palm before picking up the Nervo and handing it to him carefully."
    "Amicus estende uma pata e eu observo os dedos e palma da mão grossos, alcochoados e pretos antes de pegar o nervo e o entregar com cuidado."

# game/a1s1.rpy:1271
translate pt_br a1s1_ad1f344e:

    # "For a moment I imagine him immediately turning the thing around and jabbing it into my face, but instead he turns and walks toward the back of the ship."
    "Por um momento, imagino ele imediatamente virando a coisa e espetando na minha cara. Em vez disso, ele se vira e anda em direção à parte traseira da nave."

# game/a1s1.rpy:1273
translate pt_br a1s1_79ff2228:

    # "I notice his stance is slightly bow-legged and he adjusts himself a few times."
    "Eu percebo que a postura dele fica ligeiramente estranha com as pernas arqueadas e ele se ajusta algumas vezes."

# game/a1s1.rpy:1274
translate pt_br a1s1_6f4c20bc:

    # "That makes me feel a little guilty about fighting dirty earlier."
    "Isso faz eu me sentir um pouco culpado por jogar sujo antes."

# game/a1s1.rpy:1275
translate pt_br a1s1_e73c6f47:

    # "But only a little."
    "Mas só um pouco."

# game/a1s1.rpy:1276
translate pt_br a1s1_1af4d09d:

    # "On his way he sweeps up his cape in one fluid motion before wrapping it around his shoulders."
    "No caminho, ele pega a capa e a limpa um pouco em um movimento flúido antes de envolvê-la nos ombros."

# game/a1s1.rpy:1277
translate pt_br a1s1_a1095ca6:

    # "Then he moves to the back wall and, sticking out a paw, he presses a panel and a small portion of the wall slides back, revealing another smaller room."
    "Então ele anda até a parede dos fundos e, estendendo uma pata, pressiona um painel e uma pequena parte da parede desliza para fora, revelando outra sala menor."

# game/a1s1.rpy:1278
translate pt_br a1s1_fcb0a8e0:

    # "From where I am I can see what looks like a little cot and various cupboards."
    "De onde estou, consigo enxergar o que parece uma pequena cama e várias cômodas."

# game/a1s1.rpy:1279
translate pt_br a1s1_a1e911d8:

    # "He opens one of these and places the Nervo inside before shutting it."
    "Ele abre uma delas e coloca o nervo dentro antes de fechar."

# game/a1s1.rpy:1280
translate pt_br a1s1_65cf3021:

    # "He comes back out and notices me staring."
    "Ele volta para o convés e me nota observando."

# game/a1s1.rpy:1282
translate pt_br a1s1_2e46bd5c:

    # a "\"That's my quarters. It's where I sleep. If you, uh, need to urinate or...whatever else you do, there's a toilet in there.\""
    a "\"Esse é meu alojamento. É onde eu durmo. Se você, hã, precisar urinar ou... seja lá o que mais vocês fazem, tem um banheiro lá.\""

# game/a1s1.rpy:1283
translate pt_br a1s1_03425764:

    # m "\"I'm fine for now...\""
    m "\"Tô bem por enquanto...\""

# game/a1s1.rpy:1284
translate pt_br a1s1_11010a2b:

    # "I feel my stomach gurgle, something that it's been doing for a while now."
    "Sinto um ronco no meu estômago, algo que já venho sentindo há algum tempo."

# game/a1s1.rpy:1285
translate pt_br a1s1_36782e7c:

    # m "\"I am a little hungry, though.\""
    m "\"Mas eu tô com um pouco de fome.\""

# game/a1s1.rpy:1286
translate pt_br a1s1_8e4c05e6:

    # "Amicus raises a brow."
    "Amicus levanta uma sobrancelha."

# game/a1s1.rpy:1287
translate pt_br a1s1_74984fcc:

    # a "\"You want to try it again?\""
    a "\"Quer tentar comer de novo?\""

# game/a1s1.rpy:1288
translate pt_br a1s1_7b7bde3d:

    # m "\"...Sure.\""
    m "\"...Tá.\""

# game/a1s1.rpy:1292
translate pt_br a1s1_f38a0a8d:

    # "It's not the worst food I've ever had."
    "Não é a pior comida que eu já comi."

# game/a1s1.rpy:1293
translate pt_br a1s1_e5c20a63:

    # "The earthy smell translates into the taste, but there's a strange hint of sweetness to it, like chocolate and that makes it a little more palatable."
    "O cheiro de terra se traduz no sabor, mas tem um estranho fundo adocicado, que nem chocolate, e isso deixa um pouco mais palatável."

# game/a1s1.rpy:1294
translate pt_br a1s1_c2da015e:

    # "I can at least swallow it down without gagging, so that's good, I guess."
    "Eu consigo pelo menos engolir sem me dar ânsia de vômito, então isso é bom, eu acho."

# game/a1s1.rpy:1295
translate pt_br a1s1_88cf08df:

    # "Amicus has his own cup, though he's paying more attention to the panels than to his food."
    "Amicus segura sua própria caneca, mas ele está prestando mais atenção nos painéis que na comida."

# game/a1s1.rpy:1297
translate pt_br a1s1_786145ac:

    # a "\"I may have been exaggerating a bit earlier. Damage appears to be minimal. We're actually lucky that you didn't lock onto something worse like a pit. There was one very near that star.\""
    a "\"Eu posso ter exagerado um pouco antes. O dano parece ter sido mínimo. Na verdade, nós temos sorte de você não ter mirado em algo pior, como uma cova. Tinha uma bem perto daquela estrela.\""

# game/a1s1.rpy:1298
translate pt_br a1s1_30a93cb2:

    # m "\"A pit?\""
    m "\"Uma cova?\""

# game/a1s1.rpy:1299
translate pt_br a1s1_b0283289:

    # "Amicus shrugs, waving his hand in the air, as if brushing my question aside."
    "Amicus dá de ombros, balançando a mão no ar, como se estivesse pensando mais sobre a pergunta."

# game/a1s1.rpy:1300
translate pt_br a1s1_563cf217:

    # a "\"A very strong gravitational singularity that sucks everything up around it—\""
    a "\"Uma singularidade gravitacional super forte que suga tudo ao seu redor—\""

# game/a1s1.rpy:1301
translate pt_br a1s1_f6d33be0:

    # m "\"Like a black hole?\""
    m "\"Ah, um buraco negro?\""

# game/a1s1.rpy:1302
translate pt_br a1s1_95dd1f3d:

    # a "\"Black hole?\""
    a "\"Buraco negro?\""

# game/a1s1.rpy:1303
translate pt_br a1s1_4e776e18:

    # m "\"Like, its gravity is so powerful that even light gets pulled into it. That's why they're black.\""
    m "\"Tipo, a gravidade é tão poderosa que até a luz é sugada pra dentro dele. Por isso que eles são completamente pretos.\""

# game/a1s1.rpy:1304
translate pt_br a1s1_bbcecb2f:

    # "Amicus looks at me in susprise."
    "Amicus olha para mim, surpreso."

# game/a1s1.rpy:1306
translate pt_br a1s1_4c83ddc4:

    # a "\"Oh, you know what that is? Guess I should stop being surprised, honestly.\""
    a "\"Ah, você sabe o que é? Acho que eu deveria parar de me surpreender, na verdade.\""

# game/a1s1.rpy:1308
translate pt_br a1s1_b4678981:

    # a "\"You humans really are something. You basically uplifted yourselves.\""
    a "\"Os humanos são realmente interessantes. Vocês basicamente elevaram a si mesmos.\""

# game/a1s1.rpy:1309
translate pt_br a1s1_8619f2c6:

    # "I shrug."
    "Eu dou de ombros."

# game/a1s1.rpy:1310
translate pt_br a1s1_299014b4:

    # m "\"We touched on it in my astronomy 101 class. I don't know much about them.\""
    m "\"Falaram sobre isso na aula introdutória de astronomia. Eu não sei muito sobre eles.\""

# game/a1s1.rpy:1311
translate pt_br a1s1_952fec56:

    # a "\"But the fact that your species found out about them in the first place...Anyway—\""
    a "\"Mas só o fato de sua espécie ter descoberto eles em primeiro lugar... Enfim—\""

# game/a1s1.rpy:1313
translate pt_br a1s1_d9425616:

    # "Amicus presses a button before suddenly the hum of the ship comes back to life."
    "Amicus pressiona um botão e, de repente, o zumbido da nave volta à vida."

# game/a1s1.rpy:1314
translate pt_br a1s1_04ea1466:

    # com "\"Systems back online.\""
    com "\"Sistemas de volta online.\""

# game/a1s1.rpy:1315
translate pt_br a1s1_cde03927:

    # a "\"And—\""
    a "\"E—\""

# game/a1s1.rpy:1321
translate pt_br a1s1_abea6c9f:

    # "Amicus pulls the lever and suddenly the blue disappears and the windows are filled with warping stars again."
    "Amicus puxa a alavanca e, de repente, o azul desaparece e as janelas são preenchidas por estrelas esticadas mais uma vez."

# game/a1s1.rpy:1322
translate pt_br a1s1_a1a1db76:

    # "I immediately look away, feeling the chocolate mud start to work its way up my throat."
    "Imediatamente eu desvio o olhar, sentindo a lama de chocolate voltando do meu estômago."

# game/a1s1.rpy:1323
translate pt_br a1s1_813a3f78:

    # a "\"We were actually almost to Adastra when you...took control.\""
    a "\"Na verdade estávamos quase em Adastra quando você... tomou o controle.\""

# game/a1s1.rpy:1324
translate pt_br a1s1_1fb09630:

    # "Amicus rubs the side of his neck, wincing as he stretches it out."
    "Amicus esfrega a lateral do pescoço, tremendo de aflição enquanto o alonga."

# game/a1s1.rpy:1325
translate pt_br a1s1_9cea1886:

    # a "\"Should be there fairly soon.\""
    a "\"Devemos chegar lá em breve.\""

# game/a1s1.rpy:1326
translate pt_br a1s1_a4e2bc7d:

    # m "\"What is this.\""
    m "\"O que é isso.\""

# game/a1s1.rpy:1327
translate pt_br a1s1_0ea100a9:

    # "I wave my hand at the window, not looking."
    "Eu balanço minha mão apontando na janela, sem olhar."

# game/a1s1.rpy:1328
translate pt_br a1s1_56f1ccb2:

    # a "\"The bending light? It's the Stretch Drive. Basically space is being shortened ahead of us—\""
    a "\"A luz esticando? É a dobra espacial. Basicamente, o espaço está sendo reduzido na nossa frente—\""

# game/a1s1.rpy:1329
translate pt_br a1s1_96270e5d:

    # "Amicus puts his paws close together in front of himself."
    "Amicus junta as patas na sua frente."

# game/a1s1.rpy:1330
translate pt_br a1s1_db1a3fd7:

    # a "\"—and stretched out behind us.\""
    a "\"—e se estendendo atrás de nós.\""

# game/a1s1.rpy:1331
translate pt_br a1s1_7fb0886d:

    # "Amicus stretches his paws out wide."
    "Amicus abre as patas no ar."

# game/a1s1.rpy:1332
translate pt_br a1s1_4c4ab36f:

    # a "\"I, uh, don't really know how it works; only the parents can build this kind of tech and it's the only way I could get to Earth, or anywhere outside our star system, really.\""
    a "\"Eu, hã... não sei como funciona realmente; só os progenitores podem construir esse tipo de tecnologia e é o único jeito de chegar à Terra ou qualquer lugar fora do meu sistema estelar.\""

# game/a1s1.rpy:1333
translate pt_br a1s1_9a608588:

    # a "\"They even figured out a way to make time stand still around us when we travel, otherwise waaay too much time would have passed back home.\""
    a "\"Inclusive, eles descobriram um jeito de fazer o tempo parar ao nosso redor enquanto viajamos, caso contrário, muito tempo teria se passado lá em casa.\""

# game/a1s1.rpy:1334
translate pt_br a1s1_38773d0a:

    # "I'm starting to get a picture of how powerful these \"parents\" actually are; beings capable of warping space and time to their will."
    "Eu começo a ter uma ideia de quão poderosos são esses \"progenitores\"; seres capazes de distorcer o tempo e espaço à sua vontade."

# game/a1s1.rpy:1335
translate pt_br a1s1_8a03ef56:

    # m "\"So...how much more time—\""
    m "\"Então... quanto tempo mais vai demorar—\""

# game/a1s1.rpy:1337
translate pt_br a1s1_53507c50:

    # com "\"Arriving at Stella Vita.\""
    com "\"Chegando em Stella Vita.\""

# game/a1s1.rpy:1339
translate pt_br a1s1_a2029dcf:

    # "And just like that the stars become still again."
    "E nesse momento as estrelas ficam paradas de novo."

# game/a1s1.rpy:1340
translate pt_br a1s1_ef76e4fb:

    # "Amicus grins."
    "Amicus sorri."

# game/a1s1.rpy:1341
translate pt_br a1s1_c53bb988:

    # a "\"Welcome to Adastra, [mc].\""
    a "\"Seja bem-vindo a Adastra, [mc].\""

# game/a1s1.rpy:1343
translate pt_br a1s1_31ccc244:

    # "I look out the window and see a large, green and blue sphere shimmer below me."
    "Eu olho pela janela e vejo uma enorme esfera verde e azul brilhando embaixo da nave."

# game/a1s1.rpy:1344
translate pt_br a1s1_f2321a6f:

    # "Beyond it there's another globe, this one chalky and gray."
    "Além dela, há outro globo, este cinza como giz."

# game/a1s1.rpy:1345
translate pt_br a1s1_6c9b88bd:

    # "A smaller and even brighter orb floats further to the right, its color almost pure white."
    "Um orbe um pouco menor e ainda mais brilhante flutua mais à direita, sua cor quase puro branco."

# game/a1s1.rpy:1346
translate pt_br a1s1_6d735c90:

    # "Amicus points at the more Earth-like sphere."
    "Amicus aponta para a esfera mais parecida com a Terra."

# game/a1s1.rpy:1348
translate pt_br a1s1_a1e7b60e:

    # a "\"That specifically is Adastra, the planet to the left is {i}Ancoris{/i}. There aren't many people there aside from miners. The smallest is {i}Torque{/i}, another moon.\""
    a "\"Essa, especificamente, é Adastra, o planeta ao lado é {i}Ancoris{/i}. Não há muitas pessoas lá a não ser mineradores. A menor é {i}Torque{/i}, outra lua.\""

# game/a1s1.rpy:1349
translate pt_br a1s1_5b381c11:

    # a "\"I know you live on a planet, so Adastra might seem a bit small to you.\""
    a "\"Eu sei que você vive em um planeta, então Adastra pode parecer um pouco pequena para você.\""

# game/a1s1.rpy:1350
translate pt_br a1s1_5802e7c0:

    # "I press a hand to the window and notice that it's ice-cold."
    "Eu pressiono uma mão na janela e noto que está fria como gelo."

# game/a1s1.rpy:1351
translate pt_br a1s1_7fbca651:

    # m "\"Looks pretty big from here.\""
    m "\"Parece bem grande daqui.\""

# game/a1s1.rpy:1352
translate pt_br a1s1_ebd15aed:

    # "Amicus leans over the console and starts touching at the screen."
    "Amicus se inclina sobre o painel e começa a tocar na tela."

# game/a1s1.rpy:1353
translate pt_br a1s1_97d616b2:

    # com "\"Re entry sequence engaged.\""
    com "\"Sequência de reentrada ativada.\""

# game/a1s1.rpy:1354
translate pt_br a1s1_49e30f0d:

    # a "\"Go ahead and put your safety straps on. Re-entry is never comfortable in smaller ships.\""
    a "\"Vá em frente e coloque o cinto de segurança. Re-entrada na atmosfera em naves pequenas nunca é confortável.\""

# game/a1s1.rpy:1356
translate pt_br a1s1_99993fde:

    # "I hurriedly do as he says, sitting down and trying to figure out the seatbelt."
    "Rapidamente, faço o que ele pede, me sentando e tentando descobrir como usar o cinto de segurança."

# game/a1s1.rpy:1357
translate pt_br a1s1_c6141103:

    # "Eventually, Amicus has to come over and help, showing me how the strap just feeds into a slot."
    "Eventualmente, Amicus precisa vir me ajudar, me mostrando como o cinto se encaixa perfeitamente em um compartimento."

# game/a1s1.rpy:1358
translate pt_br a1s1_b3c1cd02:

    # "This automatically pulls the straps tightly across my waist and chest."
    "O encaixe automaticamente pressiona o cinto com firmeza na minha cintura e peito."

# game/a1s1.rpy:1359
translate pt_br a1s1_620a887b:

    # "As Amicus gets in his own seat, we start to curve around to the darker side of Adastra."
    "Quando Amicus se senta em seu próprio assento, começamos a contornar o planeta até o lado mais escuro de Adastra."

# game/a1s1.rpy:1363
translate pt_br a1s1_f822a901:

    # "Every now and then there's a bit of a downward tug on my stomach, sort of like when when the passenger jet I was in was landing in Rome."
    "Sinto um frio na barriga ocasionalmente, como quando senti no avião enquanto pousava em Roma."

# game/a1s1.rpy:1364
translate pt_br a1s1_9a354312:

    # "I had imagined that things would rattle around, along with a bunch of fire and heat like in a Hollywood movie."
    "Eu imaginei que as coisas iriam começar a chacoalhar ao redor acompanhadas de um monte de fogo e calor do lado de fora, como em um filme de Hollywood."

# game/a1s1.rpy:1365
translate pt_br a1s1_084e4e08:

    # "Instead, there's only a rumbling sound that accompanies a gentle vibration through the seat."
    "Em vez disso, só tem um som estridente acompanhado de uma vibração suave através do assento."

# game/a1s1.rpy:1366
translate pt_br a1s1_f7e924ea:

    # "There isn't any fire, but I do start to see blue flashes on the otherwise black windows."
    "Não há fogo algum, mas começo a ver flashes azuis nas janelas que antes estavam pretas."

# game/a1s1.rpy:1367
translate pt_br a1s1_e53fd1ba:

    # "I look over at Amicus and see that he's got his eyes closed, looking relaxed."
    "Olho para o Amicus e vejo que ele se encontra de olhos fechados, parecendo bem relaxado."

# game/a1s1.rpy:1368
translate pt_br a1s1_511a7243:

    # m "\"Um...\""
    m "\"Hm...\""

# game/a1s1.rpy:1369
translate pt_br a1s1_755fa1f6:

    # "The wolf opens his eyes and smiles gently at me."
    "O lobo abre os olhos e sorri gentilmente para mim."

# game/a1s1.rpy:1370
translate pt_br a1s1_608c5144:

    # a "\"Don't worry. This is all normal.\""
    a "\"Não se preocupe. Está tudo sob controle.\""

# game/a1s1.rpy:1371
translate pt_br a1s1_8d8c3040:

    # "I realize how nervous I must look, so I nod and lean my head back in the seat."
    "Eu percebo o quão nervoso eu devo estar parecendo, então aceno com a cabeça e em seguida repouso na cadeira."

# game/a1s1.rpy:1373
translate pt_br a1s1_6e06c5a5:

    # "The electric blue flashes stop after a while and then I feel one final downward pull on my body before the rumbling fades out."
    "Os feixes elétricos de luz azul cessam depois de um tempo, e então sinto uma última puxada para baixo no meu corpo até o estrondo desaparecer."

# game/a1s1.rpy:1374
translate pt_br a1s1_f2f602be:

    # "We sit in complete silence and darkness for a moment before I hear Amicus moving next to me."
    "Ficamos em completo silêncio e escuridão por um momento até eu escutar o Amicus mover-se perto de mim."

# game/a1s1.rpy:1375
translate pt_br a1s1_0d1e01e8:

    # a "\"Okay, we're in the hanger right now. Just follow me into the palace.\""
    a "\"Ok, estamos no aeródromo agora. Me siga até o palácio.\""

# game/a1s1.rpy:1376
translate pt_br a1s1_7d840b05:

    # "Amicus gets up, but the ship stays dark."
    "Amicus se levanta, mas a nave continua escura."

# game/a1s1.rpy:1377
translate pt_br a1s1_a5a4759a:

    # "So does the hanger."
    "O aeródromo também."

# game/a1s1.rpy:1378
translate pt_br a1s1_ed2cc2b7:

    # m "\"Okay...why aren't there any lights?\""
    m "\"Ok... por que não tem nenhuma luz acesa?\""

# game/a1s1.rpy:1379
translate pt_br a1s1_2a52e8d5:

    # a "\"Uh, everyone's probably asleep. I don't want to wake them up.\""
    a "\"Bem, provavelmente todo mundo já dormiu. Eu não quero acordá-los.\""

# game/a1s1.rpy:1380
translate pt_br a1s1_abc921e0:

    # "I get the feeling that he just doesn't want anyone to catch us, but I don't say anything."
    "Eu tenho a sensação de que ele só não quer que alguém nos pegue no flagra, mas não falo nada."

# game/a1s1.rpy:1381
translate pt_br a1s1_db3c6603:

    # "I fiddle with my seat belt, unable to get it undone until I feel Amicus lean over me, breathing in my ear as his large paw covers mine, pressing something that releases the strap."
    "Eu exploro o cinto de segurança com as mãos, incapaz de soltá-lo até sentir o Amicus se inclinar sobre mim, respirando no meu ouvido enquanto sua grande pata cobre minha mão, pressionando algo que libera o cinto."

# game/a1s1.rpy:1382
translate pt_br a1s1_1d2ec602:

    # "I stand up, feeling around blindly as I hold onto the seat, only barely able to make out the red bristles of the headrest in front of me."
    "Eu me levanto, me guiando pelo tato cegamente enquanto me seguro no assento, mal conseguindo distinguir as cerdas vermelhas da cadeira na minha frente."

# game/a1s1.rpy:1383
translate pt_br a1s1_3e1976e0:

    # "I reach out a hand."
    "Eu alcanço uma mão."

# game/a1s1.rpy:1384
translate pt_br a1s1_cd3315d1:

    # m "\"Hey...\""
    m "\"Ei...\""

# game/a1s1.rpy:1385
translate pt_br a1s1_9776826b:

    # "Amicus's rough paw pads envelop my hand."
    "As patas ásperas e alcochoadas do Amicus envelopam a minha mão."

# game/a1s1.rpy:1386
translate pt_br a1s1_33446be8:

    # a "\"What's wrong?\""
    a "\"Algo errado?\""

# game/a1s1.rpy:1387
translate pt_br a1s1_5f787939:

    # m "\"I can't see anything.\""
    m "\"Eu não consigo ver nada.\""

# game/a1s1.rpy:1388
translate pt_br a1s1_c38a0bd1:

    # a "\"Oh! Can you not see in low light?\""
    a "\"Ah! Você não consegue enxergar luz de baixa frequência?\""

# game/a1s1.rpy:1389
translate pt_br a1s1_6930ca1d:

    # "Amicus starts pulling me along before I hear a soft beep, then a whooshing sound."
    "Amicus me puxa pelo caminho até ouvirmos um bipe e depois um som de algo deslizando."

# game/a1s1.rpy:1390
translate pt_br a1s1_3a1f371a:

    # m "\"Not really.\""
    m "\"Não mesmo.\""

# game/a1s1.rpy:1392
translate pt_br a1s1_3cab8726:

    # "Another sound catches my attention...crickets."
    "Outro som chama a minha atenção... grilos."

# game/a1s1.rpy:1393
translate pt_br a1s1_36a1b9ab:

    # "They have crickets here too?"
    "Eles têm grilos aqui também?"

# game/a1s1.rpy:1394
translate pt_br a1s1_55aa36bb:

    # "At the same time I'm hit by a wall of humid warmth, almost like walking in to a sauna."
    "Ao mesmo tempo, sou atingido por uma camada de ar quente e úmido, parece até que entrei em uma sauna."

# game/a1s1.rpy:1395
translate pt_br a1s1_032b6a72:

    # "Amicus puts a paw against my chest."
    "Amicus pressiona uma pata contra meu peito."

# game/a1s1.rpy:1396
translate pt_br a1s1_683444a1:

    # a "\"Wait a second.\""
    a "\"Um segundo.\""

# game/a1s1.rpy:1397
translate pt_br a1s1_fae3bfe3:

    # "Then I hear a soft thud followed by a grunt."
    "Então eu ouço um baque suave seguido de um grunhido."

# game/a1s1.rpy:1398
translate pt_br a1s1_f702c6de:

    # m "\"Hello?\""
    m "\"Olá?\""

# game/a1s1.rpy:1399
translate pt_br a1s1_69a57f73:

    # a "\"Lean down.\""
    a "\"Se incline para baixo.\""

# game/a1s1.rpy:1400
translate pt_br a1s1_6d182cad:

    # "My eyes have adjusted a bit more to the dark and I'm barely able to make out what I think are paws reaching up toward me."
    "Meus olhos se ajustam um pouco mais à escuridão e eu mal consigo enxergar o que acho que são as patas dele tentando me alcançar."

# game/a1s1.rpy:1401
translate pt_br a1s1_c7d16218:

    # "I crouch down and Amicus grabs me under the arms before pulling me clumsily off the deck of the ship."
    "Eu me agacho e o Amicus me agarra embaixo dos braços antes de me puxar desjeitosamente para fora do convés da nave."

# game/a1s1.rpy:1402
translate pt_br a1s1_644d4ef4:

    # "My face mashes up against his furry chest before I'm set down on my feet."
    "Minha cara é amassada contra seu peito peludo antes de eu ser posto em pé no chão."

# game/a1s1.rpy:1403
translate pt_br a1s1_93ef6329:

    # a "\"Alright, so we're just going to go straight to my room. Try not to make too much noise.\""
    a "\"Ok. Nós vamos direto para meu quarto, então tente não fazer muito barulho.\""

# game/a1s1.rpy:1404
translate pt_br a1s1_6a1f00f6:

    # "I start to nod, but Amicus is already pulling me along."
    "Eu começo a confirmar com a cabeça, mas o Amicus já me puxa pelo caminho."

# game/a1s1.rpy:1405
translate pt_br a1s1_2cbe14b8:

    # "The humidity presses down on me like a physical force and I start to worry that I might actually have trouble surviving on this moon."
    "A umidade pesa contra mim como uma força física e eu começo a pensar se vou ter problemas para sobreviver nessa lua."

# game/a1s1.rpy:1406
translate pt_br a1s1_5520fe34:

    # m "\"It's...really hot.\""
    m "\"É... muito quente aqui.\""

# game/a1s1.rpy:1407
translate pt_br a1s1_7cbc1110:

    # a "\"Things will cool off once we're inside.\""
    a "\"Vai ficar mais frio assim que estivermos do lado de dentro.\""

# game/a1s1.rpy:1408
translate pt_br a1s1_8f4cb2e0:

    # "I can hear him panting heavily as we move through the hanger."
    "Eu consigo ouvi-lo ofegando enquanto andamos pelo aeródromo."

# game/a1s1.rpy:1409
translate pt_br a1s1_f5c7754d:

    # "I still can't see much, just angular shapes in the darkness, but finally I see some light ahead along with some cold air."
    "Ainda não consigo ver muita coisa a não ser formas angulares na escuridão, mas finalmente enxergo alguma luz mais à frente acompanhada de um pouco de ar frio."

# game/a1s1.rpy:1411
translate pt_br a1s1_2ad5fe10:

    # "We turn a corner and I have to blink against how bright it suddenly becomes."
    "Viramos em uma esquina no caminho e eu preciso piscar contra o quão brilhante o ambiente de repente se torna."

# game/a1s1.rpy:1414
translate pt_br a1s1_fb8e1c44:

    # "I look around at the pillars and marble floor, the bright lights above me, and what looks like a garden complete with statues extending out through the archways."
    "Olho em volta para os pilares e o piso de mármore, as luzes brilhantes em cima de mim e o que parece ser um jardim completo com estátuas se estendendo através dos arcos."

# game/a1s1.rpy:1415
translate pt_br a1s1_19dea63a:

    # "Well, at least I know Amicus wasn't lying about living in a palace."
    "Pelo menos agora eu sei que o Amicus não estava mentindo sobre morar em um palácio."

# game/a1s1.rpy:1416
translate pt_br a1s1_615b956e:

    # a "\"What do you think?\""
    a "\"E aí? O que achou?\""

# game/a1s1.rpy:1418
translate pt_br a1s1_cab4dfcb:

    # m "\"Wow, I mean, it looks really cool, really expensive.\""
    m "\"Uau, quer dizer, parece bem legal, bem caro.\""

# game/a1s1.rpy:1419
translate pt_br a1s1_1876a0b8:

    # "I don't know if that last part was such a great compliment, but Amicus seems happy."
    "Não sei se essa última parte foi um elogio de verdade, mas o Amicus parece feliz."

# game/a1s1.rpy:1421
translate pt_br a1s1_27bb6ef5:

    # a "\"Thanks! It's going to be your home for a while, so I'm glad you like it.\""
    a "\"Obrigado! Será sua casa por um tempo, então fico feliz que tenha gostado.\""

# game/a1s1.rpy:1422
translate pt_br a1s1_93bd351e:

    # "Amicus adjusts his cape, fanning it out a little."
    "Amicus ajusta sua capa, abanando-a um pouco."

# game/a1s1.rpy:1425
translate pt_br a1s1_ce6f0ada:

    # a "\"This is only a small portion of the palace, of course. I'll show you around later, but for now I want to go to my room and dry out a little.\""
    a "\"Esta é apenas uma pequena parte do palácio, é claro. Eu te mostro o resto depois, mas agora eu preciso ir para o meu quarto e secar um pouco.\""

# game/a1s1.rpy:1427
translate pt_br a1s1_45bbb629:

    # a "\"I must look like a mess right now. The humidity doesn't do my fur any favors.\""
    a "\"Eu devo estar todo bagunçado agora. A umidade não trata meu pelo muito bem.\""

# game/a1s1.rpy:1428
translate pt_br a1s1_3c1c4b3d:

    # "I can tell Amicus is genuinely embarrassed, even if he's trying to joke, so I put a hand up to my hair."
    "Posso dizer que o Amicus está genuinamente envergonhado agora, mesmo tentando fazer uma piada, então eu coloco uma mão na minha cabeça."

# game/a1s1.rpy:1429
translate pt_br a1s1_11d886df:

    # m "\"I have a little less to worry about, but I'm sure my hair is pretty crazy right now.\""
    m "\"Eu tenho um pouco menos com o que me preocupar, mas meu cabelo deve estar um fuzuê agora.\""

# game/a1s1.rpy:1431
translate pt_br a1s1_68759124:

    # a "\"True. That patch of fur really is something, though.\""
    a "\"Verdade. Esse tufo de pelo que você tem na cabeça é bem interessante.\""

# game/a1s1.rpy:1432
translate pt_br a1s1_219c87e3:

    # "The wolf reaches out and touches my hair, rubbing it between the pads on his fingers."
    "O lobo estende a pata e toca meu cabelo, esfregando-o entre as pontas dos dedos."

# game/a1s1.rpy:1433
translate pt_br a1s1_64a54630:

    # "We've made physical contact several times over the last day, but this is the first time that it really feels friendly."
    "Fizemos contato físico várias vezes no decorrer do dia, mas essa é a primeira vez que realmente parece amigável."

# game/a1s1.rpy:1434
translate pt_br a1s1_fe7e1d2e:

    # "We stand there for a moment, just long enough for things to get awkward."
    "Ficamos ali por um tempo, o suficiente para as coisas começarem a ficar estranhas."

# game/a1s1.rpy:1436
translate pt_br a1s1_71db700d:

    # "Amicus pulls his hand back suddenly, as if realizing what he's doing."
    "Amicus puxa a mão para trás de repente, como se percebesse o que estava fazendo."

# game/a1s1.rpy:1437
translate pt_br a1s1_af6538ef:

    # a "\"Oh, uh—\""
    a "\"Ah, hã—\""

# game/a1s1.rpy:1438
translate pt_br a1s1_837eb71f:

    # "He's saved from having to think of something to say as we both hear footsteps coming up the hall to our right."
    "Ele é salvo de ter que pensar em algo para falar quando ouvimos passos vindo do corredor à nossa direita."

# game/a1s1.rpy:1440
translate pt_br a1s1_9894b2cf:

    # a "\"Shit!\""
    a "\"Merda!\""

# game/a1s1.rpy:1441
translate pt_br a1s1_df8ec4bc:

    # m "\"What?\""
    m "\"O que foi?\""

# game/a1s1.rpy:1442
translate pt_br a1s1_1e069919:

    # a "\"Hide and be quiet!\""
    a "\"Se esconde e fica quieto!\""

# game/a1s1.rpy:1444
translate pt_br a1s1_661fff36:

    # "Amicus whispers loudly at me and suddenly pushes me hard back the way we came."
    "Amicus sussurra alto para mim e de repente me empurra de volta para o lugar de onde viemos."

# game/a1s1.rpy:1445
translate pt_br a1s1_6e2b5c7a:

    # "I stumble before scrambling around the corner."
    "Eu tropeço antes de engatinhar até o canto."

# game/a1s1.rpy:1446
translate pt_br a1s1_3eda09ab:

    # "The footsteps get louder as I stand up and press my back against the wall, listening."
    "Os passos ficam mais altos enquanto eu me levanto e pressiono minhas costas contra a parede, escutando."

# game/a1s1.rpy:1447
translate pt_br a1s1_120f6972:

    # unk "\"Amicus!\""
    unk "\"Amicus!\""

# game/a1s1.rpy:1448
translate pt_br a1s1_14e760c5:

    # "I jump, the person almost shouting Amicus's name."
    "Eu me assusto, a pessoa quase gritando o nome do Amicus."

# game/a1s1.rpy:1449
translate pt_br a1s1_42f6c8ee:

    # a "\"Cassius.\""
    a "\"Cassius.\""

# game/a1s1.rpy:1450
translate pt_br a1s1_3aa62c9a:

    # "Amicus's deeper voice responds, sounding cool and collected."
    "A voz mais grave do Amicus responde, soando calma e segura de si."

# game/a1s1.rpy:1451
translate pt_br a1s1_496a92c2:

    # c "\"Where the HELL have you been?\""
    c "\"Por onde DIABOS você esteve?\""

# game/a1s1.rpy:1452
translate pt_br a1s1_ad49212a:

    # "His voice is higher-pitched and a little more articulate than Amicus's."
    "A voz dele é mais aguda e um pouco mais articulada que a do Amicus."

# game/a1s1.rpy:1453
translate pt_br a1s1_aa6956c4:

    # "I start to look around the corner, then hesitate...then I do it anyway, wanting to see who this person is."
    "Eu começo a olhar pelo canto, e então hesito... mas acabo olhando de qualquer jeito, querendo ver quem é esta pessoa."

# game/a1s1.rpy:1454
translate pt_br a1s1_8b6d0f56:

    # "Luckily, Amicus has moved further down the room so that I'm slightly behind this Cassius guy."
    "Felizmente, Amicus moveu-se mais para dentro da sala, fazendo com que eu tenha ficado ligeiramente atrás desse Cassius."

# game/a1s1.rpy:1457
translate pt_br a1s1_6d6d622c:

    # "I see a white wolf, quite a bit smaller compared to Amicus, but no less intimidating...maybe even more so."
    "Eu enxergo um lobo branco, meio pequeno em comparação ao Amicus, mas nem um pouco menos intimidador... talvez até mais."

# game/a1s1.rpy:1458
translate pt_br a1s1_551d2447:

    # "I can tell by his demeanor that he's probably not a fun person to be around."
    "Posso dizer pelo semblante que ele provavelmente não é uma pessoa divertida de se estar por perto."

# game/a1s1.rpy:1460
translate pt_br a1s1_35799fc1:

    # a "\"I was out hunting. Is something wrong?\""
    a "\"Eu estava fora caçando. Alguma coisa errada?\""

# game/a1s1.rpy:1462
translate pt_br a1s1_8d03c841:

    # c "\"Hunting!? For two days? Is that a joke?\""
    c "\"Caçando!? Por dois dias? Isso é uma piada?\""

# game/a1s1.rpy:1464
translate pt_br a1s1_6931456d:

    # a "\"Was it that long?\""
    a "\"Foi por tanto tempo assim?\""

# game/a1s1.rpy:1466
translate pt_br a1s1_36448747:

    # c "\"Yes! You were supposed to make a speech in Lux yesterday! How many times did we remind you of it?\""
    c "\"Sim! Você deveria ter feito um discurso em Lux ontem! Quantas vezes tivemos que te lembrar disso?\""

# game/a1s1.rpy:1468
translate pt_br a1s1_55965de7:

    # "Cassius suddenly takes a deep breath."
    "Cassius respira fundo de repente."

# game/a1s1.rpy:1470
translate pt_br a1s1_6328b991:

    # c "\"Really, Amicus, you seem to expect everyone to cover up your mistakes. I can't comprehend how you could have forgotten.\""
    c "\"Sério, Amicus, parece que você espera que todos acobertem os seus erros. Não consigo entender como você esqueceu.\""

# game/a1s1.rpy:1471
translate pt_br a1s1_318eda86:

    # a "\"I...lost track of time.\""
    a "\"Eu... perdi a noção do tempo.\""

# game/a1s1.rpy:1472
translate pt_br a1s1_42c24d75:

    # c "\"That's not an excuse. How do you expect to become emperor if you act this way?\""
    c "\"Isso não é desculpa. Como você espera se tornar imperador se fica agindo assim?\""

# game/a1s1.rpy:1474
translate pt_br a1s1_2df92d67_1:

    # "Amicus growls."
    "Amicus rosna."

# game/a1s1.rpy:1475
translate pt_br a1s1_4c663d3c:

    # a "\"Don't even pretend, Cass. You're probably happy I missed it!\""
    a "\"Nem tente fingir, Cass. Você provavelmente está feliz que eu perdi a palestra!\""

# game/a1s1.rpy:1476
translate pt_br a1s1_3046bf22:

    # c "\"That's ridiculous. Amicus, I only want what's best for the empire.\""
    c "\"Isso é ridículo, Amicus. Eu só quero o que é melhor para o Império.\""

# game/a1s1.rpy:1477
translate pt_br a1s1_e2a1422a:

    # "Amicus opens his mouth, then shuts it suddenly."
    "Amicus abre a boca, então a fecha de repente."

# game/a1s1.rpy:1479
translate pt_br a1s1_cf31936b:

    # a "\"No, I'm not doing this tonight. I'm tired and I want to go to bed.\""
    a "\"Não, eu não vou ficar discutindo com você hoje. Estou cansado e quero ir para a cama.\""

# game/a1s1.rpy:1480
translate pt_br a1s1_9dfa6cbf:

    # "Cassius quietly regards Amicus for a moment, then shakes his head."
    "Silenciosamente, Cassius encara Amicus por um momento, depois balança sua cabeça."

# game/a1s1.rpy:1482
translate pt_br a1s1_cd56fee5:

    # c "\"Well, Virginia went in your stead, so you have her to thank when she returns.\""
    c "\"Bem, Virginia foi no seu lugar, então você vai ter que agradecê-la quando ela voltar.\""

# game/a1s1.rpy:1484
translate pt_br a1s1_b9f94f87:

    # a "\"She's better at that sort of thing anyway.\""
    a "\"Ela é melhor nesse tipo de coisa, de qualquer forma.\""

# game/a1s1.rpy:1485
translate pt_br a1s1_59a7fbbc:

    # c "\"The point was to show Lux that the next possible emperor stands in solidarity with them. Sending your sister is not a good look.\""
    c "\"O objetivo era mostrar a Lux que o próximo possível imperador seria solidário com eles. Mandar a sua irmã no lugar não pega bem.\""

# game/a1s1.rpy:1487
translate pt_br a1s1_25a6c897:

    # a "\"Well...walking around in undergarments doesn't look good either. You think that's how an emperor should behave?\""
    a "\"Bem... andar por aí de roupas íntimas também não pega bem. Você acha que é assim que um imperador deveria agir?\""

# game/a1s1.rpy:1489
translate pt_br a1s1_8fefcb05:

    # c "\"No one's awake, Amicus. Don't be such a pup.\""
    c "\"Ninguém está acordado, Amicus. Pare de agir como um filhotinho.\""

# game/a1s1.rpy:1490
translate pt_br a1s1_c4e3cfc3:

    # a "\"I'm just saying you look really small without your armor. Now THAT is not a good look for an emperor.\""
    a "\"Eu só estou dizendo que você parece bem nanico sem sua armadura. Pois bem, ISSO é uma coisa que não pega bem para um imperador.\""

# game/a1s1.rpy:1492
translate pt_br a1s1_ca3d8a7c:

    # c "\"Excuse me?\""
    c "\"Como é?\""

# game/a1s1.rpy:1493
translate pt_br a1s1_8ec8b806:

    # a "\"What? I only want what's best for the empire and a little runt like you definitely isn't.\""
    a "\"Que foi? Eu só quero o que é melhor para o império, e um anãozinho como você definitivamente não é.\""

# game/a1s1.rpy:1495
translate pt_br a1s1_3e290ecb:

    # "They stare at each other for a long time and though I have no idea what's going on, I can almost see the electricity arcing between them."
    "Eles se olham por um longo período de tempo e, mesmo que eu não faça ideia do que está acontecendo, eu quase consigo ver a eletricidade se formando entre eles."

# game/a1s1.rpy:1497
translate pt_br a1s1_91fe7a34:

    # "Finally, Cassius turns on his heel and stalks away, tail swishing furiously."
    "Finalmente, Cassius se vira e caminha na direção oposta com seu rabo balançando furiosamente."

# game/a1s1.rpy:1498
translate pt_br a1s1_36272402:

    # c "\"Goodnight, Amicus.\""
    c "\"Boa noite, Amicus.\""

# game/a1s1.rpy:1500
translate pt_br a1s1_b1120e2f:

    # "Amicus stands there for a moment, still puffed out a little before he finally deflates."
    "Amicus fica lá de pé por um momento, ainda cheio de ar nos pulmões antes de finalmente esvaziar."

# game/a1s1.rpy:1502
translate pt_br a1s1_97c20039:

    # a "\"Dammit.\""
    a "\"Inferno.\""

# game/a1s1.rpy:1504
translate pt_br a1s1_5346bd85:

    # "I stand quietly around the corner, waiting for Amicus to call me back."
    "Fico parado em silêncio no canto, esperando o Amicus me chamar de volta."

# game/a1s1.rpy:1505
translate pt_br a1s1_0ca229dc:

    # "When he doesn't, I whisper at him."
    "Ele não faz isso, então eu sussurro em sua direção."

# game/a1s1.rpy:1506
translate pt_br a1s1_2e87079d_1:

    # m "\"Amicus?\""
    m "\"Amicus?\""

# game/a1s1.rpy:1508
translate pt_br a1s1_e628232f:

    # "His ears prick up and he turns to me."
    "As orelhas dele se erguem e ele se vira para mim."

# game/a1s1.rpy:1510
translate pt_br a1s1_398bda04:

    # a "\"Hey, come on. We should go before anyone else decides to show up.\""
    a "\"Oi, vamos lá. Temos que ir antes que outra pessoa decida aparecer.\""

# game/a1s1.rpy:1511
translate pt_br a1s1_1f228d29:

    # m "\"Okay.\""
    m "\"Ok.\""

# game/a1s1.rpy:1514
translate pt_br a1s1_98291688:

    # "I can tell by the way the wolf walks, his ears slightly down, his tail almost dragging, that he's not in a good mood."
    "Eu consigo dizer pela maneira com a qual esse lobo anda, as orelhas levemente para baixo e o rabo quase arrastando no chão, que ele não está de bom humor."

# game/a1s1.rpy:1515
translate pt_br a1s1_702cfbe4:

    # m "\"You alright?\""
    m "\"Você tá bem?\""

# game/a1s1.rpy:1516
translate pt_br a1s1_56b926d2:

    # a "\"Hm? Yeah, yeah, I'm fine. My brother just knows how to irritate me...and I shouldn't have said that to him.\""
    a "\"Hm? Sim, sim, estou ótimo. É que meu irmão sabe como me irritar... e eu não deveria ter dito aquilo para ele.\""

# game/a1s1.rpy:1517
translate pt_br a1s1_fbabd804:

    # "We quietly walk through the marble halls, the echoing of our footsteps the only sound."
    "Caminhamos silenciosamente pelos corredores de mármore, o ecoar de nossos passos sendo o único som."

# game/a1s1.rpy:1518
translate pt_br a1s1_a9f4ea58:

    # m "\"Is he not supposed to see me?\""
    m "\"Teria sido ruim se ele me visse?\""

# game/a1s1.rpy:1519
translate pt_br a1s1_fb181d28:

    # a "\"I just...need to think of the right way to introduce you. Now isn't the best time.\""
    a "\"Não, é só que... eu preciso pensar na melhor maneira de introduzir você a todo mundo. Agora não é o melhor momento.\""

# game/a1s1.rpy:1520
translate pt_br a1s1_27dcc0f2:

    # m "\"Is he the one that challenged you for the throne?\""
    m "\"Ele é quem te desafiou pelo trono?\""

# game/a1s1.rpy:1521
translate pt_br a1s1_bb61b276:

    # "Amicus is quiet for a moment before heaving a huge sigh."
    "Amicus fica quieto por um momento antes de soltar um grande suspiro."

# game/a1s1.rpy:1522
translate pt_br a1s1_e0a3b7c8:

    # a "\"Yes, and he's really starting to turn my life upside down because of it. Sometimes I think he just sees this all as a game.\""
    a "\"Sim, e ele está virando minha vida de cabeça para baixo por causa disso. Às vezes eu acho que ele encara tudo isso como se fosse um jogo.\""

# game/a1s1.rpy:1523
translate pt_br a1s1_59527240:

    # "We come to a stop at what looks like a door."
    "Nós paramos na frente do que parece ser uma porta."

# game/a1s1.rpy:1524
translate pt_br a1s1_6866551c:

    # "It's completely smooth though, made of what also looks like marble."
    "Mas é completamente lisa, aparentemente também feita de mármore."

# game/a1s1.rpy:1525
translate pt_br a1s1_65feb50d:

    # "Amicus doesn't make any move to open it."
    "Amicus não faz nenhum movimento especial para abrir."

# game/a1s1.rpy:1527
translate pt_br a1s1_58d42db2:

    # a "\"And you know, he never seemed concerned for me and my duties until AFTER he made his challenge. That's what bothers me the most, knowing that it's all an act.\""
    a "\"E, sabe, ele nunca pareceu preocupado comigo ou com minhas atividades ANTES de propor o desafio. É isso o que mais me incomoda, saber que é tudo encenação.\""

# game/a1s1.rpy:1528
translate pt_br a1s1_e9b2a73b:

    # m "\"I guess you're not really close with him, then?\""
    m "\"Então vocês não são muito próximos?\""

# game/a1s1.rpy:1529
translate pt_br a1s1_1372a054:

    # a "\"Not since we were pups, no.\""
    a "\"Não, não desde que éramos filhotes.\""

# game/a1s1.rpy:1530
translate pt_br a1s1_b92b890e:

    # "A disturbing thought suddenly hits me."
    "De repente, um pensamento perturbador vem à minha mente."

# game/a1s1.rpy:1531
translate pt_br a1s1_be6bbf0d:

    # m "\"Well...you know in Earth's ancient Rome, the place where you guys uplifted, people would kill each other over the throne, like a lot...does that happen here?\""
    m "\"Então... sabe, na Roma antiga, lá na Terra, o lugar que vocês elevaram... As pessoas costumavam matar umas às outras pelo trono, tipo, o tempo todo... isso acontece aqui também?\""

# game/a1s1.rpy:1533
translate pt_br a1s1_e0a11c00_1:

    # "Amicus frowns."
    "Amicus arqueia as sobrancelhas."

# game/a1s1.rpy:1534
translate pt_br a1s1_fd516fb4:

    # a "\"Uh...I suppose it's happened in the past, but that was a long time ago. Besides, Cassius would never do something like that.\""
    a "\"Hã... suponho que costumava acontecer no passado, mas isso foi há muito tempo. Além disso, Cassius jamais faria algo assim.\""

# game/a1s1.rpy:1536
translate pt_br a1s1_92f1c9fd:

    # "Amicus sticks out his paw and presses it to a black square on the wall."
    "Amicus estende a pata e pressiona em um quadrado preto na parede."

# game/a1s1.rpy:1537
translate pt_br a1s1_f600264a:

    # "The door slides open without a sound."
    "A porta abre com um som."

# game/a1s1.rpy:1539
translate pt_br a1s1_0907a4b7:

    # "I feel a rush of cool air come out of the room and Amicus lets out a happy sigh as he steps inside."
    "Sinto uma onda de ar frio sair do quarto e Amicus solta um suspiro de alívio assim que dá um passo para dentro."

# game/a1s1.rpy:1541
translate pt_br a1s1_ef87675d:

    # a "\"Ahhhh, that's much better. My dad's advisor keeps the climate way too hot in the rest of the palace.\""
    a "\"Ahhhh, assim é bem melhor. O conselheiro do meu pai deixa o clima quente demais no resto do palácio.\""

# game/a1s1.rpy:1543
translate pt_br a1s1_6d34af9f:

    # "I follow the wolf inside and look around."
    "Eu sigo o lobo para dentro e olho em volta."

# game/a1s1.rpy:1544
translate pt_br a1s1_eb0631f2:

    # "Aside from a few quirks, the room looks like it could have come straight out of any luxury hotel on Earth."
    "Com exceção de algumas peculiaridades, parece que o quarto poderia ter saído direto de qualquer hotel de luxo na Terra."

# game/a1s1.rpy:1545
translate pt_br a1s1_03aeed76:

    # "Amicus sits heavily on the bed, making it squeak."
    "Amicus senta pesado na cama, fazendo ela balançar."

# game/a1s1.rpy:1546
translate pt_br a1s1_a893d3be:

    # "He starts to strip off his clothing."
    "Ele começa a tirar a roupa fora."

# game/a1s1.rpy:1548
translate pt_br a1s1_2fe005d6:

    # a "\"Toilet and bath are in there.\""
    a "\"O banheiro fica ali.\""

# game/a1s1.rpy:1549
translate pt_br a1s1_5c0f7e77:

    # "He nods ahead at another door across from the bed."
    "Ele acena com a cabeça apontando para uma porta em frente à cama."

# game/a1s1.rpy:1550
translate pt_br a1s1_2dd50623:

    # "Then he jabs a thumb back at the large curtain."
    "Depois aponta um dedo na direção da grande cortina."

# game/a1s1.rpy:1552
translate pt_br a1s1_92a9da45:

    # a "\"That's the balcony if you want to get some air, though I don't know why you would in this weather.\""
    a "\"Ali fica a varanda se você quiser um pouco de ar fresco, embora eu não sei porque você faria isso nesse clima.\""

# game/a1s1.rpy:1553
translate pt_br a1s1_c57f6e52:

    # "Then he points at the couch."
    "Então, ele aponta para o sofá."

# game/a1s1.rpy:1554
translate pt_br a1s1_6c3d91f7:

    # a "\"And that can be where you sleep, if that's alright with you. I've known other aliens to prefer the floor, though.\""
    a "\"E você pode dormir no sofá, se quiser. Se bem que eu já conheci alienígenas que preferem o chão.\""

# game/a1s1.rpy:1556
translate pt_br a1s1_424ee26a:

    # m "\"The couch is fine.\""
    m "\"Eu fico com o sofá.\""

# game/a1s1.rpy:1558
translate pt_br a1s1_73002da7:

    # "I walk over to the red sofa, sizing it up."
    "Eu caminho em direção ao sofá vermelho, dando uma avaliada."

# game/a1s1.rpy:1559
translate pt_br a1s1_2bcdcf55:

    # "It's more than big enough, but as I pick up the little black pillow I notice it's covered in fur."
    "É mais do que grande o suficiente, mas, quando pego uma pequena almofada preta, percebo que está coberta de pelos."

# game/a1s1.rpy:1560
translate pt_br a1s1_cb3b3bc4:

    # "I inconspicuously pick some of it off before a light blanket smacks into the back of my head."
    "Discretamente passo a mão para limpar antes de um leve cobertor bater atrás da minha cabeça."

# game/a1s1.rpy:1562
translate pt_br a1s1_2d9d5641:

    # a "\"Haha! There you go. Is that all okay?\""
    a "\"Haha! Ai está. Tudo bem para você?\""

# game/a1s1.rpy:1563
translate pt_br a1s1_9ad1e2eb:

    # m "\"Yeah, this is good.\""
    m "\"Sim, vai servir.\""

# game/a1s1.rpy:1564
translate pt_br a1s1_6fe613fb:

    # "I hope the blanket will be enough to keep off the cold that seems to be wafting down from the ceiling."
    "Eu espero que esse cobertor seja suficiente para suportar o ar frio que parece estar soprando do teto."

# game/a1s1.rpy:1566
translate pt_br a1s1_6b596c54:

    # a "\"Good. Like I said earlier, I'll show you the rest of the palace tomorrow. We'll get some real food too.\""
    a "\"Legal. Como eu disse antes, te mostro o resto do palácio amanhã. E, também, a gente come comida de verdade.\""

# game/a1s1.rpy:1568
translate pt_br a1s1_30066ee1:

    # "Amicus sprawls back on the bed, not bothering to draw up any blankets, his eyes closed."
    "Amicus se esparrama na cama, não se preocupando em puxar nenhum cobertor, seus olhos fechados."

# game/a1s1.rpy:1569
translate pt_br a1s1_c5dded50:

    # "I actually want real food now, but I don't say anything and instead lay down, the sofa a bit harder than I'd expected."
    "Bem que um pouco de comida de verdade cairia bem agora, mas não falo nada e, em vez disso, deito no sofá, que é um pouco mais duro do que eu esperava."

# game/a1s1.rpy:1570
translate pt_br a1s1_5e7694b6:

    # "Good support, I guess."
    "Suporte bem feito, eu acho."

# game/a1s1.rpy:1571
translate pt_br a1s1_1bcf068a:

    # "As I'm settling in, I think Amicus has already fallen asleep, but that's when he speaks again."
    "Enquanto me preparo, penso que o Amicus já pegou no sono, mas é aí que ele fala de novo."

# game/a1s1.rpy:1572
translate pt_br a1s1_5abd6ccb:

    # a "\"And thanks, [mc].\""
    a "\"E obrigado, [mc].\""

# game/a1s1.rpy:1573
translate pt_br a1s1_521ba82e:

    # "I don't know what he's thanking me for."
    "Eu não sei pelo que ele está me agradecendo."

# game/a1s1.rpy:1574
translate pt_br a1s1_de396717:

    # "For not killing him on the ship?"
    "Por não matar ele na nave?"

# game/a1s1.rpy:1575
translate pt_br a1s1_04f18c2a:

    # "For agreeing to help him become emperor?"
    "Por concordar em ajudá-lo a se tornar imperador?"

# game/a1s1.rpy:1576
translate pt_br a1s1_7c78f5b9:

    # "For the way I took this shitty sofa and flimsy blanket without complaint?"
    "Pela forma como eu aceitei esse sofá bosta e esse cobertor fino sem reclamar?"

# game/a1s1.rpy:1577
translate pt_br a1s1_90dc5502:

    # "I'm not sure, so all I say is:"
    "Não tenho certeza, então tudo o que falo é:"

# game/a1s1.rpy:1578
translate pt_br a1s1_910f899d:

    # m "\"Sure.\""
    m "\"Ok...\""

# game/a1s1.rpy:1579
translate pt_br a1s1_098fa350:

    # "Then I hear the wolf snoring softly and the lights suddenly dim down until they're off."
    "Então, ouço o lobo roncando baixinho e as luzes diminuem de repente até se apagarem."

# game/a1s1.rpy:1582
translate pt_br a1s1_95d6b7d6:

    # "I lay there a while, though I'm not sure for how long."
    "Eu fico lá deitado e acordado por um tempo, não tenho certeza de por quanto."

# game/a1s1.rpy:1583
translate pt_br a1s1_4d9868cc:

    # "In fact, time seems to have lost all meaning since I was abducted."
    "Na verdade, o tempo parece que perdeu todo o sentido desde que eu fui abduzido."

# game/a1s1.rpy:1584
translate pt_br a1s1_5a20cc71:

    # "Amicus's brother said it had been two days, but didn't Amicus say that time freezes when traveling in the Stretch Drive?"
    "O irmão do Amicus disse que se passaram dois dias, mas ele não tinha mencionado que o tempo para enquanto a gente viaja pela dobra espacial?"

# game/a1s1.rpy:1585
translate pt_br a1s1_73eec06f:

    # "Had we really spent that much time idling around?"
    "A nave ficou parada por tanto tempo assim?"

# game/a1s1.rpy:1586
translate pt_br a1s1_2e9eaf01:

    # "I need to stop thinking about everything that doesn't make sense...because that's basically everything."
    "Eu preciso parar de pensar sobre tudo o que não faz sentido... porque nada faz sentido aqui."

# game/a1s1.rpy:1587
translate pt_br a1s1_2165491e:

    # "I just need to help this wolf so I can get the hell back home."
    "Só preciso ajudar esse lobo e depois voltar para casa de uma vez."

# game/a1s1.rpy:1588
translate pt_br a1s1_5d07c304:

    # "Then I can pick apart everything I've been through all I want."
    "Então, vou poder reclamar o tanto que eu quiser."

# game/a1s1.rpy:1589
translate pt_br a1s1_8da8f1cd:

    # "For now I just need to help things move along as smoothly as possible."
    "Por enquanto, preciso fazer com que as coisas progridam da melhor maneira possível."

# game/a1s1.rpy:1590
translate pt_br a1s1_40f74d8a:

    # "With that thought in my head, and with the soft sounds of Amicus's gentle snoring, I'm lulled into a light and troubled sleep."
    "Com isso em mente e os sons suaves do leve ronco do Amicus, eu caio em um sono leve e agitado."

translate pt_br strings:

    # game/a1s1.rpy:192
    old "What is your name?"
    new "Qual é o seu nome?"
