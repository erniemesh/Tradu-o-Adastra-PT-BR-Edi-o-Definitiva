    m "\"Ah... ok.\""

# game/a1s4.rpy:560
translate pt_br a1s4_81a0d133:

    # a "\"Great!\""
    a "\"Supimpa!\""

# game/a1s4.rpy:563
translate pt_br a1s4_aa45dac4:

    # "Amicus leads the way out of the throne room and back into the marble halls."
    "Amicus guia o caminho para fora da sala do trono e de volta aos corredores de mármore."

# game/a1s4.rpy:564
translate pt_br a1s4_c3b0807b:

    # "The cooler air hits my sweaty skin and I realize that I probably don't smell so great either."
    "O ar mais frio atinge minha pele suada e eu percebo que provavelmente não cheiro tão bem também."

# game/a1s4.rpy:565
translate pt_br a1s4_94f9f600:

    # "The perfume the wolves use isn't all that strong."
    "O perfume que os lobos usam não é tão forte."

# game/a1s4.rpy:566
translate pt_br a1s4_e22afcbc:

    # "I adjust my robe, not liking the way the fabric sticks to my skin."
    "Eu ajusto meu traje, não gostando da forma como o tecido gruda na minha pele."

# game/a1s4.rpy:567
translate pt_br a1s4_d1ec6f89:

    # "Actually, all this dancing has me wishing I had jeans back."
    "Na verdade, toda essa dança me fez desejar a minha calça jeans de volta."

# game/a1s4.rpy:568
translate pt_br a1s4_c8c68152:

