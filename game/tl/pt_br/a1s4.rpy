    "As posições de dança me fizeram sentir que o traje se movia de um jeito que deixava minha cueca exposta."

# game/a1s4.rpy:569
translate pt_br a1s4_bf9995e2:

    # m "\"Can I wear pants when we do the dance?\""
    m "\"Eu posso vestir uma calça quando a gente dançar?\""

# game/a1s4.rpy:571
translate pt_br a1s4_4433823a:

    # a "\"Pants? Why?\""
    a "\"Uma calça? Por que?\""

# game/a1s4.rpy:572
translate pt_br a1s4_7dd489ba:

