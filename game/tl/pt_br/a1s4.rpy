    a "\"Eu—\""

# game/a1s4.rpy:1019
translate pt_br a1s4_6d2fc16d:

    # m "\"I mean, I'm not offended or anything. I'm just curious about the culture, if that's how you guys go about things here.\""
    m "\"Olha, eu não tô ofendido nem nada. Só curioso sobre a cultura, se é desse jeito que vocês agem com essas coisas aqui.\""

# game/a1s4.rpy:1020
translate pt_br a1s4_4ee0e210:

