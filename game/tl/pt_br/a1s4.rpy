    # a "\"Now, kindly leave my pet alone in the future. He's very busy.\""
    a "\"Agora, por gentileza, deixe o meu mascote em paz no futuro. Ele é muito ocupado.\""

# game/a1s4.rpy:934
translate pt_br a1s4_e68bcb69:

