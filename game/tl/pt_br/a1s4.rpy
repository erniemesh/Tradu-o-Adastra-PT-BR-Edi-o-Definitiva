    m "\"Sabe, é uma coisa relativamente aceita na Terra esses dias e eu não tenho problemas com isso. Se você é, pode me contar.\""

# game/a1s4.rpy:1035
translate pt_br a1s4_aa5b1ef6:

    # "Amicus goes on staring at me for a little while longer, then sighs."
    "Amicus continua me encarando por um pouco mais de tempo, então suspira."

# game/a1s4.rpy:1037
translate pt_br a1s4_2358a584:

    # a "\"I...have a preference for males, yes.\""
    a "\"Eu... tenho uma preferência por machos, sim.\""

# game/a1s4.rpy:1038
translate pt_br a1s4_dbe2487d:

