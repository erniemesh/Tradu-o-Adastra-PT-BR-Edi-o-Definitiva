# game/a1s4.rpy:1013
translate pt_br a1s4_4327a965:

    # a "\"What? Definitely not! That damned jackal was assuming quite a lot!\""
    a "\"O que? Definitivamente não! Aquele maldito chacal estava presumindo bastante coisa!\""

