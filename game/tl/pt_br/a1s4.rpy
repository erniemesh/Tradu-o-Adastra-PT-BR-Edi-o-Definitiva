# game/a1s4.rpy:962
translate pt_br a1s4_4ec5e95f:

    # n "\"Oh, did I get the wrong idea? I just assumed after you groped my chest and became excited.\""
    n "\"Ah, eu entendi errado? Foi apenas minha conclusão com você ficando excitado depois de apalpar meu peito.\""

