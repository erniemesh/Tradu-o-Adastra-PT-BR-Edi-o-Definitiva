# game/a1s4.rpy:1045
translate pt_br a1s4_02fecd16:

    # "The wolf turns away and walks over to the sofa before slumping into it, leaning his face into a paw, looking frustrated."
    "O lobo se vira e anda até o sofá antes de cair nele, inclinando o rosto em uma pata, parecendo frustrado."

# game/a1s4.rpy:1046
translate pt_br a1s4_3c6a4d52:

    # m "\"What's wrong?\""
    m "\"Tá tudo bem?\""

# game/a1s4.rpy:1047
translate pt_br a1s4_f949365d:

    # a "\"Well, that jackal for one...and, I don't know. Are you disgusted with me now?\""
    a "\"Bem, aquele chacal para começar... e, eu não sei. Você tem nojo de mim agora?\""

# game/a1s4.rpy:1048
translate pt_br a1s4_d8a2e27c:

    # m "\"Why would I be disgusted with you?\""
    m "\"E por que eu teria nojo de você?\""

# game/a1s4.rpy:1049
translate pt_br a1s4_dc1ee201:

    # a "\"I don't know...you must see past incidences in a different light, like the massages and wrestling...and the dance. I promise those are truly pet duties, and I was only having a bit of fun at the amphitheater...and I only did what the dance called fo—\""
    a "\"Eu não sei... você deve enxergar acontecimentos passados com outros olhos agora, como as massagens e a luta livre... e a dança. Eu prometo que isso são realmente deveres de mascote e eu só estava me divertindo um pouco no anfiteatro... e eu só fiz o que a dança pedia pa—\""

# game/a1s4.rpy:1050
translate pt_br a1s4_6a20a80d:

    # "I shake my head."
    "Eu balanço minha cabeça."

# game/a1s4.rpy:1051
translate pt_br a1s4_8651ae8d:

    # m "\"I think you've been really good about not taking advantage of me at all. It's fine.\""
    m "\"Eu acho que você tem se saído muito bem em não tirar vantagem de mim, Amicus. Tá tudo bem.\""

# game/a1s4.rpy:1053
translate pt_br a1s4_bc9de312:

    # "Amicus looks at me, unsure."
    "Amicus olha para mim, incerto."

# game/a1s4.rpy:1054
translate pt_br a1s4_3b363865:

    # a "\"And you never have to do those things again if you don't want. I'll understand.\""
    a "\"E você nunca precisa fazer essas coisas de novo se você não quiser. Eu vou entender.\""

# game/a1s4.rpy:1055
translate pt_br a1s4_112d764c:

    # "I raise a hand up."
    "Eu levanto uma mão."

# game/a1s4.rpy:1056
translate pt_br a1s4_7e1b6365:

    # m "\"Seriously, you're fine.\""
    m "\"Sério, tá tudo bem.\""

# game/a1s4.rpy:1058
translate pt_br a1s4_99900ed3:

    # "Amicus looks away, looking relieved but still ashamed."
    "Amicus desvia o olhar, parecendo aliviado, mas ainda envergonhado."

# game/a1s4.rpy:1059
translate pt_br a1s4_b33058d4:

    # a "\"I'm sorry it's...it's just something that's followed me most of my life. I had an...incident happen several years back and it's created a lot of rumors about me. The people aren't very interested in having a tail-raiser as their emperor.\""
    a "\"Me desculpe, é que... isso é só algo que vem me seguindo a minha vida inteira. Eu tive um... incidente que aconteceu muitos anos atrás e criou um monte de rumores sobre mim. As pessoas não estão interessadas em ter um empina-rabo como imperador.\""

# game/a1s4.rpy:1060
translate pt_br a1s4_87e6d4a2:

    # "Amicus finally looks at me."
    "Amicus finalmente olha para mim."

# game/a1s4.rpy:1062
translate pt_br a1s4_4efa73b0:

    # a "\"So I try to keep it quiet so that it might be forgotten...thought it mostly was until the Khemian mentioned it.\""
    a "\"Então eu tento deixar quieto para que, dessa forma, seja esquecido... pensei que estava até o khemiano mencionar.\""

# game/a1s4.rpy:1063
translate pt_br a1s4_2df92d67:

    # "Amicus growls."
    "Amicus rosna."

# game/a1s4.rpy:1065
translate pt_br a1s4_59653648:

    # a "\"Anyway, I'm sorry. I suppose it was something I should have told you considering how close quarters we've been living.\""
    a "\"Enfim, me perdoe. Suponho que era algo que eu deveria contar a você considerando o jeito próximo como nós temos vivido aqui.\""

# game/a1s4.rpy:1066
translate pt_br a1s4_450ace71:

    # "The wolf looks so dejected, so sad...I decide that I should tell him."
    "O lobo parece tão abatido, tão triste... eu decido que devo contar a ele."

# game/a1s4.rpy:1067
translate pt_br a1s4_51951e2c:

    # m "\"You know, I'm gay too?\""
    m "\"Eu sou gay também, sabia?\""

# game/a1s4.rpy:1068
translate pt_br a1s4_dde743ea:

    # "Amicus snaps his gaze back to me, eyes wide."
    "Amicus volta o olhar para mim, os olhos arregalados."

# game/a1s4.rpy:1070
translate pt_br a1s4_3c8805f7:

    # a "\"What?\""
    a "\"O que?\""

# game/a1s4.rpy:1071
translate pt_br a1s4_85f217b3:

    # "I feel my face turning red."
    "Eu sinto meu rosto ficando vermelho."

# game/a1s4.rpy:1072
translate pt_br a1s4_2bc0813b:

    # m "\"I'm the same. I like guys.\""
    m "\"Eu também sou assim, gosto de caras.\""

# game/a1s4.rpy:1073
translate pt_br a1s4_10ac3bf0:

    # "Amicus squints at me, like he can't quite believe what I just said."
    "Amicus quase fecha os olhos, como se não conseguisse acreditar no que acabei de dizer."

# game/a1s4.rpy:1075
translate pt_br a1s4_f41aecd7:

    # a "\"Are you...making fun of me?\""
    a "\"Você... está tirando sarro de mim?\""

# game/a1s4.rpy:1076
translate pt_br a1s4_8f19b94e:

    # m "\"What? No! I'm telling you so you don't feel so bad about it. It's fine.\""
    m "\"O que? Não! Eu só tô te contando pra você não se sentir tão mal com isso. Tá tudo bem.\""

# game/a1s4.rpy:1077
translate pt_br a1s4_69f0220c:

    # a "\"Oh.\""
    a "\"Ah.\""

# game/a1s4.rpy:1079
translate pt_br a1s4_496b2569:

    # a "\"That's quite the coincidence.\""
    a "\"Isso é muita coincidência.\""

# game/a1s4.rpy:1080
translate pt_br a1s4_bee80475:

    # m "\"Yeah, it is.\""
    m "\"É.\""

# game/a1s4.rpy:1081
translate pt_br a1s4_8302c713:

    # a "\"Well, uh, thank you for telling me. That isn't easy to do, at least it isn't for me.\""
    a "\"Bem, hã... obrigado por me contar. Isso não é fácil de fazer, para mim, pelo menos.\""

# game/a1s4.rpy:1082
translate pt_br a1s4_43d33f0d:

    # m "\"I'm the same.\""
    m "\"Pra mim também.\""

# game/a1s4.rpy:1083
translate pt_br a1s4_08028c69:

    # "I slowly walk over and sit on the sofa next to the wolf, feeling strangely awkward about our little coming out conversation."
    "Eu lentamente ando na direção do lobo e sento no sofá ao lado dele, me sentindo estranhamente constrangido sobre a nossa conversa de sair do armário."

# game/a1s4.rpy:1084
translate pt_br a1s4_b0a6ad85:

    # "Amicus still looks a bit uncomfortable, but at least he doesn't look sad anymore."
    "Amicus ainda parece um pouco desconfortável, mas pelo menos não parece mais triste."

# game/a1s4.rpy:1085
translate pt_br a1s4_0988c18a:

    # m "\"Soooo, since we're talking about all of this...what was Neferu saying about me...helping you out with your dick. Is that a pet duty too?\""
    m "\"Entãããão, já que a gente tá falando disso tudo... o que o Neferu tava falando sobre mim... \"te ajudar a satisfazer os desejos carnais\". Isso é um dever de mascote também?\""

# game/a1s4.rpy:1087
translate pt_br a1s4_c61f177f:

    # a "\"Well, yes, yes it is. But again, I would never ask that of you.\""
    a "\"Bem, sim, na verdade é. Mas eu nunca pediria isso a você.\""

# game/a1s4.rpy:1088
translate pt_br a1s4_db34a898:

    # m "\"Does Alex do that?\""
    m "\"Alex faz isso?\""

# game/a1s4.rpy:1090
translate pt_br a1s4_c03a3102:

    # "Amicus pulls a face."
    "Amicus faz uma careta."

# game/a1s4.rpy:1091
translate pt_br a1s4_89eda736:

    # a "\"While I'd rather not think of my brother in such a situation, yes, he does.\""
    a "\"Embora eu prefira não pensar no meu irmão em tal situação, sim, ele faz.\""

# game/a1s4.rpy:1092
translate pt_br a1s4_5959d4d5:

    # m "\"But...does that mean your brother's gay too?\""
    m "\"Espera... isso significa que o seu irmão é gay também?\""

# game/a1s4.rpy:1094
translate pt_br a1s4_e6dce92e:

    # a "\"No, well, not as far as I know. He doesn't have a preference for males. Isn't that what makes you a homosexual?\""
    a "\"Não, bem, não até onde eu sei. Ele não tem preferência por machos. Não é isso que faz alguém homossexual?\""

# game/a1s4.rpy:1095
translate pt_br a1s4_8619f2c6_1:

    # "I shrug."
    "Eu dou de ombros."

# game/a1s4.rpy:1096
translate pt_br a1s4_118d18df:

    # m "\"So I'd just...give you a hand-job, or something?\""
    m "\"Então eu só... te dou uma mãozinha, ou algo assim?\""

# game/a1s4.rpy:1098
translate pt_br a1s4_9c22525e:

    # "I can tell that the Lingua had no trouble translating that to Amicus, because he immediately blushes again."
    "Eu consigo dizer que o interpretus não teve nenhum problema em traduzir isso para o Amicus, porque ele imediatamente fica constrangido de novo."

# game/a1s4.rpy:1099
translate pt_br a1s4_2940e9ae:

    # "I squirm, wondering why I'm asking so much about this topic."
    "Eu me contorço, me perguntando porque estou insistindo tanto nesse assunto."

# game/a1s4.rpy:1100
translate pt_br a1s4_14fbb01c:

    # "I'm curious and I already know that I'm attracted to this wolf."
    "Estou curioso e já sei que me sinto atraído por esse lobo."

# game/a1s4.rpy:1101
translate pt_br a1s4_816546ad:

    # "I'd given up on denying it a while ago."
    "Eu desisti de negar isso há um tempo."

# game/a1s4.rpy:1102
translate pt_br a1s4_91eafdcf:

    # a "\"It can involve a lot of things...I mean, if you want to do it, I have no objections...but it's your choice!\""
    a "\"Pode envolver várias coisas... digo, se você quiser fazer isso, eu não tenho objeções... mas é escolha sua!\""

# game/a1s4.rpy:1103
translate pt_br a1s4_ed75ff4d:

    # "Amicus sounds tentatively hopeful, and I realize that he actually wants it."
    "Amicus soa timidamente esperançoso e eu percebo que ele na verdade quer isso."

# game/a1s4.rpy:1104
translate pt_br a1s4_921026fb:

    # "It seems that every day I go further and further with this wolf."
    "Parece que a cada dia eu vou mais e mais longe com esse lobo."

# game/a1s4.rpy:1105
translate pt_br a1s4_886741dc:

    # "I laugh, partly at Amicus's expression, and partly because of the absurdity of this entire situation."
    "Eu rio, em parte da expressão do Amicus e em parte por causa do absurdo de toda essa situação."

# game/a1s4.rpy:1106
translate pt_br a1s4_9e6bc8f3:

    # m "\"How about if we win the dance trial...I'll think about it.\""
    m "\"Que tal se a gente vencer o julgamento da dança... eu vou pensar nisso.\""

# game/a1s4.rpy:1107
translate pt_br a1s4_3c38ecb7:

    # "I'm speaking without thinking."
    "Estou falando sem pensar."

# game/a1s4.rpy:1108
translate pt_br a1s4_569bb2f5:

    # "Amicus is quiet, then nods."
    "Amicus fica quieto, então acena com a cabeça."

# game/a1s4.rpy:1110
translate pt_br a1s4_ea044ba4:

    # a "\"Sounds fair.\""
    a "\"Parece justo.\""

# game/a1s4.rpy:1111
translate pt_br a1s4_dc7c6ef0:

    # "I try to think of something else to talk about, still shocked at what I'd just proposed."
    "Eu tento pensar em outra coisa para falar sobre, ainda chocado com o que eu acabei de propor."

# game/a1s4.rpy:1112
translate pt_br a1s4_09816e00:

    # m "\"So what's the deal with Neferu? Why'd he do all that stuff in the bath?\""
    m "\"Então, qual é a do Neferu? Por que ele fez aquilo tudo na sala de banhos?\""

# game/a1s4.rpy:1114
translate pt_br a1s4_717b1dbd:

    # a "\"I honestly have no idea. It was very strange.\""
    a "\"Sinceramente, não faço ideia. Foi bem estranho.\""

# game/a1s4.rpy:1115
translate pt_br a1s4_f9c9adf4:

    # m "\"Hmm, do you think that's his way of furthering an alliance?\""
    m "\"Hmm, você acha que é a maneira dele de promover uma aliança?\""

# game/a1s4.rpy:1117
translate pt_br a1s4_3f58a604:

    # a "\"Not if he has any common sense. I thought he was going to be friendly considering he knows I'm open to the alliance, unlike Cassius.\""
    a "\"Não se ele tem qualquer bom senso. Eu pensei que ele seria amigável considerando o fato dele saber da minha simpatia à aliança, ao contrário do Cassius.\""

# game/a1s4.rpy:1118
translate pt_br a1s4_1bb0b2a0:

    # "I lean back on the sofa, thinking."
    "Eu me encosto no sofá, pensando."

# game/a1s4.rpy:1119
translate pt_br a1s4_84bccb62:

    # m "\"Hmm, maybe he was just feeling you out.\""
    m "\"Hmm, talvez ele estivesse só testando você.\""

# game/a1s4.rpy:1120
translate pt_br a1s4_9c5bdf06:

    # "Amicus smirks at that."
    "Amicus abre um sorriso pretensioso com isso."

# game/a1s4.rpy:1122
translate pt_br a1s4_c9bd43c6:

    # a "\"You could say that. Anyway, I don't know how to feel about him. I'm thinking of just telling him that I'm not interested in the alliance unless they send someone that has more tact.\""
    a "\"Poderia ser o caso. De qualquer forma, não sei como me sentir sobre ele. Só estou pensando em dizer a ele que eu não tenho interesse na aliança a não ser que eles mandem alguém com mais decência.\""

# game/a1s4.rpy:1123
translate pt_br a1s4_4ad4d594:

    # "Amicus glances at me."
    "Amicus olha para mim."

# game/a1s4.rpy:1124
translate pt_br a1s4_615b956e:

    # a "\"What do you think?\""
    a "\"O que você acha?\""

# game/a1s4.rpy:1130
translate pt_br a1s4_2e90bbe1:

    # m "\"Well...I think if he's the only guy you have to establish the alliance with, you should try to work with him. I mean, this could be your best chance if you're willing to put up with him.\""
    m "\"Bem... acho que se ele é o único cara com quem você precisa estabelecer uma aliança, deveria tentar trabalhar com ele. Digo, essa pode ser a sua melhor chance se você estiver disposto a aturar ele.\""

# game/a1s4.rpy:1132
translate pt_br a1s4_fea09bf9_1:

    # a "\"Hmmm...\""
    a "\"Hmmm...\""

# game/a1s4.rpy:1133
translate pt_br a1s4_562aceec:

    # m "\"And he seems to have the hots for you, so that'll probably help you, honestly.\""
    m "\"E ele parece gostar muito de você, então isso provavelmente vai te ajudar, falando sério.\""

# game/a1s4.rpy:1135
translate pt_br a1s4_0d98fafa:

    # a "\"Heh, maybe.\""
    a "\"Hehe, talvez.\""

# game/a1s4.rpy:1137
translate pt_br a1s4_d1834f85:

    # m "\"Honestly, if that's what the Khemians send to foster an alliance, I have to wonder about them as a whole.\""
    m "\"Sinceramente, se foi ele quem os khemianos mandaram pra estabelecer uma aliança, tenho que repensar neles como um todo.\""

# game/a1s4.rpy:1138
translate pt_br a1s4_a4bc53af:

    # a "\"They are an arrogant people, as I've said.\""
    a "\"Eles são um povo arrogante, como eu disse.\""

# game/a1s4.rpy:1139
translate pt_br a1s4_cff67bed:

    # m "\"And maybe his intentions aren't all that great if that's how he treats his prospective allies.\""
    m "\"E talvez suas intenções não sejam tão boas assim se é desse jeito que ele trata os aliados.\""

# game/a1s4.rpy:1141
translate pt_br a1s4_e72b5e35:

    # a "\"Agreed.\""
    a "\"Concordo.\""

# game/a1s4.rpy:1143
translate pt_br a1s4_c23b90ec:

    # m "\"But I dunno, I'm not a politician.\""
    m "\"Mas eu não sei, eu não sou um político.\""

# game/a1s4.rpy:1145
translate pt_br a1s4_31977895:

    # a "\"But you are smart!\""
    a "\"Mas você é esperto!\""

# game/a1s4.rpy:1146
translate pt_br a1s4_1dfc7b4e:

    # m "\"Thanks.\""
    m "\"Valeu.\""

# game/a1s4.rpy:1148
translate pt_br a1s4_e1214122:

    # a "\"Anyway, I'm off to my shower.\""
    a "\"Enfim, eu vou tomar meu banho.\""

# game/a1s4.rpy:1149
translate pt_br a1s4_1708ddfd:

    # "The wolf stands up, and I do the same."
    "O lobo se levanta e eu faço o mesmo."

# game/a1s4.rpy:1150
translate pt_br a1s4_fe78655b:

    # m "\"Do you need help?\""
    m "\"Você quer ajuda?\""

# game/a1s4.rpy:1152
translate pt_br a1s4_c791bb9d:

    # a "\"Oh...really?\""
    a "\"Ah... sério?\""

# game/a1s4.rpy:1153
translate pt_br a1s4_c806ebc0_5:

    # m "\"Yeah.\""
    m "\"Sim.\""

# game/a1s4.rpy:1154
translate pt_br a1s4_697e098d:

    # "I want to show him that things haven't changed, that I'm not scared of him now that I know his secret."
    "Eu quero mostrar a ele que as coisas não mudaram e que eu não tenho medo dele agora que eu sei de seu segredo."

# game/a1s4.rpy:1155
translate pt_br a1s4_c26c3c71:

    # "He looked so devastated when he told me."
    "Ele pareceu tão devastado quando me falou."

# game/a1s4.rpy:1156
translate pt_br a1s4_23a0b7a8:

    # "And even if Amicus was the one to get me into this mess, I know now that he's a good person and doesn't deserve to feel like that."
    "E mesmo que o Amicus seja o responsável por ter me metido nessa bagunça, agora eu sei que ele é uma boa pessoa e não merece se sentir assim."

# game/a1s4.rpy:1157
translate pt_br a1s4_48c61ee2:

    # m "\"I mean, I've seen your junk already, so no surprises there, right?\""
    m "\"Tipo, eu já vi suas partes antes, então sem surpresas, né?\""

# game/a1s4.rpy:1159
translate pt_br a1s4_4f71987f:

    # a "\"Heh, I suppose not...if you're sure.\""
    a "\"Hehe, suponho que não... se estiver tudo bem.\""

# game/a1s4.rpy:1160
translate pt_br a1s4_3d9e81d6:

    # m "\"I'm sure.\""
    m "\"Sim.\""

# game/a1s4.rpy:1162
translate pt_br a1s4_8db7c553:

    # "To decide things for the wolf, I walk into the shower."
    "Para assegurar as coisas com o lobo, eu entro no banheiro."

# game/a1s4.rpy:1163
translate pt_br a1s4_1f023d98:

    # "Amicus isn't far behind."
    "Amicus não fica muito atrás."

# game/a1s4.rpy:1167
translate pt_br a1s4_fec97169:

    # "To be continued..."
    "Continua..."

translate pt_br strings:

    # game/a1s4.rpy:1126
    old "Talk to him more."
    new "Falar mais com ele."

    # game/a1s4.rpy:1126
    old "Reject him."
    new "Rejeitá-lo."
