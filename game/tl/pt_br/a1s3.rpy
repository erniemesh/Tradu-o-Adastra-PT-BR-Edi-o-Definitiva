# TODO: Translation updated at 2021-07-13 23:51

# game/a1s3.rpy:2
translate pt_br a1s3_31a1e2c6:

    # "The next day, Amicus wakes me up by gently shaking my shoulder."
    "No dia seguinte, Amicus me acorda ao gentilmente balançar meu ombro."

# game/a1s3.rpy:3
translate pt_br a1s3_823d26d2:

    # a "\"Hey...hey, [mc]? Wake up.\""
    a "\"Ei... ei, [mc]? Acorda.\""

# game/a1s3.rpy:5
translate pt_br a1s3_55bcffc8:

    # "I roll over on my sofa, groggily pulling the blanket up around me as I shiver."
    "Eu rolo em cima do sofá, ainda meio grogue, puxando o cobertor para cima de mim ao calafrios percorrerem meu corpo."

# game/a1s3.rpy:6
translate pt_br a1s3_7ee8c806:

    # m "\"Ugh...it's so cold in here.\""
    m "\"Argh... tá tão frio aqui.\""

# game/a1s3.rpy:8
translate pt_br a1s3_8a6f2145:

    # a "\"Oh, I can turn up the heat if you'd like. It's just that I tend to...sweat a little when it's too warm.\""
    a "\"Ah, eu posso aumentar a temperatura se você quiser. O problema é que eu tendo a... suar um pouco quando está muito quente.\""

# game/a1s3.rpy:9
translate pt_br a1s3_34d6ee39:

    # m "\"Could just give me a better blanket.\""
    m "\"Você podia só me dar um cobertor melhor.\""

# game/a1s3.rpy:11
translate pt_br a1s3_99851fb5:

    # a "\"Of course!\""
    a "\"É claro!\""

# game/a1s3.rpy:12
translate pt_br a1s3_e5980160:

    # "I'm in just my underwear...my Romanesque underwear."
    "Eu estou usando apenas roupas íntimas... minhas roupas íntimas romanescas."

# game/a1s3.rpy:13
translate pt_br a1s3_7a6cc71d:

    # "Last night, Amicus had shown me (a bit awkwardly) how to tie it on."
    "Na noite passada, Amicus me mostrou (de forma um pouco embaraçosa) como amarrar."

# game/a1s3.rpy:14
translate pt_br a1s3_6ceb2898:

    # "While it's comfortable, it always feels a little loose, and there's a constant worry that it's just going to drop off at some point."
    "É confortável, mas sinto que é um pouco solta, então há uma constante preocupação de que ela vai simplesmente cair do nada."

# game/a1s3.rpy:16
translate pt_br a1s3_3f9b2db6:

    # a "\"Anyway, we should get going soon. Alex is probably already waiting for us!\""
    a "\"Enfim, devemos ir logo. Alex provavelmente já está esperando por nós!\""

# game/a1s3.rpy:17
translate pt_br a1s3_66f1cd27:

    # "I rub the sleep from my eyes, drawing the blanket around myself a bit more tightly."
    "Esfrego meus olhos para tirar o sono, puxando o cobertor ao meu redor um pouco mais apertado."

# game/a1s3.rpy:18
translate pt_br a1s3_88eea13b:

    # m "\"For what?\""
    m "\"E a gente vai fazer o que uma hora dessas?\""

# game/a1s3.rpy:20
translate pt_br a1s3_9918fccc:

    # a "\"We're going to the island for a picnic! You wanted something to do, didn't you?\""
    a "\"Vamos até a ilha para um piquenique! Você queria alguma coisa para fazer, não é?\""

# game/a1s3.rpy:21
translate pt_br a1s3_705f013e:

    # m "\"Oh yeah, right.\""
    m "\"Ah, é verdade.\""

# game/a1s3.rpy:23
translate pt_br a1s3_b254eac9:

    # "I get up and grab my new robe off the back of the sofa."
    "Eu levanto e pego meu novo traje, o qual deixei nas costas do sofá."

# game/a1s3.rpy:24
translate pt_br a1s3_acae7eff:

    # a "\"Don't bother with a shower today since we'll be swimming...well, I will, anyway.\""
    a "\"Não se preocupe com banho hoje já que nós iremos nadar... bem, eu vou, pelo menos.\""

# game/a1s3.rpy:27
translate pt_br a1s3_000d9bf2:

    # "Amicus moves to the bathroom and pulls out a large glass bottle filled with a clear liquid."
    "Amicus vai até o banheiro e tira uma larga garrafa de vidro, a qual está cheia com um líquido claro."

# game/a1s3.rpy:28
translate pt_br a1s3_8c781358:

    # "He pours it into the glass cap and notices me watching."
    "Ele o derrama na tampa de vidro e me nota assistindo."

# game/a1s3.rpy:30
translate pt_br a1s3_2f196654:

    # a "\"Oh, would you like to try some? I suppose your species cares about dental hygiene considering your teeth look alright.\""
    a "\"Ah, gostaria de testar? Suponho que sua espécie se importa com higiene bucal considerando que os seus dentes parecem saudáveis.\""

# game/a1s3.rpy:31
translate pt_br a1s3_3ffe5d76:

    # m "\"What is it?\""
    m "\"O que é isso?\""

# game/a1s3.rpy:33
translate pt_br a1s3_8e1384f7:

    # a "\"A wash that simply cleans the teeth. Keeps the breath from becoming offensively odorous.\""
    a "\"Uma lavagem que simplesmente limpa os dentes. Evita que o hálito torne-se ofensivamente fedorento.\""

# game/a1s3.rpy:34
translate pt_br a1s3_32e3d4a8:

    # "He holds out the cap and I take it from him as he just pours the liquid straight into his mouth."
    "Ele estende a tampa e eu tiro da pata dele enquanto ele simplesmente derrama o líquido direto na boca."

# game/a1s3.rpy:35
translate pt_br a1s3_3ecefa9c:

    # "I sniff it and though I expected a minty smell, it's floral instead."
    "Dou uma cheirada e, por mais que eu tenha esperado sentir um aroma de menta, é na verdade floral."

# game/a1s3.rpy:36
translate pt_br a1s3_242ddae1:

    # m "\"Is this all you use to clean your teeth?\""
    m "\"Isso é tudo o que vocês usam pra limpar os dentes?\""

# game/a1s3.rpy:37
translate pt_br a1s3_06c0d7f0:

    # "Amicus swishes the liquid around in his mouth for a while, then spits it into the sink."
    "Amicus faz um bochecho com o líquido por um instante, cospindo-o na pia em seguida."

# game/a1s3.rpy:39
translate pt_br a1s3_00ab6a2e:

    # a "\"It removes any surface level debris, but you should get a deeper cleaning from a drone at least once a week. I can show you that later too, if you'd like.\""
    a "\"Ele remove qualquer resíduo superficial, mas você deveria fazer uma limpeza mais profunda de um drone pelo menos uma vez por semana. Eu posso te mostrar isso depois, também, se você quiser.\""

# game/a1s3.rpy:40
translate pt_br a1s3_ed6ee905:

    # "That...kinda sounds terrifying."
    "Isso parece assustador."

# game/a1s3.rpy:41
translate pt_br a1s3_57c00e1b:

    # m "\"Maaaybe.\""
    m "\"Taaalveeez.\""

# game/a1s3.rpy:43
translate pt_br a1s3_27f2c8dc:

    # a "\"Honestly, you're supposed to use this every morning, but I forgot yesterday in all the excitement that we had.\""
    a "\"Para ser honesto, o recomendado é usar isso todas as manhãs, mas eu esqueci ontem por causa de toda a emoção.\""

# game/a1s3.rpy:45
translate pt_br a1s3_ca6e7957:

    # "I lift the liquid-filled cap to my mouth and, with just a little hesitation, I pour it in."
    "Eu levanto a tampa cheia de líquido até minha boca e, com apenas um pouco de hesitação, jogo para dentro."

# game/a1s3.rpy:46
translate pt_br a1s3_a01c8f6f:

    # "The taste reminds me of walking into a room that's just been sprayed with air freshener."
    "O gosto me lembra de quando eu entro em um cômodo que acabou de ser aromatizado com spray."

# game/a1s3.rpy:47
translate pt_br a1s3_58536bfa:

    # "Not exactly pleasant, but when I spit it into the sink, I notice bits of what I assume to be plaque floating down the drain, and my mouth does feel a lot more fresh."
    "Não é exatamente agradável, mas, quando cuspo na pia, noto pedaços do que eu presumo que sejam placas flutuando pelo ralo e sinto minha boca muito mais fresca."

# game/a1s3.rpy:48
translate pt_br a1s3_4df62a91:

    # "Guess it works."
    "É, acho que funciona."

# game/a1s3.rpy:49
translate pt_br a1s3_a0bdeb12:

    # "Amicus seems impatient though, shifting his weight from one foot to the other."
    "Porém, Amicus parece impaciente, trocando o peso de seu corpo entre um pé e outro."

# game/a1s3.rpy:51
translate pt_br a1s3_94235ba0:

    # a "\"Ready, [mc]?\""
    a "\"Pronto, [mc]?\""

# game/a1s3.rpy:52
translate pt_br a1s3_b8afe3ec:

    # m "\"Uh, yeah, sure. Do you have bathing suits, or something?\""
    m "\"Ah, sim, claro. Vocês usam trajes de banho, ou algo assim?\""

# game/a1s3.rpy:54
translate pt_br a1s3_9a22748c:

    # a "\"Uhh, like clothes for swimming?\""
    a "\"Hã... como roupas para nadar?\""

# game/a1s3.rpy:55
translate pt_br a1s3_5b5a83e5:

    # "Amicus steps out of the room and into the main hallway as I follow him."
    "Amicus anda para fora do quarto, caminhando através do corredor enquanto eu o sigo."

# game/a1s3.rpy:58
translate pt_br a1s3_e8e158d7:

    # "At the same time I finish tying on my robe, trying to make sure everything is correctly in place."
    "Enquanto isso, termino de amarrar meu traje, me certificando de que tudo está em seu devido lugar."

# game/a1s3.rpy:60
translate pt_br a1s3_99b12af4:

    # a "\"No, we swim nude. But if you prefer to have something on you could use your undergarments. I can't imagine that would be comfortable, but Alex does it!\""
    a "\"Não, nós nadamos nus. Mas se você prefere estar vestindo alguma coisa, pode usar sua roupa íntima. Não consigo imaginar como isso seria confortável, mas Alex faz isso!\""

# game/a1s3.rpy:61
translate pt_br a1s3_c9dbdb63:

    # "Just as he says the cat's name, I see him standing in the hall, carrying a heavy-looking basket in both arms."
    "Assim que ele cita o nome do gato, noto ele no meio do salão, carregando uma cesta que parece pesada com os dois braços."

# game/a1s3.rpy:62
translate pt_br a1s3_cffb4dae:

    # "Once he sees us, he smiles."
    "Assim que ele nos vê, começa a sorrir."

# game/a1s3.rpy:64
translate pt_br a1s3_d0a2816a:

    # al "\"Hello Amicus, hello [mc]. It's good to see you again. How are you this morning?\""
    al "\"Olá, Amicus. Olá, [mc]. É bom vê-los novamente. Como estão hoje?\""

# game/a1s3.rpy:65
translate pt_br a1s3_7cf81e77:

    # "I'm about to respond, but Amicus is already speaking."
    "Estou prestes a responde, mas o Amicus já está falando."

# game/a1s3.rpy:67
translate pt_br a1s3_ff44c3f5:

    # a "\"Good, good. You got all the food, Alex?\""
    a "\"Bem, bem. Você pegou toda a comida, Alex?\""

# game/a1s3.rpy:69
translate pt_br a1s3_6e4347cc:

    # al "\"Uh, yeah. Though are you sure it's not against protocol that I took all of this?\""
    al "\"Ah, sim. Mas tem certeza que não é contra o protocolo eu pegar tudo isso?\""

# game/a1s3.rpy:71
translate pt_br a1s3_2b38fa88:

    # a "\"Well, it would be if I didn't approve it. Now let's go!\""
    a "\"Bem, seria se eu não aprovasse. Agora, vamos nessa!\""

# game/a1s3.rpy:73
translate pt_br a1s3_f3274d5f:

    # "Alex and I follow the excited wolf's swishing tail as we head toward the front archways, an area that I haven't been to before."
    "Eu e o Alex seguimos a animada cauda balançante do lobo enquanto andamos em direção aos arcos da entrada, uma área a qual eu nunca estive antes."

# game/a1s3.rpy:74
translate pt_br a1s3_4d724a8e:

    # ca "\"Ahem.\""
    ca "\"Ahem.\""

# game/a1s3.rpy:75
translate pt_br a1s3_4bd084ee:

    # "I hear a familiar grunt and we all stop and turn around."
    "Ouço um grunhido familiar e todos nós paramos e nos viramos."

# game/a1s3.rpy:79
translate pt_br a1s3_fc1b590c:

    # "Cato stands there watching us, stoic as always."
    "Cato nos observa, estoico como sempre."

# game/a1s3.rpy:80
translate pt_br a1s3_11699fa9:

    # ca "\"Where might you three be off to?\""
    ca "\"Para onde os três mocinhos estariam indo?\""

# game/a1s3.rpy:82
translate pt_br a1s3_4e6d55c5:

    # a "\"Er, hello, Cato! We're going for a swim.\""
    a "\"Hã... Olá, Cato! Estamos saindo para nadar.\""

# game/a1s3.rpy:84
translate pt_br a1s3_75fdd6c0:

    # ca "\"A swim?\""
    ca "\"Nadar?\""

# game/a1s3.rpy:85
translate pt_br a1s3_2b472108:

    # "I can't exactly tell what's going on behind that visor, but the tone in his voice doesn't seem all that enthusiastic."
    "Não consigo dizer exatamente o que está acontecendo por trás daquele visor, mas o tom de sua voz não parece tão entusiasmado."

# game/a1s3.rpy:86
translate pt_br a1s3_677abf3b:

    # "Amicus seems to sense it too."
    "Amicus parece sentir isso também."

# game/a1s3.rpy:88
translate pt_br a1s3_bcc81977:

    # a "\"Yes.\""
    a "\"Sim.\""

# game/a1s3.rpy:89
translate pt_br a1s3_f5f4dc21:

    # "A moment of silence goes by."
    "Um momento de silêncio se passa."

# game/a1s3.rpy:90
translate pt_br a1s3_df6be96d:

    # ca "\"You know you have combat training today, Amicus.\""
    ca "\"Você sabe que tem treino de combate hoje, Amicus.\""

# game/a1s3.rpy:91
translate pt_br a1s3_3daf5d0a:

    # a "\"Well...yes, but only for part of the day. We'll be back shortly after noon.\""
    a "\"Bem... sim, mas por parte do dia. Estaremos de volta pouco antes do meio dia.\""

# game/a1s3.rpy:92
translate pt_br a1s3_bb531317:

    # "Cato's face twitches and I can sense the disapproval coming off of him in waves."
    "Há uma sutil mudança no rosto do Cato e eu consigo sentir sua desaprovação saindo em ondas."

# game/a1s3.rpy:93
translate pt_br a1s3_d4bc88ba:

    # "Then he turns his head slightly in my direction."
    "Então ele vira a cabeça ligeiramente em minha direção."

# game/a1s3.rpy:95
translate pt_br a1s3_a7c7bd7d:

    # ca "\"You're taking the pets?\""
    ca "\"Você está levando os mascotes?\""

# game/a1s3.rpy:96
translate pt_br a1s3_7f1b07be:

    # "I quickly fix my face into a middle-distance stare."
    "Rapidamente, conserto meu rosto em um olhar desfocado."

# game/a1s3.rpy:97
translate pt_br a1s3_a6a70d37:

    # a "\"Yes, I thought we could all use a little fresh air.\""
    a "\"Sim, pensei que todos nós poderíamos aproveitar um pouco de ar fresco.\""

# game/a1s3.rpy:99
translate pt_br a1s3_9ec1ffe2:

    # "Cato goes on staring for a moment, and I start to believe what Amicus said about Cato not having a good mood."
    "Cato fica encarando por um momento e eu começo a acreditar no que o Amicus disse sobre ele não ser capaz de ter um bom humor."

# game/a1s3.rpy:100
translate pt_br a1s3_aaa1707d:

    # "Finally, the old wolf turns his attention back to Amicus."
    "Finalmente, o velho lobo volta sua atenção para o Amicus."

# game/a1s3.rpy:102
translate pt_br a1s3_03487f9b:

    # ca "\"Well, I have some of my own duties to take care of this morning, but I expect you to be in the amphitheater by the 11th hour. Do not be late.\""
    ca "\"Bem, eu tenho algumas das minhas próprias tarefas para me ocupar esta manhã, mas espero que você esteja no anfiteatro pela 11ª hora. Não se atrase.\""

# game/a1s3.rpy:104
translate pt_br a1s3_6899731d:

    # "With that, he turns and stalks off down the hall before disappearing around a marble corner."
    "Com isso, ele se vira e anda seguindo o corredor antes de desaparecer em um canto de mármore."

# game/a1s3.rpy:105
translate pt_br a1s3_48538c1f:

    # "Amicus lets out a breath."
    "Amicus solta um suspiro."

# game/a1s3.rpy:107
translate pt_br a1s3_2556e7a4:

    # a "\"Ugh, thought he was going to cancel our outing all together. Alright, let's go before anyone else tries to stop us!\""
    a "\"Argh, achei que ele cancelaria nosso passeio de uma vez por todas. Certo, vamos embora antes que outra pessoa tente nos impedir!\""

# game/a1s3.rpy:108
translate pt_br a1s3_d5a5bc01:

    # "Amicus quickly turns toward the archways again and leads us out into the warm morning air."
    "Amicus rapidamente se vira e anda em direção aos arcos de novo, nos guiando para fora pelo ar caloroso da manhã."

# game/a1s3.rpy:113
translate pt_br a1s3_5c4fe161:

    # al "\"You seem very eager, Amicus.\""
    al "\"Você parece bem ansioso, Amicus.\""

# game/a1s3.rpy:115
translate pt_br a1s3_461285c4:

    # a "\"Well, I haven't been swimming for weeks now, and I need a good exercise.\""
    a "\"Bem, eu não nado há semanas e realmente preciso de um bom exercício.\""

# game/a1s3.rpy:116
translate pt_br a1s3_e5735906:

    # "As we walk, I notice Alex huffing and puffing, struggling with the basket, so I hold out my hand."
    "Conforme caminhamos, noto o Alex bufando e arfando, lutando para carregar a cesta, então, estendo a minha mão."

# game/a1s3.rpy:117
translate pt_br a1s3_66610f9e:

    # m "\"Here, do you need help?\""
    m "\"Ei, precisa de ajuda?\""

# game/a1s3.rpy:119
translate pt_br a1s3_ae7d8d6c:

    # al "\"Oh, I don't want to inconvenience you—\""
    al "\"Ah, eu não quero incomodá-lo—\""

# game/a1s3.rpy:120
translate pt_br a1s3_47406245:

    # "I reach out and take the handle of the basket and Alex doesn't resist as I pull it out of his paws."
    "Eu estendo a mão e pego a cesta pela alça, Alex não resiste enquanto eu a puxo para fora das patas dele."

# game/a1s3.rpy:121
translate pt_br a1s3_948ae6a3:

    # "It's heavy, but not impossible to carry."
    "É pesado, mas não é impossível de carregar."

# game/a1s3.rpy:122
translate pt_br a1s3_df045a78:

    # "I heft it in both my hands as we walk down the path toward the lake."
    "Eu seguro com as duas mãos enquanto andamos pelo caminho em direção ao lago."

# game/a1s3.rpy:124
translate pt_br a1s3_6ccc155d:

    # al "\"Are you sure it's not too heavy?\""
    al "\"Tem certeza que não é muito pesado?\""

# game/a1s3.rpy:125
translate pt_br a1s3_88309383:

    # m "\"I'm fine! Though I think someone else might be able to handle it a bit better than us, especially since I imagine it's mostly HIS food.\""
    m "\"Tô de boa! Mas eu acho que um certo alguém poderia carregar um pouco melhor que a gente, especialmente considerando que a maior parte da comida aqui é DELE.\""

# game/a1s3.rpy:127
translate pt_br a1s3_76c7624b:

    # "Amicus's ears perk at my pointed statement."
    "As orelhas do Amicus pulam com a indireta."

# game/a1s3.rpy:128
translate pt_br a1s3_3006f975:

    # a "\"Oh! Is it heavy?\""
    a "\"Ah! Está pesado?\""

# game/a1s3.rpy:129
translate pt_br a1s3_8b3760fd:

    # "Amicus turns and yanks the basket from me, easily swinging it in one paw."
    "Amicus se vira e puxa a cesta das minhas mãos, facilmente segurando em uma pata."

# game/a1s3.rpy:131
translate pt_br a1s3_643de721:

    # a "\"Should have said something, though I'll have to give it back once we get to the shore. I'll be swimming to the island!\""
    a "\"Eu deveria ter dito alguma coisa, mas eu vou precisar devolver assim que chegarmos na margem do lago, vou nadando até a ilha!\""

# game/a1s3.rpy:132
translate pt_br a1s3_e499761a:

    # "I frown."
    "Isso me faz franzir a testa."

# game/a1s3.rpy:133
translate pt_br a1s3_73531d3f:

    # m "\"Is it far?\""
    m "\"É longe?\""

# game/a1s3.rpy:135
translate pt_br a1s3_d2fbb4d9:

    # a "\"Well of course you'll be taking the Sightseer.\""
    a "\"Bem, é claro que vocês irão até lá usando o aero-observador.\""

# game/a1s3.rpy:136
translate pt_br a1s3_97e3eb46:

    # m "\"What's that?\""
    m "\"E o que é isso?\""

# game/a1s3.rpy:137
translate pt_br a1s3_535e834e:

    # "Alex moves up to walk alongside me."
    "Alex se aproxima para andar ao meu lado."

# game/a1s3.rpy:139
translate pt_br a1s3_3aa331dd:

    # al "\"You'll see. It's sort of a hovercraft for sight-seeing, as the name implies.\""
    al "\"Você vai ver. É uma espécie de planador para passeios turísticos, como o nome indica.\""

# game/a1s3.rpy:141
translate pt_br a1s3_f5e0c73f:

    # "After a few minutes, we reach the shore where there's a small gazebo with various boats underneath it."
    "Depois de alguns minutos, chegamos até a margem do lago, onde há um pequeno gazebo com várias embarcações embaixo."

# game/a1s3.rpy:142
translate pt_br a1s3_6a04aad0:

    # "There's also what sort of looks like a Jet Ski and next to that is...just a glass box with an open top."
    "Também há algo que parece com um Jet Ski e, próximo a este, simplesmente uma caixa de vidro aberta em cima."

# game/a1s3.rpy:143
translate pt_br a1s3_aa02308d:

    # "This is what Alex and Amicus walk up to, the wolf leaning over to drop the picnic basket inside."
    "É para onde Alex e Amicus caminham, o lobo se inclina para soltar a cesta de piquenique dentro."

# game/a1s3.rpy:144
translate pt_br a1s3_a3976d28:

    # "Once he does that, he strips off his underwear and tosses it into the glass craft as well."
    "Assim que ele faz isso, começa a tirar as roupas íntimas e as joga no veículo de vidro também."

# game/a1s3.rpy:145
translate pt_br a1s3_e0aeb681:

    # "I look away and notice Alex do the same, his ears down as he blushes furiously."
    "Eu desvio o olhar e noto que Alex faz o mesmo, suas orelhas furiosamente vermelhas e abaixadas."

# game/a1s3.rpy:146
translate pt_br a1s3_df431529:

    # "Trying to ignore the wolf, I walk up to the strange little craft, noticing that there's an open space on the side of the box that allows us to get in."
    "Tentando ignorar o lobo, caminho até a pequena embarcação estranha, notando que há um espaço aberto ao lado o qual nos permite entrar."

# game/a1s3.rpy:147
translate pt_br a1s3_69531c60:

    # "The floor is glass as well, and I can see the dirt and vegetation underneath us."
    "O chão também é feito de vidro e eu consigo enxergar a terra e vegetação embaixo de nós."

# game/a1s3.rpy:148
translate pt_br a1s3_3b2c0be4:

    # a "\"Race you to the island!\""
    a "\"Corrida até a ilha!\""

# game/a1s3.rpy:149
translate pt_br a1s3_151612f9:

    # "Amicus cheerfully waves at us before running into the lake, the wolf's bushy tail swooshing around over his naked butt."
    "Amicus alegremente acena para nós antes de mergulhar no lago, sua cauda estufada balançando sobre seu traseiro à mostra."

# game/a1s3.rpy:151
translate pt_br a1s3_ca2cfce8:

    # al "\"Ugh...so inappropriate.\""
    al "\"Argh... tão inapropriado.\""

# game/a1s3.rpy:153
translate pt_br a1s3_e8f4042e:

    # "Alex shakes his head and turns to a slanted glass panel attached to the side of the craft."
    "Alex chacoalha a cabeça e se vira para um painel de vidro inclinado e anexado à lateral do veículo."

# game/a1s3.rpy:154
translate pt_br a1s3_0558b100:

    # "He touches it and several bright characters come to life on the screen."
    "Ele o toca e vários símbolos brilhantes ganham vida na tela."

# game/a1s3.rpy:155
translate pt_br a1s3_2caf53ee:

    # "A few seconds later, our little glass craft levitates off the ground and starts to move over the water, albeit at a very slow pace."
    "Alguns segundos depois, a pequena embarcação de vidro levita do chão e começa a se mover em cima da água, mas em uma velocidade bem lenta."

# game/a1s3.rpy:156
translate pt_br a1s3_bcd6e1df:

    # m "\"Wow, what is this thing?\""
    m "\"Uau, o que é essa coisa?\""

# game/a1s3.rpy:160
translate pt_br a1s3_81b3e19f:

    # al "\"A sight-seeing craft. Parental tech, so it's very safe and easy to navigate.\""
    al "\"Um veículo aero-observador. Tecnologia dos progenitores, então é bem fácil e seguro de se navegar.\""

# game/a1s3.rpy:161
translate pt_br a1s3_4ce35368:

    # "I watch as we start to float over the slightly choppy water, Amicus already about 10 meters out in front of us."
    "Observo conforme começamos a flutuar sobre a água levemente agitada, Amicus já a uns 10 metros na nossa frente."

# game/a1s3.rpy:162
translate pt_br a1s3_f1ca04b0:

    # m "\"He's a pretty good swimmer.\""
    m "\"Ele é um ótimo nadador.\""

# game/a1s3.rpy:164
translate pt_br a1s3_d58b328e:

    # al "\"We're just slow. That's why he turned this into a race because he knows we won't beat him, even if we're going at full speed.\""
    al "\"Nós só estamos lentos. É por isso que ele transformou isso em uma corrida, sabe que não ganharemos dele. Mesmo se formos na velocidade total.\""

# game/a1s3.rpy:165
translate pt_br a1s3_04cb2419:

    # "Sure enough, Amicus starts to widen the gap."
    "Como observado, a distância entre nós e o Amicus começa a aumentar."

# game/a1s3.rpy:166
translate pt_br a1s3_7400efa6:

    # "I notice Alex's ears twitching about as he navigates our craft, looking left and right while avoiding looking at the water altogether."
    "Eu noto as orelhas do Alex inquietas enquanto ele pilota o veículo, olhando para os lados enquanto evita olhar na água em si."

# game/a1s3.rpy:167
translate pt_br a1s3_ab910075:

    # m "\"Do you not like swimming?\""
    m "\"Você não gosta de nadar?\""

# game/a1s3.rpy:168
translate pt_br a1s3_9f662e78:

    # al "\"Oh, I hate large bodies of water. It's a bit stressful coming out here honestly, but the island is serene and for the most part it makes the trip worth it.\""
    al "\"Ah, eu detesto grandes extensões de água. Para ser sincero, é um pouco estressante vir até aqui, mas a ilha é serena na maior parte do tempo e isso faz a viagem valer a pena.\""

# game/a1s3.rpy:169
translate pt_br a1s3_da6b3ec9:

    # m "\"Ah...felines are kind of like that on Ea—my planet, too.\""
    m "\"Ah... os felinos são desse jeito na Te—no meu planeta, também.\""

# game/a1s3.rpy:170
translate pt_br a1s3_534d24e1:

    # "I cringe inwardly as I almost reveal the name of my planet."
    "Morro por dentro depois de quase revelar o nome do meu planeta."

# game/a1s3.rpy:171
translate pt_br a1s3_6d17c3ca:

    # "It was pretty blatant, but Alex goes on like he didn't even notice."
    "Isso foi bem flagrante, mas Alex continua agindo como se nem tivesse percebido."

# game/a1s3.rpy:173
translate pt_br a1s3_6e739146:

    # al "\"Well, yes, similar origins and all, but honestly I'm a bit surprised that you're doing so well yourself, or that you even decided to come out here!\""
    al "\"Bem, sim, origens semelhantes e tudo. Na verdade, estou um pouco surpreso por você estar se saindo tão bem, até por ter decidido vir aqui em primeiro lugar.\""

# game/a1s3.rpy:174
translate pt_br a1s3_06dde7c5:

    # "That comes off as a little strange to me, but I'm distracted watching Amicus get closer to the island."
    "Isso soa um pouco estranho para mim, mas eu fico distraído assistindo o Amicus chegar mais perto da ilha."

# game/a1s3.rpy:175
translate pt_br a1s3_8ac4acd5:

    # "Maybe only about fifty meters now."
    "Talvez faltando apenas cerca de cinquenta metros agora."

# game/a1s3.rpy:176
translate pt_br a1s3_7fe5589f:

    # "I start to get an idea, though."
    "Então uma ideia invade minha mente."

# game/a1s3.rpy:177
translate pt_br a1s3_8c702794:

    # "Judging by the distance between us, Amicus, and the island, I feel like I might be able to beat him..."
    "Julgando pela distância entre nós, Amicus, e a ilha, acho que seria capaz de ultrapassá-lo..."

# game/a1s3.rpy:178
translate pt_br a1s3_dfebb020:

    # "I grin, then start stripping off my robe."
    "Eu sorrio, então começo a tirar o meu traje."

# game/a1s3.rpy:180
translate pt_br a1s3_f5ecb761:

    # al "\"Wh-what are you doing? We're not at the island yet!\""
    al "\"O-O que você está fazendo? Nós não chegamos na ilha ainda!\""

# game/a1s3.rpy:181
translate pt_br a1s3_ea24e847:

    # "Alex blushes furiously again, looking away."
    "Alex fica furiosamente constrangido outra vez, desviando o olhar."

# game/a1s3.rpy:182
translate pt_br a1s3_42e37fd2:

    # m "\"I'm gonna beat him.\""
    m "\"Eu vou ganhar dele.\""

# game/a1s3.rpy:184
translate pt_br a1s3_b985c432:

    # al "\"What!?\""
    al "\"O que!?\""

# game/a1s3.rpy:185
translate pt_br a1s3_141abefa:

    # "I grab onto the edge of the glass barrier and swing my legs over it."
    "Eu agarro a borda da barreira de vidro e levanto minhas pernas sobre ela."

# game/a1s3.rpy:186
translate pt_br a1s3_e0f2e819:

    # al "\"NO!\""
    al "\"NÃO!\""

# game/a1s3.rpy:187
translate pt_br a1s3_5351acb8:

    # "Alex actually tries to lunge for me, his paws just barely missing as I plunge into the lake."
    "Alex tenta me alcançar, na verdade, mas suas patas mal tocam em mim antes de eu mergulhar no lago."

# game/a1s3.rpy:190
translate pt_br a1s3_351a8526:

    # "I don't have much time to think about why because I'm instantly surrounded by freezing cold water."
    "Não tenho muito tempo para pensar o porquê já que sou instantaneamente cercado por água gelada."

# game/a1s3.rpy:191
translate pt_br a1s3_d1d89c21:

    # "I come up, gasping from the shock of it before I spot the direction of the island and start swimming toward it."
    "Vou até a superfície, arfando por conta do choque térmico até que miro na ilha e começo a nadar em direção a ela."

# game/a1s3.rpy:192
translate pt_br a1s3_1a76b22d:

    # "It's been a while since I've really had a chance to swim."
    "Já faz um tempo desde a última vez que nadei."

# game/a1s3.rpy:193
translate pt_br a1s3_4fe897ed:

    # "I'd always been pretty good at it though, and soon enough I get into the familiar motions of putting one arm ahead of the other while turning my head to take breaths."
    "Mas sempre fui muito bom nisso e, rápido o suficiente, consigo entrar nos movimentos familiares de colocar um braço na frente do outro enquanto levanto minha cabeça para respirar."

# game/a1s3.rpy:194
translate pt_br a1s3_4ebcdde2:

    # "While this is going on, I can still hear Alex shouting behind me."
    "Enquanto isso acontece, ainda consigo ouvir o Alex gritando atrás de mim."

# game/a1s3.rpy:195
translate pt_br a1s3_a9b9d98b:

    # "But then, just as I'm feeling that I'm about to gain on Amicus, I get rammed by something heavy and furry that suddenly starts to pull me into its grasp."
    "Mas então, no mesmo momento que sinto estar prestes a ganhar do Amicus, choco em uma coisa pesada e peluda que repentinamente começa a me puxar."

# game/a1s3.rpy:196
translate pt_br a1s3_2d331ada:

    # "At first, I wonder if I've been captured by some kind of Adastran sea monster."
    "A princípio, acho que fui capturado por algum tipo de monstro marinho adastriano."

# game/a1s3.rpy:197
translate pt_br a1s3_58e3de65:

    # "...Maybe that's why Alex is freaking out."
    "(...) talvez seja por isso que o Alex esteja enlouquecendo."

# game/a1s3.rpy:198
translate pt_br a1s3_af44257b:

    # "But just as I'm about to resign myself to that fate—"
    "Mas, assim que eu fico prestes a me render a esse destino—"

# game/a1s3.rpy:199
translate pt_br a1s3_0d181c37:

    # a "\"[mc]! Don't worry, I've got you!\""
    a "\"[mc]! Não se preocupe, peguei você!\""

# game/a1s3.rpy:200
translate pt_br a1s3_40485817:

    # "I stop fighting against the big, furry arms wrapping around me as I feel Amicus kicking his legs under mine, sort of pulling me toward the island that's just a few dozen meters away now."
    "Eu paro de lutar contra os braços grandes e peludos me envolvendo assim que sinto as pernas do Amicus chutando sob as minhas. Me puxando em direção à ilha que agora está a apenas algumas dezenas de metros. "

# game/a1s3.rpy:201
translate pt_br a1s3_615edfba:

    # m "\"Wh—what are you doing!?\""
    m "\"O—o que você tá fazendo!?\""

# game/a1s3.rpy:202
translate pt_br a1s3_abd632b0:

    # "I try to pull away, but Amicus keeps me in a fierce death-grip, refusing to loosen up at all."
    "Eu tento me libertar, mas Amicus me mantém em um feroz aperto da morte, se recusando a relaxar os braços."

# game/a1s3.rpy:203
translate pt_br a1s3_a7d8f66a:

    # al "\"By Galen!\""
    al "\"Por Galen!\""

# game/a1s3.rpy:204
translate pt_br a1s3_cbbbfe2e:

    # "I look up and see Alexios dumping out the basket full of food into the Sightseer before throwing the basket at me."
    "Eu olho para cima e vejo o Alexios pegando a cesta cheia de comida no aero-observador antes de jogar na minha direção."

# game/a1s3.rpy:205
translate pt_br a1s3_1f53c82b:

    # al "\"Use this! It will keep you above water!\""
    al "\"Use isso! Vai mantê-lo em cima da água!\""

# game/a1s3.rpy:206
translate pt_br a1s3_465ec4e9:

    # "It hits me in the face before gently bobbing away in the waves."
    "A cesta me acerta bem na cara antes de gentilmente boiar nas ondas."

# game/a1s3.rpy:207
translate pt_br a1s3_1bc7d1bb:

    # m "\"What the HELL is going on!?\""
    m "\"Mas que PORRA tá acontecendo!?\""

# game/a1s3.rpy:208
translate pt_br a1s3_dd1aa4bf:

    # "I try to pull away from Amicus one last time, but give up, leaning into his chest with a bewildered expression on my face."
    "Eu tento me libertar do Amicus uma última vez, mas desisto, encostando no peito dele com uma expressão confusa em meu rosto."

# game/a1s3.rpy:209
translate pt_br a1s3_e47333b8:

    # "He kicks his feet awkwardly under mine before I finally feel our feet drag into the shifting sand under the water."
    "Ele chuta seus pés desjeitosamente sob os meus antes de eu finalmente senti-los arrastando na areia sob a água."

# game/a1s3.rpy:211
translate pt_br a1s3_8c40b9e3:

    # "Even then, Amicus doesn't let me go."
    "Até mesmo nesse momento, Amicus não me deixa sair."

# game/a1s3.rpy:212
translate pt_br a1s3_71fd4e05:

    # "He keeps his firm grip around my wrist as he pulls me to shore, bringing us onto the little island."
    "Ele mantém seu firme aperto em volta do meu pulso enquanto me puxa até a margem, nos trazendo até a pequena ilha."

# game/a1s3.rpy:213
translate pt_br a1s3_e0f69c2d:

    # a "\"Are you alright!?\""
    a "\"Você está bem!?\""

# game/a1s3.rpy:214
translate pt_br a1s3_21630eec:

    # "Amicus puts his paws on my shoulders, his wide eyes looking into mine, breathing heavily."
    "Amicus coloca suas patas em meus ombros, seus olhos arregalados olhando nos meus, respirando com dificuldade."

# game/a1s3.rpy:215
translate pt_br a1s3_2096c85e:

    # m "\"Yes! What the hell just happened?\""
    m "\"Sim! Que merda acabou de acontecer?\""

# game/a1s3.rpy:216
translate pt_br a1s3_0b6bd83b:

    # "I rub my nose where the basket hit me in the face and that's when Alex's little craft pushes gently onto the sand."
    "Eu esfrego meu nariz onde a cesta me acertou na cara e é quando a pequena embarcação do Alex empurra suavemente na areia."

# game/a1s3.rpy:217
translate pt_br a1s3_1ad669eb:

    # "He hops out, running up to us."
    "Ele pula fora, correndo até nós."

# game/a1s3.rpy:219
translate pt_br a1s3_da0bd097:

    # al "\"I don't know what happened Amicus! He just jumped out! I'm sorry I couldn't stop him.\""
    al "\"Eu não sei o que aconteceu, Amicus! Ele só pulou fora! Me desculpe por não ter conseguido impedir.\""

# game/a1s3.rpy:220
translate pt_br a1s3_f007de41:

    # "Alex bows deeply, ears flat and trembling."
    "Alex se curva profundamente, as orelhas planas e trêmulas."

# game/a1s3.rpy:221
translate pt_br a1s3_70f8ff35:

    # "I start to wonder if maybe there's something in the water that I wasn't supposed to come into contact with."
    "Começo a me perguntar se tinha alguma coisa com a qual eu não deveria entrar em contato na água."

# game/a1s3.rpy:222
translate pt_br a1s3_4d6d9a18:

    # "I look at my skin, but everything seems fine."
    "Eu olho para minha pele, mas tudo parece bem."

# game/a1s3.rpy:223
translate pt_br a1s3_35bc6ab6:

    # "I finally look up at Amicus, trying to ignore his dick as it swings around between his legs."
    "Finalmente levanto meu rosto e olho para o Amicus, tentando ignorar o pinto dele balançando entre as pernas."

# game/a1s3.rpy:224
translate pt_br a1s3_7a52be3f:

    # "Amicus seems to notice at the same time and covers up his crotch with his paw, keeping the other on my shoulder."
    "Amicus parece notar ao mesmo tempo e cobre a virilha com sua pata, deixando a outra em meu ombro."

# game/a1s3.rpy:225
translate pt_br a1s3_b21e4f45:

    # m "\"Can you just explain to me what happened?\""
    m "\"Será que vocês podem me explicar o que acabou de acontecer?\""

# game/a1s3.rpy:227
translate pt_br a1s3_c7328555:

    # "Amicus frowns at me."
    "Amicus franze a testa para mim."

# game/a1s3.rpy:228
translate pt_br a1s3_3d000ce9:

    # a "\"Well...You can't swim...you're hopeless in water. It's why I wanted you in the craft.\""
    a "\"Bem... você não consegue nadar... é inútil na água. Foi por isso que eu quis que ficasse na embarcação.\""

# game/a1s3.rpy:229
translate pt_br a1s3_59ddd0d0:

    # "Alex's lips tremble a bit, as if about to cry."
    "Os lábios do Alex tremem um pouco, como se estivesse prestes a chorar."

# game/a1s3.rpy:231
translate pt_br a1s3_17cb50a0:

    # al "\"You're not born with natural swimming abilities. Whenever a primate falls into water they're almost sure to drown. Are you sure you're okay? I'm so, so sorry.\""
    al "\"Você não nasce com habilidades de natação naturalmente. Sempre que um primata cai na água é quase certo que eles se afogarão. Você tem certeza que está bem? Eu sinto muito, muito mesmo.\""

# game/a1s3.rpy:232
translate pt_br a1s3_f588645f:

    # "The way they explain to me how primates work reminds me that they still might not consider me to be on the same intelligence level as them."
    "A forma como ele me explica que primatas se comportam me lembra que eles ainda provavelmente não me consideram estar no mesmo nível de inteligência deles."

# game/a1s3.rpy:233
translate pt_br a1s3_779d50e1:

    # "It's like I don't know my own species capabilities, that I just jumped in because I'm a stupid barbarian."
    "É como se eu não soubesse das capacidades da minha própria espécie, que eu só pulei na água porque sou um bárbaro estúpido."

# game/a1s3.rpy:234
translate pt_br a1s3_ddd6c55d:

    # "It irritates me, but both of them look almost traumatized."
    "Isso me irrita, mas ambos parecem quase traumatizados."

# game/a1s3.rpy:235
translate pt_br a1s3_4efd49cb:

    # "Especially Amicus."
    "Especialmente o Amicus."

# game/a1s3.rpy:236
translate pt_br a1s3_ce68a004:

    # "The paw not concealing his crotch is still firmly locked on my shoulder, as if worried I'm going to go running off into the water again."
    "A pata não cobrindo a virilha ainda segura firmemente em meu ombro, como se ele estivesse preocupado que eu fosse correr para dentro da água outra vez."

# game/a1s3.rpy:237
translate pt_br a1s3_728267e7:

    # m "\"Guys...I can swim. I mean, yeah it's not natural for us, but we can learn. I've known how to swim since I was a kid.\""
    m "\"Pessoal... eu consigo nadar. Quer dizer, sim, não é uma habilidade natural, mas dá pra aprender. Eu sei como nadar desde que eu era criança.\""

# game/a1s3.rpy:238
translate pt_br a1s3_dcacdd54:

    # "They still stare back at me, as if not understanding."
    "Eles continuam me encarando, como se não estivessem entendendo."

# game/a1s3.rpy:239
translate pt_br a1s3_af121244:

    # a "\"Really?\""
    a "\"Sério?\""

# game/a1s3.rpy:240
translate pt_br a1s3_c5a23f0e:

    # m "\"Well yeah, do you think I just jumped out of the...the thing to just drown myself?\""
    m "\"Mas é claro que sim, tu acha que eu ia pular do negócio lá só pra me afogar assim do nada?\""

# game/a1s3.rpy:241
translate pt_br a1s3_65f1d361:

    # "Amicus lets go of my shoulder to cover his dick with both paws now."
    "Amicus solta o meu ombro para cobrir o pinto dele com as duas patas agora."

# game/a1s3.rpy:242
translate pt_br a1s3_b6a2cf87:

    # a "\"I don't know. I know you're unhappy here, so I wasn't sure...\""
    a "\"Eu sei lá. Eu sei que você não se sente feliz aqui, então eu não tinha certeza...\""

# game/a1s3.rpy:243
translate pt_br a1s3_e33f02ef:

    # "I laugh."
    "Eu começo a rir."

# game/a1s3.rpy:244
translate pt_br a1s3_864b89ce:

    # m "\"I'm not THAT unhappy. I'm fine. And you know, I'm not an idiot. I thought you'd know this by now, Amicus.\""
    m "\"Eu não tô TÃO infeliz assim, cara, eu tô bem. Não sou idiota, achei que você já saberia disso a essa altura, Amicus.\""

# game/a1s3.rpy:245
translate pt_br a1s3_e1ecad33:

    # "Things go quiet then; Alex looking off to the side with his ears down, Amicus standing awkwardly and covering his crotch with both paws."
    "Então, tudo fica quieto; Alex olhando para o lado com as orelhas abaixadas, Amicus sem jeito e cobrindo a virilha com as duas patas."

# game/a1s3.rpy:246
translate pt_br a1s3_0a75131a:

    # m "\"So did I ruin our outing?\""
    m "\"Então, eu estraguei o passeio?\""

# game/a1s3.rpy:248
translate pt_br a1s3_7f345d7e:

    # a "\"No, no. I just need to remember that you're not a typical Child. Now uh, let's try to relax and have some fun. It's the whole reason we came out here after all!\""
    a "\"Não, não. Eu só preciso me lembrar que você não é um infante qualquer. Agora, hã... vamos tentar relaxar e nos divertir um pouco. Foi por isso que viemos até aqui, afinal!\""

# game/a1s3.rpy:249
translate pt_br a1s3_73a4e09c:

    # "Alex still looks a bit dejected, looking off toward the Sightseer."
    "Alex ainda parece um pouco desanimado, olhando na direção do aero-observador."

# game/a1s3.rpy:250
translate pt_br a1s3_d689df3d:

    # al "\"I ruined our food. I'm sorry.\""
    al "\"Eu estraguei nossa comida. Me desculpem.\""

# game/a1s3.rpy:251
translate pt_br a1s3_5ea15bd5:

    # "Alex bows again."
    "Alex se curva outra vez."

# game/a1s3.rpy:252
translate pt_br a1s3_171f7346:

    # "I remember how Alex isn't really supposed to know about my intelligence, or anything about me, really."
    "Então eu me lembro que o Alex não deveria saber sobre minha inteligência, ou qualquer coisa sobre mim."

# game/a1s3.rpy:253
translate pt_br a1s3_3303ec66:

    # "But if he's bothered by the conversation that just took place, he's not showing it."
    "Mas se ele está incomodado com a conversa que acabou de acontecer, não está demonstrando."

# game/a1s3.rpy:254
translate pt_br a1s3_f887bb98:

    # "Amicus shrugs."
    "Amicus dá de ombros."

# game/a1s3.rpy:256
translate pt_br a1s3_9f456f95:

    # a "\"Stop bowing, it makes me feel strange.\""
    a "\"Pare de se curvar, faz eu me sentir estranho.\""

# game/a1s3.rpy:257
translate pt_br a1s3_1d1bda8a:

    # "The naked wolf ambles over to the craft and as he leans over to look at the cluttered mess inside"
    "O lobo pelado caminha até o veículo e, quando ele se inclina para olhar a bagunça desordenada de dentro..."

# game/a1s3.rpy:258
translate pt_br a1s3_4886ba73:

    # "His tail lifts and we get a view of his butt again."
    "...sua cauda levanta e nós temos uma boa visão de seu traseiro mais uma vez."

# game/a1s3.rpy:260
translate pt_br a1s3_797a005e:

    # "Alex looks away, blushing, but at this point I think I've given up on trying not to see the various naked parts of this wolf."
    "Alex desvia o olhar, constrangido, mas eu acho que já desisti de tentar não olhar para as partes nuas desse lobo."

# game/a1s3.rpy:261
translate pt_br a1s3_40074a98:

    # "Being in the nude seems pretty natural for him, even if he tries to hide it from us."
    "Estar pelado parece bem natural para ele, mesmo que ele tente esconder isso de nós."

# game/a1s3.rpy:263
translate pt_br a1s3_b7cf2bd1:

    # a "\"I think we can salvage a decent meal out of this. The wine's good!\""
    a "\"Acho que nós podemos ter uma refeição decente com isso. O vinho está bom!\""

# game/a1s3.rpy:264
translate pt_br a1s3_09805e56:

    # "Amicus lifts a large bottle of wine into the air, still not turning around."
    "Amicus levanta uma larga garrafa de vinho no ar, ainda sem se virar."

# game/a1s3.rpy:266
translate pt_br a1s3_95c34620:

    # al "\"I—I'll sort through it Amicus. Please, enjoy your swimming exercises in the meantime.\""
    al "\"Eu-eu resolvo isso, Amicus. Por favor, aproveite seus exercícios de natação por enquanto.\""

# game/a1s3.rpy:267
translate pt_br a1s3_76423db0:

    # "Alex quickly moves to start gathering up the food, head down."
    "Alex rapidamente se move para começar a pegar a comida, sua cabeça abaixada."

# game/a1s3.rpy:269
translate pt_br a1s3_f3c795f2:

    # a "\"Well...alright. And ears up, Alex! We're here to have fun!\""
    a "\"Ok... tudo bem. E orelhas erguidas, Alex! Estamos aqui para nos divertir!\""

# game/a1s3.rpy:270
translate pt_br a1s3_27de9264:

    # "Alex puts his ears up, but doesn't lift his head to look at us."
    "Alex levanta as orelhas, mas não vira a cabeça pra nos olhar."

# game/a1s3.rpy:272
translate pt_br a1s3_1e70efdc:

    # a "\"Oh, right.\""
    a "\"Ah, tudo bem.\""

# game/a1s3.rpy:273
translate pt_br a1s3_39fd8972:

    # "The wolf grins at me, dipping his muzzle down at his crotch."
    "O lobo sorri para mim, o focinho apontando na própria virilha."

# game/a1s3.rpy:274
translate pt_br a1s3_e4aec8cb:

    # a "\"The Cats are just like you when it comes to this sort of thing. Anyway, I'll get in the water so you won't have to keep averting your eyes. You should join me now that we know you can swim, [mc]!\""
    a "\"Os gatos são iguais a vocês se tratando desse tipo de coisa. Enfim, eu vou entrar na água, então vocês não vão precisar ficar desviando os olhos. Você deveria vir comigo agora que nós sabemos que consegue nadar, [mc]!\""

# game/a1s3.rpy:276
translate pt_br a1s3_f033435a:

    # "I start to follow, then look back at the cat."
    "Eu começo a segui-lo, então olho de volta para o gato."

# game/a1s3.rpy:277
translate pt_br a1s3_e4baecd0:

    # m "\"Uh, do you need help, Alex?\""
    m "\"Hã... precisa de ajuda, Alex?\""

# game/a1s3.rpy:279
translate pt_br a1s3_b0e37c50:

    # "Alex shakes his head quickly, and I can see that he's still blushing."
    "Alex balança a cabeça rapidamente e eu consigo notar que ele ainda está constrangido."

# game/a1s3.rpy:280
translate pt_br a1s3_9e1381cc:

    # al "\"Go on and swim, [mc]. I'll just be sunbathing anyway.\""
    al "\"Pode ir nadar, [mc]. Eu vou apenas tomar um banho de sol, de qualquer maneira.\""

# game/a1s3.rpy:282
translate pt_br a1s3_b8b83359:

    # "There isn't much room in the Sightseer for two people, and Amicus seems to be waiting for me, so I follow the wolf out toward the water."
    "Não há muito espaço no aero-observador para duas pessoas e Amicus parece estar esperando por mim, então sigo o lobo em direção à água."

# game/a1s3.rpy:284
translate pt_br a1s3_0c2ccc83:

    # a "\"Intelligent conversation AND a swimming partner. I have a pet that can do it all!\""
    a "\"Papo cabeça e parceria de natação. Tenho um mascote que consegue fazer tudo!\""

# game/a1s3.rpy:285
translate pt_br a1s3_6a678fbf:

    # "Amicus shoulders me as we walk along the beach, making me stumble."
    "Amicus coloca um braço ao redor do meu ombro conforme andamos pela praia, me fazendo tropeçar."

# game/a1s3.rpy:286
translate pt_br a1s3_2cd5ad3b:

    # m "\"Hey.\""
    m "\"Eeei.\""

# game/a1s3.rpy:287
translate pt_br a1s3_c2a52699:

    # "I say it warningly, even though I know he's joking."
    "Eu falo isso como um aviso, mesmo sabendo que ele está brincando."

# game/a1s3.rpy:288
translate pt_br a1s3_933fca9f:

    # m "\"You know, I have to wonder why you'd take me out here if you didn't think I could swim.\""
    m "\"Sabe, tenho que me perguntar por que você me trouxe até aqui se pensava que eu não podia nadar.\""

# game/a1s3.rpy:289
translate pt_br a1s3_6c56c8d8:

    # a "\"Everyone enjoys the beach whether they can swim or not!\""
    a "\"Todo mundo consegue curtir a praia, independente se consegue nadar ou não!\""

# game/a1s3.rpy:290
translate pt_br a1s3_5b73629f:

    # "The sand becomes too hot as I walk along the beach, so I have to jog the last ten meters or so to the wet sand, sighing as a wave cools my burning feet."
    "A areia começa a ficar bem quente à medida que ando, então corro um pouco os últimos dez metros mais ou menos até a areia molhada, suspirando quando uma onda esfria meus pés queimados."

# game/a1s3.rpy:291
translate pt_br a1s3_265a5506:

    # "Amicus catches up."
    "Amicus me alcança."

# game/a1s3.rpy:293
translate pt_br a1s3_31d87e96:

    # a "\"Too hot? I suppose I should remember that you are a bit more fragile than the other species.\""
    a "\"Muito quente? Suponho que deveria lembrar que você é um pouco mais frágil que as outras espécies.\""

# game/a1s3.rpy:294
translate pt_br a1s3_3413bb13:

    # m "\"Fragile?\""
    m "\"Frágil?\""

# game/a1s3.rpy:296
translate pt_br a1s3_27f619aa:

    # a "\"Well, a bit. I mean, when we fought on the ship I had to hold back a lot!\""
    a "\"É, um pouco. Digo, quando lutamos na nave eu tive que me segurar bastante!\""

# game/a1s3.rpy:297
translate pt_br a1s3_7e811b2d:

    # "I give Amicus a shove, the wolf stumbling more than he probably would have if he wasn't covering up his junk."
    "Dou um empurrão no Amicus, o lobo tropeça mais do que provavelmente tropeçaria se não estivesse cobrindo as partes íntimas."

# game/a1s3.rpy:299
translate pt_br a1s3_94fe48da:

    # a "\"Whoa, hey!\""
    a "\"Ooopa, ei!\""

# game/a1s3.rpy:303
translate pt_br a1s3_39a60a18:

    # "With that, I wade out into the shallows, the water quickly coming up to my shoulders."
    "Com isso, eu avanço no lago, a água rapidamente subindo até meus ombros."

# game/a1s3.rpy:304
translate pt_br a1s3_06645bc4:

    # "I stick to the shore, treading water as I watch Amicus splash around, doing a sort of lunging swim that reminds me of the butterfly stroke...just a lot more clumsy."
    "Eu fico perto da margem, pisando no fundo enquanto assisto o Amicus nadando em volta, executando um movimento que me lembra um pouco do estilo borboleta... só que muito mais desajeitado."

# game/a1s3.rpy:305
translate pt_br a1s3_6f84a052:

    # "After a few minutes, he swims up next to me."
    "Depois de alguns minutos, ele nada até mim."

# game/a1s3.rpy:306
translate pt_br a1s3_e4c873ca:

    # a "\"You doing alright? I'm still unsure of you being out in the water...\""
    a "\"Está tudo bem com você? Ainda fico um pouco apreensivo em te ver assim no meio da água...\""

# game/a1s3.rpy:307
translate pt_br a1s3_657bf87d:

    # m "\"Hey, don't start. I know what I'm doing.\""
    m "\"Ei, não começa. Eu sei o que eu tô fazendo.\""

# game/a1s3.rpy:308
translate pt_br a1s3_cb2c47e7:

    # a "\"Alright, alright, but even experienced swimmers can have accidents, so let me know if you need help, or anything.\""
    a "\"Tudo bem, certo, mas até nadadores experientes podem sofrer acidentes. Então me avise se você precisar de ajuda, ou qualquer coisa.\""

# game/a1s3.rpy:309
translate pt_br a1s3_7de9d4e4:

    # "Amicus stands right in front of me, his fur plastered tightly against his chest."
    "Amicus para bem na minha frente, seu pelo grudado firmemente contra o peito."

# game/a1s3.rpy:310
translate pt_br a1s3_011d6512:

    # m "\"I will.\""
    m "\"Certo.\""

# game/a1s3.rpy:311
translate pt_br a1s3_12876712:

    # "The wolf shields his eyes from the sun with a paw as he looks around."
    "O lobo protege os olhos do sol com uma pata enquanto observa ao redor."

# game/a1s3.rpy:312
translate pt_br a1s3_4e5a75d4:

    # a "\"Anyway, do you want to have a race around the island? We can stay in the shallows. I actually used to do it with Cass all the time as a pup.\""
    a "\"Enfim, você quer apostar uma corrida circulando a ilha? Nós podemos ficar no raso. Na verdade, eu costumava fazer isso com o Cass o tempo todo quando nós éramos filhotes.\""

# game/a1s3.rpy:313
translate pt_br a1s3_60221a12:

    # "I look around the small island, deciding that the distance is short enough that I can manage it."
    "Eu olho em volta da pequena ilha, decidindo que a distância é curta o suficiente para eu conseguir dar a volta."

# game/a1s3.rpy:314
translate pt_br a1s3_169c263b:

    # m "\"Alright, sure.\""
    m "\"Tudo bem, vamo lá.\""

# game/a1s3.rpy:315
translate pt_br a1s3_db0f1faa:

    # a "\"Alright [mc], but be warned; I won't go easy on you just because you're a primate!\""
    a "\"Certo, [mc], mas esteja avisado; eu não vou facilitar para você só porque é um primata!\""

# game/a1s3.rpy:316
translate pt_br a1s3_6b4eb34d:

    # "I swim past Amicus."
    "Eu nado ultrapassando o Amicus."

# game/a1s3.rpy:317
translate pt_br a1s3_cba3c4a0:

    # m "\"Go!\""
    m "\"Quem chegar por último é a mulher do padre!\""

# game/a1s3.rpy:318
translate pt_br a1s3_3f8b4444:

    # a "\"Wh-HEY!\""
    a "\"Mas o q-EI!\""

# game/a1s3.rpy:319
translate pt_br a1s3_e82e3b2d:

    # "I hear the wolf splash noisily behind me as he tries to catch up."
    "Eu ouço o lobo espalhando água ruidosamente atrás de mim enquanto tenta me alcançar."

# game/a1s3.rpy:320
translate pt_br a1s3_0dc9167d:

    # "I do fairly well for the first half of our little race, managing to get around the backside of the island without the wolf catching up to me."
    "Me saio muito bem na primeira metade de nossa corrida, conseguindo contornar a parte de trás da ilha sem que o lobo me alcance."

# game/a1s3.rpy:321
translate pt_br a1s3_d6e21d2c:

    # "I notice that this part of the island is covered in dense trees and vegetation with no beach to speak of."
    "Eu noto que essa parte é coberta com densas árvores e vegetação, com nenhuma margem para contar história."

# game/a1s3.rpy:322
translate pt_br a1s3_ef1c7642:

    # "It's at this point that Amicus overtakes me with his big, lunging strokes, breathing hard each time he comes up."
    "É nesse ponto que o Amicus me ultrapassa com seus grandes movimentos, respirando fundo cada vez que volta à superfície."

# game/a1s3.rpy:323
translate pt_br a1s3_78007708:

    # "I realize how hard he's trying, and I wonder if he's actually afraid of losing."
    "Percebo o quanto ele está se esforçando e me pergunto se ele realmente tem medo de perder."

# game/a1s3.rpy:324
translate pt_br a1s3_2ba64737:

    # "It's clear that there's a competitive edge to him, and I guess that makes sense if he's so determined to beat Cassius to the throne."
    "Já ficou bem claro que ele tem um espírito competitivo e acho que isso faz sentido já que ele é tão determinado a vencer o Cassius pelo trono."

# game/a1s3.rpy:325
translate pt_br a1s3_3aedb646:

    # "As we come around the final bend, I fall further behind, quickly losing stamina as the muscles burn in my arms and legs."
    "Quando chegamos na última curva, começo a ficar para trás, rapidamente perdendo o vigor enquanto os músculos queimam nos meus braços e pernas."

# game/a1s3.rpy:326
translate pt_br a1s3_b78c5291:

    # "Amicus seems to notice and slows down a bit toward the end, allowing me to catch up some before he reaches the same spot we'd started at."
    "Amicus parece notar e diminui um pouco a velocidade perto do final, me permitindo alcançar um pouco antes dele o mesmo lugar de onde começamos"

# game/a1s3.rpy:327
translate pt_br a1s3_33790077:

    # "For a moment, we both just gasp for breath in the shallows, though Amicus grins."
    "Por um momento, ficamos recuperando o nosso fôlego na parte rasa, apesar disso, Amicus sorri."

# game/a1s3.rpy:330
translate pt_br a1s3_6ad455b5:

    # a "\"Huh...huh...huh...hehe, I win...huh...\""
    a "\"Huh... huh... huh... hehe, eu ganhei... huh...\""

# game/a1s3.rpy:331
translate pt_br a1s3_b2f9ae50:

    # "I roll my eyes and wait until I can breathe evenly again."
    "Eu reviro os olhos e espero até conseguir respirar normalmente de novo."

# game/a1s3.rpy:332
translate pt_br a1s3_2ad9a5f9:

    # m "\"Whatever. You've got way more muscle than I do.\""
    m "\"Tanto faz. Você tem muito mais músculos que eu.\""

# game/a1s3.rpy:333
translate pt_br a1s3_7ed787de:

    # a "\"That...isn't really...an advantage.\""
    a "\"Isso... não é uma vantagem... de verdade.\""

# game/a1s3.rpy:334
translate pt_br a1s3_831616a5:

    # "Amicus still breathes heavily and I wonder how much effort he actually put into beating me."
    "Amicus continua respirando com dificuldade e eu me pergunto quanto esforço ele realmente investiu para conseguir me ultrapassar."

# game/a1s3.rpy:335
translate pt_br a1s3_9b1dd788:

    # a "\"Besides...I've got all this fur weighing me down and you don't. You know, competitive swimmers actually shave their fur down near the skin.\""
    a "\"Além disso... eu tenho todo esse pelo me puxando para baixo e você não. Na verdade, nadadores profissionais se depilam deixando o pelo perto da altura da pele.\""

# game/a1s3.rpy:336
translate pt_br a1s3_68df8fc9:

    # "That makes me wonder what a shaved wolf would look like."
    "Isso faz eu me perguntar como que um lobo depilado se pareceria."

# game/a1s3.rpy:337
translate pt_br a1s3_81bbb482:

    # m "\"Guess I just have bad stamina.\""
    m "\"Acho que eu só tenho um vigor ruim.\""

# game/a1s3.rpy:338
translate pt_br a1s3_e50e7a2d:

    # a "\"Actually, you did a lot better than I thought you would. Had me worried the first few minutes. What do you call that swimming style?\""
    a "\"Na verdade, você se saiu muito melhor do que pensei. Me deixou preocupado nos primeiros minutos. Como você chama esse estilo de nado?\""

# game/a1s3.rpy:339
translate pt_br a1s3_14cf6ea1:

    # m "\"Uh, I don't know. I think it's just called freestyle.\""
    m "\"Hã, não sei se tem um nome específico.\""

# game/a1s3.rpy:340
translate pt_br a1s3_ff1da866:

    # "Amicus moves closer, his breathing finally under control."
    "Amicus se aproxima, sua respiração agora finalmente sob controle."

# game/a1s3.rpy:341
translate pt_br a1s3_463b6455:

    # a "\"Could you teach me?\""
    a "\"Você pode me ensinar?\""

# game/a1s3.rpy:342
translate pt_br a1s3_5cde273b:

    # m "\"To swim? Looks like you've already got that down.\""
    m "\"A nadar? Parece que você já é muito bom nisso.\""

# game/a1s3.rpy:343
translate pt_br a1s3_c9abdee7:

    # a "\"I mean {i}your{/i} style of swimming.\""
    a "\"Eu quero dizer {i}no seu{/i} estilo de nado.\""

# game/a1s3.rpy:344
translate pt_br a1s3_e368cdab:

    # m "\"You beat me, didn't you? Why would you want to learn my style?\""
    m "\"Mas você não me venceu? Por que iria querer aprender meu estilo?\""

# game/a1s3.rpy:345
translate pt_br a1s3_9e19461c:

    # "I say that, but I think I know what Amicus is getting at."
    "Eu digo isso, mas acho que sei onde o Amicus quer chegar."

# game/a1s3.rpy:346
translate pt_br a1s3_b1c3571e:

    # "He has a very...clumsy way of swimming, sort of like he's fighting the water itself."
    "Ele nada de um jeito bem... desajeitado, como se estivesse lutando com a própria água."

# game/a1s3.rpy:347
translate pt_br a1s3_39485732:

    # "Amicus harrumphs, blowing some droplets of water from his nose."
    "Amicus escarra, assoprando algumas gotas de água vindo de seu nariz."

# game/a1s3.rpy:348
translate pt_br a1s3_91f4c676:

    # a "\"It looked effective. I'd just like to try it if you're willing to show me.\""
    a "\"Pareceu eficiente. Eu queria tentar nadar desse jeito se você quiser me mostrar.\""

# game/a1s3.rpy:349
translate pt_br a1s3_ad10a89a:

    # "I smile."
    "Eu sorrio."

# game/a1s3.rpy:350
translate pt_br a1s3_6f19d038:

    # m "\"Alright.\""
    m "\"Tudo bem.\""

# game/a1s3.rpy:351
translate pt_br a1s3_888b9fb3:

    # "For the next hour, I show the wolf how to swim freestyle."
    "Pela próxima hora, mostro ao lobo como nadar usando meu método."

# game/a1s3.rpy:352
translate pt_br a1s3_dc67f503:

    # "At the beginning, it kind of feels like I'm teaching a toddler how to swim."
    "No começo, sinto como se estivesse ensinando um bebê a nadar."

# game/a1s3.rpy:353
translate pt_br a1s3_e6f2b7c6:

    # "The first few tries end up with him thrashing around in the water like he's about to drown, showering me with lake water until I have to reach out and grab him to make him stop."
    "As primeiras tentativas acabam com ele se debatendo como se estivesse prestes a se afogar, água é jogada em todas as direções e eu levo um banho antes de alcançá-lo e fazê-lo parar."

# game/a1s3.rpy:354
translate pt_br a1s3_90eafe44:

    # "I decide to start with the arms first, standing in the shallows and showing him how I put one arm ahead of the other in a sort of rhythm."
    "Decido começar com os braços primeiro, ficando de pé no raso e demonstrando como coloco um braço na frente do outro, seguindo um certo ritmo."

# game/a1s3.rpy:355
translate pt_br a1s3_7a54c3ce:

    # "Again, I have to stand close to the naked wolf, grabbing his big furry arms and showing him how to move them."
    "Mais uma vez, preciso ficar próximo do lobo nu, pegando seus braços grandes e peludos e mostrando como movê-los."

# game/a1s3.rpy:356
translate pt_br a1s3_ab28dc7e:

    # "Once he has that down, he quickly learns how to add his feet into the mix and pretty soon, he's swimming back and forth, picking up speed to the point that I'd have no hope of keeping up with him."
    "Assim que ele se acostuma, logo aprende como adicionar os pés aos movimentos. Em seguida, começa a nadar de um lado para o outro, acelerando ao ponto que eu não tenho esperança alguma de conseguir acompanhá-lo."

# game/a1s3.rpy:357
translate pt_br a1s3_86ba6e16:

    # "I realize then that Amicus is a very fast learner."
    "Percebo então que o Amicus aprende muito rápido, eu criei um monstro."

# game/a1s3.rpy:358
translate pt_br a1s3_fac41598:

    # a "\"Haha! This is so much better! Do you know any other styles?\""
    a "\"Haha! Assim é tão melhor! Você conhece algum outro estilo?\""

# game/a1s3.rpy:359
translate pt_br a1s3_425e87a2:

    # "Amicus paddles happily around me."
    "Amicus rema alegremente ao meu redor."

# game/a1s3.rpy:360
translate pt_br a1s3_463c6667:

    # m "\"Well, I guess back floating, but no not really. I'm not a professional swimmer.\""
    m "\"Acho que nadar de costas, mas não. Eu não sou um nadador profissional.\""

# game/a1s3.rpy:362
translate pt_br a1s3_529b3d6d:

    # "Amicus stands, water running down his furry body."
    "Amicus fica de pé no raso, a água descendo pelo seu corpo peludo."

# game/a1s3.rpy:363
translate pt_br a1s3_5449d783:

    # a "\"Want to race again?\""
    a "\"Quer apostar corrida de novo?\""

# game/a1s3.rpy:364
translate pt_br a1s3_834ea2cf:

    # "He grins at me."
    "Ele sorri para mim."

# game/a1s3.rpy:365
translate pt_br a1s3_e33f02ef_1:

    # "I laugh."
    "Eu começo a gargalhar."

# game/a1s3.rpy:366
translate pt_br a1s3_8294f1de:

    # m "\"No! I'm exhausted after teaching you all of that.\""
    m "\"Não! Eu tô exausto depois de te ensinar tudo isso.\""

# game/a1s3.rpy:367
translate pt_br a1s3_5ab108b9:

    # a "\"Oh don't be such a pup, or are you afraid of losing again?\""
    a "\"Ah, não seja um filhotinho, ou você está com medo de perder outra vez?\""

# game/a1s3.rpy:368
translate pt_br a1s3_cb065360:

    # "Amicus winks to lighten his words."
    "Amicus dá uma piscada, aliviando o tom da frase."

# game/a1s3.rpy:369
translate pt_br a1s3_e96f2514:

    # "I think about flicking him on the nose like he's a misbehaving dog, but I resist the urge."
    "Eu penso em dar um peteleco no focinho como se ele fosse um cachorro se comportando mal, mas resisto à tentação."

# game/a1s3.rpy:370
translate pt_br a1s3_f73f0e7d:

    # m "\"No. I'm tired and I'm hungry and if I stay out any longer, I'm probably gonna get a sunburn.\""
    m "\"Não. Eu tô cansado e com fome e se eu passar mais tempo aqui, provavelmente vou ficar com uma queimadura de sol.\""

# game/a1s3.rpy:371
translate pt_br a1s3_be7a0733:

    # "Reminding Amicus that there's food on the beach seems to change his mind and he follows me into the shallows."
    "Lembrar ao Amicus sobre a comida na praia parece fazê-lo mudar de ideia e ele me segue pelo raso."

# game/a1s3.rpy:373
translate pt_br a1s3_a9c9daa5:

    # a "\"Oh, that's right; you have no fur. Sometimes I get burned around my nose if I stay out too long. Are you alright?\""
    a "\"Ah, é verdade; você não tem pelos. De vez em quando eu fico com uma queimadura ao redor do meu focinho quando passo muito tempo fora. Você está bem?\""

# game/a1s3.rpy:374
translate pt_br a1s3_ef8cd07e:

    # "I feel Amicus rub a paw over my shoulders and I shiver."
    "Eu sinto Amicus esfregando uma pata nos meus ombros e com ela vem um calafrio."

# game/a1s3.rpy:375
translate pt_br a1s3_744cf8bf:

    # m "\"Well, we'll know by tonight, but I feel alright.\""
    m "\"A gente vai ficar sabendo de noite, mas eu me sinto bem.\""

# game/a1s3.rpy:378
translate pt_br a1s3_948c5012:

    # "As we trudge onto the beach, I see Alex curled up on a blanket, his fur bright and shiny under the sun."
    "Conforme caminhamos pela praia, vejo o Alex deitado em cima de um lençol, seu pelo brilhante e reluzente sob o sol."

# game/a1s3.rpy:379
translate pt_br a1s3_4a9c6b7f:

    # "Judging by the plates around him, he's already eaten."
    "Julgando pelos pratos ao seu redor, ele já comeu."

# game/a1s3.rpy:380
translate pt_br a1s3_292c202c:

    # "Amicus chuckles."
    "Amicus dá uma risadinha."

# game/a1s3.rpy:382
translate pt_br a1s3_1404bca0:

    # a "\"Such a feline. Anyway, you'd better keep your eyes off me. I want the fur to dry before I put my undergarments back on, so I'm going to stop covering up for you!\""
    a "\"Que felino. Enfim, é melhor você manter os olhos longe de mim. Eu quero que o pelo seque antes de colocar a tanga de volta, então vou parar de cobrir por sua causa.\""

# game/a1s3.rpy:384
translate pt_br a1s3_7c203d05:

    # "Automatically, my eyes start wandering toward the wolf before snapping back to look straight ahead."
    "Automaticamente, meus olhos começam a vagar em direção ao lobo antes de voltarem imediatamente à posição inicial."

# game/a1s3.rpy:385
translate pt_br a1s3_c7b82874:

    # "But then I start to think; I am going to be here for a while, as far as I know."
    "Mas aí eu começo a pensar; eu vou ficar aqui por um bom tempo, até onde eu sei."

# game/a1s3.rpy:386
translate pt_br a1s3_eed72600:

    # "Maybe I should get used to the whole nudity thing now?"
    "Talvez devesse começar a me acostumar com a nudez agora?"

# game/a1s3.rpy:391
translate pt_br a1s3_6f24b50d:

    # "I mean, it's not that big of a deal, and if this is a normal thing for the Wolves, why not get used to it?"
    "Quer dizer, não é lá grande coisa e, se é algo normal para os lobos, porque não levar numa boa?"

# game/a1s3.rpy:392
translate pt_br a1s3_22690ebb:

    # "So I look."
    "Então eu olho."

# game/a1s3.rpy:394
translate pt_br a1s3_6efd0dc8:

    # "Amicus grunts in surprise when he sees me not bothering to avoid looking his way."
    "Amicus grunhe de surpresa quando me nota não evitando olhar em sua direção."

# game/a1s3.rpy:396
translate pt_br a1s3_e86bc7c2:

    # a "\"Wh—human!\""
    a "\"Mas o q—humano!\""

# game/a1s3.rpy:398
translate pt_br a1s3_b4ccb19c:

    # "Amicus's paws snap to covering his crotch again."
    "As patas do Amicus voltam a cobrir sua virilha outra vez."

# game/a1s3.rpy:399
translate pt_br a1s3_393dd690:

    # "I smirk."
    "Eu sorrio pretensiosamente."

# game/a1s3.rpy:400
translate pt_br a1s3_91fbc810:

    # m "\"What? I might as well get used to it if this is normal around here, right? Though I gotta say, you're acting like it isn't.\""
    m "\"Que foi? Eu preciso me acostumar com isso se é uma coisa normal por aqui, não? Achei que você não se importasse...\""

# game/a1s3.rpy:401
translate pt_br a1s3_7b6ac009:

    # "Amicus pauses, then pulls his paws away from his crotch, his face flushed."
    "Amicus pausa, então tira as patas de frente da virilha, uma expressão de constrangimento em seu rosto."

# game/a1s3.rpy:403
translate pt_br a1s3_4ad52e57:

    # a "\"you just surprised me, is all! Anyway...\""
    a "\"É que você me pegou de surpresa, só isso! Enfim...\""

# game/a1s3.rpy:405
translate pt_br a1s3_89c0ed7c:

    # "Amicus walks stiffly up the beach, past the sleeping Alex while I try to keep up."
    "Amicus caminha rigidamente pela praia, passando pelo Alex, adormecido, enquanto eu tento acompanhar."

# game/a1s3.rpy:406
translate pt_br a1s3_4f6ee41f:

    # "It's kind of satisfying to see how embarrassed he is considering how much he'd been teasing me about it."
    "É um pouco satisfatório ver ele tão envergonhado desse jeito considerando o tanto que ele tem me provocado sobre isso."

# game/a1s3.rpy:407
translate pt_br a1s3_5057b5d8:

    # "And honestly, now that I've seen it, it really isn't a big deal at all."
    "E, sinceramente, agora que eu vi, realmente não é tão grande coisa assim."

# game/a1s3.rpy:408
translate pt_br a1s3_347dd719:

    # "The wolf's cock and balls are just like a human's."
    "O pênis e testículos do lobo são exatamente como os de um humano."

# game/a1s3.rpy:409
translate pt_br a1s3_7e7c02f0:

    # "Sure, maybe with a little more fur on the balls and a darker shade on the cock, but still similar."
    "Claro, talvez com um pouco mais de pelo nas bolas e uma cor mais escura no pênis, mas ainda é parecido."

# game/a1s3.rpy:411
translate pt_br a1s3_2085b979:

    # "We reach the Sightseer and I see that Alex has laid out the food in a neat little line of plates."
    "Chegamos até o aero-observador e eu noto que Alex deixou a comida em uma pequena linha de pratos."

# game/a1s3.rpy:412
translate pt_br a1s3_1acd74be:

    # "Though some of the pastries look a bit squashed, everything seems to have survived the emergency dumping that they suffered."
    "Mesmo que alguns dos doces pareçam um pouco encharcados, tudo parece ter sobrevivido ao despejo de emergência."

# game/a1s3.rpy:413
translate pt_br a1s3_e6cfd76a:

    # "Amicus grabs a few large plates of quiches and what look like fruit pastries."
    "Amicus pega alguns largos pratos de quiches e o que parecem ser uns docinhos de fruta."

# game/a1s3.rpy:414
translate pt_br a1s3_38938819:

    # "Meanwhile, I grab a folded blanket, the bottle of wine for Amicus, and a smaller bottle of the vegetable-tasting juice I'd had yesterday for myself."
    "Enquanto isso, eu pego um pano dobrado, a garrafa de vinho para o Amicus e uma garrafa menor para mim do suco com gosto de vegetais o qual bebi ontem."

# game/a1s3.rpy:417
translate pt_br a1s3_fd38f889:

    # "Nope."
    "Não."

# game/a1s3.rpy:418
translate pt_br a1s3_fd337297:

    # "Just because I'm on an alien moon doesn't mean I'm just gonna conform to their way life."
    "Só porque estou em uma lua alienígena não significa que vou me conformar com o estilo de vida deles."

# game/a1s3.rpy:419
translate pt_br a1s3_0eb077f5:

    # "I'm not planning to stay here for {i}that{/i} long...I hope."
    "Eu não planejo ficar aqui por {i}tanto{/i} tempo... assim espero."

# game/a1s3.rpy:420
translate pt_br a1s3_4020408f:

    # "Besides, Alex has been here a while and he seems to be getting along fine without conforming."
    "Além disso, Alex está aqui há um bom tempo e ele parece estar indo bem sem se conformar."

# game/a1s3.rpy:421
translate pt_br a1s3_ba4ec6be:

    # "So I go on keeping my eyes just slightly to the right, letting Amicus fade into a vague, gray blur."
    "Então, decido ficar com meus olhos só um pouco para a direita, deixando o Amicus se dissolver em um vago borrão cinza."

# game/a1s3.rpy:422
translate pt_br a1s3_2085b979_1:

    # "We reach the Sightseer and I see that Alex has laid out the food in a neat little line of plates."
    "Chegamos até o aero-observador e eu noto que Alex deixou a comida em uma pequena linha de pratos."

# game/a1s3.rpy:423
translate pt_br a1s3_1acd74be_1:

    # "Though some of the pastries look a bit squashed, everything seems to have survived the emergency dumping that they suffered."
    "Mesmo que alguns dos doces pareçam um pouco encharcados, tudo parece ter sobrevivido ao despejo de emergência."

# game/a1s3.rpy:424
translate pt_br a1s3_e6cfd76a_1:

    # "Amicus grabs a few large plates of quiches and what look like fruit pastries."
    "Amicus pega alguns largos pratos de quiches e o que parecem ser uns docinhos de fruta."

# game/a1s3.rpy:425
translate pt_br a1s3_38938819_1:

    # "Meanwhile, I grab a folded blanket, the bottle of wine for Amicus, and a smaller bottle of the vegetable-tasting juice I'd had yesterday for myself."
    "Enquanto isso, eu pego um pano dobrado, a garrafa de vinho para o Amicus e uma garrafa menor para mim do suco com gosto de vegetais o qual bebi ontem."

# game/a1s3.rpy:427
translate pt_br a1s3_51b049d2:

    # "We make our way over to the shade of the trees before I roll out the blanket and Amicus starts to tie his underwear back on."
    "Seguimos o caminho até a sombra das árvores antes que eu estenda o lençol no chão e o Amicus comece a amarrar a tanga de volta."

# game/a1s3.rpy:428
translate pt_br a1s3_49ec38e5:

    # "Finally, he sits down with a huff before reaching out for the wine."
    "Finalmente, ele se senta com um bufo antes de estender a pata para pegar o vinho."

# game/a1s3.rpy:430
translate pt_br a1s3_b509c3e3:

    # a "\"You sure you don't want any?\""
    a "\"Você tem certeza que não quer um pouco?\""

# game/a1s3.rpy:431
translate pt_br a1s3_37b859d0:

    # "He asks before guzzling some of it down."
    "Ele pergunta antes de dar um pequeno gole."

# game/a1s3.rpy:432
translate pt_br a1s3_6cc1e100:

    # m "\"Um, I mean, maybe at dinner, or something, but I'd rather not get buzzed right now.\""
    m "\"Hã, sabe, talvez no jantar, ou algo assim, prefiro não ficar bêbado agora.\""

# game/a1s3.rpy:434
translate pt_br a1s3_13075a3e:

    # a "\"Oh really? I'd have to drink quite a bit more than this bottle to become inebriated.\""
    a "\"Ah, sério? Eu teria que beber um pouco mais do que essa garrafa para ficar embriagado.\""

# game/a1s3.rpy:435
translate pt_br a1s3_f45e7b44:

    # "Guess that explains how he can drink so much of it for every meal."
    "Acho que isso explica como ele consegue beber tanto em cada refeição."

# game/a1s3.rpy:436
translate pt_br a1s3_e6c23ddc:

    # m "\"Well, you are a lot bigger. Anyway, this stuff is great.\""
    m "\"É, você é muito maior. De qualquer forma, esse negócio aqui é ótimo.\""

# game/a1s3.rpy:437
translate pt_br a1s3_642f553e:

    # "I easily pull out the cork on my own bottle before drinking down the ice-cold juice."
    "Eu facilmente puxo fora a rolha da minha própria garrafa antes de beber o suco gelado."

# game/a1s3.rpy:438
translate pt_br a1s3_c03a3102:

    # "Amicus pulls a face."
    "Amicus faz uma careta."

# game/a1s3.rpy:440
translate pt_br a1s3_a489777c:

    # a "\"Eugh, {i}virdi{/i}? that stuff tastes awful. Wine is so much better.\""
    a "\"Eca, {i}virdi{/i}? Essa coisa tem um gosto horrível. Vinho é muito melhor.\""

# game/a1s3.rpy:441
translate pt_br a1s3_6addc190:

    # "Amicus immediately goes for the fruit pastries, shoving two in his mouth at the same time."
    "Amicus imediatamente avança nos docinhos de fruta, jogando dois dentro da boca ao mesmo tempo."

# game/a1s3.rpy:442
translate pt_br a1s3_9cd38a1e:

    # m "\"Maybe you just prefer sweet things? And slow down, don't you take time to enjoy your food?\""
    m "\"Você deve ter um paladar mais tolerante a doces. E calma aí, cara, como você vai curtir o sabor comendo assim tão rápido?\""

# game/a1s3.rpy:443
translate pt_br a1s3_18412b7c:

    # "Amicus frowns at me with his mouth full."
    "Amicus franze a testa com a boca cheia."

# game/a1s3.rpy:445
translate pt_br a1s3_11b4e1f8:

    # a "\"I do enjoy it. That's why I eat it fast.\""
    a "\"Mas eu curto o sabor, sim. É por isso que como rápido.\""

# game/a1s3.rpy:446
translate pt_br a1s3_45fb950c:

    # "I smile and go after one of the quiches instead."
    "Eu sorrio e pego um dos quiches em vez dos docinhos."

# game/a1s3.rpy:448
translate pt_br a1s3_2b8c0674:

    # "We eat in silence for a few minutes, then I remember what Cato had said earlier."
    "Nós comemos em silêncio por alguns minutos, então, lembro do que o Cato falou mais cedo."

# game/a1s3.rpy:449
translate pt_br a1s3_37d428d6:

    # m "\"When do you need to be at that thing Cato was talking about?\""
    m "\"Quando você precisa ir naquele negócio que o Cato tava falando?\""

# game/a1s3.rpy:450
translate pt_br a1s3_e5bc970b:

    # a "\"Combat practice? We've got at least an hour yet.\""
    a "\"O treino de combate? Nós temos pelo menos uma hora sobrando ainda.\""

# game/a1s3.rpy:451
translate pt_br a1s3_04b6fed6:

    # m "\"And what does that involve?\""
    m "\"E o que isso envolve?\""

# game/a1s3.rpy:452
translate pt_br a1s3_827877b1:

    # a "\"Oh, just striking and grapples. I'm just glad Cass isn't here to join us. I hate sparring him.\""
    a "\"Ah, só golpear e agarrar. Ainda bem que o Cass não está aqui para participar, odeio pegar leve com ele.\""

# game/a1s3.rpy:453
translate pt_br a1s3_ca480a49:

    # m "\"Really? You told me last night he can't even compete with you.\""
    m "\"Sério? Você me disse ontem à noite que ele não pode nem competir com você.\""

# game/a1s3.rpy:455
translate pt_br a1s3_1c291250:

    # a "\"That's exactly why. He has a condition where his bones are less dense than what is normal, makes them easy to break. Because of this, I'm more of a training dummy for him than anything.\""
    a "\"É exatamente por isso. Ele tem uma condição que faz os ossos dele serem menos densos que o normal, faz com que eles quebrem facilmente. Por conta disso, eu sou mais um boneco de treino para ele do que outra coisa.\""

# game/a1s3.rpy:457
translate pt_br a1s3_bbdc94f9:

    # a "\"Basically he just uses it as an excuse to punch me in the stomach. There isn't much I can do to retaliate that won't seriously injure him, so I prefer training with Cato.\""
    a "\"Basicamente, ele usa isso como justificativa para me socar no estômago. Não tem muito o que eu possa fazer como retaliação que não machucaria ele seriamente, então eu prefiro treinar com o Cato.\""

# game/a1s3.rpy:458
translate pt_br a1s3_8447d83b:

    # m "\"Didn't you tell Cassius you'd punch him yesterday?\""
    m "\"Você não disse pro Cassius que daria um soco nele ontem?\""

# game/a1s3.rpy:459
translate pt_br a1s3_96910dda:

    # "Amicus laughs."
    "Amicus dá uma gargalhada."

# game/a1s3.rpy:461
translate pt_br a1s3_ba350933:

    # a "\"Hahahaha! I did, didn't I?\""
    a "\"Hahahaha! Eu disse, né?\""

# game/a1s3.rpy:463
translate pt_br a1s3_b085fb67:

    # a "\"Well, that's why he was so offended, but now he knows not to bother you.\""
    a "\"Foi por isso que ele ficou tão ofendido, mas agora ele sabe que não deve te incomodar.\""

# game/a1s3.rpy:464
translate pt_br a1s3_b128720c:

    # a "\"I've learned to be gentle with him since we were pups, but my limits can only be pushed so far, especially now that I have you.\""
    a "\"Eu aprendi a ser gentil com ele desde que nós éramos filhotes, mas preciso traçar alguns limites, especialmente agora que eu tenho você.\""

# game/a1s3.rpy:465
translate pt_br a1s3_a893c8d0:

    # m "\"You said you used to get along with him when you were pups?\""
    m "\"Você disse que costumava se dar bem com ele quando vocês eram filhotes?\""

# game/a1s3.rpy:466
translate pt_br a1s3_c5b6d131:

    # a "\"Yes, but I think that had more to do with him admiring me when we were younger. He used to look up to me, which was preferable to how he is now.\""
    a "\"Sim, mas eu acho que tinha mais a ver com ele me admirar quando éramos mais novos. Ele costumava me ver como um exemplo, e eu preferia como ele me tratava antes do que agora.\""

# game/a1s3.rpy:467
translate pt_br a1s3_8059cacc:

    # m "\"What happened?\""
    m "\"E o que aconteceu?\""

# game/a1s3.rpy:468
translate pt_br a1s3_f887bb98_1:

    # "Amicus shrugs."
    "Amicus dá de ombros."

# game/a1s3.rpy:470
translate pt_br a1s3_6d2ff918:

    # a "\"We grew older, then mother died and he was always very close to her. They shared a lot in common, including their disease.\""
    a "\"Nós crescemos, aí a mamãe morreu e eles sempre foram muito próximos. Eles tinham muito em comum, incluindo a doença.\""

# game/a1s3.rpy:471
translate pt_br a1s3_d611e9c0:

    # "Amicus pokes around at the pastries before picking one up that looks to be filled with a red fruit."
    "Amicus vasculha os doces antes de pegar um que parece estar preenchido com uma fruta vermelha."

# game/a1s3.rpy:472
translate pt_br a1s3_69781005:

    # a "\"Then I suppose we've always been different philosophically, which would be fine if he weren't trying to take the throne from me.\""
    a "\"E também, suponho que nós sempre pensamos de forma diferente filosoficamente falando, e tudo bem para mim se ele não estivesse competindo comigo pelo trono.\""

# game/a1s3.rpy:473
translate pt_br a1s3_70f07839:

    # m "\"So if you were next in line for the throne, how could Cassius just challenge you for it. Is that how it's supposed to work?\""
    m "\"Então, se você era o próximo a assumir o trono, como pode o Cassius simplesmente te desafiar por ele? É assim que as coisas deveriam funcionar?\""

# game/a1s3.rpy:474
translate pt_br a1s3_d767f551:

    # a "\"No, not really. Cato is the one who decided to do things this way...which he can because he's the acting emperor.\""
    a "\"Na verdade, não. O Cato que decidiu fazer as coisas assim... e ele pode já que é o imperador interino.\""

# game/a1s3.rpy:475
translate pt_br a1s3_ff04b41c:

    # a "\"Cassius has been building a following amongst the wolves for the past several years.\""
    a "\"Cassius andou construíndo uma legião de seguidores entre os lobos nos últimos anos.\""

# game/a1s3.rpy:476
translate pt_br a1s3_3122b23f:

    # "Amicus shakes his head."
    "Amicus balança a cabeça."

# game/a1s3.rpy:477
translate pt_br a1s3_52bfc425:

    # a "\"I thought he was simply trying to solidify his chances of becoming my advisor, but his speeches and writings were so different from my father's...\""
    a "\"Eu achei que ele só estava tentando solificar suas chances de se tornar o meu conselheiro, mas seus discursos e escrituras eram tão diferentes dos do meu pai...\""

# game/a1s3.rpy:478
translate pt_br a1s3_b2c1c739:

    # a "\"I did realize he was cultivating a certain persona for the emperorship eventually, but I never thought Cato would buy in to it just because of Cassius's popularity...but he did, and here we are.\""
    a "\"Eventualmente eu entendi que ele estava cultivando uma certa persona para se tornar imperador, mas eu nunca pensei que o Cato seria convencido a aceitar só por causa da popularidade do Cassius... mas ele foi, e aqui estamos.\""

# game/a1s3.rpy:479
translate pt_br a1s3_e4bbad67:

    # "Amicus shoos away a worryingly large fly that lands near the plate."
    "Amicus espanta uma mosca preocupantemente enorme que pousa perto do prato."

# game/a1s3.rpy:480
translate pt_br a1s3_6b2dbc93:

    # a "\"I thought I'd have more time, anyway. A lot more time, but father's passing was sudden, so I'm left with what I have now.\""
    a "\"Eu achei que teria mais tempo, de qualquer forma. Muito mais tempo, mas a morte do papai foi tão repentina, então eu fiquei com o que me resta agora.\""

# game/a1s3.rpy:481
translate pt_br a1s3_7a2864be:

    # m "\"What happened to him...if you don't mind me asking?\""
    m "\"O que foi que aconteceu com ele... se você não se importa que eu pergunte?\""

# game/a1s3.rpy:482
translate pt_br a1s3_a4b6ed91:

    # a "\"To father? His ship crashed while landing in Adastra City about five months ago. It's a rare thing to happen, but it does happen.\""
    a "\"Com o papai? A nave dele sofreu um acidente enquanto tentava pousar na cidade de Adastra mais ou menos cinco meses atrás. É uma coisa rara de se acontecer, mas acontece.\""

# game/a1s3.rpy:483
translate pt_br a1s3_3ed7b932:

    # m "\"I'm sorry.\""
    m "\"Eu sinto muito.\""

# game/a1s3.rpy:484
translate pt_br a1s3_794944a2:

    # a "\"Well, he's with the Parents now, so I'll see him again, but he should have had so much more time left, just like mother.\""
    a "\"Bem, ele está com os progenitores agora, então eu o verei outra vez, mas ele deveria ter tanto tempo a mais de vida... assim como a mamãe.\""

# game/a1s3.rpy:485
translate pt_br a1s3_c45e4bac:

    # m "\"How old was he?\""
    m "\"Quantos anos ele tinha?\""

# game/a1s3.rpy:486
translate pt_br a1s3_ff4ab242:

    # a "\"157.\""
    a "\"157.\""

# game/a1s3.rpy:487
translate pt_br a1s3_2cc7b95a:

    # "I blink."
    "Eu pisco os olhos."

# game/a1s3.rpy:488
translate pt_br a1s3_8c7d2ff6:

    # m "\"He was 157?\""
    m "\"Ele tinha 157?\""

# game/a1s3.rpy:489
translate pt_br a1s3_bcc81977_1:

    # a "\"Yes.\""
    a "\"Sim.\""

# game/a1s3.rpy:490
translate pt_br a1s3_13d65215:

    # m "\"Years?\""
    m "\"Anos?\""

# game/a1s3.rpy:492
translate pt_br a1s3_8ca1d22f:

    # a "\"Yes?\""
    a "\"Sim?\""

# game/a1s3.rpy:493
translate pt_br a1s3_713ee5d0:

    # "Amicus looks at me, confused."
    "Amicus olha para mim, confuso."

# game/a1s3.rpy:494
translate pt_br a1s3_37709eea:

    # m "\"How long do you people live?\""
    m "\"Por quanto tempo vocês vivem?\""

# game/a1s3.rpy:495
translate pt_br a1s3_cebde5c2:

    # a "\"Uhhh, it varies, obviously, but about 250 to 300 years.\""
    a "\"Hã, varia, obviamente, mas é cerca de 250 a 300 anos.\""

# game/a1s3.rpy:496
translate pt_br a1s3_93bd3770:

    # m "\"Wow...\""
    m "\"Caramba...\""

# game/a1s3.rpy:497
translate pt_br a1s3_c3cbce5a:

    # a "\"How long do your people live?\""
    a "\"Por quanto tempo os humanos vivem?\""

# game/a1s3.rpy:498
translate pt_br a1s3_8a3c8bf1:

    # "Amicus looks slightly apprehensive."
    "Amicus parece levemente apreensivo."

# game/a1s3.rpy:499
translate pt_br a1s3_583b0a27:

    # m "\"I dunno, 80? 100 if we're lucky.\""
    m "\"Eu sei lá, 80? 100, se tivermos sorte.\""

# game/a1s3.rpy:500
translate pt_br a1s3_69f0220c:

    # a "\"Oh.\""
    a "\"Ah.\""

# game/a1s3.rpy:502
translate pt_br a1s3_1d4e2cfa:

    # "Amicus's ears fall."
    "As orelhas do Amicus caem."

# game/a1s3.rpy:503
translate pt_br a1s3_dfb409dc:

    # a "\"That's...so short.\""
    a "\"Isso é tão... curto.\""

# game/a1s3.rpy:504
translate pt_br a1s3_3b41d9a6:

    # m "\"Compared to you guys, yeah.\""
    m "\"Comparando com vocês, realmente.\""

# game/a1s3.rpy:506
translate pt_br a1s3_fa8db221:

    # a "\"Wait, how old are you?\""
    a "\"Espera, quantos anos você tem?\""

# game/a1s3.rpy:507
translate pt_br a1s3_a5fcb12d:

    # m "\"20, how old are you?\""
    m "\"20, quantos você tem?\""

# game/a1s3.rpy:509
translate pt_br a1s3_781e2d1b:

    # "Amicus is still frowning."
    "Amicus ainda está de testa franzida."

# game/a1s3.rpy:510
translate pt_br a1s3_f51e5165:

    # a "\"23.\""
    a "\"23.\""

# game/a1s3.rpy:511
translate pt_br a1s3_271194ea:

    # "That gives me some pause, trying to work out how much that would be in a human lifespan."
    "Isso me dá um tempo para pensar, tentando descobrir quanto isso seria no tempo de vida de um humano."

# game/a1s3.rpy:512
translate pt_br a1s3_6935afc7:

    # m "\"Wait, so are you an adult, or...\""
    m "\"Espera, então você é um adulto, ou...\""

# game/a1s3.rpy:513
translate pt_br a1s3_08724c0c:

    # "Amicus seems to recover."
    "Amicus parece se recuperar."

# game/a1s3.rpy:515
translate pt_br a1s3_05b82735:

    # a "\"Well, adulthood varies among species and cultures, obviously, but legal adulthood is 20. So yes, I'm considered an adult.\""
    a "\"Bem, a vida adulta varia entre as espécies e culturas, obviamente, mas um adulto legal tem 20 anos. Então, sim, eu sou considerado um adulto.\""

# game/a1s3.rpy:516
translate pt_br a1s3_fa910e7a:

    # m "\"Huh, that's about the same as humans.\""
    m "\"Ahã, isso é quase a mesma coisa que os humanos.\""

# game/a1s3.rpy:518
translate pt_br a1s3_e39a651c:

    # a "\"But the difference is that you die a lot sooner.\""
    a "\"Mas a diferença é que vocês morrem muito mais cedo.\""

# game/a1s3.rpy:519
translate pt_br a1s3_f8681f10:

    # "That concerned look again."
    "Aquele olhar preocupado de novo."

# game/a1s3.rpy:520
translate pt_br a1s3_8619f2c6:

    # "I shrug."
    "Eu dou de ombros."

# game/a1s3.rpy:521
translate pt_br a1s3_6880cecc:

    # m "\"Eh, I've grown up with the idea, so it's not all that shocking to me.\""
    m "\"É, eu cresci com essa ideia, então não é tão chocante pra mim.\""

# game/a1s3.rpy:523
translate pt_br a1s3_521b50ad:

    # "Amicus seems to be thinking."
    "Amicus parece estar pensando."

# game/a1s3.rpy:524
translate pt_br a1s3_32e5700c:

    # a "\"Well, maybe we can do something about it. I don't like the idea of you being through a fourth of your life when you've only just reached adulthood.\""
    a "\"Bem, talvez nós possamos fazer alguma coisa sobre isso. Eu não gosto da ideia de você passando por um quarto da sua vida quando acabou de chegar à vida adulta.\""

# game/a1s3.rpy:525
translate pt_br a1s3_e499761a_1:

    # "I frown."
    "Levanto uma sobrancelha."

# game/a1s3.rpy:526
translate pt_br a1s3_f12c46c6:

    # m "\"Well, what are you gonna do about it?\""
    m "\"E você vai fazer o que sobre isso?\""

# game/a1s3.rpy:528
translate pt_br a1s3_9d7c0677:

    # a "\"We aren't able to live so long naturally. We take supplements and medication that slows the aging process. Maybe we could consider some for you.\""
    a "\"Nós não somos capazes de viver tanto tempo assim de forma natural. Tomamos suplementos e medicações que atrasam o processo de envelhecimento. Talvez poderíamos considerar suplementar você com alguns.\""

# game/a1s3.rpy:529
translate pt_br a1s3_2e91dc0e:

    # "It's an interesting thought, but I don't like the idea of being a guinea pig for Wolvish medication."
    "É uma constatação interessante, mas eu não gosto da ideia de ser usado como rato de laboratório para medicações lobinas."

# game/a1s3.rpy:530
translate pt_br a1s3_6927172c:

    # m "\"Uh, maybe, but let's figure out this whole emperor thing first.\""
    m "\"É, talvez, mas vamos nos preocupar com toda essa coisa de ser imperador primeiro.\""

# game/a1s3.rpy:532
translate pt_br a1s3_69520bfa:

    # a "\"Alright...\""
    a "\"Tudo bem...\""

# game/a1s3.rpy:533
translate pt_br a1s3_3980aa4c:

    # "Amicus picks at his claws for a while, and it looks like he wants to say something, but he doesn't and just stays quiet."
    "Amicus fica dedilhando entre as garras por um momento e parece que ele quer dizer alguma coisa, mas desiste e só fica quieto."

# game/a1s3.rpy:534
translate pt_br a1s3_7ca7ff30:

    # "Finally, just as I'm about to ask him what's wrong, he looks over at the sleeping Alex."
    "Finalmente, assim que eu fico prestes a perguntar a ele o que tem de errado, ele olha para o Alex, ainda dormindo."

# game/a1s3.rpy:536
translate pt_br a1s3_4402f741:

    # a "\"I'll be right back.\""
    a "\"Eu volto já.\""

# game/a1s3.rpy:539
translate pt_br a1s3_b5aae08b:

    # "And with that, the wolf suddenly gets up and jogs over to the cat."
    "E, com isso, o lobo de repente se levanta e corre na direção do gato."

# game/a1s3.rpy:540
translate pt_br a1s3_94f386cb:

    # "I can't help but feel the conversation was left unfinished, but then I see Amicus get down on his paws and knees, as if sneaking up on Alex."
    "Não consigo parar de pensar que a conversa foi deixada inacabada, mas então eu vejo o Amicus agachar, como se estivesse sendo sorrateiro com o Alex."

# game/a1s3.rpy:541
translate pt_br a1s3_d226fb94:

    # "I frown and watch as the wolf gets closer, his paw reaching out...for Alex's earring."
    "Eu levanto uma sobrancelha e assisto enquanto o lobo chega mais perto, sua pata tentando alcançar... o brinco do Alex."

# game/a1s3.rpy:542
translate pt_br a1s3_f736583c:

    # "I guess the wolf wasn't being very quiet because Alex suddenly rolls over and squeals as the wolf leaps at him."
    "Acho que o lobo não estava sendo muito discreto, pois o Alex de repente se vira e grita quando o lobo pula nele."

# game/a1s3.rpy:545
translate pt_br a1s3_cb1c587f:

    # al "\"Amicus, no! No, no, this is my best one, don't mess it up!\""
    al "\"Amicus, não! Não, não, esse é o melhor que eu tenho, não faça isso!\""

# game/a1s3.rpy:546
translate pt_br a1s3_40ab31b3:

    # "I sigh and get up, a little reluctant to leave the shade as I make my way over to the pair."
    "Eu suspiro e fico de pé, um pouco relutante de deixar a sombra enquanto ando em direção aos dois."

# game/a1s3.rpy:547
translate pt_br a1s3_3e0b079b:

    # "Alex has rolled up into a little ball, clutching at his ear as he tries to hide the grapes."
    "Alex faz um movimento de rolar no chão, segurando sua orelha enquanto tenta esconder as uvas."

# game/a1s3.rpy:549
translate pt_br a1s3_0a3b5e4a:

    # al "\"Don't you dare! Do you want to tear my ear off!?\""
    al "\"Não se atreva! Você quer arrancar minha orelha fora!?\""

# game/a1s3.rpy:551
translate pt_br a1s3_30726470:

    # a "\"I'm being gentle! If you'd stop trying to fight it, it would make this easier!\""
    a "\"Eu estou sendo cuidadoso! Se você parasse de resistir, seria mais fácil!\""

# game/a1s3.rpy:553
translate pt_br a1s3_20507e3e:

    # al "\"Noooo!\""
    al "\"Nãããão!\""

# game/a1s3.rpy:554
translate pt_br a1s3_0bcac7f5:

    # "Alexios tries to roll away, then spots me.\""
    "Alexios tenta rolar para longe, então nota minha presença.\""

# game/a1s3.rpy:556
translate pt_br a1s3_d389d529:

    # al "\"[mc]! Help!\""
    al "\"[mc]! Me ajude!\""

# game/a1s3.rpy:557
translate pt_br a1s3_9c289f2d:

    # "I sigh and watch for a bit before deciding to save the poor cat."
    "Eu suspiro e assisto por um instante antes de decidir salvar o pobre gato."

# game/a1s3.rpy:558
translate pt_br a1s3_2ba1ebab:

    # "I look for an opening, then pounce on Amicus's back, wrapping my arms around his neck and my legs around his waist, trying to throw him off-balance."
    "Espero por uma oportunidade, depois pulo nas costas do Amicus, envolvendo meus braços ao redor de seu pescoço e minhas pernas em volta da cintura, tentando desequilibrá-lo."

# game/a1s3.rpy:560
translate pt_br a1s3_67a026f4:

    # a "\"Ohoho! Not so fragile now, are we?\""
    a "\"Ohoho! Não tão frágil agora, hein?\""

# game/a1s3.rpy:562
translate pt_br a1s3_694561a5:

    # "Amicus swings me back and forth, as if trying to throw me off, but not really putting any effort into it."
    "Amicus me balança para frente e para trás, como se estivesse tentando me lançar para fora, mas sem colocar nenhum esforço nisso."

# game/a1s3.rpy:564
translate pt_br a1s3_6601fca5:

    # "Meanwhile, Alex scrambles out from under the wolf before turning and giving him a shove."
    "Enquanto isso, Alex desliza por baixo do lobo antes de se virar e dar um empurrão."

# game/a1s3.rpy:566
translate pt_br a1s3_1eed65ba:

    # a "\"Agggh!\""
    a "\"Agggh!\""

# game/a1s3.rpy:567
translate pt_br a1s3_192e8cbe:

    # "Amicus starts to topple backwards and for a moment I think I'm about to get crushed between this 300 lbs wolf and the sand, but Amicus turns as we fall and we end up laying sideways on the beach."
    "Amicus começa a cair de costas e, por um momento, acho que vou ser esmagado entre a areia e o lobo de 150 quilos, mas ele se vira enquanto caímos e acabamos deitados de lado na praia."

# game/a1s3.rpy:571
translate pt_br a1s3_16f8af81:

    # "Alex stands to the side, quickly dusting himself off before adjusting his earring, frowning."
    "Alex fica de pé ao lado, rapidamente limpando a areia do corpo antes de ajustar o brinco, franzindo a testa."

# game/a1s3.rpy:573
translate pt_br a1s3_2bff5bbc:

    # al "\"You know, I might as well just stop wearing this thing. There's no point if half of it is plucked by the day's end.\""
    al "\"Sabe, talvez eu devesse simplesmente parar de colocar isso. Não há sentido se metade é arrancado fora antes do dia acabar.\""

# game/a1s3.rpy:574
translate pt_br a1s3_e958c843:

    # "Amicus just lays there and laughs."
    "Amicus simplesmente fica deitado e começa a rir."

# game/a1s3.rpy:575
translate pt_br a1s3_2318f0a1:

    # "His laugh is infectious, so I laugh too."
    "A risada dele é contagiosa, então eu começo a rir também."

# game/a1s3.rpy:576
translate pt_br a1s3_cd397620:

    # a "\"They're too good, Alex. Maybe you should start wearing inedible berries instead?\""
    a "\"Elas são muito boas, Alex. Talvez você devesse começar a usar brincos de frutinhas que não são comestíveis, em vez disso?\""

# game/a1s3.rpy:577
translate pt_br a1s3_c3f9c6e0:

    # "Alex huffs as he looks down his nose at us."
    "Alex bufa enquanto olha para baixo na nossa direção."

# game/a1s3.rpy:578
translate pt_br a1s3_85b40f95:

    # al "\"It's a cultural staple of my people, and honestly, what you're doing is rather disrespectful, especially as a prospective emperor.\""
    al "\"É um adereço cultural do meu povo. Francamente, o que você está fazendo é bastante desrespeitoso, especialmente sendo um imperador em potencial.\""

# game/a1s3.rpy:579
translate pt_br a1s3_b6153ea7:

    # "Amicus waves his paw dismissively, laying flat out on his back next to me, his arm flopping over my head."
    "Amicus balança a pata com desdém, deitado de costas ao meu lado, o braço caindo depois da minha cabeça."

# game/a1s3.rpy:580
translate pt_br a1s3_232bd577:

    # a "\"Phaw! You're a friend. Obviously I wouldn't do it to an actual ambassador.\""
    a "\"Pfff! Você é meu amigo. Obviamente eu não faria isso com um embaixador de verdade.\""

# game/a1s3.rpy:582
translate pt_br a1s3_19f1e891:

    # al "\"I {i}am{/i} an actual ambassador, Amicus!\""
    al "\"Eu {i}sou{/i} um embaixador de verdade, Amicus!\""

# game/a1s3.rpy:583
translate pt_br a1s3_bee67dc3:

    # a "\"Yes, but a friend ambassador.\""
    a "\"Sim, mas é um embaixador amigo.\""

# game/a1s3.rpy:584
translate pt_br a1s3_ab09fa2f:

    # "Alex sighs."
    "Alex suspira."

# game/a1s3.rpy:586
translate pt_br a1s3_334f0a03:

    # al "\"Anyway, thank you, [mc]. You should obey your master, yes, but it is also important to keep your master in check when he oversteps his bounds.\""
    al "\"Enfim, obrigado, [mc]. Você deve obedecer seu mestre, é claro, mas também é importante mantê-lo sob controle quando ele ultrapassar os limites.\""

# game/a1s3.rpy:587
translate pt_br a1s3_a2891b47:

    # a "\"Hey, don't encourage insubordination, Alex.\""
    a "\"Ei, não encoraje insubordinação, Alex.\""

# game/a1s3.rpy:588
translate pt_br a1s3_6c946f7a:

    # "Amicus's big paw resting above my head comes down to ruffle my hair."
    "A grande pata do Amicus repousando em cima da minha cabeça começa a descer para bagunçar meu cabelo."

# game/a1s3.rpy:589
translate pt_br a1s3_542a5c6a:

    # "I realize for the first time since I was abducted that I'm at ease, happy even."
    "Então percebo pela primeira vez desde que eu fui abduzido que estou bem à vontade, feliz, até."

# game/a1s3.rpy:590
translate pt_br a1s3_03e32071:

    # "Then Alex looks at the sky."
    "Alex olha para o céu."

# game/a1s3.rpy:592
translate pt_br a1s3_c4bcb4d9:

    # al "\"Amicus, what time is it?\""
    al "\"Amicus, que horas são?\""

# game/a1s3.rpy:594
translate pt_br a1s3_42229f32:

    # "Amicus suddenly sits up with a grunt, also looking toward the sun."
    "Amicus repentinamente senta com um grunhido, também olhando na direção do sol."

# game/a1s3.rpy:595
translate pt_br a1s3_c9a71176:

    # a "\"I don't know...is it close to the 11th hour?\""
    a "\"Eu não sei... está perto da 11ª hora?\""

# game/a1s3.rpy:596
translate pt_br a1s3_7a34c775:

    # al "\"I was asleep so I'm not sure. I'd ask Com, but we're outside his boundaries.\""
    al "\"Estava dormindo então não tenho certeza. Eu perguntaria ao Com, mas nós estamos fora dos limites dele.\""

# game/a1s3.rpy:597
translate pt_br a1s3_8c9ad3f6:

    # "Amicus sits for a moment, then sighs."
    "Amicus senta por um momento, então suspira."

# game/a1s3.rpy:599
translate pt_br a1s3_97051d2f:

    # a "\"Well, I suppose we should be off, just in case.\""
    a "\"Bem, suponho que nós deveríamos ir embora, só por precaução.\""

# game/a1s3.rpy:603
translate pt_br a1s3_6f8d779c:

    # "We gather up the food and blankets."
    "Nós pegamos a comida e o lençol."

# game/a1s3.rpy:604
translate pt_br a1s3_0a8b27af:

    # m "\"Don't you guys have portable clocks, or something?\""
    m "\"Vocês não têm relógios portáteis, ou algo do tipo?\""

# game/a1s3.rpy:605
translate pt_br a1s3_f887bb98_2:

    # "Amicus shrugs."
    "Amicus dá de ombros."

# game/a1s3.rpy:606
translate pt_br a1s3_0b5a30a4:

    # a "\"We do, but usually I can just ask Com.\""
    a "\"Nós temos, mas normalmente eu só preciso perguntar ao Com.\""

# game/a1s3.rpy:607
translate pt_br a1s3_8f67fc8c:

    # "The wolf taps his ear."
    "O lobo dá um tapa na orelha."

# game/a1s3.rpy:608
translate pt_br a1s3_140280da:

    # a "\"But like Alex said, his signal doesn't reach the island.\""
    a "\"Mas, como o Alex disse, o sinal dele não chega até a ilha.\""

# game/a1s3.rpy:609
translate pt_br a1s3_67ba495a:

    # "Amicus is starting to look a little nervous, so we pick up the pace and pack ourselves into the Sightseer, a bit more crowded now with Amicus inside."
    "Amicus começa a parecer um pouco nervoso, então nós apressamos o passo e organizamos as coisas no aero-observador, um pouco lotado agora com o Amicus dentro."

# game/a1s3.rpy:611
translate pt_br a1s3_16633567:

    # "When we're halfway to the shore, Amicus asks the time, then groans."
    "Quando estamos na metade do caminho para a margem, Amicus pergunta a hora e resmunga."

# game/a1s3.rpy:612
translate pt_br a1s3_8d94af45:

    # a "\"Dammit, half-past the eleventh hour.\""
    a "\"Cacilda, estamos meia hora atrasados.\""

# game/a1s3.rpy:616
translate pt_br a1s3_ba000255:

    # "The Amphitheater is small compared to the massive one I'd seen in Rome."
    "O anfiteatro é pequeno comparado com a versão enorme que eu vi em Roma."

# game/a1s3.rpy:617
translate pt_br a1s3_9a44ebaa:

    # "It might only be able to fit a hundred people at most."
    "Deve ser capaz de comportar cem pessoas, no máximo."

# game/a1s3.rpy:618
translate pt_br a1s3_2b814f66:

    # "Though Alex tells me that the really big one is in the city center."
    "Apesar disso, Alex me conta que o maior de todos fica no centro da cidade."

# game/a1s3.rpy:619
translate pt_br a1s3_b2a29154:

    # "He sits next to me on the bottom bench with the stairs between us as we watch Amicus stand alone in the center of the pit."
    "Ele se senta ao meu lado no banco do térreo com as escadas entre nós enquanto assistimos o Amicus no centro do palco, sozinho."

# game/a1s3.rpy:620
translate pt_br a1s3_a2223943:

    # "He has his paws on his hips, looking around, waiting."
    "Ele repousa as patas na cintura, olhando em volta, esperando."

# game/a1s3.rpy:622
translate pt_br a1s3_20017d26:

    # a "\"Well, I don't think he's here.\""
    a "\"É, eu não acho que ele esteja aqui.\""

# game/a1s3.rpy:624
translate pt_br a1s3_e1f602cc:

    # al "\"Clearly.\""
    al "\"Claramente.\""

# game/a1s3.rpy:626
translate pt_br a1s3_a4732af8:

    # a "\"Do you want to be my sparring partner for the day, Alex?\""
    a "\"Você quer ser meu parceiro de luta por hoje, Alex?\""

# game/a1s3.rpy:628
translate pt_br a1s3_301701b6:

    # al "\"No!\""
    al "\"Não!\""

# game/a1s3.rpy:630
translate pt_br a1s3_37b66c72:

    # "Alex scrunches up, one paw going up to cover his earring as Amicus just laughs."
    "Alex se levanta, uma pata subindo para cobrir seu brinco enquanto Amicus apenas ri."

# game/a1s3.rpy:631
translate pt_br a1s3_00856440:

    # "I look around, not seeing the old wolf anywhere."
    "Eu olho em volta, não enxergando o velho lobo em lugar algum."

# game/a1s3.rpy:632
translate pt_br a1s3_9c67287a:

    # m "\"Are you gonna get in trouble, Amicus?\""
    m "\"Você vai ter problemas por isso, Amicus?\""

# game/a1s3.rpy:636
translate pt_br a1s3_6c8eb9cb:

    # "Amicus shrugs, leaning one way, then the other in a sort of stretch."
    "Amicus dá de ombros, se inclinando para um lado, depois para o outro, em uma espécie de alongamento."

# game/a1s3.rpy:637
translate pt_br a1s3_5a7f630c:

    # a "\"Probably, but Cato is always upset. He'll probably just make me train an extra hour tomorrow, or something. Besides, I got most of my exercises in at the lake.\""
    a "\"Provavelmente, mas Cato está sempre de mau humor. Ele provavelmente só vai me treinar por uma hora extra amanhã, ou algo do tipo. Além disso, eu já me exercitei bastante lá no lago.\""

# game/a1s3.rpy:639
translate pt_br a1s3_00d60bca:

    # "Amicus suddenly does a handstand, his feet poking straight up in the air, and I'm amazed that he's able to keep perfectly balanced."
    "Amicus começa a plantar bananeira de repente, seus pés erguidos no ar bem estáveis e eu fico surpreso como ele consegue se manter perfeitamente equilibrado."

# game/a1s3.rpy:640
translate pt_br a1s3_783ba0c2:

    # "Alex quickly looks away as the hanging cloth on the wolf's undergarment falls upward, even if everything is still covered."
    "Alex rapidamente desvia o olhar assim que uma das amarras da tanga se solta, mesmo que tudo continue coberto."

# game/a1s3.rpy:641
translate pt_br a1s3_344863cf:

    # "Well...mostly; I can see the lighter colored fur that covers his front also covering his inner thighs."
    "Bem... a maior parte, pelo menos; eu consigo ver o pelo mais claro que cobre seu torso indo até internamente nas coxas."

# game/a1s3.rpy:642
translate pt_br a1s3_5645b3f3:

    # "Then Amicus falls backward, keeping his paws on the ground while his feet land with a thump, the wolf's back arched, making a bridge."
    "Então Amicus cai para trás, mantendo suas patas no chão enquanto seus pés pousam em um baque, as costas do lobo arqueadas, fazendo uma ponte."

# game/a1s3.rpy:643
translate pt_br a1s3_47a48d17:

    # "It's kind of impressive seeing such a thick, muscular body be so limber."
    "É meio impressionante ver um corpo tão denso e musculoso ser capaz de tanta flexibilidade."

# game/a1s3.rpy:644
translate pt_br a1s3_8a73abb7:

    # "That's when I notice Amicus looking directly at me from his upside-down position, watching me watching him."
    "É quando eu noto o Amicus olhando diretamente para mim em sua posição invertida, me observando observá-lo."

# game/a1s3.rpy:645
translate pt_br a1s3_06bd47a1:

    # "I quickly look away blushing, realizing the wolf is just showing off."
    "Rapidamente desvio o olhar, constrangido, percebendo o lobo apenas se exibindo."

# game/a1s3.rpy:646
translate pt_br a1s3_70cfafe9:

    # "Amicus pushes off his paws, smoothly standing up straight."
    "Amicus empurra suas patas de volta, suavemente ficando de pé."

# game/a1s3.rpy:648
translate pt_br a1s3_5e37eae0:

    # a "\"Heh, well...I suppose we could go back to the palace since I'd need a partner to do the rest of my training...unless—\""
    a "\"Hehe, bem... suponho que nós podemos voltar ao palácio já que eu precisaria de um parceiro para fazer o resto do meu treino... a não ser que—\""

# game/a1s3.rpy:649
translate pt_br a1s3_4ad4d594:

    # "Amicus glances at me."
    "Amicus fixa um olhar em mim."

# game/a1s3.rpy:651
translate pt_br a1s3_72431b79:

    # a "\"[mc], would you like to assist me?\""
    a "\"[mc], você gostaria de me ajudar?\""

# game/a1s3.rpy:652
translate pt_br a1s3_d7270d44:

    # "I freeze up for a moment, still feeling a bit awkward at being caught staring at his body."
    "Eu congelo por um momento, ainda me sentindo um pouco constrangido por ter sido pego no flagra encarando o corpo dele."

# game/a1s3.rpy:653
translate pt_br a1s3_707f5262:

    # "I know I can say no, but Alex is here, and I don't want to come off as a belligerent pet in front of him."
    "Eu sei que eu posso dizer não, mas o Alex está aqui e eu não quero passar uma imagem de mascote desobediente na frente dele."

# game/a1s3.rpy:654
translate pt_br a1s3_8641ede8:

    # "We're still sort of pretending, after all, even though Alex probably thinks something is off about me."
    "Nós ainda estamos meio que fingindo, de qualquer forma, mesmo que o Alex pense que tem alguma coisa estranha comigo."

# game/a1s3.rpy:656
translate pt_br a1s3_4ff00a93:

    # a "\"Don't worry, I'm not going to hurt you. It would probably be the other way around, haha!\""
    a "\"Não se preocupe, eu não vou machucar você. Provavelmente vai acontecer o contrário, haha!\""

# game/a1s3.rpy:657
translate pt_br a1s3_9ca67f92:

    # m "\"...Alright.\""
    m "\"(...) certo.\""

# game/a1s3.rpy:661
translate pt_br a1s3_707c86a8:

    # "I get up and stand awkwardly in front of the half-naked wolf, glad that I'm at least in my robes now."
    "Eu me levanto e fico de pé, um pouco constrangido em frente ao lobo seminu, grato por pelo menos estar vestindo o meu traje agora."

# game/a1s3.rpy:663
translate pt_br a1s3_1929b4aa:

    # a "\"Do your people have combat sports?\""
    a "\"Seu povo tem esportes de luta?\""

# game/a1s3.rpy:664
translate pt_br a1s3_506cd822:

    # m "\"Uh, yeah. Actually there were a few where your people uplifted. Wrestling and something else where they'd basically just beat each other up...I can't remember the name of it though.\""
    m "\"Ah, sim. Na verdade, tinham alguns no lugar que o seu povo elevou. Luta livre e outra coisa em que eles basicamente batiam uns nos outros... mas não consigo me lembrar do nome.\""

# game/a1s3.rpy:665
translate pt_br a1s3_37c0aac5:

    # "Amicus smiles."
    "Amicus sorri."

# game/a1s3.rpy:666
translate pt_br a1s3_6e2ec7c4:

    # a "\"That sounds similar enough! This is called {i}pugnu{/i} and it mostly involves punching, kicking, and grappling. The only rules are no claws, no teeth, and no going for the eyes...or groin.\""
    a "\"É parecido o suficiente! Esse aqui se chama {i}pugnu{/i} e, basicamente, envolve socar, chutar e agarrar. As únicas regras são: sem garras, sem dentes e sem mirar nos olhos... ou virilha.\""

# game/a1s3.rpy:668
translate pt_br a1s3_bc662d1f:

    # "Amicus smirks at me."
    "Amicus dá um sorriso pretensioso."

# game/a1s3.rpy:669
translate pt_br a1s3_79a3d375:

    # a "\"And while sparring, we avoid striking above the neck. So! Go ahead and throw some punches at me!\""
    a "\"E, enquanto lutamos, evitamos golpear acima do pescoço. Vamos! Vá em frente e tente acertar alguns socos em mim!\""

# game/a1s3.rpy:670
translate pt_br a1s3_605cf1c8:

    # "Amicus grins and hunches down, his paws out."
    "Amicus sorri e se agacha com as patas em posição."

# game/a1s3.rpy:672
translate pt_br a1s3_b13cd98c:

    # "I look over at Alex who watches us, a bit of a disapproving look on his face."
    "Eu olho na direção do Alex, que nos assiste com um olhar de desaprovação no rosto."

# game/a1s3.rpy:673
translate pt_br a1s3_39bd1e59:

    # "Amicus notices."
    "Amicus nota."

# game/a1s3.rpy:675
translate pt_br a1s3_bb8278d8:

    # a "\"Don't mind Alex; his people are too soft for this sport.\""
    a "\"Não se preocupe com o Alex; o povo dele é muito compassivo para esse tipo de esporte.\""

# game/a1s3.rpy:676
translate pt_br a1s3_561fed0d:

    # al "\"Um, excuse me, but we invented the grapples you use. We just grew out of it.\""
    al "\"Com licença, mas nós que inventamos esses movimentos de agarrar que vocês usam. Apenas paramos de lutar.\""

# game/a1s3.rpy:678
translate pt_br a1s3_e4770f4f:

    # "Amicus seems to ignore the cat, circling me."
    "Amicus parece ignorar o gato, circulando e me encarando."

# game/a1s3.rpy:679
translate pt_br a1s3_7e153544:

    # a "\"Come on, don't hold back! Mostly I just want to train my reflexes.\""
    a "\"Vamos lá, não pegue leve! Eu só quero treinar os meus reflexos.\""

# game/a1s3.rpy:680
translate pt_br a1s3_9fd6d041:

    # "I try to shake off my timidness and move forward, throwing an awkward punch at Amicus's chest."
    "Eu tento deixar de lado minha timidez e avanço dando um soco desajeitado na direção do peito do Amicus."

# game/a1s3.rpy:681
translate pt_br a1s3_95b5adfc:

    # "The wolf easily slaps it away."
    "O lobo facilmente esquiva com um tapa."

# game/a1s3.rpy:683
translate pt_br a1s3_0e234e2f:

    # a "\"I...hope you can do better than that, [mc].\""
    a "\"Hã... espero que você possa fazer melhor do que isso, [mc].\""

# game/a1s3.rpy:684
translate pt_br a1s3_cef5e652:

    # "I blush and put a little more effort into a quick punch at the wolf's side, which he dodges with a jump to the right."
    "Eu fico corado e aplico um pouco mais de esforço em um soco rápido mirando na lateral do lobo, o qual ele se esquiva com um pulo para a direita."

# game/a1s3.rpy:685
translate pt_br a1s3_ef7dc1b9:

    # "I follow him and jab at his stomach, which he blocks with an elbow."
    "Eu o sigo e golpeio em seu estômago, ele bloqueia com um cotovelo."

# game/a1s3.rpy:687
translate pt_br a1s3_7ba0a179:

    # a "\"Oh come on, you can hit harder than that!\""
    a "\"Ah, qual é, você pode golpear com mais força que isso!\""

# game/a1s3.rpy:688
translate pt_br a1s3_19cdc270:

    # "We go on for a while longer until I finally stop, huffing."
    "Nós continuamos por mais um tempo até que eu finalmente paro, arfando."

# game/a1s3.rpy:689
translate pt_br a1s3_f62740c8:

    # "Amicus comes up from his crouch."
    "Amicus se levanta do agachamento."

# game/a1s3.rpy:691
translate pt_br a1s3_cc3e36be:

    # a "\"What's wrong? Tired already?\""
    a "\"O que tem de errado? Já se cansou?\""

# game/a1s3.rpy:692
translate pt_br a1s3_6a20a80d:

    # "I shake my head."
    "Eu balanço minha cabeça."

# game/a1s3.rpy:693
translate pt_br a1s3_4ed948eb:

    # m "\"Honestly, I just don't like throwing punches at you...feels kinda wrong.\""
    m "\"Sinceramente, eu não gosto de dar socos em você... parece um pouco errado.\""

# game/a1s3.rpy:695
translate pt_br a1s3_0c3a7364:

    # "Alex perks up."
    "Alex se anima."

# game/a1s3.rpy:696
translate pt_br a1s3_6bfcf0de:

    # al "\"See? [mc] understands.\""
    al "\"Está vendo? [mc] entende.\""

# game/a1s3.rpy:697
translate pt_br a1s3_2036a934:

    # "Amicus rolls his eyes."
    "Amicus revira os olhos."

# game/a1s3.rpy:699
translate pt_br a1s3_1fb30e98:

    # a "\"Pff, you're both soft! There's nothing wrong with a bit of sanctioned combat. In fact, I'd say it creates a more civilized—Unf!\""
    a "\"Pff, vocês são muito molengas! Não tem nada de errado com um pouco de combate recíproco. Na verdade, eu diria que cria um ambiente mais—Unf!\""

# game/a1s3.rpy:701
translate pt_br a1s3_1bf8bcbd:

    # "I take the opportunity to jab Amicus in the side, making the wolf grunt."
    "Eu aproveito a oportunidade para golpear o Amicus na lateral, fazendo o lobo grunhir."

# game/a1s3.rpy:702
translate pt_br a1s3_c13ea992:

    # "Amicus turns on me with widened eyes."
    "Amicus se vira para mim com os olhos arregalados."

# game/a1s3.rpy:703
translate pt_br a1s3_a2ffe1b2:

    # m "\"Uh, oops?\""
    m "\"Hã, ops?\""

# game/a1s3.rpy:707
translate pt_br a1s3_df29126b:

    # "Amicus frowns while Alex laughs."
    "Amicus franze a testa enquanto o Alex dá risada."

# game/a1s3.rpy:709
translate pt_br a1s3_a9f004c9:

    # a "\"I'll show you an \"oops\".\""
    a "\"Eu vou te mostrar o \"ops\".\""

# game/a1s3.rpy:710
translate pt_br a1s3_a2bae82e:

    # "Amicus smirks as he ducks in, grabbing my arms and easily pinning them behind my back."
    "Amicus sorri pretensiosamente enquanto avança na minha direção, pegando meus braços e facilmente os prendendo atrás de mim."

# game/a1s3.rpy:711
translate pt_br a1s3_ef84a8b4:

    # m "\"Hey!\""
    m "\"Ei!\""

# game/a1s3.rpy:712
translate pt_br a1s3_6411710c:

    # "Amicus growls playfully into my ear."
    "Amicus rosna de brincadeira no meu ouvido."

# game/a1s3.rpy:713
translate pt_br a1s3_3a1062af:

    # a "\"Ha! Now it's your turn to train. Try and and get out of this!\""
    a "\"Ha! Agora é sua vez de treinar. Tente se libertar disso!\""

# game/a1s3.rpy:714
translate pt_br a1s3_81c25d14:

    # "He leans heavily against me, using his weight to his advantage."
    "Ele se encosta em mim, usando o próprio peso a seu favor."

# game/a1s3.rpy:715
translate pt_br a1s3_ce1d26c5:

    # "It's clear I have no chance of getting out of the hold, but I try anyway, struggling and complaining."
    "Claramente não tenho nenhuma chance de me soltar, mas tento mesmo assim, me esforçando e reclamando."

# game/a1s3.rpy:720
translate pt_br a1s3_6fae2329:

    # unk "\"AMICUS!\""
    unk "\"AMICUS!\""

# game/a1s3.rpy:721
translate pt_br a1s3_a133cfaf:

    # "I jump and so does Amicus, the wolf immediately letting me go."
    "Eu me assusto e o Amicus também, imediatamente me soltando."

# game/a1s3.rpy:722
translate pt_br a1s3_9504849a:

    # "The sudden lack of support almost causes me to face-plant before Amicus catches me and sets me back on my feet."
    "A repentina falta de equilíbrio quase me faz cair de cara no chão, mas Amicus me segura, me ajudando a voltar a ficar de pé."

# game/a1s3.rpy:723
translate pt_br a1s3_9a392d1e:

    # "I turn around and see Cato."
    "Eu me viro e vejo o Cato."

# game/a1s3.rpy:725
translate pt_br a1s3_ac8979c8:

    # "Despite the volume and fury in his voice just moments earlier, he appears almost calm."
    "Apesar do volume e da fúria em sua voz alguns momentos antes, ele parece quase calmo."

# game/a1s3.rpy:727
translate pt_br a1s3_a1532780:

    # "Amicus and I stand there for a moment, breathing heavily, then Amicus bows."
    "Amicus e eu ficamos lá parados por um momento, respirando com dificuldade, então o Amicus se curva."

# game/a1s3.rpy:729
translate pt_br a1s3_44922b6d:

    # a "\"Good morning, Cato.\""
    a "\"Bom dia, Cato.\""

# game/a1s3.rpy:730
translate pt_br a1s3_1258f09c:

    # "I quickly follow suit, bowing low."
    "Rapidamente eu repito a ação dele, me curvando baixo."

# game/a1s3.rpy:731
translate pt_br a1s3_8f38e98a:

    # "There's a moment of silence as Cato regards us both."
    "Há um momento de silêncio enquanto Cato nos observa."

# game/a1s3.rpy:732
translate pt_br a1s3_0ce1b6f8:

    # ca "\"Afternoon, you mean. You're late.\""
    ca "\"Você quis dizer boa tarde. Está atrasado.\""

# game/a1s3.rpy:733
translate pt_br a1s3_69b852c5:

    # a "\"My apologies. I lost track of the time at the lake.\""
    a "\"Eu peço desculpas. Perdi a noção do tempo lá no lago.\""

# game/a1s3.rpy:735
translate pt_br a1s3_e49171ce:

    # ca "\"Your pet did not remind you? Is that not one of his duties?\""
    ca "\"Seu mascote não lhe avisou? Esse não é um de seus deveres?\""

# game/a1s3.rpy:736
translate pt_br a1s3_f71f2867:

    # "Cato's gaze snaps in my direction, and I almost jump."
    "O olhar do Cato redireciona até mim e eu quase pulo."

# game/a1s3.rpy:737
translate pt_br a1s3_8d72bb25:

    # "I don't know what to do, so I go back to bowing, wondering if I should apologize."
    "Eu não sei o que fazer, então me curvo outra vez, me perguntando se deveria pedir desculpas."

# game/a1s3.rpy:739
translate pt_br a1s3_6fa3ed67:

    # a "\"I...have not taught him our hours yet, Cato. It's my fault.\""
    a "\"Eu... não o ensinei as horas ainda, Cato. A culpa é minha.\""

# game/a1s3.rpy:740
translate pt_br a1s3_dbd970c4:

    # "Cato watches us for a moment longer, then begins unfastening his robe."
    "Cato nos observa por mais uns instantes, então começa a desapertar a túnica."

# game/a1s3.rpy:741
translate pt_br a1s3_6e16595e:

    # ca "\"Luckily, my appointment with the Praetor has been canceled, so despite your tardiness, we may train."
    ca "\"Hoje é o seu dia de sorte, meu compromisso com o pretor foi cancelado, então, apesar de seu atraso, devemos treinar."

# game/a1s3.rpy:743
translate pt_br a1s3_60976eed:

    # "Cato tosses his robe aside."
    "Cato joga sua túnica para o lado."

# game/a1s3.rpy:745
translate pt_br a1s3_3918878d:

    # ca "\"Move, pet.\""
    ca "\"Saia do caminho, mascote.\""

# game/a1s3.rpy:746
translate pt_br a1s3_c6fa9434:

    # "I stand there like an idiot for a moment before realizing he's talking to me."
    "Eu fico parado lá igual um idiota por um momento antes de perceber que ele estava falando comigo."

# game/a1s3.rpy:751
translate pt_br a1s3_2825f32d:

    # "I hurry over to sit down next to Alex and I can tell by the expression on his face that he's also a bit worried."
    "Eu apresso o passo para sentar perto do Alex, posso dizer pela expressão no rosto dele que ele também parece um pouco preocupado."

# game/a1s3.rpy:752
translate pt_br a1s3_f34174c6:

    # ca "\"I see you've already warmed up.\""
    ca "\"Vejo que você já fez o aquecimento.\""

# game/a1s3.rpy:753
translate pt_br a1s3_c25fe680:

    # "Cato glances over at me again before turning back to Amicus, getting into a crouch."
    "Cato lança um olhar em mim mais uma vez antes de se virar na direção do Amicus, se agachando."

# game/a1s3.rpy:754
translate pt_br a1s3_e80d154a:

    # "Amicus stands awkwardly for a moment before doing the same."
    "Amicus fica parado sem jeito por um momento antes de fazer o mesmo."

# game/a1s3.rpy:755
translate pt_br a1s3_e334baab:

    # a "\"Yes...did you need to—\""
    a "\"Sim... você precisa—\""

# game/a1s3.rpy:756
translate pt_br a1s3_cfccba8b:

    # ca "\"I did mine while waiting for you for over half an hour, Amicus.\""
    ca "\"Eu me aqueci enquanto esperava você por mais de meia hora, Amicus.\""

# game/a1s3.rpy:757
translate pt_br a1s3_8e5d5cd5:

    # a "\"Ah.\""
    a "\"Ah.\""

# game/a1s3.rpy:758
translate pt_br a1s3_8928b34c:

    # "The two big wolves start circling each other."
    "Os dois grandes lobos começam a circular um ao outro."

# game/a1s3.rpy:759
translate pt_br a1s3_843381a1:

    # "I want to ask Alex if this is normal, but something tells me I shouldn't speak out of turn in the presence of Cato."
    "Eu quero perguntar ao Alex se isso é normal, mas algo me diz que eu não deveria falar fora de hora na presença do Cato."

# game/a1s3.rpy:760
translate pt_br a1s3_c160b5bc:

    # ca "\"Your brother had a very successful speech in the city today; over five hundred thousand attended.\""
    ca "\"Seu irmão fez um discurso de muito sucesso na cidade hoje, mais de quinhentos mil compareceram.\""

# game/a1s3.rpy:761
translate pt_br a1s3_8ca1e2e3:

    # a "\"Hm?\""
    a "\"Hm?\""

# game/a1s3.rpy:762
translate pt_br a1s3_342cb407:

    # "Amicus seems thrown off by what Cato said, but then Cato's fist snaps out and smacks Amicus right on the nose."
    "Amicus parece surpreendido com o que Cato disse, mas então o punho do lobo mais velho se move rapidamente e golpeia a cara do Amicus bem no focinho."

# game/a1s3.rpy:767
translate pt_br a1s3_4cef82d5:

    # a "\"Agh!\""
    a "\"Agh!\""

# game/a1s3.rpy:768
translate pt_br a1s3_4c60859e:

    # "The wolf stumbles back, blinking and snorting as he holds his face."
    "O lobo tropeça para trás, piscando e bufando enquanto segura seu rosto."

# game/a1s3.rpy:769
translate pt_br a1s3_cd46b176:

    # "I wince."
    "Eu tremo de aflição."

# game/a1s3.rpy:770
translate pt_br a1s3_c27f2ff8:

    # "Didn't Amicus just tell me they didn't go for the face during training?"
    "Amicus não acabou de me dizer que eles não golpeiam o rosto durante o treino?"

# game/a1s3.rpy:772
translate pt_br a1s3_b156ebce:

    # "I look at Alex questioningly, but the cat is now looking firmly at the ground between his feet, his ears down."
    "Eu lanço um olhar de questionamento no Alex, mas o gato fica encarando firmemente o espaço do chão entre seus pés, suas orelhas abaixadas."

# game/a1s3.rpy:773
translate pt_br a1s3_6c479a8f:

    # ca "\"That's double his last speech, Amicus, and it rivals your father's early days as emperor.\""
    ca "\"Isso é o dobro do último discurso dele, Amicus, e rivaliza com os primeiros dias do seu pai como imperador.\""

# game/a1s3.rpy:774
translate pt_br a1s3_f2d14184:

    # "Amicus has recovered at this point and he's got his paws back up, his teeth bared."
    "Amicus já se recuperou a essa altura e ele volta à posição de ataque, seus dentes à mostra."

# game/a1s3.rpy:775
translate pt_br a1s3_a7e9ee65:

    # "He doesn't respond and starts circling Cato again, and this time he attacks first, throwing an elbow at Cato's face."
    "Ele não retribui e começa a circular o Cato de novo. Dessa vez, ele ataca primeiro, golpeando com o cotovelo em direção ao rosto do Cato."

# game/a1s3.rpy:776
translate pt_br a1s3_5b69272a:

    # "Cato ducks it and moves to the side, smacking a fist into Amicus's back, right over the kidney."
    "Cato se esquiva do golpe e se move para o lado, batendo um punho nas costas do Amicus, bem na área dos rins."

# game/a1s3.rpy:780
translate pt_br a1s3_13839791:

    # a "\"AAAAGH!\""
    a "\"AAAAGH!\""

# game/a1s3.rpy:781
translate pt_br a1s3_cc05f46f:

    # "Amicus lets out a pained grunt, bending sideways and stumbling before forcing himself back into position, his teeth showing now."
    "Amicus solta um grito de dor, dobrando-se para o lado e tropeçando antes de forçar a si mesmo de volta à posição, seus dentes ainda mais à mostra."

# game/a1s3.rpy:782
translate pt_br a1s3_1d6a1e54:

    # ca "\"And while you were being a pup at the lake, Cassius was touring the countryside, and even that drew thousands.\""
    ca "\"E enquanto você estava sendo um filhote no lago, Cassius estava em turnê pelo interior e até lá atraiu milhares.\""

# game/a1s3.rpy:783
translate pt_br a1s3_72a0c8d6:

    # "Cato throws a sudden kick at Amicus's thigh, and I look away, but I still hear the painful thwack of furry flesh on furry flesh."
    "Cato disfere um chute repentino na coxa do Amicus e eu desvio o olhar, mas ainda sou capaz de ouvir a dolorosa paulada de carne peluda em carne peluda."

# game/a1s3.rpy:784
translate pt_br a1s3_c113be52:

    # "This isn't training, this is punishment."
    "Isso não é um treinamento, é punição."

# game/a1s3.rpy:785
translate pt_br a1s3_bc5e88d9:

    # ca "\"Stealing a ship and flying across the galaxy will only get you so far, Amicus. You win the people over, not me—UNGH!\""
    ca "\"Roubar uma nave e voar pela galáxia só vai te trazer até aqui, Amicus. Você pode convencer as pessoas, mas não eu—UNGH!\""

# game/a1s3.rpy:786
translate pt_br a1s3_d8a4886e:

    # "Amicus bull rushes the old wolf, grabbing one of Cato's legs by the thigh, lifting it off the ground while he starts throwing vicious punches into the older wolf's face."
    "Amicus avança no velho lobo como se fosse um touro, agarrando uma das pernas de Cato pela coxa, levantando-a do chão enquanto começa a golpear socos consecutivos no rosto do lobo mais velho."

# game/a1s3.rpy:787
translate pt_br a1s3_41bc6417:

    # "Cato seems to become dazed, stumbling on his one foot, raising his paws to protect himself."
    "Cato parece ficar atordoado, tropeçando no seu pé livre, levantando suas patas para se proteger."

# game/a1s3.rpy:788
translate pt_br a1s3_58b1d597:

    # "I silently root for Amicus, wanting to see him put the old man on his ass."
    "Silenciosamente torço pelo Amicus, querendo ver ele fazer o velho cair de bunda no chão."

# game/a1s3.rpy:789
translate pt_br a1s3_624c489f:

    # "But then Cato's paw comes around in a vicious slap that turns Amicus's head to the right."
    "Mas, então, a pata do Cato contorna um grande tapa no ar que faz a cabeça do Amicus virar à direita."

# game/a1s3.rpy:790
translate pt_br a1s3_6200d51f:

    # "He drops Cato's leg, and that's when the old wolf wraps his arms around Amicus's waist, setting his shoulder in the other wolf's stomach before actually lifting him up off the ground."
    "Ele solta a perna do Cato, e é nesse momento que o lobo mais velho envolve seus braços na cintura do Amicus, colocando seu ombro no estômago do lobo antes de levantá-lo do chão."

# game/a1s3.rpy:792
translate pt_br a1s3_0af994cf:

    # "I don't know exactly how much Amicus weighs, but it's probably around the same as Cato himself, and somehow the old wolf is able to carry Amicus across the pit in a rush."
    "Eu não sei exatamente quanto o Amicus pesa mas, provavelmente deve ser mais ou menos o mesmo peso do Cato, ainda assim, o lobo mais velho é capaz de carregar o Amicus através do palco em uma corrida."

# game/a1s3.rpy:796
translate pt_br a1s3_6437268b:

    # "Alex and I dive out of the way as Cato crushes Amicus into the stairs with a thudding crunch."
    "Alex e eu batemos em retirada, saindo do caminho conforme Cato esmaga o Amicus contra as escadas violentamente."

# game/a1s3.rpy:797
translate pt_br a1s3_bfc7fc2f:

    # a "\"Huuunffh!\""
    a "\"Huuunffh!\""

# game/a1s3.rpy:799
translate pt_br a1s3_8e1a2876:

    # "I look back and see Amicus folded around Cato's shoulder, making a sound like a deflating tire as his eyes bulge."
    "Eu olho para trás e vejo o Amicus preso nos ombros do Cato, fazendo um som parecido com um pneu esvaziando, seus olhos arregalados."

# game/a1s3.rpy:800
translate pt_br a1s3_0907b945:

    # "After a moment, Cato finally pulls back."
    "Depois de um tempo, Cato finalmente sai de cima."

# game/a1s3.rpy:801
translate pt_br a1s3_42b33f69:

    # "Amicus curls up and rolls down the few steps to the pit of the amphitheater, making a horrible groaning sound."
    "Amicus se encolhe e rola alguns degraus até o palco do anfiteatro, soltando um gemido de dor horrível."

# game/a1s3.rpy:802
translate pt_br a1s3_f0281a99:

    # "Cato, meanwhile, straightens out his undergarments before turning to pick his robes up."
    "Cato, enquanto isso, ajusta sua tanga antes de pegar sua túnica de volta do chão."

# game/a1s3.rpy:804
translate pt_br a1s3_88f365cd:

    # ca "\"Good spar, Amicus. I hope you learned something from it. I announced to the public that the trials will begin at the end of this month.\""
    ca "\"Ótima luta, Amicus. Espero que você tenha aprendido alguma coisa com ela. Anunciei ao público que os julgamentos começam no final deste mês.\""

# game/a1s3.rpy:805
translate pt_br a1s3_ec5a8b2d:

    # ca "\"Remember that your pet will be involved, so be sure that he's prepared.\""
    ca "\"Lembre-se que o seu mascote estará envolvido, então tenha certeza de que ele estará preparado.\""

# game/a1s3.rpy:807
translate pt_br a1s3_c5e63ec2:

    # "Cato ties on his robe as he walks away, then suddenly turns as if forgetting something, addressing the still-wheezing Amicus."
    "Cato amarra sua túnica de volta enquanto anda em direção ao palácio, depois repentinamente se vira como se tivesse esquecido de alguma coisa, abordando o Amicus, ainda agonizando."

# game/a1s3.rpy:808
translate pt_br a1s3_35af9d64:

    # ca "\"Oh, and your sister and her guest arrived today. She requested to see you in the great hall as soon as our session ended.\""
    ca "\"Ah, sua irmã e o convidado dela chegaram hoje. Ela pediu para vê-lo no salão principal ao terminar da nossa sessão.\""

# game/a1s3.rpy:810
translate pt_br a1s3_6a826c68:

    # "And with that, Cato stalks off, his robes billowing in the wind."
    "E, com isso, Cato vai embora, suas roupas balançando com a ventania."

# game/a1s3.rpy:812
translate pt_br a1s3_32a278f0:

    # "I rush to Amicus's side."
    "Eu apresso o passo até ficar ao lado do Amicus."

# game/a1s3.rpy:813
translate pt_br a1s3_fb6c0d0f:

    # m "\"Amicus! Are you okay?\""
    m "\"Amicus! Você tá bem?\""

# game/a1s3.rpy:814
translate pt_br a1s3_4741aae0:

    # "I know that wolves are tougher than humans, but if I'd been slammed into the stairs like that there'd be a good chance I'd never get back up."
    "Eu sei que lobos são mais resistentes que humanos mas, se eu fosse atirado nas escadas desse jeito, teria uma grande chance de que eu nunca fosse levantar de novo."

# game/a1s3.rpy:815
translate pt_br a1s3_ac1a28d3:

    # "I set a hand on the Amicus's back as he hugs at his middle and presses his face against the stone floor."
    "Coloco uma mão nas costas do Amicus enquanto ele se encolhe em posição fetal e pressiona seu rosto contra o chão de pedra."

# game/a1s3.rpy:816
translate pt_br a1s3_52a9f44d:

    # "He keeps making a strained, grunting sound, and I can see a strand of drool connecting from his lips to the ground."
    "Ele continua fazendo um som fino de grunhido, e eu consigo notar um fio de baba entre seus lábios e o chão."

# game/a1s3.rpy:818
translate pt_br a1s3_4861c620:

    # "Alex stands next to us, nervously fidgeting with his robe."
    "Alex fica de pé próximo de nós com um tique nervoso, apertando sua roupa."

# game/a1s3.rpy:819
translate pt_br a1s3_2e87079d:

    # m "\"Amicus?\""
    m "\"Amicus?\""

# game/a1s3.rpy:820
translate pt_br a1s3_a72df472:

    # "Amicus surprises me by roughly pushing my hand away."
    "Amicus me surpreende empurrando minha mão para o lado de forma bruta."

# game/a1s3.rpy:822
translate pt_br a1s3_b5500f37:

    # a "\"I...I just...lost my wind. Give me...a moment.\""
    a "\"Eu... eu só... perdi o fôlego. Me dá... um segundo.\""

# game/a1s3.rpy:823
translate pt_br a1s3_c753c6b8:

    # "Amicus turns away from me, then rolls onto his back, his paws above his head, his breathing still irregular, but at least he {i}is{/i} breathing now."
    "Amicus se vira para o outro lado, então começa a rolar de costas, suas patas em cima da cabeça e sua respiração ainda irregular, mas pelo menos ele {i}está{/i} respirando agora."

# game/a1s3.rpy:824
translate pt_br a1s3_bbe4aec7:

    # "Alex clears his throat."
    "Alex pigarreia."

# game/a1s3.rpy:826
translate pt_br a1s3_1909cd31:

    # al "\"Amicus, do you need medical attention?\""
    al "\"Amicus, você precisa de auxílio médico?\""

# game/a1s3.rpy:827
translate pt_br a1s3_c04dd6b9:

    # "Amicus takes a deep breath, then lets it out slowly."
    "Amicus respira bem fundo, então solta bem devagar."

# game/a1s3.rpy:828
translate pt_br a1s3_2765f877:

    # a "\"No, Alex.\""
    a "\"Não, Alex.\""

# game/a1s3.rpy:829
translate pt_br a1s3_f401e24f:

    # al "\"Alright...then I should probably take my leave. I don't know when Cassius will return.\""
    al "\"Tudo bem... então eu provavelmente deveria ir embora. Não sei quando o Cassius vai retornar.\""

# game/a1s3.rpy:830
translate pt_br a1s3_c7a54e22:

    # "Alex, looking extremely uncomfortable, bows to both of us."
    "Alex, parecendo extremamente desconfortável, se curva para nós dois."

# game/a1s3.rpy:831
translate pt_br a1s3_6058277e:

    # al "\"Amicus, [mc], thank you for the outing. It was very relaxing.\""
    al "\"Amicus, [mc], obrigado pelo passeio. Foi muito relaxante.\""

# game/a1s3.rpy:833
translate pt_br a1s3_96c1acc4:

    # "He then quickly makes his exit down the stone path, disappearing through the trees."
    "Então ele vai embora seguindo o caminho de pedra, desaparecendo através das árvores."

# game/a1s3.rpy:834
translate pt_br a1s3_e23603b5:

    # "I stand awkwardly off to the side, waiting for Amicus to recover."
    "Eu fico lá meio sem jeito ao lado do Amicus, esperando ele se recuperar."

# game/a1s3.rpy:835
translate pt_br a1s3_0d223639:

    # a "\"Tch, some ambassador friend he is.\""
    a "\"Tsc, que embaixador amigo ele é.\""

# game/a1s3.rpy:836
translate pt_br a1s3_288a180b:

    # "He opens one eye, looking at me."
    "Ele abre um dos olhos, me encarando."

# game/a1s3.rpy:838
translate pt_br a1s3_0240f4d0:

    # a "\"You know, you can head back to the palace as well.\""
    a "\"Sabe, você pode ir embora para o palácio também.\""

# game/a1s3.rpy:839
translate pt_br a1s3_a6737e04:

    # m "\"I...just wanna make sure you're okay.\""
    m "\"Eu... só quero ter certeza de que você tá bem.\""

# game/a1s3.rpy:840
translate pt_br a1s3_bb29fc33:

    # a "\"I'm fine.\""
    a "\"Eu estou ótimo.\""

# game/a1s3.rpy:841
translate pt_br a1s3_6da6c062:

    # m "\"I mean, he hit you really hard. I'm a little worried.\""
    m "\"Olha... ele te bateu muito forte. Eu tô um pouco preocupado.\""

# game/a1s3.rpy:843
translate pt_br a1s3_d24211da:

    # a "\"Don't be. Go back to my room.\""
    a "\"Não fique. Volte para o meu quarto.\""

# game/a1s3.rpy:844
translate pt_br a1s3_16893f7f:

    # "Amicus's usually cheerful mood has completely dissipated."
    "O humor alegre e animado do Amicus se dissipou completamente."

# game/a1s3.rpy:845
translate pt_br a1s3_70f08979:

    # m "\"Well, if I'm pretending to be your pet then I guess I'll just pretend to be worried, alright?\""
    m "\"Olha, se eu vou fingir ser o seu mascote então eu acho que vou só fingir estar preocupado, beleza?\""

# game/a1s3.rpy:846
translate pt_br a1s3_eda0f1e0:

    # "Amicus just grunts and finally gets to his feet, wincing as he does."
    "Amicus apenas grunhe e finalmente fica de pé, estremecendo enquanto levanta."

# game/a1s3.rpy:847
translate pt_br a1s3_f9452f29:

    # "He straightens out his undergarments which had twisted off to the side before walking toward the same path Alex had taken."
    "Ele ajusta sua tanga, a qual ficou virada para o lado, antes de andar pelo mesmo caminho que o Alex tinha seguido anteriormente."

# game/a1s3.rpy:849
translate pt_br a1s3_898012cb:

    # "I quickly catch up, following a few steps behind the wolf."
    "Eu rapidamente sigo seus passos, ficando a uma pequena distância atrás dele."

# game/a1s3.rpy:850
translate pt_br a1s3_353d1fae:

    # "Amicus is hunched over, walking with a light limp."
    "Amicus fica um pouco curvado, mancando levemente."

# game/a1s3.rpy:851
translate pt_br a1s3_701306c3:

    # "I feel a wave of anger for Cato."
    "Sinto uma onda de raiva por causa do Cato."

# game/a1s3.rpy:852
translate pt_br a1s3_844a9673:

    # "He'd been nice to me yesterday, but now I realize that isn't typical for him."
    "Ele foi legal comigo ontem, mas agora eu percebo que isso não é típico dele."

# game/a1s3.rpy:853
translate pt_br a1s3_d356c29c:

    # "I understood the \"lesson\" he was teaching Amicus in the amphitheater, but I don't understand why it had to involve violence."
    "Entendi a \"lição\" que ele deu ao Amicus no anfiteatro, mas eu não entendo por que tinha que envolver violência."

# game/a1s3.rpy:854
translate pt_br a1s3_7c208c67:

    # "Is this how the wolves normally treated each other?"
    "É assim que os lobos normalmente tratam uns aos outros?"

# game/a1s3.rpy:855
translate pt_br a1s3_77941b03:

    # "Fake civility with bursts of savage aggression?"
    "Falsa civilidade com explosões de agressão selvagem?"

# game/a1s3.rpy:856
translate pt_br a1s3_50784dc8:

    # m "\"Was that...was what Cato did normal?\""
    m "\"Isso foi... o que o Cato fez é normal?\""

# game/a1s3.rpy:858
translate pt_br a1s3_cc43205e:

    # a "\"What do you mean?\""
    a "\"Como assim?\""

# game/a1s3.rpy:859
translate pt_br a1s3_3600a524:

    # m "\"I mean, does he usually just...beat you like that?\""
    m "\"Sabe, ele costuma... te bater desse jeito?\""

# game/a1s3.rpy:860
translate pt_br a1s3_6d85daed:

    # "Amicus sighs deeply."
    "Amicus suspira profundamente."

# game/a1s3.rpy:861
translate pt_br a1s3_67ace871:

    # a "\"Not usually, no.\""
    a "\"Não com frequência, não.\""

# game/a1s3.rpy:862
translate pt_br a1s3_368271e2:

    # m "\"Seemed a bit...much.\""
    m "\"Pareceu um pouco... demais.\""

# game/a1s3.rpy:864
translate pt_br a1s3_b6df1af7:

    # a "\"Can we not speak of this? I'm not in the mood.\""
    a "\"Podemos não falar sobre isso agora? Eu não estou no clima.\""

# game/a1s3.rpy:865
translate pt_br a1s3_53d090c1:

    # "I go quiet and I see Amicus's ears fall flat for a bit before coming back up."
    "Eu fico quieto e vejo as orelhas do Amicus deitarem por um instante antes de voltarem à posição original."

# game/a1s3.rpy:867
translate pt_br a1s3_ebc91ffe:

    # "We walk the rest of the way to the palace in silence."
    "Nós andamos o resto do caminho até o palácio em silêncio."

# game/a1s3.rpy:868
translate pt_br a1s3_e6b91e0b:

    # "I'm sure to stay a few steps behind Amicus, wanting to give him space."
    "Eu me asseguro de ficar alguns passos atrás do Amicus, querendo dar espaço a ele."

# game/a1s3.rpy:870
translate pt_br a1s3_5b4c61b2:

    # "I get the feeling that while he's definitely upset about what happened, he's mostly just embarrassed that I saw it."
    "Tenho a sensação de que por mais que ele esteja definitivamente chateado com o que aconteceu, ele se sente mais é envergonhado por eu ter visto tudo."

# game/a1s3.rpy:873
translate pt_br a1s3_89cc8238:

    # "We finally reach the main entrance to the palace and just as we turn into the great hall—"
    "Nós finalmente chegamos na entrada da frente do palácio e, ao mesmo tempo que entramos no salão principal—"

# game/a1s3.rpy:875
translate pt_br a1s3_120f6972:

    # unk "\"Amicus!\""
    unk "\"Amicus!\""

# game/a1s3.rpy:876
translate pt_br a1s3_96761ffb:

    # "A high, sing-song voice echoes around the marble walls as a slight, Wolvish figure quickly approaches us."
    "Uma voz alta e cantarolante ecoa através das paredes de mármore enquanto uma delicada figura lobina rapidamente se aproxima de nós."

# game/a1s3.rpy:878
translate pt_br a1s3_eb529969:

    # "A wolf who I can only imagine is Virginia walks up to Amicus."
    "Uma loba que eu só consigo imaginar que seja Virginia anda na direção do Amicus."

# game/a1s3.rpy:879
translate pt_br a1s3_2984a8e8:

    # "She places both paws on his shoulders and leans in, pressing the side of her face to his."
    "Ela coloca as duas patas nos ombros dele e se inclina, pressionando a lateral do rosto contra o dele."

# game/a1s3.rpy:881
translate pt_br a1s3_d396564e:

    # a "\"Hi, Virginia.\""
    a "\"Oi, Virginia.\""

# game/a1s3.rpy:882
translate pt_br a1s3_624bf570:

    # "Virginia pulls back, rolling her eyes."
    "Virginia recua, revirando os olhos."

# game/a1s3.rpy:884
translate pt_br a1s3_fafd2f3b:

    # v "\"Amicus, I took your place on a trip around the moon for a full week and your only response is 'hi'?\""
    v "\"Amicus, eu fiquei no seu lugar em uma viagem ao redor da lua por uma semana inteira e eu só recebo um oi?\""

# game/a1s3.rpy:886
translate pt_br a1s3_2ddfb85a:

    # a "\"Sorry, I...I'm not feeling all that well.\""
    a "\"Desculpe, eu... eu não estou me sentindo muito bem.\""

# game/a1s3.rpy:888
translate pt_br a1s3_637c1856:

    # v "\"Oh? Was Cato too rough with you during training? Shall I have a word with him?\""
    v "\"Ah? Cato pegou pesado durante o treino de vocês? Devo dar uma palavrinha com ele?\""

# game/a1s3.rpy:890
translate pt_br a1s3_30c10f04:

    # a "\"No, I'm just sore.\""
    a "\"Não, eu só estou dolorido.\""

# game/a1s3.rpy:892
translate pt_br a1s3_853eb190:

    # v "\"Mh, you could use a shower, too. You smell dreadful.\""
    v "\"Hm, você está precisando de um banho, também. Está com um cheiro terrível.\""

# game/a1s3.rpy:894
translate pt_br a1s3_e96b5234:

    # a "\"I—we were swimming in the lake...never mind.\""
    a "\"Eu—nós estávamos nadando no lago... deixa para lá.\""

# game/a1s3.rpy:896
translate pt_br a1s3_1654af19:

    # a "\"I should be getting back to my room.\""
    a "\"Eu deveria voltar para o meu quarto.\""

# game/a1s3.rpy:898
translate pt_br a1s3_3ecc1aa9:

    # v "\"Enough with the dour mood, Amicus. Not until we introduce our guests to each other!\""
    v "\"Chega de mau humor, Amicus. Você não vai enquanto não apresentarmos nossos convidados um ao outro!\""

# game/a1s3.rpy:900
translate pt_br a1s3_304e03c1:

    # "Virginia looks right at me, over Amicus's shoulder."
    "Virginia olha diretamente para mim, acima do ombro do Amicus."

# game/a1s3.rpy:901
translate pt_br a1s3_377c83fb:

    # "Amicus sighs, then reaches out his paw to me."
    "Amicus suspira e então estende a pata na minha direção."

# game/a1s3.rpy:902
translate pt_br a1s3_e9dfa47b:

    # "I walk over to him, letting the wolf place his paw on my shoulder."
    "Eu ando até ele, deixando o lobo repousar uma pata no meu ombro."

# game/a1s3.rpy:903
translate pt_br a1s3_f0aa396d:

    # a "\"This is [mc], he's an abandoned child.\""
    a "\"Esse é o [mc], ele é um infante abandonado.\""

# game/a1s3.rpy:905
translate pt_br a1s3_1dca376f:

    # v "\"Oh, fascinating. I thought Cass was pulling my tail in his letters.\""
    v "\"Ah, fascinante. Pensei que o Cass estivesse puxando minha cauda em suas cartas.\""

# game/a1s3.rpy:907
translate pt_br a1s3_c04e3ef2:

    # "Virginia stretches out a paw."
    "Virginia estende uma pata."

# game/a1s3.rpy:908
translate pt_br a1s3_f89be9be:

    # "I stand there awkwardly, unsure of what to do...so I reach out and take her paw in my hand."
    "Eu fico parado sem jeito, inseguro sobre como deveria agir... então estendo minha mão e pego sua pata."

# game/a1s3.rpy:909
translate pt_br a1s3_94774804:

    # "Then, after another pause, I lean down and brush my lips on her fur like I'd seen people do in movies."
    "Depois de outra pausa, me inclino e encosto meus lábios no pelo dela assim como eu vi as pessoas fazerem nos filmes."

# game/a1s3.rpy:911
translate pt_br a1s3_68690702:

    # v "\"Heh, interesting. It seems they have some sort of etiquette.\""
    v "\"Hehe, interessante. Ao que parece eles têm alguma noção de etiqueta.\""

# game/a1s3.rpy:912
translate pt_br a1s3_3036822a:

    # "I step back, keeping my head down."
    "Eu dou um passo para trás, deixando minha cabeça baixa."

# game/a1s3.rpy:914
translate pt_br a1s3_45800067:

    # a "\"A bit, yes. Now where's the Khemian?\""
    a "\"Um pouco, sim. Agora, onde está o khemiano?\""

# game/a1s3.rpy:915
translate pt_br a1s3_af6d301a:

    # v "\"Manners, Amicus. He's examining the murals.\""
    v "\"Maneiras, Amicus. Ele está examinando os murais.\""

# game/a1s3.rpy:916
translate pt_br a1s3_fec9b48e:

    # "She turns to her right, raising her voice a bit."
    "Ela vira à sua direita, aumentando um pouco a voz."

# game/a1s3.rpy:918
translate pt_br a1s3_69c7ae95:

    # v "\"Neferu? Could you come over and meet my brother, please?\""
    v "\"Neferu? Você poderia vir aqui e conhecer o meu irmão, por favor?\""

# game/a1s3.rpy:919
translate pt_br a1s3_7ff82308:

    # "There's a moment of silence, then soft footsteps."
    "Há um momento de silêncio, depois posso ouvir passos leves."

# game/a1s3.rpy:921
translate pt_br a1s3_d963e447:

    # "A canine appears around the corner, his fur much darker than the wolves, almost pitch-black."
    "Um canino aparece no canto, seu pelo muito mais escuro que o dos lobos, quase completamente preto."

# game/a1s3.rpy:922
translate pt_br a1s3_cdd97703:

    # "He's covered in gold highlights and immediately I'm struck by how he looks."
    "Ele é coberto de decorações douradas e imediatamente eu fico impressionado com a aparência dele."

# game/a1s3.rpy:923
translate pt_br a1s3_b8b90a9b:

    # "Not just because his presence is impressive, it definitely is, but mostly because he reminds me of something on Earth."
    "Não só porque é impressionante, e definitivamente é. Mas principalmente porque ele me lembra algo na Terra."

# game/a1s3.rpy:924
translate pt_br a1s3_bf7c6b3e:

    # "Not just something, but an entire thing...a culture."
    "Não apenas algo, mas uma cultura inteira."

# game/a1s3.rpy:926
translate pt_br a1s3_3a1bdb90:

    # "As I stare, I realize that he's not looking at Amicus, but at me."
    "Enquanto eu o encaro, percebo que ele não está olhando para o Amicus e sim para mim."

# game/a1s3.rpy:927
translate pt_br a1s3_ff54a66a:

    # "I quickly look down again, not wanting to draw attention to myself."
    "Rapidamente olho para baixo outra vez, não querendo atrair atenção para mim."

# game/a1s3.rpy:929
translate pt_br a1s3_5331dcd4:

    # v "\"Neferu, this is my brother, Amicus.\""
    v "\"Neferu, este é o meu irmão, Amicus.\""

# game/a1s3.rpy:930
translate pt_br a1s3_bc3cce23:

    # "Neferu bows his head slightly in Amicus's direction."
    "Neferu curva sua cabeça ligeiramente na direção do Amicus."

# game/a1s3.rpy:932
translate pt_br a1s3_fffa4ba3:

    # n "\"Hello, thank you for letting me take up residence in your palace. It is indeed beautiful.\""
    n "\"Olá, obrigado por me oferecer residência em seu palácio. É realmente muito bonito.\""

# game/a1s3.rpy:933
translate pt_br a1s3_1c34b703:

    # "It's hard to describe, but I immediately know that Neferu is speaking a different language than the wolves."
    "É difícil descrever, mas percebo imediatamente que Neferu falou em um idioma diferente dos lobos."

# game/a1s3.rpy:934
translate pt_br a1s3_548a3826:

    # "It has a different feel in my brain, like a different dialect."
    "Senti algo distinto no meu cérebro, como se fosse um dialeto diferente."

# game/a1s3.rpy:936
translate pt_br a1s3_3de05df9:

    # a "\"Certainly. You'll have to excuse my appearance; I was just out combat training.\""
    a "\"Certamente. Você vai ter que perdoar minha aparência; eu acabei de voltar de um treino de combate.\""

# game/a1s3.rpy:938
translate pt_br a1s3_55d9bb52:

    # n "\"Oh, I see. It must have been a rough session, by the looks of it.\""
    n "\"Ah, entendo. Deve ter sido uma sessão porreta, julgando pelo seu estado.\""

# game/a1s3.rpy:942
translate pt_br a1s3_65126a1b:

    # "Neferu gives Amicus a cool smile and Amicus can only manage a grunt in response, self-consciously running a paw over his head fur."
    "Neferu dá um sorriso descolado para o Amicus e ele só consegue soltar um grunhido em resposta, conscientemente levando uma pata até a cabeça."

# game/a1s3.rpy:943
translate pt_br a1s3_750703dc:

    # "That's when Neferu turns his cool, blue gaze on me."
    "É nesse momento que Neferu desvia seu olhar descolado e azul para mim."

# game/a1s3.rpy:945
translate pt_br a1s3_13175862:

    # n "\"And who might you be?\""
    n "\"E quem seria você?\""

# game/a1s3.rpy:946
translate pt_br a1s3_b05e013c:

    # "I open my mouth to answer, then catch myself and quickly look back down."
    "Eu abro minha boca para responder, mas me impeço e rapidamente olho para baixo."

# game/a1s3.rpy:948
translate pt_br a1s3_ee3d1d40:

    # a "\"This is [mc], my pet. He's an abandoned child.\""
    a "\"Este é o [mc], meu mascote. Ele é um infante abandonado.\""

# game/a1s3.rpy:949
translate pt_br a1s3_e29b59fc:

    # "Amicus says it quickly, putting his paw on my shoulder again while gently pulling me in the direction of his room."
    "Amicus fala rapidamente, colocando uma pata no meu ombro mais uma vez enquanto gentilmente me puxa na direção de seu quarto."

# game/a1s3.rpy:951
translate pt_br a1s3_42805eda:

    # a "\"It was wonderful meeting you, but now I must be off to my shower—\""
    a "\"Foi um prazer conhecê-lo, mas agora eu preciso ir tomar banho—\""

# game/a1s3.rpy:953
translate pt_br a1s3_4ea9f189:

    # "Neferu offers his paw to me."
    "Neferu oferece sua pata para mim."

# game/a1s3.rpy:955
translate pt_br a1s3_066d5afd:

    # "I pause again, but Amicus just stares at Neferu, so I take it and do the same as I did with Virginia."
    "Eu faço outra pausa, mas Amicus simplesmente encara o Neferu, então eu a pego e faço o mesmo que eu fiz com a da Virginia."

# game/a1s3.rpy:957
translate pt_br a1s3_df8aa612:

    # "Neferu lets out a soft chuckle as I let go of his paw."
    "Neferu solta uma leve risadinha enquanto eu solto sua pata."

# game/a1s3.rpy:959
translate pt_br a1s3_74d81c2e:

    # n "\"What a fascinating creature. Do you speak?\""
    n "\"Mas que criatura fascinante. Você fala?\""

# game/a1s3.rpy:960
translate pt_br a1s3_be9d0e5d:

    # "I make sure to give a long pause, then—"
    "Eu faço questão de fazer uma longa pausa, então—"

# game/a1s3.rpy:961
translate pt_br a1s3_209b2171:

    # m "\"Little...\""
    m "\"Pouco...\""

# game/a1s3.rpy:963
translate pt_br a1s3_80416439:

    # n "\"I see.\""
    n "\"Entendo.\""

# game/a1s3.rpy:964
translate pt_br a1s3_23e28f48:

    # "Neferu keeps his eyes fixed on me, and I have to wonder why the hell he's taken such an interest."
    "Neferu mantém seus olhos fixados em mim e eu tenho que me perguntar por que diabos ele ficou tão interessado."

# game/a1s3.rpy:966
translate pt_br a1s3_61cdecfe:

    # a "\"Ahem.\""
    a "\"Ahem.\""

# game/a1s3.rpy:967
translate pt_br a1s3_9c95ecca:

    # "Amicus draws me close to his side with a paw before starting to walk in the direction of the hall."
    "Amicus me puxa para mais perto de si com uma pata antes de começar a andar na direção do corredor."

# game/a1s3.rpy:968
translate pt_br a1s3_3bf51a1f:

    # a "\"If you'll excuse us, I need my pet's assistance in the showers. Pleasure meeting you.\""
    a "\"Se nos dão licença, eu preciso da ajuda do meu mascote no chuveiro. Prazer em conhecê-lo.\""

# game/a1s3.rpy:969
translate pt_br a1s3_aa7b048f:

    # "Virginia, who had been silent throughout, smiles."
    "Virginia, que estava em silêncio durante esse tempo, sorri."

# game/a1s3.rpy:971
translate pt_br a1s3_e5b611fb:

    # v "\"Don't worry Neferu, we just caught my brother in a bad mood. Usually he's much more friendly.\""
    v "\"Não se preocupe, Neferu, nós só encontramos meu irmão em um dia ruim. Ele costuma ser muito mais amigável.\""

# game/a1s3.rpy:973
translate pt_br a1s3_4b709626:

    # a "\"I can hear you, Virginia. I'm still here.\""
    a "\"Eu consigo te ouvir, Virginia. Ainda estou aqui.\""

# game/a1s3.rpy:977
translate pt_br a1s3_30a751d3:

    # v "\"So you are, yet you said you had to be off. We shall speak more in depth in the evening, perhaps when you've stopped sulking.\""
    v "\"De fato você está, ainda assim disse que precisava ir. Devemos conversar com mais calma no final da tarde, talvez quando você parar de ser tão rabugento.\""

# game/a1s3.rpy:979
translate pt_br a1s3_c1d6e3aa:

    # "Amicus grunts noncommittally and pulls me along toward his bedroom."
    "Amicus resmunga sem compromisso e me puxa para o seu quarto."

# game/a1s3.rpy:982
translate pt_br a1s3_2248249e:

    # "As we arrive at Amicus's room, there's a cart of flatbread, vegetables, and a bowl of sauce sitting outside the door."
    "Quando chegamos no quarto do Amicus, encontramos um carrinho com pão achatado, vegetais e uma tijela com molho do lado de fora."

# game/a1s3.rpy:983
translate pt_br a1s3_bdf44a3b:

    # "I've come to realize that there are two main meals in the day: breakfast and dinner, with a sort of midday snack in between."
    "Percebi que eles têm duas refeições principais no dia: café da manhã e jantar, com uma espécie de lanche da tarde entre elas."

# game/a1s3.rpy:984
translate pt_br a1s3_9b28f8f5:

    # "Amicus grabs the cart and shoves it into the room toward the sofa, almost rattling the contents to the floor."
    "Amicus pega o carrinho e arrasta ele pelo quarto em direção ao sofá, quase derrubando tudo no chão."

# game/a1s3.rpy:985
translate pt_br a1s3_3f5fe7a9:

    # "Then, without a word, he heads straight to the shower, leaving me to sit on the couch while I frown at the door."
    "Então, sem dizer uma palavra, ele vai direto para o chuveiro, me deixando sentado no sofá enquanto eu olho na direção da porta recém fechada com uma sobrancelha levantada."

# game/a1s3.rpy:986
translate pt_br a1s3_57c6e829:

    # "At first, I think about calling him out on his bad mood when he comes back out, maybe go on about how I didn't ask to be here and him being an ass only makes it worse."
    "No começo, penso em mencionar o mau humor dele quando ele voltar, talvez falar sobre como eu não pedi para estar aqui e ele agir como um babaca só faz as coisas ficarem piores."

# game/a1s3.rpy:987
translate pt_br a1s3_a6191e7b:

    # "But then I start to realize that maybe I wouldn't be so happy myself if I'd gotten my ass kicked in front of my friends."
    "Mas aí eu começo a perceber que talvez não ficaria tão feliz eu mesmo se tivesse levado uma surra na frente dos meus amigos."

# game/a1s3.rpy:988
translate pt_br a1s3_b9fb4a5c:

    # "I spend the next fifteen minutes or so spreading the orange-colored sauce on the flatbread before sprinkling the vegetables on top and rolling it into a wrap."
    "Eu gasto os próximos quinze minutos mais ou menos espalhando o molho alaranjado no pão achatado antes de salpicar alguns vegetais e dobrar em um rolo."

# game/a1s3.rpy:989
translate pt_br a1s3_f4fd75ef:

    # "It's good, and the sauce is one of the first spicy things that I've experienced on this moon."
    "É muito bom e o molho é uma das primeiras coisas picantes que eu já provei nessa lua."

# game/a1s3.rpy:990
translate pt_br a1s3_c04a0ca5:

    # "Then Amicus comes back out, looking particularly fluffy."
    "Então o Amicus sai do banheiro, seu pelo parecendo particularmente estufado."

# game/a1s3.rpy:991
translate pt_br a1s3_745d0131:

    # "I'm about to ask if he wants to get brushed, but he just falls back into his bed with a groan."
    "Eu fico prestes a perguntar se ele quer ser escovado, mas ele simplesmente se joga na cama com um grunhido."

# game/a1s3.rpy:993
translate pt_br a1s3_702cfbe4:

    # m "\"You alright?\""
    m "\"Você tá bem?\""

# game/a1s3.rpy:995
translate pt_br a1s3_408fcf67:

    # a "\"Never better.\""
    a "\"Nunca estive melhor.\""

# game/a1s3.rpy:996
translate pt_br a1s3_5190711e:

    # "A few of the chopped peppers fall out of my wrap onto the sofa and I quickly pick them back up and set them on the cart."
    "Alguns dos pimentões picados caem do meu pão direto no sofá e eu rapidamente pego eles de volta e coloco no carrinho."

# game/a1s3.rpy:997
translate pt_br a1s3_3d041607:

    # m "\"This is actually really good; I was starting to worry that you guys didn't have food with actual flavor here. You know the country where you guys uplifted, Italy, it's known for its food.\""
    m "\"Isso é muito bom, na verdade; eu tava começando a me preocupar se vocês não tinham comida com sabor de verdade. Sabe, a cidade onde vocês elevaram, Itália, é bem conhecida pela comida.\""

# game/a1s3.rpy:998
translate pt_br a1s3_eaa06e60:

    # m "\"Actually, before you uh, took me, I had this trip planned to go to Naples, which is a few hours outside of Rome, just to try the pizza...do you have pizza here?\""
    m "\"Antes de você, hã... me pegar, eu tinha uma viagem planejada pra Nápoles, que fica só há algumas horas de Roma, só pra provar a pizza deles... vocês têm pizza aqui?\""

# game/a1s3.rpy:1000
translate pt_br a1s3_f80b7f81:

    # "Amicus gazes at me with a frown."
    "Amicus lança um olhar em mim, franzindo a testa."

# game/a1s3.rpy:1001
translate pt_br a1s3_6293a9bd:

    # "I wonder if he understood a single thing I said."
    "Eu me pergunto se ele entendeu alguma coisa do que eu disse."

# game/a1s3.rpy:1002
translate pt_br a1s3_d9aed1e7:

    # a "\"No.\""
    a "\"Não.\""

# game/a1s3.rpy:1003
translate pt_br a1s3_ab0b8c36:

    # m "\"Oh...well, it's sort of like this if I'd kept it flat and we baked it. Anyway, you want some?\""
    m "\"Ah... bem, é tipo que nem isso aqui se deixar plano e cozinhar. Enfim, quer um pouco?\""

# game/a1s3.rpy:1004
translate pt_br a1s3_62403c20:

    # "I hold up my wrap with a smile."
    "Eu seguro o meu pão com um sorriso."

# game/a1s3.rpy:1006
translate pt_br a1s3_2f8b3961:

    # "Amicus glares."
    "Amicus olha fixamente."

# game/a1s3.rpy:1007
translate pt_br a1s3_9fca7eb8:

    # a "\"I just had my guts squashed flatter than that flatbread and you're assuming I still have an appetite?\""
    a "\"Eu acabei de ter minhas entranhas mais achatadas que esse pão e você ainda acha que estou com algum apetite?\""

# game/a1s3.rpy:1008
translate pt_br a1s3_a0a3368d:

    # "I quickly lower it."
    "Eu rapidamente abaixo o pão."

# game/a1s3.rpy:1009
translate pt_br a1s3_11e67e6b:

    # m "\"Oh yeah, sorry.\""
    m "\"Ah, é verdade, foi mal.\""

# game/a1s3.rpy:1011
translate pt_br a1s3_b1ad0265:

    # "Amicus goes on staring at the ceiling while I nibble on the food, though I'm not really all that hungry anymore."
    "Amicus começa a encarar o teto enquanto eu mordisco a comida, embora não esteja mais com tanta fome assim."

# game/a1s3.rpy:1012
translate pt_br a1s3_3207e293:

    # "Then Amicus sighs deeply, covering his face with his paws."
    "Então Amicus suspira profundamente, cobrindo sua cara com as patas."

# game/a1s3.rpy:1014
translate pt_br a1s3_bced20e2:

    # a "\"I'm...sorry. I've just been thinking a lot is all.\""
    a "\"Me desculpa. É que eu tenho pensado demais, só isso.\""

# game/a1s3.rpy:1015
translate pt_br a1s3_736e45ce:

    # m "\"...About?\""
    m "\"Sobre o que?\""

# game/a1s3.rpy:1016
translate pt_br a1s3_c8798544:

    # "Amicus just shakes his head, continuing to rub his brow."
    "Amicus balança a cabeça, continuando a esfregar a sobrancelha."

# game/a1s3.rpy:1017
translate pt_br a1s3_2cb76928:

    # a "\"Well, how sore I am, for one.\""
    a "\"Bem, sobre o quão dolorido eu estou, para começar.\""

# game/a1s3.rpy:1018
translate pt_br a1s3_9d5ead88:

    # "I look over at the wolf, then remember what he'd said last night, about the massage."
    "Eu olho para o lobo, então me lembro sobre o que ele falou ontem à noite, sobre a massagem."

# game/a1s3.rpy:1019
translate pt_br a1s3_ddb454f1:

    # "I think about it for a moment."
    "Eu penso sobre isso por um momento."

# game/a1s3.rpy:1020
translate pt_br a1s3_f08a536a:

    # "Amicus {i}has{/i} been trying to make me as comfortable as possible throughout the few days I've been here...minus the sofa."
    "Amicus {i}vem{/i} tentando me deixar o mais confortável possível nesses poucos dias que eu estive aqui... com exceção do sofá."

# game/a1s3.rpy:1021
translate pt_br a1s3_21bb763d:

    # "I kinda feel like I owe it to him."
    "Eu sinto que devo isso a ele."

# game/a1s3.rpy:1022
translate pt_br a1s3_6bdb9c7e:

    # m "\"You want a massage?\""
    m "\"Você quer uma massagem?\""

# game/a1s3.rpy:1024
translate pt_br a1s3_d186e8fc:

    # "I see Amicus freeze up, his face still covered with his paws until he finally lowers them, his expression almost comical."
    "Eu vejo o Amicus congelar, seu rosto ainda coberto pelas patas até que ele finalmente as abaixa, sua expressão quase cômica."

# game/a1s3.rpy:1025
translate pt_br a1s3_3c8805f7:

    # a "\"What?\""
    a "\"O que?\""

# game/a1s3.rpy:1026
translate pt_br a1s3_03e7b0ae:

    # "I feel myself turning red."
    "Sinto meu rosto começando a ficar um pouco vermelho."

# game/a1s3.rpy:1027
translate pt_br a1s3_a57f8de0:

    # m "\"I asked if you want a massage.\""
    m "\"Eu perguntei se você quer uma massagem.\""

# game/a1s3.rpy:1029
translate pt_br a1s3_85a29171:

    # a "\"I thought you didn't want to.\""
    a "\"Eu achei que você não quisesse fazer.\""

# game/a1s3.rpy:1030
translate pt_br a1s3_37d0cf45:

    # m "\"Well, I never really gave you an answer, did I?\""
    m "\"Eu nunca te dei uma resposta de verdade, dei?\""

# game/a1s3.rpy:1031
translate pt_br a1s3_d72b6cc7:

    # "Amicus narrows his eyes."
    "Amicus estreita os olhos."

# game/a1s3.rpy:1033
translate pt_br a1s3_6cccea73:

    # a "\"I don't want to force you into something you don't want to do.\""
    a "\"Eu não quero te forçar a fazer algo que você não quer fazer.\""

# game/a1s3.rpy:1034
translate pt_br a1s3_e5c0d4a9:

    # m "\"Well I'm offering, but if you don't want it...\""
    m "\"Olha, eu tô te oferecendo, mas se você não quer...\""

# game/a1s3.rpy:1035
translate pt_br a1s3_a030b796:

    # "I start to sit back down."
    "Eu começo a me encostar de volta no sofá."

# game/a1s3.rpy:1036
translate pt_br a1s3_dba88776:

    # "Amicus's ears fall flat."
    "As orelhas do Amicus caem."

# game/a1s3.rpy:1038
translate pt_br a1s3_4a1c44d7:

    # a "\"No, no, please do.\""
    a "\"Não, não, por favor, faça.\""

# game/a1s3.rpy:1039
translate pt_br a1s3_08106cc9:

    # "I try to hide my smile as I get back up and approach the bed."
    "Eu tento esconder o meu sorriso enquanto levanto e me aproximo da cama."

# game/a1s3.rpy:1040
translate pt_br a1s3_003a059c:

    # "Amicus just sort of watches me, half-sitting up."
    "Amicus me observa, no meio do caminho para sentar."

# game/a1s3.rpy:1041
translate pt_br a1s3_b6ea62b7:

    # "Once I get to the edge of the bed, I pause."
    "Assim que eu chego no canto da cama, pauso."

# game/a1s3.rpy:1042
translate pt_br a1s3_f93353de:

    # m "\"Umm, so what do I do?\""
    m "\"Hmm... então, o que eu faço?\""

# game/a1s3.rpy:1044
translate pt_br a1s3_b9e01f02:

    # a "\"Oh, uh...\""
    a "\"Ah, hã...\""

# game/a1s3.rpy:1045
translate pt_br a1s3_57555863:

    # "Amicus rolls over onto his front."
    "Amicus rola e fica de costas para cima."

# game/a1s3.rpy:1047
translate pt_br a1s3_f78bdd28:

    # a "\"Well, honestly I don't really know how it's {i}supposed{/i} to be done, but you could start with some...light rubbing.\""
    a "\"Para falar a verdade eu não tenho certeza de como {i}deveria{/i} ser feito, então você pode só começar com uma... esfregada leve.\""

# game/a1s3.rpy:1048
translate pt_br a1s3_00c92f27:

    # "Cautiously, I get up onto the bed on my knees, trying not to get tangled up in my robe as I scoot closer."
    "Cuidadosamente, levanto na cama com meus joelhos, tentando não me enroscar nas minhas roupas enquanto me aproximo."

# game/a1s3.rpy:1049
translate pt_br a1s3_e84cc513:

    # "Tentatively, I reach out and touch the wolf's back."
    "Timidamente, estendo as mãos e toco as costas do lobo."

# game/a1s3.rpy:1050
translate pt_br a1s3_f5c85f92:

    # "Amicus inhales gently, his back rising against my fingers."
    "Amicus inspira gentilmente, suas costas levantando contra os meus dedos."

# game/a1s3.rpy:1051
translate pt_br a1s3_4aef78e2:

    # "Then, slowly, I start to massage, starting on his thick neck before slowly rubbing my way down."
    "Então, lentamente, começo a massagear, partindo de seu grosso pescoço antes de lentamente descer com as mãos."

# game/a1s3.rpy:1052
translate pt_br a1s3_823acc36:

    # "I don't know the first thing about massaging, so I just do what feels natural, and Amicus seems to like it."
    "Eu não faço ideia do que estou fazendo e se posso chamar isso de massagem, então apenas continuo com o que parece natural e Amicus parece gostar."

# game/a1s3.rpy:1053
translate pt_br a1s3_ca73ca54:

    # "When I reach his mid-back, he grunts."
    "Quando eu chego até a metade das costas, ele grunhe."

# game/a1s3.rpy:1055
translate pt_br a1s3_b28e4eae:

    # a "\"Little more gentle there. Got scraped on the stairs.\""
    a "\"Pega um pouco leve nessa parte. Foi raspado nas escadas.\""

# game/a1s3.rpy:1056
translate pt_br a1s3_e72c4b6f:

    # "I pause, then tease through the fur a bit and find a small, fresh scab, right on Amicus's spine."
    "Eu pauso, então começo a vasculhar um pouco o pelo e encontro uma pequena ferida fresca bem na coluna do Amicus."

# game/a1s3.rpy:1057
translate pt_br a1s3_b7818439:

    # "I pet the fur back down before moving past it, working my thumbs into the muscles on either side of the wolf's spine."
    "Eu arrumo o pelo de novo antes de mover para outro local, trabalhando meus polegares nos músculos de ambos os lados da coluna do lobo."

# game/a1s3.rpy:1058
translate pt_br a1s3_6444435b:

    # m "\"Cato's an asshole.\""
    m "\"Um arrombado do caralho esse Cato.\""

# game/a1s3.rpy:1060
translate pt_br a1s3_c88a54db:

    # "Amicus lets out a choked cough of surprise."
    "Amicus solta uma tosse de engasgo, surpreso."

# game/a1s3.rpy:1062
translate pt_br a1s3_7b4efb6e:

    # a "\"[mc]! Don't say that! He's the acting emperor.\""
    a "\"[mc]! Não diga isso! Ele é o imperador interino.\""

# game/a1s3.rpy:1063
translate pt_br a1s3_dee421ac:

    # m "\"Well, he is.\""
    m "\"Foda-se, eu não tô nem aí.\""

# game/a1s3.rpy:1064
translate pt_br a1s3_67a58621:

    # a "\"If you must say it, at least keep your voice down. I swear, Cassius sometimes has his ear pressed to my doo-aaaaah...\""
    a "\"Se você precisa falar, então pelo menos diminua o volume da voz. Eu juro, Cassius algumas vezes fica com a orelha pressionada contra minha po-aaaaah...\""

# game/a1s3.rpy:1066
translate pt_br a1s3_ddf22c45:

    # "Amicus moans as I start on his neck again and press harder than I had last time, really sinking into the muscle."
    "Amicus geme quando eu começo em seu pescoço de novo e pressiono mais forte que da última vez, realmente afundando nos músculos."

# game/a1s3.rpy:1067
translate pt_br a1s3_4aa70756:

    # "The wolf's body melts into the bed and I grin with satisfaction as I keep up the pressure down the rest of his back."
    "O corpo do lobo derrete na cama e eu sorrio de satisfação à medida que mantenho a pressão deslizando pelo resto de suas costas."

# game/a1s3.rpy:1068
translate pt_br a1s3_158ec1eb:

    # "It would be easier if I were straddling him, but I don't know how I feel about doing that just yet."
    "Seria mais fácil se eu estivesse montado em cima, mas não me sinto íntimo dele o suficiente para fazer isso ainda."

# game/a1s3.rpy:1069
translate pt_br a1s3_57438d7c:

    # "Amicus is quiet for a few minutes while I work, then he sighs."
    "Amicus fica quieto por alguns minutos enquanto eu massageio, então ele suspira."

# game/a1s3.rpy:1071
translate pt_br a1s3_5532e1d1:

    # a "\"He was right though. I still act like a pup. I need to be more serious.\""
    a "\"Mas ele estava certo. Eu ainda ajo como um filhote. Preciso ser mais sério.\""

# game/a1s3.rpy:1072
translate pt_br a1s3_e499761a_2:

    # "I frown."
    "Eu levanto uma sobrancelha."

# game/a1s3.rpy:1073
translate pt_br a1s3_9d3344cb:

    # m "\"What do you mean?\""
    m "\"Como assim?\""

# game/a1s3.rpy:1074
translate pt_br a1s3_044069f7:

    # a "\"Cato had every right to beat me. I haven't been acting very much like an emperor lately.\""
    a "\"Cato tinha todo o direito de me bater. Eu não venho me comportando muito como um imperador recentemente.\""

# game/a1s3.rpy:1075
translate pt_br a1s3_6a20a80d_1:

    # "I shake my head."
    "Eu balanço a minha cabeça em negação."

# game/a1s3.rpy:1076
translate pt_br a1s3_3461c9bf:

    # m "\"First of all, no one should be beaten. Second, Cassius acts like a child...or pup. I mean, you might sometimes act a little immature, but he's a brat. You're fine if he's the one you're competing with.\""
    m "\"Uma porra, ninguém merece ser tratado assim. Segundo, Cassius age igual a uma criança... ou filhote. Assim, você age de um jeito meio imaturo às vezes, mas ele é um pirralho. Se a competição é com ele, você tá ótimo.\""

# game/a1s3.rpy:1077
translate pt_br a1s3_c24fd540:

    # m "\"Besides, you're a lot of fun to be around. If I were a wolf, I would think it's pretty cool to have an emperor as nice and fun as you are.\""
    m "\"Além disso, você é uma companhia muito divertida. Se eu fosse um lobo, acharia ótimo ter um imperador tão legal e divertido como você.\""

# game/a1s3.rpy:1079
translate pt_br a1s3_950e85cf:

    # a "\"Oh really?\""
    a "\"Ah, sério?\""

# game/a1s3.rpy:1081
translate pt_br a1s3_996cbad6:

    # a "\"Then I suppose things are different here. I forgot myself at the lake today, and when Cato caught me teasing you...\""
    a "\"Acho que as coisas são diferentes aqui. Eu esqueci dos meus problemas no lago hoje, e quando o Cato me pegou no flagra provocando você...\""

# game/a1s3.rpy:1083
translate pt_br a1s3_b598e920:

    # "Amicus presses his face into the pillow, cringing."
    "Amicus pressiona seu rosto no travesseiro, envergonhado."

# game/a1s3.rpy:1084
translate pt_br a1s3_a44466bc:

    # m "\"Can you not have fun as the prospective emperor?\""
    m "\"Você não pode se divertir só porque vai ser um imperador?\""

# game/a1s3.rpy:1086
translate pt_br a1s3_01975de2:

    # a "\"Not really...Cassius hasn't been out in the lake for years. Sometimes I think something is wrong with me, that I still enjoy such things.\""
    a "\"Na verdade, não... Cassius não vai ao lago há anos. Algumas vezes eu me pergunto se tem alguma coisa errada comigo por ainda gostar dessas coisas.\""

# game/a1s3.rpy:1087
translate pt_br a1s3_a28731d1:

    # "I think, trying to decide whether my opinion is worth anything on this alien moon."
    "Eu penso, tentando decidir se minha opinião vale alguma coisa nessa lua alienígena."

# game/a1s3.rpy:1088
translate pt_br a1s3_1ebb9d48:

    # m "\"Well, I don't think so. People our age on Earth do way dumber stuff to have fun and it's considered normal. Even when you get older you're expected to do things you enjoy.\""
    m "\"Eu acho que não. As pessoas da nossa idade na terra fazem coisas muito mais idiotas pra se divertir e é considerado normal. Mesmo quando você fica velho as pessoas ainda esperam que você faça coisas que gosta.\""

# game/a1s3.rpy:1089
translate pt_br a1s3_eea311ca:

    # m "\"Otherwise what's the point of life? We're only here for a moment before we die and that's it.\""
    m "\"Senão, qual é o propósito da vida? Nós só estamos aqui por um momento antes de morrer e é isso aí.\""

# game/a1s3.rpy:1090
translate pt_br a1s3_3acbffc8:

    # "I can't help but feel that my argument is a bit amateurish."
    "Não consigo evitar de pensar que minha linha de raciocínio soa um pouco clichê."

# game/a1s3.rpy:1091
translate pt_br a1s3_4889be37:

    # "Amicus doesn't seem convinced either."
    "Amicus não parece convencido também."

# game/a1s3.rpy:1092
translate pt_br a1s3_7797cb03:

    # a "\"Well, first of all the point of my life is to lead my people to a better future. Secondly, we become one with the parents when we die.\""
    a "\"Bem, primeiro de tudo, todo o propósito da minha vida é guiar o meu povo para um futuro melhor. Segundo, nós nos tornamos um só com os progenitores quando morremos.\""

# game/a1s3.rpy:1093
translate pt_br a1s3_e499761a_3:

    # "I frown."
    "Eu faço uma careta."

# game/a1s3.rpy:1094
translate pt_br a1s3_81d6399a:

    # m "\"Become one? What, do they...absorb your soul, or something?\""
    m "\"Tornar um só? O que, eles... absorvem sua alma, ou algo do tipo?\""

# game/a1s3.rpy:1095
translate pt_br a1s3_a3cd140c:

    # "I stifle my chuckle when I see that Amicus is still very serious."
    "Eu sufoco minha risada quando noto que o Amicus continua bem sério."

# game/a1s3.rpy:1096
translate pt_br a1s3_c76da010:

    # a "\"No, well, I don't know, but our consciousness joins theirs and we go on to spread throughout the universe together.\""
    a "\"Não, bem, eu não sei, mas nossa consciência se junta com a deles e nós continuamos a viajar pelo universo juntos.\""

# game/a1s3.rpy:1097
translate pt_br a1s3_cfaf8b4b:

    # m "\"Huh, is there...proof of this? Did they say that's what happens?\""
    m "\"Hã, tem alguma... evidência disso? Eles disseram que é isso o que acontece?\""

# game/a1s3.rpy:1098
translate pt_br a1s3_d098c481:

    # a "\"Of course.\""
    a "\"É claro.\""

# game/a1s3.rpy:1099
translate pt_br a1s3_90449f37:

    # "I think of questioning him further, but right now I'm not really in the mood to debate anything religious with this wolf."
    "Eu penso em continuar questionando, mas agora eu não estou no clima para debater qualquer coisa religiosa com esse lobo."

# game/a1s3.rpy:1100
translate pt_br a1s3_45db9ce8:

    # "His mind seems to be on the \"having fun\" issue anyway."
    "A mente dele parece estar no problema de \"se divertir\", de qualquer forma."

# game/a1s3.rpy:1101
translate pt_br a1s3_2920a5ea:

    # m "\"Well, I will say that Roman emperors on Earth had a lot of fun.\""
    m "\"Eu posso dizer que os imperadores romanos da Terra se divertiram muito.\""

# game/a1s3.rpy:1102
translate pt_br a1s3_e33f02ef_2:

    # "I laugh."
    "Eu rio."

# game/a1s3.rpy:1103
translate pt_br a1s3_42ac20de:

    # m "\"There was an emperor named Elagabalus that didn't really give a shit about what the people thought of him. He had all the fun and sex he wanted.\""
    m "\"Tinha um imperador chamado Heliogábalo que realmente cagava pra o que as pessoas pensavam dele. Ele tinha toda a diversão e sexo que queria.\""

# game/a1s3.rpy:1105
translate pt_br a1s3_c8caa8fc:

    # a "\"Oh?\""
    a "\"É?\""

# game/a1s3.rpy:1106
translate pt_br a1s3_38e17d1f:

    # "Amicus sounds amused."
    "Amicus parece entretido."

# game/a1s3.rpy:1107
translate pt_br a1s3_414a9227:

    # "Then I wince, remembering that no one really liked Elagabalus and he was killed along with his male lover, then his beheaded body was dragged through the streets of Rome..."
    "Então eu morro por dentro um pouco ao me lembrar que ninguém realmente gostava de Heliogábalo e que ele foi morto junto com o seu parceiro sexual, depois seu corpo decapitado foi arrastado pelas ruas de Roma..."

# game/a1s3.rpy:1108
translate pt_br a1s3_2d896667:

    # m "\"Well...I think balance is a good thing to have in life. Be serious when you need to be, have fun when you can.\""
    m "\"Acho que equilíbrio é uma boa coisa a se cultivar na vida. Seja sério quando precisar, se divirta quando puder.\""

# game/a1s3.rpy:1109
translate pt_br a1s3_4bfc8e95:

    # "Amicus just grunts again and I go on rubbing for a while longer."
    "Amicus grunhe de novo e eu massageio por mais um tempo."

# game/a1s3.rpy:1111
translate pt_br a1s3_92e768ab:

    # a "\"Oh! So while I was at my studies I had some time in the library to myself.\""
    a "\"Ah! Então, enquanto eu estava nos meus estudos eu tirei um tempo para ir à biblioteca.\""

# game/a1s3.rpy:1113
translate pt_br a1s3_3302ded6:

    # a "\"I found this primate species in the...general vicinity of your star.\""
    a "\"E eu encontrei uma espécie primata na... vizinhança da sua estrela.\""

# game/a1s3.rpy:1114
translate pt_br a1s3_05631a1a:

    # a "\"They were part of a failed uplift and look generally similar to you. A lot hairier, but I don't think anyone will notice.\""
    a "\"Eles fizeram parte de uma elevação falha e parecem com você no geral. Muito mais peludos, mas eu não acho que alguém vai notar.\""

# game/a1s3.rpy:1115
translate pt_br a1s3_b0d23cf0:

    # a "\"The name they have for themselves isn't pronounceable by us, but we named them the {i}Simanians{/i}, so if anyone asks you what you are, tell them that.\""
    a "\"O nome que eles deram a si mesmos não é pronunciável por nós, mas nós os nomeamos {i}símios{/i}, então, se qualquer pessoa perguntar o que você é, diga isso a ela.\""

# game/a1s3.rpy:1116
translate pt_br a1s3_ac7e79cb:

    # m "\"Oh, okay.\""
    m "\"Ah, ok.\""

# game/a1s3.rpy:1117
translate pt_br a1s3_232fa72d:

    # "I repeat the word in my head, trying to memorize it."
    "Eu repito a palavra na minha cabeça, tentando memorizá-la."

# game/a1s3.rpy:1119
translate pt_br a1s3_c01e0238:

    # a "\"Also...I would recommend avoiding that Khemian. I didn't like the looks of him.\""
    a "\"Também... eu recomendaria evitar aquele khemiano. Não fui com a cara dele.\""

# game/a1s3.rpy:1120
translate pt_br a1s3_2558be92:

    # m "\"Why not?\""
    m "\"Por que não?\""

# game/a1s3.rpy:1121
translate pt_br a1s3_e79a60ab:

    # a "\"I don't know, but his demeanor was rather rude. I've heard they are an arrogant people, but to see it in person...\""
    a "\"Eu não sei, mas o comportamento dele foi um pouco rude. Eu ouvi falar que eles são um povo arrogante, mas ver com os meus próprios olhos...\""

# game/a1s3.rpy:1122
translate pt_br a1s3_f5568cd1:

    # "I almost laugh at the hypocrisy of that statement."
    "Eu quase solto uma gargalhada com a hipocrisia dessa frase."

# game/a1s3.rpy:1123
translate pt_br a1s3_d2b8fab3:

    # "I'd point it out if Amicus wasn't being so grumpy right now."
    "Eu mencionaria isso se o Amicus não estivesse de mau humor agora."

# game/a1s3.rpy:1124
translate pt_br a1s3_c777a4c4:

    # a "\"And the way he looked at you didn't sit well with me. Just be sure you watch out for him.\""
    a "\"E a forma como ele olhou para você não me pareceu normal. Só tenha certeza de ter cuidado com ele.\""

# game/a1s3.rpy:1125
translate pt_br a1s3_3c66ec5c:

    # "I didn't really see much of a difference bewteen Neferu and the wolves aside from appearance, but Amicus seems genuinely concerned."
    "Eu realmente não vi muita diferença entre o Neferu e os outros lobos a não ser pela aparência, mas Amicus parece genuinamente preocupado."

# game/a1s3.rpy:1126
translate pt_br a1s3_6f19d038_1:

    # m "\"Alright.\""
    m "\"Tudo bem.\""

# game/a1s3.rpy:1128
translate pt_br a1s3_be4fc48b:

    # "Amicus grunts in response and I go on rubbing for a little while longer."
    "Amicus grunhe em resposta e eu continuo massageando por mais alguns instantes."

# game/a1s3.rpy:1130
translate pt_br a1s3_39d6f820:

    # "Then Amicus rolls over."
    "Então ele se vira."

# game/a1s3.rpy:1131
translate pt_br a1s3_17799653:

    # "I pause."
    "Eu paro."

# game/a1s3.rpy:1132
translate pt_br a1s3_511a7243:

    # m "\"Um...\""
    m "\"Hã...\""

# game/a1s3.rpy:1133
translate pt_br a1s3_872229c1:

    # "Amicus suddenly opens his eyes, as if realizing what he's doing."
    "Amicus abre os olhos de repente, como se estivesse percebendo o que acabou de fazer."

# game/a1s3.rpy:1135
translate pt_br a1s3_ed2bac03:

    # a "\"Oh! Er...\""
    a "\"Ah! É...\""

# game/a1s3.rpy:1136
translate pt_br a1s3_ce2a4a7c:

    # m "\"Do I...do your front too?\""
    m "\"Você... você quer que eu massageie na frente também?\""

# game/a1s3.rpy:1137
translate pt_br a1s3_a4af12ec:

    # a "\"Well...often after I get my massage, my drone rubs me. It helps me fall asleep for my afternoon naps.\""
    a "\"Bem... frequentemente depois que eu recebo minha massagem, meu drone me esfrega. Me ajuda a pegar no sono para as minhas sonecas da tarde.\""

# game/a1s3.rpy:1138
translate pt_br a1s3_4a0e706d:

    # m "\"Rubs you where?\""
    m "\"Te esfrega onde?\""

# game/a1s3.rpy:1139
translate pt_br a1s3_3a20dfd9:

    # "Amicus's ears turn bright red."
    "As orelhas do Amicus ficam bastante vermelhas."

# game/a1s3.rpy:1140
translate pt_br a1s3_163eb697:

    # a "\"My...my belly.\""
    a "\"Na... na minha barriga.\""

# game/a1s3.rpy:1141
translate pt_br a1s3_e33f02ef_3:

    # "I laugh."
    "Eu começo a rir."

# game/a1s3.rpy:1143
translate pt_br a1s3_7927aacc:

    # a "\"Don't laugh! You're the one that wanted to know.\""
    a "\"Não ria! Você foi quem quis saber.\""

# game/a1s3.rpy:1144
translate pt_br a1s3_0a04ef9c:

    # "I hesitate, and then almost automatically, my hand reaches out and starts to rub."
    "Eu hesito, então, quase que automaticamente, minha mão alcança a barriga dele e começa a esfregar."

# game/a1s3.rpy:1146
translate pt_br a1s3_88d0d125:

    # "Amicus is tense at first, then starts to relax, the blush in his ears receding."
    "Amicus fica tenso no começo, mas depois começa a relaxar, a cor nas suas orelhas se dissipando."

# game/a1s3.rpy:1147
translate pt_br a1s3_9a21a419:

    # m "\"You're such a canine.\""
    m "\"Você é tão canino.\""

# game/a1s3.rpy:1149
translate pt_br a1s3_7b7bc8ca:

    # a "\"I am a canine.\""
    a "\"Eu sou um canino.\""

# game/a1s3.rpy:1151
translate pt_br a1s3_f0a3e485:

    # "The fur, fluffy and disheveled from the shower, smooths down against the wolf's thick stomach, his belly rising and falling against my hand."
    "O pelo, estufado e desgrenhado do banho, suaviza contra o denso estômago do lobo, sua barriga levantando e caindo contra minha mão."

# game/a1s3.rpy:1152
translate pt_br a1s3_de3be73b:

    # "In his relaxed state, his stomach is soft under the fur, and I press down a bit more firmly to really rub at it."
    "Quando relaxado, o estômago é macio sob o pelo e eu pressiono um pouco mais firmemente para realmente esfregar nele."

# game/a1s3.rpy:1153
translate pt_br a1s3_fc1a784e:

    # "Amicus grunts and winces a bit."
    "Amicus grunhe e treme um pouco."

# game/a1s3.rpy:1154
translate pt_br a1s3_7621d92c:

    # m "\"Too hard?\""
    m "\"Muito forte?\""

# game/a1s3.rpy:1155
translate pt_br a1s3_f0b82ba4:

    # a "\"Just sore, but keep going; it feels good.\""
    a "\"Só dolorido, mas pode continuar; é uma sensação boa.\""

# game/a1s3.rpy:1156
translate pt_br a1s3_481a208b:

    # "As I continue to rub, his eyes close and his muzzle parts slightly."
    "Conforme continuo a esfregar, seus olhos se fecham e sua boca abre levemente."

# game/a1s3.rpy:1157
translate pt_br a1s3_138016c8:

    # m "\"Soooo...the trials start soon, at the end of this month, I guess?\""
    m "\"Entããão...os julgamentos começam em breve, no final do mês, né?\""

# game/a1s3.rpy:1158
translate pt_br a1s3_4eb44ffd:

    # a "\"...Yes.\""
    a "\"(...) sim.\""

# game/a1s3.rpy:1159
translate pt_br a1s3_5e42ba62:

    # m "\"And I'm involved in it somehow?\""
    m "\"E eu vou estar envolvido neles de alguma forma?\""

# game/a1s3.rpy:1160
translate pt_br a1s3_ff59f998:

    # a "\"Mmmmh...\""
    a "\"Mmmmh...\""

# game/a1s3.rpy:1161
translate pt_br a1s3_da75757c:

    # m "\"Wanna talk about it later?\""
    m "\"Quer falar sobre isso depois?\""

# game/a1s3.rpy:1162
translate pt_br a1s3_8e3323ca:

    # a "\"Mmh.\""
    a "\"Mmh.\""

# game/a1s3.rpy:1163
translate pt_br a1s3_9cea7ff8:

    # "Now that I'm thinking about it, I'm getting a bit nervous."
    "Agora que pensei nisso, estou ficando um pouco nervoso."

# game/a1s3.rpy:1164
translate pt_br a1s3_abd25d4b:

    # "But Amicus doesn't seem to be worried, and that puts me at ease, at least a little bit."
    "Mas o Amicus não parece preocupado, então isso me deixa mais calmo, um pouco, pelo menos."

# game/a1s3.rpy:1165
translate pt_br a1s3_3341b434:

    # "That's when I notice the particular bulge in Amicus's undergarments, the one I'd noticed when I'd brushed him yesterday."
    "E é aí que eu noto a particular protuberância na tanga do Amicus, aquela que eu notei ontem depois de escovar ele."

# game/a1s3.rpy:1166
translate pt_br a1s3_645e4ea6:

    # "I'm not surprised this time, though."
    "Mas não estou surpreso dessa vez."

# game/a1s3.rpy:1167
translate pt_br a1s3_865525cb:

    # "If brushing had done it to him, rubbing definitely would too."
    "Se a escovação causou isso nele, esfregar com certeza também causaria."

# game/a1s3.rpy:1168
translate pt_br a1s3_568d8688:

    # "So I ignore it and so does Amicus, or maybe he's just asleep."
    "Então eu só ignoro, assim como o Amicus, ou vai ver ele só dormiu."

# game/a1s3.rpy:1169
translate pt_br a1s3_ff7c2a12:

    # "I realize then just how much I've accepted my life here, rubbing this prospective emperor wolf's belly, even though I know it's making him hard."
    "Eu percebo então o quanto que eu aceitei a minha vida aqui, esfregando a barriga desse potencial imperador lobo, mesmo sabendo que isso causa uma ereção nele."

# game/a1s3.rpy:1170
translate pt_br a1s3_dca415aa:

    # "But I also realize that I don't really mind it."
    "Mas eu também percebo que eu realmente não me importo."

# game/a1s3.rpy:1172
translate pt_br a1s3_b537565d:

    # "It's only been a few days, but there's something about this wolf..."
    "Só se passaram alguns dias, mas tem alguma coisa sobre esse lobo..."

# game/a1s3.rpy:1173
translate pt_br a1s3_814740fe:

    # "I don't know, I just like him."
    "Não sei, eu só gosto dele."

# game/a1s3.rpy:1174
translate pt_br a1s3_f43c02f1:

    # "Amicus starts to snore, so I slowly stop rubbing, watching his chest rise and fall with his steady breaths."
    "Amicus começa a roncar, então eu lentamente paro de esfregar, observando seu peito subir e descer com sua respiração regular."

# game/a1s3.rpy:1175
translate pt_br a1s3_5928aaed:

    # "I think about going back over to the sofa, but instead I just roll over to Amicus's left, curling up on my side in the soft pillows."
    "Eu penso em voltar para o sofá mas, em vez disso, só rolo até a esquerda do Amicus, me acomodando de lado nos travesseiros macios."

# game/a1s3.rpy:1176
translate pt_br a1s3_c5db41d8:

    # "With the relaxing sounds of Amicus's gentle snores behind me, I drift off into a light sleep."
    "Com os sons relaxantes dos suaves roncos do Amicus atrás de mim, eu caio em um sono leve."

translate pt_br strings:

    # game/a1s3.rpy:388
    old "When in Rome..."
    new "Há um tempo, em Roma..."

    # game/a1s3.rpy:388
    old "Don't look."
    new "Não olhar."
