# TODO: Translation updated at 2021-07-13 23:51

# game/end_game2.rpy:2
translate pt_br end_game2_2467797a:

    # "All this talk of Drusus, of his and [mc]'s apparently fixed destinies."
    "Toda essa conversa sobre Drusus, sobre os destinos aparentemente fixos, tanto o seu quanto o de [mc]."

# game/end_game2.rpy:3
translate pt_br end_game2_a8e38200:

    # "That decision that wolves fawned over for generations, no matter what opinion they held about Drusus himself."
    "Aquela decisão que os lobos adiaram por gerações, não importando a opinião que eles tinham sobre o próprio Drusus."

# game/end_game2.rpy:4
translate pt_br end_game2_335bc4c2:

    # "The choice offered by the parents to either save his empire, or save his lover."
    "A escolha oferecida pelos progenitores de salvar seu império ou sua amante."

# game/end_game2.rpy:5
translate pt_br end_game2_1f4af96c:

    # "Icy, cold fear and dread blooms in the pit of Amicus's stomach and slowly spreads throughout the rest of his body, seeming to leak like a frigid liquid down his groin and into his legs."
    "Um pavor e um frio na barriga de Amicus surgem e lentamente se espalham pelo resto de seu corpo, parecendo vazar como um líquido gelado por dentro da virilha e pernas."

# game/end_game2.rpy:6
translate pt_br end_game2_e4fe1db4:

    # "The wolf feels his limbs tremble as he pulls the human closer to his chest, lips drawing back as instinct kicks in to protect his mate."
    "O lobo sente seus membros tremerem à medida que puxa o humano para mais perto de seu peito, os dentes à mostra enquanto um instinto entra em ação para proteger seu companheiro."

# game/end_game2.rpy:7
translate pt_br end_game2_1e7e6ce8:

    # "For a long while, a length of time that's hard to discern, the wolf simply stares into the abyss."
    "Por um longo momento, uma quantidade de tempo difícil de discernir, o lobo simplesmente encara o abismo."

# game/end_game2.rpy:8
translate pt_br end_game2_1539cf66:

    # "He looks up into the swirling stars, clouds, and planets, trying to see..."
    "Ele olha para as estrelas, nuvens e planetas rodopiantes, tentando enxergar..."

# game/end_game2.rpy:9
translate pt_br end_game2_4087f70d:

    # "...trying to see these things that are controlling and manipulating him and his lover."
    "(...) tentando enxergar as coisas que estão controlando e manipulando ele e seu amante."

# game/end_game2.rpy:10
translate pt_br end_game2_a35df207:

    # "Trembling, Amicus shakes his head, taking another step back, away, even though the presence of the parents is all-encompassing."
    "Tremendo, Amicus balança sua cabeça, dando outro passo para trás, embora a presença dos progenitores seja abrangente, como se estivesse cercado por eles."

# game/end_game2.rpy:11
translate pt_br end_game2_f767c1d6:

    # a "\"N—no...\""
    a "\"N—não...\""

# game/end_game2.rpy:12
translate pt_br end_game2_8aa97d67:

    # "Amicus's jaw clenches, hating himself for sounding so weak and afraid."
    "Amicus aperta a mandíbula, odiando a si mesmo por soar tão fraco e medroso."

# game/end_game2.rpy:13
translate pt_br end_game2_eca45a64:

    # "Remembering who he is, the wolf squares his shoulders, glaring up into space."
    "Lembrando quem é, o lobo endireita os ombros, encarando o espaço."

# game/end_game2.rpy:14
translate pt_br end_game2_905e84c5:

    # a "\"No! I won't make such a decision!\""
    a "\"Não! Eu não vou tomar essa decisão!\""

# game/end_game2.rpy:15
translate pt_br end_game2_06583084:

    # "For once, the unseen place in which the parents reside is silent, but clearly observant; Amicus can feel the prickle of their all-seeing eyes on the nape of his neck."
    "Pela primeira vez, o lugar invisível o qual os progenitores residem mantém-se silencioso, mas claramente em estado de observação; Amicus pode sentir o formigamento de seus olhos que tudo veem no topo de sua nuca."

# game/end_game2.rpy:16
translate pt_br end_game2_d5f69205:

    # a "\"Y—you hear me!? I won't do it! I'll...I'll stay here forever if I have to! You can't involve us in this foolishness!\""
    a "\"E—Estão me ouvindo!? Eu não vou fazer isso! Eu... eu vou ficar aqui para sempre se for necessário! Vocês não podem nos envolver nessa tolice!\""

# game/end_game2.rpy:17
translate pt_br end_game2_25051fcd:

    # "[mc] suddenly shifts in his grasp, his head turning awkwardly, leaning up in a strange way that seems unnatural, as if pulled up by strings."
    "[mc] repentinamente se mexe em seu aperto, sua cabeça girando desjeitosamente, inclinando-se de um jeito que não parece natural, como se estivesse sendo puxada por cordas."

# game/end_game2.rpy:18
translate pt_br end_game2_328ea982:

    # "Amicus flinches back, feeling a chill run up his spine as he tries to stop himself from dropping the human he knows so well."
    "Amicus se afasta, sentindo um calafrio percorrer sua coluna enquanto tenta se impedir de deixar cair o humano que conhece tão bem."

# game/end_game2.rpy:19
translate pt_br end_game2_a84279dd:

    # m "\"Foolishness?\""
    m "\"Tolice?\""

# game/end_game2.rpy:20
translate pt_br end_game2_fc310673:

    # "[mc] stares at him with an expression that Amicus has never seen him make before."
    "[mc] o encara com uma expressão que Amicus nunca o tinha visto fazer antes."

# game/end_game2.rpy:21
translate pt_br end_game2_e375dbbf:

    # "It's cold and almost dismissive, an expression Amicus has never seen him make before."
    "É fria e quase desdenhosa."

# game/end_game2.rpy:22
translate pt_br end_game2_ead3c94d:

    # m "\"How does this situation, in which the lives of a trillion sapients teeter on the brink of annihilation, call for such childish statements? Tell us, in what universe would attempts to avoid such a catastrophic outcome be considered 'foolishness'?\""
    m "\"Como esta situação, da qual a vida de um trilhão de sapientes oscila à beira da aniquilação, exige tais declarações infantis? Diga-nos, em que universo as tentativas de evitar um resultado tão catastrófico seriam consideradas \"tolice\".\""

# game/end_game2.rpy:23
translate pt_br end_game2_043dc8da:

    # "The human suddenly tilts his head in an unnatural way, leaning in closer to the wolf and Amicus gasps, setting a large paw against [mc]'s face, trying to stop the strange, {i}inhuman{/i} movements."
    "O humano de repente vira a cabeça de uma maneira antinatural, inclinando-se para mais perto do lobo e Amicus bufa, colocando uma pata contra o rosto de [mc], tentando parar os movimentos {i}desumanos{/i} estranhos."

# game/end_game2.rpy:24
translate pt_br end_game2_d7725d11:

    # a "\"S—stop that. Don't hurt him!\""
    a "\"P—parem com isso. Não machuquem ele!\""

# game/end_game2.rpy:25
translate pt_br end_game2_72c20b66:

    # "The human holds the position for a moment, then seems to slowly relax back into the wolf's arms."
    "O humano mantém a posição por um momento, depois parece lentamente relaxar de volta nos braços do lobo."

# game/end_game2.rpy:26
translate pt_br end_game2_a299c627:

    # "Amicus feels his heart pounding in his chest."
    "Amicus sente seu coração batendo forte no peito."

# game/end_game2.rpy:27
translate pt_br end_game2_07ada019:

    # "He'd provoked...well, not even anger from the parents, maybe just annoyance, yet the experience had been terrifying."
    "Ele provocou... bem, nem mesmo raiva dos progenitores, talvez apenas aborrecimento, ainda assim, a experiência foi aterrorizante."

# game/end_game2.rpy:28
translate pt_br end_game2_6ee7b42f:

    # "Seeing [mc] twist and contort in such a way was unnerving, sure, but the parents had meant to do it, and the wolf is beginning to realize why they're using [mc] as a puppet."
    "Ver [mc] se contorcer de tal forma foi desconcertante, claro, mas os progenitores tiveram a intenção de fazê-lo e o lobo começa a perceber por que eles estão usando [mc] como fantoche."

# game/end_game2.rpy:29
translate pt_br end_game2_eaf4e4bf:

    # "Anger and fear battle for control over the wolf, before the latter finally wins out, remembering what type of decision he might have to make."
    "A raiva e o medo lutam para controlar o lobo, até que o último finalmente vence, o lembrando que tipo de decisão ele pode ter que tomar."

# game/end_game2.rpy:30
translate pt_br end_game2_891462ed:

    # a "\"Please, there must be another way, I can't...I can't choose between these two things!\""
    a "\"Por favor, tem que ter outro jeito, eu não posso... não posso escolher entre essas duas coisas!\""

# game/end_game2.rpy:31
translate pt_br end_game2_27c9a9f1:

    # "There's a pause in the air, and Amicus feels his knees about to give out, preparing to throw himself at the imaginary feet of these monolithic beings."
    "Há uma pausa no ar e Amicus sente seus joelhos prestes a cederem, preparando para jogar-se aos pés imaginários destes seres monolíticos."

# game/end_game2.rpy:32
translate pt_br end_game2_53210fac:

    # "He'd beg until the end of time, wolven pride be damned."
    "Ele imploraria até o fim dos tempos, dane-se o orgulho dos lobos."

# game/end_game2.rpy:33
translate pt_br end_game2_e480c67c:

    # m "\"What decision do you speak of?\""
    m "\"De que decisão você está falando?\""

# game/end_game2.rpy:34
translate pt_br end_game2_517931dc:

    # "Amicus glances up again at the stars."
    "Amicus olha novamente para as estrelas."

# game/end_game2.rpy:35
translate pt_br end_game2_42b81a19:

    # a "\"The—The decision presented to Drusus...the one decided for him by Meera ten millennia ago.\""
    a "\"A—A escolha apresentada a Drusus... aquela que Meera decidiu por ele há dez milênios atrás.\""

# game/end_game2.rpy:36
translate pt_br end_game2_8341bc92:

    # "Amicus frowns, knowing that the parents already know what he's talking about, becoming further distressed that they're making him vocalize things that are so obvious."
    "Amicus franze a testa, tendo em mente que os progenitores já sabem do que ele está falando, ficando ainda mais angustiado por eles estarem fazendo ele vocalizar coisas tão óbvias."

# game/end_game2.rpy:37
translate pt_br end_game2_aa12a452:

    # m "\"Oh, Amicus. Don't you know the proclivity of your own people to twist and distort, to aggrandize and romanticize the truth?\""
    m "\"Ah, Amicus. Não conhece a tendência de seu próprio povo em distorcer e enviesar, em engrandecer e romantizar a verdade?\""

# game/end_game2.rpy:38
translate pt_br end_game2_561bfe3b:

    # "Amicus is quiet, waiting, heart still hammering, simply feeling numb at this point."
    "Amicus fica quieto, esperando, coração ainda martelando, sentindo-se entorpecido a essa altura."

# game/end_game2.rpy:39
translate pt_br end_game2_d0dedb23:

    # m "\"Do not rely on wolven myth to inform you of parental intention. Only We will speak the truth to you.\""
    m "\"Não dependa de um mito lobino para informar-se sobre as intenções dos progenitores. Apenas nós o contaremos a verdade.\""

# game/end_game2.rpy:40
translate pt_br end_game2_34ceec70:

    # "Amicus lets out a little growl, anger overcoming fear again."
    "Amicus solta um pequeno grunhido, a raiva superando o medo novamente."

# game/end_game2.rpy:41
translate pt_br end_game2_63312a87:

    # a "\"Then what is it? Why torment me like this?\""
    a "\"Então o que vocês querem? Por que me atormentar assim?\""

# game/end_game2.rpy:42
translate pt_br end_game2_8b4b8f0c:

    # "Several moments of silence pass and Amicus growls again, frustrated at the way he's being treated, how his emotions are being manipulated and sculpted like a mound of clay."
    "Vários momentos de silêncio se passam e Amicus rosna novamente, frustrado com a maneira como está sendo tratado, como suas emoções estão sendo manipuladas e esculpidas como um punhado de argila."

# game/end_game2.rpy:43
translate pt_br end_game2_13f5d1ba:

    # "This isn't what he'd been taught at all."
    "Não é isso o que lhe foi ensinado, não mesmo."

# game/end_game2.rpy:44
translate pt_br end_game2_5937582d:

    # "Had his father known the parents to be like this?"
    "Seu pai sabia que os progenitores eram assim?"

# game/end_game2.rpy:45
translate pt_br end_game2_ee14762e:

    # "His grandfather?"
    "Seu avô?"

# game/end_game2.rpy:46
translate pt_br end_game2_2629d638:

    # "Amicus wishes that he'd been warned, somehow."
    "Amicus queria ter sido avisado de alguma maneira."

# game/end_game2.rpy:47
translate pt_br end_game2_1b04cf2f:

    # "As the silence drags on, the wolf tries to deaden his emotions, to not give these entities any sort of hint as to what he might be feeling, wanting to refuse this blatant attack on his own agency."
    "À medida que o silêncio se arrasta, o lobo tenta amortecer suas emoções para não dar a estas entidades qualquer espécie de dica sobre o que ele pode estar sentindo, querendo recusar este ataque flagrante à sua própria maneira de agir."

# game/end_game2.rpy:48
translate pt_br end_game2_9e280ab2:

    # "Despite how futile he knows that must be."
    "Apesar de quão fútil ele sabe que isso deve ser."

# game/end_game2.rpy:49
translate pt_br end_game2_6a1b2344:

    # m "\"You can bring back your lover. At this very moment time stands nearly still on your plane. [mc]'s body and mind are still salvageable.\""
    m "\"Você pode trazer de volta seu amante. Neste exato momento, o tempo está quase parado em seu plano de existência. O corpo e a mente de [mc] ainda podem ser salvos.\""

# game/end_game2.rpy:50
translate pt_br end_game2_f332a517:

    # "Amicus's heart feels as though it might leap from his mouth, his hold on [mc] tightening."
    "Amicus sente como se seu coração fosse pular da boca, seu abraço em [mc] apertando."

# game/end_game2.rpy:51
translate pt_br end_game2_c4a19054:

    # a "\"How—\""
    a "\"Como—\""

# game/end_game2.rpy:52
translate pt_br end_game2_016a1b5c:

    # m "\"But only if you submit yourself to the benevolent will of the parents...\""
    m "\"Mas somente caso você se submeta à vontade benevolente dos progenitores...\""

# game/end_game2.rpy:53
translate pt_br end_game2_a20cefa7:

    # "..."
    "..."

# game/end_game2.rpy:54
translate pt_br end_game2_8c4b036f:

    # m "\"Will you?\""
    m "\"Você se submete?\""

# game/end_game2.rpy:55
translate pt_br end_game2_5225d3d2:

    # "Amicus furrows his brow in confusion, unsure of what this all could mean."
    "Amicus franze a testa, confuso, sem saber o que tudo isso poderia significar."

# game/end_game2.rpy:56
translate pt_br end_game2_fd8888da:

    # a "\"But...I've already done so, ever since I was a pup we've been told to—\""
    a "\"Mas... eu já fiz isso, desde que eu era um filhote, nos disseram para—\""

# game/end_game2.rpy:57
translate pt_br end_game2_02d144ef:

    # m "\"After this experience your mind will waver. You're unsure as to what our intentions truly are. There will be moments in which you will want to question, to doubt our will...\""
    m "\"Após essa experiência, sua mente hesitará. Você está inseguro sobre quais são realmente nossas intenções. Haverá momentos em que você vai querer questionar, duvidar de nossa vontade...\""

# game/end_game2.rpy:58
translate pt_br end_game2_6c89b81e:

    # m "\"You must overcome such moments. Our will is what is best for the {i}Galaxias{/i} and the universe as a whole.\""
    m "\"Você deve superar tais momentos. Nossa vontade é o que há de melhor para a {i}congregação galáctica{/i} e o universo como um todo.\""

# game/end_game2.rpy:59
translate pt_br end_game2_9c07d739:

    # "Amicus stares for a moment."
    "Amicus encara por um momento."

# game/end_game2.rpy:60
translate pt_br end_game2_b815baed:

    # a "\"And if I don't agree?\""
    a "\"E se eu não concordar?\""

# game/end_game2.rpy:61
translate pt_br end_game2_1d2d8418:

    # m "\"Then we shall let the human pass on as he naturally should, and we shall wait for a future emperor to take your place.\""
    m "\"Então deixaremos o humano ir como naturalmente deveria e esperaremos que um futuro imperador tome seu lugar.\""

# game/end_game2.rpy:62
translate pt_br end_game2_5f8f905b:

    # "Amicus shakes his head, not wanting to believe this is true, that this is the way that the leaders of the {i}Galaxias{/i} function."
    "Amicus balança a cabeça, não querendo acreditar que isso é verdade, que é assim que os líderes da {i}congregação galáctica{/i} agem."

# game/end_game2.rpy:63
translate pt_br end_game2_1d9bfc12:

    # m "\"It must be done.\""
    m "\"Deve acontecer assim.\""

# game/end_game2.rpy:64
translate pt_br end_game2_27015f58:

    # "The wolf is quiet, for once wishing that he isn't in such a position, wishing that he could hide away in the quiet countryside with his human, to live a normal life..."
    "O lobo fica quieto, pela primeira vez desejando não estar em tal posição, desejando poder se esconder em uma zona rural tranquila com seu humano, para viver uma vida normal..."

# game/end_game2.rpy:65
translate pt_br end_game2_9b523202:

    # m "\"That is not your calling. It never was.\""
    m "\"Este não é o seu chamado. Jamais foi.\""

# game/end_game2.rpy:66
translate pt_br end_game2_f27c8d9c:

    # a "\"I know.\""
    a "\"Eu sei.\""

# game/end_game2.rpy:67
translate pt_br end_game2_5c77094a:

    # "Amicus whispers, more to himself than the parents."
    "Amicus sussurra, mais para si mesmo que para os progenitores."

# game/end_game2.rpy:69
translate pt_br end_game2_3fd21820:

    # "There's a long moment of silence in which Amicus simply stares into space, contemplating what it means to give up any true freedom, to submit himself to the absolute authority of the galaxy."
    "Há um longo momento de silêncio em que Amicus simplesmente encara as profundezas do espaço, ponderando sobre o que significa renunciar qualquer lívre arbítrio, submeter-se à absoluta autoridade da galáxia."

# game/end_game2.rpy:70
translate pt_br end_game2_92277ed2:

    # m "\"Will you submit?\""
    m "\"Você se submete?\""

# game/end_game2.rpy:71
translate pt_br end_game2_ce194e6b:

    # "Amicus takes a deep breath."
    "Amicus respira bem fundo."

# game/end_game2.rpy:72
translate pt_br end_game2_ffa29b58:

    # a "\"Will...will my decision affect [mc]'s free will? You said you have plans for him as well.\""
    a "\"A... a minha decisão afetará o livre arbítrio do [mc]? Vocês disseram que têm planos para ele também.\""

# game/end_game2.rpy:73
translate pt_br end_game2_f5abd5c4:

    # m "\"He will be allowed to make his own decision. We will tell you of his mission once you make {i}your{/i} decision.\""
    m "\"Ele poderá tomar a própria decisão. O falaremos sobre a missão dele assim que você tomar {i}sua{/i} decisão.\""

# game/end_game2.rpy:74
translate pt_br end_game2_e5353eb2:

    # "Amicus stifles another growl, hating that his human is being forced into this as well."
    "Amicus reprime outro rosnado, odiando que seu humano esteja sendo forçado a fazer isso também."

# game/end_game2.rpy:75
translate pt_br end_game2_92277ed2_1:

    # m "\"Will you submit?\""
    m "\"Você se submete?\""

# game/end_game2.rpy:76
translate pt_br end_game2_0f59256a:

    # "Amicus closes his eyes, feeling his anger and resilience slowly drain away."
    "Amicus fecha os olhos, sentindo sua raiva e resiliência desaparecerem lentamente."

# game/end_game2.rpy:77
translate pt_br end_game2_a3246673:

    # "Then he opens them."
    "Então ele os abre."

# game/end_game2.rpy:78
translate pt_br end_game2_b580cbaa:

    # a "\"I submit.\""
    a "\"Eu me submeto.\""

# game/end_game2.rpy:82
translate pt_br end_game2_d86a984c:

    # "Blue light swirls in front of my eyes in intricate, spiraling tendrils."
    "Luz azul rodopia em frente aos meus olhos em redemoinhos e espirais."

# game/end_game2.rpy:83
translate pt_br end_game2_149b8d27:

    # "It's beautiful, and as I begin to focus, I see a blurry, gray shape in the middle of it all."
    "É lindo, e assim que começo a focar, enxergo uma forma cinza embaçada no meio de tudo."

# game/end_game2.rpy:84
translate pt_br end_game2_21acfdb7:

    # "Even before I'm fully able to see him, I know it's my wolf."
    "Mesmo antes de conseguir enxergar por completo, já sei que é meu lobo."

# game/end_game2.rpy:85
translate pt_br end_game2_2842c249:

    # "I smile and reach up, cupping at the warm, furry form."
    "Eu sorrio e estendo a mão, segurando a forma quente e peluda."

# game/end_game2.rpy:86
translate pt_br end_game2_9142b0c2:

    # "At some point along this little journey, I've stopped caring about whether the things I see are real or not."
    "Em algum momento dessa pequena jornada eu parei de me importar se as coisas que vejo são reais ou não."

# game/end_game2.rpy:87
translate pt_br end_game2_20ca0388:

    # "I'm just happy that I'm seeing him."
    "Eu só estou feliz por estar vendo ele."

# game/end_game2.rpy:88
translate pt_br end_game2_29d00675:

    # "He smiles down at me."
    "Ele sorri de volta para mim."

# game/end_game2.rpy:91
translate pt_br end_game2_4b87ac29:

    # a "\"Hey.\""
    a "\"Oi.\""

# game/end_game2.rpy:92
translate pt_br end_game2_568a6418:

    # m "\"...Hey.\""
    m "\"Oi.\""

# game/end_game2.rpy:93
translate pt_br end_game2_03866667:

    # "I lie quietly in his arms for a while, just enjoying the comforting, blue glow."
    "Eu fico deitado em seus braços sem falar nada por um tempo, apenas curtindo o brilho azul reconfortante."

# game/end_game2.rpy:94
translate pt_br end_game2_af0313a4:

    # "I'm reminded of when I first met Amicus, when our ship stalled out in the blue dust cloud, when he'd finally revealed to me his botched plan."
    "Me lembro de quando conheci o Amicus, quando nossa nave ficou presa na nuvem de poeira azul, quando ele finalmente me revelou seu plano fracassado."

# game/end_game2.rpy:95
translate pt_br end_game2_718880a5:

    # "That feels so distant now, like it was years ago, rather than just months."
    "Isso parece tão distante agora, como se tivesse acontecido há anos, em vez de alguns meses."

# game/end_game2.rpy:96
translate pt_br end_game2_2acfa737:

    # "I take a deep breath, and something about it feels strange, almost like something mechanical is moving in my neck."
    "Eu respiro bem fundo, e algo sobre isso parece estranho, quase como se algo mecânico estivesse movendo em meu pescoço."

# game/end_game2.rpy:97
translate pt_br end_game2_f5ca74ae:

    # "I reach up, touching my fingers to my throat, and for a moment they brush against something that feels like a thin line of flesh."
    "Eu alcanço o local, tocando minha garganta. Por um momento, meus dedos roçam em algo que parece uma fina camada de tecido vivo."

# game/end_game2.rpy:98
translate pt_br end_game2_f296fa8a:

    # "But Amicus reaches down to move my hand away, pressing it to my chest instead."
    "Mas Amicus alcança para afastar minha mão do local, pressionando-a no meu peito em vez disso."

# game/end_game2.rpy:99
translate pt_br end_game2_a9ff0949:

    # a "\"You're alright. You're gonna be fine now.\""
    a "\"Você está bem. Vai ficar bem agora.\""

# game/end_game2.rpy:100
translate pt_br end_game2_cc5a0746:

    # m "\"What...\""
    m "\"O que...\""

# game/end_game2.rpy:101
translate pt_br end_game2_7607027c:

    # "That's when I also realize that my voice sounds strange."
    "É quando eu também percebo que minha voz soa estranha."

# game/end_game2.rpy:102
translate pt_br end_game2_d712c9e5:

    # "It still sounds like me, but there's something slightly off about it, like it's a little higher, maybe even just a little robotic."
    "Ainda parece eu, mas há algo levemente estranho, como se estivesse um pouco mais alta, talvez até um pouco robótica."

# game/end_game2.rpy:103
translate pt_br end_game2_e499761a:

    # "I frown."
    "Eu arqueio as sobrancelhas."

# game/end_game2.rpy:104
translate pt_br end_game2_1a78d38c:

    # "Amicus presses against my chest firmly, comfortingly."
    "Amicus pressiona contra meu peito com firmeza, confortavelmente."

# game/end_game2.rpy:106
translate pt_br end_game2_1983067b:

    # a "\"It's okay, I know it might feel a bit strange, but you won't even notice it after a few days.\""
    a "\"Tudo bem, eu sei que pode parecer um pouco estranho, mas você nem vai notar depois de alguns dias.\""

# game/end_game2.rpy:107
translate pt_br end_game2_f1e1cb15:

    # "What is he talking about?"
    "Do que ele está falando?"

# game/end_game2.rpy:108
translate pt_br end_game2_ddf54f3a:

    # "Again, I lay quietly in his arms as I gather my thoughts."
    "Mais uma vez, fico em silêncio enquanto reúno meus pensamentos, deitado em seus braços."

# game/end_game2.rpy:109
translate pt_br end_game2_a7a17747:

    # "The fight, the dagger, the darkness, the parents, then..."
    "A luta, a adaga, a escuridão, os progenitores, e então..."

# game/end_game2.rpy:110
translate pt_br end_game2_3a90705a:

    # "I look up at Amicus in question."
    "Eu olho para o Amicus em questionamento."

# game/end_game2.rpy:111
translate pt_br end_game2_6a322264:

    # m "\"What...what happened?\""
    m "\"O que... o que aconteceu?\""

# game/end_game2.rpy:112
translate pt_br end_game2_9629233f:

    # "I try to ignore the strange, soundless, mechanical clicking feeling in my throat, while also trying to get used to my voice."
    "Eu tento ignorar a sensação estranha, silenciosa e mecânica de cliques em minha garganta conforme também tento me acostumar com minha voz."

# game/end_game2.rpy:113
translate pt_br end_game2_1cf02a06:

    # "It's like hearing myself in a recording; just not quite right."
    "É como me ouvir em uma gravação; simplesmente não parece certo."

# game/end_game2.rpy:115
translate pt_br end_game2_f4566769:

    # "Amicus chuckles, sounding exhausted, relieved, and maybe even a little sad at the same time."
    "Amicus ri, parecendo exausto, aliviado e talvez até um pouco triste ao mesmo tempo."

# game/end_game2.rpy:117
translate pt_br end_game2_77478e3c:

    # a "\"Quite a bit happened, [mc].\""
    a "\"Muita coisa aconteceu, [mc].\""

# game/end_game2.rpy:118
translate pt_br end_game2_22894267:

    # m "\"But the parents. I thought they wanted us to meet them?\""
    m "\"Mas os progenitores. Achei que eles queriam que a gente se encontrasse com eles?\""

# game/end_game2.rpy:119
translate pt_br end_game2_8281fee3:

    # "Amicus's gentle smile wavers for a moment."
    "O sorriso gentil do Amicus vacila por um momento."

# game/end_game2.rpy:121
translate pt_br end_game2_25b74959:

    # a "\"Well...they did. I met them.\""
    a "\"Bem... eles fizeram isso. Eu os conheci.\""

# game/end_game2.rpy:122
translate pt_br end_game2_dec0fd59:

    # m "\"What? I don't remember...\""
    m "\"O que? Eu não me lembro...\""

# game/end_game2.rpy:123
translate pt_br end_game2_82e82f92:

    # "I rack my memory, but nothing comes to mind."
    "Eu vasculho minha memória, mas nada me vem à mente."

# game/end_game2.rpy:124
translate pt_br end_game2_a38ca5d4:

    # a "\"You, uh, you lost consciousness when it happened.\""
    a "\"Você, hã... perdeu a consciência quando aconteceu.\""

# game/end_game2.rpy:125
translate pt_br end_game2_c848da58:

    # "I frown at that, wondering why that would happen, but Amicus doesn't offer an explanation."
    "Eu levanto uma sobrancelha, me perguntando por que isso aconteceria, mas Amicus não me oferece uma explicação."

# game/end_game2.rpy:126
translate pt_br end_game2_9ec8853f:

    # "I look down at my chest, and instead of the coating of blood I expect to see, I'm clean and bare, aside from a few, small wet spots on my chest."
    "Olho para baixo e em vez da camada de sangue que esperava ver, me encontro limpo, com exceção de algumas pequenas regiões úmidas em meu peito."

# game/end_game2.rpy:127
translate pt_br end_game2_c5cf3b2b:

    # "I suppose Amicus had been a bit more emotional before I'd woken up."
    "Suponho que o Amicus tenha ficado um pouco mais emocional antes de eu acordar."

# game/end_game2.rpy:128
translate pt_br end_game2_52e9ad1f:

    # "I look back at him, then press my face against his body, and he responds by hugging me close to his chest for a moment."
    "Eu olho de volta para ele, depois pressiono meu rosto contra seu corpo e ele responde me abraçando mais perto de seu peito por um momento."

# game/end_game2.rpy:130
translate pt_br end_game2_5e7c3f80:

    # m "\"So it's over? They decided to bring me back?\""
    m "\"Então acabou? Eles decidiram me trazer de volta?\""

# game/end_game2.rpy:131
translate pt_br end_game2_56b22d0a:

    # "My voice is muffled against his fur."
    "Minha voz é abafada contra seu pelo."

# game/end_game2.rpy:132
translate pt_br end_game2_1056e810:

    # "My strange, not-quite-right voice."
    "Minha estranha e não exatamente correta voz."

# game/end_game2.rpy:133
translate pt_br end_game2_0e4c4746:

    # "Amicus loosens his hold on me, allowing me to look back up at his face."
    "Amicus afrouxa seu aperto, permitindo que eu olhe de volta para seu rosto."

# game/end_game2.rpy:135
translate pt_br end_game2_3a8de6fd:

    # a "\"Yes. It's over.\""
    a "\"Sim. Acabou.\""

# game/end_game2.rpy:136
translate pt_br end_game2_5f711d93:

    # "The tension that I'd held in my chest ever since I arrived, ever since being abducted from my bedroom in Italy, it all releases slowly."
    "A tensão que eu carregava em meu peito desde que cheguei, desde que fui sequestrado do meu quarto na Itália, tudo desaparece lentamente."

# game/end_game2.rpy:137
translate pt_br end_game2_6370b32e:

    # "For once, I feel light and free, and I sag in the wolf's arms, sighing deeply."
    "Pela primeira vez, me sinto leve e livre e me afundo nos braços do lobo, suspirando profundamente."

# game/end_game2.rpy:138
translate pt_br end_game2_38f7a6c4:

    # "Even now, I'm starting to get used to the new feelings in my throat."
    "Mesmo agora, estou começando a me acostumar com as novas sensações em minha garganta."

# game/end_game2.rpy:140
translate pt_br end_game2_891ef0b0:

    # a "\"I love you.\""
    a "\"Eu te amo.\""

# game/end_game2.rpy:141
translate pt_br end_game2_58124b9d:

    # m "\"I love you, too.\""
    m "\"Eu também te amo.\""

# game/end_game2.rpy:142
translate pt_br end_game2_13eb866a:

    # "I smile up at him, and despite everything being over, I can't help but notice that he seems a bit sad, too."
    "Eu sorrio para ele, e apesar de tudo já ter acabado, não posso deixar de notar que ele também parece um pouco triste."

# game/end_game2.rpy:143
translate pt_br end_game2_f7872598:

    # "I rest a hand against his chest."
    "Eu repouso uma mão contra seu peito."

# game/end_game2.rpy:144
translate pt_br end_game2_702cfbe4:

    # m "\"You alright?\""
    m "\"Você tá bem?\""

# game/end_game2.rpy:146
translate pt_br end_game2_459ce3ce:

    # "Amicus laughs loudly, shaking my entire body."
    "Amicus ri alto, sacudindo meu corpo inteiro."

# game/end_game2.rpy:147
translate pt_br end_game2_61356971:

    # a "\"Aside from nearly losing everything I hold dear, I suppose I'm alright, yes.\""
    a "\"Tirando o fato de quase ter perdido tudo o que mais amava, acho que estou bem sim.\""

# game/end_game2.rpy:148
translate pt_br end_game2_d8fe3f13:

    # "I try to sit up, but Amicus keeps me reclined gently, but firmly."
    "Eu tento me sentar, mas Amicus me mantém reclinado gentilmente, porém com firmeza."

# game/end_game2.rpy:149
translate pt_br end_game2_b466649c:

    # m "\"You sure? You seem upset.\""
    m "\"Tem certeza? Você parece chateado.\""

# game/end_game2.rpy:150
translate pt_br end_game2_01ee7781:

    # "The big wolf sighs deeply, and I feel his torso puff out against my side and shoulder."
    "O grande lobo suspira profundamente e eu sinto seu torso inflar contra minha lateral e ombro."

# game/end_game2.rpy:152
translate pt_br end_game2_929f0d2f:

    # a "\"There are...things I must tell you, but later. It's not important right now.\""
    a "\"Tem algumas... coisas que eu preciso te contar, mas depois. Não é importante agora.\""

# game/end_game2.rpy:153
translate pt_br end_game2_bd610d62:

    # "That tension that had been so mercifully loosened in my chest suddenly appears again, albeit in a much smaller way."
    "Aquela tensão que havia sido tão misericordiosamente aliviada do meu peito de repente aparece mais uma vez, embora de uma forma muito menor."

# game/end_game2.rpy:154
translate pt_br end_game2_f617c002:

    # "I want to ask more, but for now I just want to rest."
    "Eu quero perguntar mais, mas por enquanto só quero descansar."

# game/end_game2.rpy:155
translate pt_br end_game2_fc8f316e:

    # m "\"Well...as long as I'm not gonna pass out and wake up completely confused again. I feel like that's all I've been doing the past month.\""
    m "\"Olha... contanto que eu não vá desmaiar e acordar completamente confuso outra vez... sinto que isso é tudo o que eu tenho feito ultimamente.\""

# game/end_game2.rpy:156
translate pt_br end_game2_ff03efe4:

    # "Amicus huffs in amusement."
    "Amicus bufa, entretido."

# game/end_game2.rpy:158
translate pt_br end_game2_a553d900:

    # a "\"Yes, you do have a knack for such things.\""
    a "\"Sim, você tem um talento especial para essas coisas.\""

# game/end_game2.rpy:159
translate pt_br end_game2_fb26df1a:

    # "We go quiet again, and it's a nice kind of quiet."
    "Ficamos em silêncio de novo, e é um tipo legal de silêncio."

# game/end_game2.rpy:160
translate pt_br end_game2_30fee3c2:

    # "We're both just basking in the peaceful aftermath of our months-long struggle."
    "Estamos aproveitando o momento pacífico depois do esforço desses meses."

# game/end_game2.rpy:161
translate pt_br end_game2_989320a7:

    # "After a while though, my wolf meets my eyes again."
    "Mas depois de um tempo, meu lobo choca seu olhar com o meu outra vez."

# game/end_game2.rpy:163
translate pt_br end_game2_804cd142:

    # a "\"[mc]?\""
    a "\"[mc]?\""

# game/end_game2.rpy:164
translate pt_br end_game2_9e2f24e6:

    # m "\"Yes, Amicus?\""
    m "\"Sim, Amicus?\""

# game/end_game2.rpy:165
translate pt_br end_game2_89304c5a:

    # a "\"I'm sorry.\""
    a "\"Eu sinto muito.\""

# game/end_game2.rpy:166
translate pt_br end_game2_6bc83ed5:

    # m "\"Sorry?\""
    m "\"Pelo que?\""

# game/end_game2.rpy:167
translate pt_br end_game2_862faa9a:

    # a "\"For everything, for taking you from your planet, for involving you in Adastran politics, for acting as if I knew better. Even if it was part of the parents' plan, it doesn't make it right...and I'm sorry.\""
    a "\"Por tudo, por tirar você do seu planeta, por lhe envolver em política Adastriana, por agir como se eu soubesse o que era melhor para você. Mesmo que tenha sido parte do plano dos progenitores, não justifica nada... então eu sinto muito.\""

# game/end_game2.rpy:168
translate pt_br end_game2_15f3bc9d:

    # m "\"Plan?\""
    m "\"Plano?\""

# game/end_game2.rpy:171
translate pt_br end_game2_f7d47520:

    # "Amicus lets out a small, tired laugh, shaking his head."
    "Amicus solta uma risadinha cansada, balançando a cabeça."

# game/end_game2.rpy:172
translate pt_br end_game2_633780a5:

    # a "\"Again, I'll tell you later. Let's just be together for now.\""
    a "\"Mais uma vez, eu te conto depois. Vamos só aproveitar esse momento por enquanto.\""

# game/end_game2.rpy:173
translate pt_br end_game2_e6ac4855:

    # "I nod in agreement, ignoring the clicks in my neck, clinging to my wolf, happy to be in this quiet little corner of the universe, undisturbed by politics, mad emperors, or monolithic space entities."
    "Eu concordo com a cabeça, ignorando os cliques em meu pescoço, agarrando-me ao lobo, feliz por estar nesse cantinho silencioso do universo, imperturbável por política, imperadores loucos ou entidades espaciais monolíticas."

# game/end_game2.rpy:177
translate pt_br end_game2_5b142e94:

    # "The following days are...strange, to say the least."
    "Os próximos dias são... estranhos, para dizer o mínimo."

# game/end_game2.rpy:178
translate pt_br end_game2_5558e129:

    # "After what happened in the amphitheater, the wolven population has seemingly taken great interest in me."
    "Depois do que aconteceu no anfiteatro, a população lobina aparentemente se interessou muito por mim."

# game/end_game2.rpy:179
translate pt_br end_game2_da160f73:

    # "I guess I'm sort of a celebrity at this point."
    "Acho que sou uma espécie de celebridade a essa altura."

# game/end_game2.rpy:180
translate pt_br end_game2_052c3cdc:

    # "I got my first taste of this while lounging in the dining room, only half-paying attention to the screens when I realize that it's a reenactment of the Trial by Combat between Amicus and Cato."
    "Tive a primeira prova disso enquanto descansava na sala de jantar, ouvindo a TV de fundo até perceber que estava passando uma reencenação do julgamento de combate entre Amicus e Cato."

# game/end_game2.rpy:181
translate pt_br end_game2_23b55aff:

    # "My character, portrayed by a small wolf wearing a rather uncanny human mask, jumps in at the last second to plunge the dagger into Cato's back."
    "Meu personagem, interpretado por um pequeno lobo usando uma máscara humana bem estranha, pula no último segundo para mergulhar a adaga nas costas do Cato."

# game/end_game2.rpy:182
translate pt_br end_game2_32adedf0:

    # "He's then stabbed directly in the throat by Cato (instead of slashed) and stands for several seconds, clutching his neck while \"Amicus\" tears out Cato's throat, then arrives just in time to catch \"me\" as he swoons back."
    "Então ele é esfaqueado diretamente na garganta por Cato (em vez de cortado) e fica de pé por vários segundos, segurando o pescoço enquanto \"Amicus\" rasga a garganta do Cato, depois, chega bem a tempo de \"me\" pegar enquanto eu desmaio."

# game/end_game2.rpy:183
translate pt_br end_game2_07c0610a:

    # "I have to stop watching at this point, the memories of what happened too fresh and traumatizing for me to see played out, even if it's terribly acted out."
    "Acabo tendo que parar de assistir nesse momento, as memórias do que aconteceu ainda muito frescas e traumatizantes para se rever, mesmo que terrivelmente encenadas."

# game/end_game2.rpy:184
translate pt_br end_game2_76e8ae8b:

    # "While I suppose it's nice to be liked by the general population, I can't help but feel it's for the wrong reasons."
    "Por mais que seja legal ser querido pela população em geral, não posso deixar de sentir que é pelos motivos errados."

# game/end_game2.rpy:185
translate pt_br end_game2_0d6c0aa9:

    # "I'm definitely being portrayed as a noble savage of sorts; so in love with my \"master\" that I broke the rules to save him...or I just didn't understand the rules well enough to abide by them."
    "Definitivamente estou sendo retratado como um tipo de selvagem nobre; tão apaixonado por meu \"mestre\" que quebrei as regras para salvá-lo... ou simplesmente não entendia as regras o suficiente para segui-las."

# game/end_game2.rpy:186
translate pt_br end_game2_78d3caba:

    # "Either way, it makes me feel kind of uncomfortable."
    "De qualquer forma, isso me faz sentir meio desconfortável."

# game/end_game2.rpy:187
translate pt_br end_game2_4097fcdc:

    # "Meanwhile, Amicus is kept busy, of course."
    "Enquanto isso, Amicus permanece ocupado, é claro."

# game/end_game2.rpy:188
translate pt_br end_game2_0ab29e31:

    # "The quiet moment I'd had with him in the archives is actually the last really long moment alone I've had with him since."
    "O momento de silêncio nos arquivos foi na verdade o último momento realmente longo que tive sozinho com ele desde então."

# game/end_game2.rpy:189
translate pt_br end_game2_4580f3ad:

    # "Almost immediately after, Amicus is whisked away to various ceremonies and meetings as everything becomes official."
    "Quase imediatamente depois, Amicus foi levado para várias cerimônias e reuniões enquanto tudo se tornava oficial."

# game/end_game2.rpy:190
translate pt_br end_game2_c0bc43bb:

    # "Amicus is the emperor now, and he seems to be taking to it rather well, especially after the incredibly stressful events preceding it."
    "Amicus é o imperador agora, e ele parece estar se adaptando muito bem, especialmente depois dos eventos incrivelmente estressantes que precederam isso."

# game/end_game2.rpy:191
translate pt_br end_game2_7b3d39fe:

    # "His personality has always been silly, and a bit immature, but after taking the throne, he's taken on a persona of a cool, calm, leader."
    "Sua personalidade sempre foi boba e um pouco imatura, mas depois de reivindicar o trono, ele assumiu a personalidade de um líder calmo e legal."

# game/end_game2.rpy:192
translate pt_br end_game2_71cecf8d:

    # "It's a side of him that I've seen occasional flashes of, and while I'm happy to see him fitting the role so well, I can't help but feel a bit sad that he has to quash that playful, outgoing side of himself."
    "É um lado dele que eu já vi se mostrando ocasionalmente, e embora eu esteja feliz em vê-lo se encaixar tão bem no papel, não consigo evitar de me sentir um pouco triste sobre ele precisar reprimir esse lado brincalhão e extrovertido de si mesmo."

# game/end_game2.rpy:193
translate pt_br end_game2_eaca2af0:

    # "I suppose it's one of those parts of having to grow up."
    "Suponho que seja uma daquelas etapas de virar adulto."

# game/end_game2.rpy:195
translate pt_br end_game2_2e5b2e26:

    # "I try to stay out of his way for now, knowing he has so much to do, but on the second day after the trial, I'm told by Com that Amicus wants to speak with me."
    "Eu tento ficar fora do caminho dele por enquanto, sabendo que ele tem muito o que fazer, mas no segundo dia depois do julgamento, sou informado pelo Com que Amicus quer falar comigo."

# game/end_game2.rpy:199
translate pt_br end_game2_140cf5d8:

    # "I open the door and immediately hear Virginia's voice, raised slightly in annoyance."
    "Eu abro a porta e imediatamente ouço a voz de Virginia, levemente aborrecida."

# game/end_game2.rpy:201
translate pt_br end_game2_c98e81d4:

    # v "\"No! Lux is the city in desperate need of funds right now. {i}Lex{/i} is doing very well.\""
    v "\"Não! Lux é a cidade que precisa desesperadamente de fundos agora. {i}Lex{/i} está indo muito bem.\""

# game/end_game2.rpy:203
translate pt_br end_game2_684e8187:

    # a "\"Well, I'm sorry, but the names are rather similar, are they not? I meant Lux anyway.\""
    a "\"Sinto muito, mas os nomes são bem semelhantes, não são? Eu quis dizer Lux, de qualquer forma.\""

# game/end_game2.rpy:205
translate pt_br end_game2_300ab33e:

    # v "\"Even if you meant it that way, I can guarantee you the triumvirates won't be pleased hearing you mistakenly refer to which city they are from!\""
    v "\"Mesmo que você tenha pensado dessa maneira, posso garantir que os triunviratos não ficarão satisfeitos ouvindo você se referir erroneamente à cidade de onde eles vêm!\""

# game/end_game2.rpy:207
translate pt_br end_game2_8fc0d3a9:

    # a "\"Alright, alright! Calm down. I'll be sure to remember that...and don't yell at me in front of the triumvirates, please. You'll only give my critics more weaponry if I'm seen allowing my own sister to treat me in such a way.\""
    a "\"Certo, certo! Se acalme. Me assegurarei de lembrar disso... e não grite comigo na frente dos triunviratos, por favor. Você só vai jogar mais lenha na fogueira dos meus críticos se eu for visto permitindo que minha irmã me trate assim.\""

# game/end_game2.rpy:209
translate pt_br end_game2_fcd6d352:

    # v "\"All the more reason not to make mistakes then.\""
    v "\"Mais uma razão para não cometer erros, então.\""

# game/end_game2.rpy:213
translate pt_br end_game2_1750e977:

    # "The two seem to realize that I'm there finally, and cease their argument."
    "Os dois parecem finalmente perceber que eu estou lá e param com a discussão."

# game/end_game2.rpy:214
translate pt_br end_game2_5302c0b8:

    # a "\"[mc]! We were just finishing our conversation.\""
    a "\"[mc]! Nós já estávamos terminando nossa conversa.\""

# game/end_game2.rpy:216
translate pt_br end_game2_ce912c72:

    # v "\"Were we? I'm going to drill you on all of this again on our flight to the city.\""
    v "\"Estávamos? Vou detalhar tudo isso novamente no nosso voo até a cidade.\""

# game/end_game2.rpy:217
translate pt_br end_game2_7c63dec8:

    # "Virginia makes her way past me, pausing to rest a paw on my shoulder."
    "Virginia segue o caminho até mim, parando para repousar uma pata em meu ombro."

# game/end_game2.rpy:219
translate pt_br end_game2_6f2225cb:

    # v "\"Maybe I should put you in charge of my brother's studies. At least he listens to you.\""
    v "\"Talvez eu devesse colocar você no comando dos estudos do meu irmão. Pelo menos ele escuta você.\""

# game/end_game2.rpy:221
translate pt_br end_game2_4acccd60:

    # "The she-wolf rolls her eyes before disappearing through the door, leaving us in silence so that Amicus's big, heavy sigh seems to resonate through the entire room."
    "A loba revira os olhos antes de desaparecer pela porta, nos deixando em um silêncio tão intenso que os suspiros pesados do Amicus parecem ressoar o quarto inteiro."

# game/end_game2.rpy:224
translate pt_br end_game2_195ce336:

    # a "\"Gods, she's relentless.\""
    a "\"Deuses, ela é implacável.\""

# game/end_game2.rpy:225
translate pt_br end_game2_7baa46b0:

    # m "\"Isn't that a good thing?\""
    m "\"Isso não é uma coisa boa?\""

# game/end_game2.rpy:227
translate pt_br end_game2_03f4f62a:

    # a "\"I suppose, but it doesn't make it any easier to deal with.\""
    a "\"Suponho que sim, mas não torna lidar com ela nem um pouco mais fácil.\""

# game/end_game2.rpy:228
translate pt_br end_game2_60a11631:

    # "Amicus is walking towards me and immediately takes me up into a deep hug, followed by a kiss."
    "Amicus caminha na minha direção e imediatamente me puxa em um abraço apertado, seguido por um beijo."

# game/end_game2.rpy:229
translate pt_br end_game2_68e88f56:

    # "I kiss back, feeling Amicus's tense body relax against mine, and I feel happy at the idea that I might be able to relieve his stress so easily."
    "Eu beijo de volta, sentindo o corpo tenso do Amicus relaxar contra o meu e eu me sinto feliz com a ideia de conseguir aliviar o estresse dele com tanta facilidade."

# game/end_game2.rpy:230
translate pt_br end_game2_889a5bc2:

    # "He finally draws back, smiling as he does."
    "Então ele finalmente se afasta, sorrindo enquanto isso."

# game/end_game2.rpy:232
translate pt_br end_game2_cc2b86c4:

    # a "\"How have you been? I know I've been rather absent lately, but—\""
    a "\"Como você está? Eu sei que tenho estado muito ausente ultimamente, mas—\""

# game/end_game2.rpy:233
translate pt_br end_game2_c4c4146f:

    # m "\"I know, official business and everything. I've been okay. Just trying to adjust to the all the new.\""
    m "\"Eu sei, assuntos oficiais e tudo mais. Eu tenho me sentido bem. Só tentando me ajustar às novidades.\""

# game/end_game2.rpy:234
translate pt_br end_game2_54dc3ddd:

    # "I sweep a hand around me, then hesitantly bring it to my neck, the wound that the parents had somehow healed, my trachea and vocal cords having been replaced and repaired with...something."
    "Eu varro uma mão por mim, então, hesitantemente a levo até meu pescoço, a ferida que os progenitores curaram de alguma forma, minhas cordas vocais e traqueia tendo sido reparadas e substítuídas por... alguma coisa."

# game/end_game2.rpy:235
translate pt_br end_game2_f1ed5b06:

    # "I try not to think about it, and I've gotten used to it for the most part."
    "Eu tento não pensar muito sobre isso, e me acostumei com a coisa na maior parte do tempo."

# game/end_game2.rpy:237
translate pt_br end_game2_208a9f72:

    # a "\"Well, I hope you've been adjusting smoothly, then.\""
    a "\"Espero que você esteja se adaptando sem problemas, então.\""

# game/end_game2.rpy:238
translate pt_br end_game2_ab0c9975:

    # "Amicus brushes a paw through my hair, looking me over."
    "Amicus passa uma pata pelo meu cabelo, me olhando."

# game/end_game2.rpy:239
translate pt_br end_game2_0854bb69:

    # m "\"What was it you wanted to talk about?\""
    m "\"Sobre o que você queria falar?\""

# game/end_game2.rpy:241
translate pt_br end_game2_69296fb0:

    # "Amicus pulls his paw back, and the look on his face starts to worry me."
    "Amicus puxa sua pata de volta e o olhar em seu rosto começa a me preocupar."

# game/end_game2.rpy:242
translate pt_br end_game2_625b4e4e:

    # m "\"Is it about what happened with the parents?\""
    m "\"É sobre o que aconteceu com os progenitores?\""

# game/end_game2.rpy:243
translate pt_br end_game2_9f5a71ab:

    # "At this point in time, I know that something involving me happened while I'd been unconscious."
    "A essa altura eu já sei que alguma coisa me envolvendo aconteceu enquanto fiquei inconsciente."

# game/end_game2.rpy:244
translate pt_br end_game2_20547be1:

    # "For whatever reason, I'd been kept unaware of the conversation that happened between Amicus and the parents."
    "Seja lá qual for o motivo, fui mantido inconsciente da conversa que aconteceu entre Amicus e os progenitores."

# game/end_game2.rpy:245
translate pt_br end_game2_7dc5874e:

    # "Amicus nods, rubbing an arm awkwardly."
    "Amicus acena com a cabeça, esfregando um braço desjeitosamente."

# game/end_game2.rpy:246
translate pt_br end_game2_8aa00ae3:

    # a "\"Er, yes. It's rather complicated, so it may take a moment for me to explain it all.\""
    a "\"É... sim. É bem complicado, então pode levar um tempo para eu explicar tudo.\""

# game/end_game2.rpy:249
translate pt_br end_game2_cb7f4c3e:

    # "The wolf guides me to the sofa, and we sit side-by-side as Amicus drapes an arm around my shoulder."
    "O lobo me guia até o sofá e nós nos sentamos lado a lado enquanto Amicus coloca um braço por volta do meu ombro."

# game/end_game2.rpy:250
translate pt_br end_game2_a1c2b5fe:

    # "Over the next few minutes, he tells me of the deal he made with the parents, that he'd submit himself to their will, if only to bring me back to life."
    "Nos próximos minutos, ele me fala sobre o acordo que fez com os progenitores, que se submeteria à vontade deles se apenas para me trazer de volta à vida."

# game/end_game2.rpy:251
translate pt_br end_game2_e49a1b1a:

    # "It's a similar decision that I had to make, and I shake my head."
    "É uma escolha semelhante à que eu tinha que fazer e eu balanço minha cabeça."

# game/end_game2.rpy:253
translate pt_br end_game2_623eee90:

    # m "\"I don't like that. Why are they doing this to us?\""
    m "\"Eu não gosto disso. Por que eles tão fazendo isso com a gente?\""

# game/end_game2.rpy:254
translate pt_br end_game2_bbfe0ab5:

    # "Amicus shrugs loosely against me, shaking his head as well."
    "Amicus levemente encolhe os ombros contra mim, também balançando a cabeça."

# game/end_game2.rpy:256
translate pt_br end_game2_2c75f809:

    # a "\"I honestly don't know, but I can tell you that my view of them has changed quite a bit since what happened.\""
    a "\"Sinceramente, não sei, mas posso lhe dizer que minha visão deles mudou bastante depois do que aconteceu.\""

# game/end_game2.rpy:257
translate pt_br end_game2_adb7a868:

    # m "\"So what, now you have to do whatever they say or...something bad happens to me?\""
    m "\"E agora, você tem que fazer tudo o que eles te disserem ou... algo ruim acontece comigo?\""

# game/end_game2.rpy:258
translate pt_br end_game2_508ac204:

    # "Again, my hand drifts up to my neck, wondering if there's something more to the mechanics in my throat."
    "Mais uma vez, minha mão sobe até o pescoço, me perguntado se há algo a mais nos mecanismos da minha garganta."

# game/end_game2.rpy:259
translate pt_br end_game2_685b0624:

    # "An irrational part of my mind wonders if maybe there's some type of self-destruct mechanism built into it."
    "Uma parte irracional da minha mente se pergunta se talvez existe algum tipo de mecanismo de auto-destruição embutido."

# game/end_game2.rpy:260
translate pt_br end_game2_94c4a329:

    # "I shudder at the thought of my throat suddenly exploding."
    "Sinto calafrios com o pensamento de ter minha garganta repentinamente explodindo."

# game/end_game2.rpy:261
translate pt_br end_game2_b0954df3:

    # a "\"I...doubt that, but I feel that maybe they would make it difficult for us to stay together if I did. Our meeting together...it was planned by the parents.\""
    a "\"Eu... duvido disso, mas sinto que talvez eles dificultariam nossa permanência juntos se eu fosse contra a vontade deles. Nos conhecermos... foi planejado pelos progenitores.\""

# game/end_game2.rpy:262
translate pt_br end_game2_6dcf1164:

    # "This was something I'd sort of assumed on my own, but I still bristle nonetheless."
    "Isso foi algo que eu meio que já tinha presumido antes eu mesmo, mas ainda assim me irrito."

# game/end_game2.rpy:263
translate pt_br end_game2_c3316598:

    # m "\"See? They're using our love against us. This is...this is just fucked up.\""
    m "\"Tá vendo? Eles usam nosso amor contra nós. Isso... isso é muito escroto.\""

# game/end_game2.rpy:264
translate pt_br end_game2_087bbabf:

    # "Amicus just nods quietly, but draws me closer with his arm around my shoulders."
    "Amicus simplesmente acena com a cabeça em silêncio, mas me puxa para mais perto com seu braço em volta dos meus ombros."

# game/end_game2.rpy:265
translate pt_br end_game2_fb0ec738:

    # m "\"So they just...draw us together. I was like, the most compatible human to you so now they can make sure we do as we're told so we can stay together?\""
    m "\"Então eles simplesmente... nos uniram. Eu era tipo, o humano mais compatível com você e agora eles podem ficar tranquilos que nós vamos fazer o que eles pedem pra que possamos ficar juntos?\""

# game/end_game2.rpy:266
translate pt_br end_game2_ffa26087:

    # "Again, Amicus is quiet, just holding me."
    "Mais uma vez, Amicus fica quieto, só me abraçando."

# game/end_game2.rpy:267
translate pt_br end_game2_fdf3931c:

    # m "\"I don't like this.\""
    m "\"Eu não gosto disso.\""

# game/end_game2.rpy:268
translate pt_br end_game2_df975ad7:

    # a "\"Neither do I.\""
    a "\"Nem eu.\""

# game/end_game2.rpy:269
translate pt_br end_game2_dcb0476f:

    # m "\"So if your job is to bring the {i}Galaxias{/i} together...what's my job?\""
    m "\"Então, se o seu objetivo é unir a {i}congregação galáctica{/i}... qual é o meu objetivo?\""

# game/end_game2.rpy:271
translate pt_br end_game2_0ca3b69b:

    # "Amicus takes another slow, deep breath, which only spikes my anxiety."
    "Amicus respira fundo lentamente, o que só faz aumentar minha ansiedade."

# game/end_game2.rpy:272
translate pt_br end_game2_c8f0254b:

    # "I realize that the release I felt in the archive room was only temporary."
    "Percebo então que o alívio que senti na sala do arquivo foi apenas temporário."

# game/end_game2.rpy:273
translate pt_br end_game2_63032193:

    # "In retrospect, I suppose it was a bit silly that I thought everything would be fine after Amicus became emperor."
    "Em retrospecto, suponho que fui um pouco tolo de achar que tudo ficaria bem depois que o Amicus se tornasse imperador."

# game/end_game2.rpy:274
translate pt_br end_game2_3b442f9e:

    # "This is only the beginning."
    "Isso é só o começo."

# game/end_game2.rpy:275
translate pt_br end_game2_255dcea5:

    # a "\"Well, this is what I wanted to talk to you about.\""
    a "\"Bem, era sobre isso que eu queria falar com você.\""

# game/end_game2.rpy:276
translate pt_br end_game2_06599db0:

    # "I wait, feeling Amicus steel himself for what he's about to say, and I feel my anxiety grow."
    "Eu espero, sentindo Amicus se preparar para o que está prestes a dizer e eu sinto minha ansiedade crescendo."

# game/end_game2.rpy:277
translate pt_br end_game2_12395018:

    # "How bad could this actually be?"
    "Quão ruim isso poderia ser de fato?"

# game/end_game2.rpy:278
translate pt_br end_game2_5668dd01:

    # "Then, he lets out the breath with a rush of words, seemingly trying to get the explanation out all at once."
    "Então, ele solta o fôlego com uma palavra atropelando a outra, aparentemente tentando dar a explicação toda de uma vez."

# game/end_game2.rpy:279
translate pt_br end_game2_032f46e1:

    # a "\"The parents told me that your mission is to begin the process of integrating humans into the {i}Galaxias{/i}.\""
    a "\"Os progenitores me disseram que sua missão seria começar o processo de integração dos humanos na {i}congregação galáctica{/i}.\""

# game/end_game2.rpy:280
translate pt_br end_game2_9b699855:

    # "I'm only starting to absorb that when Amicus takes another breath and starts another slew of words."
    "Eu só estou começando a absorver isso quando Amicus respira fundo outra vez e começa a soltar outra série de palavras."

# game/end_game2.rpy:281
translate pt_br end_game2_78cddaf2:

    # a "\"They want you to return to Earth and complete a series of steps to begin the integration process, a process that will take...\""
    a "\"Eles querem que você volte à Terra e complete uma série de passos para iniciar o processo de integração, um processo que vai levar...\""

# game/end_game2.rpy:283
translate pt_br end_game2_baf58a2f:

    # "Amicus suddenly winces, as though the words themselves hurt."
    "Amicus se contorce de repente, como se as próprias palavras machucassem."

# game/end_game2.rpy:284
translate pt_br end_game2_6b27817c:

    # a "\"...that will take around eight years to complete.\""
    a "\"(...) que vai levar cerca de oito anos para ser concluído.\""

# game/end_game2.rpy:285
translate pt_br end_game2_a239cbde:

    # "That last bit takes the longest for me to comprehend."
    "Essa última parte me leva mais tempo para compreender."

# game/end_game2.rpy:286
translate pt_br end_game2_0a09e71f:

    # "Eight years?"
    "Oito anos?"

# game/end_game2.rpy:287
translate pt_br end_game2_dd72dbf2:

    # m "\"Eight years? Like, I'll have to go to Earth for eight years and...do a bunch of crap to bring my planet into the {i}Galaxias{/i}?\""
    m "\"Oito anos? Tipo, eu tenho que ir pra Terra por oito anos e... fazer um monte de maracutaias pra integrar o meu planeta à {i}congregação galáctica{/i}?\""

# game/end_game2.rpy:288
translate pt_br end_game2_4f30f690:

    # "Amicus nods, and I see the deep sadness on his face."
    "Amicus acena com a cabeça e eu enxergo a profunda tristeza em seu rosto."

# game/end_game2.rpy:289
translate pt_br end_game2_141bd4b4:

    # "This explains why he wasn't exactly happy after we'd escaped the parental dimension."
    "Isso explica por que ele não ficou exatamente feliz depois que nós escapamos da dimensão dos progenitores."

# game/end_game2.rpy:290
translate pt_br end_game2_e2f10517:

    # "I find myself at a loss for words, even though there's so much I want to ask."
    "Eu me pego sem saber o que dizer, mesmo que haja tanto que eu queira perguntar."

# game/end_game2.rpy:291
translate pt_br end_game2_cf35e122:

    # "Amicus tries to fill the silence:"
    "Amicus tenta preencher o silêncio:"

# game/end_game2.rpy:293
translate pt_br end_game2_71db4670:

    # a "\"Your planet won't be...conquered, or anything. Rather you're already on a sibling-like level. You're unique in that you aren't exactly a sibling species, but you won't be under the control of another civilization, if that makes sense.\""
    a "\"Seu planeta não será... conquistado, ou algo do gênero. Em vez disso, vocês já estão em um nível acima dos infantes. Não são exatamente uma espécie da irmandade, mas não estarão sob controle de nenhuma outra civilização, se isso faz algum sentido.\""

# game/end_game2.rpy:295
translate pt_br end_game2_0f929c9f:

    # a "\"Aside from the parents, of course.\""
    a "\"Com exceção dos progenitores, é claro.\""

# game/end_game2.rpy:296
translate pt_br end_game2_48b2b80d:

    # "That's a relief, I suppose."
    "Isso é um alivio, eu acho."

# game/end_game2.rpy:297
translate pt_br end_game2_f138af9d:

    # "Though the more I learn about the parents, the more I'm unsure about any of this."
    "Apesar disso, quanto mais aprendo sobre os progenitores, mais não tenho certeza sobre nada disso."

# game/end_game2.rpy:298
translate pt_br end_game2_a84f6935:

    # "While I'd once worried about the wolves invading Earth, I'm not sure I'd want the parents to be doing the same."
    "Por mais que eu já tenha me preocupado com os lobos invadindo a Terra, não tenho certeza se gostaria que os progenitores fizessem o mesmo."

# game/end_game2.rpy:299
translate pt_br end_game2_b9e1adf3:

    # "The way we're being...{i}used{/i} like this, like we're just a pair of tools."
    "A forma como nós estamos sendo... {i}usados{/i} assim, como se fôssemos simplesmente um par de ferramentas."

# game/end_game2.rpy:300
translate pt_br end_game2_2e2b5c5d:

    # "It makes my skin crawl."
    "Faz minha pele arrepiar."

# game/end_game2.rpy:301
translate pt_br end_game2_76d07600:

    # m "\"And the eight years? Will I just...will I be able to see you?\""
    m "\"E os oito anos? Eu vou só... eu vou poder te ver?\""

# game/end_game2.rpy:303
translate pt_br end_game2_7d4ff00a:

    # "I see the corners of Amicus's muzzle dip down deeply into a frown before stubbornly pulling back up, the way they often did when he was trying not to tear up."
    "Eu vejo os cantos do focinho do Amicus inclinarem profundamente para baixo antes de serem teimosamente puxados de volta, do jeito que ele sempre faz quando está tentando não chorar."

# game/end_game2.rpy:305
translate pt_br end_game2_735dbcbe:

    # a "\"No, but I discussed with them those supplements that we take to extend our lifespans. You'll be able to take them, to make those eight years seem more negligible.\""
    a "\"Não, mas eu discuti com eles sobre aqueles suplementos que nós tomamos para prolongar nossa expectativa de vida. Você vai ter acesso a eles, para fazer esses oito anos parecerem mais insignificantes.\""

# game/end_game2.rpy:306
translate pt_br end_game2_01846b83:

    # "The way Amicus is talking; fast-paced and upbeat tells me that he's trying to make this sound like it isn't a huge deal at all...but it is."
    "A forma como o Amicus fala, em ritmo acelerado e otimista, me diz que ele está tentando fazer parecer que isso não é nada demais... mas é."

# game/end_game2.rpy:307
translate pt_br end_game2_a561f874:

    # m "\"Eight years...\""
    m "\"Oito anos...\""

# game/end_game2.rpy:309
translate pt_br end_game2_60465660:

    # "The arm around my shoulder brings me into a full-on hug now, pressing my face against his chest."
    "O braço em volta do meu ombro me envolve em um abraço completo agora, Amicus pressionando meu rosto contra seu peito."

# game/end_game2.rpy:310
translate pt_br end_game2_408873dd:

    # a "\"I know. It seems like a long time, and it is, but after that...we'll be free.\""
    a "\"Eu sei. Parece um longo período, e é, mas depois disso... estaremos livres.\""

# game/end_game2.rpy:311
translate pt_br end_game2_73c0528c:

    # "Amicus's voice is strained, like there's a heavy weight on his chest."
    "A voz do Amicus sai tensa, como se tivesse alguma coisa pesando em seu peito."

# game/end_game2.rpy:312
translate pt_br end_game2_c09655a0:

    # "We both know we won't."
    "Nós dois sabemos que não vamos estar livres."

# game/end_game2.rpy:313
translate pt_br end_game2_d48ac3ae:

    # m "\"And I'm gonna have to do all of that alone? Couldn't you come help me?\""
    m "\"E eu vou ter que fazer tudo isso sozinho? Você não poderia vir me ajudar?\""

# game/end_game2.rpy:314
translate pt_br end_game2_625f102c:

    # "Now I sound like a child."
    "Agora eu pareço uma criança."

# game/end_game2.rpy:315
translate pt_br end_game2_f5407cc7:

    # "I can see Amicus's eyes glistening, but he stubbornly continues to smile."
    "Eu posso ver os olhos do Amicus brilhando, mas ele continua sorrindo teimosamente."

# game/end_game2.rpy:317
translate pt_br end_game2_dfa727db:

    # a "\"You won't need my help. You're fully capable on your own. Besides, we'll see each other again as soon as your series of planned steps are completed.\""
    a "\"Você não vai precisar da minha ajuda. É totalmente capaz por conta própria. Além disso, nos veremos novamente assim que sua série de etapas planejadas estiver concluída.\""

# game/end_game2.rpy:318
translate pt_br end_game2_750be4be:

    # "Over the course of eight years."
    "Ao longo de oito anos."

# game/end_game2.rpy:320
translate pt_br end_game2_6b9038c7:

    # a "\"And once we reach that point, we'll be able to finally relax and—\""
    a "\"E assim que chegarmos a esse ponto, poderemos finalmente relaxar e—\""

# game/end_game2.rpy:321
translate pt_br end_game2_97670b48:

    # m "\"But will we?\""
    m "\"Será mesmo?\""

# game/end_game2.rpy:322
translate pt_br end_game2_4be4d5de:

    # "I'm still trying to absorb the idea of a years-long mission, a mission that involves introducing all of Earth to the idea of sapient life beyond our planet."
    "Eu ainda estou tentando absorver a ideia de uma missão que vai durar anos, uma missão que envolve introduzir toda a Terra à ideia de vida sapiente além do nosso planeta."

# game/end_game2.rpy:323
translate pt_br end_game2_eb272b36:

    # "That idea is harrowing enough, but after being strung along by the parents like this, I have to wonder..."
    "Essa ideia é angustiante o suficiente, mas depois de ter sido amarrado pelos progenitores assim, tenho que me perguntar..."

# game/end_game2.rpy:324
translate pt_br end_game2_981d7d93:

    # m "\"It seems like after we accomplish every step, there's a bigger one right after.\""
    m "\"Parece que depois que conseguimos fazer algo que eles querem, tem alguma coisa maior logo depois.\""

# game/end_game2.rpy:325
translate pt_br end_game2_a898dd3f:

    # "I feel my heart rate pick up, but rather than becoming angry, I'm feeling kind of desperate."
    "Eu sinto minha frequência cardíaca acelerar, mas em vez de ficar com raiva, me sinto meio desesperado."

# game/end_game2.rpy:326
translate pt_br end_game2_9aa60d66:

    # m "\"How much more are they gonna ask from us? This whole thing is just...puppeteering. We're not in control of anything at all!\""
    m "\"Quanto mais eles vão exigir de nós? Essa situação toda é... um teatro de marionetes. A gente não tem controle sobre nada!\""

# game/end_game2.rpy:328
translate pt_br end_game2_9e17ba4d:

    # a "\"[mc]...\""
    a "\"[mc]...\""

# game/end_game2.rpy:329
translate pt_br end_game2_e82ff981:

    # "Amicus reaches out to me as I stand up."
    "Amicus tenta me alcançar conforme eu me levanto."

# game/end_game2.rpy:330
translate pt_br end_game2_9125143f:

    # a "\"Please, I know this is hard. I've been trying to figure out a way not to drag you into this, but the parents seem intent—\""
    a "\"Por favor, eu sei que isso é difícil. Tenho tentado descobrir uma maneira de não arrastá-lo para isso, mas os progenitores parecem ter a intenção—\""

# game/end_game2.rpy:331
translate pt_br end_game2_8aa4a3a0:

    # m "\"This isn't fair, though! We paid our dues...I fucking DIED!\""
    m "\"Mas isso não é justo! Nós já fizemos o possível... eu MORRI, caralho!\""

# game/end_game2.rpy:332
translate pt_br end_game2_9f3987e1:

    # "Again, I sound like a little kid."
    "Mais uma vez, eu pareço uma criança."

# game/end_game2.rpy:333
translate pt_br end_game2_65bd5da1:

    # "I can't help myself."
    "Não consigo evitar."

# game/end_game2.rpy:334
translate pt_br end_game2_556a477b:

    # "This really isn't fair at all."
    "Isso realmente não é justo."

# game/end_game2.rpy:335
translate pt_br end_game2_be4f33bc:

    # "I didn't ask for any of this."
    "Não pedi por nada disso."

# game/end_game2.rpy:336
translate pt_br end_game2_0958e2d5:

    # "Originally, I had Amicus to blame."
    "Originalmente eu tinha o Amicus para culpar."

# game/end_game2.rpy:337
translate pt_br end_game2_f5d26e5a:

    # "He was the one that brought me here in the first place."
    "Foi ele quem me trouxe aqui, afinal."

# game/end_game2.rpy:338
translate pt_br end_game2_fed64c3c:

    # "Now though, knowing that everything was planned and orchestrated by the parents...I feel powerless, like I didn't have any choice from the very beginning."
    "Mas agora, sabendo que tudo foi planejado e orquestrado pelos progenitores... me sinto impotente, como se não tivesse escolha desde o início."

# game/end_game2.rpy:339
translate pt_br end_game2_81558108:

    # m "\"I don't even have a say in this...\""
    m "\"E eu não posso nem decidir nada...\""

# game/end_game2.rpy:341
translate pt_br end_game2_357acd82:

    # a "\"But you do! I haven't gotten to that part yet.\""
    a "\"Mas você pode! Eu não cheguei nessa parte ainda.\""

# game/end_game2.rpy:342
translate pt_br end_game2_628def40:

    # "Amicus has his paws raised, and I can see that he's still trying to hold back tears."
    "Amicus levanta as patas e eu consigo ver que ele ainda está tentando segurar as lágrimas."

# game/end_game2.rpy:343
translate pt_br end_game2_a760ebeb:

    # "I want to lash out at something, but I know this isn't his fault, especially now, so I try to calm myself, taking a few deep breaths and swallowing hard."
    "Eu quero bater em alguma coisa, mas eu sei que isso não é culpa dele, especialmente agora, então tento me acalmar, respirando fundo algumas vezes e engolindo em seco."

# game/end_game2.rpy:345
translate pt_br end_game2_bce3d6e6:

    # a "\"They told me that you can make a decision, just as I made mine.\""
    a "\"Eles me disseram que você pode tomar uma decisão, assim como eu tomei a minha.\""

# game/end_game2.rpy:346
translate pt_br end_game2_a7f00c9c:

    # "I'm quiet for a moment, still breathing heavily."
    "Eu fico quieto por um momento, ainda respirando com dificuldade."

# game/end_game2.rpy:347
translate pt_br end_game2_753ece1c:

    # a "\"You can choose not to accept the mission. They will not force you to do it. We have around nine months before the mission begins.\""
    a "\"Você pode optar por não aceitar. Eles não forçarão você a fazer isso. Temos cerca de nove meses antes do início da missão.\""

# game/end_game2.rpy:348
translate pt_br end_game2_210a946a:

    # "I stare at the wolf, letting those words sink in."
    "Eu encaro o lobo, deixando essas palavras assimilarem."

# game/end_game2.rpy:349
translate pt_br end_game2_5a1d1c0a:

    # m "\"And...and if I don't accept? What are the consequences?\""
    m "\"E... e se eu não aceitar? Quais são as consequências?\""

# game/end_game2.rpy:350
translate pt_br end_game2_fde41635:

    # "That deep frown returns to Amicus's face."
    "Aquela franzida profunda volta ao rosto do Amicus."

# game/end_game2.rpy:352
translate pt_br end_game2_1e607857:

    # a "\"Well...they won't provide transport back to Earth. Of course, I'll likely be able to set it up for you now, but considering that the integration will be delayed...I would be disallowed from returning to see you.\""
    a "\"Bem... eles não fornecerão transporte de volta à Terra. É claro que eu vou poder resolver isso para você agora, mas considerando que a integração seria adiada... não me permitiriam retornar para ver você.\""

# game/end_game2.rpy:353
translate pt_br end_game2_0b79c47e:

    # "More manipulation."
    "Mais manipulação."

# game/end_game2.rpy:354
translate pt_br end_game2_12215d3d:

    # "I clench my hands into fists, willing the parents, wherever the fuck they are, to feel my anger toward them for doing this to us."
    "Eu aperto meus punhos, desejando que os progenitores, seja lá onde caralhos estejam, sintam minha raiva direcionada a eles por estarem fazendo isso com a gente."

# game/end_game2.rpy:355
translate pt_br end_game2_763230a1:

    # "I half-expect my throat to just explode right then and there and send a shower of blood over Amicus who's still sitting in front of me."
    "Meio que espero que minha garganta simplesmente exploda aqui e agora, resultando em um banho de sangue no Amicus, o qual ainda está sentado na minha frente."

# game/end_game2.rpy:356
translate pt_br end_game2_403db639:

    # m "\"So either I do what they say, or I never see you again?\""
    m "\"Então, ou eu faço o que eles dizem, ou nunca mais vejo você?\""

# game/end_game2.rpy:358
translate pt_br end_game2_9c746b8d:

    # a "\"Well...you could choose not to return to Earth. I am not suggesting that be your decision, but it is one of the possibilities.\""
    a "\"Bem... você pode optar por não voltar para a Terra. Não estou sugerindo que essa seja sua decisão, mas é uma das possibilidades.\""

# game/end_game2.rpy:359
translate pt_br end_game2_599a4f50:

    # "I look away, never having been so unsure of what to do in my life."
    "Eu desvio o olhar, nunca tendo estado tão inseguro sobre o que fazer da minha vida."

# game/end_game2.rpy:360
translate pt_br end_game2_e4c2de1d:

    # "This all feels so wrong."
    "Isso tudo parece tão errado."

# game/end_game2.rpy:361
translate pt_br end_game2_e40573ca:

    # "I'd always felt wrong about the parents, but I'd never suspected {i}this{/i}."
    "Eu sempre tive uma pulga atrás da orelha em relação aos progenitores, mas eu nunca suspeitei {i}disso{/i}."

# game/end_game2.rpy:363
translate pt_br end_game2_4c30ac82:

    # m "\"I—I need to go think about this.\""
    m "\"Eu—Eu tenho que pensar sobre isso.\""

# game/end_game2.rpy:365
translate pt_br end_game2_acddb55b:

    # "I'm starting to turn away when Amicus abruptly stands up."
    "Eu começo a me virar quando o Amicus se levanta abruptamente."

# game/end_game2.rpy:366
translate pt_br end_game2_2a69a45f:

    # "I think he's going to come after me, maybe wrap me up in another hug."
    "Eu penso que ele vai vir atrás de mim, talvez me envolver em outro abraço."

# game/end_game2.rpy:367
translate pt_br end_game2_144064f4:

    # "Instead, he keeps his paws behind his back, looking at me with an expression of stoic duty."
    "Em vez disso, ele mantém as patas atrás das costas, olhando para mim com uma expressão de dever estoico."

# game/end_game2.rpy:369
translate pt_br end_game2_bbde8ffd:

    # a "\"Alright, I'll be heading out to the city for part of the day to visit with a triumvirate...and whatever you choose, [mc], I will fully support you.\""
    a "\"Tudo bem, eu vou até a cidade durante parte do dia para visitar um triunvirato... e sejá lá o que você escolher, [mc], eu vou te apoiar incondicionalmente.\""

# game/end_game2.rpy:370
translate pt_br end_game2_9618a47a:

    # "It takes me a moment to realize that Amicus is using his \"official\" face right now, and it's strange to have him use it on me."
    "Me leva um momento para perceber que o Amicus está usando seu rosto \"oficial\" agora, e é estranho que ele tenha que usar em mim."

# game/end_game2.rpy:371
translate pt_br end_game2_99b83ef7:

    # "Even though I know he's doing it to make things easier for me, to not sway my decision based on his emotions, I hate that he has to do it."
    "Mesmo que eu saiba que ele está fazendo isso para tornar as coisas mais fáceis para mim, para não influenciar minha decisão com base nas emoções dele, odeio que ele tenha que fazer isso."

# game/end_game2.rpy:372
translate pt_br end_game2_7216cec5:

    # "I shake my head and turn away, walking out of the room even as I hear Amicus make a strangled noise as he cuts himself off and holds back from saying whatever he was going to say."
    "Balanço a cabeça e me afasto, saindo do quarto mesmo enquanto ouço Amicus fazer um barulho estrangulado conforme ele se interrompe de dizer o que ia falar."

# game/end_game2.rpy:376
translate pt_br end_game2_6d989b06:

    # "I walk briskly through the hallways, trying to gather my thoughts."
    "Eu ando rapidamente pelos corredores, tentando reunir meus pensamentos."

# game/end_game2.rpy:377
translate pt_br end_game2_b42ad93b:

    # "I just...want to spend time with Amicus, go back to Earth, see my family, come back to Adastra..."
    "Eu só... quero passar um tempo com o Amicus, voltar para a Terra, ver minha família, e então voltar para Adastra..."

# game/end_game2.rpy:378
translate pt_br end_game2_794d043e:

    # "But no, these parents are meddling with my life, seemingly rendering every choice I make meaningless."
    "Mas não, esses progenitores ficam se intrometendo na minha vida, aparentemente tornando cada escolha que eu faço insignificante."

# game/end_game2.rpy:379
translate pt_br end_game2_09d75d61:

    # "If they can do all and see all, why are they messing with me and Amicus like this?"
    "Se eles podem fazer tudo e ver tudo, por que eles brincam comigo e com o Amicus assim?"

# game/end_game2.rpy:380
translate pt_br end_game2_65623900:

    # "I feel another hot flash of anger toward them as I turn a corner and run smack into something soft, furry, and white."
    "Eu sinto outro lampejo de raiva direcionada a eles enquanto viro em um canto e bato em algo macio, peludo e branco."

# game/end_game2.rpy:383
translate pt_br end_game2_a237968c:

    # unk "\"Oof! What in the name of the gods!?\""
    unk "\"Oof! O que em nome dos deuses!?\""

# game/end_game2.rpy:384
translate pt_br end_game2_7d866cf4:

    # "It takes me a moment to recognize the voice, probably because of how disoriented I am from running into him."
    "Demoro um pouco para reconhecer a voz, provavelmente por ficar tão desorientado em encontrá-lo."

# game/end_game2.rpy:385
translate pt_br end_game2_d86fad64:

    # m "\"Sorry...Cassius.\""
    m "\"Ah! Foi mal... Cassius.\""

# game/end_game2.rpy:386
translate pt_br end_game2_70528eec:

    # "I finally focus on the indignant wolf as he angrily smooths down his fur."
    "Eu finalmente foco no lobo indignado enquanto ele suavemente endireita seu pelo."

# game/end_game2.rpy:388
translate pt_br end_game2_2a0e22d9:

    # c "\"Watch where you're going! You could have knocked me to the floor. You know what a catastrophe that could result in!\""
    c "\"Olhe por onde anda! Poderia ter me jogado no chão. Você sabe que em que tipo de catástrofe isso poderia resultar!\""

# game/end_game2.rpy:389
translate pt_br end_game2_4eb5cc91:

    # "Despite his outrage, I'm actually kind of happy to see Cassius back to his old self."
    "Apesar da indignação, na verdade eu fico feliz de ver o Cassius voltar ao seu antigo eu."

# game/end_game2.rpy:390
translate pt_br end_game2_9ca4a036:

    # "Just two days ago he was bed-ridden, though recovering."
    "Apenas dois dias atrás, ele estava de cama, embora se recuperando."

# game/end_game2.rpy:391
translate pt_br end_game2_361a3f9c:

    # "A combination of Virginia inducing him to vomit and a quick delivery of an antidote left Cassius in a position to fully recover."
    "Uma combinação de Virginia induzindo seu vômito e uma entrega rápida de um antídoto deixaram Cassius em posição de se recuperar completamente."

# game/end_game2.rpy:392
translate pt_br end_game2_b297e991:

    # m "\"Hello to you too, Cass.\""
    m "\"Oi pra você também, Cass.\""

# game/end_game2.rpy:393
translate pt_br end_game2_f32b5277:

    # "Cassius fixes me with a narrow-eyed glare."
    "Cassius me lança um olhar estreito."

# game/end_game2.rpy:395
translate pt_br end_game2_d9b06f11:

    # c "\"Since when did I give you permission to use my shortened name, human?\""
    c "\"Desde quando eu lhe dei permissão para usar meu nome abreviado, humano?\""

# game/end_game2.rpy:396
translate pt_br end_game2_0a23efe4:

    # "I shrug, simply adjusting my robe after having it disheveled from the collision."
    "Eu dou de ombros, simplesmente ajustando minha túnica depois dela ser bagunçada com a colisão."

# game/end_game2.rpy:397
translate pt_br end_game2_36eb5885:

    # m "\"How are you feeling?\""
    m "\"Como você tá se sentindo?\""

# game/end_game2.rpy:399
translate pt_br end_game2_07b191f7:

    # c "\"Changing the subject, I see. Well never mind. I'm feeling fine, thank you. I can at least eat solid foods now without retching, though I doubt I'll ever be able to drink wine again without doing so.\""
    c "\"Mudando de assunto, entendo. Bem, deixa para lá. Estou me sentindo ótimo, obrigado. Agora posso pelo menos comer alimentos sólidos sem vomitar, embora eu duvide que serei capaz de beber vinho outra vez sem que isso aconteça.\""

# game/end_game2.rpy:400
translate pt_br end_game2_623e858c:

    # m "\"I'm sorry to hear that.\""
    m "\"Sinto muito em ouvir isso.\""

# game/end_game2.rpy:402
translate pt_br end_game2_c389f91d:

    # c "\"I'm sure you are.\""
    c "\"Tenho certeza que sim.\""

# game/end_game2.rpy:403
translate pt_br end_game2_4f6bc2a8:

    # "I shake my head, wondering why the wolf has to be so sour all the time."
    "Eu balanço minha cabeça, me perguntando por que o lobo tem que ser tão amargo o tempo todo."

# game/end_game2.rpy:404
translate pt_br end_game2_f364dae6:

    # "Maybe it's a side-effect of always being second-in-line for everything."
    "Talvez seja um efeito colateral de sempre ser o segundo na fila para tudo."

# game/end_game2.rpy:405
translate pt_br end_game2_f62e233b:

    # "I see something similar in Neferu, they just go about handling it differently."
    "Eu vejo algo semelhante no Neferu, eles simplesmente lidam com isso de forma diferente."

# game/end_game2.rpy:406
translate pt_br end_game2_4f387644:

    # "Maybe it's also because of his illness, always seen as weak and needing help, and he reacted by being a dick."
    "Talvez seja também por causa da doença, sempre visto como fraco e precisando de ajuda, e ele reage agindo como um babaca."

# game/end_game2.rpy:407
translate pt_br end_game2_75512a28:

    # "Then again, it could just be because he {i}is{/i} a dick."
    "Por outro lado, pode ser simplesmente porque ele {i}é{/i} um babaca."

# game/end_game2.rpy:408
translate pt_br end_game2_c1f695ab:

    # m "\"So, uh, what are your plans now that—\""
    m "\"Então, hã... quais são seus planos agora que—\""

# game/end_game2.rpy:410
translate pt_br end_game2_c59ee696:

    # c "\"—Now that I've abdicated the throne and am leaving in disgrace?\""
    c "\"—Agora que abdiquei do trono e estou indo embora em desgraça?\""

# game/end_game2.rpy:411
translate pt_br end_game2_cd210691:

    # m "\"You're not leaving in disgrace, I think the people are going to be really—\""
    m "\"Você não tá \"indo embora em desgraça\", eu acho que as pessoas vão ficar realmente—\""

# game/end_game2.rpy:412
translate pt_br end_game2_3d85ed27:

    # c "\"I'm already being made fun of for being one of the shortest serving emperors in the history of the empire. I'm the main topic in all of the comedies at the moment.\""
    c "\"Já estou sendo ridicularizado por ser um dos menores imperadores da história do império. Eu sou o assunto principal em todas as comédias no momento.\""

# game/end_game2.rpy:413
translate pt_br end_game2_d1171c7d:

    # m "\"Ah.\""
    m "\"Ah.\""

# game/end_game2.rpy:415
translate pt_br end_game2_07f0be09:

    # "Cassius takes in a deep breath, closing his eyes."
    "Cassius respira fundo, fechando os olhos."

# game/end_game2.rpy:417
translate pt_br end_game2_cbf85703:

    # c "\"Anyway, [mc], I wanted to thank you.\""
    c "\"Enfim, [mc], eu queria falar com você.\""

# game/end_game2.rpy:418
translate pt_br end_game2_34dd85e0:

    # "I almost get whiplash from the sudden change in tone and topic."
    "Eu quase me sinto chicoteado pela mudança repentina de tom e assunto."

# game/end_game2.rpy:419
translate pt_br end_game2_df8ec4bc:

    # m "\"What?\""
    m "\"Que?\""

# game/end_game2.rpy:421
translate pt_br end_game2_f14c34eb:

    # c "\"Oh, don't make me say it again. I'm simply thankful for you putting the empire on a course that is...somewhat tolerable, at least.\""
    c "\"Ah, não me faça dizer outra vez. Eu estou simplesmente grato por você colocar o império em um curso que é... um pouco tolerável, pelo menos.\""

# game/end_game2.rpy:422
translate pt_br end_game2_6251f340:

    # m "\"As opposed to being ruled by Cato?\""
    m "\"Em vez de ser governado pelo Cato?\""

# game/end_game2.rpy:424
translate pt_br end_game2_e064fbf4:

    # c "\"Yes. While I might not believe that my brother is what is best for the empire, at least he cares for it, and I suppose that's all that I can hope for.\""
    c "\"Sim. Embora eu não acredite que meu irmão seja o melhor para o império, pelo menos se importa com ele, suponho que é tudo o que eu possa esperar.\""

# game/end_game2.rpy:425
translate pt_br end_game2_22a21ada:

    # m "\"Weren't you negotiating a position with Amicus?\""
    m "\"Você não tava negociando uma posição com o Amicus?\""

# game/end_game2.rpy:427
translate pt_br end_game2_e4b3eda3:

    # "Cassius looks at me suspiciously, though I have no idea why."
    "Cassius me olha desconfiado, embora eu não faça ideia do porquê."

# game/end_game2.rpy:428
translate pt_br end_game2_2352acfd:

    # "I suppose having almost being assassinated and also being sabotaged by everyone in the palace has made him a bit wary."
    "Suponho que quase ser assassinado e também sabotado por todo mundo no palácio tenha deixado ele um pouco cauteloso demais."

# game/end_game2.rpy:429
translate pt_br end_game2_f62f0546:

    # c "\"I suppose he'll tell you anyway, so yes, I'm looking to become the Chief of Social Affairs.\""
    c "\"Presumo que ele lhe dirá de qualquer maneira, então sim, estou procurando me tornar o chefe de questões sociais.\""

# game/end_game2.rpy:430
translate pt_br end_game2_9244ed78:

    # "He rolls his eyes at my lack of reaction."
    "Ele revira os olhos com a minha falta de reação."

# game/end_game2.rpy:432
translate pt_br end_game2_37fe3af9:

    # c "\"In other words, I will be making sure that Adastra's most vulnerable are taken care of, that all will someday receive the financial, social, and especially medical care that they need.\""
    c "\"Em outras palavras, assegurarei que a parte mais vulnerável da população de Adastra seja atendida, que todos receberão algum dia o auxílio financeiro, social e especialmente médico de que precisam.\""

# game/end_game2.rpy:433
translate pt_br end_game2_6e10c4fe:

    # "I perk up."
    "Eu me animo."

# game/end_game2.rpy:434
translate pt_br end_game2_bda8bda6:

    # m "\"Oh good! That's kind of what you were all about with your campaigning, right?\""
    m "\"Ah, que bom! Isso é tipo o que você tava querendo fazer na sua campanha, né?\""

# game/end_game2.rpy:436
translate pt_br end_game2_36f90952:

    # c "\"Yes, it will be nice to focus all my energy on that rather than the bothersome politics that come with being emperor. I don't envy Amicus.\""
    c "\"Sim, será ótimo concentrar toda minha energia nisso em vez da política incômoda que acompanha o cargo de imperador. Eu não invejo o Amicus.\""

# game/end_game2.rpy:437
translate pt_br end_game2_fae1d549:

    # "He eyes me closely."
    "Ele me olha de perto."

# game/end_game2.rpy:439
translate pt_br end_game2_55a29d8c:

    # c "\"I know you're very close with him, so please, if I must ask anything of you, it's to make sure that he does not forget those outside the Triumvir Cities.\""
    c "\"Eu sei que você é muito próximo dele, então por favor, se eu devo exigir qualquer coisa de você, é para garantir que ele não esqueça da população que vive fora das cidades-triunvirato.\""

# game/end_game2.rpy:440
translate pt_br end_game2_d0113423:

    # c "\"Their situation is desperate, and if we are truly going to reap fortune from an alliance, then they should be the first to benefit, not the Adastran elites.\""
    c "\"A situação deles é desesperadora, e se iremos realmente colher a fortuna de uma aliança, então eles devem ser os primeiros a se beneficiar, e não as elites adastrianas.\""

# game/end_game2.rpy:441
translate pt_br end_game2_39d5b9db:

    # "It's one of those rare moments that Cassius is being completely genuine with me, so I nod earnestly."
    "É um daqueles raros momentos em que Cassius é completamente genuíno comigo, então eu aceno com a cabeça seriamente."

# game/end_game2.rpy:442
translate pt_br end_game2_83b24450:

    # m "\"Of course.\""
    m "\"É claro.\""

# game/end_game2.rpy:443
translate pt_br end_game2_0be0c35c:

    # "I also plan on making sure that Amicus remembers the wolven children, and to right the wrongs of what the past rulers had done to them."
    "Também pretendo garantir que Amicus se lembre dos infantes lobinos e que corrija os erros que os governantes anteriores cometeram acerca deles."

# game/end_game2.rpy:445
translate pt_br end_game2_89bcea3a:

    # "There's a lull in the conversation, and I try to think of something to say, to thank Cassius for in return."
    "Há uma pausa na conversa e eu tento pensar em algo para dizer, para agradecer ao Cassius em troca."

# game/end_game2.rpy:446
translate pt_br end_game2_123574dc:

    # m "\"And, um, thank you for understanding our position, for deciding to step down when we asked.\""
    m "\"E, hã... obrigado por entender a nossa posição, por decidir renunciar quando a gente pediu.\""

# game/end_game2.rpy:448
translate pt_br end_game2_7741584b:

    # c "\"You threatened me with outright humiliation if I did not.\""
    c "\"Vocês me ameaçaram com a humilhação total caso eu não renunciasse.\""

# game/end_game2.rpy:449
translate pt_br end_game2_6c538681:

    # "I try to hold in a sigh of my own at the wolf's frustrating attitude, even if my attempt at some form of diplomacy with him was clumsy."
    "Eu tento reprimir um suspiro com o comportamento frustrante do lobo, mesmo que minha tentativa de alguma forma de diplomacia com ele tenha sido desajeitada."

# game/end_game2.rpy:450
translate pt_br end_game2_3bf5aa36:

    # m "\"Yeah, well, thanks anyway.\""
    m "\"É, verdade. Mas obrigado mesmo assim.\""

# game/end_game2.rpy:452
translate pt_br end_game2_276a9304:

    # "Cassius grunts noncommittally, then looks past me."
    "Cassius solta um grunhido descompromissado, depois olha para trás de mim."

# game/end_game2.rpy:453
translate pt_br end_game2_1f2153c9:

    # c "\"Anyway, I must be going to the city. I have an appointment.\""
    c "\"Enfim, devo ir para a cidade. Tenho um compromisso.\""

# game/end_game2.rpy:454
translate pt_br end_game2_0a95e931:

    # "That's when I remember Alex."
    "É quando eu me lembro do Alex."

# game/end_game2.rpy:455
translate pt_br end_game2_de606041:

    # "I never did see Cassius's reaction to finding out about the cat's treachery."
    "Eu nunca vi a reação do Cassius depois de descobrir sobre a traição do gato."

# game/end_game2.rpy:456
translate pt_br end_game2_2a2a54a1:

    # "Amicus had been furious when I told him, and I'd practically had to hold him back from marching out into the gardens and strangling the cat himself."
    "Amicus ficou furioso quando eu contei e praticamente precisei impedir que ele fosse até o jardim estrangular o gato ele mesmo."

# game/end_game2.rpy:457
translate pt_br end_game2_ea4b358e:

    # "He was especially furious when I told him that I'd made a deal with Alex to keep him from facing the consequences of sabotaging the entire empire."
    "Ele ficou especialmente furioso quando contei para ele que fiz um acordo com o Alex para evitar que ele enfrentasse as consequências por ter sabotado todo o império."

# game/end_game2.rpy:458
translate pt_br end_game2_a40b1901:

    # "Amicus had settled on banishing Alexios from the palace, to some high-security apartments in the center of Adastra City."
    "Amicus decidiu banir Alexios do palácio para algum apartamento de segurança máxima no centro da cidade de Adastra."

# game/end_game2.rpy:459
translate pt_br end_game2_9b0b067a:

    # "Cassius has been visiting him there ever since."
    "Cassius o tem visitado lá desde então."

# game/end_game2.rpy:460
translate pt_br end_game2_843caba9:

    # "While I don't know what the state of their relationship is, I suppose even high treason isn't enough to stop Cassius from seeing the cat again."
    "Embora eu não saiba qual é o estado do relacionamento deles, suponho que mesmo alta traição não seja suficiente para impedir Cassius de ver o gato novamente."

# game/end_game2.rpy:461
translate pt_br end_game2_f5473994:

    # "They must be pretty close, even closer than I'd initially thought."
    "Eles devem ser bem próximos, ainda mais próximos do que eu originalmente pensava."

# game/end_game2.rpy:462
translate pt_br end_game2_66edc6d8:

    # "I'm curious, but stop myself from asking, as I know that would only lead to more glares and sneers from the wolf."
    "Fiquei curioso, mas me impeço de perguntar sobre, pois sei que isso só provocaria mais olhares amargos e escárnios do lobo."

# game/end_game2.rpy:464
translate pt_br end_game2_0745edb7:

    # "So instead I bow and step aside, a bit surprised when Cassius bows in return, even if it's mostly just a half-hearted nod."
    "Então, em vez disso, me curvo e dou um passo para o lado, um pouco surpreso quando vejo Cassius curvar-se de volta, mesmo que seja apenas um aceno com a cabeça sem entusiasmo."

# game/end_game2.rpy:466
translate pt_br end_game2_600c20fe:

    # "I watch the white wolf disappear out through the main entrance, and I wait a few moments before taking the same route out into the gardens."
    "Observo o lobo branco desaparecer pela entrada principal e espero algum tempo antes de seguir o mesmo caminho para o jardim."

# game/end_game2.rpy:470
translate pt_br end_game2_c2f8da65:

    # "While the conversation with Cassius had distracted me for a bit, my mind wanders back to what Amicus had just told me."
    "Embora a conversa com Cassius tenha me distraído um pouco, minha mente volta para o que Amicus acabou de me contar."

# game/end_game2.rpy:471
translate pt_br end_game2_3bff8ca6:

    # "I can't stop the feeling of constriction that seems to wrap around me, bound to the will of these supposedly all-knowing creatures."
    "Não consigo parar a sensação de aperto que parece me amarrar, limitado à vontade dessas criaturas supostamente oniscientes."

# game/end_game2.rpy:472
translate pt_br end_game2_c575c8ee:

    # "I sit for a while on a bench, contemplating everything while my hand absently caresses my repaired neck."
    "Sento em um banco por um tempo, ponderando sobre tudo enquanto minha mão inconscientemente acaricia meu pescoço reparado."

# game/end_game2.rpy:473
translate pt_br end_game2_e7938bcb:

    # "I'd pressed a bit harder against the skin a few times, and didn't like the unfamiliar shapes and edges that I felt."
    "Pressionei um pouco mais forte contra a pele algumas vezes e não gostei das formas e bordas não familiares que senti."

# game/end_game2.rpy:474
translate pt_br end_game2_511ea7b4:

    # "I'd asked Amicus how the parents had done it, how they had the time to place the machinery in my neck, and also make me start breathing again."
    "Eu perguntei ao Amicus como os progenitores fizeram isso, como eles tiveram tempo de colocar o maquinário no meu pescoço e também me fazer respirar outra vez."

# game/end_game2.rpy:475
translate pt_br end_game2_47731c6b:

    # "But it turns out it's one of those parental-tech things that no one really understands."
    "É claro, acontece que essa é uma daquelas tecnologias de progenitor que ninguém realmente entende como funciona."

# game/end_game2.rpy:476
translate pt_br end_game2_f2015377:

    # "It seemed to have happened instantaneously, as if I'd been whisked away somewhere else to have surgery before being placed back in the archives."
    "Pareceu ter acontecido instantaneamente, como se eu tivesse sido levado para outro lugar e feito uma cirurgia antes de ser colocado de volta na sala do arquivo."

# game/end_game2.rpy:477
translate pt_br end_game2_b85396ef:

    # "Apparently when Amicus's father had asked the parents to restore Cato's sight, it had just happened overnight, the old wolf surprising everyone when he walked into the dining room with his brand new visor."
    "Aparentemente, quando o pai do Amicus pediu aos progenitores que restaurassem a visão do Cato, isso aconteceu da noite para o dia, o velho lobo surpreendendo a todos quando entrou na sala de jantar com seu novo visor."

# game/end_game2.rpy:478
translate pt_br end_game2_91b8c6f2:

    # "That had been over a decade ago."
    "Isso aconteceu há mais de uma década."

# game/end_game2.rpy:479
translate pt_br end_game2_4397a5a3:

    # "And that gets me wondering why the parents did that if they knew Cato would go on to do the things he did."
    "E isso faz eu me perguntar por que os progenitores fizeram isso se sabiam que Cato continuaria fazendo as coisas que fazia."

# game/end_game2.rpy:480
translate pt_br end_game2_1354e0f2:

    # "He blatantly got in the way of their plans."
    "Ele descaradamente atrapalhou o plano deles."

# game/end_game2.rpy:481
translate pt_br end_game2_022bac52:

    # "Why would they let him hold such an influential position in the empire, let alone restore his vision?"
    "Por que eles o deixariam ocupar uma posição tão influente no império, quanto mais restaurar sua visão?"

# game/end_game2.rpy:482
translate pt_br end_game2_b4ba0485:

    # "{i}Interference is to be kept to a minimum{/i} — I can practically hear the monitor say."
    "{i}Interferências devem acontecer o mínimo possível{/i} — Praticamente consigo ouvir o monitor dizer."

# game/end_game2.rpy:483
translate pt_br end_game2_f749c0de:

    # "I sigh, just sort of wishing that the parents didn't exist at all, that this {i}Other{/i} wasn't eating at the edges of our universe, which is apparently the root of all of this."
    "Eu suspiro, apenas desejando que os progenitores nem sequer existissem, que esses {i}Outros{/i} não estivessem comendo as bordas do nosso universo, o que aparentemente é a raiz de tudo isso."

# game/end_game2.rpy:484
translate pt_br end_game2_984fc457:

    # "That's something else that I don't understand."
    "Isso é outra coisa que eu não compreendo."

# game/end_game2.rpy:485
translate pt_br end_game2_d87ad4f1:

    # "From what I gathered, the {i}Galaxias{/i} had already known about the Other, just vaguely."
    "Pelo que entendi, a {i}congregação galáctica{/i} já tinha conhecimento dos Outros, apenas vagamente."

# game/end_game2.rpy:486
translate pt_br end_game2_be0c3486:

    # "Amicus had almost described it to me when I first arrived here and had been told that all life originated from the same source...except for the Other."
    "Amicus quase descreveu isso para mim quando eu cheguei aqui e ele me falou que toda vida se originou da mesma fonte... exceto pelos Outros."

# game/end_game2.rpy:487
translate pt_br end_game2_2d9e80af:

    # "A different type of life, so different from {i}us{/i} that we can barely understand {i}them{/i}."
    "Um tipo diferente de vida, tão diferente de {i}nós{/i} que mal conseguimos entender {i}eles{/i}."

# game/end_game2.rpy:488
translate pt_br end_game2_ec56416a:

    # "But now we know that they're out to get us, or something."
    "Mas agora sabemos que eles querem nos pegar, ou algo assim."

# game/end_game2.rpy:489
translate pt_br end_game2_5158943f:

    # "I just can't help but feel so distant from all of this, the result of the struggle between us and them being millennia away."
    "Eu simplesmente não consigo evitar me sentir tão distante de tudo isso, o resultado da luta entre nós e eles estando a milênios de dîstância."

# game/end_game2.rpy:490
translate pt_br end_game2_7e92c690:

    # "We don't even know {i}how{/i} many millennia."
    "Não sabemos nem {i}quantos{/i} milênios."

# game/end_game2.rpy:491
translate pt_br end_game2_663a3569:

    # "As I'm becoming more and more depressed over all of this, I hear footsteps on the path."
    "À medida que fico cada vez mais deprimido com tudo isso, ouço passos no caminho."

# game/end_game2.rpy:492
translate pt_br end_game2_ccef79e2:

    # "I look up, half-expecting to see Alex, even as I remember he's been banished from the palace."
    "Eu olho para cima, meio que esperando ver o Alex, mesmo enquanto lembro que ele foi banido do palácio."

# game/end_game2.rpy:493
translate pt_br end_game2_0b3d1b17:

    # "It's Neferu, and he's strolling along the pathways, paws behind his back with his usual suave smile plastered on his muzzle."
    "É o Neferu e ele passeia pelo caminho, patas atrás das costas com seu habitual sorriso suave estampado no focinho."

# game/end_game2.rpy:494
translate pt_br end_game2_9ace4164:

    # "I have to wonder how he keeps that expression on all the time, as it's clear he doesn't see me until he comes a bit closer."
    "Eu tenho que me perguntar como ele consegue manter essa expressão o tempo todo, pois fica claro que ele não me enxerga até se aproximar um pouco."

# game/end_game2.rpy:495
translate pt_br end_game2_5ae1c4e2:

    # "When he does spot me, his ears flick up and I get a glimpse of white teeth as his smile broadens."
    "Quando me vê, suas orelhas levantam e eu tenho um vislumbre de seus dentes brancos conforme seu sorriso se amplia."

# game/end_game2.rpy:496
translate pt_br end_game2_6e9a8576:

    # "I smile back, even though I'm not in the best mood to chat at the moment."
    "Eu sorrio de volta, apesar de não estar no melhor humor para conversar no momento."

# game/end_game2.rpy:497
translate pt_br end_game2_2c6e8da1:

    # "Still, I scoot over to make room on the bench, and Neferu greets me with a bow along with a \"Ahhotep be with you\" before he sits next to me, crossing one leg over the other."
    "Ainda assim, me desloco para deixar espaço no banco e Neferu me cumprimenta se curvando acompanhado de um \"Ahhotep esteja com você\" antes de se sentar ao meu lado, cruzando uma perna por cima da outra."

# game/end_game2.rpy:499
translate pt_br end_game2_0a432623:

    # n "\"Beautiful day.\""
    n "\"Lindo dia.\""

# game/end_game2.rpy:500
translate pt_br end_game2_6e7dcc8a:

    # "He says it wistfully, and I just nod in agreement."
    "Ele fala isso melancolicamente e eu apenas aceno com a cabeça em concordância."

# game/end_game2.rpy:502
translate pt_br end_game2_4f0c5f4c:

    # n "\"Though I can see that you're not enjoying it as much as I am. Is everything alright, [mc]?\""
    n "\"Embora eu consiga notar que você não está aproveitando tanto quanto eu. Está tudo bem, [mc]?\""

# game/end_game2.rpy:503
translate pt_br end_game2_5d1f8647:

    # "I'm about to give him a generic answer before I sigh, leaning back on the bench."
    "Fico prestes a dar uma resposta genérica antes de suspirar, me encostando no banco."

# game/end_game2.rpy:504
translate pt_br end_game2_54015def:

    # m "\"No...no, not really, Neferu.\""
    m "\"Não... não, na verdade não, Neferu.\""

# game/end_game2.rpy:506
translate pt_br end_game2_bf3db091:

    # n "\"Ah, I find that a bit surprising considering the way things have gone the past few days.\""
    n "\"Ah, acho isso um pouco surpreendente considerando o andamento das coisas nos últimos dias.\""

# game/end_game2.rpy:507
translate pt_br end_game2_8619f2c6:

    # "I shrug."
    "Eu dou de ombros."

# game/end_game2.rpy:508
translate pt_br end_game2_d2976e4a:

    # m "\"I mean, aside from almost dying, I guess everything here is good, but out there—\""
    m "\"Quer dizer, além de quase ter morrido, acho que tá tudo bem por aqui, mas lá fora—\""

# game/end_game2.rpy:509
translate pt_br end_game2_0b8d64ac:

    # "I nod up at the sky, at space."
    "Eu aceno para o céu, na direção do espaço."

# game/end_game2.rpy:510
translate pt_br end_game2_a0c62d5e:

    # m "\"I just don't know what to do.\""
    m "\"Eu só não sei o que fazer.\""

# game/end_game2.rpy:512
translate pt_br end_game2_8420473b:

    # n "\"Perhaps I could offer some advice?\""
    n "\"Talvez eu poderia te dar alguns conselhos?\""

# game/end_game2.rpy:513
translate pt_br end_game2_fe10ab79:

    # m "\"Uh...\""
    m "\"Hã...\""

# game/end_game2.rpy:514
translate pt_br end_game2_c985aa82:

    # "I remember that Amicus had told me to keep the revelations about human civilization a secret, at least until the parents give further instruction."
    "Me lembro que Amicus me disse para manter as revelações sobre a civilização humana em segredo, pelo menos até que os progenitores dessem mais instruções."

# game/end_game2.rpy:515
translate pt_br end_game2_a35ef469:

    # m "\"I don't know. I think I'm just stressed about going home, about how I'm gonna do it, ya know?\""
    m "\"Eu não sei. Acho que só tô estressado sobre ir pra casa, em como vou fazer isso, sabe?\""

# game/end_game2.rpy:517
translate pt_br end_game2_2c01e597:

    # n "\"Ah, I definitely understand, for I am in a similar boat. Unfortunately, I have little advice on that particular matter.\""
    n "\"Ah, definitivamente entendo, pois estou no mesmo barco. Infelizmente, tenho poucos conselhos sobre esse assunto em específico.\""

# game/end_game2.rpy:518
translate pt_br end_game2_65e307a9:

    # "I glance over at him, watching as he rhythmically bounces a black foot about, wiggling the toes and claws."
    "Eu olho para ele, observando enquanto ele balança um pé em uma espécie de ritmo, mexendo os dedos dos pés e as garras."

# game/end_game2.rpy:519
translate pt_br end_game2_bfb739ef:

    # m "\"Is Khemia still pissed about what happened?\""
    m "\"Khemia ainda tá pê da vida com o que aconteceu?\""

# game/end_game2.rpy:521
translate pt_br end_game2_ef902cd9:

    # n "\"Oh yes, furious. They're still threatening to cut all diplomatic relations with Adastra if Amicus doesn't make things right somehow.\""
    n "\"Ah, sim, furiosos. Eles ainda estão ameaçando cortar todas as relações diplomáticas com Adastra se Amicus não acertar as coisas de alguma maneira.\""

# game/end_game2.rpy:522
translate pt_br end_game2_77f4659f:

    # m "\"Make things right?\""
    m "\"Acertar as coisas?\""

# game/end_game2.rpy:524
translate pt_br end_game2_40c090ab:

    # n "\"Yes, despite the fact that my family very nearly despises me, they actually despise that our name has been sullied by wolven disrespect.\""
    n "\"Sim, apesar do fato da minha família quase me desprezar, eles na verdade estão mais preocupados que nosso nome tenha sido manchado com o desrespeito lobino.\""

# game/end_game2.rpy:525
translate pt_br end_game2_e5f5675c:

    # m "\"How you were almost executed?\""
    m "\"Por você quase ter sido executado?\""

# game/end_game2.rpy:527
translate pt_br end_game2_7b51d250:

    # n "\"That, and also the fact that Cato released the footage of his attack on my person before the scheduled execution. It's been in heavy rotation on the news channels ever since.\""
    n "\"Isso, e também o fato de que Cato divulgou as filmagens de seu ataque à minha pessoa antes de agendar a execução. Está sendo fortemente repassado nos canais de notícia desde então.\""

# game/end_game2.rpy:528
translate pt_br end_game2_89357ba6:

    # m "\"Oh...\""
    m "\"Ah...\""

# game/end_game2.rpy:529
translate pt_br end_game2_ab47f2cb:

    # "I haven't watched much Adastran TV after seeing the reenactments of my own death, so I guess I've been missing Neferu getting kicked in the balls over and over again."
    "Não assisti muita TV Adastriana depois de ver as encenações da minha própria morte, então acho que perdi a cena do Neferu levanto um chute no saco passando de novo e de novo."

# game/end_game2.rpy:530
translate pt_br end_game2_90beb000:

    # m "\"Uh...well, you know wolves. They just like any sort of drama.\""
    m "\"Ah...é, você conhece os lobos. Eles só apreciam qualquer tipo de drama.\""

# game/end_game2.rpy:532
translate pt_br end_game2_ea693e66:

    # n "\"It's been spread across the entire {i}Galaxias{/i}. I suppose seeing a Khemian in such a position is rather amusing to everyone, siblings and children alike.\""
    n "\"Foi espalhado por toda a {i}congregação galáctica{/i}. Suponho que ver um khemiano em tal posição seja divertido para todos, irmãos e infantes.\""

# game/end_game2.rpy:533
translate pt_br end_game2_70b8d467:

    # "I look over at Neferu again, but his light, care-free demeanor continues as he simply seems to be soaking in the scenery."
    "Olho para o Neferu de novo, mas seu comportamento leve e sem preocupações continua enquanto ele parece estar mergulhando no cenário."

# game/end_game2.rpy:534
translate pt_br end_game2_aaaf2aef:

    # m "\"Are you doing alright?\""
    m "\"Você tá de boa com isso?\""

# game/end_game2.rpy:536
translate pt_br end_game2_a5f89165:

    # "Neferu looks at me then, smile becoming a bit more warm."
    "Então, Neferu olha para mim, seu sorriso ficando um pouco mais caloroso."

# game/end_game2.rpy:538
translate pt_br end_game2_d577863d:

    # n "\"I am fine, [mc], but if I'm being truthful, I {i}am{/i} embarrassed, but that's nothing new for me.\""
    n "\"Eu estou bem, [mc], embora sendo sincero, me {i}sinto{/i} envergonhado, mas isso não é novidade para mim.\""

# game/end_game2.rpy:539
translate pt_br end_game2_e499761a_1:

    # "I frown."
    "Eu arqueio as sobrancelhas."

# game/end_game2.rpy:540
translate pt_br end_game2_f9eefcb4:

    # m "\"I can count the number of times I've seen you embarrassed on one hand, Neferu. You're downright shameless.\""
    m "\"Eu consigo contar o número de vezes que eu te vi com vergonha em uma mão, Neferu. Você é completamente sem vergonha.\""

# game/end_game2.rpy:541
translate pt_br end_game2_4012b079:

    # "I smile to lighten the words, and Neferu just chuckles."
    "Eu sorrio para aliviar as palavras e Neferu apenas ri de volta."

# game/end_game2.rpy:543
translate pt_br end_game2_5172f9fb:

    # n "\"You probably know by this point that I'm not often genuine. It comes with being a diplomat and the Pharaoh's son.\""
    n "\"Você provavelmente já sabe a essa altura que eu não sou genuíno com frequência. Consequência de ser um diplomata e filho do faraó.\""

# game/end_game2.rpy:545
translate pt_br end_game2_92e8d4a1:

    # "There's a lull in the conversation as we both just watch the gardens, listening to the birds and watching the bees hover from flower to flower."
    "Há uma pausa na conversa enquanto nós dois apenas observamos o jardim, ouvindo os pássaros e assistindo às abelhas pousando de flor em flor."

# game/end_game2.rpy:546
translate pt_br end_game2_20c75519:

    # "That's when I'm reminded of something."
    "É quando eu me lembro de uma coisa."

# game/end_game2.rpy:547
translate pt_br end_game2_f0b86e3b:

    # m "\"So...what made the Khemians want to start an alliance? Isn't it pretty groundbreaking for siblings to work together. Like isn't that against the purpose of the {i}Galaxias{/i}?\""
    m "\"Então... o que fez os khemianos quererem começar uma aliança, não é muito fora do comum pros irmãos trabalharem juntos? Tipo, isso não vai contra o propósito da {i}congregação galáctica{/i}?\""

# game/end_game2.rpy:548
translate pt_br end_game2_1232547c:

    # "I play dumb, like I don't already know it isn't."
    "Faço a egípcia, como se não soubesse da resposta."

# game/end_game2.rpy:549
translate pt_br end_game2_d9d3c2b9:

    # "Neferu quirks an eyebrow at me."
    "Neferu levanta uma sobrancelha para mim."

# game/end_game2.rpy:551
translate pt_br end_game2_eb9e8fab:

    # n "\"That's a surprising question. Well, to put it simply, we studied the earliest histories of the {i}Galaxias{/i} and came to the conclusion that it was never the intent of the parents for us to be competitors.\""
    n "\"Esta é uma pergunta surpreendente. Bem, simplificando, nós estudamos as histórias mais antigas da {i}congregação galáctica{/i} e chegamos à conclusão de que nunca foi a intenção dos progenitores que nós competíssemos.\""

# game/end_game2.rpy:552
translate pt_br end_game2_e66e99bf:

    # n "\"If you don't know, the goal of a sibling race and its children is to achieve parental status. To do that we must be able to achieve intergalactic travel.\""
    n "\"Se você não sabe, o objetivo de uma raça da irmandade e seus infantes é alcançar o status de progenitor. Para fazer isso, devemos ser capazes de realizar viagens intergalácticas.\""

# game/end_game2.rpy:553
translate pt_br end_game2_1f82f7b4:

    # n "\"We're...slowly realizing that this may not be possible without the cooperation of all sapient life in the Galaxy.\""
    n "\"Estamos... lentamente percebendo que isso talvez não seja possível sem a cooperação de toda vida sapiente na galáxia.\""

# game/end_game2.rpy:554
translate pt_br end_game2_076d574a:

    # "I nod in understanding."
    "Eu aceno em concordância."

# game/end_game2.rpy:555
translate pt_br end_game2_0d6df9c5:

    # "So it seems like the Khemians were already hip to this grand plan, either by actually figuring it out themselves, or with the help of their own parent."
    "Então parece que os khemianos já estavam de acordo com esse grande plano, ou realmente descobrindo eles mesmos, ou com a ajuda do próprio progenitor."

# game/end_game2.rpy:556
translate pt_br end_game2_f722b24f:

    # "This makes me wonder if they might know more about the thing lingering on the edges of the universe."
    "Isso me faz pensar se eles podem saber mais sobre a coisa espreitando nas bordas do universo."

# game/end_game2.rpy:557
translate pt_br end_game2_3283e36f:

    # m "\"Do you know much about the Other?\""
    m "\"Você sabe muito sobre os Outros?\""

# game/end_game2.rpy:558
translate pt_br end_game2_79d2a3a9:

    # "Now Neferu turns on the bench to really look at me, furrowing his brows."
    "Agora Neferu se vira no banco para realmente olhar para mim, arqueando as sobrancelhas."

# game/end_game2.rpy:560
translate pt_br end_game2_17c1aa78:

    # n "\"Another interesting question. Did you have some sort of experience with the parents when they healed your wounds?\""
    n "\"Outra pergunta interessante. Você teve algum tipo de experiência com os progenitores quando eles curaram suas feridas?\""

# game/end_game2.rpy:561
translate pt_br end_game2_b5dbb0ef:

    # m "\"Uh, yeah, kind of. Just really vague stuff, so I'm just curious about it is all.\""
    m "\"Sim, mais ou menos. Só um monte de coisas bem vagas, então eu fiquei curioso, só isso.\""

# game/end_game2.rpy:562
translate pt_br end_game2_977229b4:

    # "I try to make it sound like it's not a big deal."
    "Eu tento fazer parecer como se não fosse grande coisa."

# game/end_game2.rpy:565
translate pt_br end_game2_703661ec:

    # n "\"Hmm...well, it is an...entity that spreads through the universe every few billion years. It originated from somewhere other than the original source of life, the source from which we all came.\""
    n "\"Hmm... bem, é uma... entidade que se espalha através do universo a cada poucos bilhões de anos. Originou-se de outro lugar que não a fonte original da vida, a fonte da qual todos viemos.\""

# game/end_game2.rpy:566
translate pt_br end_game2_0e4ddfa6:

    # "His choice of words is confusing me."
    "A escolha de palavras dele me confunde."

# game/end_game2.rpy:567
translate pt_br end_game2_dc20acbf:

    # m "\"Is it like, alive?\""
    m "\"E é, tipo, viva?\""

# game/end_game2.rpy:569
translate pt_br end_game2_700f6858:

    # n "\"Is it alive like you and I? No, not really. It is more of a...machine, I suppose. On the edge of life, but it needs sapient life to exist.\""
    n "\"Se é viva como você e eu? Não, não exatamente. É mais como uma... máquina, creio eu. No limite da vida, mas precisa de vida sapiente para existir.\""

# game/end_game2.rpy:570
translate pt_br end_game2_e350fc39:

    # m "\"Oh, like a virus?\""
    m "\"Ah, tipo um virus?\""

# game/end_game2.rpy:572
translate pt_br end_game2_8b173763:

    # n "\"Yes, though even viruses originated from the original source. The Other is truly something different.\""
    n "\"Sim, embora até os vírus tenham surgido da fonte original. Os Outros realmente são algo diferente.\""

# game/end_game2.rpy:573
translate pt_br end_game2_47275cb7:

    # m "\"And it feeds on life? Our life, I mean?\""
    m "\"E se alimenta da vida? Nossa vida?\""

# game/end_game2.rpy:575
translate pt_br end_game2_972a9b6a:

    # n "\"First I should say that what we know about it is very, very limited, and the majority of that information is likely wrong; really just ghost stories.\""
    n "\"Primeiramente, devo dizer que o que sabemos sobre eles é muito, muito limitado, e grande parte da informação provavelmente está errada; apenas histórias de fantasmas, na verdade.\""

# game/end_game2.rpy:576
translate pt_br end_game2_a1e6df79:

    # m "\"Well, what are these ghost stories?\""
    m "\"E que histórias de fantasmas são essas?\""

# game/end_game2.rpy:578
translate pt_br end_game2_0d30241f:

    # "Neferu sighs and I realize that he's not exactly interested in this topic."
    "Neferu suspira e eu percebo que ele não está exatamente interessado no assunto."

# game/end_game2.rpy:579
translate pt_br end_game2_2f6b2350:

    # n "\"How to put it...well, it's thought that in the half dozen or so times that the Other has spread through our part of the universe, it has left behind small, patchy portions of itself.\""
    n "\"Como posso explicar... bem, pensa-se que na meia dúzia de vezes ou mais que os Outros se espalharam através de nossa parte do universo, eles deixaram para trás pequenas porções irregulares de si mesmos.\""

# game/end_game2.rpy:580
translate pt_br end_game2_58235895:

    # n "\"It is technically all around us, but very weak, though it is thought that highly concentrated portions of it attach to tangible things, or occasionally pass through us.\""
    n "\"Tecnicamente estão por toda parte, mas muito fracos, embora se pense que partes altamente concentradas deles se conectam a coisas tangíveis, ou ocasionalmente passam através de nós.\""

# game/end_game2.rpy:581
translate pt_br end_game2_5346a6ed:

    # "I feel a little tingle down my spine."
    "Sinto um pequeno arrepio nas minhas costas."

# game/end_game2.rpy:582
translate pt_br end_game2_3ac21f16:

    # m "\"And what does it do?\""
    m "\"E o que eles fazem?\""

# game/end_game2.rpy:583
translate pt_br end_game2_aafda3e6:

    # "Neferu shakes his head."
    "Neferu balança a cabeça."

# game/end_game2.rpy:585
translate pt_br end_game2_5b5ca65a:

    # n "\"I'm sure your people have stories of phenomena that are unexplainable? Perhaps an abandoned building that is inhabited by malicious spirits? Possibly a creature that defies all logical explanation, yet sporadically appears in a particular forest?\""
    n "\"Tenho certeza que seu povo tem histórias de fenômenos inexplicáveis? Talvez um prédio abandonado que é habitado por espíritos maliciosos? Possivelmente uma criatura que desafia toda explicação lógica, mas esporadicamente aparece em uma floresta em particular?\""

# game/end_game2.rpy:586
translate pt_br end_game2_703ac1f3:

    # m "\"Wait, like supernatural stuff?\""
    m "\"Espera, tipo coisas sobrenaturais?\""

# game/end_game2.rpy:587
translate pt_br end_game2_0a855e13:

    # "I give the jackal an incredulous look, and he shrugs and laughs."
    "Eu lanço um olhar incrédulo no chacal e ele dá de ombros e ri."

# game/end_game2.rpy:589
translate pt_br end_game2_bb9119e6:

    # n "\"So the stories say.\""
    n "\"Dizem as histórias.\""

# game/end_game2.rpy:590
translate pt_br end_game2_8501494f:

    # n "\"They also say that sapient consciousness is used by the Other to project these manifestations, and that the sapient's reaction to these projections feeds the entity.\""
    n "\"Elas também dizem que consciência sapiente é utilizada pelos Outros para projetar essas manifestações e que a reação dos sapientes a estas projeções alimentam a entidade.\""

# game/end_game2.rpy:592
translate pt_br end_game2_b954020a:

    # n "\"Personally, I feel that the legends surrounding the Other are simply a catch-all for anything that is feared, or poorly understood...or just the product of a bored society.\""
    n "\"Pessoalmente, sinto que as lendas acerca dos Outros são simplesmente uma peça essencial para qualquer coisa que é temida ou mal compreendida... ou apenas o produto de uma sociedade entediada.\""

# game/end_game2.rpy:593
translate pt_br end_game2_fbed8d77:

    # "I think back to what little I know about ghosts, monsters...even aliens or UFOs, and immediately, the idea is too ridiculous for me to accept."
    "Penso no pouco que conheço sobre fantasmas, monstros... até aliens ou OVNIs, e imediatamente a ideia é muito ridícula para que eu aceite."

# game/end_game2.rpy:594
translate pt_br end_game2_73d153b6:

    # m "\"Why haven't I heard of this while I've been here?\""
    m "\"Por que eu não ouvi falar disso enquanto estive aqui?\""

# game/end_game2.rpy:596
translate pt_br end_game2_dda1de9f:

    # n "\"You probably have, but just didn't understand the topic at the time. Either way, it's never a serious worry on anyone's mind considering how rarely this entity makes contact with our side of the universe.\""
    n "\"Você provavelmente já ouviu, apenas não entendia sobre o assunto na época. De qualquer forma, nunca é uma preocupação séria para a mente de ninguém, considerando quão raramente essa entidade faz contato com nosso lado do universo.\""

# game/end_game2.rpy:598
translate pt_br end_game2_ba12d96d:

    # "I just stare at the ground, not really sure of what to say."
    "Eu simplesmente olho para o chão, não tendo certeza do que dizer."

# game/end_game2.rpy:599
translate pt_br end_game2_ae49887e:

    # "Like Neferu, I find myself not very interested in the topic anymore, and our discussion moves on."
    "Assim como o Neferu, não me sinto mais interessado no assunto e nossa discussão segue em frente."

# game/end_game2.rpy:600
translate pt_br end_game2_aba5ed15:

    # "We talk of Neferu's plans; when he might return home, and how I might help him secure the alliance."
    "Falamos sobre os planos dele; quando ele poderá voltar para casa e como eu posso ajudá-lo a garantir a aliança."

# game/end_game2.rpy:601
translate pt_br end_game2_2375d7f2:

    # "Eventually, he gets up to return to his room for a nap, leaving me to sit on the bench in silence."
    "Eventualmente, ele se levanta para retornar ao seu quarto e tirar uma soneca, me restando sentar no banco em silêncio."

# game/end_game2.rpy:603
translate pt_br end_game2_1f2b8b9c:

    # "If I'm being honest, the conversation has left me feeling even less convinced by this intergalactic war the parents are apparently getting ready for."
    "Para falar a verdade, essa conversa fez eu me sentir ainda menos convencido sobre essa guerra intergaláctica para a qual os progenitores estão aparentemente se preparando."

# game/end_game2.rpy:604
translate pt_br end_game2_c182a8b3:

    # "It sounds more like we're getting ready to fight off an army of space ghosts rather than anything real."
    "Soa mais como se nós estivéssemos nos preparando para combater um exército de fantasmas espaciais em vez de algo real."

# game/end_game2.rpy:605
translate pt_br end_game2_1b360c0c:

    # "I sit there for a long while, opening my mind a bit, kind of hoping that the Monitor will swing by and dump a little more information on me that I can work with, even though I know that's not really in his nature."
    "Eu fico sentado por um longo tempo, abrindo um pouco minha mente, meio que esperando o monitor dar um oi e despejar em mim um pouco mais de informação que eu possa usar, mesmo sabendo que isso não é realmente da natureza dele."

# game/end_game2.rpy:606
translate pt_br end_game2_a7cb6344:

    # "Things stay predictably quiet, and as I'm thinking about heading back to Amicus's room to see if he's returned, Com's voice makes me jump."
    "As coisas ficam previsivelmente silenciosas, e quando começo a pensar em voltar ao quarto do Amicus para checar se ele retornou, a voz do Com me assusta."

# game/end_game2.rpy:607
translate pt_br end_game2_5b8599ca:

    # com "\"Amicus would like to let you know that he is currently in the bath, and if you would like to, you can join him. However, he wants to make it explicitly clear that it is your choice and that if you need more time—\""
    com "\"Amicus gostaria que você soubesse que ele está atualmente na sala de banhos, e caso queira, pode se juntar a ele. Entretanto, ele quer deixar explicitamente claro que a escolha é sua e que se você precisar de mais tempo—\""

# game/end_game2.rpy:608
translate pt_br end_game2_bd81624d:

    # m "\"Thanks Com, I'll head there now.\""
    m "\"Obrigado, Com, eu vou pra lá agora.\""

# game/end_game2.rpy:609
translate pt_br end_game2_520b085c:

    # com "\"Yes, [mc].\""
    com "\"Sim, [mc].\""

# game/end_game2.rpy:614
translate pt_br end_game2_98df30cf:

    # "I immediately spot Amicus as the door slides open, and I see the wolf jolt up from leaning back against the edge of the pool before quickly leaning back again, raising a paw casually."
    "Eu imediatamente me deparo com o Amicus quando a porta se abre e vejo o lobo levantar do descanso na beira da banheira rapidamente antes de voltar a se encostar outra vez, levantando uma pata casualmente."

# game/end_game2.rpy:615
translate pt_br end_game2_bb8aede0:

    # "I walk through the steamy air to stand behind Amicus, next to the bench and he looks back at me with a gentle smile."
    "Eu ando pelo ar fumegante até ficar atrás do Amicus, próximo ao banco, e ele olha de volta para mim com um sorriso gentil."

# game/end_game2.rpy:617
translate pt_br end_game2_9b769784:

    # a "\"Soak with me?\""
    a "\"Mergulha comigo?\""

# game/end_game2.rpy:618
translate pt_br end_game2_de155dd5:

    # "I nod wordlessly and slip out of my robes and underwear before walking to the edge of the pool."
    "Eu aceno com a cabeça sem palavras e tiro minhas roupas e cueca antes de caminhar até a beira da banheira."

# game/end_game2.rpy:619
translate pt_br end_game2_f353b0d0:

    # "With a little hop, I dip in quietly all at once, mostly used to the scalding temperature at this point."
    "Com um pequeno salto, mergulho silenciosamente de uma vez, já acostumado com a temperatura escaldante a essa altura."

# game/end_game2.rpy:620
translate pt_br end_game2_d1fbdbb5:

    # "As I come up, Amicus reaches out to me and I press up next to him, fitting against the curve of his chest in that familiar, easy way."
    "À medida que subo à superfície, Amicus me alcança e eu me pressiono contra ele, me encaixando na curva de seu peito daquele jeito fácil e familiar."

# game/end_game2.rpy:621
translate pt_br end_game2_c5f40fc4:

    # m "\"How was the meeting with the triumvirates?\""
    m "\"Como foi o encontro com os triunviratos?\""

# game/end_game2.rpy:623
translate pt_br end_game2_6c5c9964:

    # a "\"Good, good. Lots of seemingly pointless talk and etiquette, but as you and I know, it's necessary.\""
    a "\"Bom, bom. Muita conversa fiada e etiqueta, mas como você e eu sabemos, é necessário.\""

# game/end_game2.rpy:624
translate pt_br end_game2_5fc9fc28:

    # m "\"As long as there aren't any riots.\""
    m "\"Contanto que não haja nenhum motim.\""

# game/end_game2.rpy:625
translate pt_br end_game2_c653a8ed:

    # a "\"Yes, as long as there aren't any of those.\""
    a "\"Sim, contanto que não haja nenhum desses.\""

# game/end_game2.rpy:626
translate pt_br end_game2_8369e5f5:

    # "We sit in the hot water for a while, and I enjoy the way it makes my worries seem so far away, locked behind the doors to the bath."
    "Ficamos sentados na água quente por um tempo e eu aprecio a forma como ela faz minhas preocupações parecerem tão distantes, trancadas fora das portas da sala de banhos."

# game/end_game2.rpy:627
translate pt_br end_game2_a7540760:

    # "I should do this more often."
    "Eu deveria fazer isso com mais frequência."

# game/end_game2.rpy:628
translate pt_br end_game2_c2120147:

    # "But, of course, it's the main thing on Amicus's mind right now."
    "Mas é claro, é o principal assunto ruminando na mente do Amicus agora."

# game/end_game2.rpy:629
translate pt_br end_game2_e1c69ba5:

    # "He clears his throat nervously."
    "Ele pigarreia nervosamente."

# game/end_game2.rpy:631
translate pt_br end_game2_3a8cb532:

    # a "\"Um...how did thinking about, uh...I mean, did you make your deci—no, sorry...\""
    a "\"Hã... você pensou sobre, é... digo, você tomou sua deci—não, desculpe...\""

# game/end_game2.rpy:632
translate pt_br end_game2_14574e09:

    # "Amicus trails off in the most awkward way possible, and I laugh a little bit, though it's more of a sad laugh."
    "Amicus interrompe a frase da maneira mais desajeitada possível e isso me faz rir um pouco, embora seja mais uma risada triste."

# game/end_game2.rpy:633
translate pt_br end_game2_7e4308ed:

    # m "\"A little, but...I really don't know, Amicus. I just...\""
    m "\"Um pouco, mas... eu realmente não sei, Amicus. Eu só...\""

# game/end_game2.rpy:635
translate pt_br end_game2_ac29148e:

    # a "\"Do what you feel is right—\""
    a "\"Faça o que sentir que é certo—\""

# game/end_game2.rpy:636
translate pt_br end_game2_27b25bb8:

    # m "\"The whole reason we met is because of this purpose they've given me, and I really don't want to cause delays, or drag some other human into this, but something feels really off about this.\""
    m "\"Toda a razão pela qual a gente se conheceu foi por causa desse propósito que eles me deram e eu realmente não quero causar nenhum atraso ou arrastar outro humano pra essa situação, mas algo parece realmente errado sobre isso.\""

# game/end_game2.rpy:637
translate pt_br end_game2_7b6e451a:

    # "Amicus nods."
    "Amicus assente."

# game/end_game2.rpy:639
translate pt_br end_game2_3a32041d:

    # a "\"Well, I don't believe that you should be forced to take on duties that were thrust upon you without your consent. It's cruel, and I want you to choose what you feel is right.\""
    a "\"Bem, não acho que você deveria ser forçado a assumir tarefas que lhe foram impostas sem o seu consentimento. É cruel e quero que você escolha o que achar certo.\""

# game/end_game2.rpy:640
translate pt_br end_game2_9be73704:

    # "I give Amicus a look."
    "Eu levanto uma sobrancelha para o Amicus."

# game/end_game2.rpy:641
translate pt_br end_game2_bb0ee4d7:

    # m "\"Hasn't that been {i}your{/i} whole life?\""
    m "\"{i}Sua{/i} vida inteira não tem sido assim?\""

# game/end_game2.rpy:643
translate pt_br end_game2_76ce095d:

    # a "\"Well...yes, but I'm talking about {i}you{/i}.\""
    a "\"Bem... sim, mas eu estou falando sobre {i}você{/i}.\""

# game/end_game2.rpy:644
translate pt_br end_game2_393dd690:

    # "I smirk."
    "Eu dou um sorriso pretensioso."

# game/end_game2.rpy:645
translate pt_br end_game2_78b01f05:

    # m "\"Oh, I see. The silly, dumb ape who can't handle big boy responsibilities.\""
    m "\"Ah, entendo. O macaco bobo que não consegue lidar com responsabilidades de garotão.\""

# game/end_game2.rpy:647
translate pt_br end_game2_f1ee0ee8:

    # "Amicus's reaction to my teasing is instant and visceral."
    "A reação do Amicus à minha provocação é instantânea e visceral."

# game/end_game2.rpy:649
translate pt_br end_game2_21f03b97:

    # a "\"No! I would never—\""
    a "\"Não! eu nunca—\""

# game/end_game2.rpy:650
translate pt_br end_game2_73548c05:

    # m "\"Sorry! I was just kidding. I shouldn't make fun about that.\""
    m "\"Desculpa! Relaxa, eu só tava brincando. Não devia fazer piada com isso.\""

# game/end_game2.rpy:651
translate pt_br end_game2_423fbd29:

    # "Amicus settles back again, still looking concerned."
    "Amicus se recupera, mas ainda parecendo preocupado."

# game/end_game2.rpy:653
translate pt_br end_game2_0935d879:

    # a "\"It's alright. I just don't want you to ever feel that way again.\""
    a "\"Está tudo bem. Eu só não quero que você se sinta daquele jeito outra vez.\""

# game/end_game2.rpy:654
translate pt_br end_game2_6d85daed:

    # "Amicus sighs deeply."
    "Amicus suspira profundamente."

# game/end_game2.rpy:656
translate pt_br end_game2_bd018e14:

    # a "\"Also, I do believe we would have met somehow even without the parents intervening.\""
    a "\"E também, acredito que nós teríamos nos conhecido de alguma forma mesmo sem a intervenção dos progenitores.\""

# game/end_game2.rpy:657
translate pt_br end_game2_1e36bee6:

    # "Now I really give Amicus a look."
    "Agora minha sobrancelha realmente ganha vida própria."

# game/end_game2.rpy:658
translate pt_br end_game2_1cdd7b14:

    # m "\"Seriously?\""
    m "\"Sério?\""

# game/end_game2.rpy:660
translate pt_br end_game2_a1bc440b:

    # a "\"Of course. Something this special can't be stopped by the likes of time and space.\""
    a "\"É claro. Algo tão especial não pode ser parado pelo tempo e espaço.\""

# game/end_game2.rpy:661
translate pt_br end_game2_1e5e40d3:

    # "Amicus starts pulling me into his body, nuzzling me."
    "Amicus começa a me puxar contra seu corpo, me aconchegando."

# game/end_game2.rpy:662
translate pt_br end_game2_2cd4a0df:

    # m "\"Anyway, I'm not completely sure yet. I need time to think about it, and we do have nine months.\""
    m "\"Enfim, eu ainda não tenho certeza. Preciso de tempo pra pensar sobre isso, e a gente tem nove meses.\""

# game/end_game2.rpy:663
translate pt_br end_game2_0677976a:

    # a "\"Take your time, but...but on the off chance that you do choose to go, you must promise me one thing.\""
    a "\"Leve o tempo que precisar, mas... mas na remota possibilidade de você escolher ir embora, tem que me prometer uma coisa.\""

# game/end_game2.rpy:664
translate pt_br end_game2_4db4f382:

    # "I feel a little apprehension at that."
    "Me sinto um pouco apreensivo com isso."

# game/end_game2.rpy:665
translate pt_br end_game2_e2d30ef3:

    # m "\"Yes?\""
    m "\"Sim?\""

# game/end_game2.rpy:667
translate pt_br end_game2_8e130891:

    # a "\"Well, eight years is quite a while for a human lifespan so, I know you rejected them initially, but please start taking the life-extension medication.\""
    a "\"Bem, oito anos é bastante tempo para uma vida humana e eu sei que você rejeitou inicialmente, mas por favor, comece a tomar a medicação para prolongar a expectativa de vida.\""

# game/end_game2.rpy:669
translate pt_br end_game2_56d57b96:

    # a "\"There is a formula especially for primates. I need you around for as long as I am, [mc].\""
    a "\"Existe uma fórmula feita especialmente para primatas. Preciso de você vivo tanto tempo quanto eu, [mc].\""

# game/end_game2.rpy:670
translate pt_br end_game2_13a1cd4d:

    # "I realize then how well Amicus is taking this whole 'eight years' thing, and I have to wonder if he's just trying to make it sound less bad than it actually is."
    "Eu percebo então quão bem Amicus vem levando essa coisa dos oito anos e tenho que me perguntar se ele não está só tentando fazer parecer menos ruim do que realmente é."

# game/end_game2.rpy:671
translate pt_br end_game2_1b87042f:

    # "Eight years is a long time, whether you're a human or a wolf."
    "Oito anos é muito tempo, seja você humano ou lobo."

# game/end_game2.rpy:672
translate pt_br end_game2_e69073d0:

    # "I'd actually forgotten about the lifespan-extending medication after Amicus had told me about it."
    "Eu tinha na verdade me esquecido da medicação que prolongava a expectativa de vida que o Amicus me falou."

# game/end_game2.rpy:673
translate pt_br end_game2_f545b6bb:

    # "For whatever reason, extending my life by decades, even hundreds of years didn't really appeal to me."
    "Seja lá por que, prolongar minha vida em décadas, talvez até séculos, não me atraiu realmente."

# game/end_game2.rpy:675
translate pt_br end_game2_0d644fea:

    # "Even now it doesn't really, especially after what I experienced in the Greater Intelligence, but if it makes Amicus happy..."
    "Mesmo agora eu continuo assim, especialmente depois da amálgama, mas se vai fazer o Amicus feliz..."

# game/end_game2.rpy:676
translate pt_br end_game2_83b24450_1:

    # m "\"Of course.\""
    m "\"É claro.\""

# game/end_game2.rpy:680
translate pt_br end_game2_c0933825:

    # "And yet time seems to move faster than ever."
    "Mesmo assim, o tempo parece se mover mais rápido do que nunca."

# game/end_game2.rpy:681
translate pt_br end_game2_c9f681ca:

    # "This is on top of the fact that nine months is quite a few more days here on Adastra than it would be on Earth."
    "E isso levando em conta que nove meses têm alguns dias a mais em Adastra do que na Terra."

# game/end_game2.rpy:682
translate pt_br end_game2_d9bfbd12:

    # "Still, the days fly by, and I think it mostly has to do with my life not being in peril anymore."
    "Ainda assim, os dias passam voando e creio que isso tem a ver principalmente com o fato da minha vida não estar mais em perigo."

# game/end_game2.rpy:683
translate pt_br end_game2_7026886a:

    # "I'm not dreading a trial, or fight that will determine my future."
    "Não tenho medo de um julgamento ou uma luta que vão determinar meu futuro."

# game/end_game2.rpy:684
translate pt_br end_game2_03e1bf44:

    # "Now it's more of a slow burn that just blends together."
    "Agora é mais como uma lenta queima que se funde."

# game/end_game2.rpy:685
translate pt_br end_game2_e3ffe38c:

    # "Life in the palace becomes routine again."
    "A vida no palácio se torna rotina outra vez."

# game/end_game2.rpy:686
translate pt_br end_game2_dd7c912a:

    # "I have my own little schedule that involves gardening, and watching certain programs on Adastran TV that I've actually grown to tolerate."
    "Tenho meu próprio cronograma que envolve jardinagem e assistir a certos programas na TV adastriana que eu na verdade comecei a tolerar."

# game/end_game2.rpy:688
translate pt_br end_game2_15f691f0:

    # "I start to study, using Com as my teacher to learn as much as I can about Adastran and {i}Galaxias{i} history."
    "Começo a estudar, usando Com como meu professor para aprender o máximo possível sobre a história de Adastra e da {i}congregação galáctica{i}."

# game/end_game2.rpy:689
translate pt_br end_game2_eb26c8f4:

    # "I even have enough time to start learning the Language."
    "Eu até tenho tempo suficiente para começar a aprender o idioma."

# game/end_game2.rpy:690
translate pt_br end_game2_4524baa5:

    # "Apparently they never bothered to name their own language, which is a very wolven thing to do."
    "Aparentemente eles nunca se deram ao trabalho de nomear sua própria língua, o que é uma coisa muito lobina de se fazer."

# game/end_game2.rpy:691
translate pt_br end_game2_091ee84b:

    # "But as I'd noticed when I first arrived, it's nearly identical to Latin back on Earth."
    "Mas assim como notei quando cheguei, é quase idêntico ao latim da Terra antigamente."

# game/end_game2.rpy:692
translate pt_br end_game2_58e765c9:

    # "This makes it fairly easy to pick up considering I studied some Latin back in school, and I learned a good deal of Italian before my trip."
    "Isso facilita bastante o aprendizado, considerando que estudei um pouco de latim na escola e aprendi bastante italiano antes da minha viagem."

# game/end_game2.rpy:693
translate pt_br end_game2_b72d709a:

    # "Amicus thinks it's a bit odd I want to learn, considering I have the lingua."
    "Amicus acha um pouco estranho que eu queira aprender, considerando que eu tenho o interpretus."

# game/end_game2.rpy:694
translate pt_br end_game2_d78afae1:

    # "And while I've become used to life in what's basically a dubbed film, I can't help but feel like it's a filter of some kind."
    "E por mais que eu tenha me acostumado com a vida basicamente se transformando num filme dublado, não posso deixar de sentir que é algum tipo de filtro."

# game/end_game2.rpy:695
translate pt_br end_game2_a7d970a7:

    # "I'd like to get past that, hear Amicus and the others as they are."
    "Eu gostaria de superar isso, ouvir do Amicus e dos outros o que eles realmente estão falando."

# game/end_game2.rpy:697
translate pt_br end_game2_26745d29:

    # "And if I'm going to spend most of my life here..."
    "E se eu vou passar a maior parte da minha vida aqui..."

# game/end_game2.rpy:698
translate pt_br end_game2_bce61006:

    # "I've already started taking the supplements to extend my lifespan, which means I could be alive for a lot longer than I'd ever imagined."
    "Já comecei a tomar os suplementos para prolongar minha expectativa de vida, o que significa que eu posso ficar vivo por muito mais tempo do que jamais imaginei."

# game/end_game2.rpy:699
translate pt_br end_game2_27279348:

    # "Though, Felix says that, at most, I might get about 100 extra years out of the treatment, rather than the 200 years or so that the wolves get because I started taking them when I was already an adult."
    "Apesar disso, Felix diz que no máximo posso ganhar cerca de 100 anos extras com o tratamento, em vez dos 200 anos que os lobos recebem pois comecei a tomá-los enquanto adulto."

# game/end_game2.rpy:700
translate pt_br end_game2_179db9f1:

    # "Still, it's a lot, and while I'm sure most people on Earth would be desperate for this supplement, I strangely feel a bit exhausted by the idea."
    "Ainda assim, é bastante, e embora eu tenha certeza que a maioria das pessoas na Terra ficariam desesperadas por esse suplemento, estranhamente me sinto um pouco exausto com a ideia."

# game/end_game2.rpy:701
translate pt_br end_game2_72797534:

    # "Living 150 to 200 years really changes one's perspective on time."
    "Viver de 150 a 200 anos realmente muda a perspectiva de uma pessoa sobre o tempo."

# game/end_game2.rpy:702
translate pt_br end_game2_15952d6f:

    # "Maybe that's one of the factors that makes it seem as if the days are going by so fast."
    "Talvez esse seja um dos fatores que fazem parecer que os dias estão passando muito rápido."

# game/end_game2.rpy:703
translate pt_br end_game2_22229787:

    # "The worst part about it is that I don't get to spend very much of it with Amicus."
    "A pior parte disso é que eu não consigo gastar muito deles com o Amicus."

# game/end_game2.rpy:704
translate pt_br end_game2_043330e9:

    # "It's something I had expected, anticipated, even."
    "É algo que eu esperava, antecipava, até."

# game/end_game2.rpy:705
translate pt_br end_game2_f7590c92:

    # "But I can't help but feel a little depressed that I only see him for a second in the morning when he kisses me goodbye, then late at night to have dinner with me, exhausted by his imperial duties."
    "Mas não posso deixar de me sentir um pouco deprimido em vê-lo apenas por um segundo na manhã, quando ele me dá um beijo de despedida, depois tarde da noite para jantar comigo, exausto por causa dos deveres imperiais."

# game/end_game2.rpy:706
translate pt_br end_game2_9c785ed4:

    # "While Cassius mainly lounged around during his short rule, I also know now that Cato was doing nearly all the work behind the scenes."
    "Por mais que Cassius ficasse vadiando por aí durante seu curto governo, também sei que Cato fazia quase todo o trabalho nos bastidores."

# game/end_game2.rpy:707
translate pt_br end_game2_7ea3b01d:

    # "And while Virginia would be more than happy to do the same, Amicus isn't the type to be lazy like that."
    "E por mais que Virginia fosse ficar mais do que feliz em fazer o mesmo, Amicus não é do tipo preguiçoso."

# game/end_game2.rpy:708
translate pt_br end_game2_2bcae931:

    # "Speaking of which, it's not just Amicus; while his absence would be bearable if I had at least {i}someone{/i} to talk to that isn't Com, everyone else seems to have become just as busy."
    "Falando nisso, não é só o Amicus; enquanto sua ausência seria suportável se eu pelo menos tivesse {i}alguém{/i} com quem conversar que não fosse o Com, todo mundo parece ter ficado igualmente ocupado."

# game/end_game2.rpy:710
translate pt_br end_game2_49f32b0c:

    # "Neferu, my only real friend on this moon aside from Amicus, is usually off doing diplomatic stuff in the city, his mission to secure an alliance now fully in motion."
    "Neferu, meu único amigo de verdade nessa lua além do Amicus, geralmente trata de assuntos diplomáticos na cidade, sua missão de garantir uma aliança agora a todo vapor."

# game/end_game2.rpy:711
translate pt_br end_game2_ca7b510c:

    # "Virginia is always by Amicus's side, especially now that the populace has grown used to the idea of a woman in a chief advisor role."
    "Virginia fica sempre ao lado do Amicus, especialmente agora que a população se acostumou com a ideia de uma mulher no cargo de conselheira."

# game/end_game2.rpy:712
translate pt_br end_game2_8f908d02:

    # "And while I've never really connected with her, it would still be nice to have some kind of company."
    "E embora eu nunca tenha realmente me conectado com ela, ainda seria bom ter uma companhia."

# game/end_game2.rpy:713
translate pt_br end_game2_d40ab3da:

    # "I mean, even Cassius would be a welcome distraction, but the white wolf left a few months back to tour the more impoverished regions of Adastra so that resources might be better allocated."
    "Quer dizer, até o Cassius seria uma distração bem-vinda, mas o lobo branco viajou há alguns meses para visitar as regiões mais pobres de Adastra de forma que os recursos fossem melhor direcionados."

# game/end_game2.rpy:714
translate pt_br end_game2_007735f1:

    # "And it also turns out that he left with my former best Adastra friend, Alexios."
    "E acontece também que ele saiu com o meu antigo melhor amigo de Adastra, Alexios."

# game/end_game2.rpy:715
translate pt_br end_game2_5357c49a:

    # "Cassius left us all somewhat stunned when he did this; doing important social work while a known spy and saboteur, one that could be blamed for a lot of damage to Adastran society, is by his side."
    "Cassius deixou todos nós um tanto atordoados quando decidiu isso; fazendo um importante trabalho social enquanto um conhecido espião e sabotador, um que poderia ser responsabilizado por um monte de danos à sociedade Adastriana, está ao seu lado."

# game/end_game2.rpy:716
translate pt_br end_game2_e2afe305:

    # "Amicus was adamant on deporting Alexios on the first ship back to Omorofa, but Cassius talked with him, and I guess he'd been convincing."
    "Amicus foi inflexível ao deportar Alexios na primeira nave de volta a Omorfa, mas Cassius falou com ele e acho que foi bem convincente."

# game/end_game2.rpy:717
translate pt_br end_game2_f4baa531:

    # "Amicus simply sent a few extra guards to keep a close eye on Alex."
    "Amicus simplesmente enviou alguns guardas extras para vigiar o Alex."

# game/end_game2.rpy:718
translate pt_br end_game2_e5f17d7c:

    # "When I'd asked about this, Amicus only told me that the cat is powerless now, unable to connect with his homeworld due to all communication with Omorfa having been blocked after the scandal—"
    "Quando eu o perguntei sobre isso, Amicus só me disse que o gato não tem poder agora, incapaz de conectar-se com sua terra natal por toda a comunicação com Omorfa ter sido bloqueada depois do escândalo—"

# game/end_game2.rpy:719
translate pt_br end_game2_95e3ae8b:

    # "—one that involved many more actors than just Alex."
    "—um que envolvia muito mais agentes que apenas Alex."

# game/end_game2.rpy:721
translate pt_br end_game2_36362789:

    # "It doesn't sit right with me though, the idea that Alex caused so much pain for so many people, yet he's facing no consequences."
    "Mas não parece certo para mim, a ideia de que Alex causou tanta dor a tantas pessoas e mesmo assim não está enfrentando nenhuma consequência."

# game/end_game2.rpy:722
translate pt_br end_game2_4cf95691:

    # "Sure, I'd made that \"deal\" with him to free Amicus, but he really shouldn't still be here."
    "Claro, eu tinha feito aquele \"acordo\" com ele para libertar o Amicus, mas ele realmente não deveria ainda estar aqui."

# game/end_game2.rpy:723
translate pt_br end_game2_2f6883bf:

    # "I already know though, that it has more to do with Cassius's relationship with the cat, and I don't doubt that the white wolf had compared their situation to ours so that he could better convince Amicus."
    "No entanto, eu já sei que isso tem mais a ver com o relacionamento do Cassius com o gato, então eu não duvido que o lobo branco comparou a situação deles com a nossa para que pudesse convencer melhor o Amicus."

# game/end_game2.rpy:724
translate pt_br end_game2_4fccff82:

    # "Even if it was incomparable."
    "Mesmo que isso seja incomparável."

# game/end_game2.rpy:725
translate pt_br end_game2_d6458dd0:

    # "So now even Alex has something to do, a role to fill, and I'm the one that's left feeling useless and alone in the palace."
    "Então, agora até Alex tem o que fazer, um papel a desempenhar, e eu sou o único me sentindo inútil e sozinho no palácio."

# game/end_game2.rpy:726
translate pt_br end_game2_56069bd2:

    # "While I know I'll have a special position once I start my own mission, I'm supposed to keep a low profile until then."
    "Embora eu saiba que terei uma posição especial assim que começar minha própria missão, devo manter um perfil discreto até lá."

# game/end_game2.rpy:727
translate pt_br end_game2_5e92ded5:

    # "The only job I have right now, over the course of the entire nine months, is to decide whether or not I'm going to play the role the parents want me to."
    "O único trabalho que eu tenho agora, ao longo de nove meses inteiros, é decidir se vou ou não desempenhar o papel que os progenitores querem que eu assuma."

# game/end_game2.rpy:728
translate pt_br end_game2_cd9b72df:

    # "And while that's well and good, as it's a decision that will affect the rest of my life, I also sort of expected to be given more information over the course of my waiting period."
    "E embora isso seja legal, como é uma decisão que vai afetar o resto da minha vida, também meio que esperava receber mais informações ao longo do meu período de espera."

# game/end_game2.rpy:730
translate pt_br end_game2_f5f1314c:

    # "But no, infinite space remains quiet, and the monitor isn't breaking in through my consciousness to give me tips on what to expect."
    "Mas não, o espaço infinito permanece quieto e o monitor não invade minha consciência para me dar dicas sobre o que esperar."

# game/end_game2.rpy:731
translate pt_br end_game2_aa469221:

    # "So I'm left pulling the endless weeds in the gardens, waiting, wondering, as unsure of my future as I've ever been..."
    "Então me resta puxar as infindáveis ervas daninhas no jardim, esperando, imaginando, tão inseguro sobre meu futuro como eu jamais estive..."

# game/end_game2.rpy:734
translate pt_br end_game2_a96cfcab:

    # a "\"[mc].\""
    a "\"[mc].\""

# game/end_game2.rpy:735
translate pt_br end_game2_72a6ea31:

    # "I crack open my eyes, seeing the large silhouette of Amicus in the dimmed lighting of the bedroom."
    "Eu abro os olhos, observando a grande silhueta do Amicus na iluminação fraca do quarto."

# game/end_game2.rpy:738
translate pt_br end_game2_0554e7f9:

    # a "\"Good morning.\""
    a "\"Bom dia.\""

# game/end_game2.rpy:739
translate pt_br end_game2_81d82868:

    # "I smile and reach out my hands, expecting the usual hug and kiss before he's off for the day."
    "Eu sorrio e estendo minhas mãos, esperando o habitual abraço e beijo antes dele sair."

# game/end_game2.rpy:741
translate pt_br end_game2_f0fdf9c2:

    # "Instead though, he sits on the bed next to me, running a paw through my hair gently, pushing it back away from my forehead."
    "Mas em vez disso, ele se senta na cama ao meu lado, passando uma pata gentilmente pelo meu cabelo, afastando-o da minha testa."

# game/end_game2.rpy:742
translate pt_br end_game2_ba4da02b:

    # a "\"Your fur is a mess.\""
    a "\"Seu pelo está uma bagunça.\""

# game/end_game2.rpy:743
translate pt_br end_game2_d7b23592:

    # m "\"I mean, I did just wake up.\""
    m "\"É né, eu acabei de acordar.\""

# game/end_game2.rpy:745
translate pt_br end_game2_ca10941c:

    # a "\"Mmmh...It's cute.\""
    a "\"Mmmh... é fofo.\""

# game/end_game2.rpy:746
translate pt_br end_game2_016389c0:

    # "Amicus continues to brush his fingers and claws through my hair."
    "Amicus continua passando seus dedos e garras pelo meu cabelo."

# game/end_game2.rpy:747
translate pt_br end_game2_36ac07c4:

    # "I watch him for a moment, a bit confused."
    "Eu o observo por um momento, um pouco confuso."

# game/end_game2.rpy:748
translate pt_br end_game2_702cfbe4_1:

    # m "\"You alright?\""
    m "\"Você tá bem?\""

# game/end_game2.rpy:749
translate pt_br end_game2_dccb9457:

    # a "\"Very much so.\""
    a "\"Muito bem.\""

# game/end_game2.rpy:750
translate pt_br end_game2_658e967d:

    # "I look over at the curtains, seeing the soft light of dawn creeping around the edges."
    "Eu olho na direção das cortinas, vendo a suave luz do amanhecer rastejando pelas bordas."

# game/end_game2.rpy:751
translate pt_br end_game2_80a04599:

    # m "\"Don't you have to go to the city?\""
    m "\"Você não tem que ir pra cidade?\""

# game/end_game2.rpy:752
translate pt_br end_game2_6b6ab49e:

    # a "\"Nope.\""
    a "\"Não.\""

# game/end_game2.rpy:753
translate pt_br end_game2_9454d6dd:

    # m "\"Okay...do you have the day off? You're acting a little odd.\""
    m "\"Ok... tá com o dia de folga hoje? Você tá agindo um pouco estranho.\""

# game/end_game2.rpy:755
translate pt_br end_game2_a105cc88:

    # a "\"Ah, so you don't know.\""
    a "\"Ah, então você não sabe.\""

# game/end_game2.rpy:756
translate pt_br end_game2_53ab1b83:

    # m "\"Know what?\""
    m "\"Não sei do que?\""

# game/end_game2.rpy:757
translate pt_br end_game2_39908655:

    # "An irrational part of me begins to wonder if the nine months is already up, even though the last time I'd calculated it out, I still had four months left."
    "Uma parte irracional de mim começa a se perguntar se os nove meses já terminaram, mesmo que da última vez que calculei ainda restassem quatro meses."

# game/end_game2.rpy:759
translate pt_br end_game2_d5f6f593:

    # a "\"I'm honestly glad you don't. I was hoping to surprise you.\""
    a "\"Sinceramente, fico feliz que você não sabe. Estava esperando fazer uma surpresa.\""

# game/end_game2.rpy:760
translate pt_br end_game2_b7fcc9fd:

    # "I close my eyes in only the slightest amount of frustration."
    "Fecho os olhos com uma mínima quantidade de frustração."

# game/end_game2.rpy:761
translate pt_br end_game2_a769dc94:

    # m "\"Amicus, please just tell me. You know I don't like—\""
    m "\"Amicus, só conta pra mim de uma vez. Você sabe que eu não gosto—\""

# game/end_game2.rpy:762
translate pt_br end_game2_98186c02:

    # "I hear rustling from the wolf in front of me, and I open my eyes to the sight of a bouquet of flowers being held out to me."
    "Ouço um farfalhar do lobo na minha frente e abro os olhos para me deparar com um buquê de flores sendo oferecido para mim."

# game/end_game2.rpy:763
translate pt_br end_game2_4b06e26c:

    # "Like last time, it's dominated by lavender and its smell surrounds me, a smell that my brain has exclusively tied to my wolf."
    "Como da última vez, é dominado por lavanda e seu aroma me cerca, um cheiro que meu cérebro conectou exclusivamente ao meu lobo."

# game/end_game2.rpy:764
translate pt_br end_game2_b6d59d09:

    # "Meanwhile, white and pink flowers along the edges compliment the purple."
    "Enquanto isso, flores brancas e rosas ao longo das bordas complementam o roxo."

# game/end_game2.rpy:765
translate pt_br end_game2_4d47254f:

    # "I stare at it in surprise, unsure of what to think or say."
    "Eu encaro com surpresa, sem saber o que pensar ou dizer."

# game/end_game2.rpy:766
translate pt_br end_game2_7d66fc27:

    # "Amicus fills the silence."
    "Amicus preenche o silêncio."

# game/end_game2.rpy:768
translate pt_br end_game2_10be5100:

    # a "\"Happy Lover's Day, [mc].\""
    a "\"Feliz dia dos amores, [mc].\""

# game/end_game2.rpy:769
translate pt_br end_game2_375dc2f3:

    # "The wolf continues to hold out the bouquet insistently, so I finally reach up and take it, noticing that it looks much nicer this time versus Amicus's first bouquet."
    "O lobo continua segurando o buquê insistentemente, então eu finalmente o alcanço e pego, percebendo que parece muito melhor dessa vez em relação ao primeiro buquê do Amicus."

# game/end_game2.rpy:770
translate pt_br end_game2_981e234c:

    # m "\"O—Oh! Thank you.\""
    m "\"A—Ah! Obrigado.\""

# game/end_game2.rpy:772
translate pt_br end_game2_d102f978:

    # a "\"You're welcome!\""
    a "\"Não há de que!\""

# game/end_game2.rpy:773
translate pt_br end_game2_1aec7524:

    # "I sit there holding the bouquet awkwardly for a few seconds, noticing the stems dripping slightly on the blanket, so I hold them out over the edge."
    "Eu fico lá sentado segurando o buquê desjeitosamente por alguns segundos, percebendo as hastes pingando levemente no cobertor, então seguro em cima da borda."

# game/end_game2.rpy:774
translate pt_br end_game2_ed658f2f:

    # m "\"So is this, uh, some kind of Adastran holiday?\""
    m "\"Então, hã... isso é tipo algum feriado adastriano?\""

# game/end_game2.rpy:776
translate pt_br end_game2_3eb52eef:

    # a "\"Indeed! To celebrate those who you love and cherish, and for me, that is you, [mc]. I love you.\""
    a "\"Exatamente! Para celebrar aqueles que você ama e preza e, para mim, essa pessoa é você, [mc]. Eu te amo.\""

# game/end_game2.rpy:777
translate pt_br end_game2_9021dd00:

    # "Though I'm still feeling a bit dazed at the unexpectedness of it all, I manage to smile."
    "Embora ainda esteja um pouco atordoado com a situação inesperada, consigo sorrir."

# game/end_game2.rpy:778
translate pt_br end_game2_4e869cdd:

    # m "\"You too, Amicus. Um, I kind of wish I'd known...I didn't get you anything.\""
    m "\"Também te amo, Amicus. Hã, eu meio que queria ter ouvido falar disso antes... não fiz nada pra você.\""

# game/end_game2.rpy:779
translate pt_br end_game2_fa09bf9b:

    # "Amicus waves his paw dismissively in the air."
    "Amicus balança a pata desdenhosamente no ar."

# game/end_game2.rpy:781
translate pt_br end_game2_cf5245cb:

    # a "\"Pff, the flowers are simply a human touch that I knew you'd appreciate. Besides, this isn't a gift-giving occasion, it's a go-out-and-enjoy-yourself occasion!\""
    a "\"Pff, as flores são simplesmente um toque humano que eu sabia que você ia gostar. Além disso, não é uma ocasião de se compartilhar presentes, e sim para sair e se divertir!\""

# game/end_game2.rpy:782
translate pt_br end_game2_74882566:

    # "Amicus stands suddenly, reaching out his paw to me."
    "Amicus se levanta de repente, estendendo a pata para mim."

# game/end_game2.rpy:784
translate pt_br end_game2_36d26951:

    # a "\"Come! I have the entire day planned out, just you and I. No Triumvirs, diplomats, or advisors to bother us.\""
    a "\"Venha! Tenho o dia inteiro planejado, só você e eu. Sem triúnviros, diplomatas ou conselheiros para nos incomodar.\""

# game/end_game2.rpy:785
translate pt_br end_game2_182d054c:

    # "I take his paw, smiling as I realize how this has seemingly come just in time for me."
    "Eu pego sua pata, sorrindo enquanto percebo como isso aparentemente chegou bem a tempo para mim."

# game/end_game2.rpy:786
translate pt_br end_game2_6ad449e4:

    # "I've been feeling so lonely and bored in the palace, this is exactly what I need."
    "Eu tenho me sentido tão sozinho e entediado no palácio, isso é exatamente o que eu precisava."

# game/end_game2.rpy:787
translate pt_br end_game2_ba9a2354:

    # "I hold the flowers to my chest, smelling them, not caring anymore that they're all wet."
    "Seguro as flores em meu peito, cheirando-as, não me importando mais que estejam todas molhadas."

# game/end_game2.rpy:788
translate pt_br end_game2_f6059224:

    # m "\"What do you have planned?\""
    m "\"O que você planejou?\""

# game/end_game2.rpy:790
translate pt_br end_game2_5cbfe535:

    # a "\"Ah! That's also a surprise. I'd like to leave in the next few minutes though, so get dressed, and don't worry about showering.\""
    a "\"Ah! Isso também é uma surpresa. Mas eu gostaria de sair nos próximos minutos, então vista-se, e não se preocupe em tomar banho.\""

# game/end_game2.rpy:791
translate pt_br end_game2_6f19d038:

    # m "\"Alright.\""
    m "\"Tudo bem.\""

# game/end_game2.rpy:792
translate pt_br end_game2_d1bd88f0:

    # "I move toward the dresser to grab my robes, but as I'm doing so, there's a loud knock at the door."
    "Eu ando em direção à cômoda para pegar minhas roupas, mas conforme faço isso, há uma batida forte na porta."

# game/end_game2.rpy:795
translate pt_br end_game2_cbb2797c:

    # "Amicus's cheery mood drops for a moment as he lets out a frustrated sigh."
    "O humor alegre do Amicus diminui por um momento enquanto ele solta um suspiro frustrado."

# game/end_game2.rpy:797
translate pt_br end_game2_a351bc32:

    # a "\"Com, who's at my door?\""
    a "\"Com, quem está na minha porta?\""

# game/end_game2.rpy:798
translate pt_br end_game2_c21a3f7e:

    # com "\"Neferu is at your bedroom door, Amicus.\""
    com "\"Neferu está na porta do seu quarto, Amicus.\""

# game/end_game2.rpy:799
translate pt_br end_game2_6ef293ca:

    # "Amicus closes his eyes for a second, then opens them again, smiling at me."
    "Amicus fecha os olhos por um segundo, depois os abre novamente, sorrindo para mim."

# game/end_game2.rpy:801
translate pt_br end_game2_15f2194c:

    # a "\"One moment, probably just wants to wish us a good Lover's Day...\""
    a "\"Um momento, ele provavelmente só quer nos desejar um bom dia do amores...\""

# game/end_game2.rpy:803
translate pt_br end_game2_db256d30:

    # a "\"...or something.\""
    a "\"(...) ou sei lá.\""

# game/end_game2.rpy:804
translate pt_br end_game2_ebf05380:

    # "Amicus strides over to the door while I quickly pull out a clean robe, pulling it over my body as the door opens."
    "Amicus se dirige à porta enquanto eu rapidamente tiro uma túnica limpa, puxando-a sobre meu corpo quando a porta se abre."

# game/end_game2.rpy:807
translate pt_br end_game2_79ccbab6:

    # a "\"Neferu. Did you need something?\""
    a "\"Neferu. Precisa de alguma coisa?\""

# game/end_game2.rpy:809
translate pt_br end_game2_9dcdc9a8:

    # n "\"Hello Amicus...and Ahhotep be with you, [mc].\""
    n "\"Olá, Amicus... e Ahhotep esteja com você, [mc].\""

# game/end_game2.rpy:810
translate pt_br end_game2_3ec08fd8:

    # "Neferu pokes his head around Amicus's bulk which the wolf is clearly trying to use to shield me from view, even though I'm already in the process of tying my robe on."
    "A cabeça do Neferu brota passando o corpo do Amicus, o qual o lobo está tentando usar como escudo para me proteger de bisbilhoteiros, mesmo que eu já esteja no processo de amarrar minha túnica."

# game/end_game2.rpy:811
translate pt_br end_game2_97495df2:

    # m "\"Ahhotep be with you.\""
    m "\"Ahhotep esteja com você.\""

# game/end_game2.rpy:812
translate pt_br end_game2_da7e5a22:

    # "I mumble back, nodding in the jackal's direction."
    "Eu murmuro de volta, acenando na direção do chacal."

# game/end_game2.rpy:813
translate pt_br end_game2_a115a5c1:

    # a "\"What was it you needed?\""
    a "\"Do que precisa?\""

# game/end_game2.rpy:815
translate pt_br end_game2_adb6c019:

    # n "\"Well, {i}you{/i} are needed by the council. The Khemian ambassador and Vizier arrived an hour ago, and they requested we begin our meeting at once.\""
    n "\"Bem, {i}sua{/i} presença é solicitada no conselho. O embaixador khemiano e o vizir chegaram uma hora atrás e solicitaram que começássemos nossa reunião imediatamente.\""

# game/end_game2.rpy:818
translate pt_br end_game2_66fadc00:

    # a "\"Wha—No!\""
    a "\"Que—Não!\""

# game/end_game2.rpy:820
translate pt_br end_game2_c0aa9175:

    # "Amicus lets out a groan of frustration, leaning his head back and tilting his muzzle toward the ceiling."
    "Amicus solta um grunhido de frustração, inclinando a cabeça para trás e virando o focinho em direção ao teto."

# game/end_game2.rpy:822
translate pt_br end_game2_fa24d455:

    # n "\"Didn't Com notify you? I've been waiting in the carriage for fifteen minutes. Virginia's already there.\""
    n "\"Com não o notificou? Eu estive esperando na carruagem por quinze minutos. Virginia já está lá.\""

# game/end_game2.rpy:823
translate pt_br end_game2_cce5e850:

    # "Neferu leans sideways slightly to look at me again."
    "Neferu se inclina levemente para o lado, olhando para mim de novo."

# game/end_game2.rpy:825
translate pt_br end_game2_5728cb81:

    # n "\"Am I interrupting something?\""
    n "\"Estou interrompendo alguma coisa?\""

# game/end_game2.rpy:827
translate pt_br end_game2_03e09a9a:

    # a "\"It's Lover's Day! I cleared my schedule weeks in advance for this!\""
    a "\"É dia dos amores! Eu organizei minha agenda com semanas de antecedência para isso!\""

# game/end_game2.rpy:829
translate pt_br end_game2_7ac93770:

    # n "\"Oh, is it? Hm, well, I suppose I would have no reason to know, eh?\""
    n "\"Ah, é mesmo? Hm, bem, suponho que eu não teria motivos para saber, não é?\""

# game/end_game2.rpy:831
translate pt_br end_game2_40610a1d:

    # "Neferu winks."
    "Neferu dá uma piscadela."

# game/end_game2.rpy:833
translate pt_br end_game2_fd18d516:

    # n "\"Anyway, you know how poorly schedules match up when the stretch drive is used. Simply bad luck.\""
    n "\"Enfim, você sabe quão pessimamente os cronogramas batem quando a dobra espacial é utilizada. Simplesmente azar.\""

# game/end_game2.rpy:834
translate pt_br end_game2_1c801bd8:

    # a "\"Bad luck, indeed.\""
    a "\"Azar demais.\""

# game/end_game2.rpy:835
translate pt_br end_game2_0fafde95:

    # "All the while, I feel the slight sinking sensation of disappointment."
    "Enquanto isso, sinto a levemente profunda sensação de desapontamento."

# game/end_game2.rpy:836
translate pt_br end_game2_db2a2941:

    # "I can't really say I've been looking forward to this considering I didn't even know it was a thing, but in the couple of minutes I knew about it, I was really looking forward to it."
    "Eu não posso dizer que fiquei realmente ansioso por isso considerando o fato de nem saber da existência desse feriado, mas nos poucos minutos que soube, fiquei realmente animado."

# game/end_game2.rpy:837
translate pt_br end_game2_0e2d1fea:

    # "Amicus turns then, gaze softening as he spots me standing in my disheveled, half-tied-on robe."
    "Então, Amicus se vira, o olhar suavizando quando ele me vê na minha túnica bagunçada e amarrada pela metade."

# game/end_game2.rpy:839
translate pt_br end_game2_e940ac88:

    # a "\"I, uh...\""
    a "\"Eu, hã...\""

# game/end_game2.rpy:840
translate pt_br end_game2_50658592:

    # "I shrug in what I hope looks like a nonchalant manner."
    "Eu dou de ombros de uma maneira que espero que pareça indiferente."

# game/end_game2.rpy:841
translate pt_br end_game2_c5729f35:

    # m "\"It's alright, I understand. We can do something any other time.\""
    m "\"Tá tudo bem, eu entendo. A gente pode fazer alguma coisa outra hora.\""

# game/end_game2.rpy:842
translate pt_br end_game2_9e17ba4d_1:

    # a "\"[mc]...\""
    a "\"[mc]...\""

# game/end_game2.rpy:843
translate pt_br end_game2_2ce4682e:

    # "I suppose I'm not doing a very good job of not looking just a little upset."
    "Suponho que eu não esteja fazendo um bom trabalho em não parecer um pouco chateado."

# game/end_game2.rpy:844
translate pt_br end_game2_a582d1a4:

    # m "\"I mean, I'm happy with just this—\""
    m "\"Quer dizer, já tô feliz só com isso—\""

# game/end_game2.rpy:845
translate pt_br end_game2_6ef88d1d:

    # "I pick up the bouquet of flowers I'd set on the dresser, inhaling the scent again."
    "Eu pego o buquê de flores que coloquei na cômoda, inalando o perfume novamente."

# game/end_game2.rpy:846
translate pt_br end_game2_e62c0ac6:

    # m "\"The fact that you did all this in the first place means a lot to me.\""
    m "\"O fato de você ter feito tudo isso em primeiro lugar já significa muito pra mim.\""

# game/end_game2.rpy:847
translate pt_br end_game2_ac92827b:

    # "Amicus goes on frowning at me, clearly not buying it."
    "Amicus continua franzindo a testa para mim, claramente não se convencendo."

# game/end_game2.rpy:848
translate pt_br end_game2_c0faedef:

    # "Then he snarls."
    "Então ele rosna."

# game/end_game2.rpy:850
translate pt_br end_game2_f07d449b:

    # a "\"Fuck!\""
    a "\"Merda!\""

# game/end_game2.rpy:851
translate pt_br end_game2_b7ab907c:

    # "Neferu raises a brow."
    "Neferu levanta uma sobrancelha."

# game/end_game2.rpy:853
translate pt_br end_game2_bd18281a:

    # n "\"Poor language for an emperor, Amicus.\""
    n "\"Linguagem chula para um imperador, Amicus.\""

# game/end_game2.rpy:854
translate pt_br end_game2_30ef2bcb:

    # "Amicus ignores the jackal, keeping his eyes on me."
    "Amicus ignora o chacal, mantendo os olhos em mim."

# game/end_game2.rpy:856
translate pt_br end_game2_5823aa1f:

    # a "\"This is the only meeting I'll have all day. It shouldn't last too long, and then we'll still be able to do most of what I planned.\""
    a "\"Essa é a única reunião que eu terei o dia todo. Não deve durar muito, e ainda poderemos fazer a maior parte do que planejei.\""

# game/end_game2.rpy:857
translate pt_br end_game2_99a2ae02:

    # n "\"I wouldn't plan on that. This is a very important—\""
    n "\"Eu não contaria com isso. Essa reunião é muito—\""

# game/end_game2.rpy:859
translate pt_br end_game2_089a5cd5:

    # a "\"I know, ja—Neferu, but it won't last all day. Anyway, [mc], come with me. That way, as soon as the meeting is finished, we can immediately go to our private dinner.\""
    a "\"Eu sei, cha—Neferu, mas não vai durar o dia todo. Enfim, [mc], venha comigo. Dessa forma, assim que a reunião acabar, podemos ir imediatamente para o nosso jantar privado.\""

# game/end_game2.rpy:861
translate pt_br end_game2_376ce14a:

    # n "\"You're bringing [mc]? Didn't you say we should be keeping his profile low?\""
    n "\"Está trazendo o [mc]? Você não disse que deveríamos manter sua exposição baixa?\""

# game/end_game2.rpy:863
translate pt_br end_game2_1bbb3109:

    # a "\"It's Lover's Day. No one will be at the university.\""
    a "\"É dia dos amores. Ninguém estará na universidade.\""

# game/end_game2.rpy:864
translate pt_br end_game2_ab563c0b:

    # "I raise my hands."
    "Eu levanto minhas mãos."

# game/end_game2.rpy:865
translate pt_br end_game2_9b3ebf15:

    # m "\"I don't want to cause any problems. I can just wait for you here—\""
    m "\"Eu não quero causar nenhum problema. Posso só esperar por você aqui—\""

# game/end_game2.rpy:867
translate pt_br end_game2_59e8271f:

    # a "\"You are causing no problems. You will be accompanying me to the city. As my lover you should be at my side during Lover's Day.\""
    a "\"Não está causando nenhum problema. Você vai me acompanhar até a cidade. Como meu namorado, deveria estar ao meu lado durante o dia dos amores.\""

# game/end_game2.rpy:869
translate pt_br end_game2_fc2c577d:

    # a "\"Erm, if you so choose.\""
    a "\"É... se assim quiser.\""

# game/end_game2.rpy:870
translate pt_br end_game2_cb6c14a8:

    # "At this point, anything sounds better than staying in the palace, so the decision is pretty easy."
    "A essa altura, qualquer coisa soa melhor que ficar no palácio, então a decisão é bem fácil."

# game/end_game2.rpy:871
translate pt_br end_game2_c870cb7d:

    # m "\"Alright, yeah, let's go.\""
    m "\"Tá, beleza, vamo lá.\""

# game/end_game2.rpy:874
translate pt_br end_game2_367a2694:

    # "Amicus looks somewhat relieved, letting out a breath before reaching out to take my hand, walking us out into the hallway while Neferu follows behind."
    "Amicus parece um pouco aliviado, soltando um suspiro antes de alcançar para pegar minha mão, nos levando para o corredor enquanto Neferu nos segue."

# game/end_game2.rpy:878
translate pt_br end_game2_6798d7c9:

    # a "\"I promise it will be quick, and I'm sorry. Sometimes it's just hard to...\""
    a "\"Eu prometo que será rápido, e me desculpe. Às vezes é bem difícil...\""

# game/end_game2.rpy:879
translate pt_br end_game2_b991b2bc:

    # "Amicus seems to struggle to find his words."
    "Amicus parece ter problemas para encontrar as palavras."

# game/end_game2.rpy:880
translate pt_br end_game2_0d75efcc:

    # m "\"I understand. You're the emperor. Besides, it's not fair for me to be upset because my boyfriend is spending more time on his emperor duties than me.\""
    m "\"Eu entendo. Você é o imperador. Além disso, não é justo eu ficar chateado porque meu namorado gasta mais tempo com os seus deveres de imperador do que comigo.\""

# game/end_game2.rpy:881
translate pt_br end_game2_10c5b863:

    # a "\"I would understand if you were.\""
    a "\"Eu entenderia se você ficasse.\""

# game/end_game2.rpy:882
translate pt_br end_game2_f343ae12:

    # m "\"I just hope it won't be like this forever.\""
    m "\"Eu só espero que não seja assim pra sempre.\""

# game/end_game2.rpy:884
translate pt_br end_game2_e0f7d9a4:

    # a "\"It won't be. We're simply at a turning point in Adastran history. When...When you return, and when everything settles, we will have much more time to ourselves.\""
    a "\"Não será. Nós estamos simplesmente em um ponto de virada na história de Adastra. Quando... quando você voltar, e quando tudo se resolver, teremos muito mais tempo para nós mesmos.\""

# game/end_game2.rpy:885
translate pt_br end_game2_51e9e7c0:

    # "My stomach lurches slightly at being reminded that I have my own job to do, one that I'm not looking forward to."
    "Meu estômago revira um pouco ao ser lembrado que tenho meu próprio trabalho a fazer, um para o qual não estou animado."

# game/end_game2.rpy:886
translate pt_br end_game2_1b63bf56:

    # "I glance back at Neferu, wondering if he should be hearing any of this, but the jackal seems to not be paying attention to anything, his expression distant as his lips move silently."
    "Eu olho de relance para o Neferu, me perguntando se ele deveria estar ouvindo qualquer coisa da nossa conversa, mas o chacal parece não estar prestando atenção em nada, sua expressão distante enquanto seus lábios se movem silenciosamente."

# game/end_game2.rpy:887
translate pt_br end_game2_467a580a:

    # "It looks like he's reciting something."
    "Parece que ele está recitando algo."

# game/end_game2.rpy:889
translate pt_br end_game2_745964ae:

    # "I look forward again, leaning against Amicus as we head outside toward the carriage."
    "Eu olho para frente de novo, me encostando no Amicus enquanto saímos em direção à carruagem."

# game/end_game2.rpy:893
translate pt_br end_game2_8b3ecb46:

    # "I already start feeling a lot better as our mechanical carriage creaks through the forest, the peaceful, eerie green calming any irritation I might have felt with the whole situation."
    "Já começo a me sentir muito melhor ao passo que nossa carruagem mecânica range pela floresta, o verde pacífico e misterioso acalmando qualquer irritação que eu possa ter sentido com toda a situação."

# game/end_game2.rpy:895
translate pt_br end_game2_0f526070:

    # "Amicus has me pulled against his right side, fitting me in that familiar way as I rest my head against his shoulder."
    "Amicus me mantém encostado em sua lateral direita, me encaixando daquela forma familiar enquanto eu descanso minha cabeça em seu ombro."

# game/end_game2.rpy:897
translate pt_br end_game2_b18bceea:

    # "To Amicus's left, Neferu sits with his legs crossed, an elbow on his knee and his chin in his paw."
    "À esquerda do Amicus, Neferu senta com as pernas cruzadas, um cotovelo no joelho e o queixo na pata."

# game/end_game2.rpy:898
translate pt_br end_game2_6c39cffe:

    # "I notice Neferu and Amicus not attempting to make conversation with each other, not even glancing at one another."
    "Percebo Neferu e Amicus não tentando conversar entre si, nem sequer olhando um para o outro."

# game/end_game2.rpy:899
translate pt_br end_game2_8a2af303:

    # "I think it's pretty clear at this point that Amicus and Neferu just don't really mesh well, their personalities too different."
    "Acho que já ficou bem claro a essa altura que Amicus e Neferu simplesmente não se misturam, suas personalidades muito diferentes."

# game/end_game2.rpy:900
translate pt_br end_game2_e785baf0:

    # "Which I guess is fine, as long as they're not fighting anymore."
    "Tudo bem para mim contanto que eles não estejam mais brigando."

# game/end_game2.rpy:901
translate pt_br end_game2_c8fd0293:

    # "Neferu seems to have stopped his silent chanting, so I take the opportunity to ask him a question, leaning forward to look around Amicus's front."
    "Neferu parece ter parado com seu discurso silencioso, então aproveito a oportunidade para fazer uma pergunta, me inclinando para olhar ao redor do Amicus."

# game/end_game2.rpy:902
translate pt_br end_game2_ed88ebf9:

    # m "\"So what's going on with this Khemian ambassador and, uh, the other thing you mentioned? If you can tell me, that is.\""
    m "\"Então, qual é a desse embaixador khemiano e, hã... a outra coisa que você mencionou? Caso possa me contar, é claro.\""

# game/end_game2.rpy:903
translate pt_br end_game2_5173caab:

    # "The jackal glances at me before shifting into a position that more directly faces me."
    "O chacal olha na minha direção antes de mudar para uma posição na qual possa ficar mais de frente para mim."

# game/end_game2.rpy:905
translate pt_br end_game2_71683cec:

    # n "\"The vizier? He's the highest official serving under the pharaoh. As for the ambassador, Adastra hasn't had a Khemian ambassador since the war.\""
    n "\"O vizir? Ele é o mais alto oficial na hierarquia antes do faraó. Quanto ao embaixador, Adastra não teve um embaixador khemiano desde a guerra.\""

# game/end_game2.rpy:906
translate pt_br end_game2_9d8e02e9:

    # "Amicus grunts."
    "Amicus grunhe."

# game/end_game2.rpy:908
translate pt_br end_game2_548e1830:

    # a "\"I'll point out that Khemia was the first to expel the ambassador.\""
    a "\"Tenho que mencionar que Khemia foi o primeiro a expulsar o embaixador.\""

# game/end_game2.rpy:909
translate pt_br end_game2_ea3c8fd3:

    # "Neferu maintains a straight face."
    "Neferu mantém uma expressão normal."

# game/end_game2.rpy:910
translate pt_br end_game2_da7fb6f1:

    # n "\"And we are the first to reestablish one.\""
    n "\"E nós somos os primeiros a reestabelecer um.\""

# game/end_game2.rpy:912
translate pt_br end_game2_e4621826:

    # a "\"As it should go.\""
    a "\"Como deveria ser.\""

# game/end_game2.rpy:913
translate pt_br end_game2_b30ff7c3:

    # m "\"Well that's good.\""
    m "\"É, isso é bom.\""

# game/end_game2.rpy:914
translate pt_br end_game2_89537544:

    # "I talk a little louder than usual, trying to stop an argument before it can happen."
    "Eu falo um pouco mais alto que o normal, tentando parar uma discussão antes que ela comece."

# game/end_game2.rpy:915
translate pt_br end_game2_7183e978:

    # m "\"So are they going to help establish an alliance?\""
    m "\"Então eles vão ajudar a estabelecer uma aliança?\""

# game/end_game2.rpy:916
translate pt_br end_game2_12c61f42:

    # a "\"Yes, along with smoothing over Adastra-Khemia relations in general. The ambassador will be here for the long-term. The vizier—\""
    a "\"Sim, juntamente com a suavização das relações entre Adastra e Khemia no geral. O embaixador estará aqui a longo prazo. O vizir—\""

# game/end_game2.rpy:917
translate pt_br end_game2_32fc55b4:

    # "Amicus glances at Neferu, but the jackal simply leans back, looking out at the forest again."
    "Amicus olha para Neferu, mas o chacal simplesmente se inclina para trás, olhando na direção da floresta outra vez."

# game/end_game2.rpy:918
translate pt_br end_game2_fa7dfc31:

    # n "\"—the vizier will depart back to Khemia within a week, which is why negations must begin at once.\""
    n "\"—o vizir voltará para Khemia dentro de uma semana, razão pela qual as negociações devem começar imediatamente.\""

# game/end_game2.rpy:919
translate pt_br end_game2_6b58867d:

    # m "\"And you said this is taking place at a university?\""
    m "\"E vocês disseram que isso vai acontecer em uma universidade?\""

# game/end_game2.rpy:920
translate pt_br end_game2_460acdcd:

    # a "\"Yes, there are a few Khemia experts there...and I suppose Khemians find places of learning more comfortable to negotiate in.\""
    a "\"Sim, há alguns especialistas em Khemia lá... e suponho que os khemianos achem locais de aprendizado mais confortáveis para negociar.\""

# game/end_game2.rpy:921
translate pt_br end_game2_ce57594b:

    # "Amicus glances at Neferu for confirmation."
    "Amicus encara o Neferu, esperando uma confirmação."

# game/end_game2.rpy:923
translate pt_br end_game2_e050513a:

    # n "\"I believe it has more to do with Adastran academia being a more friendly entity compared to the political departments, or palace.\""
    n "\"Acredito que tenha mais a ver com a academia adastriana ser uma entidade mais amigável comparada aos departamentos políticos, ou o palácio.\""

# game/end_game2.rpy:924
translate pt_br end_game2_84d141c7:

    # "Amicus smirks."
    "Amicus sorri pretensiosamente."

# game/end_game2.rpy:926
translate pt_br end_game2_1c48b7e6:

    # a "\"Indeed, the last bastion of Khemaphiles.\""
    a "\"De fato, o último bastião de khemianíacos.\""

# game/end_game2.rpy:927
translate pt_br end_game2_b492a58c:

    # "Neferu rolls his eyes before they settle on me again."
    "Neferu revira os olhos antes deles se instalarem em minha direção outra vez."

# game/end_game2.rpy:929
translate pt_br end_game2_2deca85b:

    # n "\"Oh, and remember our conversation about the Other? This university is famous for supposedly being absolutely infested.\""
    n "\"Ah, e você se lembra da nossa conversa sobre os Outros? Esta universidade é famosa por supostamente estar infestada deles.\""

# game/end_game2.rpy:930
translate pt_br end_game2_09722dcb:

    # "I raise an eyebrow."
    "Eu levanto uma sobrancelha."

# game/end_game2.rpy:931
translate pt_br end_game2_b4ec0074:

    # m "\"So it's haunted?\""
    m "\"Então é assombrada?\""

# game/end_game2.rpy:932
translate pt_br end_game2_e0a11c00:

    # "Amicus frowns."
    "Amicus franze a testa."

# game/end_game2.rpy:934
translate pt_br end_game2_0eaa559a:

    # a "\"Are you serious? Have you been filling his head with the ghost stories of students, Neferu?\""
    a "\"Está falando sério? Você tem enchido a cabeça dele com histórias de fantasmas dos estudantes, Neferu?\""

# game/end_game2.rpy:935
translate pt_br end_game2_fcd949e3:

    # n "\"I have.\""
    n "\"Eu tenho.\""

# game/end_game2.rpy:936
translate pt_br end_game2_8801b4a2:

    # m "\"Don't worry, I don't really believe it.\""
    m "\"Não se preocupa, eu não acredito realmente nisso.\""

# game/end_game2.rpy:937
translate pt_br end_game2_78acc33b:

    # "I lean back against Amicus, deciding that we can't really have a conversation without the two canines butting heads."
    "Eu me inclino de volta contra o Amicus, decidindo que nós não podemos realmente ter uma conversa sem os dois caninos ficarem fazendo graça."

# game/end_game2.rpy:939
translate pt_br end_game2_d7d52ab7:

    # "The university is in a secluded area outside the city, mostly surrounded by forest."
    "A universidade fica em uma área isolada fora da cidade, na maior parte cercada por floresta."

# game/end_game2.rpy:940
translate pt_br end_game2_1937c683:

    # "The gardens and paths are well taken care of, and it reminds me of a more classical-looking version of the palace."
    "Os jardins e caminhos são bem cuidados e isso me lembra uma versão mais clássica do palácio."

# game/end_game2.rpy:941
translate pt_br end_game2_8abb33be:

    # "Amicus was right; I don't see a single person on the campus."
    "Amicus estava certo; não vejo uma pessoa sequer no campus."

# game/end_game2.rpy:942
translate pt_br end_game2_f2909c56:

    # "Our carriage rides up the main path to the largest-looking building that's front and center."
    "Nossa carruagem percorre o caminho principal até o edifício que parece o maior de todos, situado frontalmente no centro."

# game/end_game2.rpy:943
translate pt_br end_game2_717256f9:

    # "We park in front of the building next to a few small aircraft before getting out and heading inside."
    "Estacionamos em frente ao prédio ao lado de alguns veículos aéreos antes de sair e caminhar para dentro."

# game/end_game2.rpy:945
translate pt_br end_game2_e2a8490e:

    # "For a moment, I'm in awe at the size and architecture surrounding me, especially the amount of sculptures spread throughout the halls."
    "Por um momento, fico admirado com o tamanho e a arquitetura que me rodeia, especialmente com a quantidade de esculturas espalhadas pelos corredores."

# game/end_game2.rpy:946
translate pt_br end_game2_8023371f:

    # "Amicus immediately begins talking to me though."
    "Mas Amicus imediatamente começa a falar comigo."

# game/end_game2.rpy:948
translate pt_br end_game2_5a6489e0:

    # a "\"Go ahead and make yourself comfortable. There should be screens in most of the rooms, and down those stairs, you can find games of amusement—\""
    a "\"Fique à vontade. Deve ter telas na maioria dos cômodos, e descendo as escadas, pode encontrar jogos divertidos—\""

# game/end_game2.rpy:949
translate pt_br end_game2_aae04b86:

    # v "\"Amicus!\""
    v "\"Amicus!\""

# game/end_game2.rpy:952
translate pt_br end_game2_cb547aeb:

    # "Amicus jerks his head away from me, looking up as Virginia's familiar voice in a very familiar tone echoes around the marble hallways."
    "Amicus afasta a cabeça de mim, olhando para cima enquanto a voz de Virginia em um tom muito familiar ecoa pelos corredores de mármore."

# game/end_game2.rpy:954
translate pt_br end_game2_90196a65:

    # a "\"Gods...\""
    a "\"Deuses...\""

# game/end_game2.rpy:955
translate pt_br end_game2_2b60bb93:

    # "Amicus mumbles under his breath as Virginia, her face a mask of fury, approaches."
    "Amicus murmura baixinho enquanto Virginia, com uma expressão de fúria, se aproxima."

# game/end_game2.rpy:956
translate pt_br end_game2_e69800dd:

    # "She spares me a glance for a single second before focusing back on Amicus."
    "Ela me lança um olhar perfurante por um segundo antes de focar de volta no Amicus."

# game/end_game2.rpy:958
translate pt_br end_game2_ef8e17d2:

    # v "\"You are an hour late.\""
    v "\"Você está uma hora atrasado.\""

# game/end_game2.rpy:959
translate pt_br end_game2_f22e0ee5:

    # a "\"Am I?\""
    a "\"Estou?\""

# game/end_game2.rpy:960
translate pt_br end_game2_a1e7e69f:

    # v "\"Yes! I've tolerated your tardiness since, well, since you were a child, but you've kept the {i}vizier{/i} waiting...{i}how could you!{/i}\""
    v "\"Sim! Eu tolero seu atraso desde que, bem, desde que você era uma criança, mas você deixou o {i}vizir{/i} esperando... {i}como pôde!{/i}\""

# game/end_game2.rpy:961
translate pt_br end_game2_095eed4a:

    # "The wolf whisper-screams through her teeth, eyes practically bulging from her head."
    "A loba sussura gritos entre os dentes, os olhos praticamente esbugalhados em seu rosto."

# game/end_game2.rpy:962
translate pt_br end_game2_b247db10:

    # "I've never seen Virginia so angry before."
    "Eu nunca vi Virginia tão brava antes."

# game/end_game2.rpy:963
translate pt_br end_game2_c74e5986:

    # "Amicus shifts uncomfortably."
    "Amicus se ajeita desconfortavelmente."

# game/end_game2.rpy:964
translate pt_br end_game2_ed260570:

    # a "\"Well, it's a holiday, so I disabled notifications—\""
    a "\"Bem, é feriado, então desativei as notificações—\""

# game/end_game2.rpy:965
translate pt_br end_game2_6046a2d0:

    # v "\"Are you {i}joking{/i}? Emperors do not get holidays. EVER.\""
    v "\"Você está {i}brincando{/i}? Imperadores nunca têm folga. NUNCA.\""

# game/end_game2.rpy:967
translate pt_br end_game2_f6f98990:

    # a "\"Well, consider it strategic.\""
    a "\"Bem, considere estratégico.\""

# game/end_game2.rpy:969
translate pt_br end_game2_37fb03a1:

    # v "\"What?\""
    v "\"O que?\""

# game/end_game2.rpy:971
translate pt_br end_game2_ae02419c:

    # a "\"I am simply letting him know who holds the power here. It will be an advantageous start to our negotiations.\""
    a "\"Estou simplesmente deixando claro que ele sabia quem detém o poder aqui. Será um início vantajoso para nossas negociações.\""

# game/end_game2.rpy:972
translate pt_br end_game2_f75d4eea:

    # "Virginia looks at her brother with borderline disgust."
    "Virginia olha para o irmão com um desgosto limítrofe."

# game/end_game2.rpy:973
translate pt_br end_game2_5af08f3a:

    # v "\"Well, at least you can make even the most extreme stupidity sound....not quite so stupid. I hope you're not planning on bringing your mate in?\""
    v "\"Bem, ao menos você consegue fazer com que a mais extrema estupidez soe... não tão estúpida. Espero que não esteja planejando trazer seu companheiro para a reunião?\""

# game/end_game2.rpy:975
translate pt_br end_game2_d3259ce5:

    # "For a moment I don't realize that she's referring to me."
    "Por um momento eu não percebo que ela se refere a mim."

# game/end_game2.rpy:977
translate pt_br end_game2_8d74b9ce:

    # a "\"Of course not. He's waiting out here.\""
    a "\"É claro que não. Ele vai esperar aqui fora.\""

# game/end_game2.rpy:978
translate pt_br end_game2_76bd8262:

    # "Virginia looks at me again."
    "Virginia olha para mim de novo."

# game/end_game2.rpy:980
translate pt_br end_game2_867d2111:

    # v "\"My apologies. I hope my brother learns to treat you with more respect in the future. If not, then I'm sure you'll have no trouble finding someone better.\""
    v "\"Perdão, [mc]. Espero que meu irmão o trate com mais respeito no futuro. Caso contrário, tenho certeza de que você não terá problemas em encontrar alguém melhor.\""

# game/end_game2.rpy:982
translate pt_br end_game2_2e20aa42:

    # a "\"Wha—If you're so worried about wasting time, why are we doing just that?\""
    a "\"Mas o q—Se você está tão preocupada sobre perder tempo, por que estamos fazendo exatamente isso?\""

# game/end_game2.rpy:985
translate pt_br end_game2_d681505c:

    # v "\"Teacher Veteris is entertaining them on a tour. You'd better think of a good excuse before they return...actually, just pretend it didn't happen.\""
    v "\"Professor Veteris os está entretendo com uma excursão. É melhor pensar em uma boa desculpa antes que eles retornem... na verdade, apenas finja que não aconteceu.\""

# game/end_game2.rpy:987
translate pt_br end_game2_ffb95151:

    # a "\"Oh? That sounds like something you wouldn't want me to do.\""
    a "\"Hã? Isso soa como algo que você não gostaria que eu fizesse.\""

# game/end_game2.rpy:989
translate pt_br end_game2_c54a6d08:

    # v "\"Khemians are different. I suggest you not try to trick them. Let's go in for now, I think I hear them.\""
    v "\"Khemianos são diferentes. Sugiro que você não tente enganá-los. Vamos entrar por enquanto, acho que estou ouvindo eles.\""

# game/end_game2.rpy:990
translate pt_br end_game2_d893a456:

    # "Sure enough, I hear echoing voices up the hallways."
    "Dito e feito, ouço vozes ecoando pelos corredores."

# game/end_game2.rpy:994
translate pt_br end_game2_50b7999e:

    # "Amicus turns to me, giving me a quick hug, again reassuring me that he won't be long before following Virginia up the hall and disappearing behind a sliding door."
    "Amicus se vira para mim, me dando um rápido abraço, novamente me assegurando que não demorará muito antes de seguir Virginia pelo corredor e desaparecer atrás de uma porta deslizante."

# game/end_game2.rpy:995
translate pt_br end_game2_6947fead:

    # "Neferu, who I had completely forgotten about, walks past me, heading for the room as well."
    "Neferu, de quem eu tinha esquecido completamente, passa por mim, indo também em direção à sala."

# game/end_game2.rpy:996
translate pt_br end_game2_d82f6709:

    # "I frown, noting the dull look on his face, the one he'd been wearing since the carriage ride."
    "Eu arqueio as sobrancelhas, notando a expressão maçante em seu rosto, uma que insiste em não sair desde o passeio na carruagem."

# game/end_game2.rpy:997
translate pt_br end_game2_702cfbe4_2:

    # m "\"You alright?\""
    m "\"Você tá bem?\""

# game/end_game2.rpy:998
translate pt_br end_game2_9a956c45:

    # "I ask him just as he passes me."
    "Eu pergunto assim que ele passa por mim."

# game/end_game2.rpy:999
translate pt_br end_game2_ca970397:

    # "He glances toward me."
    "Ele olha na minha direção."

# game/end_game2.rpy:1001
translate pt_br end_game2_589a1f8c:

    # n "\"Of course.\""
    n "\"É claro.\""

# game/end_game2.rpy:1002
translate pt_br end_game2_86f2fd8e:

    # "He doesn't even make an effort to make it look like that's the case before walking through the door as well."
    "Ele nem se esforça para fazer parecer que esse é o caso antes de passar pela porta também."

# game/end_game2.rpy:1004
translate pt_br end_game2_e80df5ff:

    # "The voices get closer, coming from a bend in the hallway up ahead."
    "As vozes se aproximam, vindo de uma curva no corredor mais à frente."

# game/end_game2.rpy:1005
translate pt_br end_game2_9fe3bc6d:

    # "Not really wanting to be seen, I move back toward the sculptures, hiding myself amongst them."
    "Não querendo realmente ser visto, ando para trás na direção das esculturas, me escondendo entre elas."

# game/end_game2.rpy:1006
translate pt_br end_game2_b016ef3a:

    # "Technically all of Adastra City knows who I am, my face having been shown on the giant screens in the city, on loop, for months."
    "Tecnicamente toda a cidade de Adastra sabe quem sou eu, meu rosto tendo sido mostrado sem parar nas telas gigantes da cidade por meses."

# game/end_game2.rpy:1007
translate pt_br end_game2_0130da93:

    # "Still, I'm odd enough that I feel like it would just cause more trouble than it would be worth if I'm seen."
    "Ainda assim, sou tão estranho para eles que sinto que só causaria mais problemas que o necessário se fosse visto."

# game/end_game2.rpy:1008
translate pt_br end_game2_f850826d:

    # "So I peer around a statue wolf's waist, feeling like a stalker as I watch the small crowd approaching the door that Amicus, Virginia, and Neferu walked through."
    "Então, olho pela lateral da cintura de uma estátua de lobo, me sentindo como um espião enquanto observo a pequena multidão se aproximando da porta a qual Amicus, Virginia e Neferu entraram."

# game/end_game2.rpy:1009
translate pt_br end_game2_41c13eb1:

    # "A very short, old wolf leads the way, followed by only the second jackal I've ever seen in person."
    "Um lobo idoso e bem baixo lidera o caminho, seguido apenas pelo segundo chacal o qual já vi pessoalmente."

# game/end_game2.rpy:1010
translate pt_br end_game2_4ad6f3e4:

    # "He's taller and thinner than Neferu, and there's an icy-cold expression on his face."
    "Ele é mais alto e mais magro que Neferu, e há uma expressão fria em seu rosto."

# game/end_game2.rpy:1011
translate pt_br end_game2_9bb7a261:

    # "I imagine him to be the vizier, and next to him walks a rather broad-shouldered creature that vaguely looks like a wolverine."
    "Imagino que seja o vizir, ao lado dele anda uma criatura de ombros largos que se parece vagamente com um carcaju."

# game/end_game2.rpy:1012
translate pt_br end_game2_fbc109f9:

    # "His clothing and the paint on his fur is definitely Khemian, so I assume him to be the ambassador."
    "As roupas e a pintura em seu pelo são definitivamente khemianos, então presumo que ele seja o embaixador."

# game/end_game2.rpy:1013
translate pt_br end_game2_fbf094d4:

    # "Finally, a younger wolf brings up the rear, one that has longer fur on his neck which he he's styled into a braid."
    "Finalmente, um lobo mais novo aparece atrás, seu pelo mais longo no pescoço, amarrado em uma trança."

# game/end_game2.rpy:1014
translate pt_br end_game2_8d29d7e0:

    # "I'd heard about wolves with manes at some point in my studies, a trait that had been cultivated amongst Adastra's more influential families, a status symbol of the elite."
    "Já ouvi falar sobre lobos com crina em algum momento dos meus estudos, uma característica que tinha sido cultivada entre as famílias mais influentes de Adastra, um símbolo de status da elite."

# game/end_game2.rpy:1015
translate pt_br end_game2_4c35db63:

    # "The braided wolf starts to look in my direction, and that's when I pull back quickly, hiding myself behind the marble and waiting until I hear the door slide shut again."
    "O lobo trançado começa a olhar na minha direção e é quando eu recuo rapidamente, me escondendo atrás do mármore e esperando até escutar a porta se fechando."

# game/end_game2.rpy:1016
translate pt_br end_game2_5593e621:

    # "I'm left alone, standing amongst the quiet, spotless marble of the expansive university."
    "Sou deixado sozinho no cômodo de mármore impecável e silencioso da ampla universidade."

# game/end_game2.rpy:1017
translate pt_br end_game2_eb7fe493:

    # "At first, I sit on a bench, quietly taking in the architecture, thinking about how cool it would be if I could come here to study instead."
    "No começo, me sento em um banco, observando silenciosamente a arquitetura, pensando em como seria legal se eu viesse estudar aqui em vez de lá na Terra."

# game/end_game2.rpy:1018
translate pt_br end_game2_f4fa9e94:

    # "Though, now I know that this is the most prestigious university in Adastra, having seen the giant name carved into the face of the building on the way in."
    "No entanto, agora eu sei que essa é a universidade mais prestigiosa em Adastra depois de ver o nome gigante gravado na face do edifício a caminho do lado de dentro."

# game/end_game2.rpy:1019
translate pt_br end_game2_a189263a:

    # "Varro's University."
    "Universidade Varro."

# game/end_game2.rpy:1020
translate pt_br end_game2_adb20125:

    # "Or just Varro."
    "Ou só Varro."

# game/end_game2.rpy:1021
translate pt_br end_game2_888b6e2a:

    # "Only the smartest young wolves study here along with wolves from the richest families in Adastra."
    "Apenas os jovens lobos mais inteligentes estudam aqui, juntamente com os lobos das famílias mais ricas de Adastra."

# game/end_game2.rpy:1022
translate pt_br end_game2_224926fc:

    # "However, from the handful of times that it came up in Com's ramblings, it sounded like it was one of the most progressive places on the moon."
    "Entretanto, das poucas vezes em que foi citada nas divagações do Com, soou como um dos lugares mais progressistas da lua."

# game/end_game2.rpy:1023
translate pt_br end_game2_4d594602:

    # "It was one of the first elite universities to allow women to study inside the school, rather than having to sit in a separate, cheaper building on the outskirts of campus."
    "Foi uma das primeiras universidades de elite a permitir que mulheres estudassem dentro da universidade, em vez de ter que fazer isso em um edifício separado e mais barato nos arredores do campus."

# game/end_game2.rpy:1024
translate pt_br end_game2_c51fea56:

    # "That was just fifty years ago, finally allowed under the rule of Amicus's father."
    "Isso foi há apenas cinquenta anos, finalmente permitido sob o mandato do pai do Amicus."

# game/end_game2.rpy:1025
translate pt_br end_game2_c91b88fc:

    # "Eventually, I grow bored with just sitting there and start to walk around, looking at the sculptures and plaques."
    "Eventualmente, fico entediado de só ficar sentado lá e começo a perambular por aí, observando as esculturas e placas."

# game/end_game2.rpy:1026
translate pt_br end_game2_7bccdc9e:

    # "They give short descriptions of the various wolves the sculptures depict, and I try to piece together what I can with my limited written Language knowledge."
    "Elas dão descrições curtas dos vários lobos retratados pelas esculturas e eu tento reunir tudo o que posso com meu conhecimento limitado da linguagem escrita."

# game/end_game2.rpy:1027
translate pt_br end_game2_b08e75a1:

    # "Notable is the one in the middle, Varro, the university's namesake."
    "O do meio é notável, Varro, a quem se deve o nome da universidade."

# game/end_game2.rpy:1028
translate pt_br end_game2_90fc5a55:

    # "He apparently studied the education system on Omorfa before implementing that system on Adastra."
    "Aparentemente ele estudou o sistema educacional de Omorfa antes de implementá-lo em Adastra."

# game/end_game2.rpy:1029
translate pt_br end_game2_613a9ea1:

    # "This alone shows how different this university is from the rest of Adastra."
    "Isso por si só mostra quão diferente essa universidade é do resto de Adastra."

# game/end_game2.rpy:1030
translate pt_br end_game2_88924269:

    # "The wolves, especially the politicians, would {i}never{/i} admit to borrowing anything from the cats, even though they borrowed plenty."
    "Os lobos, especialmente os políticos, {i}nunca{/i} admitiriam ter pego algo emprestado dos gatos, mesmo tendo feito isso muitas vezes."

# game/end_game2.rpy:1031
translate pt_br end_game2_63d5fb6c:

    # "But...even here, there are only sculptures of wolves."
    "Ainda assim... mesmo aqui, há apenas esculturas de lobos."

# game/end_game2.rpy:1032
translate pt_br end_game2_ddf208bb:

    # "No siblings, no children, nothing."
    "Sem irmãos, sem infantes, nada."

# game/end_game2.rpy:1033
translate pt_br end_game2_fef5d58c:

    # "It reminds me of one of the biggest issues I've been wrestling with the past few months...how separate I feel from this society."
    "Isso me lembra de um dos maiores problemas que eu venho enfrentando nos últimos meses... como me sinto alheio a essa sociedade."

# game/end_game2.rpy:1034
translate pt_br end_game2_8001c494:

    # "It's to be expected."
    "É de se esperar."

# game/end_game2.rpy:1035
translate pt_br end_game2_f2f72512:

    # "I'm on an alien world after all."
    "Estou em um mundo alienígena, afinal."

# game/end_game2.rpy:1036
translate pt_br end_game2_1ecbed71:

    # "But it's a world of many different creatures and cultures, yet the wolves seem to be doing their best to ignore that."
    "Mas é um mundo de muitas criaturas e culturas diferentes, ainda assim os lobos parecem estar fazendo o melhor que podem para ignorar isso."

# game/end_game2.rpy:1037
translate pt_br end_game2_0652606e:

    # "I realize that I will never be part of this society, even if humans are successfully integrated into the {i}Galaxias{/i}."
    "Percebo então que nunca farei parte dessa sociedade, mesmo que os humanos sejam integrados com sucesso à {i}congregação galáctica{/i}."

# game/end_game2.rpy:1038
translate pt_br end_game2_7048201d:

    # "In fact, I already know what the wolven reaction to human society will be:"
    "Na verdade, já sei qual vai ser a reação lobina à sociedade humana:"

# game/end_game2.rpy:1039
translate pt_br end_game2_a5d53513:

    # "Suspicion, condescension, and overall jealousy at the idea of a race that seemingly uplifted itself, a species assigned a role that's different than all the rest."
    "Suspeita, condescendência e inveja generalizada com a ideia de uma raça que aparentemente elevou a si mesma, uma espécie que atribuiu um papel diferente de todo o resto."

# game/end_game2.rpy:1040
translate pt_br end_game2_66df781f:

    # "It doesn't matter that I'm liked by them now."
    "Não importa que eu seja adorado por eles agora."

# game/end_game2.rpy:1041
translate pt_br end_game2_959d393f:

    # "It's only because I'm a seemingly dumb, parent-less, ape."
    "Eles só agem assim porque eu aparentemente sou um macaco burro sem progenitor."

# game/end_game2.rpy:1042
translate pt_br end_game2_109a5622:

    # "They will come to despise me just as they despise the Khemians."
    "Eventualmente virão a me desprezar assim como desprezam os khemianos."

# game/end_game2.rpy:1043
translate pt_br end_game2_6c2c7cda:

    # "Is it worth it to deal with all that, only to be with Amicus?"
    "Vale a pena lidar com tudo isso só para estar com o Amicus?"

# game/end_game2.rpy:1044
translate pt_br end_game2_86f5af5d:

    # "I know the answer, but I still contemplate."
    "Eu sei a resposta, mas ainda fico pensando sobre."

# game/end_game2.rpy:1045
translate pt_br end_game2_fa81bc1d:

    # "As my thought process spirals, I even think for a moment that maybe Alex had the right idea...but no, thoughts like that always bring me back down."
    "Enquanto meu processo de pensamento dá uma espiralada, eu até penso por um momento que talvez Alex tivesse a ideia certa... mas não, pensamentos como esse sempre me fazem colocar os pés no chão."

# game/end_game2.rpy:1046
translate pt_br end_game2_e0155605:

    # "It reminds me that humans, wolves, and all the rest of the {i}Galaxias{/i} aren't so different in the end."
    "Me lembra que humanos, lobos e todo o resto da {i}congregação galáctica{/i} não são tão diferentes assim no final."

# game/end_game2.rpy:1047
translate pt_br end_game2_8dec85f6:

    # "Which means I have to hope that the parents {i}are{/i} different, because I don't think I can trust gods that act like I do."
    "O que significa que eu ao menos espero que os progenitores {i}sejam{/i} diferentes, porque não acho que posso confiar em deuses que agem como eu."

# game/end_game2.rpy:1048
translate pt_br end_game2_6ae01a40:

    # "I try to distract myself, walking around the big marble halls, looking into different rooms, and reading any inscriptions I can find."
    "Eu tento me distrair, andando pelos grandes corredores de mármore, observando salas diferentes e lendo qualquer inscrição que consigo encontrar."

# game/end_game2.rpy:1049
translate pt_br end_game2_63e323a7:

    # "The \"game room\" in the basement is just a series of tables with various board games that I've never learned to play."
    "A \"sala de jogos\" no porão é simplesmente uma série de mesas com vários jogos de tabuleiro os quais eu nunca aprendi a jogar."

# game/end_game2.rpy:1050
translate pt_br end_game2_edf254cc:

    # "After a while, it becomes clear that this isn't going to be a quick meeting."
    "Depois de um tempo, fica claro que essa reunião não vai acabar rápido."

# game/end_game2.rpy:1052
translate pt_br end_game2_ec23975d:

    # "The hours go by slowly, and while I would usually be pretty ticked off at Amicus at this point, I'm mostly just sad."
    "As horas se passam devagar, e embora eu normalmente ficaria bem irritado com o Amicus a essa altura, estou em grande parte apenas triste."

# game/end_game2.rpy:1053
translate pt_br end_game2_c70714e2:

    # "Being alone amongst towering, marble pillars isn't so different from the palace, and still, this is actually a nice change of pace."
    "Estar sozinho entre pilares de mármore enormes não é tão diferente do palácio, e ainda assim, essa é na verdade uma boa mudança de ares."

# game/end_game2.rpy:1054
translate pt_br end_game2_9de5a081:

    # "I just wish I could be spending more time with Amicus."
    "Eu só queria poder passar mais tempo com o Amicus."

# game/end_game2.rpy:1055
translate pt_br end_game2_9988bc7b:

    # "Eventually, I find a bunch of folded red cloth piled on a table, looking like banners for what could be the school flag, or colors, or something."
    "Eventualmente, encontro um monte de panos vermelhos dobrados empilhados em uma mesa, parecendo um tecido que poderia servir de bandeira da universidade, ou algo assim."

# game/end_game2.rpy:1056
translate pt_br end_game2_37bcbe6d:

    # "I grab a couple of these before scouting out a marble bench hidden in the corner of the main room, behind the statues and out of sight of the door."
    "Eu pego alguns desses antes de procurar um banco de mármore escondido no canto do salão principal, atrás das estátuas e fora de vista da porta."

# game/end_game2.rpy:1057
translate pt_br end_game2_12c40c9f:

    # "I lie down on the bench, flat on my back, laying the cloth under my head."
    "Eu deito no banco de costas, colocando o pano debaixo da minha cabeça."

# game/end_game2.rpy:1058
translate pt_br end_game2_9cdbfa8d:

    # "I'm tired after being woken up so much earlier than I'm used to, and it's not long before I'm drifting off to sleep..."
    "Estou cansado depois de ter sido acordado muito mais cedo que o normal, e não demora muito até eu começar a cair no sono..."

# game/end_game2.rpy:1062
translate pt_br end_game2_dd7fa190:

    # "Space stretches and twists into the distance, the infinite dark blue broken here and there with planets, stars, and dust clouds."
    "O espaço se estende e distorce à distância, o infinito azul escuro se quebrando aqui e ali com planetas, estrelas e nuvens de poeira."

# game/end_game2.rpy:1063
translate pt_br end_game2_f296672d:

    # "It's endless, monolithic, passionless..."
    "É sem fim, monolítico, sem paixão..."

# game/end_game2.rpy:1064
translate pt_br end_game2_1bff11b5:

    # "Except there."
    "Exceto aqui."

# game/end_game2.rpy:1065
translate pt_br end_game2_8b7829bb:

    # "Its mark is clear on the universe, like a stain, a blemish on the glittering patchwork of stars."
    "Sua marca é evidente no universo, como um borrão, uma mancha na colcha de retalhos brilhante das estrelas..."

# game/end_game2.rpy:1066
translate pt_br end_game2_d8c6c497:

    # "The planets die, the stars shrivel, the dust scatters."
    "Os planetas morrem, as estrelas se apagam, a poeira se espalha."

# game/end_game2.rpy:1067
translate pt_br end_game2_277592d0:

    # "It's all tainted."
    "Está tudo contaminado."

# game/end_game2.rpy:1068
translate pt_br end_game2_61ff649b:

    # "The mark is old."
    "A marca é velha."

# game/end_game2.rpy:1069
translate pt_br end_game2_8bf4761b:

    # "It's ancient."
    "É antiga."

# game/end_game2.rpy:1070
translate pt_br end_game2_5c1b5cc5:

    # "It existed before life."
    "Existia antes da vida."

# game/end_game2.rpy:1071
translate pt_br end_game2_9c83a385:

    # "{i}Our{/i} life."
    "{i}Nossa{/i} vida."

# game/end_game2.rpy:1072
translate pt_br end_game2_e3a6d777:

    # "It touches every life form from the youngest child to the oldest sibling."
    "Toca todas as formas de vida, desde o infante mais novo até o irmão mais velho."

# game/end_game2.rpy:1073
translate pt_br end_game2_b49f6069:

    # "It convulses before your eyes in the dark."
    "Eles convulsionam diante de seus olhos no escuro."

# game/end_game2.rpy:1074
translate pt_br end_game2_b3af052a:

    # "It whispers in your ear while you sleep."
    "Eles sussurram em seu ouvido enquanto você dorme."

# game/end_game2.rpy:1075
translate pt_br end_game2_0168ccc8:

    # "It brushes your neck when you don't see."
    "Eles deslizam por seu pescoço quando você não vê."

# game/end_game2.rpy:1076
translate pt_br end_game2_f872b3f0:

    # "We all feel it."
    "Todos nós os sentimos."

# game/end_game2.rpy:1077
translate pt_br end_game2_cf68f8c1:

    # "We all know it."
    "Todos nós os conhecemos."

# game/end_game2.rpy:1078
translate pt_br end_game2_d7a27e2c:

    # "It transcends all, it touches all, it {i}becomes{/i} all."
    "Transcende tudo, toca em tudo, {i}torna-se{/i} tudo."

# game/end_game2.rpy:1079
translate pt_br end_game2_f43fd1f4:

    # "\"{cps=22}{i}I see you...{/i}\""
    "\"{cps=22}{i}Eu vejo você...{/i}\""

# game/end_game2.rpy:1080
translate pt_br end_game2_f6a4dda9:

    # "The black tendrils of its reach already infect everything around you."
    "As gavinhas negras de seu alcance já infectam tudo ao seu redor."

# game/end_game2.rpy:1081
translate pt_br end_game2_95cf7678:

    # "\"{cps=22}{i}They're going to kill you...They're going to kill him...Your purpose is doomed...{/i}\""
    "\"{cps=22}{i}Eles matarão você... matarão ele... seu propósito está condenado.{/i}\""

# game/end_game2.rpy:1082
translate pt_br end_game2_71246463:

    # "And yet, you know that this is only the beginning, that soon it will blanket everything."
    "E no entanto, você sabe que isso é apenas o começo, que em breve, eles cobrirão tudo."

# game/end_game2.rpy:1083
translate pt_br end_game2_4cab159b:

    # "\"{cps=22}{i}You will die...He will die...Trapped in the amalgamation forever...apart...{/i}\""
    "\"{cps=22}{i}Você vai morrer... ele vai morrer... presos na amálgama para sempre... separados...{/i}\""

# game/end_game2.rpy:1084
translate pt_br end_game2_03b7467d:

    # "And that's when it won't hide in the dark anymore..."
    "E é quando eles não mais se esconderão no escuro..."

# game/end_game2.rpy:1087
translate pt_br end_game2_b641b5fd:

    # "I gasp loudly, sitting up on the bench, feeling like something had been sitting on my chest."
    "Eu bufo ruidosamente, sentando no banco, sentindo como se algo estivesse sentado em meu peito."

# game/end_game2.rpy:1088
translate pt_br end_game2_16e18701:

    # "I feel like I've been holding my breath...or something had pushed it out."
    "Sinto como se estivesse prendendo a respiração... ou como se algo tivesse empurrado o ar para fora."

# game/end_game2.rpy:1089
translate pt_br end_game2_2a3fcf2b:

    # "\"{cps=22}{i}..die...{/i}\""
    "\"{cps=22}{i}...morrer...{/i}\""

# game/end_game2.rpy:1090
translate pt_br end_game2_c068a429:

    # "A faint whisper to my left, and when I look, just for the briefest of moments, it seems as if the crouched wolf statue is contorted."
    "Ouço um leve sussurro à minha esquerda, e quando olho, apenas pelo mais breve dos momentos, parece que a estátua agachada do lobo ficou contorcida."

# game/end_game2.rpy:1091
translate pt_br end_game2_ac203bb0:

    # "Its neck is broken, staring straight back at me."
    "Seu pescoço, quebrado, olhando diretamente para mim."

# game/end_game2.rpy:1092
translate pt_br end_game2_ea37f14f:

    # "I jump, leaning back as I stare at the grotesquely twisted wolf, but it's not twisted, it's like it always was..."
    "Eu me assusto, me inclinando para trás enquanto encaro o lobo grotescamente distorcido, mas não está distorcido, continua como sempre foi."

# game/end_game2.rpy:1094
translate pt_br end_game2_faf6cd3f:

    # "And then I'm falling off the bench, landing hard on my ass and sending a jolt of pain through my tail bone."
    "E então estou caindo do banco, pousando com força na minha bunda e enviando uma onda de dor através do cóccix."

# game/end_game2.rpy:1097
translate pt_br end_game2_99f2c6f1:

    # "I can't help the involuntary yelp that comes out of my mouth."
    "Não consigo evitar o grito involuntário que sai da minha boca."

# game/end_game2.rpy:1098
translate pt_br end_game2_804cd142_1:

    # a "\"[mc]?\""
    a "\"[mc]?\""

# game/end_game2.rpy:1099
translate pt_br end_game2_b3d55b08:

    # "Amicus's voice echoes through halls, making me scramble to my feet, suddenly embarrassed about what had just happened."
    "A voz do Amicus ecoa pelos corredores, fazendo com que eu me levante, subitamente envergonhado com o que acabou de acontecer."

# game/end_game2.rpy:1100
translate pt_br end_game2_220eb1e7:

    # "I clear my throat in a way that sounds casual."
    "Eu pigarreio de uma maneira que parece casual."

# game/end_game2.rpy:1101
translate pt_br end_game2_c5f7a6a9:

    # m "\"I'm over here.\""
    m "\"Tô por aqui.\""

# game/end_game2.rpy:1102
translate pt_br end_game2_f45fb9c1:

    # "I move out from behind the statues, glancing one last time at the crouched wolf, neck in its proper position."
    "Eu saio de trás das estátuas, olhando uma última vez na direção do lobo agachado, seu pescoço na posição correta."

# game/end_game2.rpy:1103
translate pt_br end_game2_867d38f9:

    # "{i}It whispers in your ear while you sleep...{/i}"
    "{i}Eles sussurram em seu ouvido enquanto você dorme...{/i}"

# game/end_game2.rpy:1104
translate pt_br end_game2_437280fc:

    # "When my back is to it, the nape of my neck prickles, and I hurry out from my hiding spot."
    "Quando fico de costas para ele, sinto um arrepio na nuca e saio correndo do meu esconderijo."

# game/end_game2.rpy:1105
translate pt_br end_game2_3ac44e5b:

    # "As I move out into the brightly lit main room, I realize that it's already dark."
    "À medida que adentro o salão principal bem iluminado, percebo que já ficou escuro."

# game/end_game2.rpy:1106
translate pt_br end_game2_14e56174:

    # "I've been here all day."
    "Eu estive aqui o dia todo."

# game/end_game2.rpy:1107
translate pt_br end_game2_d086ee83:

    # a "\"Where?\""
    a "\"Onde?\""

# game/end_game2.rpy:1108
translate pt_br end_game2_15639431:

    # "Amicus's voice seems to come from further away, up the hall."
    "A voz do Amicus parece vir de mais longe, em cima no corredor."

# game/end_game2.rpy:1109
translate pt_br end_game2_ddda9d21:

    # m "\"Here!\""
    m "\"Aqui!\""

# game/end_game2.rpy:1110
translate pt_br end_game2_a6babd6e:

    # "I just want him to come get me."
    "Eu só quero que ele venha me buscar."

# game/end_game2.rpy:1111
translate pt_br end_game2_99f92f03:

    # "I had a nightmare, or something, but it had felt so cold, dark...and real."
    "Tive um pesadelo, ou algo assim, mas parecia tão frio, escuro... e real."

# game/end_game2.rpy:1112
translate pt_br end_game2_aa072113:

    # "I hear some footsteps padding up the hall, and I turn to see Amicus come around the corner, his paws clasped together."
    "Ouço alguns passos batendo pelo corredor e me viro para ver o Amicus dobrando a esquina, suas patas juntas."

# game/end_game2.rpy:1115
translate pt_br end_game2_acb86774:

    # a "\"[mc]? I am so, so, so sorry. They wouldn't agree on anything, and I couldn't excuse myself to come see you because that would make it look as if I—\""
    a "\"[mc]? Eu sinto muito, muito, muito mesmo. Eles não queriam concordar com nada e eu não podia pedir licença para te ver porque isso faria parecer como se eu—\""

# game/end_game2.rpy:1117
translate pt_br end_game2_4eebb6b7:

    # "I cut Amicus off by hugging him, just wanting to feel his presence for now."
    "Eu interrompo o Amicus com um abraço, apenas querendo sentir sua presença no momento."

# game/end_game2.rpy:1118
translate pt_br end_game2_15fe9223:

    # "The depressing thoughts I'd had all day, on top of that awful nightmare...at least what I hope was a nightmare, has left me feeling like complete shit."
    "Os pensamentos deprimentes que tive o dia todo, além daquele pesadelo horrível... ao menos espero que tenha sido um pesadelo, me deixaram com um sentimento péssimo."

# game/end_game2.rpy:1119
translate pt_br end_game2_012c0fd7:

    # a "\"Are you alright?\""
    a "\"Você está bem?\""

# game/end_game2.rpy:1120
translate pt_br end_game2_fe09af0d:

    # "I'm quiet for a moment, wondering if I should tell Amicus anything about what I was thinking, what I saw...then decide against it, at least for now."
    "Fico quieto por um momento, me perguntando se deveria contar ao Amicus qualquer coisa sobre o que pensei, o que eu vi... então, decido não fazer isso, pelo menos por enquanto."

# game/end_game2.rpy:1121
translate pt_br end_game2_ecc028a1:

    # m "\"I'm just happy to see you.\""
    m "\"Só tô feliz em te ver.\""

# game/end_game2.rpy:1123
translate pt_br end_game2_caa0de5c:

    # a "\"Really? Even after suffering through my complete incompetence all day long?\""
    a "\"Sério? Mesmo depois de sofrer com minha total incompetência o dia todo?\""

# game/end_game2.rpy:1124
translate pt_br end_game2_6763a3dd:

    # "I'm about to scold Amicus for saying that about himself, but then I just end up nodding."
    "Fico prestes a repreender o Amicus por falar isso sobre si mesmo, mas depois acabo acenando com a cabeça."

# game/end_game2.rpy:1125
translate pt_br end_game2_62565fa2:

    # m "\"Yeah...We all have days like that. Did everyone leave?\""
    m "\"É... todo mundo tem dias assim. O pessoal foi embora?\""

# game/end_game2.rpy:1126
translate pt_br end_game2_79b4bae6:

    # a "\"Yes, the meeting concluded about ten minutes ago. I had worried you'd left the university for whatever reason.\""
    a "\"Sim, a reunião foi concluída há cerca de dez minutos. Fiquei preocupado que você tivesse deixado a universidade por qualquer motivo.\""

# game/end_game2.rpy:1127
translate pt_br end_game2_96c48d19:

    # m "\"Sorry.\""
    m "\"Foi mal.\""

# game/end_game2.rpy:1129
translate pt_br end_game2_aeb0979f:

    # a "\"Don't be. Were you sleeping?\""
    a "\"Não se desculpe. Estava dormindo?\""

# game/end_game2.rpy:1130
translate pt_br end_game2_c806ebc0:

    # m "\"Yeah.\""
    m "\"Sim.\""

# game/end_game2.rpy:1132
translate pt_br end_game2_7eb761af:

    # a "\"Well, that's good, because I'm hoping...even after how poorly the day went, that you might join me for a late night Lover's Day celebration?\""
    a "\"Bem, isso é bom, porque eu estou esperando... mesmo depois do dia ter se seguido tão mal, que você se junte a mim para uma celebração noturna do dia dos amores?\""

# game/end_game2.rpy:1134
translate pt_br end_game2_7ddcaa1a:

    # "He never gives up, and I do love that about him."
    "Ele nunca desiste e eu amo isso nele."

# game/end_game2.rpy:1135
translate pt_br end_game2_ad10a89a:

    # "I smile."
    "Eu sorrio."

# game/end_game2.rpy:1136
translate pt_br end_game2_65ef732e:

    # m "\"That sounds great, Amicus.\""
    m "\"Parece ótimo, Amicus.\""

# game/end_game2.rpy:1139
translate pt_br end_game2_8b3939f4:

    # "We walk down the steps from the main building into an empty courtyard, all of the vehicles gone."
    "Descemos os degraus do edifício principal até um pátio vazio, todos os veículos desaparecidos."

# game/end_game2.rpy:1140
translate pt_br end_game2_e499761a_2:

    # "I frown."
    "Eu arqueio as sobrancelhas."

# game/end_game2.rpy:1141
translate pt_br end_game2_eec9377f:

    # m "\"They just left us without any transportation?\""
    m "\"Eles só deixaram a gente aqui sem nenhum transporte?\""

# game/end_game2.rpy:1143
translate pt_br end_game2_90ba4167:

    # a "\"Oh yes, I told them to go on ahead.\""
    a "\"Ah, sim, eu disse para eles irem embora.\""

# game/end_game2.rpy:1144
translate pt_br end_game2_62a5f071:

    # m "\"Oh, why?\""
    m "\"Ah, por que?\""

# game/end_game2.rpy:1146
translate pt_br end_game2_3174351e:

    # a "\"Do you not wish to walk?\""
    a "\"Você não quer caminhar?\""

# game/end_game2.rpy:1147
translate pt_br end_game2_b6161ada:

    # m "\"Isn't it a little far to walk?\""
    m "\"Não é um pouco longe pra caminhar?\""

# game/end_game2.rpy:1148
translate pt_br end_game2_649935a5:

    # "I follow Amicus down the steps and through the university's gardens before we're back in the forest, walking in the direction away from the palace."
    "Sigo o Amicus pelos degraus e através dos jardins da universidade antes de voltarmos à floresta, caminhando na direção oposta ao palácio."

# game/end_game2.rpy:1150
translate pt_br end_game2_45d2986b:

    # a "\"Not really. The city and palace are within reasonable walking distance.\""
    a "\"Na verdade, não. A cidade e o palácio estão a uma distância razoável para se caminhar.\""

# game/end_game2.rpy:1151
translate pt_br end_game2_4c814a29:

    # "I walk alongside the wolf, feeling myself relax again as we're surrounded by the quiet forest."
    "Eu ando ao lado do lobo, me sentindo relaxar novamente conforme somos cercados pela floresta tranquila."

# game/end_game2.rpy:1154
translate pt_br end_game2_fef5c314:

    # m "\"Huh, guess I just assumed it was far since we're always using the carriage.\""
    m "\"Hã, acho que eu só pensei que era longe já que a gente tá sempre usando a carruagem.\""

# game/end_game2.rpy:1155
translate pt_br end_game2_257e85d1:

    # a "\"We tend to be lazy. That, and it's expected by the citizens as it's seen as more...dignified, I suppose.\""
    a "\"Tendemos a ser preguiçosos. E é esperado pelos cidadãos já que é visto como mais... digno, eu acho.\""

# game/end_game2.rpy:1156
translate pt_br end_game2_32706b74:

    # m "\"Hmm, what about security? Shouldn't you have some protection as emperor?\""
    m "\"Hmm, e a segurança? Você não deveria ter alguma proteção como imperador?\""

# game/end_game2.rpy:1157
translate pt_br end_game2_c5351760:

    # "I look around, feeling almost vulnerable out here in the open with Amicus, used to always having the protection of the palace walls around us."
    "Eu olho em volta, quase me sentindo vulnerável aqui ao ar livre com o Amicus, acostumado a ter sempre a proteção das muralhas do palácio ao nosso redor."

# game/end_game2.rpy:1159
translate pt_br end_game2_4331b431:

    # "Amicus glances up, and I follow his gaze, immediately spotting the blinking lights of drones above us."
    "Amicus olha para cima e eu sigo seu olhar, imediatamente percebendo as luzes dos drones piscando acima de nós."

# game/end_game2.rpy:1160
translate pt_br end_game2_ec0ba95d:

    # a "\"Drones are far better than any sapient when it comes to security.\""
    a "\"Drones são bem melhores que qualquer sapiente quando se trata de segurança.\""

# game/end_game2.rpy:1161
translate pt_br end_game2_b55b53cc:

    # "Amicus looks over at me."
    "Amicus redireciona seu olhar para mim."

# game/end_game2.rpy:1163
translate pt_br end_game2_cd2819b7:

    # a "\"I suppose you haven't been outside the palace very often at all, have you?\""
    a "\"Suponho que você não esteve fora do palácio com muita frequência, não é?\""

# game/end_game2.rpy:1164
translate pt_br end_game2_3a1f371a:

    # m "\"Not really.\""
    m "\"Na verdade, não.\""

# game/end_game2.rpy:1165
translate pt_br end_game2_34b22650:

    # "The wolf grimaces."
    "O lobo faz uma careta."

# game/end_game2.rpy:1167
translate pt_br end_game2_aacf9463:

    # a "\"I apologize for that. I know it seems like you should be more free to travel after what happened, but the people are...\""
    a "\"Peço desculpas por isso. Sei que é de se esperar que você deveria estar mais livre para viajar depois do que aconteceu, mas as pessoas estão...\""

# game/end_game2.rpy:1168
translate pt_br end_game2_59409490:

    # "Amicus takes a moment to find his words."
    "Amicus leva um momento para encontrar as palavras."

# game/end_game2.rpy:1170
translate pt_br end_game2_daeb0b09:

    # a "\"...very curious about you. It would be difficult to keep them from crowding.\""
    a "\"(...) muito curiosas sobre você. Seria difícil de impedir uma aglomeração.\""

# game/end_game2.rpy:1171
translate pt_br end_game2_63478cee:

    # "I raise an eyebrow as I see lights in the distance, twinkling through the tree branches."
    "Levanto uma sobrancelha quando vejo as luzes ao longe, brilhando através dos galhos das árvores."

# game/end_game2.rpy:1172
translate pt_br end_game2_59648285:

    # m "\"But we're heading to the city right now, aren't we?\""
    m "\"Mas a gente tá indo pra cidade agora, não?\""

# game/end_game2.rpy:1173
translate pt_br end_game2_21493a8f:

    # "I don't think I can deal with crowds, at least not now when I'm not really prepared for it."
    "Acho que não consigo lidar com multidões, pelo menos não agora, não estando exatamente preparado para isso."

# game/end_game2.rpy:1174
translate pt_br end_game2_3756d470:

    # a "\"Well, I cleared the district for our arrival, though that was supposed to be...I'd say five hours ago.\""
    a "\"Bem, eu liberei o distrito para a nossa chegada, embora devesse ser... eu diria... cinco horas atrás.\""

# game/end_game2.rpy:1176
translate pt_br end_game2_0d9d8caf:

    # a "\"But still, it's late enough that the streets should be mostly empty.\""
    a "\"Mas ainda assim, é tarde o suficiente para que as ruas estejam quase vazias.\""

# game/end_game2.rpy:1177
translate pt_br end_game2_2d6ee573:

    # m "\"Oh.\""
    m "\"Ah.\""

# game/end_game2.rpy:1178
translate pt_br end_game2_757d7f2d:

    # "I draw closer to Amicus."
    "Me aproximo do Amicus."

# game/end_game2.rpy:1179
translate pt_br end_game2_3b69c6f6:

    # m "\"Where are we going?\""
    m "\"Pra onde a gente tá indo?\""

# game/end_game2.rpy:1181
translate pt_br end_game2_47cd483a:

    # a "\"You'll see.\""
    a "\"Você vai ver.\""

# game/end_game2.rpy:1182
translate pt_br end_game2_3b3a7923:

    # "There's a sly smile on the wolf's face as we trudge along the path, walking in comfortable silence."
    "Há um sorriso pretensioso no rosto do lobo enquanto caminhamos pela estrada, andando em um silêncio confortável."

# game/end_game2.rpy:1184
translate pt_br end_game2_544175c0:

    # "Eventually, we break through the trees and into the small, quaint street that I'd been on before."
    "Eventualmente, passamos das árvores e entramos na pequena e pitoresca rua a qual eu já estive antes."

# game/end_game2.rpy:1185
translate pt_br end_game2_669f89da:

    # "Sure enough, it's completely empty aside from one or two figures moving up the sidewalk or standing in a doorway."
    "E realmente está completamente vazia, exceto por uma ou duas pessoas subindo a calçada ou de pé em uma porta."

# game/end_game2.rpy:1186
translate pt_br end_game2_4cb8e272:

    # "I notice then that Amicus is becoming more excited, and it shows in his widening strides, and I have to hurry to keep up."
    "Noto então que Amicus fica mais animado e isso se mostra evidente em seus passos cada vez maiores, fazendo com que eu tenha que me apressar para alcançá-lo"

# game/end_game2.rpy:1187
translate pt_br end_game2_03b61350:

    # "I try to think of where he could possibly be taking me."
    "Eu tento pensar em onde possivelmente ele poderia estar me levando."

# game/end_game2.rpy:1188
translate pt_br end_game2_2e87079d:

    # m "\"Amicus?\""
    m "\"Amicus?\""

# game/end_game2.rpy:1189
translate pt_br end_game2_7c86d643:

    # "The wolf pauses, waiting for me to catch up, then places his paw against the small of my back, and I'm suddenly thrust forward at his speed, forced along in a stumbling gait."
    "O lobo faz uma pausa, esperando que eu o alcance, então coloca a pata na parte de baixo das minhas costas e de repente eu sou empurrado para a frente na velocidade dele, me forçando a correr tropeçando."

# game/end_game2.rpy:1190
translate pt_br end_game2_ea49018d:

    # m "\"Whoa!\""
    m "\"Ei!\""

# game/end_game2.rpy:1192
translate pt_br end_game2_9dcaf365:

    # a "\"Come on, it's right here.\""
    a "\"Vamos, está logo ali.\""

# game/end_game2.rpy:1193
translate pt_br end_game2_f9788974:

    # "The wolf sweeps me under a dark archway."
    "O lobo me traz para baixo de um arco escuro."

# game/end_game2.rpy:1194
translate pt_br end_game2_b4646299:

    # "There's a door in front of us, the soft glow of light barely showing through the frosted glass framing the door."
    "Há uma porta na nossa frente, o brilho suave de luz mal aparecendo através do vidro fosco emoldurado na porta."

# game/end_game2.rpy:1195
translate pt_br end_game2_7e608399:

    # "It looks like it's closed, and I look up at Amicus in question, but the wolf doesn't seem bothered, and simply knocks on the door."
    "Parece que está fechado e eu olho para o Amicus, me questionando, mas o lobo não parece incomodado e simplesmente bate na porta."

# game/end_game2.rpy:1198
translate pt_br end_game2_d803b403:

    # "We wait a few moments, then Amicus leans in toward the crack, talking loudly through it."
    "Esperamos alguns instantes, então Amicus se inclina em direção à fenda, falando alto através dela."

# game/end_game2.rpy:1200
translate pt_br end_game2_92008127:

    # a "\"Helooooo, Gaius?\""
    a "\"Oláááá, Gaius?\""

# game/end_game2.rpy:1201
translate pt_br end_game2_aed55d51:

    # "Something beyond the door blots out the light, and Amicus steps back before suddenly drawing me to his side, as if preparing to introduce me to someone."
    "Algo atrás da porta apaga a luz e Amicus se afasta antes de me puxar para o seu lado, como se estivesse preparando para me introduzir a alguém."

# game/end_game2.rpy:1202
translate pt_br end_game2_e84baeda:

    # "I stand there awkwardly, trying to prepare myself for whatever this is."
    "Eu fico lá parado sem jeito, tentando me preparar para o que quer que seja."

# game/end_game2.rpy:1204
translate pt_br end_game2_735b217d:

    # "When the door opens, it's not what I expect at all:"
    "Quando a porta abre, não é exatamente o que eu esperava:"

# game/end_game2.rpy:1205
translate pt_br end_game2_b34fc509:

    # "An old she-wolf in an apron and with a cloth tied over the top of her head peers around the door, cracked open just enough so that her muzzle can fit through."
    "Uma loba idosa de avental e com um pano amarrado no alto da cabeça espia pela porta, abrindo apenas o suficiente de forma que o focinho se encaixe."

# game/end_game2.rpy:1206
translate pt_br end_game2_39b41e13:

    # "I feel Amicus shift next to me, and he forces his smile even bigger."
    "Sinto o Amicus se mexendo ao meu lado e ele força um sorriso ainda maior."

# game/end_game2.rpy:1208
translate pt_br end_game2_59361f3b:

    # a "\"Hello.\""
    a "\"Olá.\""

# game/end_game2.rpy:1209
translate pt_br end_game2_d32b8a47:

    # "The old woman squints."
    "A velha aperta os olhos."

# game/end_game2.rpy:1210
translate pt_br end_game2_3218a2bf:

    # "Old She-wolf" "\"Hello?\""
    "Loba Idosa" "\"Olá?\""

# game/end_game2.rpy:1212
translate pt_br end_game2_5512288a:

    # "Amicus is quiet for a moment, clearly taken aback by the other wolf's lack of reaction."
    "Amicus fica quieto por um momento, claramente pego de surpresa com a falta de reação da loba."

# game/end_game2.rpy:1213
translate pt_br end_game2_03e8da50:

    # "He clears his throat."
    "Ele pigarreia.."

# game/end_game2.rpy:1215
translate pt_br end_game2_fdebb96d:

    # a "\"I am Amicus, your emperor, and this is [mc], my...companion.\""
    a "\"Eu sou Amicus, seu imperador, e este é [mc], meu... companheiro.\""

# game/end_game2.rpy:1216
translate pt_br end_game2_631756ef:

    # "That's a new title."
    "Esse título é novo."

# game/end_game2.rpy:1217
translate pt_br end_game2_f9e2a1b7:

    # "I look up at the wolf in question, but he goes on staring at the she-wolf who only continues to stare back at him."
    "Eu olho para o lobo em questionamento, mas ele continua encarando a loba, a qual apenas continua encarando de volta."

# game/end_game2.rpy:1219
translate pt_br end_game2_fbb21ad9:

    # a "\"Maybe you are familiar?\""
    a "\"Talvez você esteja familiarizada?\""

# game/end_game2.rpy:1220
translate pt_br end_game2_5d94e76f:

    # "Old She-wolf" "\"Hmm...no, no, I don't think so.\""
    "Loba Idosa" "\"Hmm... não, não, acho que não.\""

# game/end_game2.rpy:1223
translate pt_br end_game2_f00433d3:

    # "Amicus stares, his mouth gaping open while the woman starts to close the door."
    "Amicus fica olhando, sua boca escancarando enquanto a mulher começa a fechar a porta."

# game/end_game2.rpy:1224
translate pt_br end_game2_58f0f6b0:

    # "Quickly, Amicus lets go of me to reach out, stopping the door from closing just by an inch."
    "Rapidamente, Amicus me solta para estender a mão, impedindo que a porta se feche por apenas dois centímetros."

# game/end_game2.rpy:1226
translate pt_br end_game2_589fc791:

    # a "\"Uh, excuse me please, but could you summon Gaius? He will know who I am.\""
    a "\"Hã, com licença, por favor, mas você poderia chamar Gaius? Ele saberá quem eu sou.\""

# game/end_game2.rpy:1227
translate pt_br end_game2_520b41a5:

    # "The old wolf sticks her muzzle back through the crack, glaring now."
    "A velha loba enfia o focinho de volta no espaço entre a porta, encarando."

# game/end_game2.rpy:1228
translate pt_br end_game2_564443d9:

    # "Old She-wolf" "\"Gaius was relieved of his shift three hours ago. You know it's the second hour?\""
    "Loba Idosa" "\"Gaius foi liberado de seu turno três horas atrás. Você sabia que é a segunda hora?\""

# game/end_game2.rpy:1229
translate pt_br end_game2_836d43cd:

    # a "\"I—I had suspected, though I had hoped he would have waited for me—\""
    a "\"Eu—Eu suspeitava, mas tinha esperança que ele esperaria por mim—\""

# game/end_game2.rpy:1230
translate pt_br end_game2_df68772d:

    # "Old She-wolf" "\"You thought wrong, dear.\""
    "Loba Idosa" "\"Você achou errado, querido.\""

# game/end_game2.rpy:1231
translate pt_br end_game2_2fa4382b:

    # "Amicus bristles."
    "Amicus se arrepia."

# game/end_game2.rpy:1233
translate pt_br end_game2_62c32856:

    # a "\"E—Excuse me, but you realize you are speaking to your emperor, woman?\""
    a "\"C—Com licença, mas você percebe que está falando com seu imperador, mulher?\""

# game/end_game2.rpy:1234
translate pt_br end_game2_713d8312:

    # "Now I bristle."
    "Agora eu que me arrepio."

# game/end_game2.rpy:1235
translate pt_br end_game2_9c6d4631:

    # "Even though I don't know what's going on, exactly, I do feel a surge of disappointment at seeing my lover use the \"do you know who I am?\" line."
    "Mesmo que eu não saiba exatamente o que está acontecendo, sinto uma onda de decepção ao ver meu namorado tentar dar uma carteirada."

# game/end_game2.rpy:1236
translate pt_br end_game2_6ae30550:

    # m "\"Amicus...\""
    m "\"Amicus...\""

# game/end_game2.rpy:1237
translate pt_br end_game2_0d50df5d:

    # "I try to say it under my breath so the other wolf doesn't hear."
    "Eu tento dizer isso baixinho para que a loba não ouça."

# game/end_game2.rpy:1239
translate pt_br end_game2_e07a6585:

    # a "\"What? I'm just trying—\""
    a "\"Que foi? Eu só estou tentando—\""

# game/end_game2.rpy:1240
translate pt_br end_game2_f9798fb1:

    # "The door starts to close again, and Amicus quickly reaches out, but this time, the old woman is ready."
    "A porta começa a se fechar outra vez e Amicus rapidamente se aproxima, mas dessa vez a velha se preparou com antecedência."

# game/end_game2.rpy:1241
translate pt_br end_game2_adf1eba1:

    # "She reaches out to smack his paw hard, making Amicus gasp in surprise before the door slams shut."
    "Ela estende a mão para bater em sua pata com força, fazendo Amicus bufar de surpresa antes que a porta se feche."

# game/end_game2.rpy:1243
translate pt_br end_game2_59ee7e3f:

    # a "\"How dare...\""
    a "\"Como ousa...\""

# game/end_game2.rpy:1245
translate pt_br end_game2_c9cb7cb4:

    # "Amicus looks at loss for a moment, as if he's never experienced something like this before and doesn't know what to do, then he tries to open the door, but it's locked."
    "Amicus encara sua derrota por um momento, como se nunca tivesse vivenciado algo assim antes e não sabe o que fazer, depois ele tenta abrir a porta, mas já está trancada."

# game/end_game2.rpy:1246
translate pt_br end_game2_0f4537e5:

    # "He then resorts to pounding on the door with a heavy fist, lips drawn back to show his teeth."
    "Então ele recorre a bater forte na porta com um punho, seus lábios contraídos, mostrando seus dentes."

# game/end_game2.rpy:1248
translate pt_br end_game2_99397d82:

    # a "\"Open the damned door! I was promised a special banquet in the human's honor! Do you hear me, woman!?\""
    a "\"Abra a maldita porta! Me foi prometido um banquete especial em honra aos humanos! Está me ouvindo, mulher!?\""

# game/end_game2.rpy:1249
translate pt_br end_game2_94288fb7:

    # "I reach out, pushing a hand against Amicus's chest."
    "Eu alcanço, pressionando uma mão contra o peito do Amicus."

# game/end_game2.rpy:1250
translate pt_br end_game2_ab22b33b:

    # m "\"Holy shit, Amicus, stop!\""
    m "\"Puta merda, Amicus, para!\""

# game/end_game2.rpy:1251
translate pt_br end_game2_4965e01e:

    # "I hiss at him under my breath, looking around, not having expected to be embarrassed at Amicus's behavior."
    "Eu assobio baixinho para ele, olhando em volta, não tendo esperado me constranger com o comportamento do Amicus."

# game/end_game2.rpy:1252
translate pt_br end_game2_a70a4fdd:

    # "I'm so used to embarrassing myself."
    "Estou tão acostumado a me envergonhar sozinho."

# game/end_game2.rpy:1255
translate pt_br end_game2_3c8805f7:

    # a "\"What?\""
    a "\"Que foi?\""

# game/end_game2.rpy:1256
translate pt_br end_game2_7929d7b1:

    # m "\"Do you hear yourself?\""
    m "\"Você tá se escutando?\""

# game/end_game2.rpy:1257
translate pt_br end_game2_a2bdea04:

    # a "\"What do you mean? I paid for their services and had everything planned—\""
    a "\"Como assim? Eu paguei pelos serviços deles e tinha tudo planejado—\""

# game/end_game2.rpy:1258
translate pt_br end_game2_1df6f853:

    # m "\"We're five hours late!\""
    m "\"A gente tá cinco horas atrasado!\""

# game/end_game2.rpy:1261
translate pt_br end_game2_696efafc:

    # a "\"But I'm the emperor, and you are my guest, and that woman—\""
    a "\"Mas eu sou o imperador e você meu convidado, e essa mulher—\""

# game/end_game2.rpy:1263
translate pt_br end_game2_74e3dfd5:

    # "I step closer, cutting Amicus off even as I lower my voice, surprised at the sudden surge of anger I'm feeling."
    "Eu dou um passo à frente, interrompendo o Amicus mesmo com a voz baixa, surpreso com a repentina onda de raiva que estou sentindo."

# game/end_game2.rpy:1264
translate pt_br end_game2_fa3da4d8:

    # m "\"Amicus, you're acting like a spoiled brat right now, just like Cassius...and stop calling her woman.\""
    m "\"Amicus, você tá agindo como uma criança mimada agora, exatamente como o Cassius... e para de chamar ela assim.\""

# game/end_game2.rpy:1265
translate pt_br end_game2_810b5b47:

    # "Amicus's indignant demeanor seems to deflate a little bit at that."
    "O comportamento indignado do Amicus parece desanimar um pouco com isso."

# game/end_game2.rpy:1267
translate pt_br end_game2_78371e4e:

    # a "\"I—I'm not acting like him at all. And what else should I call her? She is a woman.\""
    a "\"Eu—Eu não estou agindo como ele de forma alguma. E do que mais eu iria chamá-la? Ela é uma mulher.\""

# game/end_game2.rpy:1268
translate pt_br end_game2_9f5bb5fe:

    # m "\"It's the {i}way{/i} you're saying it, and I dunno, maybe ma'am could be a good start?\""
    m "\"É o {i}jeito{/i} que você tá falando, e eu sei lá, talvez madame poderia ser um bom começo?\""

# game/end_game2.rpy:1269
translate pt_br end_game2_d8e9495f:

    # a "\"Well, she's certainly not acting like a madam.\""
    a "\"Bem, ela certamente não está agindo como uma madame.\""

# game/end_game2.rpy:1270
translate pt_br end_game2_4e3fb928:

    # m "\"Is this how you act when you don't get your way?\""
    m "\"É assim que você age quando não consegue o que quer?\""

# game/end_game2.rpy:1271
translate pt_br end_game2_2e930e9c:

    # "Amicus has always had an entitled streak."
    "Amicus sempre foi um pouco acostumado a ter as vontades atendidas."

# game/end_game2.rpy:1272
translate pt_br end_game2_e505db53:

    # "I mean, it's kind of what got me in this situation in the first place, but I thought he'd have changed a bit after everything we'd been through."
    "Quer dizer, é meio o que me levou a essa situação em primeiro lugar, mas pensei que ele teria mudado um pouco depois de tudo o que a gente passou."

# game/end_game2.rpy:1273
translate pt_br end_game2_d0d096f2:

    # "Especially over something as small as this."
    "Especialmente se tratando de algo tão pequeno como isso."

# game/end_game2.rpy:1274
translate pt_br end_game2_ea9fbc5a:

    # "Amicus must see the disappointment in my face, because he deflates further, blowing out a big breath that ruffles back my hair and smells vaguely of lavender."
    "Amicus deve ter visto a decepção em meu rosto, porque ele desanima ainda mais, soltando um grande suspiro que bagunça meu cabelo e cheira vagamente a lavanda."

# game/end_game2.rpy:1276
translate pt_br end_game2_36636428:

    # a "\"No...no, I don't, I promise. It's just that I had something very special planned, and—\""
    a "\"Não... não, não é, eu prometo. É só que eu tinha planejado uma coisa muito especial, e—\""

# game/end_game2.rpy:1277
translate pt_br end_game2_a58d07c7:

    # "Amicus looks back at the door, trying to see through the frosted glass, as if whoever he's looking for will magically appear."
    "Amicus olha de volta para a porta, tentando enxergar através do vidro fosco, como se quem ele estivesse procurando fosse magicamente aparecer."

# game/end_game2.rpy:1278
translate pt_br end_game2_53f73b25:

    # m "\"Amicus, you can't expect anyone to wait five hours for you, whether you're emperor, or not.\""
    m "\"Amicus, você não pode esperar que alguém espere cinco horas por você, imperador ou não.\""

# game/end_game2.rpy:1279
translate pt_br end_game2_a5ed7e8b:

    # "I think."
    "Eu penso."

# game/end_game2.rpy:1280
translate pt_br end_game2_68025071:

    # m "\"Except me, of course.\""
    m "\"Exceto eu, é claro.\""

# game/end_game2.rpy:1282
translate pt_br end_game2_a61ebafe:

    # a "\"Yeah...\""
    a "\"Sim...\""

# game/end_game2.rpy:1283
translate pt_br end_game2_ea79be36:

    # "I see the moment Amicus gives up on his grand plan, whatever it was, as his deflation completes in a slouch, and suddenly he looks very, very tired."
    "Eu vejo o momento que Amicus desiste de seu grande plano, seja lá qual fosse, até que sua desanimação completa com os ombros caindo e de repente, ele parece muito, muito cansado."

# game/end_game2.rpy:1284
translate pt_br end_game2_97e2c3a3:

    # m "\"...You okay?\""
    m "\"Você tá bem?\""

# game/end_game2.rpy:1286
translate pt_br end_game2_ec08fe3e:

    # a "\"Yes, I'm fine. Let's...let's just head back to the palace.\""
    a "\"Sim, estou bem. Vamos... vamos voltar para o palácio.\""

# game/end_game2.rpy:1287
translate pt_br end_game2_23c61366:

    # m "\"Maybe we could go someplace else? I wouldn't mind finding a hole-in-the wall that's open late.\""
    m "\"Talvez a gente possa ir pra outro lugar? Eu não me importaria de passar o resto da noite em um lugar de qualidade duvidosa que fica aberto até tarde.\""

# game/end_game2.rpy:1289
translate pt_br end_game2_764ce9c7:

    # "But Amicus is already walking back up the road toward the forest, shaking his head."
    "Mas Amicus já se encontra voltando pela estrada em direção à floresta, balançando a cabeça."

# game/end_game2.rpy:1290
translate pt_br end_game2_14064fb9:

    # a "\"I would rather we reserve the location ahead of time so that I can ensure your safety. It's too late for that tonight.\""
    a "\"Eu prefiro reservar o local com antecedência para garantir sua segurança. É é tarde demais para isso hoje.\""

# game/end_game2.rpy:1291
translate pt_br end_game2_991c429c:

    # "I follow Amicus at a slight distance, feeling generally disappointed and baffled over what had just happened."
    "Sigo o Amicus a uma pequena distância, no geral me sentindo desapontado e confuso com o que acabou de acontecer."

# game/end_game2.rpy:1292
translate pt_br end_game2_cec40b39:

    # "While I'm still feeling somewhat stunned by Amicus's behavior, I also feel bad because it's clear that he'd really wanted to make tonight special, and to see him so defeated..."
    "Por mais que ainda me sinta um pouco atordoado com o comportamento do Amicus, também me sinto mal, porque é claro que ele realmente queria tornar essa noite especial, e vê-lo assim, tão derrotado..."

# game/end_game2.rpy:1294
translate pt_br end_game2_c6a96811:

    # "I catch up to him and walk alongside the wolf just as we pass under the cover of the many branches, our path lit by the firefly-like insects floating around us."
    "Eu o alcanço e ando ao lado do lobo assim que passamos sob a cobertura dos muitos galhos, nosso caminho iluminado pelos insetos semelhantes a vaga-lumes flutuando ao nosso redor."

# game/end_game2.rpy:1295
translate pt_br end_game2_95bb049b:

    # m "\"Well, we could do something at the palace. Maybe have a picnic?\""
    m "\"Olha, a gente podia fazer alguma coisa no palácio. Talvez um piquenique?\""

# game/end_game2.rpy:1296
translate pt_br end_game2_fa573af8:

    # "Amicus heaves a heavy sigh."
    "Amicus solta um suspiro pesado."

# game/end_game2.rpy:1298
translate pt_br end_game2_48483942:

    # a "\"Honestly, [mc], I'm a bit tired...and it's not even Lover's Day anymore anyway.\""
    a "\"Sinceramente, [mc], eu estou um pouco cansado... e nem é mais dia dos amores, de qualquer forma.\""

# game/end_game2.rpy:1299
translate pt_br end_game2_3e46b371:

    # "The wolf says the last bit so quietly that I barely catch it."
    "O lobo fala a última parte tão baixo que eu mal consigo ouvir."

# game/end_game2.rpy:1300
translate pt_br end_game2_48ff5cf6:

    # "And just like that, my attempts to keep my own mood light give in and I sour instantly."
    "E assim, minhas tentativas de manter meu próprio humor falham e eu fico amargo instantaneamente."

# game/end_game2.rpy:1303
translate pt_br end_game2_b1fe8fa5:

    # m "\"Well...if your goal is to ruin the rest of the night, you're doing a damn good job of it.\""
    m "\"É... se seu objetivo era arruinar o pouco que resta da noite, você tá fazendo um ótimo trabalho.\""

# game/end_game2.rpy:1304
translate pt_br end_game2_e29cdb3e:

    # "Suddenly, we're having one of our old fights again, the way we would feed off of each other's negativity and spiral into a shared mood of sulk."
    "De repente, estamos tendo uma de nossas antigas brigas mais uma vez, da maneira como nos alimentamos da negatividade um do outro e descemos em uma espiral de climão."

# game/end_game2.rpy:1305
translate pt_br end_game2_11ee6ea9:

    # "Usually, I'd be the one to start it, but this time I feel like Amicus is the clear culprit."
    "Normalmente, eu seria a pessoa que começa, mas dessa vez sinto que Amicus é claramente o culpado."

# game/end_game2.rpy:1306
translate pt_br end_game2_e7f31b97:

    # "I stare at the ground, frowning even though I feel Amicus's eyes on me."
    "Eu olho para o chão, franzindo a testa, mesmo sentindo os olhos do Amicus em mim."

# game/end_game2.rpy:1307
translate pt_br end_game2_34b79e1c:

    # "Then it takes me a few moments to realize he's stopped walking."
    "Então, me leva alguns instantes para perceber que ele parou de andar."

# game/end_game2.rpy:1308
translate pt_br end_game2_f990b9d4:

    # "I stop too, then turn around to look back at him."
    "Eu também paro, depois me viro para olhar de volta para ele."

# game/end_game2.rpy:1310
translate pt_br end_game2_07cd6598:

    # "We regard each other for a moment, then Amicus takes a deep breath."
    "Nos olhamos por um momento, então Amicus respira fundo."

# game/end_game2.rpy:1311
translate pt_br end_game2_a0613b69:

    # a "\"I...realize that I am acting like a spoiled pup, and I apologize. I do not want this to ruin the rest of the night, even though there is not much left of it.\""
    a "\"Eu... percebo que estou agindo como um filhote mimado, e peço desculpas. Não quero que isso estrague o resto da noite, mesmo que não tenha sobrado muita coisa.\""

# game/end_game2.rpy:1312
translate pt_br end_game2_acca654e:

    # "I stand there, not saying anything because it looks like Amicus wants to say more."
    "Eu fico lá parado, sem dizer nada porque parece que o Amicus quer falar mais."

# game/end_game2.rpy:1313
translate pt_br end_game2_f00496e7:

    # a "\"I promise you, I do not often act in such a way in front of my subjects.\""
    a "\"Eu prometo, não ajo dessa forma com frequência na frente dos meus súditos.\""

# game/end_game2.rpy:1315
translate pt_br end_game2_010c82f5:

    # a "\"I just so desperately wanted for something to go right after everything that happened...\""
    a "\"Eu só queria desesperadamente que alguma coisa desse certo depois de tudo o que aconteceu...\""

# game/end_game2.rpy:1316
translate pt_br end_game2_aa616c93:

    # m "\"Not often?\""
    m "\"Com frequência?\""

# game/end_game2.rpy:1317
translate pt_br end_game2_aa2b8676:

    # "I raise an eyebrow, but smirk at the same time, wanting to show Amicus that I'm willing to lighten up as well."
    "Eu levanto uma sobrancelha, mas sorrio ao mesmo tempo, querendo mostrar ao Amicus que estou disposto a relevar também."

# game/end_game2.rpy:1319
translate pt_br end_game2_35e382bd:

    # a "\"I mean, never, really. I've never used such words to get my way during all of my emperorship, and it was only because it was for {i}you{/i}.\""
    a "\"Digo, nunca, sério. Eu nunca usei tais palavras para conseguir o que queria durante todo o meu mandato, e foi apenas porque era por {i}você{/i}.\""

# game/end_game2.rpy:1320
translate pt_br end_game2_3f739ce1:

    # "I sigh."
    "Eu suspiro."

# game/end_game2.rpy:1321
translate pt_br end_game2_186c5628:

    # m "\"Well...please don't ever feel the need to act that way on my behalf again. Especially when you're yelling at an old lady and calling her {i}woman{/i}.\""
    m "\"Olha... por favor nunca mais sinta a necessidade de agir dessa forma por minha causa. Especialmente quando você tá gritando com uma senhora de idade e chamando ela de {i}mulher{/i}.\""

# game/end_game2.rpy:1323
translate pt_br end_game2_dd898edc:

    # a "\"I still do not see the problem with that. She {i}is{/i} a woman.\""
    a "\"Eu ainda não entendo seu problema com isso. Ela {i}é{/i} uma mulher.\""

# game/end_game2.rpy:1324
translate pt_br end_game2_5a613a6f:

    # "Amicus starts walking again, and I walk alongside him."
    "Amicus começa a andar de novo, e eu ando ao lado dele."

# game/end_game2.rpy:1325
translate pt_br end_game2_b00236c7:

    # m "\"And like I said, it's the way you were saying it, like it was an insult, somehow.\""
    m "\"Como eu disse, foi o jeito que você falou, como se de algum jeito fosse um insulto.\""

# game/end_game2.rpy:1326
translate pt_br end_game2_e8943bf3:

    # a "\"I did not mean it that way.\""
    a "\"Não foi a minha intenção.\""

# game/end_game2.rpy:1327
translate pt_br end_game2_3f481890:

    # m "\"I mean, I kind of feel like you did. But I get it, you were raised in this society of—\""
    m "\"Olha, eu meio que sinto foi sim. Mas eu entendo, você foi criado nessa sociedade de—\""

# game/end_game2.rpy:1328
translate pt_br end_game2_eb6d22ec:

    # "Amicus huffs out a sigh."
    "Amicus bufa um suspiro."

# game/end_game2.rpy:1329
translate pt_br end_game2_7384a961:

    # a "\"Yes, I know. But I've been doing a lot to progress the rights of women in this society.\""
    a "\"Sim, eu sei. Mas tenho feito bastante para progredir com os direitos das mulheres nessa sociedade.\""

# game/end_game2.rpy:1330
translate pt_br end_game2_321851e1:

    # a "\"Just yesterday I put into motion legislation that will allow females to request a divorce before a court.\""
    a "\"Ontem mesmo eu propus uma lei que permitirá às mulheres solicitarem o divórcio perante um tribunal.\""

# game/end_game2.rpy:1331
translate pt_br end_game2_55cc15e7:

    # m "\"And they couldn't before?\""
    m "\"E elas não podiam antes?\""

# game/end_game2.rpy:1333
translate pt_br end_game2_85cc914b:

    # a "\"Well, no, the husband had to.\""
    a "\"Bem, não, o marido que deveria solicitar.\""

# game/end_game2.rpy:1334
translate pt_br end_game2_93bd3770:

    # m "\"Wow...\""
    m "\"Nossa...\""

# game/end_game2.rpy:1336
translate pt_br end_game2_baa7287f:

    # a "\"Gods, are you humans going to be like the Khemians? Shocked and disgusted by every aspect of our society?\""
    a "\"Deuses, vocês humanos serão como os khemianos? Chocados e enojados com cada aspecto da nossa sociedade?\""

# game/end_game2.rpy:1337
translate pt_br end_game2_8619f2c6_1:

    # "I shrug."
    "Eu dou de ombros."

# game/end_game2.rpy:1338
translate pt_br end_game2_7c79f747:

    # m "\"I mean, some definitely will be.\""
    m "\"Olha, alguns definitivamente vão sim.\""

# game/end_game2.rpy:1339
translate pt_br end_game2_7f83ae76:

    # a "\"Do you not have your own problems?\""
    a "\"Vocês não têm seus próprios problemas?\""

# game/end_game2.rpy:1340
translate pt_br end_game2_e33f02ef:

    # "I laugh."
    "Eu rio."

# game/end_game2.rpy:1341
translate pt_br end_game2_f1e8ef67:

    # m "\"Oh yeah, we do, we {i}definitely{/i} do. I'm sure you'll be beyond shocked by some of the things we've done to ourselves.\""
    m "\"Ah, sim, temos, {i}definitivamente{/i}. Aposto que você vai ficar chocado com algumas das coisas que fizemos a nós mesmos.\""

# game/end_game2.rpy:1342
translate pt_br end_game2_7929dd14:

    # a "\"Like?\""
    a "\"Como o que?\""

# game/end_game2.rpy:1343
translate pt_br end_game2_2c5a22b3:

    # "I close my eyes, shaking my head."
    "Eu fecho meus olhos, balançando minha cabeça."

# game/end_game2.rpy:1344
translate pt_br end_game2_d81c6c67:

    # m "\"I'll let the diplomats reveal that to you, but yeah, most places on Earth still have problems when it comes to equality, a lot of problems.\""
    m "\"Vou deixar que os diplomatas revelem isso pra você, mas sim, a maioria dos lugares na Terra ainda tem problemas quando se trata de igualdade, um monte de problemas.\""

# game/end_game2.rpy:1346
translate pt_br end_game2_9eaa2441:

    # a "\"Then why do you judge me so harshly?\""
    a "\"Então por que você me julga tão severamente?\""

# game/end_game2.rpy:1347
translate pt_br end_game2_dcf666eb:

    # m "\"Because I know you can do better, and I know you have the power to create immediate change.\""
    m "\"Por que eu sei que você pode fazer melhor e sei que tem o poder de provocar mudanças imediatas.\""

# game/end_game2.rpy:1349
translate pt_br end_game2_e1239223:

    # a "\"Technically, but realistically—\""
    a "\"Tecnicamente, mas sendo realista—\""

# game/end_game2.rpy:1350
translate pt_br end_game2_c436e109:

    # m "\"I know, it's a slow process.\""
    m "\"Eu sei, é um processo lento.\""

# game/end_game2.rpy:1351
translate pt_br end_game2_a6721f33:

    # m "\"But you know, where you found me, Italy, it's doing alright with equality, and a lot of Europe is doing great, so I know Adastra can be better.\""
    m "\"Mas sabe, onde você me encontrou, lá na Itália, eles estão indo bem se tratando de igualdade e boa parte da Europa também, então eu sei que Adastra pode ser melhor.\""

# game/end_game2.rpy:1352
translate pt_br end_game2_cb7e8690:

    # "Things go quiet for a moment, that tangent feeling a little strange, like there's more to it than just gender equality."
    "As coisas ficam quietas por um momento, essa tangente soando um pouco estranha, como se englobasse mais do que apenas igualdade de gênero."

# game/end_game2.rpy:1353
translate pt_br end_game2_eda81ff3:

    # "Amicus senses it too, of course:"
    "Amicus sente isso também, é claro:"

# game/end_game2.rpy:1355
translate pt_br end_game2_226c9be0:

    # a "\"While I know that the parents, through whatever space wizardry they possess, brought us together due to perfect compatibility—\""
    a "\"Embora eu saiba que os progenitores, através de qualquer feitiçaria espacial que eles possuam, nos uniram graças à perfeita compatibilidade—\""

# game/end_game2.rpy:1357
translate pt_br end_game2_e8b8ff0f:

    # a "\"—sometimes I wonder about their measurements, because in some instances, we do feel worlds apart.\""
    a "\"—às vezes me pergunto sobre as medidas deles, porque, em alguns casos, de fato nos sentimos em mundos separados.\""

# game/end_game2.rpy:1358
translate pt_br end_game2_0e65f65d:

    # "I look at Amicus, the statement making me feel a little sad."
    "Eu olho para o Amicus, a frase me deixando um pouco triste."

# game/end_game2.rpy:1359
translate pt_br end_game2_9a59bc78:

    # m "\"Well, I guess we really are.\""
    m "\"É, acho que sim.\""

# game/end_game2.rpy:1360
translate pt_br end_game2_bcf07b7b:

    # a "\"But...I love it, I love that about you. You open my eyes, you surprise me, and I've accepted the fact that you come from a better functioning society.\""
    a "\"Mas... eu adoro, eu amo isso em você. Você abre meus olhos, me surpreende, e eu aceitei o fato de que você vem de uma sociedade que funciona melhor.\""

# game/end_game2.rpy:1361
translate pt_br end_game2_1f13d0f9:

    # a "\"I'm willing to learn.\""
    a "\"Estou disposto a aprender.\""

# game/end_game2.rpy:1362
translate pt_br end_game2_39d9857f:

    # "I look down, feeling a little embarrassed."
    "Eu olho para baixo, me sentindo um pouco envergonhado."

# game/end_game2.rpy:1363
translate pt_br end_game2_28b1048c:

    # m "\"Well, humans have a {i}lot{/i} to learn too. We're kind of a disaster, too.\""
    m "\"Olha, os humanos tem {i}muito{/i} o que aprender. A gente é meio que um desastre, também.\""

# game/end_game2.rpy:1364
translate pt_br end_game2_7f62752d:

    # a "\"Then let us learn together.\""
    a "\"Então aprenderemos juntos.\""

# game/end_game2.rpy:1366
translate pt_br end_game2_084220c4:

    # a "\"But back to what I was saying previously: [mc], we're...we're running out of time, and I {i}need{/i} to do something with you. I feel like I missed that tonight.\""
    a "\"Mas, de volta ao que eu estava dizendo anteriormente: [mc], nós estamos... estamos ficando sem tempo, e eu {i}preciso{/i} fazer alguma coisa com você. Sinto que perdi esta noite.\""

# game/end_game2.rpy:1367
translate pt_br end_game2_104e5611:

    # "I feel my chest twinge a bit at that."
    "Sinto meu peito tremer um pouco com isso."

# game/end_game2.rpy:1368
translate pt_br end_game2_80ea9d91:

    # m "\"We still have time.\""
    m "\"A gente ainda tem tempo.\""

# game/end_game2.rpy:1370
translate pt_br end_game2_d93452b8:

    # a "\"I suppose.\""
    a "\"Acho que sim.\""

# game/end_game2.rpy:1371
translate pt_br end_game2_77f498ce:

    # "It's quiet again, and though things aren't fully relaxed again, most of the tension has left the air."
    "Tudo fica quieto de novo, e embora as coisas não tenham ficado totalmente tranquilas, a maior parte da tensão deixou o ar."

# game/end_game2.rpy:1372
translate pt_br end_game2_2dc4ace5:

    # "After a few more minutes of walking, simply enjoying the cool, night air, I clear my throat."
    "Depois de mais alguns minutos de caminhada apenas apreciando o ar fresco da noite, eu pigarreio."

# game/end_game2.rpy:1373
translate pt_br end_game2_6edfbf00:

    # m "\"So, uh, what was that whole restaurant thing about?\""
    m "\"Então, hã... sobre o que era aquela coisa toda lá do restaurante?\""

# game/end_game2.rpy:1375
translate pt_br end_game2_f62564dd:

    # "Amicus chuckles, kicking a rock with a big foot paw, sending it tumbling up the path to clack loudly against the roots of a tree."
    "Amicus dá uma risadinha, chutando uma pedra com uma pata, fazendo-a rolar pelo caminho até bater ruidosamente contra as raízes de uma árvore."

# game/end_game2.rpy:1376
translate pt_br end_game2_87da4fb6:

    # a "\"I had, uh, decided to get a head start on human integration into the {i}Galaxias{/i}, even though the citizens won't know it.\""
    a "\"Eu hã... decidi dar um empurrãozinho na integração humana à {i}congregação galáctica{/i}, mesmo que os cidadãos não saibam disso ainda.\""

# game/end_game2.rpy:1377
translate pt_br end_game2_707d2a10:

    # m "\"How so?\""
    m "\"Como assim?\""

# game/end_game2.rpy:1378
translate pt_br end_game2_18e4babd:

    # a "\"Well, a cultural staple for all species is often times their food.\""
    a "\"Bem, é bem comum a marca registrada da cultura de cada espécie ser sua comida.\""

# game/end_game2.rpy:1379
translate pt_br end_game2_9b78ca0f:

    # m "\"Yeah?\""
    m "\"É mesmo?\""

# game/end_game2.rpy:1380
translate pt_br end_game2_20e5cd12:

    # "I have an idea of where this is going, but I don't know how it's possible."
    "Eu tenho uma ideia de onde ele quer chegar, mas não sei como é possível."

# game/end_game2.rpy:1381
translate pt_br end_game2_27ef6f27:

    # a "\"So, I've established a human cuisine restaurant.\""
    a "\"Então eu fundei um restaurante de culinária humana.\""

# game/end_game2.rpy:1382
translate pt_br end_game2_6c6c25c1:

    # m "\"Oh really?\""
    m "\"Eita, sério?\""

# game/end_game2.rpy:1384
translate pt_br end_game2_bcc81977:

    # a "\"Yes.\""
    a "\"Sim.\""

# game/end_game2.rpy:1385
translate pt_br end_game2_cced5b15:

    # m "\"But, uh, how?\""
    m "\"Mas, hã... como?\""

# game/end_game2.rpy:1386
translate pt_br end_game2_2435df10:

    # a "\"Com analyzed and stored a fragment of the data from your Nexus back on Earth.\""
    a "\"Com analisou e armazenou um fragmento de dados do Nexus de vocês quando fomos na Terra.\""

# game/end_game2.rpy:1387
translate pt_br end_game2_d87dd849:

    # a "\"Though not all ingredients are the same, we substituted as best we could and developed food that is, in my opinion, rather authentic.\""
    a "\"Embora nem todos os ingredientes sejam iguais, nós substituímos da melhor maneira possível e desenvolvemos alimentos que, na minha opinião, são bem autênticos.\""

# game/end_game2.rpy:1388
translate pt_br end_game2_fefe1069:

    # m "\"Huh...you know there's a lot of food from different cultures on Earth, so a lot of different types of food.\""
    m "\"Hã... sabe, existe um monte de comida de culturas diferentes na Terra, então são muitos tipos diferentes.\""

# game/end_game2.rpy:1390
translate pt_br end_game2_93eb0ea7:

    # a "\"Oh, I kept it all in Italy, at least for now. In fact, our first item was {i}Nea-poli-tan pi-zza{/i}.\""
    a "\"Ah, eu me limitei à Itália, pelo menos por enquanto. Na verdade, nosso primeiro item era {i}Pi-zza Nea-poli-tana{/i}.\""

# game/end_game2.rpy:1391
translate pt_br end_game2_317e26bd:

    # "Amicus's suddenly heavily accented voice startles me a bit, as it always does, the wolf chewing around the words like he's actually eating it."
    "O sotaque pesado do Amicus repentinamente me assusta um pouco, o lobo mastigando as palavras como se estivesse realmente comendo elas."

# game/end_game2.rpy:1392
translate pt_br end_game2_8c4e5c77:

    # m "\"Wow.\""
    m "\"Uau.\""

# game/end_game2.rpy:1394
translate pt_br end_game2_e05b3600:

    # a "\"So, as you would expect, I wanted you to try all of the items to let us know how we did.\""
    a "\"Então, como é de se esperar, queria que você provasse todos os itens para nos informar como nos saímos.\""

# game/end_game2.rpy:1395
translate pt_br end_game2_1b161588:

    # "Amicus is talking about all of this like the restaurant was his own project, something he's been working on for a long time."
    "Amicus fala sobre tudo isso como se o restaurante fosse seu próprio projeto, algo em que ele esteve trabalhando há muito tempo."

# game/end_game2.rpy:1397
translate pt_br end_game2_33e91dac:

    # a "\"I thought it would be a fun distraction for you, but as you know, things did not go as planned.\""
    a "\"Achei que seria uma distração divertida para você, mas como vimos, as coisas não saíram como planejado.\""

# game/end_game2.rpy:1398
translate pt_br end_game2_c289b373:

    # "It would have been fun, and I am disappointed that we didn't get to do it together, but the thought alone of what Amicus had planned for me is enough to warm my chest, and I lean against him."
    "Teria sido divertido e eu estou decepcionado que não conseguimos fazer isso juntos, mas só o pensamento de que Amicus planejou tudo isso para mim é suficiente para aquecer meu peito e eu me inclino contra ele."

# game/end_game2.rpy:1399
translate pt_br end_game2_bbc62048:

    # m "\"Well, thank you anyway, and I mean it.\""
    m "\"Enfim, obrigado, de qualquer forma, e eu falo sério.\""

# game/end_game2.rpy:1400
translate pt_br end_game2_bf1d179e:

    # "Amicus huffs and slides his arm around my side, rubbing my shoulder vigorously."
    "Amicus bufa e desliza o braço pela minha lateral, esfregando meu ombro vigorosamente."

# game/end_game2.rpy:1402
translate pt_br end_game2_4c84e59d:

    # a "\"Well, we'll do it some time soon. Can't open it without you giving your approval first.\""
    a "\"Bem, faremos isso em breve. Não posso abrir sem que você dê sua aprovação primeiro.\""

# game/end_game2.rpy:1403
translate pt_br end_game2_29ed04c5:

    # m "\"Oh, I didn't know it would all depend on me.\""
    m "\"Eita, não sabia que tudo iria depender de mim.\""

# game/end_game2.rpy:1405
translate pt_br end_game2_65bd2d52:

    # a "\"Of course! The restaurant is named in your honor, after all.\""
    a "\"É claro! O restaurante é nomeado em sua homenagem, afinal.\""

# game/end_game2.rpy:1406
translate pt_br end_game2_816fbc29:

    # m "\"Oh god, really?\""
    m "\"Caramba, sério?\""

# game/end_game2.rpy:1408
translate pt_br end_game2_daf6e5de:

    # a "\"Really.\""
    a "\"Sério.\""

# game/end_game2.rpy:1409
translate pt_br end_game2_f8bb492a:

    # "I feel myself blushing at the thought of my name on a restaurant."
    "Me sinto corar com o pensamento do meu nome em um restaurante."

# game/end_game2.rpy:1410
translate pt_br end_game2_b12d9d21:

    # "It's embarrassing for some reason, but also incredibly sweet."
    "É embaraçoso por algum motivo, mas também incrivelmente doce e fofo."

# game/end_game2.rpy:1412
translate pt_br end_game2_82331c67:

    # a "\"And I think we should have that picnic. Nothing like a third hour dinner in the moonlight."
    a "\"E acho que deveríamos fazer esse piquenique. Nada como um jantar de terceira hora ao luar."

# game/end_game2.rpy:1413
translate pt_br end_game2_1d745154:

    # m "\"You sure? You look pretty tired.\""
    m "\"Tem certeza? Você parece bem cansado.\""

# game/end_game2.rpy:1414
translate pt_br end_game2_6ebf043a:

    # a "\"I'll live.\""
    a "\"Eu vou sobreviver.\""

# game/end_game2.rpy:1416
translate pt_br end_game2_e28827af:

    # "Amicus lets me go after a moment, and as he does, I slide my hand down against his paw, taking hold of it."
    "Amicus me solta depois de um momento, e quando ele faz isso, deslizo minha mão contra sua pata, a segurando."

# game/end_game2.rpy:1417
translate pt_br end_game2_9ea9469d:

    # "We don't hold hands often, mainly because it's something the wolves just don't really do."
    "Não damos as mãos com frequência, principalmente porque é algo que os lobos realmente não fazem."

# game/end_game2.rpy:1418
translate pt_br end_game2_efe0dfbc:

    # "But nothing about it feels strange or out of place as we walk down the path, hand-in-paw, with only the glow of the moon and the firebugs to guide us."
    "Mas nada parece estranho ou fora do lugar enquanto caminhamos pela estrada, de mãos dadas, apenas com o brilho da lua e os insetos para nos guiar."

# game/end_game2.rpy:1419
translate pt_br end_game2_42fa939b:

    # "There's an eerie edge to it all, and while I might have been a little nervous if I were alone, I don't feel any of that with Amicus."
    "Há um ar misterioso em tudo isso, e embora eu teria ficado um pouco nervoso se estivesse sozinho, não sinto nada disso com o Amicus."

# game/end_game2.rpy:1420
translate pt_br end_game2_01ca3ed7:

    # "It does make me think back though, of what happened in the university."
    "Mas isso me faz pensar no que aconteceu lá na universidade."

# game/end_game2.rpy:1421
translate pt_br end_game2_2e87079d_1:

    # m "\"Amicus?\""
    m "\"Amicus?\""

# game/end_game2.rpy:1423
translate pt_br end_game2_3a0221e6:

    # a "\"Hmm?\""
    a "\"Hmm?\""

# game/end_game2.rpy:1424
translate pt_br end_game2_003a724f:

    # m "\"What do you know about the Other?\""
    m "\"O que você sabe sobre os Outros?\""

# game/end_game2.rpy:1426
translate pt_br end_game2_3c8391b0:

    # a "\"Why do you ask about that?\""
    a "\"Por que pergunta?\""

# game/end_game2.rpy:1427
translate pt_br end_game2_8619f2c6_2:

    # "I shrug."
    "Eu dou de ombros."

# game/end_game2.rpy:1428
translate pt_br end_game2_7e1ce96b:

    # m "\"I dunno. I've had it explained to me a few times, but I still don't really understand it.\""
    m "\"Sei lá. Já me explicaram sobre eles uma vez, mas ainda não entendi realmente do que se trata.\""

# game/end_game2.rpy:1429
translate pt_br end_game2_75aadd1c:

    # a "\"You don't need to worry about it.\""
    a "\"Você não precisa se preocupar com isso.\""

# game/end_game2.rpy:1430
translate pt_br end_game2_60187d91:

    # "I look up at Amicus, glaring."
    "Eu lanço um olhar incrédulo no Amicus."

# game/end_game2.rpy:1431
translate pt_br end_game2_f2e06b22:

    # m "\"Are you seriou—\""
    m "\"Sério mesm—\""

# game/end_game2.rpy:1433
translate pt_br end_game2_b103b352:

    # a "\"I'm not saying that to exclude you—\""
    a "\"Eu não estou dizendo isso para excluir você—\""

# game/end_game2.rpy:1435
translate pt_br end_game2_53633d06:

    # a "\"It is honestly something you do not need to fret over. It's thousands of years away, something you will never see.\""
    a "\"Sinceramente, é algo que você não precisa se preocupar. Está a milhares de anos de distância, algo que você nunca verá.\""

# game/end_game2.rpy:1436
translate pt_br end_game2_527ed176:

    # "I look back down at the ground, frowning."
    "Eu olho de volta para o chão, franzindo a testa."

# game/end_game2.rpy:1438
translate pt_br end_game2_012c0fd7_1:

    # a "\"Are you alright?\""
    a "\"Você está bem?\""

# game/end_game2.rpy:1439
translate pt_br end_game2_642df38a:

    # m "\"I don't know...doesn't it already sort of have a presence around us?\""
    m "\"Eu não sei... já não tem meio que uma presença ao nosso redor?\""

# game/end_game2.rpy:1441
translate pt_br end_game2_602fbe3c:

    # a "\"How much has that jackal been telling you? I swear—\""
    a "\"Quanto aquele chacal ficou enchendo sua cabeça com essas coisas? Eu juro—\""

# game/end_game2.rpy:1442
translate pt_br end_game2_916a36bd:

    # m "\"Hey, he's the only one that's been telling me anything about it. What else do I have to go on?\""
    m "\"Ei, ele é o único que tem conversado comigo sobre isso. A quem mais eu deveria recorrer?\""

# game/end_game2.rpy:1444
translate pt_br end_game2_6b39c7dc:

    # a "\"Listen, [mc], all that is known for certain is that it exists and that it is a threat. The rest are stories and pseudoscience.\""
    a "\"Escute, [mc], tudo o que se sabe com certeza é que eles existem e que são uma ameaça. O resto são histórias e pseudociência.\""

# game/end_game2.rpy:1445
translate pt_br end_game2_b460865a:

    # m "\"Amicus, when I was in the university, I heard voices, telling me what might happen to us...\""
    m "\"Amicus, quando eu tava na universidade, ouvi vozes, me dizendo o que poderia acontecer com a gente...\""

# game/end_game2.rpy:1447
translate pt_br end_game2_3c8805f7_1:

    # a "\"What?\""
    a "\"O que?\""

# game/end_game2.rpy:1448
translate pt_br end_game2_2cb45f02:

    # "I take a deep breath, deciding that I trust Amicus enough to tell him this, no matter how crazy it is."
    "Respiro fundo, decidindo que confio no Amicus o suficiente para contar isso a ele, por mais louco que seja."

# game/end_game2.rpy:1449
translate pt_br end_game2_34f977c8:

    # "When I finish, Amicus is quiet for a moment."
    "Quando termino, Amicus fica quieto por um momento."

# game/end_game2.rpy:1451
translate pt_br end_game2_a67d2c17:

    # m "\"So...am I just crazy?\""
    m "\"Então... eu sou doido ou o que?\""

# game/end_game2.rpy:1452
translate pt_br end_game2_1412d42e:

    # a "\"No, and I don't doubt you at all. Would you be offended if I offer the idea that it could very well have been a dream?\""
    a "\"Não, eu não duvido de você nem um pouco. Ficaria ofendido se eu sugerisse a ideia de que poderia muito bem ter sido apenas um sonho?\""

# game/end_game2.rpy:1453
translate pt_br end_game2_d56e3228:

    # m "\"No, it probably was. It just worried me.\""
    m "\"Não, provavelmente foi. É só que me preocupou.\""

# game/end_game2.rpy:1455
translate pt_br end_game2_d70253ea:

    # a "\"As it should have. It sounds frightening.\""
    a "\"Como deveria. Parece assustador.\""

# game/end_game2.rpy:1456
translate pt_br end_game2_be87cbf2:

    # "Amicus pulls me against his side again."
    "Amicus me puxa contra seu lado novamente."

# game/end_game2.rpy:1457
translate pt_br end_game2_a1c64716:

    # a "\"But I'm very happy you told me, and I hope you'll tell me if you experience anything else. After what we have been through, I think we should be open to all possibilities.\""
    a "\"Mas estou muito feliz que você tenha me contado e espero que me diga se acontecer mais alguma coisa. Depois do que passamos, acho que deveríamos estar abertos a todas as possibilidades.\""

# game/end_game2.rpy:1458
translate pt_br end_game2_bf023949:

    # m "\"Yeah...\""
    m "\"Sim...\""

# game/end_game2.rpy:1459
translate pt_br end_game2_e2da8d3c:

    # "Just being able to talk to Amicus about it has made me feel better, that Amicus is taking this seriously even though it very likely was a dream."
    "Só poder conversar com o Amicus sobre isso já faz eu me sentir melhor, ele está levando isso a sério, mesmo que muito provavelmente tenha sido só um sonho."

# game/end_game2.rpy:1461
translate pt_br end_game2_b5044dd6:

    # a "\"But, in the very, very unlikely event that it was the Other, then the stories would indicate that it doesn't think on its own and simply works with what it has in your mind.\""
    a "\"Mas no caso muito, muito improvável de que tenham sido os Outros, então as histórias indicariam que não pensam por si mesmos e simplesmente trabalham com o que existe na sua cabeça.\""

# game/end_game2.rpy:1463
translate pt_br end_game2_4a1fba19:

    # a "\"It projects your own worries into your reality. But even then, it can't hurt you in such a weak state...and that's assuming that its remnants really do exist in the first place.\""
    a "\"Eles projetam suas próprias preocupações em sua realidade. Mas mesmo assim, não podem machucá-lo a ponto de prejudicar... e isso pressupondo que os vestígios deles realmente existem em primeiro lugar.\""

# game/end_game2.rpy:1464
translate pt_br end_game2_50e6278d:

    # m "\"Hmm, well, I'm glad the palace isn't haunted.\""
    m "\"Hmm, bem, fico feliz que o palácio não seja assombrado.\""

# game/end_game2.rpy:1465
translate pt_br end_game2_62e89a4b:

    # a "\"Heh, well, having lived there all my life, I can guarantee you that is the case. I've never seen anything unexplainable there. This forest on the other hand...\""
    a "\"Hehe, tendo morado lá a vida toda, posso garantir que esse é o caso. Nunca vi nada inexplicável por lá. Essa floresta, por outro lado...\""

# game/end_game2.rpy:1466
translate pt_br end_game2_df8ec4bc_1:

    # m "\"What?\""
    m "\"O que?\""

# game/end_game2.rpy:1467
translate pt_br end_game2_0e0f2ec4:

    # a "\"Well, some say a creature called the {i}Simiarbor{/i} lives within the forests surrounding the city.\""
    a "\"Bem, alguns dizem que uma criatura chamada {i}Simiarbor{/i} vive dentro das florestas que cercam a cidade.\""

# game/end_game2.rpy:1468
translate pt_br end_game2_73453da0:

    # m "\"Oh yeah?\""
    m "\"É mesmo?\""

# game/end_game2.rpy:1470
translate pt_br end_game2_e1e9ed40:

    # "Amicus sees my smile."
    "Amicus vê meu sorriso."

# game/end_game2.rpy:1471
translate pt_br end_game2_b27eeec6:

    # a "\"Oh yes, it's actually thought to be a primate of some sort, and climbs and jumps from tree to tree.\""
    a "\"Ah sim, na verdade, dizem ser um primata de algum tipo, ele escala e pula de árvore em árvore.\""

# game/end_game2.rpy:1472
translate pt_br end_game2_33ffb7ed:

    # a "\"It's completely black, and its face is on the opposite side of its head so that its red, glowing eyes can stare at you while it clings to the branches.\""
    a "\"É completamente preto e seu rosto fica no lado oposto de sua cabeça de forma que seus olhos vermelhos e brilhantes possam encarar você enquanto ele se agarra aos galhos.\""

# game/end_game2.rpy:1473
translate pt_br end_game2_c46aa755:

    # "I can tell Amicus is trying to scare me, and even though I feel a little creeped out, his own presence makes it almost impossible to feel scared."
    "Eu posso dizer que o Amicus está tentando me assustar, e mesmo que eu me sinta um pouco aterrorizado, a própria presença dele torna quase impossível sentir medo."

# game/end_game2.rpy:1474
translate pt_br end_game2_d9dd9b20:

    # m "\"Yeah? And you've seen it?\""
    m "\"É? E você já viu ele?\""

# game/end_game2.rpy:1476
translate pt_br end_game2_c2464ee1:

    # a "\"I've heard strange noises and maybe movement in the trees while out hunting before.\""
    a "\"Eu ouvi barulhos estranhos e talvez movimento nas árvores enquanto estava fora caçando uma vez.\""

# game/end_game2.rpy:1477
translate pt_br end_game2_15c5dfb2:

    # m "\"Yeah, alright.\""
    m "\"É, tá bom.\""

# game/end_game2.rpy:1478
translate pt_br end_game2_f22f1d8b:

    # "Amicus smirks at me as we continue walking, and even though I know he's teasing me, I still feel that prickle of paranoia on the back of my neck."
    "Amicus sorri para mim enquanto continuamos andando, e mesmo que eu saiba que ele está me provocando, ainda sinto aquela pontada de paranoia na parte de trás do meu pescoço."

# game/end_game2.rpy:1480
translate pt_br end_game2_f6d35083:

    # "I distract myself by telling Amicus about our own primate cryptids back on Earth."
    "Me distraio contando para o Amicus sobre nossas próprias lendas de primatas na Terra."

# game/end_game2.rpy:1481
translate pt_br end_game2_972ba884:

    # "Despite the bad start to our Lover's Day, I find myself happy, just being able to have this strange conversation with my wolf."
    "Apesar do começo ruim do nosso dia do amores, me sinto feliz só por poder ter essa conversa estranha com meu lobo."

# game/end_game2.rpy:1485
translate pt_br end_game2_209eb206:

    # "Com sends our food, mostly leftovers from the dinner that we'd missed, out to us in a floating basket as Amicus prepares the sightseer."
    "Com envia nossa comida, a maior parte sendo sobras do jantar que tínhamos perdido, em uma cesta flutuante enquanto Amicus prepara o aero-observador."

# game/end_game2.rpy:1486
translate pt_br end_game2_ce0df67f:

    # "We board and soon enough we're heading out toward the island, the one that I haven't been to since I followed Alex there with Neferu."
    "Nós embarcamos e brevemente estamos indo em direção à ilha, aquela na qual eu não estive desde que segui Alex até lá com o Neferu."

# game/end_game2.rpy:1487
translate pt_br end_game2_76c33344:

    # "Being so late at night, or rather early in the morning, was refreshing compared to the humid mornings and afternoons."
    "Sendo tão tarde da noite, ou muito cedo de madrugada, é refrescante, em comparação com as manhãs e tardes úmidas."

# game/end_game2.rpy:1488
translate pt_br end_game2_70fca207:

    # "Amicus is clearly enjoying it, his elbows on the railing of our craft, leaning back, head tilted up toward the sky, a slight smile on his face."
    "Amicus claramente aproveita o momento, seus cotovelos no parapeito da embarcação, inclinado para trás, cabeça virada na direção do céu, um leve sorriso em seu rosto."

# game/end_game2.rpy:1489
translate pt_br end_game2_34e8d1d5:

    # "His fur whips around gently on his face and torso, and that single fang that always pokes out under his lip glints softly under the light of the celestial bodies above us."
    "Seu pelo sopra suavemente em seu rosto e torso, e aquela única presa que sempre aparece fora dos lábios brilha suavemente sob a luz dos corpos celestiais acima de nós."

# game/end_game2.rpy:1490
translate pt_br end_game2_7e202672:

    # "He looks so peaceful, something he deserves more than anything."
    "Ele parece tão em paz, algo que ele merece mais do que qualquer coisa."

# game/end_game2.rpy:1491
translate pt_br end_game2_f24922b1:

    # "So I savor the moment, trying to capture this image perfectly in my mind, knowing that not so long from now, I'll want to be able to look back on this when I'm out on my own."
    "Então eu saboreio o momento, tentando capturar essa imagem perfeitamente na minha mente, sabendo que não muito tempo a partir de agora, vou querer lembrar disso quando estiver lá fora sozinho."

# game/end_game2.rpy:1492
translate pt_br end_game2_49a262c7:

    # "I bite my lip and blink back the small threat of tears just in time before Amicus's eyes open again."
    "Eu mordo meus lábios e pisco de volta a pequena ameaça de lágrimas bem a tempo dos olhos do Amicus abrirem de novo."

# game/end_game2.rpy:1494
translate pt_br end_game2_cb31ac03:

    # a "\"Despite everything seemingly getting in our way, we WILL have to travel for a few weeks together before you might leave.\""
    a "\"Apesar de tudo aparentemente entrando no nosso caminho, nós TEMOS que viajar juntos por algumas semanas antes de você ir embora.\""

# game/end_game2.rpy:1495
translate pt_br end_game2_78d2b33b:

    # m "\"Oh, for what?\""
    m "\"Ah, pra quê?\""

# game/end_game2.rpy:1496
translate pt_br end_game2_e5c6895a:

    # a "\"For you to tour the moon, and also for us to pick up Cassius from the final city in his destination. It will give you an opportunity to see most of Adastra so that you better understand the moon.\""
    a "\"Para a sua excursão pela lua, e também para pegarmos o Cassius na última cidade de destino dele. Você vai ter a oportunidade de ver a maior parte de Adastra e entender melhor a lua.\""

# game/end_game2.rpy:1497
translate pt_br end_game2_a990038f:

    # "Amicus winks."
    "Amicus dá uma piscadinha."

# game/end_game2.rpy:1499
translate pt_br end_game2_891d24be:

    # a "\"And it has been decreed by the parents, so there's no getting out of it.\""
    a "\"E isso foi decretado pelos progenitores, então, não há como fugir disso.\""

# game/end_game2.rpy:1500
translate pt_br end_game2_40f89502:

    # m "\"Don't I know it.\""
    m "\"E eu não sei.\""

# game/end_game2.rpy:1501
translate pt_br end_game2_34d286aa:

    # "I feel both happiness at the idea of having some guaranteed time with Amicus, while also feeling that pang of resentment at the thought of the parents making it happen."
    "Sinto tanto felicidade com a ideia de ter um tempo garantido com o Amicus quanto aquela pontada de ressentimento com o fato de que os progenitores estão fazendo com que isso aconteça."

# game/end_game2.rpy:1504
translate pt_br end_game2_80b5aec8:

    # "Our craft pushes up onto the beach, and Amicus hops out before reaching out a paw to help me down onto the sand, even though he doesn't have to."
    "Nossa embarcação empurra contra a praia e Amicus salta antes de estender uma pata para me ajudar a descer na areia, mesmo que ele não precise."

# game/end_game2.rpy:1505
translate pt_br end_game2_2a3f8d1c:

    # "I bring the blanket while Amicus carries the basket, and we set things out in roughly the same spot we did all those months ago in my first weeks here."
    "Eu trago o cobertor enquanto Amicus carrega a cesta e nós colocamos as coisas no mesmo local de todos os meses atrás, nas minhas primeiras semanas aqui."

# game/end_game2.rpy:1506
translate pt_br end_game2_8617fae0:

    # "Only months..."
    "Apenas meses..."

# game/end_game2.rpy:1507
translate pt_br end_game2_c26635c9:

    # "It feels like years."
    "Parece que foram anos."

# game/end_game2.rpy:1509
translate pt_br end_game2_476eccad:

    # "As we set out the food, I do kind of wish we had Neapolitan pizza as I see the usual bread, cheese, olives, and poultry, along with various vegetables I've never been able to identify."
    "Enquanto organizamos a comida, eu meio que gostaria que tivéssemos pizza napolitana quando vejo o pão, queijo, azeitonas e ave de sempre, junto com vários vegetais os quais eu nunca consegui identificar."

# game/end_game2.rpy:1510
translate pt_br end_game2_baee54f7:

    # "Still, it's good enough, and I'm just happy to lounge next to Amicus while we eat."
    "Ainda assim, é bom o suficiente e eu fico feliz em relaxar ao lado do Amicus enquanto comemos."

# game/end_game2.rpy:1511
translate pt_br end_game2_2ea7b961:

    # "Again, it's in that comfortable silence that I always enjoy with my wolf."
    "Mais uma vez, é naquele silêncio confortável que sempre curto com meu lobo."

# game/end_game2.rpy:1512
translate pt_br end_game2_8261cb74:

    # "Silence that doesn't have to be filled with anything except the sounds of chewing, which mostly come from Amicus."
    "Silêncio que não precisa ser preenchido com nada, exceto os sons de mastigação, que geralmente vêm do Amicus."

# game/end_game2.rpy:1513
translate pt_br end_game2_21a09370:

    # "After a while though, he breaks the silence with something that almost makes me choke on my {i}virdi{/i}."
    "Mas depois de um tempo, ele quebra o silêncio com algo que quase me faz engasgar no meu {i}virdi{/i}."

# game/end_game2.rpy:1515
translate pt_br end_game2_e657b7aa:

    # a "\"So...how do humans get married? You present a ring, correct?\""
    a "\"Então... como os humanos se casam? Você entrega um anel, certo?\""

# game/end_game2.rpy:1516
translate pt_br end_game2_9f19e41d:

    # "I cough loudly for a second while Amicus stares."
    "Eu tusso alto por um segundo enquanto Amicus me encara."

# game/end_game2.rpy:1518
translate pt_br end_game2_012c0fd7_2:

    # a "\"Are you alright?\""
    a "\"Você está bem?\""

# game/end_game2.rpy:1519
translate pt_br end_game2_23096c79:

    # m "\"What do you mean by that?\""
    m "\"O que você quer dizer com isso?\""

# game/end_game2.rpy:1520
translate pt_br end_game2_35bf4bbb:

    # "I stare at Amicus, then look around, trying to spot something that might tell me what the wolf is up to."
    "Eu encaro o Amicus, depois olho em volta, tentando encontrar algo que possa revelar o que o lobo pretende fazer."

# game/end_game2.rpy:1521
translate pt_br end_game2_78905d47:

    # a "\"I am just curious.\""
    a "\"Eu só estou curioso.\""

# game/end_game2.rpy:1522
translate pt_br end_game2_a0a343ae:

    # m "\"That's what you said when you asked about dating.\""
    m "\"Foi isso que você disse quando perguntou sobre namoro.\""

# game/end_game2.rpy:1524
translate pt_br end_game2_d6acf0dd:

    # a "\"Oh yes...\""
    a "\"Ah, sim...\""

# game/end_game2.rpy:1526
translate pt_br end_game2_9c5ad23a:

    # a "\"Are you suspecting that I might ask for your paw in marriage?\""
    a "\"Você está suspeitando que talvez eu possa pedir sua pata em casamento?\""

# game/end_game2.rpy:1527
translate pt_br end_game2_c1fda584:

    # "Even though Amicus is grinning teasingly, I can tell that he's blushing even under the moonlight."
    "Embora Amicus esteja sorrindo provocativamente, posso dizer que ele está ficando um pouco constrangido."

# game/end_game2.rpy:1528
translate pt_br end_game2_5ec998ca:

    # m "\"You didn't think asking something like that would make me suspicious?\""
    m "\"Você não achou que perguntar algo assim me deixaria desconfiado?\""

# game/end_game2.rpy:1530
translate pt_br end_game2_6f5698ee:

    # a "\"Well, I don't know. It's an interesting topic that has never been brought up. Two males cannot be married anyway, let alone ones from different species.\""
    a "\"Eu não sei. É um assunto interessante que nunca tinha sido citado. Aqui dois homens não podem se casar, de qualquer forma, ainda mais sendo de espécies diferentes.\""

# game/end_game2.rpy:1531
translate pt_br end_game2_c7bbc0d8:

    # "I feel myself calm down a little, not sure how I would have reacted if Amicus had just whipped out a ring then and there."
    "Sinto meu corpo acalmar um pouco, sem saber como eu teria reagido se Amicus simplesmente tivesse mostrado um anel para mim aqui e agora."

# game/end_game2.rpy:1532
translate pt_br end_game2_49920ada:

    # "Amicus is still looking at me, expecting an answer."
    "Ele continua olhando para mim, esperando uma resposta."

# game/end_game2.rpy:1533
translate pt_br end_game2_75a82a59:

    # "I swallow, then think."
    "Eu engulo, então penso."

# game/end_game2.rpy:1534
translate pt_br end_game2_79c386fa:

    # m "\"I guess you just propose to the person you wanna marry, then you go to the courthouse and sign some papers and it's official...I think. I don't know, I've never been married.\""
    m "\"Acho que é basicamente pedir a pessoa em casamento, depois ir ao tribunal e assinar alguns papéis e então é oficial... eu acho. Sei lá, nunca fui casado.\""

# game/end_game2.rpy:1536
translate pt_br end_game2_bf925b1c:

    # a "\"And in some places, males can marry other males, right?\""
    a "\"E em alguns lugares, homens podem se casar com outros homens, certo?\""

# game/end_game2.rpy:1537
translate pt_br end_game2_0cd535bd:

    # "I narrow my eyes."
    "Eu estreito os olhos."

# game/end_game2.rpy:1538
translate pt_br end_game2_db2aa9d8:

    # m "\"How would you know that?\""
    m "\"Como você sabe disso?\""

# game/end_game2.rpy:1539
translate pt_br end_game2_18a18f5f:

    # a "\"Again, I've spent some time with your Nexus. It's only fair I do, considering you've been spending so much of your own time learning about Adastra.\""
    a "\"Eu gastei mais algum tempo com seu Nexus. É apenas justo que eu faça isso, considerando que você tem passado tanto do seu próprio tempo aprendendo sobre Adastra.\""

# game/end_game2.rpy:1540
translate pt_br end_game2_1f0acfbe:

    # "I'm starting to see why Amicus might have been so busy these past months, starting up his own restaurant and learning human culture."
    "Estou começando a entender por que Amicus esteve tão ocupado nesses últimos meses, abrindo seu próprio restaurante e aprendendo sobre cultura humana."

# game/end_game2.rpy:1541
translate pt_br end_game2_0193b426:

    # m "\"Well you're right, there are a lot of places on Earth where you can marry the same sex.\""
    m "\"É, você tá certo, tem um monte de lugares na Terra onde você pode se casar com uma pessoa do mesmo sexo.\""

# game/end_game2.rpy:1542
translate pt_br end_game2_f7870847:

    # "Amicus looks off into the lake."
    "Amicus olha para o lago."

# game/end_game2.rpy:1544
translate pt_br end_game2_d15f5134:

    # a "\"That does sound rather nice...What about Italy?\""
    a "\"Isso parece bem legal... e na Itália?\""

# game/end_game2.rpy:1545
translate pt_br end_game2_7ef092de:

    # "I glance at Amicus, noticing the interest he's been taking in the country he abducted me from."
    "Eu olho para o Amicus, percebendo o interesse que ele vem tendo no país de onde me abduziu."

# game/end_game2.rpy:1546
translate pt_br end_game2_cce3ffd3:

    # "I suppose it's a place for him to look to for inspiration, a vision of what Adastra {i}could{/i} be, which makes sense."
    "Suponho que seja um lugar para ele buscar inspiração, uma visão do que Adastra {i}poderia{/i} ser, o que faz sentido."

# game/end_game2.rpy:1547
translate pt_br end_game2_97813f07:

    # "It's the location of the uplift, of course, but it also has a turbulent history, and politics that have always been raucous and unpredictable."
    "É o local da elevação, é claro, mas também tem uma história turbulenta e políticas que sempre foram ásperas e imprevisíveis."

# game/end_game2.rpy:1548
translate pt_br end_game2_83421d9b:

    # "But considering where the country started, and where it is now, Amicus wouldn't be wrong to find inspiration there."
    "Mas considerando onde o país começou e onde está agora, Amicus não estaria errado em procurar inspiração por lá."

# game/end_game2.rpy:1549
translate pt_br end_game2_e5c292b5:

    # "Again, Amicus is waiting for his answer, and I have to think back to what little I researched about the topic."
    "Mais uma vez, Amicus fica esperando por sua resposta e eu tenho que pensar de volta no pouco que pesquisei sobre o assunto."

# game/end_game2.rpy:1550
translate pt_br end_game2_4e892e3c:

    # m "\"Soooort of, I think civil unions are a thing, which is pretty close to marriage, but not really. I think if you marry someone from an EU country, you can—\""
    m "\"Maaais ou meeenos, acho que uniões civis são uma realidade, o que é bem próximo do casamento, mas não exatamente. Acho que se você se casar com alguém de um país da União Europeia, você pode—\""

# game/end_game2.rpy:1551
translate pt_br end_game2_05117008:

    # "I realize how Amicus might have no idea what I'm talking about, even though he seems to be listening intently."
    "Percebo então como Amicus pode não fazer ideia do que eu estou falando, mesmo que ele pareça estar ouvindo atentamente."

# game/end_game2.rpy:1552
translate pt_br end_game2_08d8a66f:

    # m "\"Anyway, yeah, sort of, civil unions. Mostly marriage, but not really marriage. I think it'll happen there soon, though.\""
    m "\"Enfim, sim, mais ou menos, uniões civis. Tipo um casamento, mas não exatamente. Mas acho que eles vão legalizar em breve.\""

# game/end_game2.rpy:1554
translate pt_br end_game2_192cd3df:

    # a "\"Hmm, sounds complicated.\""
    a "\"Hmm, parece complicado.\""

# game/end_game2.rpy:1555
translate pt_br end_game2_62f54373:

    # m "\"Yeah, it gets really complicated.\""
    m "\"Sim, fica bem complicado.\""

# game/end_game2.rpy:1556
translate pt_br end_game2_7cbc33a7:

    # "Amicus is still looking out at the lake."
    "Amicus ainda continua olhando para o lago."

# game/end_game2.rpy:1558
translate pt_br end_game2_986c1cb7:

    # a "\"You want to swim?\""
    a "\"Você quer nadar?\""

# game/end_game2.rpy:1559
translate pt_br end_game2_2cc7b95a:

    # "I blink."
    "Eu pisco."

# game/end_game2.rpy:1560
translate pt_br end_game2_0efff087:

    # m "\"No, the water will be freezing.\""
    m "\"Não, a água vai estar congelando.\""

# game/end_game2.rpy:1561
translate pt_br end_game2_88fdf521:

    # a "\"So?\""
    a "\"E daí?\""

# game/end_game2.rpy:1562
translate pt_br end_game2_13713d12:

    # m "\"So I don't want to die of hypothermia?\""
    m "\"E daí que eu não quero morrer de hipotermia?\""

# game/end_game2.rpy:1563
translate pt_br end_game2_82aabc2c:

    # "Amicus guffaws."
    "Amicus gargalha."

# game/end_game2.rpy:1564
translate pt_br end_game2_37b639f9:

    # a "\"You really are a pup. It's not {i}that{/i} cold.\""
    a "\"Você realmente é um filhote. Não está {i}tão{/i} frio assim.\""

# game/end_game2.rpy:1565
translate pt_br end_game2_cec1cbb6:

    # "I roll my eyes, feeling a little whiplash from the sudden change in conversation."
    "Eu reviro os olhos, me sentindo um pouco chicoteado pela mudança repentina na conversa."

# game/end_game2.rpy:1567
translate pt_br end_game2_5d1b2f3a:

    # "Then I yelp in surprise as I feel myself get swooped up from the ground, easily held up in Amicus's strong paws."
    "Então eu grito de surpresa quando me sinto sendo levantado do chão, facilmente preso nas patas fortes do Amicus."

# game/end_game2.rpy:1568
translate pt_br end_game2_ef84a8b4:

    # m "\"Hey!\""
    m "\"Ei!\""

# game/end_game2.rpy:1569
translate pt_br end_game2_30b2bb74:

    # a "\"I'll show you.\""
    a "\"Eu vou te mostrar.\""

# game/end_game2.rpy:1570
translate pt_br end_game2_486a0250:

    # m "\"What!?\""
    m "\"O que!?\""

# game/end_game2.rpy:1571
translate pt_br end_game2_ba8d6a2a:

    # "I struggle in the wolf's grasp, very much not in the mood to be dunked in freezing cold water."
    "Eu luto contra o aperto do lobo, realmente sem estar no clima para ser mergulhado na água gelada agora."

# game/end_game2.rpy:1572
translate pt_br end_game2_4225ed6a:

    # "Amicus's strength can't be matched by me though, and the waves get louder as the wolf walks closer to the water's edge."
    "Mas eu não sou páreo para a força do Amicus e as ondas ficam mais barulhentas conforme o lobo se aproxima da beira da água."

# game/end_game2.rpy:1574
translate pt_br end_game2_9ccec687:

    # m "\"Amicus, my robe!\""
    m "\"Amicus, minha túnica!\""

# game/end_game2.rpy:1575
translate pt_br end_game2_a5fab8cf:

    # "Realizing that a dip in the lake is inevitable, I start to try and struggle out of my garments, but at that moment, I'm suddenly set back down on my feet."
    "Percebendo que um mergulho no lago é inevitável, começo a tentar tirar minhas roupas, mas naquele momento, repentinamente sou colocado de pé novamente."

# game/end_game2.rpy:1576
translate pt_br end_game2_e95410ed:

    # "Dazed, I stumble."
    "Atordoado, eu tropeço."

# game/end_game2.rpy:1577
translate pt_br end_game2_d3f9a3b5:

    # "We're right at the water's edge where the waves are crawling up the sand just a few inches from my feet."
    "Nós estamos bem na beira da água, onde as ondas sobem na areia a apenas alguns centímetros dos meus pés."

# game/end_game2.rpy:1578
translate pt_br end_game2_07a8f48a:

    # "The lake stretches out to my right, dark and expansive, the blackness broken by the shimmers of silver light reflecting off the rippling water."
    "O lago se estende à minha direita, escuro e expansivo, a escuridão quebrada pelos brilhos de luz prateada refletindo na água ondulante."

# game/end_game2.rpy:1579
translate pt_br end_game2_4e137279:

    # "It takes me a while to finally focus on Amicus."
    "Me leva um tempo para finalmente focar no Amicus."

# game/end_game2.rpy:1580
translate pt_br end_game2_bf16cc91:

    # "That's because he's kneeling on the beach, reaching up toward me with both paws, and I see what is definitely a ring held between the pads of his fingers."
    "Isso é porque ele está ajoelhado na praia, estendendo as duas patas na minha direção e eu noto o que definitivamente é um anel sendo segurado entre as pontas dos dedos."

# game/end_game2.rpy:1581
translate pt_br end_game2_61f958ee:

    # "I stare."
    "Eu encaro."

# game/end_game2.rpy:1583
translate pt_br end_game2_0e8b0adb:

    # "Amicus clears his throat, his bravado from just a minute ago having quickly faded, replaced by a look he'd once worn when he offered me a bouquet of flowers in the gardens."
    "Amicus pigarreia, sua bravura de apenas um minuto atrás tendo desaparecido rapidamente, substituída pelo olhar que ele usou quando me ofereceu o buquê de flores no jardim."

# game/end_game2.rpy:1586
translate pt_br end_game2_968b7b82:

    # a "\"Will you...be my husband?\""
    a "\"Você quer ser... meu marido?\""

# game/end_game2.rpy:1587
translate pt_br end_game2_d087309d:

    # "I continue to stare."
    "Eu continuo encarando."

# game/end_game2.rpy:1589
translate pt_br end_game2_0a3e6b05:

    # "Amicus stares back, clearly trying to keep a confident look on his face, but after a few more seconds, it fails."
    "Amicus encara de volta, claramente tentando manter um olhar confiante em seu rosto, mas depois de mais alguns segundos, ele vacila."

# game/end_game2.rpy:1591
translate pt_br end_game2_ca41d15d:

    # a "\"I—I know what I'm doing this time. I was sure to research it. I know what this means.\""
    a "\"Eu—Eu sei o que estou fazendo desta vez. Tive certeza de pesquisar o bastante. Sei o que significa.\""

# game/end_game2.rpy:1592
translate pt_br end_game2_5ce0c9bc:

    # "He stubbornly holds up the ring."
    "Ele teimosamente segura o anel."

# game/end_game2.rpy:1593
translate pt_br end_game2_5ade2ac9:

    # "Now I get a good look at it, and I'm not sure if it's just reflecting the sky, but the ring appears to be a dark, dark blue, with tiny speckles of sparkling stones dotting the rim, just like the stars above."
    "Agora eu dou uma boa olhada nele e não tenho certeza se só está refletindo o céu, mas o anel parece ser azul escuro com pequenos pontinhos de pedras brilhantes cobrindo a borda, assim como as estrelas acima."

# game/end_game2.rpy:1594
translate pt_br end_game2_78aff621:

    # "A thin, stripe of silver wraps all the way around the band, straight down the middle."
    "Uma fina tira de prata embrulha todo o conjunto percorrendo o meio."

# game/end_game2.rpy:1595
translate pt_br end_game2_3680c037:

    # m "\"But you said males couldn't marry each other.\""
    m "\"Mas você disse que homens não podem se casar aqui.\""

# game/end_game2.rpy:1596
translate pt_br end_game2_0a76482c:

    # "I mumble that out stupidly, not sure why it's the first thing that comes to mind."
    "Eu murmuro isso estupidamente, sem saber por que é a primeira coisa que me vem à minha mente."

# game/end_game2.rpy:1597
translate pt_br end_game2_480a1737:

    # "Amicus ducks his head slightly."
    "Amicus levemente abaixa a cabeça."

# game/end_game2.rpy:1598
translate pt_br end_game2_c1983afa:

    # a "\"No...but I am emperor, and I know that might sound bad after what happened earlier, but I want this, so I will have it.\""
    a "\"Não... mas eu sou o imperador, e sei que isso talvez soe mal depois do que aconteceu mais cedo, mas eu quero isso, então eu terei.\""

# game/end_game2.rpy:1599
translate pt_br end_game2_41a673f1:

    # "Amicus looks back up at me with a determined expression."
    "Amicus olha de volta para mim com uma expressão determinada."

# game/end_game2.rpy:1601
translate pt_br end_game2_6eb7c0cd:

    # a "\"That is, if you will have it as well.\""
    a "\"Isto é, se você também quiser.\""

# game/end_game2.rpy:1602
translate pt_br end_game2_b29989a1:

    # "I'm frozen, and that determined expression melts away once again as Amicus looks like he's about to panic."
    "Eu permaneço congelado e essa expressão determinada desaparece mais uma vez enquanto Amicus parece que está prestes a entrar em pânico."

# game/end_game2.rpy:1604
translate pt_br end_game2_fa11abf8:

    # a "\"E—eight years, [mc]. That is too long. I—We need something to bind us together, to always remember, to have something when we reunite.\""
    a "\"O—oito anos, [mc]. Isso é muito longo. Eu—Nós precisamos de um vínculo, para sempre lembrar, para ter algo ao qual ansiar quando nos reunirmos.\""

# game/end_game2.rpy:1605
translate pt_br end_game2_88d2c1f3:

    # "A few more moments of silence."
    "Mais alguns momentos de silêncio."

# game/end_game2.rpy:1606
translate pt_br end_game2_198b10c7:

    # "I see Amicus's paws faltering, starting to pull back, and that's what finally gets my stupid brain to force me to move, reaching down to gently touch the ring."
    "Eu vejo as patas do Amicus vacilando, começando a recuar, e é isso que finalmente faz meu cérebro estúpido me forçar a mexer, estendendo a mão para tocar no anel gentilmente."

# game/end_game2.rpy:1607
translate pt_br end_game2_44986a21:

    # m "\"I—I...Yes, of course.\""
    m "\"Eu—Eu... Sim, é claro.\""

# game/end_game2.rpy:1608
translate pt_br end_game2_903fa19d:

    # "Amicus's ears perk up."
    "As orelhas do Amicus se levantam."

# game/end_game2.rpy:1609
translate pt_br end_game2_8ca1d22f:

    # a "\"Yes?\""
    a "\"Sim?\""

# game/end_game2.rpy:1610
translate pt_br end_game2_5fac3114:

    # m "\"I will marry you, of course.\""
    m "\"Eu me caso com você, é claro.\""

# game/end_game2.rpy:1611
translate pt_br end_game2_3bc21e1d:

    # "I laugh through the last words, not even sure what I'm doing right now."
    "Eu rio nas últimas palavras, sem nem ter certeza do que estou fazendo agora."

# game/end_game2.rpy:1613
translate pt_br end_game2_4c188844:

    # a "\"YES!\""
    a "\"ISSO!\""

# game/end_game2.rpy:1614
translate pt_br end_game2_84521b2c:

    # "Amicus hops to his feet, fist in the air, as if he's just won kind of sports competition."
    "Amicus pula com um punho no ar, como se tivesse acabado de ganhar uma competição esportiva."

# game/end_game2.rpy:1616
translate pt_br end_game2_b33634e5:

    # "Before I can say anything else, he's crushing the air from my lungs with the force of the hug he pulls me into, pressing his muzzle against my lips."
    "Antes que eu consiga dizer qualquer outra coisa, ele esmaga o ar dos meus pulmões com a força do abraço que me dá, pressionando o focinho contra meus lábios."

# game/end_game2.rpy:1617
translate pt_br end_game2_95592b15:

    # "Then when he pulls back, he adds another kiss, this one a canine-style lick up the side of my face."
    "Então, quando se afasta, adiciona outro beijo, dessa vez um no estilo canino, lambendo a lateral do meu rosto."

# game/end_game2.rpy:1618
translate pt_br end_game2_b842c2b8:

    # m "\"Ah!\""
    m "\"Ah!\""

# game/end_game2.rpy:1619
translate pt_br end_game2_80cd62ee:

    # "I flinch back, surprised by the gesture."
    "Eu recuo, surpreso com o gesto."

# game/end_game2.rpy:1620
translate pt_br end_game2_c1265acd:

    # "It's a juvenile show of affection, something a pup would do, and something Amicus has never done to me before."
    "É uma demonstração juvenil de afeto, algo que um filhote faria, e algo que o Amicus nunca fez comigo."

# game/end_game2.rpy:1622
translate pt_br end_game2_d4fb7f7d:

    # "He looks happier than I've seen him in months."
    "Ele parece mais feliz do que eu já vi em meses."

# game/end_game2.rpy:1624
translate pt_br end_game2_1bc71ad9:

    # a "\"[mc], I'm going to be the best husband there ever was. I love you.\""
    a "\"[mc], eu vou ser o melhor marido que já existiu. Eu te amo.\""

# game/end_game2.rpy:1625
translate pt_br end_game2_e800380d:

    # "He pulls me against his body again, more gently this time, looking into my eyes."
    "Ele me puxa contra seu corpo outra vez, mais gentilmente agora, olhando nos meus olhos."

# game/end_game2.rpy:1627
translate pt_br end_game2_57015d45:

    # "Though I know that marriages on Adastra are more pragmatic, it seems that Amicus has, for the most part, educated himself on the more emotional, romantic meaning it holds on Earth."
    "Embora eu saiba que os casamentos em Adastra sejam mais pragmáticos, parece que Amicus se educou sobre o significado mais emocional e romântico que casamentos têm na Terra."

# game/end_game2.rpy:1628
translate pt_br end_game2_945f5153:

    # "The wolf takes my hand in his much bigger paw, drawing it up between us so that he can slide the ring on."
    "O lobo pega minha mão com sua pata muito maior, puxando-a entre nós para que possa deslizar o anel para dentro."

# game/end_game2.rpy:1629
translate pt_br end_game2_4564995a:

