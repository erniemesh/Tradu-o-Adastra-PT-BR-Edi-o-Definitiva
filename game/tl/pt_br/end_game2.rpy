    m "\"Boa madrugada.\""

# game/end_game2.rpy:1942
translate pt_br end_game2_cc6cb352:

    # v "\"I must say that I'm a bit surprised to see you outside before Vita has even risen.\""
    v "\"Devo dizer que estou um pouco surpresa de vê-lo aqui fora antes mesmo de Vita nascer.\""

# game/end_game2.rpy:1943
translate pt_br end_game2_8619f2c6_3:

