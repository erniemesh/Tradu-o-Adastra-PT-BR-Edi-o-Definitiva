# TODO: Translation updated at 2021-07-13 23:51

# game/a3s1.rpy:3
translate pt_br a3s1_006d9f9c:

    # "The snuffling in my hair pauses as Amicus absorbs what I'd just said."
    "A fungada no meu cabelo faz uma pausa quando o Amicus absorve o que eu acabei de dizer."

# game/a3s1.rpy:5
translate pt_br a3s1_03aa16a0:

    # a "\"The parents?\""
    a "\"Os progenitores?\""

# game/a3s1.rpy:6
translate pt_br a3s1_c806ebc0:

    # m "\"Yeah.\""
    m "\"Sim.\""

# game/a3s1.rpy:8
translate pt_br a3s1_840e2238:

    # a "\"THE parents?\""
    a "\"OS progenitores?\""

# game/a3s1.rpy:9
translate pt_br a3s1_8ffa16f8:

    # "I sigh, wondering if I'm going to have just as much trouble convincing Amicus of this as I did with everyone else."
    "Eu suspiro, me perguntando se terei problemas em convencer o Amicus assim como eu tive com todo mundo."

# game/a3s1.rpy:10
translate pt_br a3s1_577ac75b:

    # "I still remember the look Neferu gave me when I told him about the drug trip I had."
    "Ainda me lembro de como o Neferu me olhou estranho quando falei que bateu uma onda forte."

# game/a3s1.rpy:11
translate pt_br a3s1_5fc5a999:

    # "Amicus seems to sense my frustration and hugs me a little tighter."
    "Amicus parece sentir a minha frustração e me abraça um pouco mais apertado."

# game/a3s1.rpy:13
translate pt_br a3s1_ee3c6288:

    # a "\"Hey, I'm just surprised, I believe you. I have no reason not to.\""
    a "\"Ei, só estou surpreso, eu acredito em você. Não tenho razão para não acreditar.\""

# game/a3s1.rpy:14
translate pt_br a3s1_3487b25b:

    # "He nuzzles my head again."
    "Ele acaricia minha cabeça de novo."

# game/a3s1.rpy:15
translate pt_br a3s1_fe0b8294:

    # a "\"Did they come to you in a dream, or...\""
    a "\"Eles vieram até você em um sonho, ou...\""

# game/a3s1.rpy:16
translate pt_br a3s1_3b52b862:

    # m "\"Sort of.\""
    m "\"Tipo isso.\""

# game/a3s1.rpy:17
translate pt_br a3s1_eaeb556d:

    # "I tell Amicus what happened in the hallway in front of the meditation room."
    "Eu falo ao Amicus o que aconteceu no corredor em frente à sala de meditação."

# game/a3s1.rpy:19
translate pt_br a3s1_2d370d51:

    # a "\"Wha—\""
    a "\"Mas o q—\""

# game/a3s1.rpy:20
translate pt_br a3s1_23edfe12:

    # "I push through his shocked exclamations and go on to describe the dreams I'd been having as well."
    "Eu atropelo suas interjeições e continuo descrevendo os sonhos que eu venho tendo também."

# game/a3s1.rpy:22
translate pt_br a3s1_7e09cff1:

    # a "\"What? But why wouldn't you tell me this?\""
    a "\"O que? Mas por que você não me contou isso?\""

# game/a3s1.rpy:23
translate pt_br a3s1_ed90ace8:

    # "I shrug against his body."
    "Eu dou de ombros contra seu corpo."

# game/a3s1.rpy:24
translate pt_br a3s1_1f2b771e:

    # m "\"I forgot about them as soon as I woke up. I didn't remember until after what happened with Cassius.\""
    m "\"Eu esqueci deles assim que acordei. Não me lembrava de nada até depois do que aconteceu com o Cassius.\""

# game/a3s1.rpy:25
translate pt_br a3s1_8baee541:

    # a "\"Well—\""
    a "\"Bem—\""

# game/a3s1.rpy:26
translate pt_br a3s1_961c12d8:

    # "I feel Amicus's chest puff up with pride."
    "Eu sinto o peito do Amicus se estufar de orgulho."

# game/a3s1.rpy:28
translate pt_br a3s1_1087acbd:

    # a "\"—sounds like I really am meant to be emperor, eh?\""
    a "\"—parece que eu realmente estou destinado a ser o imperador, não é?\""

# game/a3s1.rpy:29
translate pt_br a3s1_32a35f52:

    # m "\"That's what they said, but you know what else this means?\""
    m "\"Foi o que eles disseram, mas você sabe o que mais isso significa?\""

# game/a3s1.rpy:31
translate pt_br a3s1_e9e3bd96:

    # a "\"Mm?\""
    a "\"Mm?\""

# game/a3s1.rpy:32
translate pt_br a3s1_91e3699d:

    # m "\"The monitors know I'm here. They're okay with it. So I guess it's not really even illegal, right?\""
    m "\"Os monitores sabem que eu tô aqui. Eles ficaram de boa com isso. Então acho que essa situação não é nem ilegal, você não acha?\""

# game/a3s1.rpy:33
translate pt_br a3s1_f85b39eb:

    # "There's a pause."
    "Há uma pausa."

# game/a3s1.rpy:34
translate pt_br a3s1_7345e930:

    # a "\"I mean, it may have been just a dream, but it's nice to hear, nevertheless. Also, stay away from that room.\""
    a "\"Quer dizer, pode ter sido apenas um sonho, mas é ótimo ouvir isso, de qualquer maneira. E também, fique longe daquela sala.\""

# game/a3s1.rpy:35
translate pt_br a3s1_f0494b4f:

    # a "\"While I find it funny that Cassius is using {i}somni{/i} to make contact, I'd rather you not use it.\""
    a "\"Por mais que eu ache engraçado que Cassius esteja usando {i}somni{/i} para fazer contato, eu prefiro que você não use.\""

# game/a3s1.rpy:36
translate pt_br a3s1_944a4845:

    # "Amicus kisses the top of my head as I let out a sigh of exasperation."
    "Amicus beija o topo da minha cabeça enquanto eu solto um suspiro de exasperação."

# game/a3s1.rpy:37
translate pt_br a3s1_30a921cb:

    # m "\"I didn't do it on purpose...and you said you'd believe me!\""
    m "\"Eu não usei de propósito... e você disse que ia acreditar em mim!\""

# game/a3s1.rpy:38
translate pt_br a3s1_5d0a26e6:

    # "Amicus lets out a chuckle that rumbles through his torso and into my back."
    "Amicus solta uma risadinha que vibra através de seu torso para as minhas costas."

# game/a3s1.rpy:39
translate pt_br a3s1_26ca33a3:

    # "It's a comforting feeling and despite my annoyance, I find myself pressing deeper against him."
    "É uma sensação reconfortante e apesar do meu aborrecimento, me pego pressionando mais profundamente contra ele."

# game/a3s1.rpy:41
translate pt_br a3s1_1e5ff128:

    # a "\"I believe that you saw these things, but who can say if it was real, or not? Sometimes I have dreams of entities that I believe are the parents, but I don't necessarily believe it actually is them.\""
    a "\"Eu acredito que você viu essas coisas, mas quem pode dizer se eram reais, ou não? Às vezes eu tenho sonhos com entidades que acredito serem os progenitores, mas não acredito necessariamente que são eles de fato.\""

# game/a3s1.rpy:42
translate pt_br a3s1_155c8c29:

    # "I'm quiet for a moment, letting the silence drag out and I know Amicus well enough at this point that he's got his ears pointed up, waiting for me to respond."
    "Eu fico quieto por um momento, deixando o silêncio se arrastar. Conheço Amicus bem o suficiente a essa altura para saber que suas orelhas estão apontadas para cima, me esperando responder."

# game/a3s1.rpy:43
translate pt_br a3s1_8788cb63:

    # m "\"Trust me. Like seriously, you need to trust me on this Amicus.\""
    m "\"Confia em mim. Tipo, sério mesmo, você precisa confiar em mim nessa, Amicus.\""

# game/a3s1.rpy:45
translate pt_br a3s1_5e161dd0:

    # "Amicus spends his own moment being quiet, resting his cheek against my head, contemplating."
    "Amicus fica um momento em silêncio, descansando a bochecha contra minha cabeça, ponderando."

# game/a3s1.rpy:46
translate pt_br a3s1_21d11a63:

    # m "\"DO you trust me?\""
    m "\"Você CONFIA em mim?\""

# game/a3s1.rpy:47
translate pt_br a3s1_d72e4a9b:

    # "There's only a short pause."
    "Há apenas uma pequena pausa."

# game/a3s1.rpy:49
translate pt_br a3s1_b0849aad:

    # a "\"Alright, yes. I do trust you.\""
    a "\"Certo, sim. Eu confio em você.\""

# game/a3s1.rpy:50
translate pt_br a3s1_82abc784:

    # "There's a sense of conviction in his voice, and I can tell that he really is determined to believe me."
    "Há uma sensação de convicção na voz dele e eu posso dizer que ele realmente está determinado a acreditar em mim."

# game/a3s1.rpy:51
translate pt_br a3s1_b12e64e7:

    # m "\"Thank you. But I only say that because of something else that happened.\""
    m "\"Obrigado. Mas eu só digo isso por causa de outra coisa que aconteceu.\""

# game/a3s1.rpy:52
translate pt_br a3s1_ac78218d:

    # a "\"What was that?\""
    a "\"O que foi?\""

# game/a3s1.rpy:53
translate pt_br a3s1_a5e8d1c4:

    # "I take a deep breath."
    "Eu respiro bem fundo."

# game/a3s1.rpy:54
translate pt_br a3s1_e371ffc3:

    # "Amicus, sensing my anxiety, suddenly turns me in his lap to face him, letting me lay my head against his chest as he pets the side of my face."
    "Amicus, captando minha ansiedade, repentinamente me vira em seu colo para ficar de frente para ele, me deixando repousar minha cabeça contra seu peito enquanto ele acaricia a lateral do meu rosto."

# game/a3s1.rpy:56
translate pt_br a3s1_b53404f6:

    # a "\"Hey, you can tell me anything, [mc]. Like I said, I believe you.\""
    a "\"Ei, você pode me contar qualquer coisa, [mc]. Como disse, eu acredito em você.\""

# game/a3s1.rpy:57
translate pt_br a3s1_0fe353cc:

    # "He says it even more firmly this time, tipping his muzzle down to look at me as I look up at him, meeting eyes."
    "Ele fala com ainda mais firmeza dessa vez, inclinando o focinho na minha direção enquanto eu o encaro, nossos olhares se encontrando."

# game/a3s1.rpy:58
translate pt_br a3s1_f7ba4b10:

    # m "\"Alright, so I was in the archives with Virginia yesterday—\""
    m "\"Certo, então... eu tava nos arquivos com a Virginia ontem—\""

# game/a3s1.rpy:60
translate pt_br a3s1_984a27ed:

    # "Amicus's eyes widen."
    "Os olhos do Amicus se arregalam."

# game/a3s1.rpy:61
translate pt_br a3s1_231b3cd8:

    # a "\"The archives? What were you doing in there?\""
    a "\"Nos arquivos? O que vocês estavam fazendo lá?\""

# game/a3s1.rpy:62
translate pt_br a3s1_ba1885aa:

    # "This reminds me that I also need to tell Amicus about what we've been plotting this past week."
    "Isso me lembra que eu também preciso contar ao Amicus sobre o que nós temos planejado essa última semana."

# game/a3s1.rpy:63
translate pt_br a3s1_7e431881:

    # m "\"I'll tell you in a bit, but something happened when I was...hooked up to the machine."
    m "\"Eu te falo em um minuto, mas, alguma coisa aconteceu quando eu tava... ligado à maquina."

# game/a3s1.rpy:64
translate pt_br a3s1_4f42936a:

    # a "\"You connected with it? Why woul—\""
    a "\"Você se conectou com ela? Por que voc—\""

# game/a3s1.rpy:65
translate pt_br a3s1_694e15fe:

    # m "\"In a bit. Anyway, while I was hooked up, I had another vision from the parents.\""
    m "\"Em um minuto. Enfim, enquanto eu tava conectado, tive outra visão dos progenitores.\""

# game/a3s1.rpy:66
translate pt_br a3s1_a08fc22a:

    # "Amicus thinks."
    "Amicus pensa."

# game/a3s1.rpy:68
translate pt_br a3s1_ed5feb10:

    # a "\"Well...I suppose that would make more sense considering that's the way the emperor speaks with them...but it's only the emperor they speak to.\""
    a "\"Bem... suponho que faria mais sentido considerando que é assim que o imperador fala com eles... mas é apenas o imperador com quem eles falam.\""

# game/a3s1.rpy:69
translate pt_br a3s1_50b16890:

    # m "\"Yeah, well, for whatever reason they started talking to me...actually YOU started talking to me.\""
    m "\"Sim, então, seja lá por que eles começaram a falar comigo... na verdade, VOCÊ começou a falar comigo.\""

# game/a3s1.rpy:71
translate pt_br a3s1_744af5aa:

    # a "\"Me?\""
    a "\"Eu?\""

# game/a3s1.rpy:72
translate pt_br a3s1_890cf66c:

    # m "\"I think so. You were like, yelling, telling me that you didn't want me to leave you.\""
    m "\"Acho que sim. Você tava tipo, gritando, dizendo pra mim que não queria que eu te deixasse sozinho.\""

# game/a3s1.rpy:74
translate pt_br a3s1_96136525:

    # a "\"Oh, well, that does sound like something I would say in such a situation.\""
    a "\"Ah, bem, isso parece com algo que eu diria em tal situação.\""

# game/a3s1.rpy:75
translate pt_br a3s1_7cd1124e:

    # m "\"But you sounded really scared and sad, and I felt like I couldn't breathe; my throat hurt and just felt weird.\""
    m "\"Mas você soou realmente assustado e triste e eu senti como se não pudesse respirar; minha garganta doía e tinha uma sensação estranha.\""

# game/a3s1.rpy:77
translate pt_br a3s1_fea09bf9:

    # a "\"Hmmm...\""
    a "\"Hmmm...\""

# game/a3s1.rpy:78
translate pt_br a3s1_a9fe4775:

    # "Amicus seems to contemplate all of this, but doesn't say anything more."
    "Amicus parece ponderar sobre tudo isso, mas não fala mais nada."

# game/a3s1.rpy:79
translate pt_br a3s1_1a649b9c:

    # "I start to get frustrated, but I realize that I can't really expect him to offer more information that I don't already know."
    "Começo a ficar frustrado, mas percebo que não posso realmente esperar que ele me dê mais informações que eu já não saiba."

# game/a3s1.rpy:80
translate pt_br a3s1_282a97f0:

    # "I guess I had hoped that he would have more insight into why parents do things the way that they do."
    "Acho que esperava que ele tivesse uma compreensão melhor sobre o porquê dos progenitores fazerem as coisas que fazem."

# game/a3s1.rpy:81
translate pt_br a3s1_676525a0:

    # "But really, I'm on my own figuring this all out."
    "Mas eu realmente estou por conta própria no caminho de entender o que tudo isso significa."

# game/a3s1.rpy:82
translate pt_br a3s1_34e90a2d:

    # "I sigh and lean my head against the wolf's chest."
    "Eu suspiro e inclino minha cabeça contra o peito do lobo."

# game/a3s1.rpy:84
translate pt_br a3s1_38957971:

    # a "\"Hey, what's wrong? I'm sure you'll be fine. The parents are very mysterious. My father had several visions he had trouble interpreting.\""
    a "\"Ei, o que tem de errado? Eu tenho certeza de que você vai ficar bem. Os progenitores são muito misteriosos. Meu pai teve muitos problemas para interpretar umas visões dele. \""

# game/a3s1.rpy:85
translate pt_br a3s1_6ac698b4:

    # m "\"I just—I feel like something bad is going to happen, like really bad, and I don't know what it is that I should do to stop it.\""
    m "\"Eu só—Eu sinto como se alguma coisa ruim fosse acontecer e eu não sei o que deveria fazer pra impedir.\""

# game/a3s1.rpy:86
translate pt_br a3s1_12750f9d:

    # a "\"Did they give you any guidance at all?\""
    a "\"Eles não guiaram você de forma alguma?\""

# game/a3s1.rpy:87
translate pt_br a3s1_1fa4cd80:

    # m "\"They just said to give in to their 'benevolent will', or something like that.\""
    m "\"Eles só me disseram pra ceder à \"vontade benevolente\" deles, ou algo assim.\""

# game/a3s1.rpy:89
translate pt_br a3s1_b2c3224f:

    # "Amicus gently pushes me back so that he can look at me directly before he smiles gently."
    "Amicus me empurra suavemente de volta para que possa me olhar direto nos olhos antes de sorrir gentilmente."

# game/a3s1.rpy:90
translate pt_br a3s1_9b011068:

    # a "\"Well, there's your answer. The parents only want what is best for all of us. Just follow their guidance, keep your mind and heart open to them and all will turn out as it should.\""
    a "\"Bem, aí está sua resposta. Os progenitores só querem o que é melhor para todos nós. Simplesmente siga a orientação deles, mantenha sua mente e coração abertos para eles e tudo acontecerá como deveria.\""

# game/a3s1.rpy:91
translate pt_br a3s1_951e3b1d:

    # "Those sentences wouldn't be out of place during a sermon in a church on Earth, and I'm reminded again how these parents really are seen as gods."
    "Essas frases não seriam estranhas durante um sermão de uma igreja na Terra e eu me lembro de novo como esses progenitores realmente são vistos como deuses."

# game/a3s1.rpy:92
translate pt_br a3s1_881d957d:

    # "It's a comforting thought that I could just do as they say and be just fine, made all the more comforting by Amicus's smile and confidence in the matter."
    "É um pensamento reconfortante que eu poderia simplesmente fazer o que eles dizem e ficar bem, tornado ainda mais reconfortante pelo sorriso e confiança do Amicus no assunto."

# game/a3s1.rpy:93
translate pt_br a3s1_203de7b4:

    # "But there's a nagging feeling in the back of my mind, that there's more to the parents than the wolves seem to know."
    "Mas eu fico com uma pulga atrás da orelha com tudo isso, com a sensação de que existe mais sobre os progenitores do que os lobos parecem saber."

# game/a3s1.rpy:94
translate pt_br a3s1_8fea60df:

    # "I lower my voice a bit."
    "Eu abaixo minha voz um pouco."

# game/a3s1.rpy:95
translate pt_br a3s1_af278700:

    # m "\"I just...I just don't know if I trust them.\""
    m "\"Eu só... eu não sei se confio neles.\""

# game/a3s1.rpy:97
translate pt_br a3s1_a750297b:

    # "Amicus laughs, and that actually does annoy me."
    "Amicus gargalha, e isso na verdade me deixa irritado."

# game/a3s1.rpy:98
translate pt_br a3s1_4077938e:

    # m "\"Hey, I'm serious. There's something off about all of this, like the way they're going about things. If they want me to do something then they should just tell me instead of showing me scary visions.\""
    m "\"Ei, eu tô falando sério. Tem algo que não me cheira bem nisso tudo, tipo a forma como eles abordam as coisas. Se eles querem que eu faça alguma coisa então eles deveriam só me contar em vez de ficar me mostrando visões assustadoras.\""

# game/a3s1.rpy:100
translate pt_br a3s1_2535486d:

    # "Amicus forces himself to stop laughing and clears his throat, trying to look serious."
    "Amicus se força a parar de rir e pigarreia, tentando parecer sério."

# game/a3s1.rpy:102
translate pt_br a3s1_5d002496:

    # a "\"I'm sorry, [mc], I just sometimes forget that you are outside the {i}Galaxias{/i} and aren't accustomed to these things. The parents are nothing but benevolence and goodwill.\""
    a "\"Me desculpe, [mc], eu só esqueço às vezes que você não faz parte da {i}congregação galáctica{/i} e não é acostumado com essas coisas. Os progenitores não são nada além de benevolentes e amigáveis.\""

# game/a3s1.rpy:103
translate pt_br a3s1_0a863382:

    # a "\"We all feel their guidance in our lives, even if we're not able to speak to them directly like the emperor. The fact that you are able to do so is an incredible honor. You should happy, not worried.\""
    a "\"Todos nós sentimos a orientação deles em nossas vidas, mesmo que não sejamos capazes de falar com eles diretamente, como o imperador. O fato de você ser capaz de fazer isso é uma honra incrível. Deveria ficar feliz, não preocupado.\""

# game/a3s1.rpy:104
translate pt_br a3s1_48a9d6a0:

    # "Amicus strokes my hair."
    "Amicus acaricia meu cabelo."

# game/a3s1.rpy:105
translate pt_br a3s1_8841b0b1:

    # m "\"Yeah but don't you think me being an outsider gives me a different perspective on all of this? What if they aren't what they say they are?\""
    m "\"Sim, mas você não acha que eu ser uma pessoa de fora me dá uma perspectiva diferente nisso tudo? E se eles não forem quem dizem que são?\""

# game/a3s1.rpy:107
translate pt_br a3s1_08b6f031:

    # a "\"They are, and have no reason not to be.\""
    a "\"Eles são e não têm motivos para não serem.\""

# game/a3s1.rpy:108
translate pt_br a3s1_1f7a9e79:

    # "Amicus's voice becomes more firm, and I can tell that he's starting to become uncomfortable with my questions."
    "A voz do Amicus fica mais firme e consigo captar que ele está começando a ficar desconfortável com as minhas perguntas."

# game/a3s1.rpy:109
translate pt_br a3s1_3373407d:

    # a "\"My advice to you? Listen to them. They will help you...and maybe even figure out a way to get us out of this mess.\""
    a "\"Meu conselho para você? Escute-os. Eles vão ajudá-lo... e talvez até descubram uma forma de nos livrar de toda essa bagunça.\""

# game/a3s1.rpy:111
translate pt_br a3s1_2bb391cc:

    # a "\"Besides, it's a great relief to know that you may be here for a reason. I'm starting to think I was meant to find you.\""
    a "\"Além disso, é um grande alívio saber que você deve estar aqui por uma razão. Estou começando a achar que era meu destino encontrar você.\""

# game/a3s1.rpy:112
translate pt_br a3s1_42834070:

    # "Amicus hugs me again."
    "Amicus me abraça de novo."

# game/a3s1.rpy:113
translate pt_br a3s1_505e511f:

    # "I decide not to press further."
    "Eu decido não forçar mais o assunto."

# game/a3s1.rpy:114
translate pt_br a3s1_e85662c4:

    # "I love and trust Amicus, but he's clearly on board with anything to do with the parents, and I doubt I'd be able to make him question that."
    "Eu amo e confio no Amicus, mas ele está claramente de acordo com qualquer coisa que tenha a ver com os progenitores e duvido que seja capaz de fazer ele questionar isso."

# game/a3s1.rpy:115
translate pt_br a3s1_47bc4efb:

    # "Not that I really want to anyway, I just worry that I'm being lead down a path that I really don't want to go down."
    "Não que eu realmente queira, de qualquer forma, eu só me preocupo de estar sendo conduzido por um caminho que eu realmente não quero seguir."

# game/a3s1.rpy:117
translate pt_br a3s1_335ca6e6:

    # a "\"Oh, [mc].\""
    a "\"Ah, [mc].\""

# game/a3s1.rpy:118
translate pt_br a3s1_040319e3:

    # "Amicus, clearly sensing my continuing anxiety, pulls me forward to kiss me."
    "Amicus, claramente captando a minha ansiedade, me puxa para me dar um beijo."

# game/a3s1.rpy:119
translate pt_br a3s1_6df4255a:

    # "I kiss back, and it feels good even though my stomach continues to churn."
    "Eu beijo de volta, e é uma sensação boa, mesmo com o frio na barriga."

# game/a3s1.rpy:120
translate pt_br a3s1_7a61a916:

    # com "\"Ten minutes remaining, [mc].\""
    com "\"Dez minutos restantes, [mc].\""

# game/a3s1.rpy:122
translate pt_br a3s1_fbccefbd:

    # "Com uses his loud voice to call down to us from the top of the ladder."
    "Com usa sua voz em alto volume para falar do alto da escada."

# game/a3s1.rpy:123
translate pt_br a3s1_af62ac39:

    # "Amicus and I sigh in unified frustration."
    "Eu e o Amicus suspiramos de frustração em uníssono."

# game/a3s1.rpy:125
translate pt_br a3s1_59b27c3f:

    # a "\"Ummm...want to have a little fun before you go?\""
    a "\"Hmmm... quer se divertir um pouco antes de ir?\""

# game/a3s1.rpy:126
translate pt_br a3s1_48ef8e5c:

    # "I look down, and I'm kind of amazed to see that he still has a boner, which makes me wonder how much he'd really been engaged in our conversation."
    "Eu olho para baixo e fico meio espantado ao ver que ele ainda mantém a ereção, o que me faz pensar no quão realmente envolvido ele estava na nossa conversa."

# game/a3s1.rpy:127
translate pt_br a3s1_827e5871:

    # m "\"I have to tell you—\""
    m "\"Eu tenho que contar pra você—\""

# game/a3s1.rpy:128
translate pt_br a3s1_378f8142:

    # "I catch myself and lower my voice."
    "Eu percebo o que vou falar e abaixo minha voz."

# game/a3s1.rpy:129
translate pt_br a3s1_e1f6dca5:

    # m "\"—what we've been doing to get you out.\""
    m "\"—o que nós temos feito pra te soltar.\""

# game/a3s1.rpy:131
translate pt_br a3s1_e0f94c54:

    # a "\"You can do that...and other things at the same time.\""
    a "\"Você pode fazer isso... e outras coisas ao mesmo tempo.\""

# game/a3s1.rpy:132
translate pt_br a3s1_da21de04:

    # "Amicus tries not to look too eager."
    "Amicus tenta não parecer tão ansioso."

# game/a3s1.rpy:133
translate pt_br a3s1_06e3ddd2:

    # "I roll my eyes but press my hand against his chest and draw it slowly down the wolf's front, over the curve of his stomach."
    "Eu reviro os olhos, mas pressiono minha mão contra seu peito e deslizo lentamente descendo pela frente do lobo, sobre a curva de sua barriga."

# game/a3s1.rpy:134
translate pt_br a3s1_94f45fb8:

    # "He immediately moans quietly as I reach the lower part of his abdomen and I see the bulge jump in his underwear as his hips even thrust up a bit too."
    "De imediato, ele geme levemente conforme eu alcanço a parte mais baixa de seu abdômen e observo a protuberância saltar em sua roupa de baixo, até o seu quadril empurra um pouco para cima também."

# game/a3s1.rpy:135
translate pt_br a3s1_47a2d334:

    # "I laugh at his eagerness, and I have to admit that it's kind of nice to have something more light-hearted to do while I discuss all of these troubling issues with my wolf."
    "Eu rio da animação dele e tenho que admitir que é ótimo ter algo mais leve para fazer enquanto discuto todos esses problemas com meu lobo."

# game/a3s1.rpy:139
translate pt_br a3s1_25eecf92:

    # "For the next little while, I walk around the gardens, taking advantage of the mild weather."
    "Por um tempinho, ando pelo jardim, aproveitando o clima ameno."

# game/a3s1.rpy:140
translate pt_br a3s1_7b44d987:

    # "I've noticed it's become cooler and less humid over the past week, which is nice."
    "Notei que vem ficando mais frio e menos úmido na última semana, o que é ótimo."

# game/a3s1.rpy:141
translate pt_br a3s1_5d49f129:

    # "Apparently this is as cold as it gets on this part of Adastra though, and it never snows."
    "Mas aparentemente esse é o máximo de frio que chega nessa parte de Adastra, e nunca neva."

# game/a3s1.rpy:142
translate pt_br a3s1_2f50ad46:

    # "I sigh and sit on a bench, thinking back on my meeting with Amicus just an hour ago."
    "Eu suspiro e sento em um banco, pensando de volta no meu encontro com o Amicus, apenas uma hora atrás."

# game/a3s1.rpy:143
translate pt_br a3s1_61128eac:

    # "It had been easier to say goodbye to the wolf this time, especially now that I know Cassius is willing to let us see each other as much as is possible."
    "Foi mais fácil de me despedir do lobo dessa vez, especialmente agora que eu sei que Cassius vai nos permitir se encontrar na medida do possível."

# game/a3s1.rpy:144
translate pt_br a3s1_6a9a3012:

    # "That being whenever Cato is out, which is good, because he's gone a lot of the time doing his \"official business\", or whatever."
    "Isso sendo sempre que o Cato estiver fora, o que é ótimo porque ele fica fora boa parte do tempo cuidando de seus \"assuntos oficiais\", ou sei lá."

# game/a3s1.rpy:145
translate pt_br a3s1_2f57f6ba:

    # "Amicus, once again, had recommended I distance myself from the plotting so as not to get caught up if we get exposed."
    "Amicus, mais uma vez, recomendou que eu me distanciasse dos planos para que não fosse pego caso nós fôssemos expostos."

# game/a3s1.rpy:146
translate pt_br a3s1_74e7ead2:

    # "I reassure him even though I know I'm going to do whatever it takes to see this through, even if that means I will have to put myself in danger."
    "Eu disse para ele ficar tranquilo mesmo sabendo que vou fazer o que for preciso para resolver isso, mesmo que signifique acabar me colocando em perigo."

# game/a3s1.rpy:147
translate pt_br a3s1_eb70179d:

    # "I don't want Amicus to be down there for another day."
    "Eu não quero que o Amicus fique lá embaixo por sequer mais um dia."

# game/a3s1.rpy:148
translate pt_br a3s1_5437916a:

    # "Just yesterday, Cassius...or Cato, banned all talk of Amicus on Adastra, which Neferu told me only caused the rumors to really start flying."
    "Ontem mesmo, Cassius... ou Cato, baniu todas as conversas sobre o Amicus em Adastra, o que Neferu me disse que só fez causar um aumento nas fofocas."

# game/a3s1.rpy:149
translate pt_br a3s1_6e2ad0b8:

    # "They range from Amicus being imprisoned (true), banished, or even executed."
    "Elas variam entre o Amicus estar preso (verdadeiro), banido, ou até mesmo executado."

# game/a3s1.rpy:150
translate pt_br a3s1_e666b8be:

    # "This is good for us, I'm told, because the public, whether they liked Amicus or not, generally doesn't feel he should be struck from existence just because he lost the emperorship."
    "Ele me disse que isso é bom para nós porque o público, gostando do Amicus ou não, em sua maioria não sente que ele deveria ser arrancado da existência só porque perdeu o cargo de imperador."

# game/a3s1.rpy:151
translate pt_br a3s1_3b0dd29a:

    # "In other words, the people will likely be on our side when we finally reveal everything."
    "Em outras palavras, as pessoas provavelmente vão ficar do nosso lado quando finalmente revelarmos tudo."

# game/a3s1.rpy:152
translate pt_br a3s1_5ec8a2cf:

    # "Hopefully."
    "Tomara."

# game/a3s1.rpy:153
translate pt_br a3s1_b1b82c39:

    # "That's really all we can rely on considering the emperor holds so much power, even if the way it was achieved was illegitimate."
    "Isso é realmente tudo em que nós podemos depositar nossa confiança, considerando que o imperador possui tanto poder, mesmo que a maneira como isso foi alcançado tenha sido ilegítima."

# game/a3s1.rpy:154
translate pt_br a3s1_3ff457f2:

    # "The triumvirates barely check the emperor's power, so unless the people as a whole come together, it would be difficult to remove Cassius from the throne."
    "Os triunviratos mal podem controlar o poder do imperador, então a não ser que o povo como um todo se reunisse, seria difícil tirar o Cassius do trono."

# game/a3s1.rpy:155
translate pt_br a3s1_c94d537e:

    # "If Cassius still refuses to step down, our options will be very limited, and most probably won't turn out well for me, or anyone here that's not part of the family."
    "Se o Cassius se recusar a renunciar, nossas opções ficarão bem limitadas e muito provavelmente a situação não vai ficar boa para o meu lado, ou para qualquer um aqui que não faz parte da família."

# game/a3s1.rpy:156
translate pt_br a3s1_45574f13:

    # "Still, Cassius is proud, very proud."
    "Ainda assim, Cassius é orgulhoso, muito orgulhoso."

# game/a3s1.rpy:157
translate pt_br a3s1_9474d9c6:

    # "Neferu and Virginia think he'll either step down, or at least accept combat to go out with honor."
    "Neferu e Virginia acham que ele vai ou renunciar, ou pelo menos aceitar o combate por honra."

# game/a3s1.rpy:158
translate pt_br a3s1_835d51c8:

    # "Hopefully the first because I really don't know how Amicus would deal with the idea of having to kill his brother."
    "Tomara que seja a primeira opção porque eu não sei realmente como Amicus lidaria com a ideia de ter que matar seu próprio irmão."

# game/a3s1.rpy:159
translate pt_br a3s1_3d5b68a2:

    # "I sigh and lean back on the bench, really getting frustrated with all of this political bullshit."
    "Eu suspiro e me encosto no banco, ficando realmente frustrado com toda essa maracutaia política."

# game/a3s1.rpy:160
translate pt_br a3s1_2f240717:

    # "This had been the exact type of thing Cassius wanted to get rid of, but now it just seems worse than ever."
    "Esse era exatamente o tipo de coisa da qual o Cassius queria se livrar, mas agora parece pior do que nunca."

# game/a3s1.rpy:162
translate pt_br a3s1_ebafde4f:

    # "Just as I'm thinking this, I see Alex."
    "Assim que penso nisso, avisto o Alex."

# game/a3s1.rpy:163
translate pt_br a3s1_a6a8836d:

    # "He's just up the path, standing right in the middle of it..."
    "Ele está parado, bem no meio do caminho..."

# game/a3s1.rpy:165
translate pt_br a3s1_15c3cc0a:

    # "...and he's looking right at me."
    "...e está olhando diretamente para mim."

# game/a3s1.rpy:166
translate pt_br a3s1_a02e75ac:

    # "I give a start, then just stare back at him."
    "Eu aceno, então fico encarando ele de volta."

# game/a3s1.rpy:167
translate pt_br a3s1_ad5682f7:

    # "He doesn't move, just goes on looking at me, and I start to wonder what the hell he's doing."
    "Ele não se move, só continua olhando para mim e eu começo a me perguntar o que diabos ele está fazendo."

# game/a3s1.rpy:168
translate pt_br a3s1_f25c5673:

    # "He doesn't have his usual smile on either, and as a soft breeze blows through the leaves and foliage, I start to feel like I'm in some kind of horror movie."
    "Ele também não está com o habitual sorriso no rosto e conforme uma leve brisa assopra entre as folhas e arbustos, começo a sentir como se estivesse em algum tipo de filme de terror."

# game/a3s1.rpy:169
translate pt_br a3s1_711430e4:

    # "Actually, now that I know who he really is, I do start to feel a little concerned about what he's capable of."
    "Na verdade, agora que eu sei quem ele realmente é, fico um pouco preocupado com o que ele pode ser capaz de fazer."

# game/a3s1.rpy:170
translate pt_br a3s1_c6cebebf:

    # "So I decide to act casual and stand up, raising a hand and walking over to the cat."
    "Então decido agir casualmente e fico de pé, levantando uma mão e andando até o gato."

# game/a3s1.rpy:171
translate pt_br a3s1_64934fe8:

    # m "\"Hey, Alex.\""
    m "\"Oi, Alex.\""

# game/a3s1.rpy:172
translate pt_br a3s1_fc82cd96:

    # al "\"Alexios will do, [mc].\""
    al "\"Alexios está bom, [mc].\""

# game/a3s1.rpy:173
translate pt_br a3s1_6f742d16:

    # m "\"Um, okay. Hi Alexios.\""
    m "\"Hã, ok. Oi, Alexios.\""

# game/a3s1.rpy:174
translate pt_br a3s1_961f3a23:

    # al "\"Ahhotep be with you, [mc].\""
    al "\"Ahhotep esteja com você, [mc].\""

# game/a3s1.rpy:175
translate pt_br a3s1_df8ec4bc:

    # m "\"What?\""
    m "\"O que?\""

# game/a3s1.rpy:176
translate pt_br a3s1_3cc498ea:

    # al "\"I feel things should be more formal between us from now on, that is all.\""
    al "\"Sinto que as coisas deveriam ser mais formais entre nós a partir de agora, só isso.\""

# game/a3s1.rpy:177
translate pt_br a3s1_ef9d105c:

    # m "\"No, I mean why that greeting?\""
    m "\"Não, quer dizer, por que me cumprimentou assim?\""

# game/a3s1.rpy:178
translate pt_br a3s1_fb3a4df7:

    # "I'd heard Neferu use it many times, but no one else."
    "Eu já ouvi o Neferu falando isso várias vezes, mas ninguém mais."

# game/a3s1.rpy:179
translate pt_br a3s1_b7cb27d5:

    # al "\"You are a Khemian, are you not?\""
    al "\"Você é um khemiano, não é?\""

# game/a3s1.rpy:180
translate pt_br a3s1_abde442e:

    # "That gives me pause."
    "Isso me faz pensar."

# game/a3s1.rpy:181
translate pt_br a3s1_3c34ffc2:

    # m "\"Oh, yeah, I guess I am.\""
    m "\"Ah, sim, acho que eu sou.\""

# game/a3s1.rpy:183
translate pt_br a3s1_5b29b57c:

    # "The cat smirks."
    "O gato sorri pretensiosamente."

# game/a3s1.rpy:184
translate pt_br a3s1_d1c141f9:

    # al "\"Odd. You seem to have forgotten your own citizenship.\""
    al "\"Estranho. Você parece ter esquecido de sua própria cidadania.\""

# game/a3s1.rpy:185
translate pt_br a3s1_8619f2c6:

    # "I shrug."
    "Eu dou de ombros."

# game/a3s1.rpy:186
translate pt_br a3s1_06cfe8ed:

    # m "\"Still getting used to it.\""
    m "\"Ainda tô me acostumando.\""

# game/a3s1.rpy:188
translate pt_br a3s1_661ddda5:

    # al "\"I mean, it's something that even some siblings desire, not to mention children...or even the uncontacted.\""
    al "\"Digo, é algo que até alguns membros da irmandade desejam, sem mencionar os infantes... até mesmo os sem contato.\""

# game/a3s1.rpy:189
translate pt_br a3s1_09722dcb:

    # "I raise an eyebrow."
    "Eu levanto uma sobrancelha."

# game/a3s1.rpy:190
translate pt_br a3s1_e7ba2733:

    # m "\"That so?\""
    m "\"É mesmo?\""

# game/a3s1.rpy:191
translate pt_br a3s1_f9042ce0:

    # al "\"Certainly. Who wouldn't want to be part of the most spoiled civilization in the galaxy?\""
    al "\"Certamente. Quem não iria querer fazer parte da civilização mais mimada da galáxia?\""

# game/a3s1.rpy:192
translate pt_br a3s1_484b7fd7:

    # "I sigh, still tired from thinking about all of this political maneuvering."
    "Eu suspiro, ainda cansado de pensar em todas essas manobras políticas."

# game/a3s1.rpy:193
translate pt_br a3s1_57ca372b:

    # "Playing games with Alexios is the last thing I want to do right now."
    "Ficar de joguinho com o Alexios é a última coisa que eu quero fazer nesse momento."

# game/a3s1.rpy:194
translate pt_br a3s1_1a1083b5:

    # m "\"Cut the bullshit, Alex. What do you want?\""
    m "\"Pula esse monte de frescura, Alex. O que você quer?\""

# game/a3s1.rpy:196
translate pt_br a3s1_4e17c6e7:

    # al "\"Excuse me?\""
    al "\"Com licença?\""

# game/a3s1.rpy:197
translate pt_br a3s1_c78583d8:

    # m "\"You're excused.\""
    m "\"À vontade.\""

# game/a3s1.rpy:198
translate pt_br a3s1_e04d1fab:

    # "I walk past the cat, listening to him sputter in surprise."
    "Eu ando passando pelo gato, ouvindo-o resmungar de surpresa."

# game/a3s1.rpy:200
translate pt_br a3s1_3de930f5:

    # al "\"You...you have some nerve to talk to a sibling like that.\""
    al "\"Você... você tem coragem para falar com um membro da irmandade assim.\""

# game/a3s1.rpy:201
translate pt_br a3s1_86947c99:

    # "I frown, glancing back."
    "Eu arqueio as sobrancelhas, olhando de volta."

# game/a3s1.rpy:202
translate pt_br a3s1_05a92a30:

    # m "\"What's that supposed to mean?\""
    m "\"E o que você quer dizer com isso?\""

# game/a3s1.rpy:203
translate pt_br a3s1_c2b304eb:

    # al "\"You're...you're not even a child, yet you throw your weight around here like you're the most important person in the palace.\""
    al "\"Você... você não é nem um infante, ainda assim joga desaforo como se fosse a pessoa mais importante no palácio.\""

# game/a3s1.rpy:204
translate pt_br a3s1_833adc77:

    # "I laugh, loud."
    "Eu começo a gargalhar, alto."

# game/a3s1.rpy:205
translate pt_br a3s1_8c940ed6:

    # "I see the cat's ears pin back."
    "Noto as orelhas do gato caírem de novo."

# game/a3s1.rpy:206
translate pt_br a3s1_ec67eea8:

    # m "\"Are you fucking kidding me? All of you assholes have been throwing ME around with all your plots and fake niceties. I'm just trying to survive.\""
    m "\"Tu tá de sacanagem comigo, caralho? Vocês que são uns escrotos da porra e ME jogam desaforo com todos esses planos ocultos e fazendo a egípcia pra tudo. Eu só tô tentando sobreviver.\""

# game/a3s1.rpy:207
translate pt_br a3s1_a7f742dd:

    # m "\"Also, last I checked, Khemians are all equal, so I don't really give a shit if you're a sibling.\""
    m "\"E também, da última vez que eu chequei, os khemianos são todos iguais, então eu realmente não tô nem aí se você é um membro da irmandade.\""

# game/a3s1.rpy:209
translate pt_br a3s1_45fe45b4:

    # "Alex looks completely taken aback, which is completely satisfying."
    "Alex parece completamente pego de surpresa, o que é totalmente satisfatório."

# game/a3s1.rpy:210
translate pt_br a3s1_33d364e2:

    # m "\"And haven't you always implied that the wolves are fucked up for looking down on their children and treating them like slaves?\""
    m "\"E não era você que sempre dava a entender que os lobos são uns fodidos por rebaixarem os próprios infantes e tratarem eles como escravos?\""

# game/a3s1.rpy:211
translate pt_br a3s1_8cef5105:

    # "Alex coughs to clear his throat."
    "Alex tosse para pigarrear."

# game/a3s1.rpy:213
translate pt_br a3s1_c31822b3:

    # al "\"My apologies, I simply lost my temper for a moment. You were just being a bit rude.\""
    al "\"Mil desculpas, eu simplesmente perdi a paciência por um momento. Você só estava sendo um pouco rude.\""

# game/a3s1.rpy:214
translate pt_br a3s1_fd90d16a:

    # m "\"Or maybe deep down you're just as...speciesist, or whatever, as the wolves, even though you try to pretend you're not...Neferu's the same way.\""
    m "\"Ou talvez lá no fundo você só seja... especista, ou sei lá, assim como os lobos, mesmo que você tente fingir que não é... Neferu é do mesmo jeito.\""

# game/a3s1.rpy:215
translate pt_br a3s1_173cf1eb:

    # "Even I'm surprising myself a little."
    "Até eu estou ficando um pouco surpreso comigo mesmo."

# game/a3s1.rpy:216
translate pt_br a3s1_e5c9da8a:

    # "It's like the lid has finally blown off and I'm just using Alex to vent all of my frustrations with this place."
    "É como se a tampa da garrafa finalmente tivesse explodido e eu só esteja usando o Alex para desabafar todas as minhas frustrações com esse lugar."

# game/a3s1.rpy:218
translate pt_br a3s1_43201a23:

    # al "\"What has gotten into you, [mc]?\""
    al "\"O que deu em você, [mc]?\""

# game/a3s1.rpy:219
translate pt_br a3s1_f98281fd:

    # "There's a long pause, and I finally sigh, rubbing my face."
    "Há uma longa pausa e eu finalmente suspiro, esfregando meu rosto."

# game/a3s1.rpy:220
translate pt_br a3s1_4e1ecaa1:

    # m "\"Sorry, I'm just...I think I'm losing my mind here.\""
    m "\"Desculpa, eu só... acho que eu tô perdendo a cabeça aqui.\""

# game/a3s1.rpy:222
translate pt_br a3s1_52515f5e:

    # "For the first time in a while, I see the cat crack a genuine smile."
    "Pela primeira vez em um bom tempo, vejo o gato esboçar um sorriso genuíno."

# game/a3s1.rpy:223
translate pt_br a3s1_8d19dc53:

    # al "\"I can tell you then that you're not meant to be a diplomat.\""
    al "\"Posso dizer então que você não nasceu para ser um diplomata.\""

# game/a3s1.rpy:224
translate pt_br a3s1_002de6d3:

    # m "\"Definitely not.\""
    m "\"Definitivamente não.\""

# game/a3s1.rpy:225
translate pt_br a3s1_cd801e84:

    # "For a moment, I feel that old, familiar kinship I had with the cat not even a few weeks ago."
    "Por um momento, sinto aquele velho e familiar companheirismo que eu tinha com o gato nem mesmo algumas semanas atrás."

# game/a3s1.rpy:226
translate pt_br a3s1_5ebfe083:

    # "I do believe that in any other situation, in one where we're not all spies, Alex and I could have been really good friends."
    "Eu realmente acredito que em qualquer outra situação, uma que nós não fôssemos espiões, Alex e eu poderíamos ter sido ótimos amigos."

# game/a3s1.rpy:227
translate pt_br a3s1_4e10057f:

    # "I know that can't be the case now though, so I stop smiling and look Alexios right in the eye."
    "Mas eu sei que esse não pode ser o caso agora, então paro de sorrir e encaro Alexios diretamente."

# game/a3s1.rpy:228
translate pt_br a3s1_4fbb9329:

    # m "\"But seriously, what do you want? I can tell you're trying to get something out of me.\""
    m "\"Mas sério, o que você quer? Dá pra ver que você tá tentando tirar alguma coisa de mim.\""

# game/a3s1.rpy:229
translate pt_br a3s1_3e312e4c:

    # "Alex becomes serious too, smile fading."
    "Alex também fica sério, seu sorriso desaparecendo."

# game/a3s1.rpy:231
translate pt_br a3s1_bf55e9f6:

    # "He considers me for a long while, probably realizing that I'm not going to play his little game."
    "Ele me analisa por um longo momento, provavelmente percebendo que eu não vou jogar o joguinho dele."

# game/a3s1.rpy:232
translate pt_br a3s1_2b77e86d:

    # al "\"Alright, [mc], who are you? I know you're not an abandoned child. What is it that you want and what are you doing here?\""
    al "\"Certo, [mc], quem é você? Eu sei que você não é um infante abandonado. O que você quer e o que está fazendo aqui?\""

# game/a3s1.rpy:233
translate pt_br a3s1_3215e217:

    # m "\"So you want to know everything?\""
    m "\"Então, você quer saber de tudo?\""

# game/a3s1.rpy:234
translate pt_br a3s1_8c7583c6:

    # al "\"Yes.\""
    al "\"Sim.\""

# game/a3s1.rpy:235
translate pt_br a3s1_f53aa243:

    # m "\"And why should I tell you?\""
    m "\"E por que eu deveria te contar?\""

# game/a3s1.rpy:236
translate pt_br a3s1_739032d2:

    # "Alex smirks."
    "Alex sorri pretensiosamente."

# game/a3s1.rpy:238
translate pt_br a3s1_7d138169:

    # al "\"Why be blunt if we're going to play the game anyway, [mc]?\""
    al "\"Por que omitir coisas se vamos jogar o jogo de qualquer maneira, [mc]?\""

# game/a3s1.rpy:239
translate pt_br a3s1_00682048:

    # m "\"I'm just curious as to why you're so curious. I hardly matter in all of this.\""
    m "\"Eu só tô curioso com o porquê da sua curiosidade. Dificilmente eu tenho importância nisso tudo.\""

# game/a3s1.rpy:241
translate pt_br a3s1_007b4740:

    # al "\"That is a complete lie. Everything has changed here since you arrived. This is why I want to know.\""
    al "\"Essa é uma completa mentira. Tudo mudou desde que você chegou aqui. É por isso que eu quero saber.\""

# game/a3s1.rpy:242
translate pt_br a3s1_b18d4dfc:

    # m "\"But why does it matter that you know?\""
    m "\"Mas por que importa que você saiba?\""

# game/a3s1.rpy:243
translate pt_br a3s1_459e85cd:

    # al "\"I am an important link between Omorfa and Adastra. It is my job to know what is happening in this empire.\""
    al "\"Eu sou uma ponte importante entre Omorfa e Adastra. É meu trabalho saber o que está acontecendo neste império.\""

# game/a3s1.rpy:244
translate pt_br a3s1_54754d56:

    # m "\"Uh-huh, so who told you I'm uncontacted...Cassius?\""
    m "\"Ãh-ham, então quem te disse que eu sou um sem contato... o Cassius?\""

# game/a3s1.rpy:245
translate pt_br a3s1_9093d1b1:

    # al "\"You've deduced correctly. But I also know that the monitors seem to approve of it...which is rather odd.\""
    al "\"Você deduziu corretamente. Mas eu também sei que os monitores parecem aprovar isso... o que é bastante estranho.\""

# game/a3s1.rpy:246
translate pt_br a3s1_8619f2c6_1:

    # "I shrug."
    "Eu dou de ombros."

# game/a3s1.rpy:247
translate pt_br a3s1_81ecaded:

    # m "\"Again, I don't know what's going on. Anyway, I don't see why I'd tell you anything if I don't know anything about you.\""
    m "\"Eu nem faço ideia do que tá acontecendo, na verdade. E também, não sei por que eu te falaria qualquer coisa se não conheço nada sobre você.\""

# game/a3s1.rpy:249
translate pt_br a3s1_e6feb859:

    # al "\"Why, I'm just a simple pet. I don't know anything that's going on.\""
    al "\"Por que? Eu sou apenas um simples mascote. Não sei de nada sobre o que está acontecendo.\""

# game/a3s1.rpy:250
translate pt_br a3s1_a7a847e1:

    # "His tone of voice tells me that he's mocking me."
    "O tom de voz deixa claro que ele está zombando de mim."

# game/a3s1.rpy:251
translate pt_br a3s1_46646205:

    # "I raise an eyebrow, but don't say anything."
    "Eu levanto uma sobrancelha, mas não digo nada."

# game/a3s1.rpy:252
translate pt_br a3s1_ab09fa2f:

    # "Alex sighs."
    "Alex suspira."

# game/a3s1.rpy:256
translate pt_br a3s1_c912da87:

    # al "\"The simplest way I can explain it is that I'm trying to maintain peace in the {i}Galaxias{/i} as a whole. That mainly involves watching the motives of the wolves.\""
    al "\"A maneira mais simples de explicar isso é que eu estou tentando manter a paz na {i}congregação galáctica{/i} como um todo. Isso envolve principalmente observar as motivações dos lobos.\""

# game/a3s1.rpy:257
translate pt_br a3s1_51e734c7:

    # m "\"Why's that?\""
    m "\"Por que?\""

# game/a3s1.rpy:258
translate pt_br a3s1_075ca7ef:

    # al "\"Because...they can be dangerous.\""
    al "\"Porque... eles podem ser perigosos.\""

# game/a3s1.rpy:259
translate pt_br a3s1_2e4d8030:

    # m "\"Okay. Are none of the other siblings dangerous?\""
    m "\"Tá. Nenhum dos outros membros da irmandade são perigosos?\""

# game/a3s1.rpy:260
translate pt_br a3s1_3fe8b354:

    # al "\"[mc], Adastra is the only civilization in the galaxy to wage war on another sibling in over ten millennia...and they were the perpetrators in the previous war as well.\""
    al "\"[mc], Adastra é a única civilização da galáxia a travar uma guerra com outro membro da irmandade em mais de dez milênios... e eles também foram os autores da guerra anterior.\""

# game/a3s1.rpy:261
translate pt_br a3s1_78d31e3b:

    # al "\"Not only that, but they waged war on an almost parent-level civilization. They're suicidal, and I can't imagine why the Khemians want an alliance with them.\""
    al "\"Não só isso, mas eles travaram uma guerra contra uma civilização quase em nível de progenitor. Eles são suicidas, e eu não consigo imaginar o porquê dos khemianos desejarem uma aliança com eles.\""

# game/a3s1.rpy:262
translate pt_br a3s1_a5ed7e8b:

    # "I think."
    "Eu penso."

# game/a3s1.rpy:263
translate pt_br a3s1_447f3678:

    # m "\"Do you...not want the alliance to happen?\""
    m "\"Você... não quer que a aliança aconteça?\""

# game/a3s1.rpy:264
translate pt_br a3s1_7c624495:

    # "This seems to go against what Alex would want."
    "Isso parece ir contra o que Alex gostaria que acontecesse."

# game/a3s1.rpy:265
translate pt_br a3s1_3ae16758:

    # "I thought he wanted Amicus to take the throne."
    "Eu achei que ele quisesse ver o Amicus no trono."

# game/a3s1.rpy:266
translate pt_br a3s1_3e9519ef:

    # al "\"I want the {i}Galaxias{/i} to remain safe. Is the alliance something YOU want to happen?\""
    al "\"Eu quero que a {i}congregação galáctica{/i} permaneça segura. A aliança é algo que VOCÊ quer que aconteça?\""

# game/a3s1.rpy:267
translate pt_br a3s1_b9dd0920:

    # "I frown, wondering why he's asking me."
    "Eu arqueio as sobrancelhas, me perguntando por que ele me questionou isso."

# game/a3s1.rpy:268
translate pt_br a3s1_87c9f920:

    # m "\"I mean, to me it seems like it would create peace, so yeah.\""
    m "\"Olha, pra mim parece que isso traria paz, então sim.\""

# game/a3s1.rpy:269
translate pt_br a3s1_4d4aebf0:

    # "Alex's eyes narrow, like he figured something out."
    "Os olhos do Alex se estreitam, como se ele tivesse descoberto alguma coisa."

# game/a3s1.rpy:270
translate pt_br a3s1_33f2b476:

    # m "\"What, do you want the wolves to stay isolated?\""
    m "\"Que foi, você quer que os lobos fiquem isolados?\""

# game/a3s1.rpy:271
translate pt_br a3s1_992721a1:

    # al "\"I just want order. The wolves have none of that.\""
    al "\"Eu apenas quero ordem. Os lobos não têm nada disso.\""

# game/a3s1.rpy:272
translate pt_br a3s1_1986a682:

    # "The silence stretches out between us."
    "O silêncio se estende entre nós."

# game/a3s1.rpy:273
translate pt_br a3s1_24977fa2:

    # al "\"I suppose you're still not going to tell me anything about yourself, then?\""
    al "\"Então, suponho que você ainda não vai me contar nada sobre você?\""

# game/a3s1.rpy:274
translate pt_br a3s1_a3d05969:

    # m "\"I didn't say I would, and there really isn't much to tell.\""
    m "\"Eu não disse que ia e realmente não tem muito o que contar.\""

# game/a3s1.rpy:275
translate pt_br a3s1_c63e5989:

    # al "\"How about this; how did you secure Khemian citizenship? That's not something that's just given out to children who are presumed to belong to wolves.\""
    al "\"Que tal isso; como você conseguiu a cidadania khemiana? Isso não é algo que simplesmente é dado a infantes que se presume pertencerem aos lobos.\""

# game/a3s1.rpy:276
translate pt_br a3s1_f8a0d137:

    # "The question takes me by surprise, though this whole Khemian thing does seem to be what's bothering him most, especially after his greeting."
    "A pergunta me pega de surpresa, mas essa coisa dos khemianos não é o que parece mais estar incomodando ele, especialmente depois do cumprimento que ele fez."

# game/a3s1.rpy:277
translate pt_br a3s1_f474fa27:

    # "I think, but the truth doesn't seem harmful here."
    "Eu penso, mas a verdade não parece prejudicial aqui."

# game/a3s1.rpy:278
translate pt_br a3s1_5af9a43e:

    # m "\"Honestly, it was just to protect me from Cassius. He doesn't really like me, if you haven't noticed.\""
    m "\"Pra falar a verdade, isso foi só pra me proteger do Cassius. Ele não gosta muito de mim, caso você não tenha notado.\""

# game/a3s1.rpy:279
translate pt_br a3s1_54d8e5a2:

    # "The expression on Alex's face tells me that he definitely doesn't believe me."
    "A expressão no rosto do Alex me diz que ele definitivamente não acredita em mim."

# game/a3s1.rpy:280
translate pt_br a3s1_09f8a60f:

    # al "\"Cassius wouldn't harm you unless you did something that deserved it.\""
    al "\"Cassius não machucaria você a não ser que fizesse alguma coisa que merecesse isso.\""

# game/a3s1.rpy:281
translate pt_br a3s1_9f9978b0:

    # m "\"He said he wanted to execute me because I back talked him and Amicus slapped his nose.\""
    m "\"Ele disse que ia me executar só porque eu dei um tapinha na mão dele e o Amicus socou o focinho.\""

# game/a3s1.rpy:282
translate pt_br a3s1_f50b2242:

    # "Alex's ears flatten."
    "As orelhas do Alex caem."

# game/a3s1.rpy:284
translate pt_br a3s1_eb77d870:

    # al "\"Cassius...says things. He's very passionate.\""
    al "\"Cassius... diz coisas. Ele é muito impetuoso.\""

# game/a3s1.rpy:285
translate pt_br a3s1_17ff052b:

    # m "\"That's one way to put it.\""
    m "\"É um jeito de descrever.\""

# game/a3s1.rpy:286
translate pt_br a3s1_764358f1:

    # "I shift on my feet, starting to get tired of this conversation."
    "Eu mudo a sustentação do meu pé, começando a ficar cansado dessa conversa."

# game/a3s1.rpy:287
translate pt_br a3s1_cbda873e:

    # m "\"Listen, I have nothing against you, Alex. I'm just trying to get through this as much as you are.\""
    m "\"Escuta, eu não tenho nada contra você, Alex. Eu só tô tentando lidar com tudo isso tanto quanto você.\""

# game/a3s1.rpy:289
translate pt_br a3s1_855cd033:

    # al "\"Neferu gave you the citizenship, right?\""
    al "\"Neferu lhe concedeu a cidadania, certo?\""

# game/a3s1.rpy:290
translate pt_br a3s1_2f83ba8d:

    # m "\"Uhhh...yeah?\""
    m "\"Éééé... sim?\""

# game/a3s1.rpy:291
translate pt_br a3s1_5128d548:

    # al "\"And you're working with him to make the alliance a reality, correct?\""
    al "\"E você está trabalhando com ele para tornar a aliança uma realidade, correto?\""

# game/a3s1.rpy:292
translate pt_br a3s1_e0f26b6c:

    # "That stops me."
    "Isso me para."

# game/a3s1.rpy:293
translate pt_br a3s1_c894e91b:

    # m "\"What? No...no, I'm focused on Amicus right now.\""
    m "\"O que? Não... não, meu foco é no Amicus agora.\""

# game/a3s1.rpy:294
translate pt_br a3s1_b80c1de3:

    # "Alex glares."
    "Alex me olha feio."

# game/a3s1.rpy:295
translate pt_br a3s1_33d3cc03:

    # al "\"Which is still part of the alliance.\""
    al "\"O qual ainda faz parte da aliança.\""

# game/a3s1.rpy:296
translate pt_br a3s1_c9c1d786:

    # m "\"I guess so, but honestly that's not really my top priority right now.\""
    m "\"Acho que sim, mas isso não é realmente minha prioridade agora, pra falar a verdade.\""

# game/a3s1.rpy:297
translate pt_br a3s1_083fd42f:

    # al "\"It is part of your top priority.\""
    al "\"É parte de sua prioridade.\""

# game/a3s1.rpy:298
translate pt_br a3s1_b8936ae0:

    # "I'm getting frustrated and I start to sidle off toward the palace."
    "Estou ficando frustrado e começo a me afastar em direção ao palácio."

# game/a3s1.rpy:299
translate pt_br a3s1_eab6a985:

    # m "\"Yeah, we established that. Listen, I'm gonna lay down. I'm tired.\""
    m "\"É, a gente decidiu isso. Escuta, eu vou me deitar, tô cansado.\""

# game/a3s1.rpy:301
translate pt_br a3s1_c2d4b0f5:

    # "Alex goes on staring and doesn't say anything."
    "Alex fica me encarando e não fala nada."

# game/a3s1.rpy:302
translate pt_br a3s1_f0936355:

    # m "\"Again, I have nothing against you. I hope that we can just...go back to normal in the future once this is over, ya know?\""
    m "\"Mais uma vez, eu não tenho nada contra você. Espero que a gente possa só... voltar ao normal no futuro quando tudo isso acabar, beleza?\""

# game/a3s1.rpy:303
translate pt_br a3s1_3daf9e96:

    # al "\"Indeed.\""
    al "\"Igualmente.\""

# game/a3s1.rpy:305
translate pt_br a3s1_f7b7d9e6:

    # "With that, Alex turns and walks away up the path, leaving me to stare after him."
    "Com isso, Alex se vira e anda para longe seguindo o caminho, restando a mim encará-lo."

# game/a3s1.rpy:309
translate pt_br a3s1_c218dc7f:

    # "I decide to ask Neferu about what happened with Alex."
    "Eu decido ir perguntar ao Neferu sobre o que aconteceu com o Alex."

# game/a3s1.rpy:310
translate pt_br a3s1_813a6044:

    # "I know they had some kind of relationship going on, so maybe he can enlighten me on the cat's motives."
    "Eu sei que eles tinham algum tipo de rolo entre eles, então talvez ele possa me dar uma luz quanto aos motivos do gato."

# game/a3s1.rpy:314
translate pt_br a3s1_be9059f6:

    # "My mouth is already open as I'm walking into the bedroom when I'm hit with a blast of sound."
    "Minha boca já está aberta quando entro no quarto ao passo que sou atingido com uma explosão de som."

# game/a3s1.rpy:317
translate pt_br a3s1_73814cdc:

    # "In front of me is Neferu with his back to me, though I can see that he's in his underwear."
    "Na minha frente, encontro o Neferu de costas para mim e consigo notar que ele está vestindo apenas roupas íntimas."

# game/a3s1.rpy:318
translate pt_br a3s1_2b1df2e9:

    # "He's moving fluidly around, arms and paws waving about and pausing at odd angles while his feet slide across the ground, gliding back and forth."
    "Ele se move de forma flúida, braços e patas balançando no ar e pausando em ângulos estranhos enquanto seus pés deslizam pelo chão para frente e para trás."

# game/a3s1.rpy:319
translate pt_br a3s1_8e6b958a:

    # "At first, I think he's doing some kind of exercise, but then I can hear him singing over the music."
    "Primeiro, penso que ele está fazendo algum tipo de exercício, mas então consigo ouvir ele cantando por cima da música."

# game/a3s1.rpy:320
translate pt_br a3s1_eace5e37:

    # "It's wordless because it doesn't translate through the lingua, just a sort of howling sound, though very different from the wolves."
    "Não há palavras porque não passa pelo interpretus, só uma espécie de uivo, mas é bem diferente do uivo dos lobos."

# game/a3s1.rpy:321
translate pt_br a3s1_95fccd8e:

    # "It's very loud and it's a wonder I couldn't hear it in the hallway."
    "É bem alto e eu me pergunto como que não ouvi lá do corredor."

# game/a3s1.rpy:322
translate pt_br a3s1_e67482aa:

    # "It doesn't necessarily sound bad, but I can tell Neferu isn't putting much effort into making it sound nice."
    "Não soa necessariamente ruim, mas dá para notar que o Neferu não está colocando muito esforço para fazer um canto legal."

# game/a3s1.rpy:323
translate pt_br a3s1_ff9ff9dd:

    # "Still, I feel like I'm walking in on something private, so I consider backing out."
    "Ainda assim, sinto que estou atrapalhando algo pessoal, então considero voltar."

# game/a3s1.rpy:324
translate pt_br a3s1_30a8a1f5:

    # "Of course, that's when he spins around and immediately spots me standing there in front of the door, my mouth still open."
    "Mas é claro, esse é o momento em que ele vira e se depara comigo parado em frente à porta, minha boca ainda aberta."

# game/a3s1.rpy:326
translate pt_br a3s1_2bfd765d:

    # "Quickly, I fix my face into a pleasant smile, trying to act casual so I don't embarrass him."
    "Rapidamente, corrijo minha expressão em um sorriso agradável, tentando agir casualmente de forma que não o deixe constrangido."

# game/a3s1.rpy:327
translate pt_br a3s1_dbfce420:

    # m "\"Oh hey, Neferu, I was—\""
    m "\"Ah, oi, Neferu, eu tava—\""

# game/a3s1.rpy:329
translate pt_br a3s1_3d0f3247:

    # "I pause as I see Neferu grinning back at me."
    "Eu pauso enquanto vejo Neferu sorrindo de volta para mim."

# game/a3s1.rpy:330
translate pt_br a3s1_65e23529:

    # m "\"Um, I was just, uh...you okay?\""
    m "\"Hm, eu tava só, hã... você tá bem?\""

# game/a3s1.rpy:331
translate pt_br a3s1_c0e2bcbd:

    # "I have to almost shout over the music."
    "Eu quase tenho que gritar por cima da música."

# game/a3s1.rpy:332
translate pt_br a3s1_a5145240:

    # "The Jackal is swaying back and forth a little bit, almost like he's still dancing."
    "O chacal continua balançando para frente e para trás um pouco, quase como se ainda estivesse dançando."

# game/a3s1.rpy:333
translate pt_br a3s1_ed6163f6:

    # n "\"Oh, [mc], what an incredibly pleasant and joyous surprise.\""
    n "\"Ah, [mc], que surpresa incrivelmente agradável e alegre.\""

# game/a3s1.rpy:334
translate pt_br a3s1_0c96a866:

    # m "\"Uhhh...Thanks?\""
    m "\"Éééé... Valeu?\""

# game/a3s1.rpy:336
translate pt_br a3s1_eaab285e:

    # "The jackal begins to dance again, facing me this time, though he doesn't sing, thankfully."
    "O chacal começa a dançar novamente, olhando para mim dessa vez, mas ele não canta, ainda bem."

# game/a3s1.rpy:337
translate pt_br a3s1_994f6c7b:

    # m "\"Are you okay?\""
    m "\"Você tá bem?\""

# game/a3s1.rpy:338
translate pt_br a3s1_4a7e005e:

    # n "\"Better than I've ever been, my Simian friend! What do you think of the music?\""
    n "\"Melhor do que jamais estive, amigo símio! O que você acha da música?\""

# game/a3s1.rpy:339
translate pt_br a3s1_e2af9fd0:

    # "Neferu nods at the ceiling."
    "Neferu acena para o teto."

# game/a3s1.rpy:340
translate pt_br a3s1_5dd11dee:

    # m "\"It's...It's nice...kinda loud.\""
    m "\"É... é legalzinha... meio alta pra falar a verdade.\""

# game/a3s1.rpy:341
translate pt_br a3s1_db0bd149:

    # n "\"I'm sorry, I need to hear sounds from home every now and then. The wolves have no...{i}spice{/i} in their music.\""
    n "\"Me desculpe, eu preciso ouvir música da minha terra natal volta e meia. Os lobos não têm... {i}tempero{/i} na música deles.\""

# game/a3s1.rpy:342
translate pt_br a3s1_244f4b12:

    # "The jackal slides his paws sensually over his torso, smoothing the fur down to better accentuate his pecs and abs, his eyes glued to mine."
    "O chacal desliza suas patas sensualmente sobre o torso, suavizando o pelo para melhor acentuar seu peitoral e abdômen, os olhos colados nos meus."

# game/a3s1.rpy:343
translate pt_br a3s1_28a8869d:

    # "I look around and note the three bottles of wine on the bedside table."
    "Eu olho em volta e noto as três garrafas de vinho na mesa de cabeceira."

# game/a3s1.rpy:344
translate pt_br a3s1_f5dda719:

    # m "\"Oh...you're drunk.\""
    m "\"Ah... você tá bêbado.\""

# game/a3s1.rpy:346
translate pt_br a3s1_0e901af3:

    # n "\"I'm drunk.\""
    n "\"Eu estou bêbado.\""

# game/a3s1.rpy:347
translate pt_br a3s1_43679fa6:

    # "Neferu spins in a circle and actually almost loses his balance, something I've never seen him do."
    "Neferu gira um círculo e, na verdade, quase perde o equilíbrio, algo que eu nunca vi ele fazendo."

# game/a3s1.rpy:348
translate pt_br a3s1_05d472eb:

    # "I've seen him buzzed before, but he's always managed to keep his composure."
    "Eu já vi ele embriagado antes, mas ele sempre conseguiu manter sua compostura."

# game/a3s1.rpy:349
translate pt_br a3s1_0deb666a:

    # "But now..."
    "Mas agora..."

# game/a3s1.rpy:350
translate pt_br a3s1_d022db94:

    # m "\"How drunk?\""
    m "\"Quão bêbado?\""

# game/a3s1.rpy:352
translate pt_br a3s1_36c6ca77:

    # n "\"Too drunk, but—\""
    n "\"Muito bêbado, mas—\""

# game/a3s1.rpy:353
translate pt_br a3s1_21cec5d6:

    # "Neferu steadies himself against a pillar, leaning and rubbing his head against it."
    "Neferu se apoia em um pilar, inclinando-se e esfregando a cabeça contra ele."

# game/a3s1.rpy:355
translate pt_br a3s1_c243004e:

    # n "\"—at the same time, not drunk enough.\""
    n "\"—ao mesmo tempo, não bêbado o suficiente.\""

# game/a3s1.rpy:356
translate pt_br a3s1_3dbdf34c:

    # "I quickly make sure the door is closed behind me before moving closer to the jackal."
    "Rapidamente eu me certifico de deixar a porta atrás de mim fechada antes de me aproximar do chacal."

# game/a3s1.rpy:357
translate pt_br a3s1_fe78655b:

    # m "\"Do you need help?\""
    m "\"Você precisa de ajuda?\""

# game/a3s1.rpy:358
translate pt_br a3s1_e2e5c744:

    # n "\"What!?\""
    n "\"O que!?\""

# game/a3s1.rpy:359
translate pt_br a3s1_b3af2145:

    # "I raise my voice above the music."
    "Eu aumento minha voz por cima da música."

# game/a3s1.rpy:360
translate pt_br a3s1_0f20c0a5:

    # m "\"Do you—\""
    m "\"Você—\""

# game/a3s1.rpy:361
translate pt_br a3s1_7859df96:

    # "Neferu waves his paw at me."
    "Neferu balança a pata para mim."

# game/a3s1.rpy:362
translate pt_br a3s1_e85575cf:

    # n "\"Wait, Com, pause music.\""
    n "\"Espere, Com, pausar música.\""

# game/a3s1.rpy:364
translate pt_br a3s1_0aa31415:

    # com "\"Pausing 'Dancing Amongst the Dunes' by Heqet.\""
    com "\"Pausando \"Dançando Entre as Dunas\" por Heqet.\""

# game/a3s1.rpy:366
translate pt_br a3s1_d9e2f4b0:

    # n "\"I need another drink.\""
    n "\"Eu preciso de outra bebida.\""

# game/a3s1.rpy:367
translate pt_br a3s1_3d7f8685:

    # "Neferu reaches out toward the table even though it's a good ten feet away, and I look over to see that one of them is half full."
    "Neferu estende a mão em direção à mesa, mesmo que ela esteja a uns bons três metros de distância, e eu vejo que uma das garrafas está meio cheia."

# game/a3s1.rpy:368
translate pt_br a3s1_2d57c37d:

    # "There's a pause, then Neferu opens his eyes, frowning at me."
    "Há uma pausa, então Neferu abre seus olhos, franzindo a testa para mim."

# game/a3s1.rpy:370
translate pt_br a3s1_4fed1908:

    # n "\"I said I need a drink, [mc].\""
    n "\"Eu disse que preciso de uma bebida, [mc].\""

# game/a3s1.rpy:371
translate pt_br a3s1_cfc78543:

    # m "\"And what do you think I'm gonna do about that?\""
    m "\"E o que você acha que eu vou fazer sobre isso?\""

# game/a3s1.rpy:372
translate pt_br a3s1_40a556dd:

    # n "\"You're a slave. You know what to do.\""
    n "\"Você é um escravo. Sabe o que fazer.\""

# game/a3s1.rpy:373
translate pt_br a3s1_61f958ee:

    # "I stare."
    "Eu encaro."

# game/a3s1.rpy:374
translate pt_br a3s1_61d5f247:

    # m "\"Excuse me?\""
    m "\"Como é?\""

# game/a3s1.rpy:376
translate pt_br a3s1_e11c5139:

    # n "\"You. Are. A. Slave.\""
    n "\"Você. É. Um. Escravo.\""

# game/a3s1.rpy:377
translate pt_br a3s1_1bd9f5ec:

    # "Neferu pokes a finger in my direction with every word."
    "Neferu aponta um dedo na minha direção a cada palavra."

# game/a3s1.rpy:378
translate pt_br a3s1_954afc44:

    # n "\"Don't let the wolves tell you any different. As long as you are here, they are your master.\""
    n "\"Não deixe que nenhum lobo te faça acreditar no contrário. Enquanto você estiver aqui, eles mandam em você.\""

# game/a3s1.rpy:379
translate pt_br a3s1_6ff386a3:

    # m "\"But {i}you{/i} were treating me like a slave just now.\""
    m "\"Mas {i}você{/i} tava me tratando como um escravo agora mesmo.\""

# game/a3s1.rpy:380
translate pt_br a3s1_ccfb0b22:

    # n "\"I was making—\""
    n "\"Eu estava—\""

# game/a3s1.rpy:381
translate pt_br a3s1_eab5b6ef:

    # "Neferu pauses as he makes a strange swallowing/hiccuping sound."
    "Neferu pausa enquanto faz um barulho estranho de engolir/soluço."

# game/a3s1.rpy:382
translate pt_br a3s1_cb6f719c:

    # n "\"I was making a point, clearly. Sorry, should I simplify my words for you?\""
    n "\"Eu estava apresentando um ponto de vista, claramente. Desculpe, eu deveria simplificar minhas palavras para você?\""

# game/a3s1.rpy:384
translate pt_br a3s1_d0b59f05:

    # "The jackal goes on staring at the bottle, as if wondering if it's worth it to make the journey there."
    "O chacal então começa a encarar a garrafa, como se estivesse se perguntando se vale a pena fazer a jornada até lá."

# game/a3s1.rpy:386
translate pt_br a3s1_2e08f618:

    # "He turns back to me, as if just remembering that I'm there, though he seems to have trouble focusing his eyes."
    "Ele vira a cabeça de volta para mim, como se tivesse acabado de lembrar que estou aqui, embora ele pareça estar tendo dificuldade em focar os olhos."

# game/a3s1.rpy:387
translate pt_br a3s1_52e9e541:

    # n "\"Don't worry, [mc], I am just as much a slave as you are. You have the advantage of some day leaving, though.\""
    n "\"Não se preocupe, [mc], eu sou um escravo tanto quanto você. Embora você tenha a vantagem de ir embora algum dia.\""

# game/a3s1.rpy:388
translate pt_br a3s1_af90e319:

    # "I move closer, deciding to sit on my bed while Neferu goes on hugging at the pillar, as if letting go will cause him to fall."
    "Eu me aproximo, decidindo sentar na minha cama enquanto Neferu continua abraçando o pilar, como se soltar fosse provocar sua queda."

# game/a3s1.rpy:389
translate pt_br a3s1_977b8ea0:

    # "That wouldn't be good considering the fountain is right there."
    "Isso não seria nada bom considerando que a fonte está bem ali."

# game/a3s1.rpy:390
translate pt_br a3s1_e8967cd6:

    # m "\"You can't leave whenever you want?\""
    m "\"Você não pode ir embora quando quiser?\""

# game/a3s1.rpy:392
translate pt_br a3s1_c2c3a664:

    # "Neferu chuckles, then guffaws, another sound I've never heard from him."
    "Neferu dá uma risadinha, então gargalha, outro som que eu nunca tinha ouvido dele antes."

# game/a3s1.rpy:393
translate pt_br a3s1_6fe012d7:

    # n "\"You don't understand. I can leave, but I {i}can't{/i} leave.\""
    n "\"Você não entende. Eu posso ir embora, mas eu não {i}posso{/i} ir embora.\""

# game/a3s1.rpy:394
translate pt_br a3s1_33241b8d:

    # m "\"...Yeah, I don't think I do understand.\""
    m "\"(...) É, acho que eu não entendo mesmo.\""

# game/a3s1.rpy:395
translate pt_br a3s1_00b444b9:

    # "Suddenly, Neferu's ears flatten."
    "De repente, as orelhas do Neferu caem."

# game/a3s1.rpy:397
translate pt_br a3s1_e9080f3d:

    # n "\"You really fucked this up for me, do you understand that?\""
    n "\"Você realmente estragou tudo para o meu lado, consegue entender isso?\""

# game/a3s1.rpy:398
translate pt_br a3s1_2cc7b95a:

    # "I blink."
    "Eu pisco."

# game/a3s1.rpy:399
translate pt_br a3s1_df8ec4bc_1:

    # m "\"What?\""
    m "\"O que?\""

# game/a3s1.rpy:401
translate pt_br a3s1_6d5d9718:

    # n "\"You. Fucked. My. Life.\""
    n "\"Você. Fodeu. Minha. Vida.\""

# game/a3s1.rpy:402
translate pt_br a3s1_112966bd:

    # "This time Neferu uses his foot to point at me...or really just sort of kicking it in my direction."
    "Dessa vez, Neferu usa o pé para apontar para mim... ou realmente só meio que chutando na minha direção."

# game/a3s1.rpy:403
translate pt_br a3s1_02f1940d:

    # m "\"What the hell are you talking about?\""
    m "\"Do que diabos você tá falando?\""

# game/a3s1.rpy:404
translate pt_br a3s1_980ced3d:

    # n "\"If you hadn't come here, Cato would not have had the excuse to nullify Amicus's emperorship. I would be halfway through negotiating an alliance by now.\""
    n "\"Se você não tivesse vindo para cá, Cato não teria desculpas para anular o cargo de imperador do Amicus. Eu estaria a meio caminho da negociação de uma aliança agora.\""

# game/a3s1.rpy:405
translate pt_br a3s1_0c281810:

    # m "\"Wait, this isn't my fault. I was brought here against my will, Neferu.\""
    m "\"Peraê, isso não é culpa minha. Eu fui trazido até aqui contra minha vontade, Neferu.\""

# game/a3s1.rpy:407
translate pt_br a3s1_66f3c71d:

    # "Neferu makes another deep swallowing sound, then just belches loudly."
    "Neferu emite outro som profundo de deglutição e depois solta um arroto bem alto."

# game/a3s1.rpy:408
translate pt_br a3s1_66d3f6be:

    # n "\"Yes, yes, I'm sorry. I forget it's mostly that big idiot's fault.\""
    n "\"Sim, sim, eu sinto muito. Esqueci que a maior parte da culpa é daquele grande idiota.\""

# game/a3s1.rpy:409
translate pt_br a3s1_0cd92e8e:

    # "I feel my temper snap and I stand up."
    "Sinto meu temperamento ficar pior e me levanto."

# game/a3s1.rpy:410
translate pt_br a3s1_38932c9f:

    # "Now is not the time I wanted to find out that my most important ally actually blames me and my boyfriend for the situation he's in."
    "Agora não é a hora que eu gostaria de descobrir que meu aliado mais importante na verdade culpa a mim e meu namorado pela situação em que ele se encontra."

# game/a3s1.rpy:411
translate pt_br a3s1_955a8a09:

    # m "\"Hey, I know you're drunk, but I'm not gonna listen to you say this shit. You can call me back when you've sobered up and stop feeling sorry for yourself.\""
    m "\"Olha só, eu sei que você tá bêbado, mas eu não vou ficar ouvindo você falar esse monte de merda. Você pode me chamar de volta quando ficar sóbrio e parar de sentir pena de si mesmo.\""

# game/a3s1.rpy:413
translate pt_br a3s1_1f2b7d19:

    # "I start walking toward the door quickly, feeling a little sick at the whole situation."
    "Eu começo a andar em direção à porta rapidamente, me sentindo um pouco mal com toda a situação."

# game/a3s1.rpy:414
translate pt_br a3s1_b6a46ce6:

    # "If Neferu really is turning on me, that means the only person I can trust here is in the dungeon."
    "Se Neferu realmente está se voltando contra mim, isso significa que a única pessoa em quem eu posso confiar aqui está nas masmorras."

# game/a3s1.rpy:415
translate pt_br a3s1_89803e76:

    # "I really would be alone."
    "Eu realmente estaria sozinho nessa."

# game/a3s1.rpy:416
translate pt_br a3s1_66fac335:

    # n "\"Wait...\""
    n "\"Espera...\""

# game/a3s1.rpy:417
translate pt_br a3s1_4faa458c:

    # "His voice is so quiet that I'm almost not even sure if I'd heard it."
    "Sua voz sai tão quieta que quase nem tenho certeza se escutei."

# game/a3s1.rpy:418
translate pt_br a3s1_e1c41e39:

    # "I pause though, looking back over my shoulder."
    "Mas eu paro, olhando de volta por cima do ombro."

# game/a3s1.rpy:420
translate pt_br a3s1_b997abe7:

    # "He's still leaned up against the pillar, his ears down, gazing at the ground."
    "Ele ainda está encostado no pilar, as orelhas abaixadas."

# game/a3s1.rpy:421
translate pt_br a3s1_941ea22a:

    # "I'm about to ask him to repeat himself, but that's when he suddenly lets out a gasp and slides down the pillar to his knees."
    "Fico prestes a pedir para ele falar de novo, mas é quando ele de repente solta uma arfada e desliza no pilar até ficar de joelhos."

# game/a3s1.rpy:424
translate pt_br a3s1_32d2ec05:

    # "He crumples on the ground, paws covering his face as he trembles and starts to sob loudly."
    "Ele se dobra no chão, as patas cobrindo seu rosto enquanto ele treme e começa a soluçar ruidosamente."

# game/a3s1.rpy:425
translate pt_br a3s1_6a691dbc:

    # n "\"I'm...I'm s—so sorry. I don't...I don't know what I'm—what I'm doing.\""
    n "\"Eu... eu sinto muito, muito mesmo. Eu não... eu não sei o que—eu não sei o que estou fazendo.\""

# game/a3s1.rpy:426
translate pt_br a3s1_f070c4c4:

    # "I stare, open-mouthed, watching the jackal cry for several seconds."
    "Eu o encaro de boca aberta, assistindo ao chacal chorando por vários segundos."

# game/a3s1.rpy:427
translate pt_br a3s1_33c1cecf:

    # "Apparenly \"too drunk\" means \"waaaaay too drunk\"."
    "Aparentemente \"muito bêbado\" significa \"muuuuuiiito bêbado\"."

# game/a3s1.rpy:428
translate pt_br a3s1_ec40abf0:

    # "Still, this jackal clearly has a lot of problems that he doesn't tell anyone about."
    "Ainda assim, esse chacal claramente tem vários problemas que ele não conta a ninguém."

# game/a3s1.rpy:429
translate pt_br a3s1_208fc44b:

    # "Actually, he doesn't really have anyone to tell them to on this alien moon."
    "Na verdade, ele realmente não tem ninguém nessa lua alienígena com quem desabafar."

# game/a3s1.rpy:430
translate pt_br a3s1_272a52df:

    # "At least I have Amicus."
    "Eu tenho o Amicus, pelo menos."

# game/a3s1.rpy:432
translate pt_br a3s1_ce056b53:

    # "So, after standing there in stunned silence for a moment, I walk over to Neferu."
    "Então, depois de ficar parado em silêncio por um momento, eu vou até ele."

# game/a3s1.rpy:433
translate pt_br a3s1_c6be5d92:

    # "I stand awkwardly at his side for a moment, watching his broad, black-furred shoulders heave up and down before I kneel and rest a hand on his back."
    "Fico parado ao seu lado sem saber o que fazer por um momento, observando seus ombros largos e de pelo preto subirem e descerem antes que eu me ajoelhe e repouse uma mão en suas costas."

# game/a3s1.rpy:434
translate pt_br a3s1_1b3267cc:

    # "I see his ears perk up for a moment in reaction, but otherwise he doesn't say anything."
    "Eu vejo suas orelhas se levantarem por um momento em reação, mas ele não fala nada."

# game/a3s1.rpy:435
translate pt_br a3s1_0248e681:

    # "I'm generally not the best at comforting someone, especially when they're crying, but I rub my hand in a circle through the fur."
    "Eu geralmente não sou muito bom em confortar os outros, especialmente quando eles estão chorando, mas eu começo a esfregar minha mão em um círculo através do pelo."

# game/a3s1.rpy:436
translate pt_br a3s1_d00111f6:

    # m "\"Hey...I get it. This whole thing is really frustrating, but we'll figure this out together.\""
    m "\"Ei... eu entendo. Essa situação toda é realmente frustrante, mas nós vamos dar um jeito, juntos.\""

# game/a3s1.rpy:437
translate pt_br a3s1_ba6e0355:

    # "I give the jackal a few minutes to finally calm down, then I start to pull him up, pushing him in the direction of his bed."
    "Dou ao chacal alguns minutos para finalmente se acalmar, então começo a puxar ele para cima, o empurrando em direção à cama."

# game/a3s1.rpy:438
translate pt_br a3s1_53d45b5a:

    # "He doesn't resist and stumbles up to it before falling face-down onto the covers."
    "Ele não resiste e tropeça até ela antes de cair de cara em cima dos lençóis."

# game/a3s1.rpy:439
translate pt_br a3s1_e8bd7674:

    # "He wipes his face with the pillow and while he does that, I quickly grab the wine bottles, moving them to the floor so that they're out of his reach."
    "Ele limpa o rosto com o travesseiro e enquanto faz isso, rapidamente pego as garrafas de vinho, colocando-as no chão para que estejam fora de seu alcance."

# game/a3s1.rpy:440
translate pt_br a3s1_38e79375:

    # "Finally, Neferu lets out a big, shuddery sigh."
    "Finalmente, Neferu solta um grande suspiro trêmulo."

# game/a3s1.rpy:442
translate pt_br a3s1_17a6450b:

    # n "\"Can you...rub my back again? It feels good.\""
    n "\"Você pode... esfregar minhas costas de novo? É uma sensação boa.\""

# game/a3s1.rpy:443
translate pt_br a3s1_4061012a:

    # "The jackal's voice is stuffy from his clogged nose."
    "A voz do chacal fica abafada por causa do nariz entupido."

# game/a3s1.rpy:444
translate pt_br a3s1_910f899d:

    # m "\"Sure.\""
    m "\"Tá.\""

# game/a3s1.rpy:445
translate pt_br a3s1_f19c12eb:

    # "I kneel beside the bed before starting to rub Neferu's back again."
    "Eu me ajoelho ao lado da cama antes de começar a esfregar as costas do Neferu outra vez."

# game/a3s1.rpy:446
translate pt_br a3s1_4b98aa43:

    # "He sighs, head turned away from me."
    "Ele suspira, sua cabeça virada para o outro lado."

# game/a3s1.rpy:447
translate pt_br a3s1_f84e01f6:

    # "I let the silence go on for a while, listening to the jackal sniffing every couple of seconds before I finally speak."
    "Deixo o silêncio continuar por um tempo, ouvindo o chacal fungando a cada dois segundos antes de finalmente falar."

# game/a3s1.rpy:448
translate pt_br a3s1_4731eb9a:

    # m "\"So uh...what happened?\""
    m "\"Então, hã... o que aconteceu?\""

# game/a3s1.rpy:449
translate pt_br a3s1_0a109fb3:

    # n "\"I drank.\""
    n "\"Eu bebi.\""

# game/a3s1.rpy:450
translate pt_br a3s1_d0193d53:

    # m "\"Yeah, speaking of which; Com, bring us a glass and pitcher of water please?\""
    m "\"É, falando nisso; Com, traz pra gente um copo e uma jarra de água, por favor?\""

# game/a3s1.rpy:451
translate pt_br a3s1_520b085c:

    # com "\"Yes, [mc].\""
    com "\"Sim, [mc].\""

# game/a3s1.rpy:452
translate pt_br a3s1_4a1aa200:

    # m "\"And uh, take the wine bottles away too.\""
    m "\"E, hã... leva embora as garrafas de vinho também.\""

# game/a3s1.rpy:453
translate pt_br a3s1_520b085c_1:

    # com "\"Yes, [mc].\""
    com "\"Sim, [mc].\""

# game/a3s1.rpy:454
translate pt_br a3s1_37099a92:

    # n "\"Nooo, my precious wolven wine.\""
    n "\"Nãããoo, meu precioso vinho lobino.\""

# game/a3s1.rpy:455
translate pt_br a3s1_cc442595:

    # "Neferu says it in a mock sad voice, but combined with his already sad state, there's not much of a difference."
    "Neferu diz isso com uma voz triste fingida, mas combinado com seu estado já triste, não faz muita diferença."

# game/a3s1.rpy:456
translate pt_br a3s1_ebd3f6e1:

    # m "\"Again, what happened?\""
    m "\"Mais uma vez, o que aconteceu?\""

# game/a3s1.rpy:458
translate pt_br a3s1_7583a0b0:

    # n "\"I don't know...I suppose I realized how challenging this will all be. I can't say I trust the wolven people to oust Cassius. They're rather accepting of corrupt officials.\""
    n "\"Eu não sei... acho que percebi o quão desafiador tudo isso vai ser. Não posso dizer que confio no povo lobino para tirar o Cassius do trono. Eles são muito passivos com oficiais corruptos.\""

# game/a3s1.rpy:459
translate pt_br a3s1_2c8bb309:

    # "I think, trying to approach this delicately."
    "Eu penso, tentando abordar isso delicadamente."

# game/a3s1.rpy:460
translate pt_br a3s1_60d14cf1:

    # m "\"Is your family making you do this, like they won't let you come back unless you cultivate the alliance?\""
    m "\"Sua família tá fazendo você fazer isso, tipo, eles não vão deixar você voltar a não ser que consiga a aliança?\""

# game/a3s1.rpy:462
translate pt_br a3s1_c1bfc414:

    # n "\"Hehe, my family doesn't even expect me to accomplish that, but that's why I must do it. If I don't, I might as well be banished.\""
    n "\"Hehe, minha família nem sequer espera que eu conquiste essa aliança, mas é exatamente por isso que eu devo ter sucesso, ou eu poderia ser banido.\""

# game/a3s1.rpy:463
translate pt_br a3s1_0fd013da:

    # m "\"It seems kind of unfair that they'd put all of this on you.\""
    m "\"Parece meio injusto que eles tenham deixado tudo isso pra você resolver.\""

# game/a3s1.rpy:465
translate pt_br a3s1_4f9d7d3b:

    # n "\"After what I've put them through, it's only fair.\""
    n "\"Depois do que eu fiz eles passarem, é apenas justo.\""

# game/a3s1.rpy:466
translate pt_br a3s1_918b3ff2:

    # "I wait for more of an explanation, but he doesn't go on."
    "Eu espero por mais explicação, mas ele não continua."

# game/a3s1.rpy:467
translate pt_br a3s1_70274ef6:

    # m "\"So is what Alex said on the island about you and your family true?\""
    m "\"Então aquilo que o Alex disse na ilha sobre você e sua família é verdade?\""

# game/a3s1.rpy:468
translate pt_br a3s1_cf12068f:

    # n "\"More or less.\""
    n "\"Mais ou menos.\""

# game/a3s1.rpy:469
translate pt_br a3s1_f54dbe2f:

    # "Again, he doesn't seem interested in talking about it, so I just go on rubbing his back."
    "Mais uma vez, ele não parece interessado em falar sobre isso, então eu só continuo esfregando suas costas."

# game/a3s1.rpy:470
translate pt_br a3s1_c74f7402:

    # m "\"Well, we're gonna get Amicus out of the dungeons and onto the throne. I know you don't believe that I've talked to the parents, but I really think I have, and they're on our side.\""
    m "\"Bem, a gente vai tirar o Amicus das masmorras e levar ao trono. Eu sei que você não acredita que eu falei com os progenitores, mas eu realmente acho que sim, e eles estão do nosso lado.\""

# game/a3s1.rpy:472
translate pt_br a3s1_adaeddad:

    # "Neferu chuckles."
    "Neferu dá uma risadinha."

# game/a3s1.rpy:474
translate pt_br a3s1_3236ec8d:

    # m "\"So you'll get that alliance.\""
    m "\"Então você vai conseguir essa aliança.\""

# game/a3s1.rpy:476
translate pt_br a3s1_7fe1a4f9:

    # n "\"I hope so, my friend.\""
    n "\"Espero que sim, meu amigo.\""

# game/a3s1.rpy:477
translate pt_br a3s1_5ee6a9ce:

    # "We sit in silence for a long while, and even I start to enjoy the hypnotic motion of rubbing Neferu's furry back in a large spiral motion."
    "Ficamos em silêncio por um longo tempo e até eu começo a curtir o movimento hipnótico de esfregar as costas peludas do Neferu em um grande movimento espiral."

# game/a3s1.rpy:478
translate pt_br a3s1_0d360a41:

    # "My mind wanders back to the cat."
    "Minha mente vagueia de volta para o gato."

# game/a3s1.rpy:480
translate pt_br a3s1_cc64e6cd:

    # m "\"Speaking of Alex, I had a weird conversation with him today. I think he thinks we're like...conspiring against him, or something.\""
    m "\"Falando no Alex, eu tive uma conversa estranha com ele hoje. Acho que ele pensa que a gente tá tipo... conspirando contra ele, ou algo assim.\""

# game/a3s1.rpy:481
translate pt_br a3s1_11246b01:

    # "Neferu grunts."
    "Neferu grunhe."

# game/a3s1.rpy:483
translate pt_br a3s1_975f129e:

    # n "\"Stay away from that cat. He's nothing but trouble.\""
    n "\"Fique longe daquele gato. Ele não é nada além de encrenca.\""

# game/a3s1.rpy:484
translate pt_br a3s1_abd525b5:

    # m "\"Well, he kept bringing up the alliance. He seemed to want to know my role in it.\""
    m "\"Então, ele ficava batendo na tecla da aliança. Parecia querer saber o meu papel nisso.\""

# game/a3s1.rpy:485
translate pt_br a3s1_739d97dc:

    # "Neferu turns his face toward me, his eyes bloodshot, but the tears dried up at this point."
    "Neferu vira o rosto em minha direção, seus olhos avermelhados, mas as lágrimas já secas a essa altura."

# game/a3s1.rpy:486
translate pt_br a3s1_1e0aea36:

    # n "\"I assume it had something to do with not wanting the alliance to happen?\""
    n "\"Presumo que tinha algo a ver com não querer que a aliança acontecesse?\""

# game/a3s1.rpy:487
translate pt_br a3s1_c806ebc0_1:

    # m "\"Yeah.\""
    m "\"É.\""

# game/a3s1.rpy:488
translate pt_br a3s1_a6abe4cc:

    # "Neferu takes a deep breath and presses his face into the pillow, letting out a long groan."
    "Neferu respira bem fundo e pressiona seu rosto no travesseiro, deixando escapar um longo gemido de lamentação."

# game/a3s1.rpy:489
translate pt_br a3s1_5eb0351c:

    # n "\"All I can say is don't trust him.\""
    n "\"Tudo o que eu posso dizer é: não confie nele.\""

# game/a3s1.rpy:490
translate pt_br a3s1_772eb02e:

    # m "\"Yeah, definitely not. I just don't really get what he's doing.\""
    m "\"É, definitivamente não. Eu só realmente não entendo o que ele tá fazendo.\""

# game/a3s1.rpy:491
translate pt_br a3s1_e567b56d:

    # n "\"Neither do I, and that's why you should stay away from him.\""
    n "\"Nem eu, e é por isso que você deveria ficar longe dele.\""

# game/a3s1.rpy:492
translate pt_br a3s1_ebf91e77:

    # m "\"Really? I thought you two...I dunno, talked and did stuff together.\""
    m "\"Sério? Eu achava que vocês dois... sei lá, conversavam e faziam coisas juntos.\""

# game/a3s1.rpy:494
translate pt_br a3s1_83c90434:

    # n "\"Which didn't shed any light on his motives. Considering the way our relationship has changed, I doubt I'll get any more information from him.\""
    n "\"O que não jogou nenhuma luz sobre suas motivações. Considerando a forma como nosso relacionamento mudou, duvido que conseguirei qualquer informação a mais dele.\""

# game/a3s1.rpy:495
translate pt_br a3s1_f30bfe77:

    # m "\"Sure you can't just seduce him again?\""
    m "\"Tem certeza que você não pode simplesmente seduzir ele de novo?\""

# game/a3s1.rpy:497
translate pt_br a3s1_f9ee6f09:

    # "Neferu cracks a smile."
    "Neferu racha um sorriso."

# game/a3s1.rpy:498
translate pt_br a3s1_ac01ffd6:

    # n "\"Last time I tried that, he referred to me as a whore...which isn't exactly inaccurate.\""
    n "\"Última vez que eu tentei isso ele se referiu a mim como um prostituto... o que não é exatamente impreciso.\""

# game/a3s1.rpy:499
translate pt_br a3s1_a2f52205:

    # "The doors open and a drone glides in, setting water down on the bedside table and fetching the bottles from behind the jackals bed."
    "As portas se abrem e um drone entra no recinto, colocando a água na mesa de cabeceira e pegando as garrafas atrás da cama do chacal."

# game/a3s1.rpy:501
translate pt_br a3s1_81351e51:

    # "Neferu watches it go morosely."
    "Neferu observa em melancolia."

# game/a3s1.rpy:502
translate pt_br a3s1_ce64039d:

    # "I clear my throat, trying to distract him from the departing alcohol."
    "Eu pigarreio, tentando distrair ele do álcool sendo levado embora."

# game/a3s1.rpy:503
translate pt_br a3s1_d7e4cdc0:

    # m "\"I get what you mean though. It seems like he favors one side, then the other. I don't get it.\""
    m "\"Mas eu entendo o que você quer dizer. Parece que ele favorece um lado, depois o outro. Eu não entendo.\""

# game/a3s1.rpy:504
translate pt_br a3s1_e20675ca:

    # "Neferu waves his paw."
    "Neferu balança a pata."

# game/a3s1.rpy:506
translate pt_br a3s1_9b72f79d:

    # n "\"Best not to worry yourself with him and simply stay away. Omorfans are famous for their quirks and seemingly contradictive behavior.\""
    n "\"Melhor você não se preocupar com ele e simplesmente manter distância. Omorfanos são famosos por suas peculiaridades e comportamento aparentemente contraditório.\""

# game/a3s1.rpy:507
translate pt_br a3s1_6f19d038:

    # m "\"Alright.\""
    m "\"Tudo bem.\""

# game/a3s1.rpy:509
translate pt_br a3s1_314e9f28:

    # "I rub for a while longer, switching hands as my arm starts getting tired."
    "Eu massageio por mais um tempo, intercalando as mãos quando meu braço começa a ficar cansado."

# game/a3s1.rpy:510
translate pt_br a3s1_6d35b09a:

    # "I'm starting to think that the jackal has fallen asleep when he suddenly speaks again, jolting me out of my trance."
    "Eu começo a pensar que o chacal adormeceu quando, de repente, ele fala de novo, me tirando do transe."

# game/a3s1.rpy:512
translate pt_br a3s1_3eefe7b6:

    # n "\"We will be revealing our hand to Cassius tomorrow. With any luck, Amicus will be free by the end of the week.\""
    n "\"Nós vamos revelar nosso plano para o Cassius amanhã. Com alguma sorte, Amicus estará livre até o final da semana.\""

# game/a3s1.rpy:513
translate pt_br a3s1_89357ba6:

    # m "\"Oh...\""
    m "\"Ah...\""

# game/a3s1.rpy:514
translate pt_br a3s1_61b99de2:

    # "I'm surprised, finding that hard to take in."
    "Eu fico surpreso, achando isso difícil de absorver."

# game/a3s1.rpy:515
translate pt_br a3s1_4991d345:

    # "I knew this would be coming, but not so soon."
    "Eu sabia que isso iria acontecer, mas não tão cedo."

# game/a3s1.rpy:516
translate pt_br a3s1_540d79a9:

    # m "\"How are we gonna do that?\""
    m "\"Como a gente vai fazer isso?\""

# game/a3s1.rpy:517
translate pt_br a3s1_aad02cb6:

    # n "\"Well, we have three pieces of information that can help us. The first is the footage from the third trial, hopefully that will be enough to convince Cassius to step down.\""
    n "\"Bem, temos três informações que podem nos ajudar. A primeira é a filmagem do terceiro julgamento, com sorte isso será suficiente para convencer Cassius a renunciar.\""

# game/a3s1.rpy:518
translate pt_br a3s1_df288e8f:

    # "Neferu suddenly shifts and slowly sits up, groaning again before reaching for the pitcher and glass of water."
    "Neferu repentinamente muda de posição e se senta, gemendo outra vez antes de alcançar a jarra e o copo de água."

# game/a3s1.rpy:519
translate pt_br a3s1_955f554a:

    # n "\"The second is the footage of Cato attacking me. I'd rather we not have to use that, but if Cassius isn't convinced by the first, then we may have to resort to it.\""
    n "\"A segunda é a filmagem do Cato me atacando. Eu prefiro que nós não precisemos usar isso, mas se Cassius não for convencido pela primeira, então talvez tenhamos que recorrer a ela.\""

# game/a3s1.rpy:520
translate pt_br a3s1_14212003:

    # "Neferu drinks deeply from his glass, and I watch him impatiently as he drains the entire thing."
    "Neferu bebe profundamente de seu copo e eu o observo impaciente enquanto ele drena a coisa toda."

# game/a3s1.rpy:521
translate pt_br a3s1_6b1b3812:

    # m "\"And the third?\""
    m "\"E a terceira?\""

# game/a3s1.rpy:522
translate pt_br a3s1_167df24a:

    # "Neferu gasps and leans back, setting the glass down."
    "Neferu suspira e se inclina de volta, deixando o copo."

# game/a3s1.rpy:524
translate pt_br a3s1_de56b445:

    # n "\"Remember your little theory about the previous emperor's accident?\""
    n "\"Lembra da sua pequena teoria sobre o acidente do imperador anterior?\""

# game/a3s1.rpy:525
translate pt_br a3s1_8ce61eb8:

    # "I nod."
    "Eu aceno com a cabeça."

# game/a3s1.rpy:526
translate pt_br a3s1_3baddf98:

    # m "\"Alex said the investigation was botched.\""
    m "\"Alex disse que a investigação foi um fracasso.\""

# game/a3s1.rpy:528
translate pt_br a3s1_5be167d1:

    # "Neferu glances at me."
    "Neferu me olha feio."

# game/a3s1.rpy:529
translate pt_br a3s1_e4d29bfd:

    # n "\"The fact that the cat tipped you off is worrying...but, it is very odd. The investigation wasn't botched, but rather called off by the acting emperor.\""
    n "\"O fato do gato ter lhe dado uma dica é preocupante... mas é muito estranho. A investigação não foi um fracasso, na verdade, foi cancelada pelo imperador interino.\""

# game/a3s1.rpy:530
translate pt_br a3s1_8a99da6f:

    # m "\"Cato?\""
    m "\"Cato?\""

# game/a3s1.rpy:531
translate pt_br a3s1_02de9316:

    # n "\"Indeed. The investigators were only able to get as far as discovering a possible malicious software installed on the ship's navigations system.\""
    n "\"Exatamente. Os investigadores foram longe ao ponto de descobrir um possível software malicioso instalado no sistema de navegação da nave.\""

# game/a3s1.rpy:532
translate pt_br a3s1_f5eeee97:

    # n "\"Considering software has to be installed through a port, and that the ship is heavily protected whenever outside the palace, the installation likely would have had to have happened while inside the palace.\""
    n "\"Considerando que o software precisa ser instalado através de uma porta de acesso e que a nave é fortemente protegida enquanto está fora do palácio, a instalação provavelmente teria acontecido enquanto a nave estava dentro dele.\""

# game/a3s1.rpy:533
translate pt_br a3s1_88a5f18d:

    # m "\"So Cato.\""
    m "\"Então foi o Cato.\""

# game/a3s1.rpy:535
translate pt_br a3s1_adaeddad_1:

    # "Neferu chuckles."
    "Neferu dá uma risadinha."

# game/a3s1.rpy:536
translate pt_br a3s1_f9c5aba9:

    # n "\"More than likely, yes, but I don't understand why. Cato was good friends with the last emperor, and as far as I can tell, he was supportive of his policies.\""
    n "\"Mais que provável, sim, mas eu não entendo o porquê. Cato era um ótimo amigo do último imperador e até onde eu sei, ele apoiava suas propostas.\""

# game/a3s1.rpy:537
translate pt_br a3s1_ed383bf9:

    # m "\"Well, how people act on the outside doesn't really seem to matter much around here.\""
    m "\"Então, né, como as pessoas agem por fora não parece realmente importar muito por aqui.\""

# game/a3s1.rpy:539
translate pt_br a3s1_145767c2:

    # n "\"Or anywhere. What convinced me of Cato's involvement however, is the fact that every single investigator has gone missing since.\""
    n "\"Ou em qualquer lugar. No entanto, o que me convenceu do envolvimento do Cato foi o fato de que cada um dos investigadores estão desaparecidos desde então.\""

# game/a3s1.rpy:540
translate pt_br a3s1_df8ec4bc_2:

    # m "\"What?\""
    m "\"O que?\""

# game/a3s1.rpy:542
translate pt_br a3s1_fd68d82c:

    # n "\"Mhm.\""
    n "\"Mhm.\""

# game/a3s1.rpy:543
translate pt_br a3s1_93ed1ccc:

    # "I start to feel that icy fear in my chest again."
    "Eu começo a sentir aquele medo gelado no meu peito mais uma vez."

# game/a3s1.rpy:544
translate pt_br a3s1_a2ed0224:

    # "If it is Cato, then he really is ruthless."
    "Se foi o Cato, então ele realmente é cruel."

# game/a3s1.rpy:545
translate pt_br a3s1_a3562a9c:

    # "What I saw happen to that doctor, Felix, could only be a taste of what Cato is capable of."
    "O que eu vi acontecer com aquele médico, Felix, pode ser só uma amostra do que o Cato é capaz."

# game/a3s1.rpy:546
translate pt_br a3s1_d97cda5a:

    # n "\"Unfortunately, because there is no solid evidence linking Cato, I'm afraid it might not be very effective. It could be another last resort though.\""
    n "\"Infelizmente, como não há evidências sólidas que conectem ao Cato, receio que não será muito eficaz. Mas poderia ser um outro último recurso.\""

# game/a3s1.rpy:548
translate pt_br a3s1_94c4eb4e:

    # n "\"Anyway, would you like to go with Virginia to try and convince him with this information?\""
    n "\"Enfim, gostaria de ir com Virginia para tentar convencê-lo com essas informações?\""

# game/a3s1.rpy:549
translate pt_br a3s1_0dadb667:

    # m "\"Really? You've been trying to get me to stay out of the way for the past week.\""
    m "\"Sério? Você vem tentando me fazer ficar fora do caminho a semana toda.\""

# game/a3s1.rpy:550
translate pt_br a3s1_1a6579cf:

    # n "\"To keep you safe, but I've noticed that Cassius may have taken a liking to you as of late. You know him to some degree and could use that knowledge to better convince him.\""
    n "\"Para mantê-lo seguro, mas notei que Cassius pode ter gostado de você ultimamente. Você o conhece em algum nível e poderia usar este conhecimento para convencê-lo da melhor forma.\""

# game/a3s1.rpy:551
translate pt_br a3s1_2be3e65d:

    # m "\"Well, I wouldn't say he likes me, but yeah, I can try.\""
    m "\"Então, eu não diria exatamente que ele gosta de mim, mas beleza, eu posso tentar.\""

# game/a3s1.rpy:552
translate pt_br a3s1_7bd77c6c:

    # n "\"And as I said, Virginia will be there to help as well.\""
    n "\"Como eu disse, Virginia estará lá para ajudar.\""

# game/a3s1.rpy:553
translate pt_br a3s1_f5b997af:

    # m "\"I assume you're not going?\""
    m "\"Suponho então que você não vai?\""

# game/a3s1.rpy:555
translate pt_br a3s1_f93f2b76:

    # "Neferu smirks."
    "Neferu sorri pretensiosamente."

# game/a3s1.rpy:556
translate pt_br a3s1_af4ceb73:

    # n "\"I am the last person he would want to see while discussing the possible end of his rule. Besides, I know I'm not going to be feeling my best tomorrow. I think I'll stay in bed for once.\""
    n "\"Eu sou a última pessoa que ele gostaria de ver enquanto discute o possível fim de seu governo. Além disso, sei que não vou estar no meu melhor estado amanhã. Acho que vou me manter na cama, para variar.\""

# game/a3s1.rpy:557
translate pt_br a3s1_d87f04fe:

    # m "\"Drink more water.\""
    m "\"Bebe mais água.\""

# game/a3s1.rpy:559
translate pt_br a3s1_fe575250:

    # "Neferu sighs, just sort of looking at the pitcher."
    "Neferu suspira, meio que só olhando na direção da jarra."

# game/a3s1.rpy:560
translate pt_br a3s1_112c2e03:

    # "I roll my eyes, reaching out to pour him another glass."
    "Eu reviro os olhos, estendendo a mão para servir outro copo."

# game/a3s1.rpy:562
translate pt_br a3s1_dd1e87cf:

    # n "\"Oh how kind of you.\""
    n "\"Ah, como você é gentil.\""

# game/a3s1.rpy:563
translate pt_br a3s1_29e33bbf:

    # m "\"I'm a slave, right?\""
    m "\"Eu sou um escravo, né?\""

# game/a3s1.rpy:565
translate pt_br a3s1_9a4bce58:

    # "Neferu winces as he takes the glass from me."
    "Neferu se contorce quando pega o copo de mim."

# game/a3s1.rpy:567
translate pt_br a3s1_d568f1aa:

    # n "\"No...you're a Khemian, and I think we'll be very proud to have you.\""
    n "\"Não... você é um khemiano e eu acho que nós teremos muito orgulho em recebê-lo.\""

# game/a3s1.rpy:568
translate pt_br a3s1_463df8c5:

    # "With that, he once again downs the entire thing."
    "Com isso, ele engole tudo de uma vez."

# game/a3s1.rpy:571
translate pt_br a3s1_8550e322:

    # "I toss and turn most of the night, even while Neferu snores loudly in his own bed."
    "Eu fico agitado e me mexendo a maior parte da noite, mesmo enquanto o Neferu ronca ruidosamente em sua própria cama."

# game/a3s1.rpy:572
translate pt_br a3s1_ed703c06:

    # "I go over what I might be able to say to Cassius in case things go wrong for whatever reason."
    "Fico repetindo mentalmente o que eu poderia dizer ao Cassius caso as coisas deem errado por qualquer motivo."

# game/a3s1.rpy:573
translate pt_br a3s1_d27a9228:

    # "I find that difficult to do though, especially considering how angry and unpredictable the wolf can be sometimes."
    "Mas acho isso difícil de fazer, especialmente considerando quão irritado e imprevisível o lobo pode ser de vez em quando."

# game/a3s1.rpy:574
translate pt_br a3s1_de1f525e:

    # "I manage to get maybe a couple hours of sleep."
    "Eu consigo dormir talvez duas horas de sono."

# game/a3s1.rpy:576
translate pt_br a3s1_248a42ce:

    # "But as soon as the sun starts shining through the opening in the roof, I'm up and ready for Virginia to come get me."
    "Mas assim que o sol começa a brilhar pela abertura no telhado, me levanto e fico pronto para a Virginia vir me buscar."

# game/a3s1.rpy:577
translate pt_br a3s1_f46760fd:

    # "That doesn't happen until about an hour later, and Neferu only lifts his head for a moment when the wolf enters before groaning and dropping it back to the pillow."
    "Isso não acontece até cerca de uma hora depois e Neferu só levanta sua cabeça por um momento quando a loba entra antes de gemer e enfiar a cabeça de volta no travesseiro."

# game/a3s1.rpy:578
translate pt_br a3s1_e7dd35d8:

    # "I'm hoping that he doesn't remember what happened yesterday, for his sake."
    "Espero que ele não se lembre do que aconteceu ontem, pelo seu próprio bem."

# game/a3s1.rpy:581
translate pt_br a3s1_a7407fb3:

    # "The amount of anticipation in the air is almost too much for me to handle as I follow Virginia to the throne room."
    "O clima de antecipação no ar é quase demais para mim enquanto sigo Virginia até a sala do trono."

# game/a3s1.rpy:582
translate pt_br a3s1_ba556665:

    # "It's a feeling that I haven't felt since the trials, since when I thought I was about to be able to fly back home."
    "É um sentimento que não sinto desde os julgamentos, desde quando pensei que estava prestes a poder voar de volta para casa."

# game/a3s1.rpy:583
translate pt_br a3s1_4fbea3ef:

    # "Now though, it's the anticipation that I'll be able to get Amicus out of the dungeons."
    "Mas agora é a antecipação de que eu vou conseguir tirar o Amicus das masmorras."

# game/a3s1.rpy:584
translate pt_br a3s1_052a1037:

    # "We pause at the door, Virginia glancing at me."
    "Nós paramos na porta, Virginia olhando para mim."

# game/a3s1.rpy:586
translate pt_br a3s1_21717b76:

    # v "\"Remember, speak only if absolutely necessary. This is of the utmost importance.\""
    v "\"Lembre-se, fale apenas se for absolutamente necessário. Isto é de extrema importância.\""

# game/a3s1.rpy:587
translate pt_br a3s1_71c8b117:

    # "I nod silently."
    "Eu aceno com a cabeça, silenciosamente."

# game/a3s1.rpy:588
translate pt_br a3s1_3098e8a0:

    # "I get the feeling that she hadn't wanted me to come, but Neferu probably insisted."
    "Tenho a sensação de que ela não queria que eu viesse, mas Neferu provavelmente insistiu."

# game/a3s1.rpy:589
translate pt_br a3s1_5f05b78e:

    # "The wolf reaches out and presses the panel, opening the door."
    "A loba estende a mão e pressiona o painel, abrindo a porta."

# game/a3s1.rpy:592
translate pt_br a3s1_b23cd80b:

    # "I follow her in and immediately spot Cassius on his throne, still on his little booster seat, but there's someone else too."
    "Eu a sigo e imediatamente me deparo com o Cassius no trono, ainda em seu pequeno assento propulsor, mas também há outra pessoa."

# game/a3s1.rpy:593
translate pt_br a3s1_2a916ce0:

    # "We'd chosen today because Cato still hadn't returned from his trip, thus leaving Cassius alone."
    "Nós escolhemos hoje porque o Cato ainda não voltou de sua viagem, assim, deixando Cassius sozinho."

# game/a3s1.rpy:594
translate pt_br a3s1_d4fda896:

    # "Now though, Alex is here, kneeling beside the throne, his head on the armrest while Cassius strokes his head, his other paw occupied with a tablet-like device."
    "Mas agora o Alex está aqui, ajoelhado ao lado do trono, sua cabeça no apoio de braço enquanto Cassius o acaricia, a outra pata ocupada com um dispositivo semelhante a um tablet."

# game/a3s1.rpy:595
translate pt_br a3s1_86559426:

    # "He glances up."
    "Ele olha para cima."

# game/a3s1.rpy:597
translate pt_br a3s1_48e05195:

    # c "\"Ah, sister...and [mc]. What was it you needed?\""
    c "\"Ah, irmã... e [mc]. Do que vocês precisam?\""

# game/a3s1.rpy:598
translate pt_br a3s1_eda9bdba:

    # "Virginia is silent until we stop at the base of the steps."
    "Virginia fica em silêncio até pararmos na base dos degraus."

# game/a3s1.rpy:599
translate pt_br a3s1_d1e0b49b:

    # "I come to a stop just behind her, to her left."
    "Eu paro logo atrás dela, à sua esquerda."

# game/a3s1.rpy:601
translate pt_br a3s1_05e9dcbe:

    # "Cassius narrows his eyes as he looks down at us, probably realizing that this is no ordinary visit."
    "Cassius estreita os olhos enquanto olha para nós, provavelmente percebendo que essa não é uma visita comum."

# game/a3s1.rpy:603
translate pt_br a3s1_c1fb9c71:

    # "Meanwhile, Alex just stares at us inquisitively, looking innocent and oblivious as he always tries to."
    "Enquanto isso, Alex olha para nós inquisitivamente, parecendo inocente e absorto como ele sempre tenta transparecer."

# game/a3s1.rpy:607
translate pt_br a3s1_44048250:

    # v "\"Brother...I have something very, very important to discuss with you.\""
    v "\"Irmão... eu tenho algo muito, muito importante para discutir com você.\""

# game/a3s1.rpy:608
translate pt_br a3s1_ec5ef88d:

    # "Cassius regards her for a moment, then glances at me."
    "Cassius a olha por um momento, depois olha para mim."

# game/a3s1.rpy:610
translate pt_br a3s1_7a58e459:

    # c "\"Why is he here?\""
    c "\"Por que ele está aqui?\""

# game/a3s1.rpy:612
translate pt_br a3s1_e18adbd1:

    # v "\"It involves him. It involves all of us, actually.\""
    v "\"Isso o envolve. Envolve a todos nós, na verdade.\""

# game/a3s1.rpy:614
translate pt_br a3s1_e41ee5d6:

    # "Cassius frowns deeply, expression growing more and more sour."
    "Cassius franze a testa profundamente, sua expressão ficando cada vez mais amarga."

# game/a3s1.rpy:615
translate pt_br a3s1_6832ac46:

    # c "\"And what is it, Virginia?\""
    c "\"E o que é, Virginia?\""

# game/a3s1.rpy:616
translate pt_br a3s1_359f4197:

    # "Virginia takes a deep breath."
    "Virginia respira bem fundo."

# game/a3s1.rpy:618
translate pt_br a3s1_85496cc8:

    # v "\"Cassius...you must abdicate.\""
    v "\"Cassius... você deve renunciar.\""

# game/a3s1.rpy:621
translate pt_br a3s1_e0631be4:

    # "It takes Cassius a moment to take that in, but when he does, his eyes widen and his nostrils flare, leaning back in his throne like he's been slapped."
    "Cassius leva um momento para absorver isso, mas quando o faz, seus olhos se arregalam e suas narinas se abrem, inclinando-se para trás em seu trono como se tivesse levado um tapa."

# game/a3s1.rpy:623
translate pt_br a3s1_91c58798:

    # c "\"E—excuse me?\""
    c "\"C—como é?\""

# game/a3s1.rpy:624
translate pt_br a3s1_1d25cf0e:

    # "I wonder if this is the best way to go about telling Cassius that we're about to try and take the throne from him."
    "Eu me pergunto se essa é a melhor maneira de dizer ao Cassius que nós estamos prestes a tentar tomar o trono dele."

# game/a3s1.rpy:625
translate pt_br a3s1_8b1b0a5b:

    # "I look around, wondering if there are any drones that he might use to blast us with."
    "Eu olho em volta, me perguntando se há qualquer drone que ele possa usar para nos explodir."

# game/a3s1.rpy:626
translate pt_br a3s1_3485a9dc:

    # v "\"Cassius, we all know that this is illegitimate. You must consider—\""
    v "\"Cassius, todos nós sabemos que isso é ilegítimo. Você deveria considerar—\""

# game/a3s1.rpy:628
translate pt_br a3s1_30743b0e:

    # c "\"Enough! I will hear no talk of this...from my own sister, no less! Leave at once.\""
    c "\"Basta! Eu não vou ouvir nada sobre isso... da minha própria irmã, menos ainda! Vá embora.\""

# game/a3s1.rpy:629
translate pt_br a3s1_06b84e9d:

    # "The young wolf is shaking in his seat, wide-eyed, ears flat."
    "O jovem lobo treme em seu assento, olhos arregalados, orelhas baixas."

# game/a3s1.rpy:630
translate pt_br a3s1_837f4148:

    # v "\"Well, you must hear it.\""
    v "\"Bem, você deve ouvir.\""

# game/a3s1.rpy:632
translate pt_br a3s1_5d619cba:

    # c "\"I must not! I followed every protocol. I am in my rightful place. Leave now or I will have the drones escort you.\""
    c "\"Eu não devo! Segui cada protocolo. Estou no meu lugar de direito. Saia agora ou eu farei os drones escoltarem vocês.\""

# game/a3s1.rpy:634
translate pt_br a3s1_00a7b130:

    # "Alex is sitting up straight now, staring at us, his ears perked, and I kind of wish that we could have had him leave the room."
    "Alex está sentado agora, nos encarando, suas orelhas levantadas e eu meio que gostaria que nós pudéssemos fazer ele sair da sala."

# game/a3s1.rpy:636
translate pt_br a3s1_438248e8:

    # "Virginia remains calm, simply gazing back up at Cassius with an almost stoic look."
    "Virginia permanece calma, simplesmente olhando de volta para o Cassius com um olhar quase estoico."

# game/a3s1.rpy:637
translate pt_br a3s1_e43db0e7:

    # v "\"Brother, you must hear it, because we have proof of your deception.\""
    v "\"Irmão, você deve escutar porque nós temos prova de sua fraude.\""

# game/a3s1.rpy:638
translate pt_br a3s1_62ab43d2:

    # "Cassius seems to have recovered from his initial shock, though he's still trembling a bit, chest heaving for breath."
    "Cassius parece ter se recuperado do choque inicial, embora ainda esteja tremendo um pouco com o peito ofegante."

# game/a3s1.rpy:640
translate pt_br a3s1_b3ca42e2:

    # c "\"What...proof?\""
    c "\"Que... prova?\""

# game/a3s1.rpy:641
translate pt_br a3s1_359f4197_1:

    # "Virginia takes a deep breath."
    "Virginia respira bem fundo."

# game/a3s1.rpy:643
translate pt_br a3s1_4d9f03ab:

    # v "\"You know that we already know about the staging, but we have footage of the third trial...all of it.\""
    v "\"Você sabe que nós já temos conhecimento sobre a encenação, mas temos imagens do terceiro julgamento... tudo.\""

# game/a3s1.rpy:644
translate pt_br a3s1_9af23a27:

    # "Cassius stays quiet, unsure of what to say."
    "Cassius fica quieto, sem certeza do que dizer."

# game/a3s1.rpy:645
translate pt_br a3s1_188bdcb7:

    # v "\"We have contacts in Adastra that will release it to the public tomorrow evening.\""
    v "\"Nós temos contatos em Adastra que irão divulgar ao público amanhã à noite.\""

# game/a3s1.rpy:647
translate pt_br a3s1_a71669ec:

    # "Cassius swallows hard."
    "Cassius engole em seco."

# game/a3s1.rpy:649
translate pt_br a3s1_a296f849:

    # c "\"I will close the news channels.\""
    c "\"Eu vou fechar os canais de notícias.\""

# game/a3s1.rpy:650
translate pt_br a3s1_8042deaa:

    # v "\"Not only to the news channels, but in portable formats as well that may be copied and spread. You will not be able to stop all of it.\""
    v "\"Não apenas para os canais de notícias, mas em mídias portáteis também, que devem ser copiados e espalhados. Você não será capaz de impedir tudo.\""

# game/a3s1.rpy:652
translate pt_br a3s1_92c1073a:

    # "Cassius opens his mouth, then closes it, then opens it again...then closes it."
    "Cassius abre sua boca, então a fecha, então abre de novo... então fecha."

# game/a3s1.rpy:653
translate pt_br a3s1_5a786ffb:

    # "He didn't see this coming at all."
    "Ele realmente não esperava por isso."

# game/a3s1.rpy:655
translate pt_br a3s1_95676bae:

    # "Finally, his shoulders drop and he stares at the floor."
    "Finalmente, seus ombros caem e ele encara o chão."

# game/a3s1.rpy:656
translate pt_br a3s1_280f73b0:

    # c "\"Virginia...how could you do this to me?\""
    c "\"Virginia... como você pôde fazer isso comigo?\""

# game/a3s1.rpy:658
translate pt_br a3s1_7f6029e7:

    # "Virginia frowns, actually looking a bit sad."
    "Virginia franze a testa, na verdade parecendo um pouco triste."

# game/a3s1.rpy:659
translate pt_br a3s1_345e282f:

    # v "\"How could you take the throne in such a dishonest manner? Mother taught you better.\""
    v "\"Como você pôde assumir o trono de uma maneira tão desonesta? A mamãe te ensinou coisa melhor.\""

# game/a3s1.rpy:661
translate pt_br a3s1_e80cb004:

    # c "\"Do not speak of mother!\""
    c "\"Não fale da mamãe!\""

# game/a3s1.rpy:662
translate pt_br a3s1_872e68f6:

    # "Cassius's response is instant and angry before he deflates again."
    "A resposta do Cassius é imediata e irritada antes dele recuar de novo."

# game/a3s1.rpy:664
translate pt_br a3s1_e9c52123:

    # "The silence stretches out for a while before Virginia speaks again."
    "O silêncio se estende por um tempo antes da Virginia falar outra vez."

# game/a3s1.rpy:665
translate pt_br a3s1_d0e37417:

    # v "\"I know you Cass. I know you're an honest, honorable wolf. I know you don't want the emperorship like this.\""
    v "\"Eu conheço você, Cassius. Sei que é um lobo honesto e honrado. Sei que você não quer ser imperador desse jeito.\""

# game/a3s1.rpy:666
translate pt_br a3s1_2739cf2d:

    # "Cassius goes on staring off into space."
    "Cassius continua olhando para o nada."

# game/a3s1.rpy:667
translate pt_br a3s1_d7d126f0:

    # m "\"Do you even want to be emperor, Cassius?\""
    m "\"Você quer mesmo ser imperador, Cassius?\""

# game/a3s1.rpy:669
translate pt_br a3s1_bc934a29:

    # "Virginia looks sharply over at me, but I ignore her for now, looking right up at Cassius."
    "Virginia olha bruscamente na minha direção, mas eu a ignoro por enquanto, olhando diretamente para o Cassius."

# game/a3s1.rpy:671
translate pt_br a3s1_0c04eab2:

    # "He turns his gaze slowly to me."
    "Lentamente, ele volta seu olhar para mim."

# game/a3s1.rpy:672
translate pt_br a3s1_fc02a00d:

    # c "\"What sort of question is that?\""
    c "\"Que tipo de pergunta é essa?\""

# game/a3s1.rpy:673
translate pt_br a3s1_ba193eab:

    # m "\"Remember when we saw the parents together?\""
    m "\"Lembra quando a gente viu os progenitores, juntos?\""

# game/a3s1.rpy:675
translate pt_br a3s1_6a0462cf:

    # "Cassius instantly bristles, his ears turning a deep red."
    "Cassius fica constrangido, suas orelhas ficando profundamente vermelhas."

# game/a3s1.rpy:676
translate pt_br a3s1_fefadd85:

    # m "\"You remember what they said, right?\""
    m "\"Você lembra do que eles disseram, né?\""

# game/a3s1.rpy:677
translate pt_br a3s1_0e9bcfca:

    # c "\"I don't remember.\""
    c "\"Eu não me lembro.\""

# game/a3s1.rpy:678
translate pt_br a3s1_63512457:

    # m "\"Sure, anyway, you know what the parents think, what they want. Just...listen to them, they only want what's best for this empire.\""
    m "\"Tá, enfim, você sabe o que os progenitores pensam, o que eles querem. Só... escute eles, eles só querem o que é melhor pra esse império.\""

# game/a3s1.rpy:679
translate pt_br a3s1_54954fff:

    # "Cassius closes his eyes, taking a deep breath."
    "Cassius fecha os olhos, respirando bem fundo."

# game/a3s1.rpy:681
translate pt_br a3s1_5afbea67:

    # c "\"Why are you doing this to me?\""
    c "\"Por que estão fazendo isso comigo?\""

# game/a3s1.rpy:682
translate pt_br a3s1_ddf9e68f:

    # "He says it quietly, and I'm not sure if he's talking to me, Virginia, or the both of us."
    "Ele diz isso em voz baixa e eu não tenho certeza se ele está falando comigo, Virginia, ou nós dois."

# game/a3s1.rpy:684
translate pt_br a3s1_a01fb054:

    # v "\"Because we also want what's best for the empire Cassius, and that involves a legitimate emperor that rightfully sits upon the throne.\""
    v "\"Por que também queremos o que é melhor para o império, Cassius, e isso envolve um imperador legítimo que sente no trono por direito.\""

# game/a3s1.rpy:686
translate pt_br a3s1_ff31a1e1:

    # c "\"I can't just abdicate. How many emperors have even done that? The humiliation would be too great.\""
    c "\"Eu não posso simplesmente renunciar. Quantos imperadores já fizeram isso? A humilhação seria muito grande.\""

# game/a3s1.rpy:687
translate pt_br a3s1_f1191104:

    # "For the first time, I hear some resignation in Cassius's voice, and I actually do believe that he doesn't want this emperorship anymore."
    "Pela primeira vez, ouço alguma resignação na voz do Cassius e realmente acredito que ele não quer mais ser imperador."

# game/a3s1.rpy:688
translate pt_br a3s1_72838acc:

    # "I jump in again."
    "Eu me intrometo outra vez."

# game/a3s1.rpy:689
translate pt_br a3s1_2207e12d:

    # m "\"We can make up any story you want, Cassius. It doesn't have to be a shameful thing. We can make it seem honorable...even though I think it already is if you do step down.\""
    m "\"Nós podemos inventar qualquer história que você quiser, Cassius. Não precisa ser uma coisa vergonhosa. Podemos fazer com que pareça honorável... embora eu ache que já seja se você renunciar.\""

# game/a3s1.rpy:690
translate pt_br a3s1_79d4cade:

    # "Again, Cassius is silent, and I can only imagine all of the things that are going through his head right now."
    "Mais uma vez, Cassius fica em silêncio e eu só posso imaginar todas as coisas que estão passando por sua cabeça agora."

# game/a3s1.rpy:691
translate pt_br a3s1_6bbe7673:

    # "He knows that the release of the footage will destroy his image, cause unrest, probably to the point that he'd never be able to recover if he remained on the throne."
    "Ele sabe que o vazamento das filmagens vão destruir sua imagem, causará inquietação, provavelmente ao ponto dele nunca conseguir se recuperar se permanecer no trono."

# game/a3s1.rpy:692
translate pt_br a3s1_afe61a5d:

    # "He already knows that he's been beaten."
    "Ele já sabe que foi derrotado."

# game/a3s1.rpy:694
translate pt_br a3s1_70de4d65:

    # "Alex, meanwhile, continues to sit at his side, just staring at the two of us."
    "Alex, enquanto isso, continua sentado ao seu lado, apenas nos encarando."

# game/a3s1.rpy:695
translate pt_br a3s1_bc6d3725:

    # "I'm surprised he hasn't said anything at all, and again I'm not sure whose side he's on."
    "Fico surpreso que ele ainda não tenha dito nada e, mais uma vez, não tenho certeza de que lado ele está."

# game/a3s1.rpy:697
translate pt_br a3s1_28c3d028:

    # v "\"Also, you need to demote Cato from Advisor, otherwise he will become acting emperor again.\""
    v "\"Além disso, você precisa demitir Cato do cargo de conselheiro, do contrário ele se tornará imperador interino novamente.\""

# game/a3s1.rpy:698
translate pt_br a3s1_7c65fa0a:

    # "Cassius looks sharply at us."
    "Cassius olha bruscamente para nós."

# game/a3s1.rpy:700
translate pt_br a3s1_79114e15:

    # m "\"We know he's behind all of this...that you're a puppet, Cassius.\""
    m "\"Sabemos que ele está por trás de tudo isso... que você é um fantoche, Cassius.\""

# game/a3s1.rpy:704
translate pt_br a3s1_e5664e17:

    # "Cassius bristles and Virginia shoots me another warning look."
    "Cassius se irrita e Virginia me lança outro olhar de aviso."

# game/a3s1.rpy:705
translate pt_br a3s1_4997b4fe:

    # m "\"But you're still the emperor. You have complete power over your advisor; you can easily cut those strings.\""
    m "\"Mas você ainda é o imperador. Tem total poder sobre seu conselheiro; pode facilmente cortar essas cordas.\""

# game/a3s1.rpy:706
translate pt_br a3s1_5177068d:

    # "Cassius looks about ready to say something, to protest, but again he slumps down, just glaring at his knees."
    "Cassius parece prestes a falar alguma coisa em protesto, mas mais uma vez, ele cai em seu assento, olhando para os joelhos."

# game/a3s1.rpy:708
translate pt_br a3s1_736a272a:

    # c "\"That would automatically make Amicus emperor.\""
    c "\"Isso automaticamente faria Amicus se tornar o imperador.\""

# game/a3s1.rpy:709
translate pt_br a3s1_fbbe72e9:

    # "It's not a question, just a defeated statement."
    "Não é uma pergunta, apenas uma declaração de derrota."

# game/a3s1.rpy:710
translate pt_br a3s1_26bc927b:

    # "We don't say anything."
    "Nós não falamos nada."

# game/a3s1.rpy:712
translate pt_br a3s1_72e2889d:

    # c "\"I suppose he was always destined to be that. I was a fool to think I could make this work.\""
    c "\"Suponho que ele sempre esteve destinado a isso. Fui um tolo por pensar que poderia fazer isso funcionar.\""

# game/a3s1.rpy:714
translate pt_br a3s1_34b4a831:

    # "Virginia's ears perk up and I feel a swooping feeling in my chest like I just missed a step."
    "As orelhas de Virginia levantam e sinto uma sensação de mergulho no meu peito, como se tivesse errado um degrau de escada."

# game/a3s1.rpy:715
translate pt_br a3s1_3d7d86fb:

    # "Alex just looks up at Cassius, frowning."
    "Alex olha para cima na direção do Cassius, franzindo a testa."

# game/a3s1.rpy:716
translate pt_br a3s1_1050aea7:

    # "Cassius shakes his head."
    "Cassius balança a cabeça."

# game/a3s1.rpy:718
translate pt_br a3s1_2c061b02:

    # c "\"I'll need to think. You said tomorrow evening?\""
    c "\"Eu preciso pensar. Você disse amanhã à noite?\""

# game/a3s1.rpy:719
translate pt_br a3s1_e1400e6d:

    # v "\"The fourteenth hour.\""
    v "\"À décima quarta hora.\""

# game/a3s1.rpy:720
translate pt_br a3s1_29bb44ad:

    # "Cassius sighs, then nods."
    "Cassius suspira, então acena com a cabeça."

# game/a3s1.rpy:721
translate pt_br a3s1_6934ca8c:

    # c "\"I see. I will make an announcement tomorrow after breakfast. I need to meditate.\""
    c "\"Entendo. Farei um pronunciamento amanhã após o café da manhã. Eu preciso meditar.\""

# game/a3s1.rpy:723
translate pt_br a3s1_7ee43426:

    # v "\"Certainly.\""
    v "\"Certamente.\""

# game/a3s1.rpy:724
translate pt_br a3s1_b320fd32:

    # "Cassius drops his paw to his lap and picks up the glass tablet again, and just like that, we're dismissed."
    "Cassius coloca as patas no colo e pega seu tablet de vidro novamente, assim, somos dispensados."

# game/a3s1.rpy:726
translate pt_br a3s1_25d9c3e2:

    # "As Virginia turns to go, I quickly speak up."
    "Enquanto Virginia se vira, eu rapidamente falo."

# game/a3s1.rpy:727
translate pt_br a3s1_0d4c68d0:

    # m "\"Uh, Cassius? Can I see Amicus again?\""
    m "\"Hã... Cassius? Eu posso ir ver o Amicus de novo?\""

# game/a3s1.rpy:728
translate pt_br a3s1_3c749781:

    # "He rolls his eyes."
    "Ele revira os olhos."

# game/a3s1.rpy:730
translate pt_br a3s1_ce7b44da:

    # c "\"Gods...yes, in fact—\""
    c "\"Deuses... sim, na verdade—\""

# game/a3s1.rpy:731
translate pt_br a3s1_536f3f6d:

    # "He looks up at the ceiling."
    "Ele olha para o teto."

# game/a3s1.rpy:733
translate pt_br a3s1_039554da:

    # c "\"Com, set [mc]'s access to the dungeons as unrestricted...he'll be free by tomorrow anyway, I'm sure.\""
    c "\"Com, marque o acesso do [mc] às masmorras como irrestrito... ele estará livre até amanhã, de qualquer forma, tenho certeza.\""

# game/a3s1.rpy:734
translate pt_br a3s1_11cda958:

    # m "\"Thank you.\""
    m "\"Obrigado.\""

# game/a3s1.rpy:736
translate pt_br a3s1_70d95e84:

    # "I bow because it feels like the right thing to do, but Cassius only grunts in response."
    "Eu me curvo porque parece a coisa certa a se fazer, mas Cassius só resmunga em resposta."

# game/a3s1.rpy:737
translate pt_br a3s1_43a94352:

    # "I then quickly follow Virginia out into the hallway, almost skipping with relief and excitement."
    "Então rapidamente sigo Virginia até o corredor, quase pulando de alívio e animação."

# game/a3s1.rpy:740
translate pt_br a3s1_6f5f5f20:

    # m "\"Holy shit, that was easy!\""
    m "\"Cacete, essa foi fácil!\""

# game/a3s1.rpy:741
translate pt_br a3s1_646bc616:

    # "I whisper to the she-wolf as she maintains that stoic look."
    "Eu sussurro para a loba enquanto ela mantém aquele olhar estoico."

# game/a3s1.rpy:743
translate pt_br a3s1_9d895475:

    # v "\"It really was, wasn't it? It seems that Cassius isn't enjoying his position on the throne after all.\""
    v "\"Realmente, não é? Parece que Cassius não está desfrutando de sua posição no trono, afinal.\""

# game/a3s1.rpy:744
translate pt_br a3s1_3a866959:

    # m "\"Did he think it would be easy?\""
    m "\"Ele pensou que seria fácil?\""

# game/a3s1.rpy:745
translate pt_br a3s1_ce4bf356:

    # v "\"I think he never looked past beating Amicus. Now that he has, well...\""
    v "\"Eu acho que ele nunca planejou o que iria fazer depois de vencer o Amicus. Agora que isso aconteceu, bem...\""

# game/a3s1.rpy:746
translate pt_br a3s1_6a20a80d:

    # "I shake my head."
    "Eu balanço minha cabeça."

# game/a3s1.rpy:747
translate pt_br a3s1_d1fc70d9:

    # m "\"If that was his only reason, then he deserves this.\""
    m "\"Se esse é o único motivo, então ele merecia isso.\""

# game/a3s1.rpy:748
translate pt_br a3s1_96075f40:

    # v "\"Well, I don't believe it was his only reason, he simply didn't prepare himself beyond the trials.\""
    v "\"Bem, eu não acredito que essa tenha sido a única razão, ele simplesmente não se preparou para além dos julgamentos.\""

# game/a3s1.rpy:749
translate pt_br a3s1_1f22674d:

    # "Virginia side-eyes me."
    "Virginia me olha de lado."

# game/a3s1.rpy:751
translate pt_br a3s1_0755091e:

    # v "\"And don't get too excited just yet. Nothing is final until Cassius says the words.\""
    v "\"E não fique muito animado ainda. Nada é definitivo até que o Cassius diga as palavras.\""

# game/a3s1.rpy:752
translate pt_br a3s1_acf64cce:

    # m "\"Yeah, but it looks like he's definitely going to.\""
    m "\"É, mas definitivamente parece que ele vai renunciar.\""

# game/a3s1.rpy:753
translate pt_br a3s1_7d101186:

    # v "\"It does, yes, but remain careful and vigilant, also—\""
    v "\"Parece sim, mas mantenha-se cauteloso e vigilante, também—\""

# game/a3s1.rpy:754
translate pt_br a3s1_76844bf4:

    # "Virginia pauses as we reach a branch in the hallway where we would part ways so that I can go to the dungeons."
    "Virginia para quando alcançamos uma parte do corredor onde iríamos nos separar para que eu pudesse ir até as masmorras."

# game/a3s1.rpy:755
translate pt_br a3s1_29d3914c:

    # "I stop and look up at her, stepping from one foot to the other, eager to tell Amicus the news."
    "Eu paro e olho para ela, intercalando a sustentação dos pés, ansioso para contar as novidades ao Amicus."

# game/a3s1.rpy:757
translate pt_br a3s1_99cffa5f:

    # v "\"You've noted my loyalty to Amicus over the past week, yes?\""
    v "\"Você notou minha lealdade ao Amicus na última semana, sim?\""

# game/a3s1.rpy:758
translate pt_br a3s1_fc3e2a4d:

    # m "\"Uh, yeah?\""
    m "\"Hã, sim?\""

# game/a3s1.rpy:759
translate pt_br a3s1_9b70abf7:

    # v "\"At the very least, this would be deserving of some time of official position, don't you think?\""
    v "\"No mínimo, isso seria merecedor de algum tempo em um cargo oficial, você não acha?\""

# game/a3s1.rpy:760
translate pt_br a3s1_9ebe4f84:

    # m "\"You wanna be chief advisor, right?\""
    m "\"Você quer ser a conselheira dele, né?\""

# game/a3s1.rpy:762
translate pt_br a3s1_f3cc3ec7:

    # v "\"Yes. And you are very close to him.\""
    v "\"Sim. E você é muito próximo dele.\""

# game/a3s1.rpy:763
translate pt_br a3s1_600666fc:

    # m "\"I'll get him to make it happen.\""
    m "\"Eu convenço ele a te dar o cargo.\""

# game/a3s1.rpy:765
translate pt_br a3s1_86a58d30:

    # "The wolf almost looks shocked."
    "A loba quase parece chocada."

# game/a3s1.rpy:766
translate pt_br a3s1_144439bf:

    # "I don't know why though; I'd assumed this was always part of the plan."
    "Mas eu não sei por que; presumi que isso sempre fez parte do plano."

# game/a3s1.rpy:768
translate pt_br a3s1_53fb5f62:

    # v "\"Thank you, [mc].\""
    v "\"Obrigada, [mc].\""

# game/a3s1.rpy:769
translate pt_br a3s1_da156efe:

    # m "\"Of course. I'll see you later today.\""
    m "\"É claro. Te vejo mais tarde.\""

# game/a3s1.rpy:772
translate pt_br a3s1_3b967a6a:

    # "I leave the wolf standing there, trying not to walk too fast on my way to the dungeons."
    "Eu deixo a loba parada lá, tentando não andar rápido demais no caminho até as masmorras."

# game/a3s1.rpy:775
translate pt_br a3s1_2e849425:

    # "Amicus is shocked when I tell him the news, obviously, but like Virginia, he tells me to stay cautious."
    "Amicus fica chocado quando eu conto as notícias para ele, obviamente, mas assim como Virginia, ele me diz para permanecer cauteloso."

# game/a3s1.rpy:776
translate pt_br a3s1_85f4a4cf:

    # "Anything can happen between now and when Cassius makes the announcement."
    "Qualquer coisa pode acontecer entre agora e o momento que Cassius fizer o pronunciamento."

# game/a3s1.rpy:777
translate pt_br a3s1_ea31c54a:

    # "And we're definitely not guaranteed an abdication during said announcement."
    "E definitivamente nós não temos garantia alguma de que ele vai renunciar durante o tal anúncio."

# game/a3s1.rpy:778
translate pt_br a3s1_5f3b61a8:

    # "Either way, I promise Amicus to come back down first thing in the morning to tell him the news."
    "De qualquer forma, prometo ao Amicus que vou retornar logo pela manhã para lhe contar as novidades."

# game/a3s1.rpy:779
translate pt_br a3s1_66c29b20:

    # "I leave in good spirits, and I catch Amicus's tail wagging more than it usually does."
    "Eu saio de bom humor e noto a cauda dele abanando mais que o normal."

# game/a3s1.rpy:780
translate pt_br a3s1_bb73908d:

    # "We might actually be at the end of this nightmare..."
    "Nós podemos realmente estar no fim desse pesadelo..."

# game/a3s1.rpy:783
translate pt_br a3s1_1fe2b9dd:

    # com "\"[mc].\""
    com "\"[mc].\""

# game/a3s1.rpy:784
translate pt_br a3s1_a20cefa7:

    # "..."
    "..."

# game/a3s1.rpy:785
translate pt_br a3s1_1fe2b9dd_1:

    # com "\"[mc].\""
    com "\"[mc].\""

# game/a3s1.rpy:786
translate pt_br a3s1_ac94747a:

    # m "\"Huh?\""
    m "\"Oi?\""

# game/a3s1.rpy:788
translate pt_br a3s1_92da94fd:

    # "I stare at the ceiling, wondering for a moment where I am."
    "Eu olho para o teto, me perguntando por um momento onde estou."

# game/a3s1.rpy:789
translate pt_br a3s1_39bf153a:

    # com "\"[mc], your presence is requested at breakfast.\""
    com "\"[mc], sua presença é solicitada no café da manhã.\""

# game/a3s1.rpy:790
translate pt_br a3s1_df8ec4bc_3:

    # m "\"What?\""
    m "\"Que?\""

# game/a3s1.rpy:791
translate pt_br a3s1_780375f4:

    # "I try to focus, the memories of last night slowly coming back to me."
    "Eu tento me concentrar, as memórias da noite passada lentamente voltando à mente."

# game/a3s1.rpy:792
translate pt_br a3s1_479c5379:

    # "I'd returned to Virginia and Neferu having a drink to celebrate our tentative victory."
    "Eu voltei para a Virginia e Neferu e os encontrei tomando um drinque, comemorando nossa pequena vitória."

# game/a3s1.rpy:793
translate pt_br a3s1_7b32a1b3:

    # "I'd joined them and maybe I had too much...it's a bit blurry, but the splitting headache is evidence enough."
    "Eu me juntei a eles e talvez tenha bebido um pouco demais... está um pouco embaçado, mas a dor de cabeça é evidência o suficiente."

# game/a3s1.rpy:794
translate pt_br a3s1_dd6f77ac:

    # "Then I remember that Com woke me up."
    "Então me lembro que o Com me acordou."

# game/a3s1.rpy:795
translate pt_br a3s1_f57f5f1a:

    # m "\"Wait, breakfast?\""
    m "\"Peraí, café da manhã?\""

# game/a3s1.rpy:796
translate pt_br a3s1_172ab3db:

    # com "\"Yes, your presence is requested immediately.\""
    com "\"Sim, sua presença é solicitada imediatamente.\""

# game/a3s1.rpy:797
translate pt_br a3s1_eeb596ca:

    # "I hadn't had breakfast with the family since Amicus was imprisoned, why would they request me now?"
    "Eu não tomo café da manhã com a família desde que o Amicus foi preso, por que eles iriam me solicitar agora?"

# game/a3s1.rpy:798
translate pt_br a3s1_1abc8a9e:

    # "That gets me nervous, knowing what's about to happen today."
    "Isso me deixa nervoso, sabendo o que está prestes a acontecer hoje."

# game/a3s1.rpy:799
translate pt_br a3s1_28936296:

    # "I look over to once again see Neferu sleeping in his bed, his fur uncharacteristically mussed up, just like yesterday morning."
    "Eu olho em volta para mais uma vez ver Neferu dormindo em sua cama, seu pelo incomumente despenteado, assim como ontem de manhã."

# game/a3s1.rpy:800
translate pt_br a3s1_1e1cf41b:

    # "Quickly, I jump out of bed, throwing on my robes and trying to straighten out my hair as I hurry out and towards the dining room."
    "Rapidamente eu pulo da cama, vestindo minhas roupas e tentando arrumar meu cabelo enquanto corro para a sala de jantar."

# game/a3s1.rpy:803
translate pt_br a3s1_c95dcde3:

    # "I wonder if maybe Amicus is already out of the dungeons."
    "Eu me pergunto se talvez o Amicus já esteja fora das masmorras."

# game/a3s1.rpy:804
translate pt_br a3s1_1288d4bc:

    # "Maybe he's the one requesting my presence?"
    "Talvez tenha sido ele quem solicitou minha presença?"

# game/a3s1.rpy:805
translate pt_br a3s1_3078d135:

    # "But as I reach the door, I realize that's not the case."
    "Mas assim que eu chego até a porta, percebo que esse não é o caso."

# game/a3s1.rpy:813
translate pt_br a3s1_d177ec15:

    # "Virginia, Cassius, and Cato sit on the beds while Alex kneels in front of Cassius."
    "Virginia, Cassius e Cato sentam nas camas enquanto Alex se ajoelha em frente ao Cassius."

# game/a3s1.rpy:814
translate pt_br a3s1_bf86aa08:

    # "As I walk in, I can immediately tell that something's off."
    "Conforme entro na sala, consigo imediatamente dizer que há algo errado."

# game/a3s1.rpy:815
translate pt_br a3s1_0e7f3d71:

    # "The air is tense."
    "O clima está tenso."

# game/a3s1.rpy:816
translate pt_br a3s1_09280c0f:

    # "I come to a gradual stop, unsure of what to do as the rest of them glance up at me."
    "Diminuo a velocidade gradualmente até parar, sem saber o que fazer enquanto o restante deles olha para mim."

# game/a3s1.rpy:818
translate pt_br a3s1_f76a494f:

    # ca "\"Ah, is that [mc]? How nice of you to join us. Would you care to serve us our food and drink, please?\""
    ca "\"Ah, é o [mc]? Que gentileza sua se juntar a nós. Se importa de nos servir comida e bebida, por favor?\""

# game/a3s1.rpy:819
translate pt_br a3s1_2db40aa9:

    # "Something is very wrong here."
    "Tem alguma coisa muito errada aqui."

# game/a3s1.rpy:820
translate pt_br a3s1_4e3b1d45:

    # "Did Cassius tell Cato about what happened?"
    "Cassius disse para o Cato o que aconteceu?"

# game/a3s1.rpy:821
translate pt_br a3s1_24158393:

    # "There's not much else I can do except walk over to kneel beside Alex, reaching out to begin serving the wolves."
    "Não tem muito mais o que eu possa fazer exceto andar para ficar de joelhos ao lado do Alex, estendendo a mão para começar a servir os lobos."

# game/a3s1.rpy:822
translate pt_br a3s1_33b1ce60:

    # "It's completely silent as all of them just watch me fumbling around with the food."
    "O silêncio é total enquanto todos eles apenas me observam manipulando a comida."

# game/a3s1.rpy:823
translate pt_br a3s1_28e9677c:

    # "Finally, Virginia breaks the silence."
    "Finalmente, Virginia quebra o silêncio."

# game/a3s1.rpy:824
translate pt_br a3s1_83491eaa:

    # v "\"Cato...is there a reason you called us all to breakfast?\""
    v "\"Cato... existe uma razão para você ter chamado todos nós para tomar café da manhã?\""

# game/a3s1.rpy:825
translate pt_br a3s1_3e0fd94a:

    # "Cato turns his head in Virginia's direction."
    "Cato vira a cabeça na direção de Virginia."

# game/a3s1.rpy:827
translate pt_br a3s1_acda6557:

    # ca "\"Can't I enjoy a meal with the royal siblings? I simply wanted to discuss my trip with you.\""
    ca "\"Não posso apreciar uma refeição com os irmãos reais? Eu simplesmente queria discutir minha viagem com vocês.\""

# game/a3s1.rpy:828
translate pt_br a3s1_f524c9a1:

    # v "\"Oh, I see. It's just been so long since we've had a scheduled breakfast.\""
    v "\"Ah, entendo. Apenas faz tanto tempo desde que programamos um café da manhã.\""

# game/a3s1.rpy:829
translate pt_br a3s1_d20de67a:

    # ca "\"It may be a good habit to get back into, wouldn't you agree, Emperor Cassius?\""
    ca "\"Pode ser um bom hábito para reestabelecermos, não concorda, Imperador Cassius?\""

# game/a3s1.rpy:831
translate pt_br a3s1_3e6cc05c:

    # c "\"Oh! Yes, definitely Cato...how was your trip?\""
    c "\"Ah! Sim, definitivamente, Cato... como foi sua viagem?\""

# game/a3s1.rpy:833
translate pt_br a3s1_33c262bd:

    # ca "\"Wonderful, I had the pleasure of visiting Ad Rotae. Being the entertainment capital of Adastra, I had such a good time observing the plays...despite my inability to observe.\""
    ca "\"Maravilhosa, tive o prazer de visitar Ad Rotae. Sendo a capital do entretenimento em Adastra, me diverti muito assistindo às peças... apesar da minha incapacidade de ver.\""

# game/a3s1.rpy:834
translate pt_br a3s1_34e29430:

    # "Cato starts laughing loudly and I can tell why everyone's on edge."
    "Cato começa a gargalhar alto e eu consigo dizer o porquê de todo mundo estar com uma cara de \"que porra é essa?\"."

# game/a3s1.rpy:835
translate pt_br a3s1_e99fdf11:

    # "This isn't like Cato at all."
    "Isso não parece com o Cato nem um pouco."

# game/a3s1.rpy:836
translate pt_br a3s1_65408f1f:

    # "I set a plate out for Cato while Alex does the same for Cassius and while he's working on Virginia's plate, Cato shifts."
    "Eu estendo um prato para o Cato enquanto Alex faz o mesmo para o Cassius, enquanto ele trabalha no prato da Virginia, Cato muda de posição."

# game/a3s1.rpy:838
translate pt_br a3s1_4632f0d2:

    # ca "\"[mc], could you hand us all our goblets? I am absolutely parched.\""
    ca "\"[mc], poderia entregar nossos cálices? Estou absolutamente sedento.\""

# game/a3s1.rpy:839
translate pt_br a3s1_90db77c4:

    # "I had noticed that the goblets had already been sat out in front of each wolf, already filled with wine."
    "Eu tinha notado que os cálices já foram colocados na frente de cada lobo, todos cheios de vinho."

# game/a3s1.rpy:840
translate pt_br a3s1_21af4e58:

    # "Carefully, I hand Cato his goblet, then turn and reach for Cassius's."
    "Cuidadosamente, dou ao Cato seu cálice, então me viro e alcanço o do Cassius."

# game/a3s1.rpy:842
translate pt_br a3s1_0049b059:

    # "\"{i}Fear not...these are the events that shall follow...{/i}\""
    "\"{i}Não tenha medo... esses são os eventos que devem se seguir...{/i}\""

# game/a3s1.rpy:843
translate pt_br a3s1_af368f34:

    # "I blink, and I notice Cassius staring at me, raising an eyebrow."
    "Eu pisco e noto Cassius olhando para mim, levantando uma sobrancelha."

# game/a3s1.rpy:844
translate pt_br a3s1_5c5539ce:

    # "I hold out the goblet, and my fingers twitch, but I keep a stubborn grip."
    "Eu entrego o cálice, e há um espasmo em meus dedos, mas mantenho um aperto firme."

# game/a3s1.rpy:845
translate pt_br a3s1_ff439647:

    # "I shake my head and push the goblet into his paw."
    "Eu balanço a cabeça e empurro o cálice em sua pata."

# game/a3s1.rpy:846
translate pt_br a3s1_7b7f7b47:

    # "I'm about to grab Virginia's, but Alex has already finished her plate and hands her her goblet as well."
    "Fico prestes a pegar o de Virginia, mas Alex já terminou seu prato e estende o cálice dela."

# game/a3s1.rpy:847
translate pt_br a3s1_c771ca7a:

    # "For a while, the wolves eat and drink in silence."
    "Por um momento, os lobos comem e bebem em silêncio."

# game/a3s1.rpy:848
translate pt_br a3s1_639f2116:

    # "At least Virginia and Cassius do."
    "Virginia e Cassius, pelo menos."

# game/a3s1.rpy:849
translate pt_br a3s1_550fbd02:

    # "I notice Cato not touching his food at all, simply watching the rest of us."
    "Eu noto o Cato não tocando em sua comida, simplesmente observando o resto de nós."

# game/a3s1.rpy:850
translate pt_br a3s1_0365a41d:

    # "Cassius lets out a loud cough."
    "Cassius solta uma tosse alta."

# game/a3s1.rpy:851
translate pt_br a3s1_bd54b0a1:

    # "Alex sets a paw on his leg in concern."
    "Alex coloca uma pata em sua perna, preocupado."

# game/a3s1.rpy:853
translate pt_br a3s1_52c1e822:

    # c "\"Sorry, something in my throat.\""
    c "\"Perdão, algo na minha garganta.\""

# game/a3s1.rpy:854
translate pt_br a3s1_3a331c2a:

    # "He takes another drink of his wine."
    "Ele toma outro gole do vinho."

# game/a3s1.rpy:855
translate pt_br a3s1_fe93803e:

    # "\"{i}Keep your mind and heart open, great ape...You shall receive guidance...{/i}\""
    "\"{i}Mantenha sua mente e coração abertos, grande macaco... você será guiado...{/i}\""

# game/a3s1.rpy:856
translate pt_br a3s1_f00d42f7:

    # "My vision flashes and the tension somehow builds, and I know now that something terrible is about to happen."
    "Minha visão brilha, a tensão de alguma forma aumenta e eu sei que algo terrível está prestes a acontecer."

# game/a3s1.rpy:857
translate pt_br a3s1_acf4c868:

    # ca "\"So, Cassius. I hear you have an announcement to make this morning.\""
    ca "\"Então, Cassius. Ouvi falar que você tem um anúncio a fazer esta manhã.\""

# game/a3s1.rpy:861
translate pt_br a3s1_c8b801a1:

    # "The entire room freezes as the wolves stop eating and Alex stops serving."
    "A sala inteira congela enquanto os lobos param de comer e Alex para de servir."

# game/a3s1.rpy:862
translate pt_br a3s1_0d24e7f8:

    # "I sit there on my knees, trying to keep my breathing even, trying to deal with feeling like I have voices in my head, and with Cato apparently discovering our plan at the same time."
    "Eu fico sentado de joelhos, tentando manter minha respiração regular, tentando lidar com a sensação de que tenho vozes na minha cabeça e Cato aparentemente descobrindo nosso plano ao mesmo tempo."

# game/a3s1.rpy:863
translate pt_br a3s1_7a38a2c6:

    # "Cassius finally speaks...or tries to."
    "Cassius finalmente fala... ou tenta fazer isso."

# game/a3s1.rpy:865
translate pt_br a3s1_bcd33917:

    # c "\"I—\""
    c "\"Eu—\""

# game/a3s1.rpy:867
translate pt_br a3s1_97e84dd8:

    # "He coughs again, harder this time."
    "Ele tosse de novo, mais forte dessa vez."

# game/a3s1.rpy:869
translate pt_br a3s1_bcd33917_1:

    # c "\"I—\""
    c "\"Eu—\""

# game/a3s1.rpy:870
translate pt_br a3s1_4475fc7e:

    # "I notice him starting to shake, and Alex again puts a paw on his leg."
    "Eu noto ele começando a tremer e Alex mais uma vez coloca uma pata na perna dele."

# game/a3s1.rpy:872
translate pt_br a3s1_8c7d51e4:

    # al "\"Cassius...Cassius, what's wrong?\""
    al "\"Cassius... Cassius, o que há de errado?\""

# game/a3s1.rpy:873
translate pt_br a3s1_7fd52fd5:

    # ca "\"Yes, what's wrong Cassius? Don't you have a speech to give this morning? You might have to postpone it if you have a cough.\""
    ca "\"Sim, o que há de errado, Cassius? Você não tem um discurso para fazer esta manhã? Talvez precise adiá-lo se estiver com uma tosse.\""

# game/a3s1.rpy:874
translate pt_br a3s1_c458508e:

    # "Cassius suddenly sits up, trembling."
    "Cassius de repente se senta, tremendo."

# game/a3s1.rpy:880
translate pt_br a3s1_392fa82e:

    # "He stares at Cato, wide-eyed, disbelieving, one paw moving to his throat."
    "Ele encara o Cato, de olhos arregalados, incrédulo, uma pata movendo até a garganta."

# game/a3s1.rpy:882
translate pt_br a3s1_c05692ab:

    # al "\"Cassius!\""
    al "\"Cassius!\""

# game/a3s1.rpy:883
translate pt_br a3s1_abf7c567:

    # "He turns to Alex, reaching a paw out to him, which the cat catches."
    "Ele se vira para o Alex, estendendo uma pata para ele, a qual o gato pega."

# game/a3s1.rpy:884
translate pt_br a3s1_56be5092:

    # c "\"I...I can't...breathe...\""
    c "\"Não... consigo... respirar...\""

# game/a3s1.rpy:885
translate pt_br a3s1_3ecb8893:

    # "Cassius wheezes looking down into his goblet, then he suddenly spasms curling over his stomach before another violent spasm takes him and he arches out onto the bed, screaming."
    "Cassius chia olhando para seu cálice, então, de repente um espasmo se curva sobre seu estômago antes que outro espasmo mais violento o atinja e ele se contorça na cama, gritando."

# game/a3s1.rpy:887
translate pt_br a3s1_0d55bc4b:

    # "It's a hideous sound, full of agony."
    "É um som terrível, cheio de agonia."

# game/a3s1.rpy:888
translate pt_br a3s1_8fdf7a51:

    # "It's so sudden, I'm left to just stare in shock, still on my knees."
    "É tão repentino que eu fico apenas encarando, chocado, ainda de joelhos."

# game/a3s1.rpy:889
translate pt_br a3s1_fe5dbb2d:

    # "Virginia stands up, moving around her bed to get closer to Cassius."
    "Virginia se levanta, andando ao redor de sua cama para chegar mais perto do Cassius."

# game/a3s1.rpy:890
translate pt_br a3s1_1cd41325:

    # "Meanwhile, Alex screams as well, staring in horror at Cassius."
    "Enquanto isso, Alex também grita, encarando Cassius com horror."

# game/a3s1.rpy:891
translate pt_br a3s1_d7e4f232:

    # al "\"Cass! Cass, what is it, what happened!?\""
    al "\"Cass! Cass, o que é isso, o que aconteceu!?\""

# game/a3s1.rpy:892
translate pt_br a3s1_f38f1247:

    # "Cassius just writhes under him, even as Alex tries to hold him down."
    "Cassius apenas se contorce, mesmo enquanto Alex tenta segurá-lo."

# game/a3s1.rpy:893
translate pt_br a3s1_56b1d48f:

    # "I notice his mouth foaming, red from the wine, the goblet still held in his paw before he drops it, spilling it to the bed and floor."
    "Percebo sua boca espumando, vermelho por conta do vinho, o cálice ainda em sua pata antes dele derrubar, derramando o líquido na cama e no chão."

# game/a3s1.rpy:895
translate pt_br a3s1_e352e7f3:

    # al "\"CASS!\""
    al "\"CASS!\""

# game/a3s1.rpy:896
translate pt_br a3s1_54f81aa9:

    # "Alex's voice is filled with despair, probably realizing at the same time I do that Cassius has been poisoned, that he might be dying."
    "A voz do Alex está cheia de desespero, provavelmente percebendo ao mesmo tempo que eu que o Cassius foi envenenado, que ele pode estar morrendo."

# game/a3s1.rpy:897
translate pt_br a3s1_b8019628:

    # ca "\"Oh dear, are you cramping, Cassius? Perhaps you ate too fast?\""
    ca "\"Ah, querido, você está se engasgando, Cassius? Talvez tenha comido rápido demais.\""

# game/a3s1.rpy:898
translate pt_br a3s1_3218deb6:

    # "The hair rises on the back of my neck as I sense Cato sitting behind me."
    "O cabelo sobe na parte de trás do meu pescoço quando percebo o Cato sentando atrás de mim."

# game/a3s1.rpy:899
translate pt_br a3s1_8c44d1bd:

    # "He'd found out about our plan."
    "Ele descobriu sobre o nosso plano."

# game/a3s1.rpy:900
translate pt_br a3s1_88805f35:

    # "He'd put a stop to it just like that."
    "Ele colocou um fim nisso assim mesmo."

# game/a3s1.rpy:901
translate pt_br a3s1_fa1e925d:

    # al "\"Cato, this was too far! Was it the wine!?\""
    al "\"Cato, isso foi longe demais! O vinho causou isso!?\""

# game/a3s1.rpy:902
translate pt_br a3s1_de8f01ba:

    # "I almost don't register what Alex just said, but that's when I feel Cato get up behind me."
    "Eu quase não registro o que o Alex acabou de falar, mas é quando sinto Cato se levantando atrás de mim."

# game/a3s1.rpy:903
translate pt_br a3s1_92259f57:

    # "In a few steps, he's standing over Alex and Cassius before he swings a paw hard into Alex's face."
    "Em poucos passos, ele fica de pé em frente ao Alex e Cassius antes de bater forte com uma pata no rosto do gato."

# game/a3s1.rpy:906
translate pt_br a3s1_a2b3410a:

    # "It sends the small cat flying so far that he's thrown up against the wall."
    "Isso faz ele voar tão longe que é jogado contra a parede."

# game/a3s1.rpy:907
translate pt_br a3s1_d0753a58:

    # "He crumples there, unmoving."
    "Ele colide e cai, imóvel."

# game/a3s1.rpy:908
translate pt_br a3s1_f4903d04:

    # "Virginia ducks when this happens, but bravely moves forward, grabbing Cassius and turning him over onto his stomach."
    "Virginia se abaixa quando isso acontece, mas corajosamente avança, agarrando Cassius e o virando de bruços."

# game/a3s1.rpy:909
translate pt_br a3s1_e46b02c1:

    # "For a moment, I think Cato is going to do the same to her, but he seems to get himself under control."
    "Por um momento eu acho que Cato iria fazer o mesmo com ela, mas ele parece se controlar."

# game/a3s1.rpy:911
translate pt_br a3s1_5818a9a7:

    # ca "\"Was it the wine, then? Well...who served it?\""
    ca "\"Foi o vinho, então? Bem... quem o serviu?\""

# game/a3s1.rpy:912
translate pt_br a3s1_9244d4c5:

    # "He looks around inquisitively, even while Virginia sticks her fingers into Cassius's mouth, shoving them deep until the screaming wolf lets out a retch."
    "Ele olha em volta inquisitivamente, mesmo enquanto Virginia coloca seus dedos dentro da boca do Cassius, empurrando-os profundamente até o lobo gritando vomitar."

# game/a3s1.rpy:913
translate pt_br a3s1_6da87eb5:

    # "Cato's eyes settle on me."
    "Os olhos do Cato fixam em mim."

# game/a3s1.rpy:914
translate pt_br a3s1_4d1eb44d:

    # ca "\"What did you put in his drink, simian?\""
    ca "\"O que você colocou na bebida dele, símio?\""

# game/a3s1.rpy:915
translate pt_br a3s1_4b5553af:

    # "I stay there on my knees, dumbfounded."
    "Eu fico lá de joelhos, estupefato."

# game/a3s1.rpy:916
translate pt_br a3s1_a358496f:

    # "Then, there's a splattering sound as Cassius vomits up his breakfast, tinged red from the wine."
    "Então, há um som de respingos enquanto Cassius vomita seu café da manhã, tingido de vermelho com o vinho."

# game/a3s1.rpy:917
translate pt_br a3s1_1278e933:

    # "Virginia stubbornly continues to gag him, forcing out every little bit that she can."
    "Virginia teimosamente continua provocando seu vômito, forçando para fora cada pedacinho que ela consegue."

# game/a3s1.rpy:918
translate pt_br a3s1_83f3fd6c:

    # ca "\"Well...I suppose we'll have to investigate, won't we?\""
    ca "\"Bem... suponho que vamos ter que investigar, não é mesmo?\""

# game/a3s1.rpy:920
translate pt_br a3s1_eec28777:

    # v "\"COM! Send a medical ship from Adastra City! Tell them the emperor has been poisoned!\""
    v "\"COM! Envie uma nave médica da cidade de Adastra! Diga a eles que o imperador foi envenenado!\""

# game/a3s1.rpy:921
translate pt_br a3s1_02e7e13a:

    # com "\"Yes, Virginia.\""
    com "\"Sim, Virginia.\""

# game/a3s1.rpy:922
translate pt_br a3s1_7537c077:

    # "Cato looks down at me, then before I can move, he reaches out and grabs up my arm."
    "Cato olha para mim e antes mesmo que eu possa me mexer, ele estende uma pata e agarra meu braço."

# game/a3s1.rpy:923
translate pt_br a3s1_50187081:

    # "I've felt the power of a wolf before, main one being Amicus, of course, but this is different."
    "Eu já senti o poder de um lobo antes, o principal sendo o Amicus, é claro, mas isso é diferente."

# game/a3s1.rpy:924
translate pt_br a3s1_297217bc:

    # "It's like he's made of stone."
    "É como se ele fosse feito de pedra."

# game/a3s1.rpy:925
translate pt_br a3s1_0aafee22:

    # "Cato starts pulling me toward the door and every step feels like my arm is about to be yanked out of its socket."
    "Cato começa a me puxar em direção à porta e a cada passo eu sinto como se meu braço estivesse prestes a ser arrancado do meu ombro."

# game/a3s1.rpy:927
translate pt_br a3s1_678700a6:

    # "As Cato marches out into the hallway, I grasp at his arm with my other hand, trying to relieve the pressure somehow."
    "Enquanto Cato marcha pelo corredor, agarro seu braço com a outra mão, tentando aliviar a pressão de alguma forma."

# game/a3s1.rpy:928
translate pt_br a3s1_170bc35e:

    # "The wolf stares straight ahead, ignoring me even as I try to pull away."
    "O lobo continua olhando em frente, me ignorando mesmo enquanto eu tento me afastar."

# game/a3s1.rpy:929
translate pt_br a3s1_bdbdb51b:

    # m "\"I can...walk.\""
    m "\"Eu posso... andar.\""

# game/a3s1.rpy:930
translate pt_br a3s1_d80a8ab7:

    # "I grit my teeth, my hand already numb."
    "Eu cerro meus dentes, minha mão já dormente."

# game/a3s1.rpy:931
translate pt_br a3s1_9fc15781:

    # "I look left and right, trying to figure out how I might get away."
    "Olho em volta, tentando descobrir como eu poderia escapar."

# game/a3s1.rpy:932
translate pt_br a3s1_e9667136:

    # "There's no chance for that though, as I realize we've reached Amicus's room."
    "Mas não há chances disso acontecer conforme eu percebo que chegamos ao quarto do Amicus."

# game/a3s1.rpy:934
translate pt_br a3s1_59bde554:

    # "Suddenly, I find myself on the floor as the wolf throws me violently into the room."
    "De repente, me pego no chão quando o lobo me joga violentamente dentro do quarto."

# game/a3s1.rpy:935
translate pt_br a3s1_e181101f:

    # ca "\"I suggest you stay there; you have no means of escape anyway. I'll be back to...discuss things with you.\""
    ca "\"Eu sugiro que você fique aqui; não tem como você escapar, de qualquer maneira. Eu vou voltar para... discutir as coisas com você.\""

# game/a3s1.rpy:936
translate pt_br a3s1_4b2fbf8e:

    # "There's some strange humor in his voice with that last part, and before I can even look back, the door shuts and I hear another sound..."
    "Há um humor estranho em sua voz nessa última parte e antes mesmo que eu possa olhar de volta, a porta se fecha e eu ouço outro som..."

# game/a3s1.rpy:938
translate pt_br a3s1_c3b5c3b6:

    # "...a click."
    "...um clique."

# game/a3s1.rpy:941
translate pt_br a3s1_acd1b39c:

    # "I sit in Amicus's room in stunned silence for a long, long time."
    "Eu sento no quarto do Amicus em silêncio por muito, muito tempo."

# game/a3s1.rpy:942
translate pt_br a3s1_e8b635cf:

    # "I still haven't been able to comprehend the series of events that had just unfolded."
    "Ainda não consegui compreender a série de eventos que acabaram de se desenrolar."

# game/a3s1.rpy:943
translate pt_br a3s1_ca308137:

    # "All I can piece together was that Alex, for whatever reason, had tipped Cato off as to what we were planning."
    "Tudo o que eu pude entender foi que Alex, seja lá por que, denunciou ao Cato sobre o que nós estávamos planejando."

# game/a3s1.rpy:944
translate pt_br a3s1_e545cd0e:

    # "I suppose the cat hadn't expected Cato to use such drastic measures, judging by his reaction, but he'd wanted to put a stop to our plans just the same."
    "Suponho que o gato não esperava que Cato tomasse medidas tão drásticas julgando sua reação, mas ele também queria pôr um fim em nossos planos."

# game/a3s1.rpy:945
translate pt_br a3s1_73dbe2ed:

    # "I don't bother myself with trying to figure out Alex's motives anymore though."
    "Porém, não me incomodo mais em tentar descobrir as motivações do Alex."

# game/a3s1.rpy:946
translate pt_br a3s1_df30e312:

    # "Instead, I'm left to sit here and wonder if there's anything I can possibly do to get out of this."
    "Em vez disso, fico sentado, me perguntando se há algo que eu possa fazer para sair dessa."

# game/a3s1.rpy:947
translate pt_br a3s1_4f87c68e:

    # "I soon find out that the clicking sound was the door locking."
    "Eu logo descobri que o som de clique era a porta sendo trancada."

# game/a3s1.rpy:948
translate pt_br a3s1_be604547:

    # "I suppose that means Cato is the acting emperor again, with Cassius either incapacitated...or even dead."
    "Suponho que isso significa que Cato é o imperador interino outra vez, com Cassius incapacitado... ou até mesmo morto."

# game/a3s1.rpy:949
translate pt_br a3s1_fc55dfd2:

    # "I ask Com about Cassius's health, but he only tells me that that information is not available to him."
    "Eu pergunto ao Com sobre a saúde do Cassius, mas ele só me diz que essa informação não está disponível para ele."

# game/a3s1.rpy:950
translate pt_br a3s1_3472dacc:

    # "So I wait, sitting on the couch for hours, wondering if the next time the door slides open, it will be my death."
    "Então eu espero, sentado no sofá por horas, me perguntando se a próxima vez que a porta se abrir, será minha morte."

# game/a3s1.rpy:951
translate pt_br a3s1_8cdaa246:

    # "I need Amicus."
    "Eu preciso do Amicus."

# game/a3s1.rpy:952
translate pt_br a3s1_85cd972f:

    # "These thoughts become too much for me and I have to get up to walk around, trying hard not to hyperventilate."
    "Esses pensamentos se tornam demais para mim e eu preciso me levantar para andar, tentando não hiperventilar."

# game/a3s1.rpy:953
translate pt_br a3s1_a830b51a:

    # "Maybe Neferu will be able to do something."
    "Talvez Neferu seja capaz de fazer alguma coisa."

# game/a3s1.rpy:954
translate pt_br a3s1_56bd817d:

    # "He must have heard about what happened by now...unless Cato did something to him as well."
    "Ele deve ter ouvido falar sobre o que aconteceu a essa altura... a não ser que Cato tenha feito alguma coisa com ele também."

# game/a3s1.rpy:955
translate pt_br a3s1_811f449b:

    # "With a deep breath, I push past the curtain and out onto the balcony."
    "Com uma respiração profunda, passo pela cortina e vou até a varanda."

# game/a3s1.rpy:958
translate pt_br a3s1_cc08ddf1:

    # "It's already late afternoon, but that's not what catches my attention."
    "Já é fim de tarde, mas não é isso que chama minha atenção."

# game/a3s1.rpy:959
translate pt_br a3s1_567d3c97:

    # "Instead, it's the smoke rising over the city, the sun shining behind it all to give it a strange, red glow."
    "Em vez disso, é a fumaça subindo sobre a cidade, o sol por trás de tudo isso pintando o céu com um brilho vermelho sinistro."

# game/a3s1.rpy:960
translate pt_br a3s1_422844ed:

    # "I stare, wondering what possibly could have happened in the short time between this morning and now."
    "Eu fico encarando, me perguntando o que possivelmente poderia ter acontecido no curto espaço de tempo entre essa manhã e agora."

# game/a3s1.rpy:961
translate pt_br a3s1_c3273a87:

    # m "\"Com?\""
    m "\"Com?\""

# game/a3s1.rpy:962
translate pt_br a3s1_80cf3baf:

    # com "\"Yes, [mc]?\""
    com "\"Sim, [mc]?\""

# game/a3s1.rpy:963
translate pt_br a3s1_3feb32ae:

    # m "\"Why is there smoke over Adastra City?\""
    m "\"Por que tem fumaça sobre a cidade de Adastra?\""

# game/a3s1.rpy:964
translate pt_br a3s1_f85b39eb_1:

    # "There's a pause."
    "Há uma pausa."

# game/a3s1.rpy:965
translate pt_br a3s1_b1811efc:

    # com "\"Here's what I found; at approximately the eleventh hour, Cato proclaimed himself emperor of Adastra shortly after Emperor Cassius was poisoned by a child pet.\""
    com "\"Aqui está o que eu encontrei; aproximadamente à décima primeira hora, Cato se proclamou o imperador de Adastra logo depois que o Imperador Cassius foi envenenado por um mascote infante.\""

# game/a3s1.rpy:966
translate pt_br a3s1_3d9816ab:

    # com "\"Cato then dissolved the Triumvirate and assumed absolute control of the empire. There are destructive riots in all seven major cities.\""
    com "\"Cato então dissolveu o triunvirato e assumiu absoluto controle do império. Há motins destrutivos nas sete principais cidades.\""

# game/a3s1.rpy:967
translate pt_br a3s1_7be1f3a0:

    # m "\"Is Cassius alive?\""
    m "\"Cassius está vivo?\""

# game/a3s1.rpy:968
translate pt_br a3s1_a2fd2855:

    # com "\"That information is not available to me, [mc].\""
    com "\"Esta informação não está disponível para mim, [mc].\""

# game/a3s1.rpy:969
translate pt_br a3s1_33fb006e:

    # "I sigh and stare down at the water, feeling sick."
    "Eu suspiro e fico encarando a água, me sentindo enjoado."

# game/a3s1.rpy:970
translate pt_br a3s1_cc2149d5:

    # "I wonder how much of this is my fault...at least a little bit, if not all of it for just being here in the first place."
    "Gostaria de saber quanto disso é minha culpa... pelo menos um pouco, se não tudo, só por estar aqui em primeiro lugar."

# game/a3s1.rpy:971
translate pt_br a3s1_0b7e64ac:

    # "And now that Cato's framing me, I'm going to die..."
    "E agora, com o Cato me enquadrando, eu vou morrer..."

# game/a3s1.rpy:972
translate pt_br a3s1_65a08bb7:

    # "My vision blurs with tears before one drops down into the sloshing lake below me..."
    "Minha visão borra com lágrimas antes que uma caia no lago abaixo de mim..."

# game/a3s1.rpy:973
translate pt_br a3s1_b850cd5c:

    # "...and then I remember."
    "(...) e então eu me lembro."

# game/a3s1.rpy:974
translate pt_br a3s1_e46216f2:

    # "I deleted my profile from Com's database."
    "Eu deletei meu registro do banco de dados do Com."

# game/a3s1.rpy:975
translate pt_br a3s1_636331d1:

    # "I try to remember what I was told about how exactly it works...something to do with the AI's security system."
    "Tento me lembrar do que me disseram sobre como exatamente funciona... algo a ver com o sistema de segurança da inteligência artificial."

# game/a3s1.rpy:976
translate pt_br a3s1_6441b4d3:

    # "While he might be able to deduce what room I'm in based on my voice, he should be blind to my exact location."
    "Embora ele possa deduzir em que cômodo eu estou com base na minha voz, ele deve estar cego para minha localização exata."

# game/a3s1.rpy:977
translate pt_br a3s1_76556022:

    # "That would mean leaving the boundaries of the palace shouldn't alert anything."
    "Isso significa que deixar os limites do palácio não deveria alertar em nada."

# game/a3s1.rpy:978
translate pt_br a3s1_69b72dbc:

    # "Maybe if I..."
    "Talvez se eu..."

# game/a3s1.rpy:979
translate pt_br a3s1_a76c0719:

    # "I experimentally stick an arm over the railing, then a leg, and before I know it, I'm on the other side of the balcony, the lake sloshing below me."
    "Experimentalmente, ponho um braço sobre a cerca, depois uma perna, e antes que eu perceba, estou do outro lado da varanda, o lago abaixo de mim."

# game/a3s1.rpy:980
translate pt_br a3s1_3f03af31:

    # "I think about what I can do."
    "Eu penso sobre o que posso fazer."

# game/a3s1.rpy:981
translate pt_br a3s1_1e250f52:

    # "I could swim for the shore, make a run for Adastra City and maybe find someone to help me."
    "Eu poderia nadar até a praia, correr até a cidade e talvez encontrar alguém para me ajudar."

# game/a3s1.rpy:982
translate pt_br a3s1_0591e7f0:

    # "Maybe one of those contacts that Neferu and Virginia keep talking about."
    "Talvez um dos contatos que Neferu e Virginia ficavam falando sobre."

# game/a3s1.rpy:983
translate pt_br a3s1_ce866e9d:

    # "I could also just hide somewhere, maybe even on the island until things settle down a bit."
    "Eu poderia também só me esconder em algum lugar, talvez na ilha até que a poeira abaixasse um pouco."

# game/a3s1.rpy:984
translate pt_br a3s1_e4a803dd:

    # "Running into a city in chaos probably wouldn't be the best move."
    "Correr até uma cidade em caos provavelmente não seria a melhor decisão."

# game/a3s1.rpy:985
translate pt_br a3s1_ee0478a9:

    # "But...I already know what I'm going to do."
    "Mas... eu já sei o que vou fazer."

# game/a3s1.rpy:986
translate pt_br a3s1_c18608b5:

    # "I'm not going to leave the palace."
    "Eu não vou sair do palácio."

# game/a3s1.rpy:987
translate pt_br a3s1_a655056b:

    # "I'm going to find a way back in."
    "Vou encontrar um caminho de volta."

# game/a3s1.rpy:988
translate pt_br a3s1_fa54f0d9:

    # "I need to get to Amicus."
    "Eu preciso ir até o Amicus."

# game/a3s1.rpy:989
translate pt_br a3s1_140ed949:

    # "I need to tell him what happened and...figure out a way to fall back on our last resort."
    "Preciso contar para ele o que aconteceu... e descobrir uma maneira de recorrer ao nosso último recurso."

# game/a3s1.rpy:990
translate pt_br a3s1_0030af29:

    # "My stomach twists at the idea, but I know that we're out of choices now."
    "Meu estômago revira com a ideia, mas sei que estamos sem opções agora."

# game/a3s1.rpy:991
translate pt_br a3s1_a03b9c80:

    # "With that, I look down at the water and let go."
    "Com isso, eu olho para água e solto a cerca."

# game/a3s1.rpy:997
translate pt_br a3s1_fec97169:

    # "To be continued..."
    "Continua..."
